{
  "reportUnitUri": "/reports/origin/customer_contact_letter",
  "dataSources": {
    "DEV": "ORIGIN_DEV_DS",
    "QA": "C2M_QA_DS",
    "PROD": "C2M_PROD_DS"
  },
  "inputControls": [
    {
      "id": "CC_ID",
      "label": "Customer Contact ID",
      "type": "singleSelectQuery",
      "mandatory": false,
      "visible": true,
      "valueColumn": "CC_ID",
      "visibleColumn": "CC_LABEL",
      "query": "SELECT TO_CHAR(CC_ID) AS CC_ID, TO_CHAR(CC_ID) || ' | ' || TO_CHAR(CC_DTTM, 'YYYY-MM-DD HH24:MI') || ' | ' || NVL(CC_TYPE_CD, '-') AS CC_LABEL FROM CISADM.CI_CC WHERE PRINT_LETTER_SW = 'Y' ORDER BY CC_DTTM DESC FETCH FIRST 200 ROWS ONLY"
    },
    {
      "id": "ACCT_ID",
      "label": "Account ID (fallback mode)",
      "type": "singleValueText",
      "mandatory": false,
      "visible": true
    },
    {
      "id": "START_TS",
      "label": "Start Timestamp",
      "type": "dateTime",
      "mandatory": false,
      "visible": true
    },
    {
      "id": "END_TS",
      "label": "End Timestamp",
      "type": "dateTime",
      "mandatory": false,
      "visible": true
    },
    {
      "id": "AGENT_NAME",
      "label": "Agent Name",
      "type": "singleValueText",
      "mandatory": true,
      "visible": true
    },
    {
      "id": "AGENT_TITLE",
      "label": "Agent Title",
      "type": "singleValueText",
      "mandatory": false,
      "visible": true
    },
    {
      "id": "CLIENT_LOGO_URL",
      "label": "Client Logo URL",
      "type": "singleValueText",
      "mandatory": false,
      "visible": false
    },
    {
      "id": "LETTER_DATE",
      "label": "Letter Date",
      "type": "dateTime",
      "mandatory": true,
      "visible": true
    }
  ]
}
