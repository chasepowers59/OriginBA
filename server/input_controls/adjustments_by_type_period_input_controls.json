{
  "reportUnitUri": "/SmartCity/Report/Standard_Offering/Finance/adjustments_by_type_period",
  "label": "Adjustments by Type",
  "description": "Frozen adjustments created in a date window by adjustment type: count, net amount, largest and smallest, with the ten largest adjustments (account and customer) under each type.",
  "dataSources": {
    "DEV": "ORIGIN_DEV_DS",
    "QA": "C2M_QA_DS",
    "PROD": "C2M_PROD_DS"
  },
  "subreport": "reports/subreports/adjustments_by_type_top.jrxml  (a local jrxml resource of the unit named adjustments_by_type_top; the main says repo:adjustments_by_type_top)",
  "inputControls": [
    {
      "id": "FROM_DT",
      "label": "From date (inclusive)",
      "type": "singleValueDate",
      "mandatory": true,
      "visible": true
    },
    {
      "id": "TO_DT",
      "label": "To date (inclusive)",
      "type": "singleValueDate",
      "mandatory": true,
      "visible": true
    },
    {
      "id": "CLIENT_NAME",
      "label": "Client name (footer)",
      "type": "singleValueText",
      "mandatory": false,
      "visible": true,
      "defaultValue": "SmartCity Client"
    },
    {
      "id": "TOP_N",
      "label": "Top N",
      "type": "singleValueNumber",
      "mandatory": false,
      "visible": true,
      "defaultValue": "10"
    },
    {
      "id": "ADJ_TYPE_CD_F",
      "label": "Adjustment type (blank = all)",
      "type": "singleValueText",
      "mandatory": false,
      "visible": true
    },
    {
      "id": "ACCT_ID_F",
      "label": "Account ID (blank = all)",
      "type": "singleValueText",
      "mandatory": false,
      "visible": true
    },
    {
      "id": "SA_ID_F",
      "label": "Service agreement ID (blank = all)",
      "type": "singleValueText",
      "mandatory": false,
      "visible": true
    },
    {
      "id": "MIN_ABS_AMT_F",
      "label": "Minimum absolute amount (blank = all)",
      "type": "singleValueNumber",
      "mandatory": false,
      "visible": true
    }
  ]
}
