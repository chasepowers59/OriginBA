      "label": "GL division (blank = all)",
      "type": "singleValueText",
      "mandatory": false,
      "visible": true
    },
    {
      "id": "CIS_DIVISION_F",
      "label": "CIS division (blank = all)",
      "type": "singleValueText",
      "mandatory": false,
      "visible": true
