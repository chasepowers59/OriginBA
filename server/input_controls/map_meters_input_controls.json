{
  "organization": "Origin_DEV",
  "reportUnitUri": "/organizations/Origin_DEV/reports/maps/map_meters_coverage",
  "dataSources": {
    "DEV": "ORIGIN_DEV_DS",
    "QA": "C2M_QA_DS",
    "PROD": "C2M_PROD_DS"
  },
  "inputControls": [
    {
      "id": "CLIENT_ID",
      "label": "Client",
      "type": "singleSelectQuery",
      "mandatory": true,
      "visible": true,
      "valueColumn": "CLIENT_ID",
      "visibleColumn": "CLIENT_NAME",
      "query": "SELECT C.CLIENT_ID, C.CLIENT_NAME FROM CISADM.CLIENTS C ORDER BY C.CLIENT_NAME"
    },
    {
      "id": "START_TS",
      "label": "Start Timestamp",
      "type": "dateTime",
      "mandatory": true,
      "visible": true
    },
    {
      "id": "END_TS",
      "label": "End Timestamp",
      "type": "dateTime",
      "mandatory": true,
      "visible": true
    },
    {
      "id": "THRESHOLD_HOURS",
      "label": "No-Read Threshold (Hours)",
      "type": "singleValueNumber",
      "mandatory": true,
      "visible": true,
      "defaultValue": 24
    },
    {
      "id": "REGION",
      "label": "Region",
      "type": "singleSelectQuery",
      "mandatory": false,
      "visible": true,
      "valueColumn": "REGION",
      "visibleColumn": "REGION_LABEL",
      "query": "SELECT DISTINCT FW.WORK_REGION AS REGION, FW.WORK_REGION AS REGION_LABEL FROM CISADM.FIELD_WORK_LOG FW WHERE FW.CLIENT_ID = $P{CLIENT_ID} AND FW.WORK_REGION IS NOT NULL ORDER BY FW.WORK_REGION"
    },
    {
      "id": "CLIENT_LOGO_URL",
      "label": "Client Logo URL",
      "type": "singleValueText",
      "mandatory": false,
      "visible": false
    }
  ]
}
