      <filterString>CI_LOOKUP_VAL_L_1.FIELD_NAME == 'CM_SNAPSHOT_TYPE_FLG          '</filterString>
      <joinInfo alias="CMS_SA_SNAPSHOT" referenceId="CMS_SA_SNAPSHOT"></joinInfo>
      <joinList>
        <join expr="CMS_SA_SNAPSHOT.SA_ID == CI_SA.SA_ID" left="CMS_SA_SNAPSHOT" right="CI_SA" type="inner" weight="1"></join>
        <join expr="CI_SA.ACCT_ID == CI_ACCT.ACCT_ID" left="CI_SA" right="CI_ACCT" type="inner" weight="1"></join>
        <join expr="CMS_SA_SNAPSHOT.PER_ID == CI_PER_NAME.PER_ID and CI_PER_NAME.NAME_TYPE_FLG == 'PRIM'" left="CMS_SA_SNAPSHOT" right="CI_PER_NAME" type="inner" weight="1"></join>
        <join expr="CI_ACCT.BILL_CYC_CD == CI_BILL_CYC_L.BILL_CYC_CD and CI_BILL_CYC_L.LANGUAGE_CD == 'ENG'" left="CI_ACCT" right="CI_BILL_CYC_L" type="leftOuter" weight="1"></join>
        <join expr="CI_ACCT.ACCT_MGMT_GRP_CD == CI_ACCT_MGMT_GR_L.ACCT_MGMT_GRP_CD and CI_ACCT_MGMT_GR_L.LANGUAGE_CD == 'ENG'" left="CI_ACCT" right="CI_ACCT_MGMT_GR_L" type="leftOuter" weight="1"></join>
        <join expr="CI_ACCT.COLL_CL_CD == CI_COLL_CL_L.COLL_CL_CD and CI_COLL_CL_L.LANGUAGE_CD == 'ENG'" left="CI_ACCT" right="CI_COLL_CL_L" type="inner" weight="1"></join>
        <join expr="CI_ACCT.CUST_CL_CD == CI_CUST_CL_L.CUST_CL_CD and CI_CUST_CL_L.LANGUAGE_CD == 'ENG'" left="CI_ACCT" right="CI_CUST_CL_L" type="inner" weight="1"></join>
