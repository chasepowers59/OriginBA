    <jdbcQuery id="WO_PAY_AGG" datasourceId="Origin_DEV_DS">
      <fieldList>
        <field id="UNCOLL_PROC_ID" type="java.lang.String"></field>
        <field id="PAY_SEGMENT_COUNT" type="java.math.BigDecimal"></field>
        <field id="PAYMENT_EVENT_COUNT" type="java.math.BigDecimal"></field>
        <field id="PAY_SEG_AMT_TOTAL" type="java.math.BigDecimal"></field>
        <field id="PAY_SEG_AMT_IN_WINDOW" type="java.math.BigDecimal"></field>
        <field id="FIRST_PAY_DT" type="java.sql.Timestamp"></field>
        <field id="LAST_PAY_DT" type="java.sql.Timestamp"></field>
      </fieldList>
      <query>select w.uncoll_proc_id, count(distinct ps.pay_seg_id) as pay_segment_count, count(distinct pe.pay_event_id) as payment_event_count, nvl(sum(case when pe.pay_event_id is not null then nvl(ps.pay_seg_amt, 0) else 0 end), 0) as pay_seg_amt_total, nvl(sum(case when pe.pay_dt &gt;= w.cre_dttm and (w.wo_proc_compl_dt is null or pe.pay_dt &lt;= w.wo_proc_compl_dt) then nvl(ps.pay_seg_amt, 0) else 0 end), 0) as pay_seg_amt_in_window, min(pe.pay_dt) as first_pay_dt, max(pe.pay_dt) as last_pay_dt from cisadm.c1_bi_woproc_vw w left join cisadm.ci_wo_proc_sa s on s.wo_proc_id = w.uncoll_proc_id left join cisadm.ci_pay_seg ps on ps.sa_id = s.sa_id left join cisadm.ci_pay_tndr pt on pt.pay_tender_id = ps.pay_id left join cisadm.ci_pay_event pe on pe.pay_event_id = pt.pay_event_id and pe.pay_dt &gt;= date '2025-09-01' where w.cre_dttm &gt;= date '2025-09-01' group by w.uncoll_proc_id</query>
    </jdbcQuery>
