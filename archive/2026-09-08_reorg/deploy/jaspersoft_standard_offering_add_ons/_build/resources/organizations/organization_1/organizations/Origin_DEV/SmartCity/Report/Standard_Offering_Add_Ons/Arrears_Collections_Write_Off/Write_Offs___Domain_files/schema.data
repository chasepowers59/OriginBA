        <item defaultAgg="Sum" dimensionOrMeasure="Measure" id="PAYMENT_SEGMENT_COUNT" label="Payment Segment Count (Agg Sum)" resourceId="JoinTree_1.WO_PAY_AGG.PAY_SEGMENT_COUNT"></item>
        <item defaultAgg="Sum" dimensionOrMeasure="Measure" id="PAYMENT_EVENT_COUNT" label="Payment Event Count (Agg Sum)" resourceId="JoinTree_1.WO_PAY_AGG.PAYMENT_EVENT_COUNT"></item>
