    <jdbcQuery id="CMS_ACTIVITY_ML" datasourceId="Origin_DEV_DS">
      <fieldList>
        <field id="D1_ACTIVITY_ID" type="java.lang.String"></field>
        <field id="FA_INT_STATUS_FLG" type="java.lang.String"></field>
        <field id="FA_PRIORITY_FLG" type="java.lang.String"></field>
        <field id="THRD_PTY_REP_CD" type="java.lang.String"></field>
      </fieldList>
      <query>SELECT
  D1_ACTIVITY_ID,
  MIN(FA_INT_STATUS_FLG) AS FA_INT_STATUS_FLG,
  MIN(FA_PRIORITY_FLG) AS FA_PRIORITY_FLG,
  MAX(THRD_PTY_REP_CD) AS THRD_PTY_REP_CD
FROM(
    SELECT 
      AC.D1_ACTIVITY_ID,
      DECODE(trim(AC.CHAR_TYPE_CD), 'CMFAINST', trim(ac.adhoc_char_val), NULL) AS FA_INT_STATUS_FLG,
      DECODE(trim(AC.CHAR_TYPE_CD), 'CMFAPRIO', trim(ac.adhoc_char_val), NULL) AS FA_PRIORITY_FLG,
      DECODE(trim(AC.CHAR_TYPE_CD), 'CMFAREP', trim(ac.char_val_fk1), NULL) || '  ' AS THRD_PTY_REP_CD
    FROM
      CISADM.D1_ACTIVITY_CHAR AC
      )
GROUP BY
  D1_ACTIVITY_ID</query>
    </jdbcQuery>
