      <filterString>D1_ACTIVITY_TYPE.ACTIVITY_TYPE_CAT_FLG == 'D1FA' and F1_BUS_OBJ_L.LANGUAGE_CD == 'ENG' and D1_ACTIVITY_TYPE_L.LANGUAGE_CD == 'ENG' and F1_BUS_OBJ_STATUS_L.LANGUAGE_CD == 'ENG'</filterString>
      <joinInfo alias="D1_ACTIVITY" referenceId="D1_ACTIVITY"></joinInfo>
      <joinList>
        <join expr="D1_ACTIVITY.ACTIVITY_TYPE_CD == D1_ACTIVITY_TYPE.ACTIVITY_TYPE_CD and D1_ACTIVITY_TYPE.ACTIVITY_TYPE_CAT_FLG == 'D1FA'" left="D1_ACTIVITY" right="D1_ACTIVITY_TYPE" type="inner" weight="1"></join>
        <join expr="D1_ACTIVITY.D1_ACTIVITY_ID == D1_ACTIVITY_REL.D1_ACTIVITY_ID and D1_ACTIVITY_REL.ACTIVITY_REL_TYPE_FLG == 'D1PR'" left="D1_ACTIVITY" right="D1_ACTIVITY_REL" type="leftOuter" weight="1"></join>
