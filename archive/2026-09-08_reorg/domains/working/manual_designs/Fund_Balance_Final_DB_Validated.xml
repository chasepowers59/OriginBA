    <jdbcQuery id="FUND_MAP_RESOLVED" datasourceId="Odessa_DS">
      <fieldList>
        <field id="FT_ID" type="java.lang.String"></field>
        <field id="GL_SEQ_NBR" type="java.math.BigDecimal"></field>
        <field id="FUND_CD" type="java.lang.String"></field>
        <field id="EFFDT" type="java.sql.Timestamp"></field>
        <field id="FUND_MAP_STATUS" type="java.lang.String"></field>
      </fieldList>
      <query>select
    ranked.ft_id,
    ranked.gl_seq_nbr,
    ranked.fund_cd,
    cast(ranked.effdt as timestamp) as effdt,
    case
        when ranked.dst_id is null or ranked.gl_acct is null then 'No Distribution Key'
        when ranked.fund_cd is null then 'No Active Fund Mapping'
        else 'Mapped'
    end as fund_map_status
from (
    select
        gl.ft_id,
        gl.gl_seq_nbr,
        gl.dst_id,
        gl.gl_acct,
        d.fund_cd,
        d.effdt,
        row_number() over (
            partition by gl.ft_id, gl.gl_seq_nbr
            order by
                case
                    when d.effdt is not null
                     and ft.accounting_dt is not null
                     and d.effdt &lt;= ft.accounting_dt then 0
                    when d.effdt is null then 1
                    else 2
                end,
                case
                    when d.effdt is not null
                     and ft.accounting_dt is not null
                     and d.effdt &lt;= ft.accounting_dt then d.effdt
                end desc nulls last,
                d.effdt desc nulls last,
                d.fund_cd
        ) as rn
    from cisadm.ci_ft_gl gl
    join cisadm.ci_ft ft
      on ft.ft_id = gl.ft_id
     and ft.redundant_sw = 'N'
    left join cisadm.ci_dst_code_eff d
      on d.dst_id = gl.dst_id
     and d.gl_acct = gl.gl_acct
     and d.eff_status = 'A'
) ranked
where ranked.rn = 1</query>
    </jdbcQuery>

