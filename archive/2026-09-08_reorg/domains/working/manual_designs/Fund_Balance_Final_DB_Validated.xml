    <jdbcQuery id="FT_PROC_LATEST" datasourceId="Odessa_DS">
      <fieldList>
        <field id="FT_ID" type="java.lang.String"></field>
        <field id="BATCH_NBR" type="java.math.BigDecimal"></field>
      </fieldList>
      <query>select q.ft_id, q.batch_nbr
from (
    select
        p.ft_id,
        p.batch_nbr,
        row_number() over (
            partition by p.ft_id
            order by
                p.seq_num desc,
                p.batch_nbr desc nulls last,
                p.batch_cd desc nulls last
        ) as rn
    from cisadm.ci_ft_proc p
) q
where q.rn = 1</query>
    </jdbcQuery>

