      </fieldList>
    </jdbcTable>

    <jdbcQuery id="CI_LOOKUP_VAL_L_4" datasourceId="Origin_DEV_DS">
      <fieldList>
        <field id="FIELD_NAME" type="java.lang.String"></field>
        <field id="FIELD_VALUE" type="java.lang.String"></field>
        <field id="LANGUAGE_CD" type="java.lang.String"></field>
        <field id="DESCR" type="java.lang.String"></field>
      </fieldList>
      <query>select 'RC_TYPE_FLG' as field_name, l.field_value, 'ENG' as language_cd, l.descr from cisadm.ci_lookup_val_l l where l.field_name = 'RC_TYPE_FLG' and l.language_cd = 'ENG'</query>
    </jdbcQuery>

    <jdbcTable id="JoinTree_1" datasourceId="Origin_DEV_DS" datasourceTableName="C1_BI_BILLED_USAGE_VW" schemaAlias="CISADM">
      <fieldList>
        <field id="C1_BI_BILLED_USAGE_VW.BILL_ID" type="java.lang.String"></field>
        <field id="C1_BI_BILLED_USAGE_VW.BSEG_ID" type="java.lang.String"></field>
        <field id="C1_BI_BILLED_USAGE_VW.ACCT_ID" type="java.lang.String"></field>
        <field id="C1_BI_BILLED_USAGE_VW.RS_CD" type="java.lang.String"></field>
        <field id="C1_BI_BILLED_USAGE_VW.UOM_CD" type="java.lang.String"></field>
        <field id="C1_BI_BILLED_USAGE_VW.TOU_CD" type="java.lang.String"></field>
        <field id="C1_BI_BILLED_USAGE_VW.SQI_CD" type="java.lang.String"></field>
        <field id="C1_BI_BILLED_USAGE_VW.ACCOUNTING_DT" type="java.sql.Timestamp"></field>

        <field id="RC_COMPONENT_CTX.BSEG_ID" type="java.lang.String"></field>
        <field id="RC_COMPONENT_CTX.UOM_CD" type="java.lang.String"></field>
        <field id="RC_COMPONENT_CTX.TOU_CD" type="java.lang.String"></field>
        <field id="RC_COMPONENT_CTX.SQI_CD" type="java.lang.String"></field>
        <field id="RC_COMPONENT_CTX.RC_SEQ" type="java.math.BigDecimal"></field>
        <field id="RC_COMPONENT_CTX.DESCR_ON_BILL" type="java.lang.String"></field>
        <field id="RC_COMPONENT_CTX.CALC_AMT" type="java.math.BigDecimal"></field>
        <field id="RC_COMPONENT_CTX.BILL_SQ" type="java.math.BigDecimal"></field>
