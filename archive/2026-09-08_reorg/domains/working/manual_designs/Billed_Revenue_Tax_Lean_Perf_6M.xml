  <resources>
    <jdbcQuery id="C1_BI_BILLED_USAGE_VW" datasourceId="Origin_DEV_DS">
      <fieldList>
        <field id="BILL_ID" type="java.lang.String"></field>
        <field id="BSEG_ID" type="java.lang.String"></field>
        <field id="ACCT_ID" type="java.lang.String"></field>
        <field id="RS_CD" type="java.lang.String"></field>
        <field id="UOM_CD" type="java.lang.String"></field>
        <field id="TOU_CD" type="java.lang.String"></field>
        <field id="SQI_CD" type="java.lang.String"></field>
        <field id="ACCOUNTING_DT" type="java.sql.Timestamp"></field>
      </fieldList>
      <query>select u.bill_id,
       u.bseg_id,
       u.acct_id,
       u.rs_cd,
       u.uom_cd,
       u.tou_cd,
       u.sqi_cd,
       u.accounting_dt
from cisadm.c1_bi_billed_usage_vw u
where u.accounting_dt &gt;= add_months(trunc(sysdate), -6)
  and u.accounting_dt &lt; trunc(sysdate) + 1
  and u.bill_id is not null
  and u.bseg_id is not null
  and u.rs_cd is not null</query>
    </jdbcQuery>

    <jdbcQuery id="RC_COMPONENT_CTX" datasourceId="Origin_DEV_DS">
      <fieldList>
        <field id="BSEG_ID" type="java.lang.String"></field>
        <field id="UOM_CD" type="java.lang.String"></field>
        <field id="TOU_CD" type="java.lang.String"></field>
        <field id="SQI_CD" type="java.lang.String"></field>
        <field id="RC_SEQ" type="java.math.BigDecimal"></field>
        <field id="DESCR_ON_BILL" type="java.lang.String"></field>
        <field id="CALC_AMT" type="java.math.BigDecimal"></field>
        <field id="BILL_SQ" type="java.math.BigDecimal"></field>
        <field id="RC_TYPE_FLG" type="java.lang.String"></field>
        <field id="COMPONENT_AMT_GROSS" type="java.math.BigDecimal"></field>
        <field id="COMPONENT_AMT_CREDITS" type="java.math.BigDecimal"></field>
        <field id="COMPONENT_AMT_NET" type="java.math.BigDecimal"></field>
      </fieldList>
      <query>select bcl.bseg_id,
       bcl.uom_cd,
       bcl.tou_cd,
       bcl.sqi_cd,
       bcl.rc_seq,
       bcl.descr_on_bill,
       bcl.calc_amt,
       bcl.bill_sq,
       rc.rc_type_flg,
       case when bcl.calc_amt &gt; 0 then bcl.calc_amt else 0 end as component_amt_gross,
       case when bcl.calc_amt &lt; 0 then -1 * bcl.calc_amt else 0 end as component_amt_credits,
       bcl.calc_amt as component_amt_net
  from cisadm.ci_bseg_calc_ln bcl
  join (
      select distinct v.bseg_id
        from cisadm.c1_bi_billed_usage_vw v
       where v.accounting_dt &gt;= add_months(trunc(sysdate), -6)
         and v.accounting_dt &lt; trunc(sysdate) + 1
         and v.bseg_id is not null
  ) uk
    on uk.bseg_id = bcl.bseg_id
  join cisadm.ci_bseg_calc bc
    on bc.bseg_id = bcl.bseg_id
   and bc.header_seq = bcl.header_seq
  left join cisadm.ci_rc rc
    on rc.rs_cd = bc.rs_cd
   and rc.rc_seq = bcl.rc_seq
   and rc.effdt = bc.effdt</query>
    </jdbcQuery>

    <jdbcTable id="CI_RS_L" datasourceId="Origin_DEV_DS" datasourceTableName="CI_RS_L" schemaAlias="CISADM">
      <fieldList>
