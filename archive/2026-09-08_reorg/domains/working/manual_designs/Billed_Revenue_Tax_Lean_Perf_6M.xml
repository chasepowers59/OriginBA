        <field id="CI_LOOKUP_VAL_L_4.DESCR" type="java.lang.String"></field>
      </fieldList>

      <joinInfo alias="C1_BI_BILLED_USAGE_VW" referenceId="C1_BI_BILLED_USAGE_VW"></joinInfo>
      <joinList>
        <join expr="C1_BI_BILLED_USAGE_VW.BSEG_ID == RC_COMPONENT_CTX.BSEG_ID and C1_BI_BILLED_USAGE_VW.UOM_CD == RC_COMPONENT_CTX.UOM_CD and C1_BI_BILLED_USAGE_VW.TOU_CD == RC_COMPONENT_CTX.TOU_CD and C1_BI_BILLED_USAGE_VW.SQI_CD == RC_COMPONENT_CTX.SQI_CD" left="C1_BI_BILLED_USAGE_VW" right="RC_COMPONENT_CTX" type="inner" weight="1"></join>
        <join expr="C1_BI_BILLED_USAGE_VW.RS_CD == CI_RS_L.RS_CD and CI_RS_L.LANGUAGE_CD == 'ENG'" left="C1_BI_BILLED_USAGE_VW" right="CI_RS_L" type="leftOuter" weight="1"></join>
        <join expr="C1_BI_BILLED_USAGE_VW.ACCT_ID == CI_ACCT.ACCT_ID" left="C1_BI_BILLED_USAGE_VW" right="CI_ACCT" type="leftOuter" weight="1"></join>
        <join expr="CI_ACCT.BILL_CYC_CD == CI_BILL_CYC_L.BILL_CYC_CD and CI_BILL_CYC_L.LANGUAGE_CD == 'ENG'" left="CI_ACCT" right="CI_BILL_CYC_L" type="leftOuter" weight="1"></join>
        <join expr="CI_ACCT.CUST_CL_CD == CI_CUST_CL_L.CUST_CL_CD and CI_CUST_CL_L.LANGUAGE_CD == 'ENG'" left="CI_ACCT" right="CI_CUST_CL_L" type="leftOuter" weight="1"></join>
        <join expr="RC_COMPONENT_CTX.RC_TYPE_FLG == CI_LOOKUP_VAL_L_4.FIELD_VALUE" left="RC_COMPONENT_CTX" right="CI_LOOKUP_VAL_L_4" type="leftOuter" weight="1"></join>
      </joinList>
