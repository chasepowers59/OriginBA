  <resources>
    <jdbcQuery id="CI_TD_ENTRY" datasourceId="Origin_DEV_DS">
      <fieldList>
        <field id="TD_ENTRY_ID" type="java.lang.String"></field>
        <field id="BATCH_CD" type="java.lang.String"></field>
        <field id="BATCH_NBR" type="java.math.BigDecimal"></field>
        <field id="MESSAGE_CAT_NBR" type="java.math.BigDecimal"></field>
        <field id="MESSAGE_NBR" type="java.math.BigDecimal"></field>
        <field id="ASSIGNED_TO" type="java.lang.String"></field>
        <field id="TD_TYPE_CD" type="java.lang.String"></field>
        <field id="ROLE_ID" type="java.lang.String"></field>
        <field id="ENTRY_STATUS_FLG" type="java.lang.String"></field>
        <field id="CRE_DTTM" type="java.sql.Timestamp"></field>
        <field id="ASSIGNED_DTTM" type="java.sql.Timestamp"></field>
        <field id="COMPLETE_DTTM" type="java.sql.Timestamp"></field>
        <field id="COMPLETE_USER_ID" type="java.lang.String"></field>
        <field id="COMMENTS" type="java.lang.String"></field>
        <field id="ASSIGNED_USER_ID" type="java.lang.String"></field>
        <field id="TD_PRIORITY_FLG" type="java.lang.String"></field>
      </fieldList>
      <query>select tde.td_entry_id, tde.batch_cd, tde.batch_nbr, tde.message_cat_nbr, tde.message_nbr, tde.assigned_to, tde.td_type_cd, tde.role_id, tde.entry_status_flg, tde.cre_dttm, tde.assigned_dttm, tde.complete_dttm, tde.complete_user_id, tde.comments, tde.assigned_user_id, tde.td_priority_flg from cisadm.ci_td_entry tde where tde.cre_dttm >= trunc(sysdate) - 365 and tde.cre_dttm &lt; trunc(sysdate) + 1 and tde.td_entry_id is not null</query>
    </jdbcQuery>

    <jdbcQuery id="CMS_TD_ENTRY_CTX_RESOLVED" datasourceId="Origin_DEV_DS">
      <fieldList>
        <field id="TD_ENTRY_ID" type="java.lang.String"></field>
        <field id="SA_ID" type="java.lang.String"></field>
        <field id="ACCT_ID_DIRECT" type="java.lang.String"></field>
        <field id="ACCT_ID_RESOLVED" type="java.lang.String"></field>
        <field id="PER_ID" type="java.lang.String"></field>
        <field id="PREM_ID" type="java.lang.String"></field>
        <field id="D1_SP_ID" type="java.lang.String"></field>
        <field id="D1_DEVICE_ID" type="java.lang.String"></field>
        <field id="MEASR_COMP_ID" type="java.lang.String"></field>
        <field id="CONTACT_ID" type="java.lang.String"></field>
        <field id="US_ID" type="java.lang.String"></field>
        <field id="ASSET_ID" type="java.lang.String"></field>
      </fieldList>
      <query>select td.td_entry_id, max(case when trim(fkr.tbl_name) = 'CI_SA' then trim(tdc.char_val_fk1) end) as sa_id, max(case when trim(fkr.tbl_name) = 'CI_ACCT' then trim(tdc.char_val_fk1) end) as acct_id_direct, coalesce(max(case when trim(fkr.tbl_name) = 'CI_ACCT' then trim(tdc.char_val_fk1) end), max(case when trim(fkr.tbl_name) = 'CI_SA' then sa.acct_id end)) as acct_id_resolved, max(case when trim(fkr.tbl_name) = 'CI_PER' then trim(tdc.char_val_fk1) end) as per_id, max(case when trim(fkr.tbl_name) = 'CI_PREM' then trim(tdc.char_val_fk1) end) as prem_id, max(case when trim(fkr.tbl_name) = 'D1_SP' then trim(tdc.char_val_fk1) end) as d1_sp_id, max(case when trim(fkr.tbl_name) = 'D1_DVC' then trim(tdc.char_val_fk1) end) as d1_device_id, max(case when trim(fkr.tbl_name) = 'D1_MEASR_COMP' then trim(tdc.char_val_fk1) end) as measr_comp_id, max(case when trim(fkr.tbl_name) = 'D1_CONTACT' then trim(tdc.char_val_fk1) end) as contact_id, max(case when trim(fkr.tbl_name) = 'D1_US' then trim(tdc.char_val_fk1) end) as us_id, max(case when trim(fkr.tbl_name) = 'W1_ASSET' then trim(tdc.char_val_fk1) end) as asset_id from cisadm.ci_td_entry td left join cisadm.ci_td_entry_cha tdc on tdc.td_entry_id = td.td_entry_id left join cisadm.ci_char_type ct on ct.char_type_cd = tdc.char_type_cd and ct.char_type_flg = 'FKV' left join cisadm.ci_fk_ref fkr on fkr.fk_ref_cd = ct.fk_ref_cd and trim(fkr.tbl_name) in ('CI_SA', 'CI_ACCT', 'CI_PER', 'CI_PREM', 'D1_SP', 'D1_DVC', 'D1_MEASR_COMP', 'D1_CONTACT', 'D1_US', 'W1_ASSET') left join cisadm.ci_sa sa on trim(fkr.tbl_name) = 'CI_SA' and sa.sa_id = trim(tdc.char_val_fk1) where td.cre_dttm >= trunc(sysdate) - 365 and td.cre_dttm &lt; trunc(sysdate) + 1 group by td.td_entry_id</query>
    </jdbcQuery>

    <jdbcQuery id="CMS_TD_ENTRY_TIMES" datasourceId="Origin_DEV_DS">
      <fieldList>
        <field id="TD_ENTRY_ID" type="java.lang.String"></field>
        <field id="UNASSIGNED_TM_MINS" type="java.math.BigDecimal"></field>
        <field id="ASSIGNED_TM_MINS" type="java.math.BigDecimal"></field>
        <field id="COMPLETE_TM_MINS" type="java.math.BigDecimal"></field>
        <field id="UNASSIGNED_TM_DAYS" type="java.math.BigDecimal"></field>
        <field id="ASSIGNED_TM_DAYS" type="java.math.BigDecimal"></field>
        <field id="COMPLETE_TM_DAYS" type="java.math.BigDecimal"></field>
      </fieldList>
      <query>select tde.td_entry_id, case when tde.entry_status_flg = 'O' then round(current_date - tde.cre_dttm, 2) * 24 * 60 else round(tde.assigned_dttm - tde.cre_dttm, 2) * 24 * 60 end as unassigned_tm_mins, case when tde.entry_status_flg = 'W' then round(current_date - tde.assigned_dttm, 2) * 24 * 60 when tde.entry_status_flg = 'C' then round(tde.complete_dttm - tde.assigned_dttm, 2) * 24 * 60 else 0 end as assigned_tm_mins, case when tde.entry_status_flg = 'C' then round(tde.complete_dttm - tde.cre_dttm, 2) * 24 * 60 else 0 end as complete_tm_mins, case when tde.entry_status_flg = 'O' then round(current_date - tde.cre_dttm, 0) else round(tde.assigned_dttm - tde.cre_dttm, 0) end as unassigned_tm_days, case when tde.entry_status_flg = 'W' then round(current_date - tde.assigned_dttm, 0) when tde.entry_status_flg = 'C' then round(tde.complete_dttm - tde.assigned_dttm, 0) else 0 end as assigned_tm_days, case when tde.entry_status_flg = 'C' then round(tde.complete_dttm - tde.cre_dttm, 0) else 0 end as complete_tm_days from cisadm.ci_td_entry tde where tde.cre_dttm >= trunc(sysdate) - 365 and tde.cre_dttm &lt; trunc(sysdate) + 1</query>
    </jdbcQuery>

