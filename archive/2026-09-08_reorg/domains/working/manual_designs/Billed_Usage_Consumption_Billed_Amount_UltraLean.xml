  <resources>
    <jdbcQuery id="C1_BI_BILLED_USAGE_VW" datasourceId="Origin_DEV_DS">
      <fieldList>
        <field id="BILL_ID" type="java.lang.String"></field>
        <field id="BSEG_ID" type="java.lang.String"></field>
        <field id="SA_ID" type="java.lang.String"></field>
        <field id="ACCT_ID" type="java.lang.String"></field>
        <field id="RS_CD" type="java.lang.String"></field>
        <field id="UOM_CD" type="java.lang.String"></field>
        <field id="TOU_CD" type="java.lang.String"></field>
        <field id="SQI_CD" type="java.lang.String"></field>
        <field id="FT_TYPE_FLG" type="java.lang.String"></field>
        <field id="ACCOUNTING_DT" type="java.sql.Timestamp"></field>
        <field id="BSEG_START_DT" type="java.sql.Timestamp"></field>
        <field id="BSEG_END_DT" type="java.sql.Timestamp"></field>
        <field id="BILL_SQ" type="java.math.BigDecimal"></field>
        <field id="BILLED_AMT" type="java.math.BigDecimal"></field>
      </fieldList>
      <query>select u.bill_id,
       u.bseg_id,
       u.sa_id,
       u.acct_id,
       u.rs_cd,
       u.uom_cd,
       u.tou_cd,
       u.sqi_cd,
       u.ft_type_flg,
       u.accounting_dt,
       u.bseg_start_dt,
       u.bseg_end_dt,
       u.bill_sq,
       u.billed_amt
from cisadm.c1_bi_billed_usage_vw u
where u.accounting_dt &gt;= add_months(trunc(sysdate), -6)
  and u.accounting_dt &lt; trunc(sysdate) + 1
  and u.bill_id is not null
  and u.bseg_id is not null
  and u.rs_cd is not null</query>
    </jdbcQuery>

    <jdbcTable id="CI_ACCT" datasourceId="Origin_DEV_DS" datasourceTableName="CI_ACCT" schemaAlias="CISADM">
      <fieldList>
        <field id="ACCT_ID" type="java.lang.String"></field>
        <field id="CUST_CL_CD" type="java.lang.String"></field>
        <field id="COLL_CL_CD" type="java.lang.String"></field>
      </fieldList>
    </jdbcTable>

    <jdbcTable id="CI_CUST_CL_L" datasourceId="Origin_DEV_DS" datasourceTableName="CI_CUST_CL_L" schemaAlias="CISADM">
      <fieldList>
        <field id="CUST_CL_CD" type="java.lang.String"></field>
        <field id="LANGUAGE_CD" type="java.lang.String"></field>
        <field id="DESCR" type="java.lang.String"></field>
      </fieldList>
    </jdbcTable>

    <jdbcTable id="CI_COLL_CL_L" datasourceId="Origin_DEV_DS" datasourceTableName="CI_COLL_CL_L" schemaAlias="CISADM">
      <fieldList>
        <field id="COLL_CL_CD" type="java.lang.String"></field>
        <field id="LANGUAGE_CD" type="java.lang.String"></field>
        <field id="DESCR" type="java.lang.String"></field>
      </fieldList>
    </jdbcTable>

    <jdbcTable id="JoinTree_1" datasourceId="Origin_DEV_DS" datasourceTableName="C1_BI_BILLED_USAGE_VW" schemaAlias="CISADM">
      <fieldList>
        <field id="C1_BI_BILLED_USAGE_VW.BILL_ID" type="java.lang.String"></field>
        <field id="C1_BI_BILLED_USAGE_VW.BSEG_ID" type="java.lang.String"></field>
        <field id="C1_BI_BILLED_USAGE_VW.SA_ID" type="java.lang.String"></field>
        <field id="C1_BI_BILLED_USAGE_VW.ACCT_ID" type="java.lang.String"></field>
        <field id="C1_BI_BILLED_USAGE_VW.RS_CD" type="java.lang.String"></field>
        <field id="C1_BI_BILLED_USAGE_VW.UOM_CD" type="java.lang.String"></field>
        <field id="C1_BI_BILLED_USAGE_VW.TOU_CD" type="java.lang.String"></field>
        <field id="C1_BI_BILLED_USAGE_VW.SQI_CD" type="java.lang.String"></field>
        <field id="C1_BI_BILLED_USAGE_VW.FT_TYPE_FLG" type="java.lang.String"></field>
        <field id="C1_BI_BILLED_USAGE_VW.ACCOUNTING_DT" type="java.sql.Timestamp"></field>
        <field id="C1_BI_BILLED_USAGE_VW.BSEG_START_DT" type="java.sql.Timestamp"></field>
        <field id="C1_BI_BILLED_USAGE_VW.BSEG_END_DT" type="java.sql.Timestamp"></field>
        <field id="C1_BI_BILLED_USAGE_VW.BILL_SQ" type="java.math.BigDecimal"></field>
        <field id="C1_BI_BILLED_USAGE_VW.BILLED_AMT" type="java.math.BigDecimal"></field>

        <field id="CI_ACCT.ACCT_ID" type="java.lang.String"></field>
        <field id="CI_ACCT.CUST_CL_CD" type="java.lang.String"></field>
        <field id="CI_ACCT.COLL_CL_CD" type="java.lang.String"></field>

        <field id="CI_CUST_CL_L.CUST_CL_CD" type="java.lang.String"></field>
        <field id="CI_CUST_CL_L.LANGUAGE_CD" type="java.lang.String"></field>
        <field id="CI_CUST_CL_L.DESCR" type="java.lang.String"></field>

        <field id="CI_COLL_CL_L.COLL_CL_CD" type="java.lang.String"></field>
        <field id="CI_COLL_CL_L.LANGUAGE_CD" type="java.lang.String"></field>
        <field id="CI_COLL_CL_L.DESCR" type="java.lang.String"></field>
      </fieldList>

      <joinInfo alias="C1_BI_BILLED_USAGE_VW" referenceId="C1_BI_BILLED_USAGE_VW"></joinInfo>
      <joinList>
        <join expr="C1_BI_BILLED_USAGE_VW.ACCT_ID == CI_ACCT.ACCT_ID" left="C1_BI_BILLED_USAGE_VW" right="CI_ACCT" type="leftOuter" weight="1"></join>
        <join expr="CI_ACCT.CUST_CL_CD == CI_CUST_CL_L.CUST_CL_CD and CI_CUST_CL_L.LANGUAGE_CD == 'ENG'" left="CI_ACCT" right="CI_CUST_CL_L" type="leftOuter" weight="1"></join>
        <join expr="CI_ACCT.COLL_CL_CD == CI_COLL_CL_L.COLL_CL_CD and CI_COLL_CL_L.LANGUAGE_CD == 'ENG'" left="CI_ACCT" right="CI_COLL_CL_L" type="leftOuter" weight="1"></join>
      </joinList>
      <joinOptions></joinOptions>
      <tableRefList>
        <tableRef alwaysIncludeTable="false" tableAlias="C1_BI_BILLED_USAGE_VW" tableId="C1_BI_BILLED_USAGE_VW"></tableRef>
        <tableRef alwaysIncludeTable="false" tableAlias="CI_ACCT" tableId="CI_ACCT"></tableRef>
        <tableRef alwaysIncludeTable="false" tableAlias="CI_CUST_CL_L" tableId="CI_CUST_CL_L"></tableRef>
        <tableRef alwaysIncludeTable="false" tableAlias="CI_COLL_CL_L" tableId="CI_COLL_CL_L"></tableRef>
      </tableRefList>
    </jdbcTable>
  </resources>
</schema>
