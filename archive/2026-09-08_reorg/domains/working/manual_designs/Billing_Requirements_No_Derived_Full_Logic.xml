        <field id="BILL_DT" type="java.sql.Timestamp"></field>
        <field id="CRE_DTTM" type="java.sql.Timestamp"></field>
        <field id="COMPLETE_DTTM" type="java.sql.Timestamp"></field>
        <field id="DUE_DT" type="java.sql.Timestamp"></field>
      </fieldList>
      <query>select bill.bill_id,
       bill.acct_id,
       bill.bill_cyc_cd,
       bill.bill_stat_flg,
       bill.bill_dt,
       bill.cre_dttm,
       bill.complete_dttm,
       bill.due_dt
from cisadm.ci_bill bill
where bill.bill_dt &gt;= date '2025-09-01'</query>
    </jdbcQuery>
