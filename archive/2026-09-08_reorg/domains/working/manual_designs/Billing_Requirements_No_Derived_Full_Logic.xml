        <field id="STAT_CHG_DTTM" type="java.sql.Timestamp"></field>
        <field id="CAN_RSN_CD" type="java.lang.String"></field>
        <field id="CAN_BSEG_ID" type="java.lang.String"></field>
        <field id="REBILL_SEG_ID" type="java.lang.String"></field>
      </fieldList>
      <query>select bseg.bseg_id,
       bseg.bill_id,
       bseg.bill_cyc_cd,
       bseg.sa_id,
       bseg.prem_id,
       bseg.bseg_stat_flg,
       bseg.cre_dttm,
       bseg.stat_chg_dttm,
       bseg.can_rsn_cd,
       bseg.can_bseg_id,
       bseg.rebill_seg_id
from cisadm.ci_bseg bseg
where bseg.cre_dttm &gt;= date '2025-09-01'</query>
    </jdbcQuery>
    <jdbcQuery id="CI_BILL" datasourceId="Origin_DEV_DS">
      <fieldList>
        <field id="BILL_ID" type="java.lang.String"></field>
