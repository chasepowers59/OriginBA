        <field id="UOM_CD" type="java.lang.String" />
        <field id="TOU_CD" type="java.lang.String" />
        <field id="SQI_CD" type="java.lang.String" />
        <field id="FT_TYPE_FLG" type="java.lang.String" />
        <field id="ACCOUNTING_DT" type="java.sql.Timestamp" />
      </fieldList>
      <query>select u.bill_id,
       u.bseg_id,
       u.sa_id,
       u.acct_id,
       u.rs_cd,
       u.uom_cd,
       u.tou_cd,
       u.sqi_cd,
       u.ft_type_flg,
       u.accounting_dt
from cisadm.c1_bi_billed_usage_vw u
where u.accounting_dt &gt;= add_months(trunc(sysdate), -6)
  and u.accounting_dt &lt; trunc(sysdate) + 1
  and u.bill_id is not null
  and u.bseg_id is not null
  and u.rs_cd is not null</query>
    </jdbcQuery>
    <jdbcQuery id="RC_COMPONENT_CTX" datasourceId="Origin_DEV_DS">
      <fieldList>
        <field id="BSEG_ID" type="java.lang.String" />
        <field id="UOM_CD" type="java.lang.String" />
        <field id="TOU_CD" type="java.lang.String" />
        <field id="SQI_CD" type="java.lang.String" />
        <field id="RC_SEQ" type="java.math.BigDecimal" />
        <field id="DESCR_ON_BILL" type="java.lang.String" />
        <field id="CALC_AMT" type="java.math.BigDecimal" />
        <field id="BILL_SQ" type="java.math.BigDecimal" />
        <field id="RC_TYPE_FLG" type="java.lang.String" />
        <field id="RC_DESCR" type="java.lang.String" />
        <field id="UOM_DESCR" type="java.lang.String" />
        <field id="TOU_DESCR" type="java.lang.String" />
        <field id="SQI_DESCR" type="java.lang.String" />
        <field id="COMPONENT_AMT_GROSS" type="java.math.BigDecimal" />
        <field id="COMPONENT_AMT_CREDITS" type="java.math.BigDecimal" />
        <field id="COMPONENT_AMT_NET" type="java.math.BigDecimal" />
        <field id="COMPONENT_QTY_GROSS" type="java.math.BigDecimal" />
        <field id="COMPONENT_QTY_REVERSAL" type="java.math.BigDecimal" />
        <field id="COMPONENT_QTY_NET" type="java.math.BigDecimal" />
      </fieldList>
      <query>select bcl.bseg_id,
       bcl.uom_cd,
       bcl.tou_cd,
       bcl.sqi_cd,
       bcl.rc_seq,
       bcl.descr_on_bill,
       bcl.calc_amt,
       bcl.bill_sq,
       rc.rc_type_flg,
       rcl.descr as rc_descr,
       uom.descr100 as uom_descr,
       tou.descr100 as tou_descr,
       sqi.descr100 as sqi_descr,
       case when bcl.calc_amt &gt; 0 then bcl.calc_amt else 0 end as component_amt_gross,
       case when bcl.calc_amt &lt; 0 then -1 * bcl.calc_amt else 0 end as component_amt_credits,
       bcl.calc_amt as component_amt_net,
       case when bcl.bill_sq &gt; 0 then bcl.bill_sq else 0 end as component_qty_gross,
       case when bcl.bill_sq &lt; 0 then -1 * bcl.bill_sq else 0 end as component_qty_reversal,
       bcl.bill_sq as component_qty_net
  from cisadm.ci_bseg_calc_ln bcl
  join (
      select distinct v.bseg_id
        from cisadm.c1_bi_billed_usage_vw v
       where v.accounting_dt &gt;= add_months(trunc(sysdate), -6)
         and v.accounting_dt &lt; trunc(sysdate) + 1
         and v.bseg_id is not null
  ) uk
    on uk.bseg_id = bcl.bseg_id
  join cisadm.ci_bseg_calc bc
    on bc.bseg_id = bcl.bseg_id
   and bc.header_seq = bcl.header_seq
  left join cisadm.ci_rc rc
    on rc.rs_cd = bc.rs_cd
   and rc.rc_seq = bcl.rc_seq
   and rc.effdt = bc.effdt
  left join cisadm.ci_rc_l rcl
    on rcl.rs_cd = rc.rs_cd
   and rcl.rc_seq = rc.rc_seq
   and rcl.effdt = rc.effdt
   and rcl.language_cd = 'ENG'
  left join cisadm.d1_uom_l uom
    on uom.d1_uom_cd = bcl.uom_cd
   and uom.language_cd = 'ENG'
  left join cisadm.d1_tou_l tou
    on tou.d1_tou_cd = bcl.tou_cd
   and tou.language_cd = 'ENG'
  left join cisadm.d1_sqi_l sqi
    on sqi.d1_sqi_cd = bcl.sqi_cd
   and sqi.language_cd = 'ENG'</query>
    </jdbcQuery>
