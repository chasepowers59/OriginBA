# The deployed FastAPI backend the portal talks to (NOT Vercel — see DEPLOYMENT.md).
# Client + server components both read this.
NEXT_PUBLIC_API_URL=https://originba-api.<your-backend-host>

# Optional: https origins (space-separated) allowed to frame embedded views (/embed/<token>).
# Unset: only the portal itself may frame them. Every other page refuses framing.
# EMBED_ALLOWED_ORIGINS=https://www.city.gov https://intranet.city.gov

# Optional: disable auth in a throwaway preview only. NEVER set true in production.
# NEXT_PUBLIC_PORTAL_AUTH_DISABLED=false
