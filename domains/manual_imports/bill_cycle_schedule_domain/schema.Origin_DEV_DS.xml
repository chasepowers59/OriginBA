        <field id="WINDOW_DAYS" dataSetExpression="ElapsedDays(CI_BILL_CYC_SCH.WIN_END_DT, CI_BILL_CYC_SCH.WIN_START_DT)" type="java.math.BigDecimal"></field>
        <field id="DAYS_WINDOW_END_TO_LAST_COMPLETE" dataSetExpression="ElapsedDays(WINDOW_BILLS.LAST_COMPLETE_DTTM, CI_BILL_CYC_SCH.WIN_END_DT)" type="java.math.BigDecimal"></field>
        <field id="DAYS_ESTIMATE_TO_ACCOUNTING" dataSetExpression="ElapsedDays(CI_BILL_CYC_SCH.ACCOUNTING_DT, CI_BILL_CYC_SCH.EST_DT)" type="java.math.BigDecimal"></field>
        <field id="ACCOUNTS_NOT_BILLED" dataSetExpression="CYCLE_ACCOUNTS.ACTIVE_ACCOUNT_COUNT - WINDOW_BILLS.ACCOUNTS_BILLED" type="java.lang.Long"></field>
        <field id="FROZEN_BUT_PENDING_BILLS" dataSetExpression="CaseWhen(CI_BILL_CYC_SCH.FREEZE_COMPLETE_SW == 'Y' and WINDOW_BILLS.PENDING_COUNT &gt; 0, 'Y', 'N')" type="java.lang.String"></field>
        <field id="HAS_OPEN_SEGMENTS" dataSetExpression="CaseWhen(WINDOW_BSEG.OPEN_BSEG_COUNT &gt; 0, 'Y', 'N')" type="java.lang.String"></field>
        <field id="HAS_EXCEPTIONS" dataSetExpression="CaseWhen(WINDOW_BSEG.BSEG_WITH_EXCEPTION_COUNT &gt; 0, 'Y', 'N')" type="java.lang.String"></field>
      </fieldList>
      <joinInfo alias="CI_BILL_CYC_SCH" referenceId="CI_BILL_CYC_SCH"></joinInfo>
      <joinList>
        <join expr="CI_BILL_CYC_SCH.BILL_CYC_CD == CI_BILL_CYC_L.BILL_CYC_CD and CI_BILL_CYC_L.LANGUAGE_CD == 'ENG'" left="CI_BILL_CYC_SCH" right="CI_BILL_CYC_L" type="leftOuter" weight="1"></join>
        <join expr="CI_BILL_CYC_SCH.BILL_CYC_CD == WINDOW_BILLS.BILL_CYC_CD and CI_BILL_CYC_SCH.WIN_START_DT == WINDOW_BILLS.WIN_START_DT" left="CI_BILL_CYC_SCH" right="WINDOW_BILLS" type="leftOuter" weight="1"></join>
        <join expr="CI_BILL_CYC_SCH.BILL_CYC_CD == CYCLE_ACCOUNTS.BILL_CYC_CD" left="CI_BILL_CYC_SCH" right="CYCLE_ACCOUNTS" type="leftOuter" weight="1"></join>
        <join expr="CI_BILL_CYC_SCH.BILL_CYC_CD == WINDOW_BSEG.BILL_CYC_CD and CI_BILL_CYC_SCH.WIN_START_DT == WINDOW_BSEG.WIN_START_DT" left="CI_BILL_CYC_SCH" right="WINDOW_BSEG" type="leftOuter" weight="1"></join>
        <join expr="CI_BILL_CYC_SCH.BILL_CYC_CD == WINDOW_AGE.BILL_CYC_CD and CI_BILL_CYC_SCH.WIN_START_DT == WINDOW_AGE.WIN_START_DT" left="CI_BILL_CYC_SCH" right="WINDOW_AGE" type="leftOuter" weight="1"></join>
      </joinList>
