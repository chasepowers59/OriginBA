        <field id="WINDOW_BILLS.LAST_COMPLETE_DTTM" type="java.sql.Timestamp"></field>
        <field id="WINDOW_BILLS.FIRST_BILL_DT" type="java.sql.Timestamp"></field>
        <field id="WINDOW_BILLS.LAST_DUE_DT" type="java.sql.Timestamp"></field>
        <field id="CYCLE_ACCOUNTS.BILL_CYC_CD" type="java.lang.String"></field>
        <field id="CYCLE_ACCOUNTS.ACCOUNT_COUNT" type="java.lang.Long"></field>
        <field id="CYCLE_ACCOUNTS.ACTIVE_ACCOUNT_COUNT" type="java.lang.Long"></field>
        <field id="WINDOW_BSEG.BILL_CYC_CD" type="java.lang.String"></field>
        <field id="WINDOW_BSEG.WIN_START_DT" type="java.sql.Timestamp"></field>
        <field id="WINDOW_BSEG.BSEG_COUNT" type="java.lang.Long"></field>
        <field id="WINDOW_BSEG.FROZEN_BSEG_COUNT" type="java.lang.Long"></field>
        <field id="WINDOW_BSEG.CANCELED_BSEG_COUNT" type="java.lang.Long"></field>
        <field id="WINDOW_BSEG.OPEN_BSEG_COUNT" type="java.lang.Long"></field>
        <field id="WINDOW_BSEG.ESTIMATED_BSEG_COUNT" type="java.lang.Long"></field>
        <field id="WINDOW_BSEG.BSEG_WITH_EXCEPTION_COUNT" type="java.lang.Long"></field>
        <field id="WINDOW_BSEG.SA_COUNT" type="java.lang.Long"></field>
        <field id="WINDOW_AGE.BILL_CYC_CD" type="java.lang.String"></field>
        <field id="WINDOW_AGE.WIN_START_DT" type="java.sql.Timestamp"></field>
        <field id="WINDOW_AGE.DAYS_SINCE_WINDOW_END" type="java.math.BigDecimal"></field>
        <field id="WINDOW_AGE.WINDOW_IS_PAST" type="java.lang.String"></field>
        <field id="WINDOW_AGE.PAST_AND_NOT_FROZEN" type="java.lang.String"></field>
