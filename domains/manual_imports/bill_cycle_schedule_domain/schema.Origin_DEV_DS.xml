    <jdbcTable id="CI_BILL_CYC_SCH" datasourceId="Origin_DEV_DS" datasourceTableName="CI_BILL_CYC_SCH" schemaAlias="CISADM">
      <fieldList>
        <field id="BILL_CYC_CD" type="java.lang.String"></field>
        <field id="WIN_START_DT" type="java.sql.Timestamp"></field>
        <field id="WIN_END_DT" type="java.sql.Timestamp"></field>
        <field id="ACCOUNTING_DT" type="java.sql.Timestamp"></field>
