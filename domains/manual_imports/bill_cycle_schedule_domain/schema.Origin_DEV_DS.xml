        <field id="CI_BILL_CYC_L.DESCR" type="java.lang.String"></field>
        <field id="WINDOW_BILLS.BILL_CYC_CD" type="java.lang.String"></field>
        <field id="WINDOW_BILLS.WIN_START_DT" type="java.sql.Timestamp"></field>
        <field id="WINDOW_BILLS.BILL_COUNT" type="java.lang.Long"></field>
        <field id="WINDOW_BILLS.COMPLETED_COUNT" type="java.lang.Long"></field>
        <field id="WINDOW_BILLS.PENDING_COUNT" type="java.lang.Long"></field>
        <field id="WINDOW_BILLS.ACCOUNTS_BILLED" type="java.lang.Long"></field>
