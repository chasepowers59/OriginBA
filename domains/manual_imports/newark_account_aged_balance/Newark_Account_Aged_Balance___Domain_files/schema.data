    <jdbcTable id="JoinTree_1" datasourceId="Newark1_DS" datasourceTableName="CI_ACCT" schemaAlias="CISADM">
      <fieldList>
        <field id="NEWARK_REP8_BUCKETS.ACCT_ID" type="java.lang.String"></field>
        <field id="NEWARK_REP8_BUCKETS.RPT_DT" type="java.sql.Timestamp"></field>
        <field id="NEWARK_REP8_BUCKETS.CURRENT_BAL" type="java.math.BigDecimal"></field>
