        <field id="NEWARK_REP8_BUCKETS.ARREARS_30_PRINCIPAL" type="java.math.BigDecimal"></field>
        <field id="NEWARK_REP8_BUCKETS.ARREARS_30_INTEREST" type="java.math.BigDecimal"></field>
        <field id="NEWARK_REP8_BUCKETS.ARREARS_60_PRINCIPAL" type="java.math.BigDecimal"></field>
        <field id="NEWARK_REP8_BUCKETS.ARREARS_60_INTEREST" type="java.math.BigDecimal"></field>
        <field id="NEWARK_REP8_BUCKETS.ARREARS_90_PRINCIPAL" type="java.math.BigDecimal"></field>
        <field id="NEWARK_REP8_BUCKETS.ARREARS_90_INTEREST" type="java.math.BigDecimal"></field>
        <field id="NEWARK_REP8_BUCKETS.ARREARS_TOTAL" type="java.math.BigDecimal"></field>
        <field id="NEWARK_PREM_CHARS.LOT" type="java.lang.String"></field>
        <field id="NEWARK_PREM_CHARS.LOTSUFF" type="java.lang.String"></field>
        <field id="NEWARK_PREM_CHARS.BLOCK" type="java.lang.String"></field>
        <field id="NEWARK_PREM_CHARS.BLOCKSUF" type="java.lang.String"></field>
        <field id="NEWARK_PREM_CHARS.BLOCK_LOT" type="java.lang.String"></field>
        <field id="NEWARK_PREM_CHARS.QLFR" type="java.lang.String"></field>
        <field id="NEWARK_PREM_CHARS.WARD" type="java.lang.String"></field>
        <field id="CI_ACCT_REP8.COLL_CL_CD" type="java.lang.String"></field>
        <field id="CI_ACCT_REP8.BILL_CYC_CD" type="java.lang.String"></field>
        <field id="CI_ACCT_REP8.MAILING_PREM_ID" type="java.lang.String"></field>
        <field id="CI_PREM_SVC.ADDRESS1" type="java.lang.String"></field>
        <field id="CI_PREM_SVC.ADDRESS2" type="java.lang.String"></field>
        <field id="CI_PREM_SVC.POSTAL" type="java.lang.String"></field>
        <field id="CI_PREM_MAIL.ADDRESS1" type="java.lang.String"></field>
        <field id="CI_PREM_MAIL.CITY" type="java.lang.String"></field>
        <field id="CI_PREM_MAIL.STATE" type="java.lang.String"></field>
        <field id="CI_PREM_MAIL.POSTAL" type="java.lang.String"></field>
        <field id="CI_PER_NAME_REP8.ENTITY_NAME" type="java.lang.String"></field>
        <field id="CI_PER_PHONE.PHONE" type="java.lang.String"></field>
        <field id="NEWARK_LATEST_PAY.LATEST_PAY_DT" type="java.sql.Timestamp"></field>
        <field id="NEWARK_PA_FLAG.PA_FLAG" type="java.lang.String"></field>
        <field id="REP8_ARREARS_30" dataSetExpression="NEWARK_REP8_BUCKETS.ARREARS_30_PRINCIPAL + NEWARK_REP8_BUCKETS.ARREARS_30_INTEREST" type="java.math.BigDecimal"></field>
        <field id="REP8_ARREARS_60" dataSetExpression="NEWARK_REP8_BUCKETS.ARREARS_60_PRINCIPAL + NEWARK_REP8_BUCKETS.ARREARS_60_INTEREST" type="java.math.BigDecimal"></field>
        <field id="REP8_ARREARS_90" dataSetExpression="NEWARK_REP8_BUCKETS.ARREARS_90_PRINCIPAL + NEWARK_REP8_BUCKETS.ARREARS_90_INTEREST" type="java.math.BigDecimal"></field>
      </fieldList>
      <joinInfo alias="CI_ACCT_REP8" referenceId="CI_ACCT_REP8"></joinInfo>
      <joinList>
        <join expr="CI_ACCT_REP8.ACCT_ID == NEWARK_REP8_BUCKETS.ACCT_ID" left="CI_ACCT_REP8" right="NEWARK_REP8_BUCKETS" type="inner" weight="1"></join>
        <join expr="CI_ACCT_REP8.ACCT_ID == NEWARK_ACCT_MAIN_PER.ACCT_ID" left="CI_ACCT_REP8" right="NEWARK_ACCT_MAIN_PER" type="leftOuter" weight="1"></join>
        <join expr="NEWARK_ACCT_MAIN_PER.PER_ID == CI_PER_NAME_REP8.PER_ID" left="NEWARK_ACCT_MAIN_PER" right="CI_PER_NAME_REP8" type="leftOuter" weight="1"></join>
        <join expr="CI_ACCT_REP8.ACCT_ID == NEWARK_ACCT_SVC_PREM.ACCT_ID" left="CI_ACCT_REP8" right="NEWARK_ACCT_SVC_PREM" type="leftOuter" weight="1"></join>
        <join expr="NEWARK_ACCT_SVC_PREM.PREM_ID == CI_PREM_SVC.PREM_ID" left="NEWARK_ACCT_SVC_PREM" right="CI_PREM_SVC" type="leftOuter" weight="1"></join>
        <join expr="NEWARK_ACCT_SVC_PREM.PREM_ID == NEWARK_PREM_CHARS.PREM_ID" left="NEWARK_ACCT_SVC_PREM" right="NEWARK_PREM_CHARS" type="leftOuter" weight="1"></join>
        <join expr="CI_ACCT_REP8.MAILING_PREM_ID == CI_PREM_MAIL.PREM_ID" left="CI_ACCT_REP8" right="CI_PREM_MAIL" type="leftOuter" weight="1"></join>
        <join expr="NEWARK_ACCT_MAIN_PER.PER_ID == CI_PER_PHONE.PER_ID" left="NEWARK_ACCT_MAIN_PER" right="CI_PER_PHONE" type="leftOuter" weight="1"></join>
        <join expr="CI_ACCT_REP8.ACCT_ID == NEWARK_LATEST_PAY.ACCT_ID" left="CI_ACCT_REP8" right="NEWARK_LATEST_PAY" type="leftOuter" weight="1"></join>
        <join expr="CI_ACCT_REP8.ACCT_ID == NEWARK_PA_FLAG.ACCT_ID" left="CI_ACCT_REP8" right="NEWARK_PA_FLAG" type="leftOuter" weight="1"></join>
      </joinList>
      <joinOptions></joinOptions>
