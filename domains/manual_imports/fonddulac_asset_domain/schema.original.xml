        <field id="EQPMNT_CNT" type="java.math.BigDecimal"></field>
        <field id="BO_DATA_AREA" type="java.lang.String"></field>
        <field id="D1_SP_TYPE_CD" type="java.lang.String"></field>
        <field id="BO_STATUS_CD" type="java.lang.String"></field>
        <field id="SP_DESCR" type="java.lang.String"></field>
        <field id="MSRMT_CYC_CD" type="java.lang.String"></field>
        <field id="MSRMT_CYC_RTE_CD" type="java.lang.String"></field>
        <field id="MSRMT_CYC_RTE_SEQ" type="java.math.BigDecimal"></field>
        <field id="ADDRESS1" type="java.lang.String"></field>
        <field id="COUNTRY" type="java.lang.String"></field>
        <field id="POSTAL" type="java.lang.String"></field>
        <field id="TIME_ZONE_CD" type="java.lang.String"></field>
        <field id="CITY" type="java.lang.String"></field>
        <field id="COUNTY" type="java.lang.String"></field>
        <field id="STATE" type="java.lang.String"></field>
        <field id="SP_SRC_STAT_FLG" type="java.lang.String"></field>
        <field id="DIVISION_CD" type="java.lang.String"></field>
        <field id="SP_ID_TYPE_FLG" type="java.lang.String"></field>
      </fieldList>
      <query>SELECT
SPE.D1_DEVICE_ID ,
SPE.D1_INSTALL_DTTM ,
SPE.D1_REMOVAL_DTTM ,
SPE.COMMENTS ,
SPE.VERSION ,
SPE.EQPMNT_CNT ,
SPE.BO_DATA_AREA ,
SP.D1_SP_ID ,
SPID.ID_VALUE            ,
SPID.SP_ID_TYPE_FLG,
SP.D1_SP_TYPE_CD         ,
SP.BO_STATUS_CD          ,
SPTL.DESCR100 AS SP_DESCR,
DTL.DEVICE_TYPE_CD       ,
DTL. DESCR100            ,
SP.MSRMT_CYC_CD          ,
SP.MSRMT_CYC_RTE_CD      ,
SP.MSRMT_CYC_RTE_SEQ     ,
SP.ADDRESS1              ,
SP.COUNTRY               ,
SP.POSTAL                ,
SP.TIME_ZONE_CD          ,
SP.CITY                  ,
SP.COUNTY                ,
SP.STATE                 ,
SP.SP_SRC_STAT_FLG       ,
SP.DIVISION_CD
FROM
CISADM.D1_SP            SP   ,
CISADM.D1_SP_TYPE_L     SPTL ,
CISADM.D1_SP_IDENTIFIER SPID
LEFT JOIN 
    CISADM.D1_SP_EQPMNT SPE ON SPID.D1_SP_ID = SPE.D1_SP_ID
LEFT JOIN
    CISADM.D1_DVC D ON SPE.D1_DEVICE_ID = D.D1_DEVICE_ID
LEFT JOIN
    CISADM.D1_DVC_TYPE_L DTL ON D.DEVICE_TYPE_CD = DTL.DEVICE_TYPE_CD
WHERE
        SPID.D1_SP_ID       = SP.D1_SP_ID
AND     SPTL.D1_SP_TYPE_CD  = SP.D1_SP_TYPE_CD
AND     SPID.SP_ID_TYPE_FLG = 'D1OI'</query>
    </jdbcQuery>
