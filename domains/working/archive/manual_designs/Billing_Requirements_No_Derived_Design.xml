  <resources>
    <jdbcTable id="CI_BSEG" datasourceId="Origin_DEV_DS" datasourceTableName="CI_BSEG" schemaAlias="CISADM">
      <fieldList>
        <field id="BSEG_ID" type="java.lang.String"></field>
        <field id="BILL_ID" type="java.lang.String"></field>
        <field id="SA_ID" type="java.lang.String"></field>
        <field id="PREM_ID" type="java.lang.String"></field>
        <field id="REBILL_SEG_ID" type="java.lang.String"></field>
        <field id="BILL_CYC_CD" type="java.lang.String"></field>
        <field id="BSEG_STAT_FLG" type="java.lang.String"></field>
        <field id="CRE_DTTM" type="java.sql.Timestamp"></field>
      </fieldList>
    </jdbcTable>

    <jdbcTable id="CI_BILL" datasourceId="Origin_DEV_DS" datasourceTableName="CI_BILL" schemaAlias="CISADM">
      <fieldList>
        <field id="BILL_ID" type="java.lang.String"></field>
        <field id="ACCT_ID" type="java.lang.String"></field>
        <field id="BILL_CYC_CD" type="java.lang.String"></field>
        <field id="BILL_STAT_FLG" type="java.lang.String"></field>
        <field id="BILL_DT" type="java.sql.Timestamp"></field>
        <field id="CRE_DTTM" type="java.sql.Timestamp"></field>
      </fieldList>
    </jdbcTable>

    <jdbcTable id="CI_SA" datasourceId="Origin_DEV_DS" datasourceTableName="CI_SA" schemaAlias="CISADM">
      <fieldList>
        <field id="SA_ID" type="java.lang.String"></field>
        <field id="ACCT_ID" type="java.lang.String"></field>
        <field id="SA_STATUS_FLG" type="java.lang.String"></field>
      </fieldList>
    </jdbcTable>

    <jdbcTable id="CI_ACCT" datasourceId="Origin_DEV_DS" datasourceTableName="CI_ACCT" schemaAlias="CISADM">
      <fieldList>
        <field id="ACCT_ID" type="java.lang.String"></field>
        <field id="BILL_CYC_CD" type="java.lang.String"></field>
      </fieldList>
    </jdbcTable>

    <jdbcTable id="CI_BILL_CYC_L" datasourceId="Origin_DEV_DS" datasourceTableName="CI_BILL_CYC_L" schemaAlias="CISADM">
      <fieldList>
        <field id="BILL_CYC_CD" type="java.lang.String"></field>
        <field id="LANGUAGE_CD" type="java.lang.String"></field>
        <field id="DESCR" type="java.lang.String"></field>
      </fieldList>
    </jdbcTable>

    <jdbcTable id="CI_LOOKUP_VAL_L" datasourceId="Origin_DEV_DS" datasourceTableName="CI_LOOKUP_VAL_L" schemaAlias="CISADM">
      <fieldList>
        <field id="FIELD_NAME" type="java.lang.String"></field>
        <field id="FIELD_VALUE" type="java.lang.String"></field>
        <field id="LANGUAGE_CD" type="java.lang.String"></field>
        <field id="DESCR" type="java.lang.String"></field>
      </fieldList>
    </jdbcTable>

    <jdbcTable id="CI_LOOKUP_VAL_L_1" datasourceId="Origin_DEV_DS" datasourceTableName="CI_LOOKUP_VAL_L" schemaAlias="CISADM">
      <fieldList>
        <field id="FIELD_NAME" type="java.lang.String"></field>
        <field id="FIELD_VALUE" type="java.lang.String"></field>
        <field id="LANGUAGE_CD" type="java.lang.String"></field>
        <field id="DESCR" type="java.lang.String"></field>
      </fieldList>
    </jdbcTable>

    <jdbcTable id="JoinTree_1" datasourceId="Origin_DEV_DS" datasourceTableName="CI_BSEG" schemaAlias="CISADM">
      <fieldList>
        <field id="CI_BSEG.BSEG_ID" type="java.lang.String"></field>
        <field id="CI_BSEG.BILL_ID" type="java.lang.String"></field>
        <field id="CI_BSEG.SA_ID" type="java.lang.String"></field>
        <field id="CI_BSEG.PREM_ID" type="java.lang.String"></field>
        <field id="CI_BSEG.REBILL_SEG_ID" type="java.lang.String"></field>
        <field id="CI_BSEG.BILL_CYC_CD" type="java.lang.String"></field>
        <field id="CI_BSEG.BSEG_STAT_FLG" type="java.lang.String"></field>
        <field id="CI_BSEG.CRE_DTTM" type="java.sql.Timestamp"></field>

        <field id="CI_BILL.BILL_ID" type="java.lang.String"></field>
        <field id="CI_BILL.BILL_CYC_CD" type="java.lang.String"></field>
        <field id="CI_BILL.BILL_STAT_FLG" type="java.lang.String"></field>
        <field id="CI_BILL.BILL_DT" type="java.sql.Timestamp"></field>
        <field id="CI_BILL.CRE_DTTM" type="java.sql.Timestamp"></field>

        <field id="CI_SA.SA_ID" type="java.lang.String"></field>
        <field id="CI_SA.ACCT_ID" type="java.lang.String"></field>
        <field id="CI_SA.SA_STATUS_FLG" type="java.lang.String"></field>

        <field id="CI_ACCT.ACCT_ID" type="java.lang.String"></field>

        <field id="CI_BILL_CYC_L.BILL_CYC_CD" type="java.lang.String"></field>
        <field id="CI_BILL_CYC_L.LANGUAGE_CD" type="java.lang.String"></field>
        <field id="CI_BILL_CYC_L.DESCR" type="java.lang.String"></field>

        <field id="CI_LOOKUP_VAL_L.FIELD_NAME" type="java.lang.String"></field>
        <field id="CI_LOOKUP_VAL_L.FIELD_VALUE" type="java.lang.String"></field>
        <field id="CI_LOOKUP_VAL_L.LANGUAGE_CD" type="java.lang.String"></field>
        <field id="CI_LOOKUP_VAL_L.DESCR" type="java.lang.String"></field>

        <field id="CI_LOOKUP_VAL_L_1.FIELD_NAME" type="java.lang.String"></field>
        <field id="CI_LOOKUP_VAL_L_1.FIELD_VALUE" type="java.lang.String"></field>
        <field id="CI_LOOKUP_VAL_L_1.LANGUAGE_CD" type="java.lang.String"></field>
        <field id="CI_LOOKUP_VAL_L_1.DESCR" type="java.lang.String"></field>
      </fieldList>

      <filterString>trim(CI_BSEG.BILL_CYC_CD) != ''</filterString>
      <joinInfo alias="CI_BSEG" referenceId="CI_BSEG"></joinInfo>

      <joinList>
        <join expr="CI_BSEG.BILL_ID == CI_BILL.BILL_ID" left="CI_BSEG" right="CI_BILL" type="leftOuter" weight="1"></join>
        <join expr="CI_BSEG.SA_ID == CI_SA.SA_ID and CI_SA.SA_STATUS_FLG == '20'" left="CI_BSEG" right="CI_SA" type="inner" weight="1"></join>
        <join expr="CI_SA.ACCT_ID == CI_ACCT.ACCT_ID" left="CI_SA" right="CI_ACCT" type="inner" weight="1"></join>
        <join expr="trim(CI_BSEG.BILL_CYC_CD) == trim(CI_BILL_CYC_L.BILL_CYC_CD) and CI_BILL_CYC_L.LANGUAGE_CD == 'ENG'" left="CI_BSEG" right="CI_BILL_CYC_L" type="leftOuter" weight="1"></join>
        <join expr="CI_BILL.BILL_STAT_FLG == CI_LOOKUP_VAL_L.FIELD_VALUE and trim(CI_LOOKUP_VAL_L.FIELD_NAME) == 'BILL_STAT_FLG' and CI_LOOKUP_VAL_L.LANGUAGE_CD == 'ENG'" left="CI_BILL" right="CI_LOOKUP_VAL_L" type="leftOuter" weight="1"></join>
        <join expr="CI_BSEG.BSEG_STAT_FLG == CI_LOOKUP_VAL_L_1.FIELD_VALUE and trim(CI_LOOKUP_VAL_L_1.FIELD_NAME) == 'BSEG_STAT_FLG' and CI_LOOKUP_VAL_L_1.LANGUAGE_CD == 'ENG'" left="CI_BSEG" right="CI_LOOKUP_VAL_L_1" type="leftOuter" weight="1"></join>
      </joinList>

      <joinOptions></joinOptions>

      <tableRefList>
        <tableRef alwaysIncludeTable="false" tableAlias="CI_BSEG" tableId="CI_BSEG"></tableRef>
        <tableRef alwaysIncludeTable="false" tableAlias="CI_BILL" tableId="CI_BILL"></tableRef>
        <tableRef alwaysIncludeTable="false" tableAlias="CI_SA" tableId="CI_SA"></tableRef>
        <tableRef alwaysIncludeTable="false" tableAlias="CI_ACCT" tableId="CI_ACCT"></tableRef>
        <tableRef alwaysIncludeTable="false" tableAlias="CI_BILL_CYC_L" tableId="CI_BILL_CYC_L"></tableRef>
        <tableRef alwaysIncludeTable="false" tableAlias="CI_LOOKUP_VAL_L" tableId="CI_LOOKUP_VAL_L"></tableRef>
        <tableRef alwaysIncludeTable="false" tableAlias="CI_LOOKUP_VAL_L_1" tableId="CI_LOOKUP_VAL_L_1"></tableRef>
      </tableRefList>
    </jdbcTable>
  </resources>
</schema>
