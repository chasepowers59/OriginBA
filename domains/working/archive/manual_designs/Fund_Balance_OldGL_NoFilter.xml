        <field id="CI_LOOKUP_VAL_L_2.DESCR" type="java.lang.String"></field>

        <field id="DEBIT_AMOUNT" dataSetExpression="CaseWhen(CI_FT_GL.AMOUNT &gt;= 0, CI_FT_GL.AMOUNT, 0)" type="java.math.BigDecimal"></field>
        <field id="CREDIT_AMOUNT" dataSetExpression="CaseWhen(CI_FT_GL.AMOUNT &lt;= 0, -1 * CI_FT_GL.AMOUNT, 0)" type="java.math.BigDecimal"></field>
      </fieldList>
      <joinInfo alias="CI_FT" referenceId="CI_FT"></joinInfo>
      <joinList>
        <join expr="CI_FT.FT_ID == CI_FT_GL.FT_ID" left="CI_FT" right="CI_FT_GL" type="inner" weight="1"></join>
        <join expr="CI_FT.FT_ID == CI_FT_PROC.FT_ID" left="CI_FT" right="CI_FT_PROC" type="leftOuter" weight="1"></join>
        <join expr="CI_FT.FT_TYPE_FLG == CI_LOOKUP_VAL_L.FIELD_VALUE and CI_LOOKUP_VAL_L.FIELD_NAME == 'FT_TYPE_FLG' and CI_LOOKUP_VAL_L.LANGUAGE_CD == 'ENG'" left="CI_FT" right="CI_LOOKUP_VAL_L" type="leftOuter" weight="1"></join>
        <join expr="CI_FT.GL_DISTRIB_STATUS == CI_LOOKUP_VAL_L_1.FIELD_VALUE and CI_LOOKUP_VAL_L_1.FIELD_NAME == 'GL_DISTRIB_STATUS' and CI_LOOKUP_VAL_L_1.LANGUAGE_CD == 'ENG'" left="CI_FT" right="CI_LOOKUP_VAL_L_1" type="leftOuter" weight="1"></join>
        <join expr="CI_FT_GL.DST_ID == CI_DST_CODE_EFF.DST_ID and CI_FT_GL.GL_ACCT == CI_DST_CODE_EFF.GL_ACCT and CI_DST_CODE_EFF.EFF_STATUS == 'A'" left="CI_FT_GL" right="CI_DST_CODE_EFF" type="leftOuter" weight="1"></join>
        <join expr="CI_DST_CODE_EFF.FUND_CD == CI_FUND.FUND_CD" left="CI_DST_CODE_EFF" right="CI_FUND" type="leftOuter" weight="1"></join>
        <join expr="CI_FUND.FUND_CD == CI_FUND_L.FUND_CD and CI_FUND_L.LANGUAGE_CD == 'ENG'" left="CI_FUND" right="CI_FUND_L" type="leftOuter" weight="1"></join>
        <join expr="CI_FUND.FUND_TYPE_FLG == CI_LOOKUP_VAL_L_2.FIELD_VALUE and CI_LOOKUP_VAL_L_2.FIELD_NAME == 'FUND_TYPE_FLG' and CI_LOOKUP_VAL_L_2.LANGUAGE_CD == 'ENG'" left="CI_FUND" right="CI_LOOKUP_VAL_L_2" type="leftOuter" weight="1"></join>
      </joinList>
      <joinOptions></joinOptions>
