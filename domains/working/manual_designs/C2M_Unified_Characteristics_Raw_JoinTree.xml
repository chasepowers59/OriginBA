      <joinList>
        <join expr="CHAR_UNIFIED_RAW.CHAR_TYPE_CD == CI_CHAR_TYPE_L.CHAR_TYPE_CD and CI_CHAR_TYPE_L.LANGUAGE_CD == 'ENG'" left="CHAR_UNIFIED_RAW" right="CI_CHAR_TYPE_L" type="leftOuter" weight="1"></join>

        <join expr="CHAR_UNIFIED_RAW.OBJECT_TYPE == 'PERSON' and CHAR_UNIFIED_RAW.OBJECT_ID == CI_PER.PER_ID" left="CHAR_UNIFIED_RAW" right="CI_PER" type="leftOuter" weight="1"></join>
        <join expr="CI_PER.PER_ID == CI_PER_NAME.PER_ID and CI_PER_NAME.NAME_TYPE_FLG == 'PRIM'" left="CI_PER" right="CI_PER_NAME" type="leftOuter" weight="1"></join>
        <join expr="CI_PER.PER_ID == CI_ACCT_PER.PER_ID and CI_ACCT_PER.MAIN_CUST_SW == 'Y'" left="CI_PER" right="CI_ACCT_PER" type="leftOuter" weight="1"></join>

        <join expr="CHAR_UNIFIED_RAW.OBJECT_TYPE == 'ACCOUNT' and CHAR_UNIFIED_RAW.OBJECT_ID == CI_ACCT.ACCT_ID" left="CHAR_UNIFIED_RAW" right="CI_ACCT" type="leftOuter" weight="1"></join>
        <join expr="CI_ACCT_PER.ACCT_ID == CI_ACCT.ACCT_ID" left="CI_ACCT_PER" right="CI_ACCT" type="leftOuter" weight="1"></join>

        <join expr="CHAR_UNIFIED_RAW.OBJECT_TYPE == 'SA' and CHAR_UNIFIED_RAW.OBJECT_ID == CI_SA.SA_ID" left="CHAR_UNIFIED_RAW" right="CI_SA" type="leftOuter" weight="1"></join>
        <join expr="CHAR_UNIFIED_RAW.OBJECT_TYPE == 'PREMISE' and CHAR_UNIFIED_RAW.OBJECT_ID == CI_PREM.PREM_ID" left="CHAR_UNIFIED_RAW" right="CI_PREM" type="leftOuter" weight="1"></join>
        <join expr="CHAR_UNIFIED_RAW.OBJECT_TYPE == 'SP' and CHAR_UNIFIED_RAW.OBJECT_ID == D1_SP.D1_SP_ID" left="CHAR_UNIFIED_RAW" right="D1_SP" type="leftOuter" weight="1"></join>
