      </fieldList>
      <query>select
    'PERSON' as object_type,
    c.per_id as object_id,
    c.char_type_cd,
    c.char_val,
    c.adhoc_char_val,
    c.srch_char_val,
    c.char_val_fk1,
    c.char_val_fk2,
    c.char_val_fk3,
    c.char_val_fk4,
    c.char_val_fk5,
    c.effdt as char_effdt,
    c.version as char_version,
    c.per_id || '|' || c.char_type_cd || '|' || to_char(c.effdt, 'YYYY-MM-DD HH24:MI:SS') as char_row_key
from cisadm.ci_per_char c
union all
select
    'ACCOUNT' as object_type,
    c.acct_id as object_id,
    c.char_type_cd,
    c.char_val,
    c.adhoc_char_val,
    c.srch_char_val,
    c.char_val_fk1,
    c.char_val_fk2,
    c.char_val_fk3,
    c.char_val_fk4,
    c.char_val_fk5,
    c.effdt as char_effdt,
    c.version as char_version,
    c.acct_id || '|' || c.char_type_cd || '|' || to_char(c.effdt, 'YYYY-MM-DD HH24:MI:SS') as char_row_key
from cisadm.ci_acct_char c
union all
select
    'SA' as object_type,
    c.sa_id as object_id,
    c.char_type_cd,
    c.char_val,
    c.adhoc_char_val,
    c.srch_char_val,
    c.char_val_fk1,
    c.char_val_fk2,
    c.char_val_fk3,
    c.char_val_fk4,
    c.char_val_fk5,
    c.effdt as char_effdt,
    c.version as char_version,
    c.sa_id || '|' || c.char_type_cd || '|' || to_char(c.effdt, 'YYYY-MM-DD HH24:MI:SS') as char_row_key
from cisadm.ci_sa_char c
union all
select
    'PREMISE' as object_type,
    c.prem_id as object_id,
    c.char_type_cd,
    c.char_val,
    c.adhoc_char_val,
    c.srch_char_val,
    c.char_val_fk1,
    c.char_val_fk2,
    c.char_val_fk3,
    c.char_val_fk4,
    c.char_val_fk5,
    c.effdt as char_effdt,
    c.version as char_version,
    c.prem_id || '|' || c.char_type_cd || '|' || to_char(c.effdt, 'YYYY-MM-DD HH24:MI:SS') as char_row_key
from cisadm.ci_prem_char c
union all
select
    'SP' as object_type,
    c.d1_sp_id as object_id,
    c.char_type_cd,
    c.char_val,
    c.adhoc_char_val,
    c.srch_char_val,
    c.char_val_fk1,
    c.char_val_fk2,
    c.char_val_fk3,
    c.char_val_fk4,
    c.char_val_fk5,
    c.effdt as char_effdt,
    c.version as char_version,
    c.d1_sp_id || '|' || c.char_type_cd || '|' || to_char(c.effdt, 'YYYY-MM-DD HH24:MI:SS') as char_row_key
from cisadm.d1_sp_char c</query>
