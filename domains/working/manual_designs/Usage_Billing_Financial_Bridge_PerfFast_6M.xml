    <jdbcQuery id="C1_BI_BILLED_USAGE_VW" datasourceId="Origin_DEV_DS">
      <fieldList>
        <field id="BILL_ID" type="java.lang.String"></field>
        <field id="BSEG_ID" type="java.lang.String"></field>
        <field id="SA_ID" type="java.lang.String"></field>
        <field id="ACCT_ID" type="java.lang.String"></field>
        <field id="RS_CD" type="java.lang.String"></field>
        <field id="UOM_CD" type="java.lang.String"></field>
        <field id="TOU_CD" type="java.lang.String"></field>
        <field id="SQI_CD" type="java.lang.String"></field>
        <field id="ACCOUNTING_DT" type="java.sql.Timestamp"></field>
        <field id="BSEG_START_DT" type="java.sql.Timestamp"></field>
        <field id="BSEG_END_DT" type="java.sql.Timestamp"></field>
        <field id="BILL_SQ" type="java.math.BigDecimal"></field>
        <field id="BILLED_AMT" type="java.math.BigDecimal"></field>
      </fieldList>
      <query>select u.bill_id,
       u.bseg_id,
       u.sa_id,
       u.acct_id,
       u.rs_cd,
       u.uom_cd,
       u.tou_cd,
       u.sqi_cd,
       u.accounting_dt,
       u.bseg_start_dt,
       u.bseg_end_dt,
       u.bill_sq,
       u.billed_amt
from cisadm.c1_bi_billed_usage_vw u
where u.accounting_dt &gt;= add_months(trunc(sysdate), -6)
  and u.accounting_dt &lt; trunc(sysdate) + 1
  and u.bill_id is not null
  and u.bseg_id is not null
  and u.rs_cd is not null</query>
    </jdbcQuery>

    <jdbcQuery id="C1_BI_FT_VW_AGG" datasourceId="Origin_DEV_DS">
      <fieldList>
        <field id="BILL_ID" type="java.lang.String"></field>
        <field id="BSEG_ID" type="java.lang.String"></field>
        <field id="RS_CD" type="java.lang.String"></field>
        <field id="FT_GL_REV_AMT_TOTAL" type="java.math.BigDecimal"></field>
        <field id="FT_GL_TAX_AMT_TOTAL" type="java.math.BigDecimal"></field>
        <field id="FT_OTHER_AMT_TOTAL" type="java.math.BigDecimal"></field>
        <field id="FT_TOT_AMT_TOTAL" type="java.math.BigDecimal"></field>
        <field id="FT_CNT_TOTAL" type="java.math.BigDecimal"></field>
      </fieldList>
      <query>select f.bill_id,
       f.bseg_id,
       f.rs_cd,
       nvl(sum(nvl(f.ft_gl_rev_amt, 0)), 0) as ft_gl_rev_amt_total,
       nvl(sum(nvl(f.ft_gl_tax_amt, 0)), 0) as ft_gl_tax_amt_total,
       nvl(sum(nvl(f.ft_other_amt, 0)), 0) as ft_other_amt_total,
       nvl(sum(nvl(f.tot_amt, 0)), 0) as ft_tot_amt_total,
       nvl(sum(nvl(f.ft_cnt, 0)), 0) as ft_cnt_total
  from cisadm.c1_bi_ft_vw f
  join (
      select distinct u.bill_id,
             u.bseg_id,
             u.rs_cd
        from cisadm.c1_bi_billed_usage_vw u
       where u.accounting_dt &gt;= add_months(trunc(sysdate), -6)
         and u.accounting_dt &lt; trunc(sysdate) + 1
         and u.bill_id is not null
         and u.bseg_id is not null
         and u.rs_cd is not null
  ) uk
    on uk.bill_id = f.bill_id
   and uk.bseg_id = f.bseg_id
   and uk.rs_cd = f.rs_cd
 where f.accounting_dt &gt;= add_months(trunc(sysdate), -6)
   and f.accounting_dt &lt; trunc(sysdate) + 1
   and f.bill_id is not null
   and f.bseg_id is not null
   and f.rs_cd is not null
 group by f.bill_id, f.bseg_id, f.rs_cd</query>
    </jdbcQuery>

