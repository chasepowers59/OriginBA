  <resources>
    <jdbcQuery id="D1_USAGE_BASE_180D" datasourceId="Origin_DEV_DS">
      <fieldList>
        <field id="D1_USAGE_ID" type="java.lang.String"></field>
        <field id="US_ID" type="java.lang.String"></field>
        <field id="USG_GRP_CD" type="java.lang.String"></field>
        <field id="MSRMT_CYC_CD" type="java.lang.String"></field>
        <field id="MSRMT_CYC_RTE_CD" type="java.lang.String"></field>
        <field id="USAGE_START_DTTM" type="java.sql.Timestamp"></field>
        <field id="USAGE_END_DTTM" type="java.sql.Timestamp"></field>
        <field id="USED_ON_BILL_FLG" type="java.lang.String"></field>
        <field id="USG_SRC_FLG" type="java.lang.String"></field>
        <field id="SCALAR_SEQ_NUM" type="java.math.BigDecimal"></field>
        <field id="D1_SP_ID" type="java.lang.String"></field>
        <field id="MEASR_COMP_ID" type="java.lang.String"></field>
        <field id="D1_UOM_CD" type="java.lang.String"></field>
        <field id="D1_TOU_CD" type="java.lang.String"></field>
        <field id="D1_SQI_CD" type="java.lang.String"></field>
        <field id="SCALAR_START_DTTM" type="java.sql.Timestamp"></field>
        <field id="SCALAR_END_DTTM" type="java.sql.Timestamp"></field>
        <field id="USAGE_QTY" type="java.math.BigDecimal"></field>
        <field id="INTERVAL_DAYS" type="java.math.BigDecimal"></field>
        <field id="USAGE_QTY_PER_DAY" type="java.math.BigDecimal"></field>
      </fieldList>
      <query>select u.d1_usage_id, u.us_id, u.usg_grp_cd, u.msrmt_cyc_cd, u.msrmt_cyc_rte_cd, u.start_dttm as usage_start_dttm, u.end_dttm as usage_end_dttm, u.used_on_bill_flg, u.usg_src_flg, d.seq_num as scalar_seq_num, d.d1_sp_id, d.measr_comp_id, d.d1_uom_cd, d.d1_tou_cd, d.d1_sqi_cd, d.start_dttm as scalar_start_dttm, d.end_dttm as scalar_end_dttm, nvl(psq.period_qty, nvl(d.quantity, 0)) as usage_qty, case when d.end_dttm is not null and d.start_dttm is not null and d.end_dttm &gt; d.start_dttm then cast(d.end_dttm as date) - cast(d.start_dttm as date) else null end as interval_days, case when d.end_dttm is not null and d.start_dttm is not null and d.end_dttm &gt; d.start_dttm then nvl(psq.period_qty, nvl(d.quantity, 0)) / (cast(d.end_dttm as date) - cast(d.start_dttm as date)) else null end as usage_qty_per_day from cisadm.d1_usage u join cisadm.d1_usage_scalar_dtl d on d.d1_usage_id = u.d1_usage_id left join (select p.d1_usage_id, p.d1_sp_id, p.measr_comp_id, p.d1_uom_cd, p.d1_tou_cd, p.d1_sqi_cd, sum(nvl(p.quantity, 0)) as period_qty from cisadm.d1_usage_period_sq p join cisadm.d1_usage u2 on u2.d1_usage_id = p.d1_usage_id where u2.start_dttm >= trunc(sysdate) - 180 and u2.start_dttm &lt; trunc(sysdate) + 1 and trim(u2.bus_obj_cd) = 'D2-UsageTransaction' group by p.d1_usage_id, p.d1_sp_id, p.measr_comp_id, p.d1_uom_cd, p.d1_tou_cd, p.d1_sqi_cd) psq on psq.d1_usage_id = d.d1_usage_id and psq.d1_sp_id = d.d1_sp_id and psq.measr_comp_id = d.measr_comp_id and nvl(psq.d1_uom_cd, '~') = nvl(d.d1_uom_cd, '~') and nvl(psq.d1_tou_cd, '~') = nvl(d.d1_tou_cd, '~') and nvl(psq.d1_sqi_cd, '~') = nvl(d.d1_sqi_cd, '~') where u.start_dttm >= trunc(sysdate) - 180 and u.start_dttm &lt; trunc(sysdate) + 1 and u.d1_usage_id is not null and trim(u.bus_obj_cd) = 'D2-UsageTransaction'</query>
    </jdbcQuery>

    <jdbcQuery id="USAGE_ACCT_CTX_180D" datasourceId="Origin_DEV_DS">
      <fieldList>
        <field id="D1_USAGE_ID" type="java.lang.String"></field>
        <field id="D1_SP_ID" type="java.lang.String"></field>
        <field id="SA_ID" type="java.lang.String"></field>
        <field id="ACCT_ID" type="java.lang.String"></field>
      </fieldList>
      <query>select z.d1_usage_id, z.d1_sp_id, z.sa_id, z.acct_id from (select uk.d1_usage_id, uk.d1_sp_id, sasp.sa_id, sa.acct_id, row_number() over (partition by uk.d1_usage_id, uk.d1_sp_id order by nvl(sasp.stop_dttm, date '2999-12-31') desc, nvl(sasp.start_dttm, date '1900-01-01') desc, sasp.sa_id) as rn from (select distinct u.d1_usage_id, d.d1_sp_id, u.start_dttm as usage_start_dttm from cisadm.d1_usage u join cisadm.d1_usage_scalar_dtl d on d.d1_usage_id = u.d1_usage_id where u.start_dttm >= trunc(sysdate) - 180 and u.start_dttm &lt; trunc(sysdate) + 1 and d.d1_sp_id is not null and trim(u.bus_obj_cd) = 'D2-UsageTransaction') uk left join cisadm.ci_sa_sp sasp on sasp.sp_id = uk.d1_sp_id and (sasp.start_dttm is null or sasp.start_dttm &lt;= uk.usage_start_dttm) and (sasp.stop_dttm is null or sasp.stop_dttm &gt; uk.usage_start_dttm) left join cisadm.ci_sa sa on sa.sa_id = sasp.sa_id) z where z.rn = 1</query>
    </jdbcQuery>

    <jdbcQuery id="USAGE_DEVICE_CTX_180D" datasourceId="Origin_DEV_DS">
      <fieldList>
        <field id="D1_USAGE_ID" type="java.lang.String"></field>
        <field id="D1_SP_ID" type="java.lang.String"></field>
        <field id="MEASR_COMP_ID" type="java.lang.String"></field>
        <field id="D1_DEVICE_ID" type="java.lang.String"></field>
      </fieldList>
      <query>select k.d1_usage_id, k.d1_sp_id, k.measr_comp_id, cfg.d1_device_id from (select distinct u.d1_usage_id, d.d1_sp_id, d.measr_comp_id from cisadm.d1_usage u join cisadm.d1_usage_scalar_dtl d on d.d1_usage_id = u.d1_usage_id where u.start_dttm >= trunc(sysdate) - 180 and u.start_dttm &lt; trunc(sysdate) + 1 and d.measr_comp_id is not null and trim(u.bus_obj_cd) = 'D2-UsageTransaction') k left join cisadm.d1_measr_comp mc on mc.measr_comp_id = k.measr_comp_id left join (select c.device_config_id, c.d1_device_id, row_number() over (partition by c.device_config_id order by nvl(c.eff_dttm, date '1900-01-01') desc, nvl(c.cre_dttm, date '1900-01-01') desc, c.d1_device_id) as rn from cisadm.d1_dvc_cfg c) cfg on cfg.device_config_id = mc.device_config_id and cfg.rn = 1</query>
    </jdbcQuery>

    <jdbcQuery id="DEVICE_ACCT_LINK_180D" datasourceId="Origin_DEV_DS">
      <fieldList>
        <field id="D1_USAGE_ID" type="java.lang.String"></field>
        <field id="D1_SP_ID" type="java.lang.String"></field>
        <field id="MEASR_COMP_ID" type="java.lang.String"></field>
        <field id="USAGE_START_DTTM" type="java.sql.Timestamp"></field>
        <field id="D1_DEVICE_ID" type="java.lang.String"></field>
        <field id="ACCT_ID" type="java.lang.String"></field>
        <field id="SA_ID" type="java.lang.String"></field>
        <field id="DEVICE_ACCT_KEY" type="java.lang.String"></field>
      </fieldList>
      <query>select ud.d1_usage_id, ud.d1_sp_id, ud.measr_comp_id, ud.usage_start_dttm, ud.d1_device_id, ua.acct_id, ua.sa_id, ud.d1_device_id || '|' || ua.acct_id as device_acct_key from (select k.d1_usage_id, k.d1_sp_id, k.measr_comp_id, k.usage_start_dttm, cfg.d1_device_id from (select distinct u.d1_usage_id, u.start_dttm as usage_start_dttm, d.d1_sp_id, d.measr_comp_id from cisadm.d1_usage u join cisadm.d1_usage_scalar_dtl d on d.d1_usage_id = u.d1_usage_id where u.start_dttm >= trunc(sysdate) - 180 and u.start_dttm &lt; trunc(sysdate) + 1 and d.measr_comp_id is not null and trim(u.bus_obj_cd) = 'D2-UsageTransaction') k left join cisadm.d1_measr_comp mc on mc.measr_comp_id = k.measr_comp_id left join (select c.device_config_id, c.d1_device_id, row_number() over (partition by c.device_config_id order by nvl(c.eff_dttm, date '1900-01-01') desc, nvl(c.cre_dttm, date '1900-01-01') desc, c.d1_device_id) as rn from cisadm.d1_dvc_cfg c) cfg on cfg.device_config_id = mc.device_config_id and cfg.rn = 1) ud join (select z.d1_usage_id, z.d1_sp_id, z.sa_id, z.acct_id from (select uk.d1_usage_id, uk.d1_sp_id, sasp.sa_id, sa.acct_id, row_number() over (partition by uk.d1_usage_id, uk.d1_sp_id order by nvl(sasp.stop_dttm, date '2999-12-31') desc, nvl(sasp.start_dttm, date '1900-01-01') desc, sasp.sa_id) as rn from (select distinct u.d1_usage_id, d.d1_sp_id, u.start_dttm as usage_start_dttm from cisadm.d1_usage u join cisadm.d1_usage_scalar_dtl d on d.d1_usage_id = u.d1_usage_id where u.start_dttm >= trunc(sysdate) - 180 and u.start_dttm &lt; trunc(sysdate) + 1 and d.d1_sp_id is not null and trim(u.bus_obj_cd) = 'D2-UsageTransaction') uk left join cisadm.ci_sa_sp sasp on sasp.sp_id = uk.d1_sp_id and (sasp.start_dttm is null or sasp.start_dttm &lt;= uk.usage_start_dttm) and (sasp.stop_dttm is null or sasp.stop_dttm &gt; uk.usage_start_dttm) left join cisadm.ci_sa sa on sa.sa_id = sasp.sa_id) z where z.rn = 1) ua on ua.d1_usage_id = ud.d1_usage_id and ua.d1_sp_id = ud.d1_sp_id where ud.d1_device_id is not null and ua.acct_id is not null</query>
    </jdbcQuery>

