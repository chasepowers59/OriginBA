  <resources>
    <jdbcQuery id="COLL_PROC_BASE_180D" datasourceId="Origin_DEV_DS">
      <fieldList>
        <field id="COLL_PROC_ID" type="java.lang.String"></field>
        <field id="ACCT_ID" type="java.lang.String"></field>
        <field id="COLL_PROC_TMPL_CD" type="java.lang.String"></field>
        <field id="COLL_CL_CNTL_CD" type="java.lang.String"></field>
        <field id="COLL_STATUS_FLG" type="java.lang.String"></field>
        <field id="COLL_STAT_RSN_FLG" type="java.lang.String"></field>
        <field id="CRE_DTTM" type="java.sql.Timestamp"></field>
        <field id="COLL_ARS_DT" type="java.sql.Timestamp"></field>
        <field id="ARS_AMT" type="java.math.BigDecimal"></field>
        <field id="CURRENCY_CD" type="java.lang.String"></field>
        <field id="TRIGGER_BP_SW" type="java.lang.String"></field>
      </fieldList>
      <query>select p.coll_proc_id, p.acct_id, p.coll_proc_tmpl_cd, p.coll_cl_cntl_cd, p.coll_status_flg, p.coll_stat_rsn_flg, p.cre_dttm, p.coll_ars_dt, nvl(p.ars_amt, 0) as ars_amt, p.currency_cd, p.trigger_bp_sw from cisadm.ci_coll_proc p where p.cre_dttm >= trunc(sysdate) - 180 and p.cre_dttm &lt; trunc(sysdate) + 1 and p.coll_proc_id is not null and p.acct_id is not null</query>
    </jdbcQuery>

    <jdbcQuery id="COLL_EVT_AGG" datasourceId="Origin_DEV_DS">
      <fieldList>
        <field id="COLL_PROC_ID" type="java.lang.String"></field>
        <field id="EVT_COUNT" type="java.math.BigDecimal"></field>
        <field id="EVT_COMPLETED_COUNT" type="java.math.BigDecimal"></field>
        <field id="EVT_OPEN_COUNT" type="java.math.BigDecimal"></field>
        <field id="FIRST_EVT_TRIGGER_DT" type="java.sql.Timestamp"></field>
        <field id="LAST_EVT_COMPLETION_DT" type="java.sql.Timestamp"></field>
        <field id="NEXT_OPEN_EVT_SEQ" type="java.math.BigDecimal"></field>
        <field id="HAS_OPEN_EVT_SW" type="java.lang.String"></field>
      </fieldList>
      <query>select ce.coll_proc_id, count(*) as evt_count, sum(case when ce.completion_dt is not null then 1 else 0 end) as evt_completed_count, sum(case when ce.completion_dt is null then 1 else 0 end) as evt_open_count, min(ce.trigger_dt) as first_evt_trigger_dt, max(ce.completion_dt) as last_evt_completion_dt, min(case when ce.completion_dt is null then ce.evt_seq end) as next_open_evt_seq, case when sum(case when ce.completion_dt is null then 1 else 0 end) &gt; 0 then 'Y' else 'N' end as has_open_evt_sw from cisadm.ci_coll_evt ce join (select p.coll_proc_id from cisadm.ci_coll_proc p where p.cre_dttm >= trunc(sysdate) - 180 and p.cre_dttm &lt; trunc(sysdate) + 1) bp on bp.coll_proc_id = ce.coll_proc_id group by ce.coll_proc_id</query>
    </jdbcQuery>

    <jdbcQuery id="COLL_NEXT_PROC_CTX" datasourceId="Origin_DEV_DS">
      <fieldList>
        <field id="COLL_PROC_ID" type="java.lang.String"></field>
        <field id="ACCT_ID" type="java.lang.String"></field>
        <field id="PROC_CRE_DTTM" type="java.sql.Timestamp"></field>
        <field id="ARS_AMT_START" type="java.math.BigDecimal"></field>
        <field id="NEXT_COLL_PROC_ID" type="java.lang.String"></field>
        <field id="NEXT_PROC_CRE_DTTM" type="java.sql.Timestamp"></field>
        <field id="NEXT_ARS_AMT" type="java.math.BigDecimal"></field>
        <field id="ARS_CHANGE_TO_NEXT" type="java.math.BigDecimal"></field>
        <field id="ARS_REDUCTION_POS" type="java.math.BigDecimal"></field>
        <field id="DAYS_TO_NEXT_PROC" type="java.math.BigDecimal"></field>
        <field id="HAS_NEXT_PROC_SW" type="java.lang.String"></field>
        <field id="DEBT_REDUCED_BY_NEXT_SW" type="java.lang.String"></field>
        <field id="HAS_NEXT_PROC_CNT_ROW" type="java.math.BigDecimal"></field>
        <field id="NO_FOLLOWUP_PROC_CNT_ROW" type="java.math.BigDecimal"></field>
        <field id="EFFECTIVE_PROC_CNT_ROW" type="java.math.BigDecimal"></field>
        <field id="INEFFECTIVE_PROC_CNT_ROW" type="java.math.BigDecimal"></field>
      </fieldList>
      <query>select y.coll_proc_id, y.acct_id, y.cre_dttm as proc_cre_dttm, y.ars_amt as ars_amt_start, y.next_coll_proc_id, y.next_proc_cre_dttm, y.next_ars_amt, case when y.next_ars_amt is null then null else nvl(y.ars_amt, 0) - nvl(y.next_ars_amt, 0) end as ars_change_to_next, case when y.next_ars_amt is null then 0 when nvl(y.ars_amt, 0) - nvl(y.next_ars_amt, 0) &gt; 0 then nvl(y.ars_amt, 0) - nvl(y.next_ars_amt, 0) else 0 end as ars_reduction_pos, case when y.next_proc_cre_dttm is null then null else round(cast(y.next_proc_cre_dttm as date) - cast(y.cre_dttm as date), 6) end as days_to_next_proc, case when y.next_coll_proc_id is null then 'N' else 'Y' end as has_next_proc_sw, case when y.next_coll_proc_id is null then 'N' when nvl(y.ars_amt, 0) - nvl(y.next_ars_amt, 0) &gt; 0 then 'Y' else 'N' end as debt_reduced_by_next_sw, case when y.next_coll_proc_id is null then 0 else 1 end as has_next_proc_cnt_row, case when y.next_coll_proc_id is null then 1 else 0 end as no_followup_proc_cnt_row, case when y.next_coll_proc_id is not null and (nvl(y.ars_amt, 0) - nvl(y.next_ars_amt, 0)) &gt; 0 then 1 else 0 end as effective_proc_cnt_row, case when y.next_coll_proc_id is not null and (nvl(y.ars_amt, 0) - nvl(y.next_ars_amt, 0)) &lt;= 0 then 1 else 0 end as ineffective_proc_cnt_row from (select x.coll_proc_id, x.acct_id, x.cre_dttm, nvl(x.ars_amt, 0) as ars_amt, lead(x.coll_proc_id) over (partition by x.acct_id order by x.cre_dttm, lpad(trim(x.coll_proc_id), 30, '0'), x.coll_proc_id) as next_coll_proc_id, lead(x.cre_dttm) over (partition by x.acct_id order by x.cre_dttm, lpad(trim(x.coll_proc_id), 30, '0'), x.coll_proc_id) as next_proc_cre_dttm, lead(nvl(x.ars_amt, 0)) over (partition by x.acct_id order by x.cre_dttm, lpad(trim(x.coll_proc_id), 30, '0'), x.coll_proc_id) as next_ars_amt from cisadm.ci_coll_proc x where x.cre_dttm >= trunc(sysdate) - 180 and x.cre_dttm &lt; trunc(sysdate) + 1 and x.coll_proc_id is not null and x.acct_id is not null) y</query>
    </jdbcQuery>

