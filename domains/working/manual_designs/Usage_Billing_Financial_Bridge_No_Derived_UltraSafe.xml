        <field id="BILL_LAG_DAYS" type="java.math.BigDecimal"></field>
        <field id="BSEG_SQ_CNT" type="java.math.BigDecimal"></field>
      </fieldList>
      <query>select u.bseg_id,
       u.rs_cd,
       u.uom_cd,
       u.tou_cd,
       u.sqi_cd,
       u.bill_id,
       u.ft_type_flg,
       u.accounting_dt,
       u.freeze_dttm,
       u.bseg_start_dt,
       u.bseg_end_dt,
       u.bseg_days,
       u.bill_cre_dttm,
       u.sa_id,
       u.acct_id,
       u.prem_id,
       u.per_id,
       u.bill_sq,
       u.billed_amt,
       u.bill_lag_days,
       u.bseg_sq_cnt
from cisadm.c1_bi_billed_usage_vw u
where u.accounting_dt &gt;= add_months(trunc(sysdate), -6)
  and u.accounting_dt &lt; trunc(sysdate) + 1
  and u.bill_id is not null
  and u.bseg_id is not null
  and u.rs_cd is not null</query>
    </jdbcQuery>
    <jdbcQuery id="C1_BI_FT_VW" datasourceId="Origin_DEV_DS">
      <fieldList>
        <field id="FT_ID" type="java.lang.String"></field>
