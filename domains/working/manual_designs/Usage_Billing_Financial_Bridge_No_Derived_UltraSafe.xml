        <field id="FT_GL_TAX_AMT" type="java.math.BigDecimal"></field>
        <field id="FT_OTHER_AMT" type="java.math.BigDecimal"></field>
        <field id="FT_CNT" type="java.math.BigDecimal"></field>
      </fieldList>
      <query>select f.ft_id,
       f.bill_id,
       f.bseg_id,
       f.sa_id,
       f.acct_id,
       f.ft_type_flg,
       f.cur_amt,
       f.tot_amt,
       f.accounting_dt,
       f.rs_cd,
       f.ft_gl_rev_amt,
       f.ft_gl_tax_amt,
       f.ft_other_amt,
       f.ft_cnt
  from cisadm.c1_bi_ft_vw f
  join (
      select distinct u.bill_id,
             u.bseg_id,
             u.rs_cd
        from cisadm.c1_bi_billed_usage_vw u
       where u.accounting_dt &gt;= add_months(trunc(sysdate), -6)
         and u.accounting_dt &lt; trunc(sysdate) + 1
         and u.bill_id is not null
         and u.bseg_id is not null
         and u.rs_cd is not null
  ) uk
    on uk.bill_id = f.bill_id
   and uk.bseg_id = f.bseg_id
   and uk.rs_cd = f.rs_cd
 where f.accounting_dt &gt;= add_months(trunc(sysdate), -6)
   and f.accounting_dt &lt; trunc(sysdate) + 1
   and f.bill_id is not null
   and f.bseg_id is not null
   and f.rs_cd is not null</query>
    </jdbcQuery>
