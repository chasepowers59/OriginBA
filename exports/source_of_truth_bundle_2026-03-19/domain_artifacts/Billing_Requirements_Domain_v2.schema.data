  <items>
    <item id="BILL_CYCLE_CODE" label="Bill Cycle Code" resourceId="JoinTree_1.BC_BILLING_VERIFICATION_SUMMARY_V2.BILL_CYCLE_CODE"></item>
    <item id="BILL_CYCLE_DESCRIPTION" label="Bill Cycle Description" resourceId="JoinTree_1.BC_BILLING_VERIFICATION_SUMMARY_V2.BILL_CYCLE_DESCRIPTION"></item>
    <item defaultAgg="Max" dimensionOrMeasure="Measure" id="EXPECTED_ACTIVE_SA_COUNT" label="Expected Active SA Count" resourceId="JoinTree_1.BC_BILLING_VERIFICATION_SUMMARY_V2.EXPECTED_ACTIVE_SA_COUNT"></item>
    <item defaultAgg="Max" dimensionOrMeasure="Measure" id="EXPECTED_ACTIVE_ACCOUNT_COUNT" label="Expected Active Account Count" resourceId="JoinTree_1.BC_BILLING_VERIFICATION_SUMMARY_V2.EXPECTED_ACTIVE_ACCOUNT_COUNT"></item>
    <item defaultAgg="Max" dimensionOrMeasure="Measure" id="ACTUAL_BILLED_SA_COUNT" label="Actual Billed SA Count" resourceId="JoinTree_1.BC_BILLING_VERIFICATION_SUMMARY_V2.ACTUAL_BILLED_SA_COUNT"></item>
    <item defaultAgg="Max" dimensionOrMeasure="Measure" id="ACTUAL_BILLED_ACCOUNT_COUNT" label="Actual Billed Account Count" resourceId="JoinTree_1.BC_BILLING_VERIFICATION_SUMMARY_V2.ACTUAL_BILLED_ACCOUNT_COUNT"></item>
    <item defaultAgg="Max" dimensionOrMeasure="Measure" id="ACTUAL_BILL_SEGMENT_COUNT" label="Actual Bill Segment Count" resourceId="JoinTree_1.BC_BILLING_VERIFICATION_SUMMARY_V2.ACTUAL_BILL_SEGMENT_COUNT"></item>
    <item defaultAgg="Max" dimensionOrMeasure="Measure" id="ACTUAL_BILL_COUNT" label="Actual Bill Count" resourceId="JoinTree_1.BC_BILLING_VERIFICATION_SUMMARY_V2.ACTUAL_BILL_COUNT"></item>
    <item defaultAgg="Max" dimensionOrMeasure="Measure" id="MISSING_ACTIVE_SA_COUNT" label="Missing Active SA Count" resourceId="JoinTree_1.BC_BILLING_VERIFICATION_SUMMARY_V2.MISSING_ACTIVE_SA_COUNT"></item>
    <item defaultAgg="Max" dimensionOrMeasure="Measure" id="MISSING_ACTIVE_ACCOUNT_COUNT" label="Missing Active Account Count" resourceId="JoinTree_1.BC_BILLING_VERIFICATION_SUMMARY_V2.MISSING_ACTIVE_ACCOUNT_COUNT"></item>
    <item id="RECON_CYCLE_LAST_EVENT_DATE" label="Reconciliation Cycle Last Event Date" resourceId="JoinTree_1.BC_BILLING_VERIFICATION_SUMMARY_V2.CYCLE_LAST_EVENT_DATE"></item>
    <item id="MOST_RECENT_BILL_CYCLE_SW_RECON" label="Most Recent Bill Cycle (Reconciliation)" resourceId="JoinTree_1.BC_BILLING_VERIFICATION_SUMMARY_V2.MOST_RECENT_BILL_CYCLE_SW"></item>
    <item id="ACCOUNT_ID" label="Account ID" resourceId="JoinTree_1.BC_BILLING_VERIFICATION_DETAIL_V2.ACCOUNT_ID"></item>
    <item id="SERVICE_AGREEMENT_ID" label="Service Agreement ID" resourceId="JoinTree_1.BC_BILLING_VERIFICATION_DETAIL_V2.SERVICE_AGREEMENT_ID"></item>
    <item id="PREMISE_ID" label="Premise ID" resourceId="JoinTree_1.BC_BILLING_VERIFICATION_DETAIL_V2.PREMISE_ID"></item>
    <item id="BILL_ID_DETAIL" label="Bill ID" resourceId="JoinTree_1.BC_BILLING_VERIFICATION_DETAIL_V2.BILL_ID"></item>
    <item id="BILL_SEGMENT_ID_DETAIL" label="Bill Segment ID" resourceId="JoinTree_1.BC_BILLING_VERIFICATION_DETAIL_V2.BILL_SEGMENT_ID"></item>
    <item id="BILL_DATE" label="Bill Date" resourceId="JoinTree_1.BC_BILLING_VERIFICATION_DETAIL_V2.BILL_DATE"></item>
    <item id="BILL_CREATE_DATE" label="Bill Create Date" resourceId="JoinTree_1.BC_BILLING_VERIFICATION_DETAIL_V2.BILL_CREATE_DATE"></item>
    <item id="BSEG_CREATE_DATE" label="Bill Segment Create Date" resourceId="JoinTree_1.BC_BILLING_VERIFICATION_DETAIL_V2.BSEG_CREATE_DATE"></item>
    <item id="BILL_STATUS_DESCRIPTION" label="Bill Status Description" resourceId="JoinTree_1.BC_BILLING_VERIFICATION_DETAIL_V2.BILL_STATUS_DESCRIPTION"></item>
    <item id="BSEG_STATUS_DESCRIPTION" label="Bill Segment Status Description" resourceId="JoinTree_1.BC_BILLING_VERIFICATION_DETAIL_V2.BSEG_STATUS_DESCRIPTION"></item>
    <item id="IS_ERROR_SW" label="Is Exception" resourceId="JoinTree_1.BC_BILLING_VERIFICATION_DETAIL_V2.IS_ERROR_SW"></item>
    <item id="ERROR_REASON" label="Exception Detail" resourceId="JoinTree_1.BC_BILLING_VERIFICATION_DETAIL_V2.ERROR_REASON"></item>
    <item id="EXCEPTION_TYPE" label="Exception Type" resourceId="JoinTree_1.BC_BILLING_VERIFICATION_DETAIL_V2.EXCEPTION_TYPE"></item>
    <item id="RECOMMENDED_ACTION" label="Recommended Action" resourceId="JoinTree_1.BC_BILLING_VERIFICATION_DETAIL_V2.RECOMMENDED_ACTION"></item>
    <item id="EVENT_DATE" label="Event Date" resourceId="JoinTree_1.BC_BILLING_VERIFICATION_DETAIL_V2.EVENT_DATE"></item>
    <item id="MOST_RECENT_BILL_CYCLE_SW_DETAIL" label="Most Recent Bill Cycle (Detail)" resourceId="JoinTree_1.BC_BILLING_VERIFICATION_DETAIL_V2.MOST_RECENT_BILL_CYCLE_SW"></item>
  </items>
  <resources>
    <jdbcTable id="CI_BILL_CYC_L" datasourceId="Origin_DEV_DS" datasourceTableName="CI_BILL_CYC_L" schemaAlias="CISADM">
      <fieldList>
        <field id="BILL_CYC_CD" type="java.lang.String"></field>
        <field id="LANGUAGE_CD" type="java.lang.String"></field>
        <field id="DESCR" type="java.lang.String"></field>
      </fieldList>
    </jdbcTable>
    <jdbcQuery id="BC_BILLING_VERIFICATION_SUMMARY_V2" datasourceId="Origin_DEV_DS">
      <fieldList>
        <field id="BILL_CYCLE_CODE" type="java.lang.String"></field>
        <field id="BILL_CYCLE_DESCRIPTION" type="java.lang.String"></field>
        <field id="EXPECTED_ACTIVE_SA_COUNT" type="java.math.BigDecimal"></field>
        <field id="EXPECTED_ACTIVE_ACCOUNT_COUNT" type="java.math.BigDecimal"></field>
        <field id="ACTUAL_BILLED_SA_COUNT" type="java.math.BigDecimal"></field>
        <field id="ACTUAL_BILLED_ACCOUNT_COUNT" type="java.math.BigDecimal"></field>
        <field id="ACTUAL_BILL_SEGMENT_COUNT" type="java.math.BigDecimal"></field>
        <field id="ACTUAL_BILL_COUNT" type="java.math.BigDecimal"></field>
        <field id="MISSING_ACTIVE_SA_COUNT" type="java.math.BigDecimal"></field>
        <field id="MISSING_ACTIVE_ACCOUNT_COUNT" type="java.math.BigDecimal"></field>
        <field id="CYCLE_LAST_EVENT_DATE" type="java.sql.Timestamp"></field>
        <field id="MOST_RECENT_BILL_CYCLE_SW" type="java.lang.String"></field>
      </fieldList>
      <query>SELECT
  C.BILL_CYCLE_CODE,
  NVL(D.BILL_CYCLE_DESCRIPTION, 'Cycle ' || C.BILL_CYCLE_CODE) AS BILL_CYCLE_DESCRIPTION,
  NVL(E.EXPECTED_ACTIVE_SA_COUNT, 0) AS EXPECTED_ACTIVE_SA_COUNT,
  NVL(E.EXPECTED_ACTIVE_ACCOUNT_COUNT, 0) AS EXPECTED_ACTIVE_ACCOUNT_COUNT,
  NVL(A.ACTUAL_BILLED_SA_COUNT, 0) AS ACTUAL_BILLED_SA_COUNT,
  NVL(A.ACTUAL_BILLED_ACCOUNT_COUNT, 0) AS ACTUAL_BILLED_ACCOUNT_COUNT,
  NVL(A.ACTUAL_BILL_SEGMENT_COUNT, 0) AS ACTUAL_BILL_SEGMENT_COUNT,
  NVL(A.ACTUAL_BILL_COUNT, 0) AS ACTUAL_BILL_COUNT,
  GREATEST(NVL(E.EXPECTED_ACTIVE_SA_COUNT, 0) - NVL(A.ACTUAL_BILLED_SA_COUNT, 0), 0) AS MISSING_ACTIVE_SA_COUNT,
  GREATEST(NVL(E.EXPECTED_ACTIVE_ACCOUNT_COUNT, 0) - NVL(A.ACTUAL_BILLED_ACCOUNT_COUNT, 0), 0) AS MISSING_ACTIVE_ACCOUNT_COUNT,
  A.CYCLE_LAST_EVENT_DATE,
  CASE
    WHEN A.CYCLE_LAST_EVENT_DATE = MAX(A.CYCLE_LAST_EVENT_DATE) OVER () THEN 'Y'
    ELSE 'N'
  END AS MOST_RECENT_BILL_CYCLE_SW
FROM (
  SELECT BILL_CYCLE_CODE
  FROM (
    SELECT DISTINCT NULLIF(TRIM(AC.BILL_CYC_CD), '') AS BILL_CYCLE_CODE
    FROM CISADM.CI_SA SA
    JOIN CISADM.CI_ACCT AC
      ON AC.ACCT_ID = SA.ACCT_ID
    WHERE TRIM(SA.SA_STATUS_FLG) = '20'
      AND NULLIF(TRIM(AC.BILL_CYC_CD), '') IS NOT NULL
    UNION
    SELECT DISTINCT NULLIF(TRIM(NVL(B.BILL_CYC_CD, AC.BILL_CYC_CD)), '') AS BILL_CYCLE_CODE
    FROM CISADM.CI_BILL B
    LEFT JOIN CISADM.CI_ACCT AC
      ON AC.ACCT_ID = B.ACCT_ID
    WHERE NULLIF(TRIM(NVL(B.BILL_CYC_CD, AC.BILL_CYC_CD)), '') IS NOT NULL
      AND NVL(B.BILL_DT, B.CRE_DTTM) &gt;= ADD_MONTHS(TRUNC(SYSDATE), -18)
      AND NVL(B.BILL_DT, B.CRE_DTTM) &lt; TRUNC(SYSDATE) + 1
    UNION
    SELECT DISTINCT NULLIF(TRIM(NVL(S.BILL_CYC_CD, NVL(B.BILL_CYC_CD, AC.BILL_CYC_CD))), '') AS BILL_CYCLE_CODE
    FROM CISADM.CI_BSEG S
    LEFT JOIN CISADM.CI_BILL B
      ON B.BILL_ID = S.BILL_ID
    LEFT JOIN CISADM.CI_SA SA
      ON SA.SA_ID = S.SA_ID
    LEFT JOIN CISADM.CI_ACCT AC
      ON AC.ACCT_ID = NVL(B.ACCT_ID, SA.ACCT_ID)
    WHERE NULLIF(TRIM(NVL(S.BILL_CYC_CD, NVL(B.BILL_CYC_CD, AC.BILL_CYC_CD))), '') IS NOT NULL
      AND NVL(B.BILL_DT, S.CRE_DTTM) &gt;= ADD_MONTHS(TRUNC(SYSDATE), -18)
      AND NVL(B.BILL_DT, S.CRE_DTTM) &lt; TRUNC(SYSDATE) + 1
  )
) C
LEFT JOIN (
  SELECT
    NULLIF(TRIM(AC.BILL_CYC_CD), '') AS BILL_CYCLE_CODE,
    COUNT(DISTINCT SA.SA_ID) AS EXPECTED_ACTIVE_SA_COUNT,
    COUNT(DISTINCT SA.ACCT_ID) AS EXPECTED_ACTIVE_ACCOUNT_COUNT
  FROM CISADM.CI_SA SA
  JOIN CISADM.CI_ACCT AC
    ON AC.ACCT_ID = SA.ACCT_ID
  WHERE TRIM(SA.SA_STATUS_FLG) = '20'
    AND NULLIF(TRIM(AC.BILL_CYC_CD), '') IS NOT NULL
  GROUP BY NULLIF(TRIM(AC.BILL_CYC_CD), '')
) E
  ON E.BILL_CYCLE_CODE = C.BILL_CYCLE_CODE
LEFT JOIN (
  SELECT
    M.BILL_CYCLE_CODE,
    NVL(LS.ACTUAL_BILLED_SA_COUNT, 0) AS ACTUAL_BILLED_SA_COUNT,
    NVL(LB.ACTUAL_BILLED_ACCOUNT_COUNT, 0) AS ACTUAL_BILLED_ACCOUNT_COUNT,
    NVL(LS.ACTUAL_BILL_SEGMENT_COUNT, 0) AS ACTUAL_BILL_SEGMENT_COUNT,
    NVL(LB.ACTUAL_BILL_COUNT, 0) AS ACTUAL_BILL_COUNT,
    M.CYCLE_LAST_EVENT_DATE
  FROM (
    SELECT
      X.BILL_CYCLE_CODE,
      MAX(X.EVENT_DATE) AS CYCLE_LAST_EVENT_DATE
    FROM (
      SELECT
        NULLIF(TRIM(NVL(B.BILL_CYC_CD, AC.BILL_CYC_CD)), '') AS BILL_CYCLE_CODE,
        TRUNC(NVL(B.BILL_DT, B.CRE_DTTM)) AS EVENT_DATE
      FROM CISADM.CI_BILL B
      LEFT JOIN CISADM.CI_ACCT AC
        ON AC.ACCT_ID = B.ACCT_ID
      WHERE NULLIF(TRIM(NVL(B.BILL_CYC_CD, AC.BILL_CYC_CD)), '') IS NOT NULL
        AND NVL(B.BILL_DT, B.CRE_DTTM) &gt;= ADD_MONTHS(TRUNC(SYSDATE), -18)
        AND NVL(B.BILL_DT, B.CRE_DTTM) &lt; TRUNC(SYSDATE) + 1
      UNION ALL
      SELECT
        NULLIF(TRIM(NVL(S.BILL_CYC_CD, NVL(B.BILL_CYC_CD, AC.BILL_CYC_CD))), '') AS BILL_CYCLE_CODE,
        TRUNC(NVL(B.BILL_DT, S.CRE_DTTM)) AS EVENT_DATE
      FROM CISADM.CI_BSEG S
      LEFT JOIN CISADM.CI_BILL B
        ON B.BILL_ID = S.BILL_ID
      LEFT JOIN CISADM.CI_SA SA
        ON SA.SA_ID = S.SA_ID
      LEFT JOIN CISADM.CI_ACCT AC
        ON AC.ACCT_ID = NVL(B.ACCT_ID, SA.ACCT_ID)
      WHERE NULLIF(TRIM(NVL(S.BILL_CYC_CD, NVL(B.BILL_CYC_CD, AC.BILL_CYC_CD))), '') IS NOT NULL
        AND NVL(B.BILL_DT, S.CRE_DTTM) &gt;= ADD_MONTHS(TRUNC(SYSDATE), -18)
        AND NVL(B.BILL_DT, S.CRE_DTTM) &lt; TRUNC(SYSDATE) + 1
    ) X
    GROUP BY X.BILL_CYCLE_CODE
  ) M
  LEFT JOIN (
    SELECT
      M1.BILL_CYCLE_CODE,
      COUNT(DISTINCT X.BILL_ID) AS ACTUAL_BILL_COUNT,
      COUNT(DISTINCT X.ACCT_ID) AS ACTUAL_BILLED_ACCOUNT_COUNT
    FROM (
      SELECT
        X1.BILL_CYCLE_CODE,
        MAX(X1.EVENT_DATE) AS CYCLE_LAST_EVENT_DATE
      FROM (
        SELECT
          NULLIF(TRIM(NVL(B.BILL_CYC_CD, AC.BILL_CYC_CD)), '') AS BILL_CYCLE_CODE,
          TRUNC(NVL(B.BILL_DT, B.CRE_DTTM)) AS EVENT_DATE
        FROM CISADM.CI_BILL B
        LEFT JOIN CISADM.CI_ACCT AC
          ON AC.ACCT_ID = B.ACCT_ID
        WHERE NULLIF(TRIM(NVL(B.BILL_CYC_CD, AC.BILL_CYC_CD)), '') IS NOT NULL
          AND NVL(B.BILL_DT, B.CRE_DTTM) &gt;= ADD_MONTHS(TRUNC(SYSDATE), -18)
          AND NVL(B.BILL_DT, B.CRE_DTTM) &lt; TRUNC(SYSDATE) + 1
        UNION ALL
        SELECT
          NULLIF(TRIM(NVL(S.BILL_CYC_CD, NVL(B.BILL_CYC_CD, AC.BILL_CYC_CD))), '') AS BILL_CYCLE_CODE,
          TRUNC(NVL(B.BILL_DT, S.CRE_DTTM)) AS EVENT_DATE
        FROM CISADM.CI_BSEG S
        LEFT JOIN CISADM.CI_BILL B
          ON B.BILL_ID = S.BILL_ID
        LEFT JOIN CISADM.CI_SA SA
          ON SA.SA_ID = S.SA_ID
        LEFT JOIN CISADM.CI_ACCT AC
          ON AC.ACCT_ID = NVL(B.ACCT_ID, SA.ACCT_ID)
        WHERE NULLIF(TRIM(NVL(S.BILL_CYC_CD, NVL(B.BILL_CYC_CD, AC.BILL_CYC_CD))), '') IS NOT NULL
          AND NVL(B.BILL_DT, S.CRE_DTTM) &gt;= ADD_MONTHS(TRUNC(SYSDATE), -18)
          AND NVL(B.BILL_DT, S.CRE_DTTM) &lt; TRUNC(SYSDATE) + 1
      ) X1
      GROUP BY X1.BILL_CYCLE_CODE
    ) M1
    JOIN (
      SELECT
        NULLIF(TRIM(NVL(B.BILL_CYC_CD, AC.BILL_CYC_CD)), '') AS BILL_CYCLE_CODE,
        B.ACCT_ID,
        B.BILL_ID,
        TRUNC(NVL(B.BILL_DT, B.CRE_DTTM)) AS EVENT_DATE
      FROM CISADM.CI_BILL B
      LEFT JOIN CISADM.CI_ACCT AC
        ON AC.ACCT_ID = B.ACCT_ID
      WHERE NULLIF(TRIM(NVL(B.BILL_CYC_CD, AC.BILL_CYC_CD)), '') IS NOT NULL
        AND NVL(B.BILL_DT, B.CRE_DTTM) &gt;= ADD_MONTHS(TRUNC(SYSDATE), -18)
        AND NVL(B.BILL_DT, B.CRE_DTTM) &lt; TRUNC(SYSDATE) + 1
    ) X
      ON X.BILL_CYCLE_CODE = M1.BILL_CYCLE_CODE
     AND X.EVENT_DATE = M1.CYCLE_LAST_EVENT_DATE
    GROUP BY M1.BILL_CYCLE_CODE
  ) LB
    ON LB.BILL_CYCLE_CODE = M.BILL_CYCLE_CODE
  LEFT JOIN (
    SELECT
      M2.BILL_CYCLE_CODE,
      COUNT(DISTINCT X.BSEG_ID) AS ACTUAL_BILL_SEGMENT_COUNT,
      COUNT(DISTINCT X.SA_ID) AS ACTUAL_BILLED_SA_COUNT
    FROM (
      SELECT
        X1.BILL_CYCLE_CODE,
        MAX(X1.EVENT_DATE) AS CYCLE_LAST_EVENT_DATE
      FROM (
        SELECT
          NULLIF(TRIM(NVL(B.BILL_CYC_CD, AC.BILL_CYC_CD)), '') AS BILL_CYCLE_CODE,
          TRUNC(NVL(B.BILL_DT, B.CRE_DTTM)) AS EVENT_DATE
        FROM CISADM.CI_BILL B
        LEFT JOIN CISADM.CI_ACCT AC
          ON AC.ACCT_ID = B.ACCT_ID
        WHERE NULLIF(TRIM(NVL(B.BILL_CYC_CD, AC.BILL_CYC_CD)), '') IS NOT NULL
          AND NVL(B.BILL_DT, B.CRE_DTTM) &gt;= ADD_MONTHS(TRUNC(SYSDATE), -18)
          AND NVL(B.BILL_DT, B.CRE_DTTM) &lt; TRUNC(SYSDATE) + 1
        UNION ALL
        SELECT
          NULLIF(TRIM(NVL(S.BILL_CYC_CD, NVL(B.BILL_CYC_CD, AC.BILL_CYC_CD))), '') AS BILL_CYCLE_CODE,
          TRUNC(NVL(B.BILL_DT, S.CRE_DTTM)) AS EVENT_DATE
        FROM CISADM.CI_BSEG S
        LEFT JOIN CISADM.CI_BILL B
          ON B.BILL_ID = S.BILL_ID
        LEFT JOIN CISADM.CI_SA SA
          ON SA.SA_ID = S.SA_ID
        LEFT JOIN CISADM.CI_ACCT AC
          ON AC.ACCT_ID = NVL(B.ACCT_ID, SA.ACCT_ID)
        WHERE NULLIF(TRIM(NVL(S.BILL_CYC_CD, NVL(B.BILL_CYC_CD, AC.BILL_CYC_CD))), '') IS NOT NULL
          AND NVL(B.BILL_DT, S.CRE_DTTM) &gt;= ADD_MONTHS(TRUNC(SYSDATE), -18)
          AND NVL(B.BILL_DT, S.CRE_DTTM) &lt; TRUNC(SYSDATE) + 1
      ) X1
      GROUP BY X1.BILL_CYCLE_CODE
    ) M2
    JOIN (
      SELECT
        NULLIF(TRIM(NVL(S.BILL_CYC_CD, NVL(B.BILL_CYC_CD, AC.BILL_CYC_CD))), '') AS BILL_CYCLE_CODE,
        S.SA_ID,
        S.BSEG_ID,
        TRUNC(NVL(B.BILL_DT, S.CRE_DTTM)) AS EVENT_DATE
      FROM CISADM.CI_BSEG S
      LEFT JOIN CISADM.CI_BILL B
        ON B.BILL_ID = S.BILL_ID
      LEFT JOIN CISADM.CI_SA SA
        ON SA.SA_ID = S.SA_ID
      LEFT JOIN CISADM.CI_ACCT AC
        ON AC.ACCT_ID = NVL(B.ACCT_ID, SA.ACCT_ID)
      WHERE NULLIF(TRIM(NVL(S.BILL_CYC_CD, NVL(B.BILL_CYC_CD, AC.BILL_CYC_CD))), '') IS NOT NULL
        AND NVL(B.BILL_DT, S.CRE_DTTM) &gt;= ADD_MONTHS(TRUNC(SYSDATE), -18)
        AND NVL(B.BILL_DT, S.CRE_DTTM) &lt; TRUNC(SYSDATE) + 1
    ) X
      ON X.BILL_CYCLE_CODE = M2.BILL_CYCLE_CODE
     AND X.EVENT_DATE = M2.CYCLE_LAST_EVENT_DATE
    GROUP BY M2.BILL_CYCLE_CODE
  ) LS
    ON LS.BILL_CYCLE_CODE = M.BILL_CYCLE_CODE
) A
  ON A.BILL_CYCLE_CODE = C.BILL_CYCLE_CODE
LEFT JOIN (
  SELECT
    TRIM(BILL_CYC_CD) AS BILL_CYCLE_CODE,
    MAX(DESCR) AS BILL_CYCLE_DESCRIPTION
  FROM CISADM.CI_BILL_CYC_L
  WHERE LANGUAGE_CD IN ('ENG', 'EN')
  GROUP BY TRIM(BILL_CYC_CD)
) D
  ON D.BILL_CYCLE_CODE = C.BILL_CYCLE_CODE
WHERE C.BILL_CYCLE_CODE IS NOT NULL</query>
    </jdbcQuery>
    <jdbcQuery id="BC_BILLING_VERIFICATION_DETAIL_V2" datasourceId="Origin_DEV_DS">
      <fieldList>
        <field id="BILL_CYCLE_CODE" type="java.lang.String"></field>
        <field id="ACCOUNT_ID" type="java.lang.String"></field>
        <field id="SERVICE_AGREEMENT_ID" type="java.lang.String"></field>
        <field id="PREMISE_ID" type="java.lang.String"></field>
        <field id="BILL_ID" type="java.lang.String"></field>
        <field id="BILL_SEGMENT_ID" type="java.lang.String"></field>
        <field id="BILL_DATE" type="java.sql.Timestamp"></field>
        <field id="BILL_CREATE_DATE" type="java.sql.Timestamp"></field>
        <field id="BSEG_CREATE_DATE" type="java.sql.Timestamp"></field>
        <field id="BILL_STATUS_DESCRIPTION" type="java.lang.String"></field>
        <field id="BSEG_STATUS_DESCRIPTION" type="java.lang.String"></field>
        <field id="IS_ERROR_SW" type="java.lang.String"></field>
        <field id="ERROR_REASON" type="java.lang.String"></field>
        <field id="EXCEPTION_TYPE" type="java.lang.String"></field>
        <field id="RECOMMENDED_ACTION" type="java.lang.String"></field>
        <field id="EVENT_DATE" type="java.sql.Timestamp"></field>
        <field id="MOST_RECENT_BILL_CYCLE_SW" type="java.lang.String"></field>
      </fieldList>
      <query>SELECT
  Y.BILL_CYCLE_CODE,
  Y.ACCOUNT_ID,
  Y.SERVICE_AGREEMENT_ID,
  Y.PREMISE_ID,
  Y.BILL_ID,
  Y.BILL_SEGMENT_ID,
  Y.BILL_DATE,
  Y.BILL_CREATE_DATE,
  Y.BSEG_CREATE_DATE,
  Y.BILL_STATUS_DESCRIPTION,
  Y.BSEG_STATUS_DESCRIPTION,
  'Y' AS IS_ERROR_SW,
  Y.ERROR_REASON,
  Y.EXCEPTION_TYPE,
  Y.RECOMMENDED_ACTION,
  Y.EVENT_DATE,
  CASE
    WHEN Y.EVENT_DATE = MAX(Y.EVENT_DATE) OVER () THEN 'Y'
    ELSE 'N'
  END AS MOST_RECENT_BILL_CYCLE_SW
FROM (
  SELECT
    E.BILL_CYCLE_CODE,
    E.ACCT_ID AS ACCOUNT_ID,
    E.SA_ID AS SERVICE_AGREEMENT_ID,
    CAST(NULL AS VARCHAR2(60)) AS PREMISE_ID,
    CAST(NULL AS VARCHAR2(60)) AS BILL_ID,
    CAST(NULL AS VARCHAR2(60)) AS BILL_SEGMENT_ID,
    CAST(NULL AS DATE) AS BILL_DATE,
    CAST(NULL AS DATE) AS BILL_CREATE_DATE,
    CAST(NULL AS DATE) AS BSEG_CREATE_DATE,
    CAST(NULL AS VARCHAR2(200)) AS BILL_STATUS_DESCRIPTION,
    CAST(NULL AS VARCHAR2(200)) AS BSEG_STATUS_DESCRIPTION,
    'MISSING_EXPECTED_BILL' AS EXCEPTION_TYPE,
    'Active service agreement is assigned to the cycle but no bill header appears in the latest cycle snapshot.' AS ERROR_REASON,
    'Review account billing completion and batch outcome for the latest cycle run.' AS RECOMMENDED_ACTION,
    M.CYCLE_LAST_EVENT_DATE AS EVENT_DATE
  FROM (
    SELECT
      NULLIF(TRIM(AC.BILL_CYC_CD), '') AS BILL_CYCLE_CODE,
      SA.ACCT_ID,
      SA.SA_ID
    FROM CISADM.CI_SA SA
    JOIN CISADM.CI_ACCT AC
      ON AC.ACCT_ID = SA.ACCT_ID
    WHERE TRIM(SA.SA_STATUS_FLG) = '20'
      AND NULLIF(TRIM(AC.BILL_CYC_CD), '') IS NOT NULL
  ) E
  JOIN (
    SELECT
      X.BILL_CYCLE_CODE,
      MAX(X.EVENT_DATE) AS CYCLE_LAST_EVENT_DATE
    FROM (
      SELECT
        NULLIF(TRIM(NVL(B.BILL_CYC_CD, AC.BILL_CYC_CD)), '') AS BILL_CYCLE_CODE,
        TRUNC(NVL(B.BILL_DT, B.CRE_DTTM)) AS EVENT_DATE
      FROM CISADM.CI_BILL B
      LEFT JOIN CISADM.CI_ACCT AC
        ON AC.ACCT_ID = B.ACCT_ID
      WHERE NULLIF(TRIM(NVL(B.BILL_CYC_CD, AC.BILL_CYC_CD)), '') IS NOT NULL
        AND NVL(B.BILL_DT, B.CRE_DTTM) &gt;= ADD_MONTHS(TRUNC(SYSDATE), -18)
        AND NVL(B.BILL_DT, B.CRE_DTTM) &lt; TRUNC(SYSDATE) + 1
      UNION ALL
      SELECT
        NULLIF(TRIM(NVL(S.BILL_CYC_CD, NVL(B.BILL_CYC_CD, AC.BILL_CYC_CD))), '') AS BILL_CYCLE_CODE,
        TRUNC(NVL(B.BILL_DT, S.CRE_DTTM)) AS EVENT_DATE
      FROM CISADM.CI_BSEG S
      LEFT JOIN CISADM.CI_BILL B
        ON B.BILL_ID = S.BILL_ID
      LEFT JOIN CISADM.CI_SA SA
        ON SA.SA_ID = S.SA_ID
      LEFT JOIN CISADM.CI_ACCT AC
        ON AC.ACCT_ID = NVL(B.ACCT_ID, SA.ACCT_ID)
      WHERE NULLIF(TRIM(NVL(S.BILL_CYC_CD, NVL(B.BILL_CYC_CD, AC.BILL_CYC_CD))), '') IS NOT NULL
        AND NVL(B.BILL_DT, S.CRE_DTTM) &gt;= ADD_MONTHS(TRUNC(SYSDATE), -18)
        AND NVL(B.BILL_DT, S.CRE_DTTM) &lt; TRUNC(SYSDATE) + 1
    ) X
    GROUP BY X.BILL_CYCLE_CODE
  ) M
    ON M.BILL_CYCLE_CODE = E.BILL_CYCLE_CODE
  LEFT JOIN (
    SELECT
      M1.BILL_CYCLE_CODE,
      X.ACCT_ID
    FROM (
      SELECT
        X1.BILL_CYCLE_CODE,
        MAX(X1.EVENT_DATE) AS CYCLE_LAST_EVENT_DATE
      FROM (
        SELECT
          NULLIF(TRIM(NVL(B.BILL_CYC_CD, AC.BILL_CYC_CD)), '') AS BILL_CYCLE_CODE,
          TRUNC(NVL(B.BILL_DT, B.CRE_DTTM)) AS EVENT_DATE
        FROM CISADM.CI_BILL B
        LEFT JOIN CISADM.CI_ACCT AC
          ON AC.ACCT_ID = B.ACCT_ID
        WHERE NULLIF(TRIM(NVL(B.BILL_CYC_CD, AC.BILL_CYC_CD)), '') IS NOT NULL
          AND NVL(B.BILL_DT, B.CRE_DTTM) &gt;= ADD_MONTHS(TRUNC(SYSDATE), -18)
          AND NVL(B.BILL_DT, B.CRE_DTTM) &lt; TRUNC(SYSDATE) + 1
        UNION ALL
        SELECT
          NULLIF(TRIM(NVL(S.BILL_CYC_CD, NVL(B.BILL_CYC_CD, AC.BILL_CYC_CD))), '') AS BILL_CYCLE_CODE,
          TRUNC(NVL(B.BILL_DT, S.CRE_DTTM)) AS EVENT_DATE
        FROM CISADM.CI_BSEG S
        LEFT JOIN CISADM.CI_BILL B
          ON B.BILL_ID = S.BILL_ID
        LEFT JOIN CISADM.CI_SA SA
          ON SA.SA_ID = S.SA_ID
        LEFT JOIN CISADM.CI_ACCT AC
          ON AC.ACCT_ID = NVL(B.ACCT_ID, SA.ACCT_ID)
        WHERE NULLIF(TRIM(NVL(S.BILL_CYC_CD, NVL(B.BILL_CYC_CD, AC.BILL_CYC_CD))), '') IS NOT NULL
          AND NVL(B.BILL_DT, S.CRE_DTTM) &gt;= ADD_MONTHS(TRUNC(SYSDATE), -18)
          AND NVL(B.BILL_DT, S.CRE_DTTM) &lt; TRUNC(SYSDATE) + 1
      ) X1
      GROUP BY X1.BILL_CYCLE_CODE
    ) M1
    JOIN (
      SELECT
        NULLIF(TRIM(NVL(B.BILL_CYC_CD, AC.BILL_CYC_CD)), '') AS BILL_CYCLE_CODE,
        B.ACCT_ID,
        TRUNC(NVL(B.BILL_DT, B.CRE_DTTM)) AS EVENT_DATE
      FROM CISADM.CI_BILL B
      LEFT JOIN CISADM.CI_ACCT AC
        ON AC.ACCT_ID = B.ACCT_ID
      WHERE NULLIF(TRIM(NVL(B.BILL_CYC_CD, AC.BILL_CYC_CD)), '') IS NOT NULL
        AND NVL(B.BILL_DT, B.CRE_DTTM) &gt;= ADD_MONTHS(TRUNC(SYSDATE), -18)
        AND NVL(B.BILL_DT, B.CRE_DTTM) &lt; TRUNC(SYSDATE) + 1
    ) X
      ON X.BILL_CYCLE_CODE = M1.BILL_CYCLE_CODE
     AND X.EVENT_DATE = M1.CYCLE_LAST_EVENT_DATE
  ) LB
    ON LB.BILL_CYCLE_CODE = E.BILL_CYCLE_CODE
   AND LB.ACCT_ID = E.ACCT_ID
  WHERE LB.ACCT_ID IS NULL

  UNION ALL

  SELECT
    LB.BILL_CYCLE_CODE,
    LB.ACCOUNT_ID,
    CAST(NULL AS VARCHAR2(60)) AS SERVICE_AGREEMENT_ID,
    CAST(NULL AS VARCHAR2(60)) AS PREMISE_ID,
    LB.BILL_ID,
    CAST(NULL AS VARCHAR2(60)) AS BILL_SEGMENT_ID,
    LB.BILL_DATE,
    LB.BILL_CREATE_DATE,
    CAST(NULL AS DATE) AS BSEG_CREATE_DATE,
    LB.BILL_STATUS_DESCRIPTION,
    CAST(NULL AS VARCHAR2(200)) AS BSEG_STATUS_DESCRIPTION,
    'MISSING_BSEG' AS EXCEPTION_TYPE,
    'Bill header exists in the latest cycle snapshot but no bill segment row is linked to that bill.' AS ERROR_REASON,
    'Review bill segment generation and confirm the bill completed with segment output.' AS RECOMMENDED_ACTION,
    LB.EVENT_DATE
  FROM (
    SELECT
      M.BILL_CYCLE_CODE,
      X.ACCT_ID AS ACCOUNT_ID,
      X.BILL_ID,
      TRUNC(X.BILL_DATE) AS BILL_DATE,
      TRUNC(X.BILL_CREATE_DATE) AS BILL_CREATE_DATE,
      NVL(BS.STATUS_DESCRIPTION, 'BILL_STATUS_' || X.BILL_STAT_FLG) AS BILL_STATUS_DESCRIPTION,
      X.EVENT_DATE
    FROM (
      SELECT
        X1.BILL_CYCLE_CODE,
        MAX(X1.EVENT_DATE) AS CYCLE_LAST_EVENT_DATE
      FROM (
        SELECT
          NULLIF(TRIM(NVL(B.BILL_CYC_CD, AC.BILL_CYC_CD)), '') AS BILL_CYCLE_CODE,
          TRUNC(NVL(B.BILL_DT, B.CRE_DTTM)) AS EVENT_DATE
        FROM CISADM.CI_BILL B
        LEFT JOIN CISADM.CI_ACCT AC
          ON AC.ACCT_ID = B.ACCT_ID
        WHERE NULLIF(TRIM(NVL(B.BILL_CYC_CD, AC.BILL_CYC_CD)), '') IS NOT NULL
          AND NVL(B.BILL_DT, B.CRE_DTTM) &gt;= ADD_MONTHS(TRUNC(SYSDATE), -18)
          AND NVL(B.BILL_DT, B.CRE_DTTM) &lt; TRUNC(SYSDATE) + 1
        UNION ALL
        SELECT
          NULLIF(TRIM(NVL(S.BILL_CYC_CD, NVL(B.BILL_CYC_CD, AC.BILL_CYC_CD))), '') AS BILL_CYCLE_CODE,
          TRUNC(NVL(B.BILL_DT, S.CRE_DTTM)) AS EVENT_DATE
        FROM CISADM.CI_BSEG S
        LEFT JOIN CISADM.CI_BILL B
          ON B.BILL_ID = S.BILL_ID
        LEFT JOIN CISADM.CI_SA SA
          ON SA.SA_ID = S.SA_ID
        LEFT JOIN CISADM.CI_ACCT AC
          ON AC.ACCT_ID = NVL(B.ACCT_ID, SA.ACCT_ID)
        WHERE NULLIF(TRIM(NVL(S.BILL_CYC_CD, NVL(B.BILL_CYC_CD, AC.BILL_CYC_CD))), '') IS NOT NULL
          AND NVL(B.BILL_DT, S.CRE_DTTM) &gt;= ADD_MONTHS(TRUNC(SYSDATE), -18)
          AND NVL(B.BILL_DT, S.CRE_DTTM) &lt; TRUNC(SYSDATE) + 1
      ) X1
      GROUP BY X1.BILL_CYCLE_CODE
    ) M
    JOIN (
      SELECT
        NULLIF(TRIM(NVL(B.BILL_CYC_CD, AC.BILL_CYC_CD)), '') AS BILL_CYCLE_CODE,
        B.ACCT_ID,
        B.BILL_ID,
        B.BILL_DT AS BILL_DATE,
        B.CRE_DTTM AS BILL_CREATE_DATE,
        B.BILL_STAT_FLG,
        TRUNC(NVL(B.BILL_DT, B.CRE_DTTM)) AS EVENT_DATE
      FROM CISADM.CI_BILL B
      LEFT JOIN CISADM.CI_ACCT AC
        ON AC.ACCT_ID = B.ACCT_ID
      WHERE NULLIF(TRIM(NVL(B.BILL_CYC_CD, AC.BILL_CYC_CD)), '') IS NOT NULL
        AND NVL(B.BILL_DT, B.CRE_DTTM) &gt;= ADD_MONTHS(TRUNC(SYSDATE), -18)
        AND NVL(B.BILL_DT, B.CRE_DTTM) &lt; TRUNC(SYSDATE) + 1
    ) X
      ON X.BILL_CYCLE_CODE = M.BILL_CYCLE_CODE
     AND X.EVENT_DATE = M.CYCLE_LAST_EVENT_DATE
    LEFT JOIN (
      SELECT
        FIELD_VALUE AS STATUS_CODE,
        MAX(DESCR) AS STATUS_DESCRIPTION
      FROM CISADM.CI_LOOKUP_VAL_L
      WHERE FIELD_NAME = 'BILL_STAT_FLG'
        AND LANGUAGE_CD = 'ENG'
      GROUP BY FIELD_VALUE
    ) BS
      ON BS.STATUS_CODE = X.BILL_STAT_FLG
  ) LB
  LEFT JOIN (
    SELECT
      M.BILL_CYCLE_CODE,
      X.BILL_ID
    FROM (
      SELECT
        X1.BILL_CYCLE_CODE,
        MAX(X1.EVENT_DATE) AS CYCLE_LAST_EVENT_DATE
      FROM (
        SELECT
          NULLIF(TRIM(NVL(B.BILL_CYC_CD, AC.BILL_CYC_CD)), '') AS BILL_CYCLE_CODE,
          TRUNC(NVL(B.BILL_DT, B.CRE_DTTM)) AS EVENT_DATE
        FROM CISADM.CI_BILL B
        LEFT JOIN CISADM.CI_ACCT AC
          ON AC.ACCT_ID = B.ACCT_ID
        WHERE NULLIF(TRIM(NVL(B.BILL_CYC_CD, AC.BILL_CYC_CD)), '') IS NOT NULL
          AND NVL(B.BILL_DT, B.CRE_DTTM) &gt;= ADD_MONTHS(TRUNC(SYSDATE), -18)
          AND NVL(B.BILL_DT, B.CRE_DTTM) &lt; TRUNC(SYSDATE) + 1
        UNION ALL
        SELECT
          NULLIF(TRIM(NVL(S.BILL_CYC_CD, NVL(B.BILL_CYC_CD, AC.BILL_CYC_CD))), '') AS BILL_CYCLE_CODE,
          TRUNC(NVL(B.BILL_DT, S.CRE_DTTM)) AS EVENT_DATE
        FROM CISADM.CI_BSEG S
        LEFT JOIN CISADM.CI_BILL B
          ON B.BILL_ID = S.BILL_ID
        LEFT JOIN CISADM.CI_SA SA
          ON SA.SA_ID = S.SA_ID
        LEFT JOIN CISADM.CI_ACCT AC
          ON AC.ACCT_ID = NVL(B.ACCT_ID, SA.ACCT_ID)
        WHERE NULLIF(TRIM(NVL(S.BILL_CYC_CD, NVL(B.BILL_CYC_CD, AC.BILL_CYC_CD))), '') IS NOT NULL
          AND NVL(B.BILL_DT, S.CRE_DTTM) &gt;= ADD_MONTHS(TRUNC(SYSDATE), -18)
          AND NVL(B.BILL_DT, S.CRE_DTTM) &lt; TRUNC(SYSDATE) + 1
      ) X1
      GROUP BY X1.BILL_CYCLE_CODE
    ) M
    JOIN (
      SELECT
        NULLIF(TRIM(NVL(S.BILL_CYC_CD, NVL(B.BILL_CYC_CD, AC.BILL_CYC_CD))), '') AS BILL_CYCLE_CODE,
        S.BILL_ID,
        TRUNC(NVL(B.BILL_DT, S.CRE_DTTM)) AS EVENT_DATE
      FROM CISADM.CI_BSEG S
      LEFT JOIN CISADM.CI_BILL B
        ON B.BILL_ID = S.BILL_ID
      LEFT JOIN CISADM.CI_SA SA
        ON SA.SA_ID = S.SA_ID
      LEFT JOIN CISADM.CI_ACCT AC
        ON AC.ACCT_ID = NVL(B.ACCT_ID, SA.ACCT_ID)
      WHERE NULLIF(TRIM(NVL(S.BILL_CYC_CD, NVL(B.BILL_CYC_CD, AC.BILL_CYC_CD))), '') IS NOT NULL
        AND NVL(B.BILL_DT, S.CRE_DTTM) &gt;= ADD_MONTHS(TRUNC(SYSDATE), -18)
        AND NVL(B.BILL_DT, S.CRE_DTTM) &lt; TRUNC(SYSDATE) + 1
    ) X
      ON X.BILL_CYCLE_CODE = M.BILL_CYCLE_CODE
     AND X.EVENT_DATE = M.CYCLE_LAST_EVENT_DATE
  ) LS
    ON LS.BILL_CYCLE_CODE = LB.BILL_CYCLE_CODE
   AND LS.BILL_ID = LB.BILL_ID
  WHERE LS.BILL_ID IS NULL

  UNION ALL

  SELECT
    LS.BILL_CYCLE_CODE,
    LS.ACCOUNT_ID,
    LS.SERVICE_AGREEMENT_ID,
    LS.PREMISE_ID,
    LS.BILL_ID,
    LS.BILL_SEGMENT_ID,
    LS.BILL_DATE,
    LS.BILL_CREATE_DATE,
    LS.BSEG_CREATE_DATE,
    LS.BILL_STATUS_DESCRIPTION,
    LS.BSEG_STATUS_DESCRIPTION,
    'ORPHAN_BSEG' AS EXCEPTION_TYPE,
    'Bill segment row exists in the latest cycle snapshot but no matching bill header is present.' AS ERROR_REASON,
    'Review bill header creation and confirm the segment is attached to the correct bill.' AS RECOMMENDED_ACTION,
    LS.EVENT_DATE
  FROM (
    SELECT
      M.BILL_CYCLE_CODE,
      NVL(B.ACCT_ID, SA.ACCT_ID) AS ACCOUNT_ID,
      S.SA_ID AS SERVICE_AGREEMENT_ID,
      S.PREM_ID AS PREMISE_ID,
      S.BILL_ID,
      S.BSEG_ID AS BILL_SEGMENT_ID,
      B.BILL_DT AS BILL_DATE,
      B.CRE_DTTM AS BILL_CREATE_DATE,
      S.CRE_DTTM AS BSEG_CREATE_DATE,
      NVL(BS.STATUS_DESCRIPTION, 'BILL_STATUS_' || B.BILL_STAT_FLG) AS BILL_STATUS_DESCRIPTION,
      NVL(SS.STATUS_DESCRIPTION, 'BSEG_STATUS_' || S.BSEG_STAT_FLG) AS BSEG_STATUS_DESCRIPTION,
      TRUNC(NVL(B.BILL_DT, S.CRE_DTTM)) AS EVENT_DATE
    FROM (
      SELECT
        X1.BILL_CYCLE_CODE,
        MAX(X1.EVENT_DATE) AS CYCLE_LAST_EVENT_DATE
      FROM (
        SELECT
          NULLIF(TRIM(NVL(B.BILL_CYC_CD, AC.BILL_CYC_CD)), '') AS BILL_CYCLE_CODE,
          TRUNC(NVL(B.BILL_DT, B.CRE_DTTM)) AS EVENT_DATE
        FROM CISADM.CI_BILL B
        LEFT JOIN CISADM.CI_ACCT AC
          ON AC.ACCT_ID = B.ACCT_ID
        WHERE NULLIF(TRIM(NVL(B.BILL_CYC_CD, AC.BILL_CYC_CD)), '') IS NOT NULL
          AND NVL(B.BILL_DT, B.CRE_DTTM) &gt;= ADD_MONTHS(TRUNC(SYSDATE), -18)
          AND NVL(B.BILL_DT, B.CRE_DTTM) &lt; TRUNC(SYSDATE) + 1
        UNION ALL
        SELECT
          NULLIF(TRIM(NVL(S.BILL_CYC_CD, NVL(B.BILL_CYC_CD, AC.BILL_CYC_CD))), '') AS BILL_CYCLE_CODE,
          TRUNC(NVL(B.BILL_DT, S.CRE_DTTM)) AS EVENT_DATE
        FROM CISADM.CI_BSEG S
        LEFT JOIN CISADM.CI_BILL B
          ON B.BILL_ID = S.BILL_ID
        LEFT JOIN CISADM.CI_SA SA
          ON SA.SA_ID = S.SA_ID
        LEFT JOIN CISADM.CI_ACCT AC
          ON AC.ACCT_ID = NVL(B.ACCT_ID, SA.ACCT_ID)
        WHERE NULLIF(TRIM(NVL(S.BILL_CYC_CD, NVL(B.BILL_CYC_CD, AC.BILL_CYC_CD))), '') IS NOT NULL
          AND NVL(B.BILL_DT, S.CRE_DTTM) &gt;= ADD_MONTHS(TRUNC(SYSDATE), -18)
          AND NVL(B.BILL_DT, S.CRE_DTTM) &lt; TRUNC(SYSDATE) + 1
      ) X1
      GROUP BY X1.BILL_CYCLE_CODE
    ) M
    JOIN CISADM.CI_BSEG S
      ON NULLIF(TRIM(S.BILL_CYC_CD), '') = M.BILL_CYCLE_CODE
    LEFT JOIN CISADM.CI_BILL B
      ON B.BILL_ID = S.BILL_ID
    LEFT JOIN CISADM.CI_SA SA
      ON SA.SA_ID = S.SA_ID
    LEFT JOIN CISADM.CI_ACCT AC
      ON AC.ACCT_ID = NVL(B.ACCT_ID, SA.ACCT_ID)
    LEFT JOIN (
      SELECT
        FIELD_VALUE AS STATUS_CODE,
        MAX(DESCR) AS STATUS_DESCRIPTION
      FROM CISADM.CI_LOOKUP_VAL_L
      WHERE FIELD_NAME = 'BILL_STAT_FLG'
        AND LANGUAGE_CD = 'ENG'
      GROUP BY FIELD_VALUE
    ) BS
      ON BS.STATUS_CODE = B.BILL_STAT_FLG
    LEFT JOIN (
      SELECT
        FIELD_VALUE AS STATUS_CODE,
        MAX(DESCR) AS STATUS_DESCRIPTION
      FROM CISADM.CI_LOOKUP_VAL_L
      WHERE FIELD_NAME = 'BSEG_STAT_FLG'
        AND LANGUAGE_CD = 'ENG'
      GROUP BY FIELD_VALUE
    ) SS
      ON SS.STATUS_CODE = S.BSEG_STAT_FLG
    WHERE TRUNC(NVL(B.BILL_DT, S.CRE_DTTM)) = M.CYCLE_LAST_EVENT_DATE
  ) LS
  LEFT JOIN (
    SELECT
      M.BILL_CYCLE_CODE,
      X.BILL_ID
    FROM (
      SELECT
        X1.BILL_CYCLE_CODE,
        MAX(X1.EVENT_DATE) AS CYCLE_LAST_EVENT_DATE
      FROM (
        SELECT
          NULLIF(TRIM(NVL(B.BILL_CYC_CD, AC.BILL_CYC_CD)), '') AS BILL_CYCLE_CODE,
          TRUNC(NVL(B.BILL_DT, B.CRE_DTTM)) AS EVENT_DATE
        FROM CISADM.CI_BILL B
        LEFT JOIN CISADM.CI_ACCT AC
          ON AC.ACCT_ID = B.ACCT_ID
        WHERE NULLIF(TRIM(NVL(B.BILL_CYC_CD, AC.BILL_CYC_CD)), '') IS NOT NULL
          AND NVL(B.BILL_DT, B.CRE_DTTM) &gt;= ADD_MONTHS(TRUNC(SYSDATE), -18)
          AND NVL(B.BILL_DT, B.CRE_DTTM) &lt; TRUNC(SYSDATE) + 1
        UNION ALL
        SELECT
          NULLIF(TRIM(NVL(S.BILL_CYC_CD, NVL(B.BILL_CYC_CD, AC.BILL_CYC_CD))), '') AS BILL_CYCLE_CODE,
          TRUNC(NVL(B.BILL_DT, S.CRE_DTTM)) AS EVENT_DATE
        FROM CISADM.CI_BSEG S
        LEFT JOIN CISADM.CI_BILL B
          ON B.BILL_ID = S.BILL_ID
        LEFT JOIN CISADM.CI_SA SA
          ON SA.SA_ID = S.SA_ID
        LEFT JOIN CISADM.CI_ACCT AC
          ON AC.ACCT_ID = NVL(B.ACCT_ID, SA.ACCT_ID)
        WHERE NULLIF(TRIM(NVL(S.BILL_CYC_CD, NVL(B.BILL_CYC_CD, AC.BILL_CYC_CD))), '') IS NOT NULL
          AND NVL(B.BILL_DT, S.CRE_DTTM) &gt;= ADD_MONTHS(TRUNC(SYSDATE), -18)
          AND NVL(B.BILL_DT, S.CRE_DTTM) &lt; TRUNC(SYSDATE) + 1
      ) X1
      GROUP BY X1.BILL_CYCLE_CODE
    ) M
    JOIN (
      SELECT
        NULLIF(TRIM(NVL(B.BILL_CYC_CD, AC.BILL_CYC_CD)), '') AS BILL_CYCLE_CODE,
        B.BILL_ID,
        TRUNC(NVL(B.BILL_DT, B.CRE_DTTM)) AS EVENT_DATE
      FROM CISADM.CI_BILL B
      LEFT JOIN CISADM.CI_ACCT AC
        ON AC.ACCT_ID = B.ACCT_ID
      WHERE NULLIF(TRIM(NVL(B.BILL_CYC_CD, AC.BILL_CYC_CD)), '') IS NOT NULL
        AND NVL(B.BILL_DT, B.CRE_DTTM) &gt;= ADD_MONTHS(TRUNC(SYSDATE), -18)
        AND NVL(B.BILL_DT, B.CRE_DTTM) &lt; TRUNC(SYSDATE) + 1
    ) X
      ON X.BILL_CYCLE_CODE = M.BILL_CYCLE_CODE
     AND X.EVENT_DATE = M.CYCLE_LAST_EVENT_DATE
  ) LB
    ON LB.BILL_CYCLE_CODE = LS.BILL_CYCLE_CODE
   AND LB.BILL_ID = LS.BILL_ID
  WHERE LB.BILL_ID IS NULL

  UNION ALL

  SELECT
    LB.BILL_CYCLE_CODE,
    LB.ACCOUNT_ID,
    CAST(NULL AS VARCHAR2(60)) AS SERVICE_AGREEMENT_ID,
    CAST(NULL AS VARCHAR2(60)) AS PREMISE_ID,
    LB.BILL_ID,
    CAST(NULL AS VARCHAR2(60)) AS BILL_SEGMENT_ID,
    LB.BILL_DATE,
    LB.BILL_CREATE_DATE,
    CAST(NULL AS DATE) AS BSEG_CREATE_DATE,
    LB.BILL_STATUS_DESCRIPTION,
    CAST(NULL AS VARCHAR2(200)) AS BSEG_STATUS_DESCRIPTION,
    'BILL_STATUS_EXCEPTION' AS EXCEPTION_TYPE,
    'Bill status indicates an exception condition in the latest cycle snapshot.' AS ERROR_REASON,
    'Review bill status and billing batch logs for the affected bill.' AS RECOMMENDED_ACTION,
    LB.EVENT_DATE
  FROM (
    SELECT
      M.BILL_CYCLE_CODE,
      X.ACCT_ID AS ACCOUNT_ID,
      X.BILL_ID,
      TRUNC(X.BILL_DATE) AS BILL_DATE,
      TRUNC(X.BILL_CREATE_DATE) AS BILL_CREATE_DATE,
      BS.STATUS_DESCRIPTION AS BILL_STATUS_DESCRIPTION,
      X.EVENT_DATE
    FROM (
      SELECT
        X1.BILL_CYCLE_CODE,
        MAX(X1.EVENT_DATE) AS CYCLE_LAST_EVENT_DATE
      FROM (
        SELECT
          NULLIF(TRIM(NVL(B.BILL_CYC_CD, AC.BILL_CYC_CD)), '') AS BILL_CYCLE_CODE,
          TRUNC(NVL(B.BILL_DT, B.CRE_DTTM)) AS EVENT_DATE
        FROM CISADM.CI_BILL B
        LEFT JOIN CISADM.CI_ACCT AC
          ON AC.ACCT_ID = B.ACCT_ID
        WHERE NULLIF(TRIM(NVL(B.BILL_CYC_CD, AC.BILL_CYC_CD)), '') IS NOT NULL
          AND NVL(B.BILL_DT, B.CRE_DTTM) &gt;= ADD_MONTHS(TRUNC(SYSDATE), -18)
          AND NVL(B.BILL_DT, B.CRE_DTTM) &lt; TRUNC(SYSDATE) + 1
        UNION ALL
        SELECT
          NULLIF(TRIM(NVL(S.BILL_CYC_CD, NVL(B.BILL_CYC_CD, AC.BILL_CYC_CD))), '') AS BILL_CYCLE_CODE,
          TRUNC(NVL(B.BILL_DT, S.CRE_DTTM)) AS EVENT_DATE
        FROM CISADM.CI_BSEG S
        LEFT JOIN CISADM.CI_BILL B
          ON B.BILL_ID = S.BILL_ID
        LEFT JOIN CISADM.CI_SA SA
          ON SA.SA_ID = S.SA_ID
        LEFT JOIN CISADM.CI_ACCT AC
          ON AC.ACCT_ID = NVL(B.ACCT_ID, SA.ACCT_ID)
        WHERE NULLIF(TRIM(NVL(S.BILL_CYC_CD, NVL(B.BILL_CYC_CD, AC.BILL_CYC_CD))), '') IS NOT NULL
          AND NVL(B.BILL_DT, S.CRE_DTTM) &gt;= ADD_MONTHS(TRUNC(SYSDATE), -18)
          AND NVL(B.BILL_DT, S.CRE_DTTM) &lt; TRUNC(SYSDATE) + 1
      ) X1
      GROUP BY X1.BILL_CYCLE_CODE
    ) M
    JOIN (
      SELECT
        NULLIF(TRIM(NVL(B.BILL_CYC_CD, AC.BILL_CYC_CD)), '') AS BILL_CYCLE_CODE,
        B.ACCT_ID,
        B.BILL_ID,
        B.BILL_DT AS BILL_DATE,
        B.CRE_DTTM AS BILL_CREATE_DATE,
        B.BILL_STAT_FLG,
        TRUNC(NVL(B.BILL_DT, B.CRE_DTTM)) AS EVENT_DATE
      FROM CISADM.CI_BILL B
      LEFT JOIN CISADM.CI_ACCT AC
        ON AC.ACCT_ID = B.ACCT_ID
      WHERE NULLIF(TRIM(NVL(B.BILL_CYC_CD, AC.BILL_CYC_CD)), '') IS NOT NULL
        AND NVL(B.BILL_DT, B.CRE_DTTM) &gt;= ADD_MONTHS(TRUNC(SYSDATE), -18)
        AND NVL(B.BILL_DT, B.CRE_DTTM) &lt; TRUNC(SYSDATE) + 1
    ) X
      ON X.BILL_CYCLE_CODE = M.BILL_CYCLE_CODE
     AND X.EVENT_DATE = M.CYCLE_LAST_EVENT_DATE
    LEFT JOIN (
      SELECT
        FIELD_VALUE AS STATUS_CODE,
        MAX(DESCR) AS STATUS_DESCRIPTION
      FROM CISADM.CI_LOOKUP_VAL_L
      WHERE FIELD_NAME = 'BILL_STAT_FLG'
        AND LANGUAGE_CD = 'ENG'
      GROUP BY FIELD_VALUE
    ) BS
      ON BS.STATUS_CODE = X.BILL_STAT_FLG
  ) LB
  WHERE REGEXP_LIKE(UPPER(NVL(LB.BILL_STATUS_DESCRIPTION, '')), 'ERROR|EXCEPTION|FAIL')

  UNION ALL

  SELECT
    LS.BILL_CYCLE_CODE,
    LS.ACCOUNT_ID,
    LS.SERVICE_AGREEMENT_ID,
    LS.PREMISE_ID,
    LS.BILL_ID,
    LS.BILL_SEGMENT_ID,
    LS.BILL_DATE,
    LS.BILL_CREATE_DATE,
    LS.BSEG_CREATE_DATE,
    LS.BILL_STATUS_DESCRIPTION,
    LS.BSEG_STATUS_DESCRIPTION,
    'BSEG_STATUS_EXCEPTION' AS EXCEPTION_TYPE,
    'Bill segment status indicates an exception condition in the latest cycle snapshot.' AS ERROR_REASON,
    'Review bill segment status and the billing batch or retry path for the segment.' AS RECOMMENDED_ACTION,
    LS.EVENT_DATE
  FROM (
    SELECT
      M.BILL_CYCLE_CODE,
      NVL(B.ACCT_ID, SA.ACCT_ID) AS ACCOUNT_ID,
      S.SA_ID AS SERVICE_AGREEMENT_ID,
      S.PREM_ID AS PREMISE_ID,
      S.BILL_ID,
      S.BSEG_ID AS BILL_SEGMENT_ID,
      B.BILL_DT AS BILL_DATE,
      B.CRE_DTTM AS BILL_CREATE_DATE,
      S.CRE_DTTM AS BSEG_CREATE_DATE,
      NVL(BS.STATUS_DESCRIPTION, 'BILL_STATUS_' || B.BILL_STAT_FLG) AS BILL_STATUS_DESCRIPTION,
      NVL(SS.STATUS_DESCRIPTION, 'BSEG_STATUS_' || S.BSEG_STAT_FLG) AS BSEG_STATUS_DESCRIPTION,
      TRUNC(NVL(B.BILL_DT, S.CRE_DTTM)) AS EVENT_DATE
    FROM (
      SELECT
        X1.BILL_CYCLE_CODE,
        MAX(X1.EVENT_DATE) AS CYCLE_LAST_EVENT_DATE
      FROM (
        SELECT
          NULLIF(TRIM(NVL(B.BILL_CYC_CD, AC.BILL_CYC_CD)), '') AS BILL_CYCLE_CODE,
          TRUNC(NVL(B.BILL_DT, B.CRE_DTTM)) AS EVENT_DATE
        FROM CISADM.CI_BILL B
        LEFT JOIN CISADM.CI_ACCT AC
          ON AC.ACCT_ID = B.ACCT_ID
        WHERE NULLIF(TRIM(NVL(B.BILL_CYC_CD, AC.BILL_CYC_CD)), '') IS NOT NULL
          AND NVL(B.BILL_DT, B.CRE_DTTM) &gt;= ADD_MONTHS(TRUNC(SYSDATE), -18)
          AND NVL(B.BILL_DT, B.CRE_DTTM) &lt; TRUNC(SYSDATE) + 1
        UNION ALL
        SELECT
          NULLIF(TRIM(NVL(S.BILL_CYC_CD, NVL(B.BILL_CYC_CD, AC.BILL_CYC_CD))), '') AS BILL_CYCLE_CODE,
          TRUNC(NVL(B.BILL_DT, S.CRE_DTTM)) AS EVENT_DATE
        FROM CISADM.CI_BSEG S
        LEFT JOIN CISADM.CI_BILL B
          ON B.BILL_ID = S.BILL_ID
        LEFT JOIN CISADM.CI_SA SA
          ON SA.SA_ID = S.SA_ID
        LEFT JOIN CISADM.CI_ACCT AC
          ON AC.ACCT_ID = NVL(B.ACCT_ID, SA.ACCT_ID)
        WHERE NULLIF(TRIM(NVL(S.BILL_CYC_CD, NVL(B.BILL_CYC_CD, AC.BILL_CYC_CD))), '') IS NOT NULL
          AND NVL(B.BILL_DT, S.CRE_DTTM) &gt;= ADD_MONTHS(TRUNC(SYSDATE), -18)
          AND NVL(B.BILL_DT, S.CRE_DTTM) &lt; TRUNC(SYSDATE) + 1
      ) X1
      GROUP BY X1.BILL_CYCLE_CODE
    ) M
    JOIN CISADM.CI_BSEG S
      ON NULLIF(TRIM(S.BILL_CYC_CD), '') = M.BILL_CYCLE_CODE
    LEFT JOIN CISADM.CI_BILL B
      ON B.BILL_ID = S.BILL_ID
    LEFT JOIN CISADM.CI_SA SA
      ON SA.SA_ID = S.SA_ID
    LEFT JOIN CISADM.CI_ACCT AC
      ON AC.ACCT_ID = NVL(B.ACCT_ID, SA.ACCT_ID)
    LEFT JOIN (
      SELECT
        FIELD_VALUE AS STATUS_CODE,
        MAX(DESCR) AS STATUS_DESCRIPTION
      FROM CISADM.CI_LOOKUP_VAL_L
      WHERE FIELD_NAME = 'BILL_STAT_FLG'
        AND LANGUAGE_CD = 'ENG'
      GROUP BY FIELD_VALUE
    ) BS
      ON BS.STATUS_CODE = B.BILL_STAT_FLG
    LEFT JOIN (
      SELECT
        FIELD_VALUE AS STATUS_CODE,
        MAX(DESCR) AS STATUS_DESCRIPTION
      FROM CISADM.CI_LOOKUP_VAL_L
      WHERE FIELD_NAME = 'BSEG_STAT_FLG'
        AND LANGUAGE_CD = 'ENG'
      GROUP BY FIELD_VALUE
    ) SS
      ON SS.STATUS_CODE = S.BSEG_STAT_FLG
    WHERE TRUNC(NVL(B.BILL_DT, S.CRE_DTTM)) = M.CYCLE_LAST_EVENT_DATE
  ) LS
  WHERE REGEXP_LIKE(UPPER(NVL(LS.BSEG_STATUS_DESCRIPTION, '')), 'ERROR|EXCEPTION|FAIL')
) Y</query>
    </jdbcQuery>
