        <field id="BC_EXPECTED_VS_ACTUAL_FAST.ACTUAL_BILLED_SA_COUNT" type="java.math.BigDecimal"></field>
        <field id="BC_EXPECTED_VS_ACTUAL_FAST.ACTUAL_BILLED_ACCOUNT_COUNT" type="java.math.BigDecimal"></field>
        <field id="BC_EXPECTED_VS_ACTUAL_FAST.ACTUAL_BILL_SEGMENT_COUNT" type="java.math.BigDecimal"></field>
        <field id="BC_EXPECTED_VS_ACTUAL_FAST.ACTUAL_BILL_COUNT" type="java.math.BigDecimal"></field>
        <field id="BC_EXPECTED_VS_ACTUAL_FAST.MISSING_ACTIVE_SA_COUNT" type="java.math.BigDecimal"></field>
        <field id="BC_EXPECTED_VS_ACTUAL_FAST.MISSING_ACTIVE_ACCOUNT_COUNT" type="java.math.BigDecimal"></field>
        <field id="BC_EXPECTED_VS_ACTUAL_FAST.CYCLE_LAST_EVENT_DATE" type="java.sql.Timestamp"></field>
        <field id="BC_EXPECTED_VS_ACTUAL_FAST.MOST_RECENT_BILL_CYCLE_SW" type="java.lang.String"></field>
        <field id="BC_CYCLE_NUMBERS_FAST.BILL_CYCLE_CODE" type="java.lang.String"></field>
        <field id="BC_CYCLE_NUMBERS_FAST.BILL_SEGMENT_COUNT" type="java.math.BigDecimal"></field>
        <field id="BC_CYCLE_NUMBERS_FAST.BILL_COUNT" type="java.math.BigDecimal"></field>
        <field id="BC_CYCLE_NUMBERS_FAST.ACTIVE_SERVICE_AGREEMENT_COUNT" type="java.math.BigDecimal"></field>
        <field id="BC_CYCLE_NUMBERS_FAST.ACTIVE_ACCOUNT_COUNT" type="java.math.BigDecimal"></field>
        <field id="BC_CYCLE_NUMBERS_FAST.LAST_BILL_DATE" type="java.sql.Timestamp"></field>
        <field id="BC_CYCLE_NUMBERS_FAST.MOST_RECENT_BILL_CYCLE_SW" type="java.lang.String"></field>
        <field id="BC_SEGMENT_STATUS_DRILLDOWN_V2.BILL_CYCLE_CODE" type="java.lang.String"></field>
        <field id="BC_SEGMENT_STATUS_DRILLDOWN_V2.ACCOUNT_ID" type="java.lang.String"></field>
        <field id="BC_SEGMENT_STATUS_DRILLDOWN_V2.SERVICE_AGREEMENT_ID" type="java.lang.String"></field>
        <field id="BC_SEGMENT_STATUS_DRILLDOWN_V2.PREMISE_ID" type="java.lang.String"></field>
        <field id="BC_SEGMENT_STATUS_DRILLDOWN_V2.BILL_ID" type="java.lang.String"></field>
        <field id="BC_SEGMENT_STATUS_DRILLDOWN_V2.BILL_SEGMENT_ID" type="java.lang.String"></field>
        <field id="BC_SEGMENT_STATUS_DRILLDOWN_V2.BILL_DATE" type="java.sql.Timestamp"></field>
        <field id="BC_SEGMENT_STATUS_DRILLDOWN_V2.BILL_CREATE_DATE" type="java.sql.Timestamp"></field>
        <field id="BC_SEGMENT_STATUS_DRILLDOWN_V2.BSEG_CREATE_DATE" type="java.sql.Timestamp"></field>
        <field id="BC_SEGMENT_STATUS_DRILLDOWN_V2.BILL_STATUS_DESCRIPTION" type="java.lang.String"></field>
        <field id="BC_SEGMENT_STATUS_DRILLDOWN_V2.BSEG_STATUS_DESCRIPTION" type="java.lang.String"></field>
        <field id="BC_SEGMENT_STATUS_DRILLDOWN_V2.IS_ERROR_SW" type="java.lang.String"></field>
        <field id="BC_SEGMENT_STATUS_DRILLDOWN_V2.ERROR_REASON" type="java.lang.String"></field>
        <field id="BC_SEGMENT_STATUS_DRILLDOWN_V2.EVENT_DATE" type="java.sql.Timestamp"></field>
        <field id="BC_SEGMENT_STATUS_DRILLDOWN_V2.MOST_RECENT_BILL_CYCLE_SW" type="java.lang.String"></field>
      </fieldList>
      <filterString>CI_BILL_CYC_L.LANGUAGE_CD == 'ENG' and trim(CI_BILL_CYC_L.BILL_CYC_CD) != ''</filterString>
      <joinInfo alias="CI_BILL_CYC_L" referenceId="CI_BILL_CYC_L"></joinInfo>
      <joinList>
        <join expr="trim(CI_BILL_CYC_L.BILL_CYC_CD) == BC_EXPECTED_VS_ACTUAL_FAST.BILL_CYCLE_CODE" left="CI_BILL_CYC_L" right="BC_EXPECTED_VS_ACTUAL_FAST" type="leftOuter" weight="1"></join>
        <join expr="trim(CI_BILL_CYC_L.BILL_CYC_CD) == BC_CYCLE_NUMBERS_FAST.BILL_CYCLE_CODE" left="CI_BILL_CYC_L" right="BC_CYCLE_NUMBERS_FAST" type="leftOuter" weight="1"></join>
        <join expr="trim(CI_BILL_CYC_L.BILL_CYC_CD) == BC_SEGMENT_STATUS_DRILLDOWN_V2.BILL_CYCLE_CODE" left="CI_BILL_CYC_L" right="BC_SEGMENT_STATUS_DRILLDOWN_V2" type="leftOuter" weight="1"></join>
      </joinList>
      <joinOptions></joinOptions>
      <tableRefList>
        <tableRef alwaysIncludeTable="false" tableAlias="CI_BILL_CYC_L" tableId="CI_BILL_CYC_L"></tableRef>
        <tableRef alwaysIncludeTable="false" tableAlias="BC_EXPECTED_VS_ACTUAL_FAST" tableId="BC_EXPECTED_VS_ACTUAL_FAST"></tableRef>
        <tableRef alwaysIncludeTable="false" tableAlias="BC_CYCLE_NUMBERS_FAST" tableId="BC_CYCLE_NUMBERS_FAST"></tableRef>
        <tableRef alwaysIncludeTable="false" tableAlias="BC_SEGMENT_STATUS_DRILLDOWN_V2" tableId="BC_SEGMENT_STATUS_DRILLDOWN_V2"></tableRef>
      </tableRefList>
    </jdbcTable>
  </resources>
</schema>
