  <resources>
    <jdbcTable id="CI_BILL_CYC_L" datasourceId="Origin_DEV_DS" datasourceTableName="CI_BILL_CYC_L" schemaAlias="CISADM">
      <fieldList>
        <field id="BILL_CYC_CD" type="java.lang.String"></field>
        <field id="LANGUAGE_CD" type="java.lang.String"></field>
        <field id="VERSION" type="java.math.BigDecimal"></field>
        <field id="DESCR" type="java.lang.String"></field>
      </fieldList>
    </jdbcTable>
    <jdbcQuery id="BC_CYCLE_NUMBERS_FAST" datasourceId="Origin_DEV_DS">
      <fieldList>
        <field id="BILL_CYCLE_CODE" type="java.lang.String"></field>
        <field id="BILL_SEGMENT_COUNT" type="java.math.BigDecimal"></field>
        <field id="BILL_COUNT" type="java.math.BigDecimal"></field>
        <field id="ACTIVE_SERVICE_AGREEMENT_COUNT" type="java.math.BigDecimal"></field>
        <field id="ACTIVE_ACCOUNT_COUNT" type="java.math.BigDecimal"></field>
        <field id="LAST_BILL_DATE" type="java.sql.Timestamp"></field>
        <field id="MOST_RECENT_BILL_CYCLE_SW" type="java.lang.String"></field>
      </fieldList>
      <query>SELECT X.BILL_CYCLE_CODE,COUNT(*) AS BILL_SEGMENT_COUNT,COUNT(DISTINCT X.BILL_ID) AS BILL_COUNT,COUNT(DISTINCT X.SA_ID) AS ACTIVE_SERVICE_AGREEMENT_COUNT,COUNT(DISTINCT X.ACCT_ID) AS ACTIVE_ACCOUNT_COUNT,MAX(X.EVENT_DATE) AS LAST_BILL_DATE,CASE WHEN MAX(X.CYCLE_LAST_EVENT_DATE)=MAX(MAX(X.CYCLE_LAST_EVENT_DATE)) OVER () THEN 'Y' ELSE 'N' END AS MOST_RECENT_BILL_CYCLE_SW FROM (SELECT NULLIF(TRIM(S.BILL_CYC_CD),'') AS BILL_CYCLE_CODE,S.BILL_ID,S.SA_ID,SA.ACCT_ID,TRUNC(NVL(B.BILL_DT,S.CRE_DTTM)) AS EVENT_DATE,MAX(TRUNC(NVL(B.BILL_DT,S.CRE_DTTM))) OVER (PARTITION BY NULLIF(TRIM(S.BILL_CYC_CD),'')) AS CYCLE_LAST_EVENT_DATE FROM CISADM.CI_BSEG S JOIN CISADM.CI_SA SA ON SA.SA_ID=S.SA_ID AND SA.SA_STATUS_FLG='20' LEFT JOIN CISADM.CI_BILL B ON B.BILL_ID=S.BILL_ID WHERE NULLIF(TRIM(S.BILL_CYC_CD),'') IS NOT NULL AND S.CRE_DTTM &gt;= ADD_MONTHS(TRUNC(SYSDATE),-18) AND S.CRE_DTTM &lt; TRUNC(SYSDATE)+1) X WHERE X.EVENT_DATE=X.CYCLE_LAST_EVENT_DATE GROUP BY X.BILL_CYCLE_CODE</query>
    </jdbcQuery>
    <jdbcQuery id="BC_EXPECTED_VS_ACTUAL_FAST" datasourceId="Origin_DEV_DS">
      <fieldList>
        <field id="BILL_CYCLE_CODE" type="java.lang.String"></field>
        <field id="EXPECTED_ACTIVE_SA_COUNT" type="java.math.BigDecimal"></field>
        <field id="EXPECTED_ACTIVE_ACCOUNT_COUNT" type="java.math.BigDecimal"></field>
        <field id="ACTUAL_BILLED_SA_COUNT" type="java.math.BigDecimal"></field>
        <field id="ACTUAL_BILLED_ACCOUNT_COUNT" type="java.math.BigDecimal"></field>
        <field id="ACTUAL_BILL_SEGMENT_COUNT" type="java.math.BigDecimal"></field>
        <field id="ACTUAL_BILL_COUNT" type="java.math.BigDecimal"></field>
        <field id="MISSING_ACTIVE_SA_COUNT" type="java.math.BigDecimal"></field>
        <field id="MISSING_ACTIVE_ACCOUNT_COUNT" type="java.math.BigDecimal"></field>
        <field id="CYCLE_LAST_EVENT_DATE" type="java.sql.Timestamp"></field>
        <field id="MOST_RECENT_BILL_CYCLE_SW" type="java.lang.String"></field>
      </fieldList>
      <query>SELECT E.BILL_CYCLE_CODE,E.EXPECTED_ACTIVE_SA_COUNT,E.EXPECTED_ACTIVE_ACCOUNT_COUNT,NVL(A.ACTUAL_BILLED_SA_COUNT,0) AS ACTUAL_BILLED_SA_COUNT,NVL(A.ACTUAL_BILLED_ACCOUNT_COUNT,0) AS ACTUAL_BILLED_ACCOUNT_COUNT,NVL(A.ACTUAL_BILL_SEGMENT_COUNT,0) AS ACTUAL_BILL_SEGMENT_COUNT,NVL(A.ACTUAL_BILL_COUNT,0) AS ACTUAL_BILL_COUNT,E.EXPECTED_ACTIVE_SA_COUNT-NVL(A.ACTUAL_BILLED_SA_COUNT,0) AS MISSING_ACTIVE_SA_COUNT,E.EXPECTED_ACTIVE_ACCOUNT_COUNT-NVL(A.ACTUAL_BILLED_ACCOUNT_COUNT,0) AS MISSING_ACTIVE_ACCOUNT_COUNT,A.CYCLE_LAST_EVENT_DATE,CASE WHEN A.CYCLE_LAST_EVENT_DATE=MAX(A.CYCLE_LAST_EVENT_DATE) OVER () THEN 'Y' ELSE 'N' END AS MOST_RECENT_BILL_CYCLE_SW FROM (SELECT NULLIF(TRIM(AC.BILL_CYC_CD),'') AS BILL_CYCLE_CODE,COUNT(DISTINCT SA.SA_ID) AS EXPECTED_ACTIVE_SA_COUNT,COUNT(DISTINCT SA.ACCT_ID) AS EXPECTED_ACTIVE_ACCOUNT_COUNT FROM CISADM.CI_SA SA JOIN CISADM.CI_ACCT AC ON AC.ACCT_ID=SA.ACCT_ID WHERE SA.SA_STATUS_FLG='20' AND NULLIF(TRIM(AC.BILL_CYC_CD),'') IS NOT NULL GROUP BY NULLIF(TRIM(AC.BILL_CYC_CD),'')) E LEFT JOIN (SELECT X.BILL_CYCLE_CODE,COUNT(*) AS ACTUAL_BILL_SEGMENT_COUNT,COUNT(DISTINCT X.BILL_ID) AS ACTUAL_BILL_COUNT,COUNT(DISTINCT X.SA_ID) AS ACTUAL_BILLED_SA_COUNT,COUNT(DISTINCT X.ACCT_ID) AS ACTUAL_BILLED_ACCOUNT_COUNT,MAX(X.CYCLE_LAST_EVENT_DATE) AS CYCLE_LAST_EVENT_DATE FROM (SELECT NULLIF(TRIM(S.BILL_CYC_CD),'') AS BILL_CYCLE_CODE,S.BILL_ID,S.SA_ID,SA.ACCT_ID,TRUNC(NVL(B.BILL_DT,S.CRE_DTTM)) AS EVENT_DATE,MAX(TRUNC(NVL(B.BILL_DT,S.CRE_DTTM))) OVER (PARTITION BY NULLIF(TRIM(S.BILL_CYC_CD),'')) AS CYCLE_LAST_EVENT_DATE FROM CISADM.CI_BSEG S JOIN CISADM.CI_SA SA ON SA.SA_ID=S.SA_ID AND SA.SA_STATUS_FLG='20' LEFT JOIN CISADM.CI_BILL B ON B.BILL_ID=S.BILL_ID WHERE NULLIF(TRIM(S.BILL_CYC_CD),'') IS NOT NULL AND S.CRE_DTTM &gt;= ADD_MONTHS(TRUNC(SYSDATE),-18) AND S.CRE_DTTM &lt; TRUNC(SYSDATE)+1) X WHERE X.EVENT_DATE=X.CYCLE_LAST_EVENT_DATE GROUP BY X.BILL_CYCLE_CODE) A ON A.BILL_CYCLE_CODE=E.BILL_CYCLE_CODE</query>
    </jdbcQuery>
    <jdbcQuery id="BC_SEGMENT_STATUS_DRILLDOWN_V2" datasourceId="Origin_DEV_DS">
      <fieldList>
        <field id="BILL_CYCLE_CODE" type="java.lang.String"></field>
        <field id="ACCOUNT_ID" type="java.lang.String"></field>
        <field id="SERVICE_AGREEMENT_ID" type="java.lang.String"></field>
        <field id="PREMISE_ID" type="java.lang.String"></field>
        <field id="BILL_ID" type="java.lang.String"></field>
        <field id="BILL_SEGMENT_ID" type="java.lang.String"></field>
        <field id="BILL_DATE" type="java.sql.Timestamp"></field>
        <field id="BILL_CREATE_DATE" type="java.sql.Timestamp"></field>
        <field id="BSEG_CREATE_DATE" type="java.sql.Timestamp"></field>
        <field id="BILL_STATUS_DESCRIPTION" type="java.lang.String"></field>
        <field id="BSEG_STATUS_DESCRIPTION" type="java.lang.String"></field>
        <field id="IS_ERROR_SW" type="java.lang.String"></field>
        <field id="ERROR_REASON" type="java.lang.String"></field>
        <field id="EVENT_DATE" type="java.sql.Timestamp"></field>
        <field id="MOST_RECENT_BILL_CYCLE_SW" type="java.lang.String"></field>
      </fieldList>
      <query>SELECT X.BILL_CYCLE_CODE,X.ACCT_ID AS ACCOUNT_ID,X.SA_ID AS SERVICE_AGREEMENT_ID,X.PREM_ID AS PREMISE_ID,X.BILL_ID,X.BSEG_ID AS BILL_SEGMENT_ID,X.BILL_DATE,X.BILL_CREATE_DATE,X.BSEG_CREATE_DATE,NVL(BS.STATUS_DESCRIPTION,'BILL_STATUS_'||X.BILL_STAT_FLG) AS BILL_STATUS_DESCRIPTION,NVL(SS.STATUS_DESCRIPTION,'BSEG_STATUS_'||X.BSEG_STAT_FLG) AS BSEG_STATUS_DESCRIPTION,CASE WHEN REGEXP_LIKE(UPPER(NVL(SS.STATUS_DESCRIPTION,'')),'ERROR|EXCEPTION|FAIL|CANCEL') OR REGEXP_LIKE(UPPER(NVL(BS.STATUS_DESCRIPTION,'')),'ERROR|EXCEPTION|FAIL|CANCEL') THEN 'Y' ELSE 'N' END AS IS_ERROR_SW,CASE WHEN REGEXP_LIKE(UPPER(NVL(SS.STATUS_DESCRIPTION,'')),'ERROR|EXCEPTION|FAIL|CANCEL') THEN SS.STATUS_DESCRIPTION WHEN REGEXP_LIKE(UPPER(NVL(BS.STATUS_DESCRIPTION,'')),'ERROR|EXCEPTION|FAIL|CANCEL') THEN BS.STATUS_DESCRIPTION ELSE NULL END AS ERROR_REASON,X.EVENT_DATE,CASE WHEN X.CYCLE_LAST_EVENT_DATE=MAX(X.CYCLE_LAST_EVENT_DATE) OVER () THEN 'Y' ELSE 'N' END AS MOST_RECENT_BILL_CYCLE_SW FROM (SELECT NULLIF(TRIM(S.BILL_CYC_CD),'') AS BILL_CYCLE_CODE,SA.ACCT_ID,S.SA_ID,S.PREM_ID,S.BILL_ID,S.BSEG_ID,B.BILL_STAT_FLG,S.BSEG_STAT_FLG,TRUNC(B.BILL_DT) AS BILL_DATE,TRUNC(B.CRE_DTTM) AS BILL_CREATE_DATE,TRUNC(S.CRE_DTTM) AS BSEG_CREATE_DATE,TRUNC(NVL(B.BILL_DT,S.CRE_DTTM)) AS EVENT_DATE,MAX(TRUNC(NVL(B.BILL_DT,S.CRE_DTTM))) OVER (PARTITION BY NULLIF(TRIM(S.BILL_CYC_CD),'')) AS CYCLE_LAST_EVENT_DATE FROM CISADM.CI_BSEG S JOIN CISADM.CI_SA SA ON SA.SA_ID=S.SA_ID AND SA.SA_STATUS_FLG='20' LEFT JOIN CISADM.CI_BILL B ON B.BILL_ID=S.BILL_ID WHERE NULLIF(TRIM(S.BILL_CYC_CD),'') IS NOT NULL AND S.CRE_DTTM &gt;= ADD_MONTHS(TRUNC(SYSDATE),-18) AND S.CRE_DTTM &lt; TRUNC(SYSDATE)+1) X LEFT JOIN (SELECT FIELD_VALUE AS STATUS_CODE,MAX(DESCR) AS STATUS_DESCRIPTION FROM CISADM.CI_LOOKUP_VAL_L WHERE FIELD_NAME='BILL_STAT_FLG' AND LANGUAGE_CD='ENG' GROUP BY FIELD_VALUE) BS ON BS.STATUS_CODE=X.BILL_STAT_FLG LEFT JOIN (SELECT FIELD_VALUE AS STATUS_CODE,MAX(DESCR) AS STATUS_DESCRIPTION FROM CISADM.CI_LOOKUP_VAL_L WHERE FIELD_NAME='BSEG_STAT_FLG' AND LANGUAGE_CD='ENG' GROUP BY FIELD_VALUE) SS ON SS.STATUS_CODE=X.BSEG_STAT_FLG WHERE X.EVENT_DATE=X.CYCLE_LAST_EVENT_DATE</query>
    </jdbcQuery>
    <jdbcTable id="JoinTree_1" datasourceId="Origin_DEV_DS" datasourceTableName="CI_BILL_CYC_L" schemaAlias="CISADM">
