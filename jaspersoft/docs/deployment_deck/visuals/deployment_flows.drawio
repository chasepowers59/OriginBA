rce="d2" target="d3" parent="g4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e21" value="no" style="html=1;whiteSpace=nowrap;fontFamily=Arial;edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#E6ECF2;strokeWidth=2;endArrow=block;endFill=1;fontColor=#E6ECF2;fontSize=14.6;fontStyle=1;labelBackgroundColor=#0B1723;" edge="1" source="d3" target="sd3" parent="g4"><mxGeometry relative="1" as="geometry"><mxPoint as="offset" x="0" y="-12"/></mxGeometry></mxCell><mxCell id="e22" value="yes" style="html=1;whiteSpace=nowrap;fontFamily=Arial;edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#E6ECF2;strokeWidth=2;endArrow=block;endFill=1;fontColor=#E6ECF2;fontSize=14.6;fontStyle=1;labelBackgroundColor=#0B1723;" edge="1" source="d3" target="d4" parent="g4"><mxGeometry relative="1" as="geometry"><mxPoint as="offset" x="18" y="-6"/></mxGeometry></mxCell><mxCell id="e23" value="" style="html=1;whiteSpace=nowrap;fontFamily=Arial;edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#E6ECF2;strokeWidth=2;endArrow=block;endFill=1;fontColor=#E6ECF2;fontSize=14.6;fontStyle=1;labelBackgroundColor=#0B1723;" edge="1" source="d4" target="d5" parent="g4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e24" value="" style="html=1;whiteSpace=nowrap;fontFamily=Arial;edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#E6ECF2;strokeWidth=2;endArrow=block;endFill=1;fontColor=#E6ECF2;fontSize=14.6;fontStyle=1;labelBackgroundColor=#0B1723;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" source="d5" target="e3" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1802.9" y="883.2"/><mxPoint x="1708.8" y="883.2"/></Array></mxGeometry></mxCell><mxCell id="e25" value="" style="html=1;whiteSpace=nowrap;fontFamily=Arial;edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#E6ECF2;strokeWidth=2;endArrow=block;endFill=1;fontColor=#E6ECF2;fontSize=14.6;fontStyle=1;labelBackgroundColor=#0B1723;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" source="e3" target="c0" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2064" y="1005.6"/><mxPoint x="2064" y="177.6"/><mxPoint x="1305.6" y="177.6"/></Array></mxGeometry></mxCell><mxCell id="_title" value="&lt;b&gt;&lt;font style=&quot;font-size:39.9px&quot;&gt;Standard Offering Deployment Flow&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:18.6px&quot;&gt;authored on Origin_DEV, proven on Origin_TEST, then every client org by the same tool with the same seven proofs&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;fontColor=#E6ECF2;" vertex="1" parent="1"><mxGeometry x="77.8" y="33.6" width="1958.4" height="124.8" as="geometry"/></mxCell><mxCell id="_legend" value="&lt;b&gt;&lt;font style=&quot;font-size:14.6px&quot; color=&quot;#E6ECF2&quot;&gt;Blue diamonds are gates: yes continues, no stops the run and names the rollback. Numbers are the order of one full promotion. The Workstreams tree is never moved; the offering is a curated copy promoted org by org.&lt;/font&gt;&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;fontColor=#E6ECF2;" vertex="1" parent="1"><mxGeometry x="77.8" y="1104" width="1958.4" height="57.6" as="geometry"/></mxCell><mxCell id="_footer" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#E6ECF2&quot;&gt;Origin Utility, Inc  /  Proprietary and Confidential  /  Internal Use Only&lt;/font&gt;&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;fontColor=#E6ECF2;" vertex="1" parent="1"><mxGeometry x="77.8" y="1156.8" width="1958.4" height="38.4" as="geometry"/></mxCell><mxCell id="_layer0_0" value="&amp;lt;b&amp;gt;&amp;lt;font style=&amp;quot;font-size:13.3px&amp;quot; color=&amp;quot;#004B86&amp;quot;&amp;gt;build_standard_offering_package.py, then verify_standard_offering_package.py&amp;lt;/font&amp;gt;&amp;lt;/b&amp;gt;" style="html=1;whiteSpace=wrap;fontFamily=Courier New;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#006FAC;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=6;fontColor=#004B86;" vertex="1" parent="_layer0"><mxGeometry x="96" y="571.2" width="412.8" height="40.3" as="geometry"/></mxCell><mxCell id="_layer0_1" value="&amp;lt;b&amp;gt;&amp;lt;font style=&amp;quot;font-size:13.3px&amp;quot; color=&amp;quot;#004B86&amp;quot;&amp;gt;jrs_promote.py --from internal:Origin_DEV --to test:Origin_TEST --resource /SmartCity/Report/Standard_Offering --ds Origin_TEST_DS&amp;lt;/font&amp;gt;&amp;lt;/b&amp;gt;" style="html=1;whiteSpace=wrap;fontFamily=Courier New;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#006FAC;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=6;fontColor=#004B86;" vertex="1" parent="_layer0"><mxGeometry x="595.2" y="302.4" width="412.8" height="40.3" as="geometry"/></mxCell><mxCell id="_layer0_2" value="&amp;lt;b&amp;gt;&amp;lt;font style=&amp;quot;font-size:13.3px&amp;quot; color=&amp;quot;#004B86&amp;quot;&amp;gt;jrs_inventory.py snapshot --env test --orgs &amp;amp;lt;Org&amp;amp;gt;&amp;lt;/font&amp;gt;&amp;lt;/b&amp;gt;" style="html=1;whiteSpace=wrap;fontFamily=Courier New;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#006FAC;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=6;fontColor=#004B86;" vertex="1" parent="_layer0"><mxGeometry x="1094.4" y="360" width="412.8" height="40.3" as="geometry"/></mxCell><mxCell id="_layer0_3" value="&amp;lt;b&amp;gt;&amp;lt;font style=&amp;quot;font-size:13.3px&amp;quot; color=&amp;quot;#004B86&amp;quot;&amp;gt;jrs_promote.py --from test:Origin_TEST --to test:&amp;amp;lt;Org&amp;amp;gt; --resource /SmartCity/Report/Standard_Offering --ds &amp;amp;lt;Org&amp;amp;gt;_DS&amp;lt;/font&amp;gt;&amp;lt;/b&amp;gt;" style="html=1;whiteSpace=wrap;fontFamily=Courier New;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#006FAC;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=6;fontColor=#004B86;" vertex="1" parent="_layer0"><mxGeometry x="1094.4" y="489.6" width="412.8" height="40.3" as="geometry"/></mxCell><mxCell id="_layer0_4" value="&amp;lt;b&amp;gt;&amp;lt;font style=&amp;quot;font-size:13.3px&amp;quot; color=&amp;quot;#004B86&amp;quot;&amp;gt;jrs_run_sweep.py --env test --org &amp;amp;lt;Org&amp;amp;gt; --folder /SmartCity/Report/Standard_Offering; build_standard_offering_validation_doc.py --evidence&amp;lt;/font&amp;gt;&amp;lt;/b&amp;gt;" style="html=1;whiteSpace=wrap;fontFamily=Courier New;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#006FAC;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=6;fontColor=#004B86;" vertex="1" parent="_layer0"><mxGeometry x="1094.4" y="806.4" width="412.8" height="40.3" as="geometry"/></mxCell><mxCell id="_layer0_5" value="&amp;lt;b&amp;gt;&amp;lt;font style=&amp;quot;font-size:13.3px&amp;quot; color=&amp;quot;#004B86&amp;quot;&amp;gt;jrs_promote_test_to_prod.py --org &amp;amp;lt;Org&amp;amp;gt; --folder /SmartCity/Report/Standard_Offering --ds &amp;amp;lt;DS&amp;amp;gt; --i-mean-prod&amp;lt;/font&amp;gt;&amp;lt;/b&amp;gt;" style="html=1;whiteSpace=wrap;fontFamily=Courier New;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#006FAC;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=6;fontColor=#004B86;" vertex="1" parent="_layer0"><mxGeometry x="1593.6" y="475.2" width="412.8" height="40.3" as="geometry"/></mxCell><mxCell id="_layer0_6" value="&amp;lt;b&amp;gt;&amp;lt;font style=&amp;quot;font-size:13.3px&amp;quot; color=&amp;quot;#004B86&amp;quot;&amp;gt;jrs_domain_patch_apply.py --env test --org &amp;amp;lt;Org&amp;amp;gt; --domain &amp;amp;lt;uri&amp;amp;gt; --patch &amp;amp;lt;module&amp;amp;gt;  (--restore rolls back)&amp;lt;/font&amp;gt;&amp;lt;/b&amp;gt;" style="html=1;whiteSpace=wrap;fontFamily=Courier New;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#006FAC;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=6;fontColor=#004B86;" vertex="1" parent="_layer0"><mxGeometry x="96" y="1012.8" width="595.2" height="40.3" as="geometry"/></mxCell><mxCell id="_layer1_0" value="&amp;lt;b&amp;gt;&amp;lt;font style=&amp;quot;font-size:13.3px&amp;quot; color=&amp;quot;#004B86&amp;quot;&amp;gt;package gate&amp;lt;/font&amp;gt;&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;&amp;lt;font style=&amp;quot;font-size:12px&amp;quot; color=&amp;quot;#56636E&amp;quot;&amp;gt;no source host / org / datasource string; every outside reference exists on the target; every view field resolves in its domain&amp;lt;/font&amp;gt;" style="html=1;whiteSpace=wrap;fontFamily=Courier New;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#006FAC;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=6;fontColor=#004B86;" vertex="1" parent="_layer1"><mxGeometry x="96" y="715.2" width="412.8" height="52.8" as="geometry"/></mxCell><mxCell id="_layer1_1" value="&amp;lt;b&amp;gt;&amp;lt;font style=&amp;quot;font-size:13.3px&amp;quot; color=&amp;quot;#004B86&amp;quot;&amp;gt;seven proofs&amp;lt;/font&amp;gt;&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;&amp;lt;font style=&amp;quot;font-size:12px&amp;quot; color=&amp;quot;#56636E&amp;quot;&amp;gt;1 no source host, org path or datasource name survives in the package; 2 every reference to something outside the package exists on the target; 3 every field the views use resolves in its domain; 4 import without warnings; 5 re-export byte-equal inside the scope; 6 every resource executes; 7 datasource connection unchanged&amp;lt;/font&amp;gt;" style="html=1;whiteSpace=wrap;fontFamily=Courier New;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#006FAC;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=6;fontColor=#004B86;" vertex="1" parent="_layer1"><mxGeometry x="595.2" y="662.4" width="412.8" height="72" as="geometry"/></mxCell><mxCell id="_layer1_2" value="&amp;lt;b&amp;gt;&amp;lt;font style=&amp;quot;font-size:13.3px&amp;quot; color=&amp;quot;#004B86&amp;quot;&amp;gt;seven proofs, on prod&amp;lt;/font&amp;gt;&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;&amp;lt;font style=&amp;quot;font-size:12px&amp;quot; color=&amp;quot;#56636E&amp;quot;&amp;gt;1 no source host, org path or datasource name survives in the package; 2 every reference to something outside the package exists on the target; 3 every field the views use resolves in its domain; 4 import without warnings; 5 re-export byte-equal inside the scope; 6 every resource executes; 7 datasource connection unchanged&amp;lt;/font&amp;gt;" style="html=1;whiteSpace=wrap;fontFamily=Courier New;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#006FAC;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=6;fontColor=#004B86;" vertex="1" parent="_layer1"><mxGeometry x="1593.6" y="633.6" width="412.8" height="72" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page2" name="Database Deployment Flow"><mxGraphModel adaptiveColors="none" grid="0" page="0" background="#0B1723"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="_layer0" value="Commands" parent="0" visible="0"/><mxCell id="_layer1" value="Checks" parent="0" visible="0"/><mxCell id="big" value="&lt;b&gt;&lt;font style=&quot;font-size:18.6px&quot; color=&quot;#E6ECF2&quot;&gt;What the domains read&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14.6px&quot; color=&quot;#E6ECF2&quot;&gt;created in steps 2 and 3, validated at step 7 before anything is scheduled; each outlined stack feeds the domain chip beneath it&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;rounded=1;arcSize=6;fillColor=none;strokeColor=#8ACAD4;strokeWidth=1.5;container=1;pointerEvents=0;align=left;verticalAlign=top;spacingLeft=14;spacingTop=4;fontColor=#E6ECF2;" vertex="1" parent="1"><mxGeometry x="77.8" y="604.8" width="1958.4" height="432" as="geometry"/></mxCell><mxCell id="p5" value="&lt;b&gt;&lt;font style=&quot;font-size:18.6px&quot; color=&quot;#E6ECF2&quot;&gt;5. Submit 8 baselines as parallel scheduler jobs&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14.6px&quot; color=&quot;#E6ECF2&quot;&gt;unattended; they survive a dropped connection&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;rounded=1;arcSize=6;fillColor=none;strokeColor=#8ACAD4;strokeWidth=1.5;container=1;pointerEvents=0;align=left;verticalAlign=top;spacingLeft=14;spacingTop=4;fontColor=#E6ECF2;" vertex="1" parent="1"><mxGeometry x="1287.4" y="206.4" width="748.8" height="158.4" as="geometry"/></mxCell><mxCell id="wo" value="&lt;b&gt;&lt;font style=&quot;font-size:18.6px&quot; color=&quot;#E6ECF2&quot;&gt;Field Ops views&lt;/font&gt;&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;rounded=1;arcSize=6;fillColor=none;strokeColor=#8ACAD4;strokeWidth=1.5;container=1;pointerEvents=0;align=left;verticalAlign=top;spacingLeft=14;spacingTop=4;fontColor=#E6ECF2;" vertex="1" parent="big"><mxGeometry x="1419.8" y="62.4" width="283.2" height="249.6" as="geometry"/></mxCell><mxCell id="wv" value="&lt;b&gt;&lt;font style=&quot;font-size:18.6px&quot; color=&quot;#E6ECF2&quot;&gt;Meter Ops views&lt;/font&gt;&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;rounded=1;arcSize=6;fillColor=none;strokeColor=#8ACAD4;strokeWidth=1.5;container=1;pointerEvents=0;align=left;verticalAlign=top;spacingLeft=14;spacingTop=4;fontColor=#E6ECF2;" vertex="1" parent="big"><mxGeometry x="1129.9" y="62.4" width="278.4" height="249.6" as="geometry"/></mxCell><mxCell id="wf" value="&lt;b&gt;&lt;font style=&quot;font-size:18.6px&quot; color=&quot;#E6ECF2&quot;&gt;Finance tables&lt;/font&gt;&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;rounded=1;arcSize=6;fillColor=none;strokeColor=#8ACAD4;strokeWidth=1.5;container=1;pointerEvents=0;align=left;verticalAlign=top;spacingLeft=14;spacingTop=4;fontColor=#E6ECF2;" vertex="1" parent="big"><mxGeometry x="13.4" y="62.4" width="273.6" height="249.6" as="geometry"/></mxCell><mxCell id="wb" value="&lt;b&gt;&lt;font style=&quot;font-size:18.6px&quot; color=&quot;#E6ECF2&quot;&gt;Billing tables&lt;/font&gt;&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;rounded=1;arcSize=6;fillColor=none;strokeColor=#8ACAD4;strokeWidth=1.5;container=1;pointerEvents=0;align=left;verticalAlign=top;spacingLeft=14;spacingTop=4;fontColor=#E6ECF2;" vertex="1" parent="big"><mxGeometry x="298.6" y="62.4" width="273.6" height="249.6" as="geometry"/></mxCell><mxCell id="wm" value="&lt;b&gt;&lt;font style=&quot;font-size:18.6px&quot; color=&quot;#E6ECF2&quot;&gt;Meter Ops tables&lt;/font&gt;&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;rounded=1;arcSize=6;fillColor=none;strokeColor=#8ACAD4;strokeWidth=1.5;container=1;pointerEvents=0;align=left;verticalAlign=top;spacingLeft=14;spacingTop=4;fontColor=#E6ECF2;" vertex="1" parent="big"><mxGeometry x="583.7" y="62.4" width="273.6" height="249.6" as="geometry"/></mxCell><mxCell id="wd" value="&lt;b&gt;&lt;font style=&quot;font-size:18.6px&quot; color=&quot;#E6ECF2&quot;&gt;Debt Mgmt objects&lt;/font&gt;&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;rounded=1;arcSize=6;fillColor=none;strokeColor=#8ACAD4;strokeWidth=1.5;container=1;pointerEvents=0;align=left;verticalAlign=top;spacingLeft=14;spacingTop=4;fontColor=#E6ECF2;" vertex="1" parent="big"><mxGeometry x="868.8" y="62.4" width="249.6" height="249.6" as="geometry"/></mxCell><mxCell id="wc" value="&lt;b&gt;&lt;font style=&quot;font-size:18.6px&quot; color=&quot;#E6ECF2&quot;&gt;Customer Ops views&lt;/font&gt;&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;rounded=1;arcSize=6;fillColor=none;strokeColor=#8ACAD4;strokeWidth=1.5;container=1;pointerEvents=0;align=left;verticalAlign=top;spacingLeft=14;spacingTop=4;fontColor=#E6ECF2;" vertex="1" parent="big"><mxGeometry x="1714.6" y="62.4" width="225.6" height="249.6" as="geometry"/></mxCell><mxCell id="p1" value="&lt;b&gt;&lt;font style=&quot;font-size:18.6px&quot; color=&quot;#004B86&quot;&gt;Preflight&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14.6px&quot; color=&quot;#56636E&quot;&gt;the deploy user can read every source table and write the targets&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;rounded=1;arcSize=10;fillColor=#F2F5F8;strokeColor=none;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="77.8" y="240" width="240" height="96" as="geometry"/></mxCell><mxCell id="p1_n" value="1" style="html=1;whiteSpace=wrap;fontFamily=Arial;ellipse;fillColor=#006FAC;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=13.3;spacing=0;" vertex="1" parent="1"><mxGeometry x="64.3" y="226.6" width="32.6" height="32.6" as="geometry"/></mxCell><mxCell id="p2" value="&lt;b&gt;&lt;font style=&quot;font-size:18.6px&quot; color=&quot;#004B86&quot;&gt;Create the 7 snapshot tables&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14.6px&quot; color=&quot;#56636E&quot;&gt;empty, with their keys&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;rounded=1;arcSize=10;fillColor=#F2F5F8;strokeColor=none;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="346.6" y="240" width="278.4" height="96" as="geometry"/></mxCell><mxCell id="p2_n" value="2" style="html=1;whiteSpace=wrap;fontFamily=Arial;ellipse;fillColor=#006FAC;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=13.3;spacing=0;" vertex="1" parent="1"><mxGeometry x="333.1" y="226.6" width="32.6" height="32.6" as="geometry"/></mxCell><mxCell id="p3" value="&lt;b&gt;&lt;font style=&quot;font-size:18.6px&quot; color=&quot;#004B86&quot;&gt;Create the domain-support objects&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14.6px&quot; color=&quot;#56636E&quot;&gt;SA snapshot table, lookup seed, 8 CMS views, grants, synonyms&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;rounded=1;arcSize=10;fillColor=#F2F5F8;strokeColor=none;align=left;