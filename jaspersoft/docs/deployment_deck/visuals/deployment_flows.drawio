<mxfile><diagram id="page1" name="Standard Offering Deployment Flow"><mxGraphModel adaptiveColors="none" grid="0" page="0" background="#0B3D7A"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="g5" value="&lt;b&gt;&lt;font style=&quot;font-size:18.6px&quot; color=&quot;#F5EFE9&quot;&gt;After go-live&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14.6px&quot; color=&quot;#F5EFE9&quot;&gt;every change is a tool run with the same proofs, never a hand edit&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;rounded=1;arcSize=6;fillColor=none;strokeColor=#F5EFE9;strokeWidth=1.5;container=1;pointerEvents=0;align=left;verticalAlign=top;spacingLeft=14;spacingTop=4;fontColor=#F5EFE9;" vertex="1" parent="1"><mxGeometry x="77.8" y="849.6" width="1958.4" height="187.2" as="geometry"/></mxCell><mxCell id="g1" value="&lt;b&gt;&lt;font style=&quot;font-size:18.6px&quot; color=&quot;#F5EFE9&quot;&gt;Origin_DEV&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14.6px&quot; color=&quot;#F5EFE9&quot;&gt;authoring, the internal server&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;rounded=1;arcSize=6;fillColor=none;strokeColor=#F5EFE9;strokeWidth=1.5;container=1;pointerEvents=0;align=left;verticalAlign=top;spacingLeft=14;spacingTop=4;fontColor=#F5EFE9;" vertex="1" parent="1"><mxGeometry x="77.8" y="192" width="466.6" height="628.8" as="geometry"/></mxCell><mxCell id="g2" value="&lt;b&gt;&lt;font style=&quot;font-size:18.6px&quot; color=&quot;#F5EFE9&quot;&gt;Origin_TEST&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14.6px&quot; color=&quot;#F5EFE9&quot;&gt;proving, before any client&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;rounded=1;arcSize=6;fillColor=none;strokeColor=#F5EFE9;strokeWidth=1.5;container=1;pointerEvents=0;align=left;verticalAlign=top;spacingLeft=14;spacingTop=4;fontColor=#F5EFE9;" vertex="1" parent="1"><mxGeometry x="575" y="192" width="466.6" height="628.8" as="geometry"/></mxCell><mxCell id="g3" value="&lt;b&gt;&lt;font style=&quot;font-size:18.6px&quot; color=&quot;#F5EFE9&quot;&gt;Client test org&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14.6px&quot; color=&quot;#F5EFE9&quot;&gt;the client's own data&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;rounded=1;arcSize=6;fillColor=none;strokeColor=#F5EFE9;strokeWidth=1.5;container=1;pointerEvents=0;align=left;verticalAlign=top;spacingLeft=14;spacingTop=4;fontColor=#F5EFE9;" vertex="1" parent="1"><mxGeometry x="1072.3" y="192" width="466.6" height="628.8" as="geometry"/></mxCell><mxCell id="g4" value="&lt;b&gt;&lt;font style=&quot;font-size:18.6px&quot; color=&quot;#F5EFE9&quot;&gt;Client prod org&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14.6px&quot; color=&quot;#F5EFE9&quot;&gt;read-only until the prod flag is given&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;rounded=1;arcSize=6;fillColor=none;strokeColor=#F5EFE9;strokeWidth=1.5;container=1;pointerEvents=0;align=left;verticalAlign=top;spacingLeft=14;spacingTop=4;fontColor=#F5EFE9;" vertex="1" parent="1"><mxGeometry x="1569.6" y="192" width="466.6" height="628.8" as="geometry"/></mxCell><mxCell id="a1" value="&lt;b&gt;&lt;font style=&quot;font-size:18.6px&quot; color=&quot;#0B3D7A&quot;&gt;Workstreams tree&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14.6px&quot; color=&quot;#4C5D69&quot;&gt;domains, Ad Hoc views, reports and dashboards: the only content edited by hand&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;rounded=1;arcSize=10;fillColor=#F5EFE9;strokeColor=none;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;" vertex="1" parent="g1"><mxGeometry x="17.3" y="72" width="432" height="96" as="geometry"/></mxCell><mxCell id="a2" value="&lt;b&gt;&lt;font style=&quot;font-size:18.6px&quot; color=&quot;#0B3D7A&quot;&gt;Export the org&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14.6px&quot; color=&quot;#4C5D69&quot;&gt;one API export task, polled, downloaded&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;rounded=1;arcSize=10;fillColor=#F5EFE9;strokeColor=none;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;" vertex="1" parent="g1"><mxGeometry x="17.3" y="182.4" width="432" height="76.8" as="geometry"/></mxCell><mxCell id="a3" value="&lt;b&gt;&lt;font style=&quot;font-size:18.6px&quot; color=&quot;#0B3D7A&quot;&gt;Build the package&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14.6px&quot; color=&quot;#4C5D69&quot;&gt;inventory and classify the export; keep the offering list; one copy of each domain in one home; carry the datasource; rewrite every path; strip print wrappers; narrow the import index&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;rounded=1;arcSize=10;fillColor=#F5EFE9;strokeColor=none;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;" vertex="1" parent="g1"><mxGeometry x="17.3" y="273.6" width="432" height="148.8" as="geometry"/></mxCell><mxCell id="a4" value="package verifies?" style="html=1;whiteSpace=wrap;fontFamily=Arial;rhombus;fillColor=#FFA418;strokeColor=none;fontColor=#0B3D7A;fontStyle=1;fontSize=14.6;spacingLeft=26;spacingRight=26;" vertex="1" parent="g1"><mxGeometry x="151.7" y="451.2" width="163.2" height="86.4" as="geometry"/></mxCell><mxCell id="b1" value="&lt;b&gt;&lt;font style=&quot;font-size:18.6px&quot; color=&quot;#0B3D7A&quot;&gt;Import, update in place&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14.6px&quot; color=&quot;#4C5D69&quot;&gt;polled; an importer warning counts as a failure&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;rounded=1;arcSize=10;fillColor=#F5EFE9;strokeColor=none;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;" vertex="1" parent="g2"><mxGeometry x="17.3" y="72" width="432" height="81.6" as="geometry"/></mxCell><mxCell id="b2" value="&lt;b&gt;&lt;font style=&quot;font-size:18.6px&quot; color=&quot;#0B3D7A&quot;&gt;Re-export and compare&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14.6px&quot; color=&quot;#4C5D69&quot;&gt;byte-equal inside the scope, importer stamps ignored&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;rounded=1;arcSize=10;fillColor=#F5EFE9;strokeColor=none;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;" vertex="1" parent="g2"><mxGeometry x="17.3" y="168" width="432" height="81.6" as="geometry"/></mxCell><mxCell id="b3" value="&lt;b&gt;&lt;font style=&quot;font-size:18.6px&quot; color=&quot;#0B3D7A&quot;&gt;Execute everything&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14.6px&quot; color=&quot;#4C5D69&quot;&gt;views by query, reports as PDF, domains by metadata and probe&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;rounded=1;arcSize=10;fillColor=#F5EFE9;strokeColor=none;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;" vertex="1" parent="g2"><mxGeometry x="17.3" y="264" width="432" height="91.2" as="geometry"/></mxCell><mxCell id="b4" value="seven proofs pass?" style="html=1;whiteSpace=wrap;fontFamily=Arial;rhombus;fillColor=#FFA418;strokeColor=none;fontColor=#0B3D7A;fontStyle=1;fontSize=14.6;spacingLeft=26;spacingRight=26;" vertex="1" parent="g2"><mxGeometry x="151.7" y="374.4" width="163.2" height="86.4" as="geometry"/></mxCell><mxCell id="b5" value="&lt;b&gt;&lt;font style=&quot;font-size:18.6px&quot; color=&quot;#0B3D7A&quot;&gt;Proven offering&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14.6px&quot; color=&quot;#4C5D69&quot;&gt;the package every client promotion starts from&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;rounded=1;arcSize=10;fillColor=#F5EFE9;strokeColor=none;align=center;verticalAlign=middle;spacingLeft=0;spacingRight=0;" vertex="1" parent="g2"><mxGeometry x="17.3" y="480" width="432" height="81.6" as="geometry"/></mxCell><mxCell id="c1" value="&lt;b&gt;&lt;font style=&quot;font-size:18.6px&quot; color=&quot;#0B3D7A&quot;&gt;Inventory snapshot&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14.6px&quot; color=&quot;#4C5D69&quot;&gt;every resource on the org before anything changes&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;rounded=1;arcSize=10;fillColor=#F5EFE9;strokeColor=none;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;" vertex="1" parent="g3"><mxGeometry x="17.3" y="72" width="432" height="76.8" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;&lt;font style=&quot;font-size:18.6px&quot; color=&quot;#0B3D7A&quot;&gt;Rebuild for the client&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14.6px&quot; color=&quot;#4C5D69&quot;&gt;the client's own datasource export carried byte for byte; org path, folder, alias and tenant root rewritten&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;rounded=1;arcSize=10;fillColor=#F5EFE9;strokeColor=none;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;" vertex="1" parent="g3"><mxGeometry x="17.3" y="163.2" width="432" height="115.2" as="geometry"/></mxCell><mxCell id="c3" value="verified? no source strings, references exist, fields resolve" style="html=1;whiteSpace=wrap;fontFamily=Arial;rhombus;fillColor=#FFA418;strokeColor=none;fontColor=#0B3D7A;fontStyle=1;fontSize=13.3;spacingLeft=39;spacingRight=39;" vertex="1" parent="g3"><mxGeometry x="108.5" y="292.8" width="249.6" height="100.8" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;&lt;font style=&quot;font-size:18.6px&quot; color=&quot;#0B3D7A&quot;&gt;Import, compare, execute&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14.6px&quot; color=&quot;#4C5D69&quot;&gt;the same three proofs as Origin_TEST&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;rounded=1;arcSize=10;fillColor=#F5EFE9;strokeColor=none;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;" vertex="1" parent="g3"><mxGeometry x="17.3" y="408" width="432" height="76.8" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;&lt;font style=&quot;font-size:18.6px&quot; color=&quot;#0B3D7A&quot;&gt;Sweep and sign off&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14.6px&quot; color=&quot;#4C5D69&quot;&gt;PASS, EMPTY, SLOW or FAIL per resource with timing; one document per org&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;rounded=1;arcSize=10;fillColor=#F5EFE9;strokeColor=none;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;" vertex="1" parent="g3"><mxGeometry x="17.3" y="499.2" width="432" height="96" as="geometry"/></mxCell><mxCell id="d0" value="explicit prod flag required" style="html=1;whiteSpace=wrap;fontFamily=Arial;rounded=1;arcSize=50;fillColor=#FFA418;strokeColor=none;fontColor=#0B3D7A;fontStyle=1;fontSize=16;" vertex="1" parent="g4"><mxGeometry x="17.3" y="72" width="432" height="48" as="geometry"/></mxCell><mxCell id="d1" value="&lt;b&gt;&lt;font style=&quot;font-size:18.6px&quot; color=&quot;#0B3D7A&quot;&gt;Inventory snapshot&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14.6px&quot; color=&quot;#4C5D69&quot;&gt;the rollback baseline&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;rounded=1;arcSize=10;fillColor=#F5EFE9;strokeColor=none;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;" vertex="1" parent="g4"><mxGeometry x="17.3" y="134.4" width="432" height="72" as="geometry"/></mxCell><mxCell id="d2" value="&lt;b&gt;&lt;font style=&quot;font-size:18.6px&quot; color=&quot;#0B3D7A&quot;&gt;Same promotion, same proofs&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14.6px&quot; color=&quot;#4C5D69&quot;&gt;target datasource carried; rewritten; verified; imported; compared; executed&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;rounded=1;arcSize=10;fillColor=#F5EFE9;strokeColor=none;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;" vertex="1" parent="g4"><mxGeometry x="17.3" y="220.8" width="432" height="105.6" as="geometry"/></mxCell><mxCell id="d3" value="seven proofs pass?" style="html=1;whiteSpace=wrap;fontFamily=Arial;rhombus;fillColor=#FFA418;strokeColor=none;fontColor=#0B3D7A;fontStyle=1;fontSize=14.6;spacingLeft=26;spacingRight=26;" vertex="1" parent="g4"><mxGeometry x="151.7" y="340.8" width="163.2" height="86.4" as="geometry"/></mxCell><mxCell id="d4" value="&lt;b&gt;&lt;font style=&quot;font-size:18.6px&quot; color=&quot;#0B3D7A&quot;&gt;Sweep and sign off&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14.6px&quot; color=&quot;#4C5D69&quot;&gt;on the client's prod numbers&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;rounded=1;arcSize=10;fillColor=#F5EFE9;strokeColor=none;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;" vertex="1" parent="g4"><mxGeometry x="17.3" y="441.6" width="432" height="72" as="geometry"/></mxCell><mxCell id="d5" value="&lt;b&gt;&lt;font style=&quot;font-size:18.6px&quot; color=&quot;#0B3D7A&quot;&gt;Diff after = rollback record&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14.6px&quot; color=&quot;#4C5D69&quot;&gt;inventory before against after: nothing else moved&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;rounded=1;arcSize=10;fillColor=#F5EFE9;strokeColor=none;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;" vertex="1" parent="g4"><mxGeometry x="17.3" y="528" width="432" height="81.6" as="geometry"/></mxCell><mxCell id="e1" value="&lt;b&gt;&lt;font style=&quot;font-size:18.6px&quot; color=&quot;#0B3D7A&quot;&gt;Additive-only domain patch&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14.6px&quot; color=&quot;#4C5D69&quot;&gt;the additions guard refuses any change to what is there; seven proofs per org; one-command restore&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;rounded=1;arcSize=10;fillColor=#F5EFE9;strokeColor=none;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;" vertex="1" parent="g5"><mxGeometry x="18.2" y="57.6" width="614.4" height="110.4" as="geometry"/></mxCell><mxCell id="e2" value="&lt;b&gt;&lt;font style=&quot;font-size:18.6px&quot; color=&quot;#0B3D7A&quot;&gt;Standardized Reports folder&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14.6px&quot; color=&quot;#4C5D69&quot;&gt;scheduled SQL reports in one folder; on Origin_DEV today, promoted to client orgs by the same tool when approved&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;rounded=1;arcSize=10;fillColor=#F5EFE9;strokeColor=none;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;" vertex="1" parent="g5"><mxGeometry x="671" y="57.6" width="614.4" height="110.4" as="geometry"/></mxCell><mxCell id="e3" value="&lt;b&gt;&lt;font style=&quot;font-size:18.6px&quot; color=&quot;#0B3D7A&quot;&gt;Sweep after every change&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14.6px&quot; color=&quot;#4C5D69&quot;&gt;the sign-off is regenerated; the first red row is the alert&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;rounded=1;arcSize=10;fillColor=#F5EFE9;strokeColor=none;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;" vertex="1" parent="g5"><mxGeometry x="1323.8" y="57.6" width="614.4" height="110.4" as="geometry"/></mxCell><mxCell id="e0" value="" style="html=1;whiteSpace=nowrap;fontFamily=Arial;edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#F5EFE9;strokeWidth=2;endArrow=block;endFill=1;fontColor=#F5EFE9;fontSize=14.6;fontStyle=1;labelBackgroundColor=#0B3D7A;" edge="1" source="a1" target="a2" parent="g1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="" style="html=1;whiteSpace=nowrap;fontFamily=Arial;edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#F5EFE9;strokeWidth=2;endArrow=block;endFill=1;fontColor=#F5EFE9;fontSize=14.6;fontStyle=1;labelBackgroundColor=#0B3D7A;" edge="1" source="a2" target="a3" parent="g1"><mxGeometry relative="1" as="