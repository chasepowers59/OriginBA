<mxfile><diagram id="page1" name="Standard Offering Deployment Flow"><mxGraphModel adaptiveColors="none" grid="0" page="0" background="#0B1723"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="_layer0" value="Commands" parent="0" visible="0"/><mxCell id="_layer1" value="Checks" parent="0" visible="0"/><mxCell id="g5" value="&lt;b&gt;&lt;font style=&quot;font-size:18.6px&quot; color=&quot;#E6ECF2&quot;&gt;After go-live&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14.6px&quot; color=&quot;#E6ECF2&quot;&gt;every change is a tool run with the same proofs, never a hand edit&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;rounded=1;arcSize=6;fillColor=none;strokeColor=#8ACAD4;strokeWidth=1.5;container=1;pointerEvents=0;align=left;verticalAlign=top;spacingLeft=14;spacingTop=4;fontColor=#E6ECF2;" vertex="1" parent="1"><mxGeometry x="77.8" y="897.6" width="1958.4" height="177.6" as="geometry"/></mxCell><mxCell id="g1" value="&lt;b&gt;&lt;font style=&quot;font-size:18.6px&quot; color=&quot;#E6ECF2&quot;&gt;Origin_DEV&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14.6px&quot; color=&quot;#E6ECF2&quot;&gt;authoring, the internal server&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;rounded=1;arcSize=6;fillColor=none;strokeColor=#8ACAD4;strokeWidth=1.5;container=1;pointerEvents=0;align=left;verticalAlign=top;spacingLeft=14;spacingTop=4;fontColor=#E6ECF2;" vertex="1" parent="1"><mxGeometry x="77.8" y="192" width="466.6" height="676.8" as="geometry"/></mxCell><mxCell id="g2" value="&lt;b&gt;&lt;font style=&quot;font-size:18.6px&quot; color=&quot;#E6ECF2&quot;&gt;Origin_TEST&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14.6px&quot; color=&quot;#E6ECF2&quot;&gt;proving, before any client&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;rounded=1;arcSize=6;fillColor=none;strokeColor=#8ACAD4;strokeWidth=1.5;container=1;pointerEvents=0;align=left;verticalAlign=top;spacingLeft=14;spacingTop=4;fontColor=#E6ECF2;" vertex="1" parent="1"><mxGeometry x="575" y="192" width="466.6" height="676.8" as="geometry"/></mxCell><mxCell id="g3" value="&lt;b&gt;&lt;font style=&quot;font-size:18.6px&quot; color=&quot;#E6ECF2&quot;&gt;Client test org&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14.6px&quot; color=&quot;#E6ECF2&quot;&gt;the client's own data&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;rounded=1;arcSize=6;fillColor=none;strokeColor=#8ACAD4;strokeWidth=1.5;container=1;pointerEvents=0;align=left;verticalAlign=top;spacingLeft=14;spacingTop=4;fontColor=#E6ECF2;" vertex="1" parent="1"><mxGeometry x="1072.3" y="192" width="466.6" height="676.8" as="geometry"/></mxCell><mxCell id="g4" value="&lt;b&gt;&lt;font style=&quot;font-size:18.6px&quot; color=&quot;#E6ECF2&quot;&gt;Client prod org&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14.6px&quot; color=&quot;#E6ECF2&quot;&gt;read-only until the prod flag is given&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;rounded=1;arcSize=6;fillColor=none;strokeColor=#8ACAD4;strokeWidth=1.5;container=1;pointerEvents=0;align=left;verticalAlign=top;spacingLeft=14;spacingTop=4;fontColor=#E6ECF2;" vertex="1" parent="1"><mxGeometry x="1569.6" y="192" width="466.6" height="676.8" as="geometry"/></mxCell><mxCell id="a1" value="&lt;b&gt;&lt;font style=&quot;font-size:18.6px&quot; color=&quot;#004B86&quot;&gt;Workstreams tree&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14.6px&quot; color=&quot;#56636E&quot;&gt;domains, Ad Hoc views, reports and dashboards: the only content edited by hand&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;rounded=1;arcSize=10;fillColor=#F2F5F8;strokeColor=none;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;" vertex="1" parent="g1"><mxGeometry x="17.3" y="72" width="432" height="96" as="geometry"/></mxCell><mxCell id="a1_n" value="1" style="html=1;whiteSpace=wrap;fontFamily=Arial;ellipse;fillColor=#006FAC;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=13.3;spacing=0;" vertex="1" parent="g1"><mxGeometry x="3.8" y="58.6" width="32.6" height="32.6" as="geometry"/></mxCell><object id="a2" label="&lt;b&gt;&lt;font style=&quot;font-size:18.6px&quot; color=&quot;#004B86&quot;&gt;Export the org&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14.6px&quot; color=&quot;#56636E&quot;&gt;one API export task, polled, downloaded&lt;/font&gt;" tooltip="A REST export task on the internal server, polled until done, downloaded as a zip package."><mxCell style="html=1;whiteSpace=wrap;fontFamily=Arial;rounded=1;arcSize=10;fillColor=#F2F5F8;strokeColor=none;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;" vertex="1" parent="g1"><mxGeometry x="17.3" y="182.4" width="432" height="76.8" as="geometry"/></mxCell></object><mxCell id="a2_n" value="2" style="html=1;whiteSpace=wrap;fontFamily=Arial;ellipse;fillColor=#006FAC;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=13.3;spacing=0;" vertex="1" parent="g1"><mxGeometry x="3.8" y="169" width="32.6" height="32.6" as="geometry"/></mxCell><mxCell id="a3" value="&lt;b&gt;&lt;font style=&quot;font-size:18.6px&quot; color=&quot;#004B86&quot;&gt;Build the package&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14.6px&quot; color=&quot;#56636E&quot;&gt;inventory and classify the export; keep the offering list; one copy of each domain in one home; carry the datasource; rewrite every path; strip print wrappers; narrow the import index&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;rounded=1;arcSize=10;fillColor=#F2F5F8;strokeColor=none;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;" vertex="1" parent="g1"><mxGeometry x="17.3" y="273.6" width="432" height="148.8" as="geometry"/></mxCell><mxCell id="a3_n" value="3" style="html=1;whiteSpace=wrap;fontFamily=Arial;ellipse;fillColor=#006FAC;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=13.3;spacing=0;" vertex="1" parent="g1"><mxGeometry x="3.8" y="260.2" width="32.6" height="32.6" as="geometry"/></mxCell><object id="a4" label="package verifies?" tooltip="No source host, org path or datasource name left in the package; every outside reference exists on the target; every field the views use resolves."><mxCell style="html=1;whiteSpace=wrap;fontFamily=Arial;rhombus;fillColor=#006FAC;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=14.6;spacingLeft=23;spacingRight=23;" vertex="1" parent="g1"><mxGeometry x="161.3" y="446.4" width="144" height="86.4" as="geometry"/></mxCell></object><mxCell id="a4_n" value="4" style="html=1;whiteSpace=wrap;fontFamily=Arial;ellipse;fillColor=#006FAC;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=13.3;spacing=0;" vertex="1" parent="g1"><mxGeometry x="147.8" y="433" width="32.6" height="32.6" as="geometry"/></mxCell><mxCell id="sa4" value="stop" style="html=1;whiteSpace=wrap;fontFamily=Arial;rounded=1;arcSize=30;fillColor=#F2F5F8;strokeColor=none;fontColor=#004B86;fontStyle=1;fontSize=12;" vertex="1" parent="g1"><mxGeometry x="19.2" y="468" width="94.1" height="43.2" as="geometry"/></mxCell><mxCell id="b1" value="&lt;b&gt;&lt;font style=&quot;font-size:18.6px&quot; color=&quot;#004B86&quot;&gt;Import, update in place&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14.6px&quot; color=&quot;#56636E&quot;&gt;polled; an importer warning counts as a failure&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;rounded=1;arcSize=10;fillColor=#F2F5F8;strokeColor=none;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;" vertex="1" parent="g2"><mxGeometry x="17.3" y="72" width="432" height="81.6" as="geometry"/></mxCell><mxCell id="b1_n" value="5" style="html=1;whiteSpace=wrap;fontFamily=Arial;ellipse;fillColor=#006FAC;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=13.3;spacing=0;" vertex="1" parent="g2"><mxGeometry x="3.8" y="58.6" width="32.6" height="32.6" as="geometry"/></mxCell><mxCell id="b2" value="&lt;b&gt;&lt;font style=&quot;font-size:18.6px&quot; color=&quot;#004B86&quot;&gt;Re-export and compare&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14.6px&quot; color=&quot;#56636E&quot;&gt;byte-equal inside the scope, importer stamps ignored&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;rounded=1;arcSize=10;fillColor=#F2F5F8;strokeColor=none;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;" vertex="1" parent="g2"><mxGeometry x="17.3" y="168" width="432" height="81.6" as="geometry"/></mxCell><mxCell id="b2_n" value="6" style="html=1;whiteSpace=wrap;fontFamily=Arial;ellipse;fillColor=#006FAC;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=13.3;spacing=0;" vertex="1" parent="g2"><mxGeometry x="3.8" y="154.6" width="32.6" height="32.6" as="geometry"/></mxCell><mxCell id="b3" value="&lt;b&gt;&lt;font style=&quot;font-size:18.6px&quot; color=&quot;#004B86&quot;&gt;Execute everything&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14.6px&quot; color=&quot;#56636E&quot;&gt;views by query, reports as PDF, domains by metadata and probe&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;rounded=1;arcSize=10;fillColor=#F2F5F8;strokeColor=none;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;" vertex="1" parent="g2"><mxGeometry x="17.3" y="264" width="432" height="91.2" as="geometry"/></mxCell><mxCell id="b3_n" value="7" style="html=1;whiteSpace=wrap;fontFamily=Arial;ellipse;fillColor=#006FAC;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=13.3;spacing=0;" vertex="1" parent="g2"><mxGeometry x="3.8" y="250.6" width="32.6" height="32.6" as="geometry"/></mxCell><object id="b4" label="seven proofs pass?" tooltip="the seven proofs: 1 no source host, org path or datasource name survives in the package; 2 every reference to something outside the package exists on the target; 3 every field the views use resolves in its domain; 4 import without warnings; 5 re-export byte-equal inside the scope; 6 every resource executes; 7 datasource connection unchanged"><mxCell style="html=1;whiteSpace=wrap;fontFamily=Arial;rhombus;fillColor=#006FAC;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=14.6;spacingLeft=23;spacingRight=23;" vertex="1" parent="g2"><mxGeometry x="161.3" y="374.4" width="144" height="86.4" as="geometry"/></mxCell></object><mxCell id="b4_n" value="8" style="html=1;whiteSpace=wrap;fontFamily=Arial;ellipse;fillColor=#006FAC;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=13.3;spacing=0;" vertex="1" parent="g2"><mxGeometry x="147.8" y="361" width="32.6" height="32.6" as="geometry"/></mxCell><mxCell id="sb4" value="stop" style="html=1;whiteSpace=wrap;fontFamily=Arial;rounded=1;arcSize=30;fillColor=#F2F5F8;strokeColor=none;fontColor=#004B86;fontStyle=1;fontSize=12;" vertex="1" parent="g2"><mxGeometry x="353.3" y="396" width="94.1" height="43.2" as="geometry"/></mxCell><mxCell id="b5" value="&lt;b&gt;&lt;font style=&quot;font-size:18.6px&quot; color=&quot;#004B86&quot;&gt;Proven offering&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14.6px&quot; color=&quot;#56636E&quot;&gt;the package every client promotion starts from&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;rounded=1;arcSize=10;fillColor=#F2F5F8;strokeColor=none;align=center;verticalAlign=middle;spacingLeft=0;spacingRight=0;" vertex="1" parent="g2"><mxGeometry x="17.3" y="480" width="432" height="81.6" as="geometry"/></mxCell><mxCell id="b5_n" value="9" style="html=1;whiteSpace=wrap;fontFamily=Arial;ellipse;fillColor=#006FAC;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=13.3;spacing=0;" vertex="1" parent="g2"><mxGeometry x="3.8" y="466.6" width="32.6" height="32.6" as="geometry"/></mxCell><object id="c0" label="datasource: the client's own export, carried byte for byte" tooltip="The target org's own /DataSource export is unzipped and carried into the package unchanged; never an edited copy of the source's datasource."><mxCell style="html=1;whiteSpace=wrap;fontFamily=Arial;rounded=1;arcSize=50;fillColor=#006FAC;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=14.6;" vertex="1" parent="g3"><mxGeometry x="17.3" y="72" width="432" height="48" as="geometry"/></mxCell></object><mxCell id="c1" value="&lt;b&gt;&lt;font style=&quot;font-size:18.6px&quot; color=&quot;#004B86&quot;&gt;Inventory snapshot&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14.6px&quot; color=&quot;#56636E&quot;&gt;every resource on the org before anything changes&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;rounded=1;arcSize=10;fillColor=#F2F5F8;strokeColor=none;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;" vertex="1" parent="g3"><mxGeometry x="17.3" y="134.4" width="432" height="76.8" as="geometry"/></mxCell><mxCell id="c1_n" value="10" style="html=1;whiteSpace=wrap;fontFamily=Arial;ellipse;fillColor=#006FAC;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=13.3;spacing=0;" vertex="1" parent="g3"><mxGeometry x="3.8" y="121" width="32.6" height="32.6" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;&lt;font style=&quot;font-size:18.6px&quot; color=&quot;#004B86&quot;&gt;Rebuild for the client&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14.6px&quot; color=&quot;#56636E&quot;&gt;the client's datasource carried; org path, folder, alias and tenant root rewritten by tested replacements&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;rounded=1;arcSize=10;fillColor=#F2F5F8;strokeColor=none;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;" vertex="1" parent="g3"><mxGeometry x="17.3" y="225.6" width="432" height="115.2" as="geometry"/></mxCell><mxCell id="c2_n" value="11" style="html=1;whiteSpace=wrap;fontFamily=Arial;ellipse;fillColor=#006FAC;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=13.3;spacing=0;" vertex="1" parent="g3"><mxGeometry x="3.8" y="212.2" width="32.6" height="32.6" as="geometry"/></mxCell><object id="c3" label="package verified?" tooltip="No source host, org path or datasource name survives; every outside reference exists on the target; every field the views use resolves in its domain."><mxCell style="html=1;whiteSpace=wrap;fontFamily=Arial;rhombus;fillColor=#006FAC;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=14.6;spacingLeft=23;spacingRight=23;" vertex="1" parent="g3"><mxGeometry x="161.3" y="355.2" width="144" height="86.4" as="geometry"/></mxCell></object><mxCell id="c3_n" value="12" style="html=1;whiteSpace=wrap;fontFamily=Arial;ellipse;fillColor=#006FAC;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=13.3;spacing=0;" vertex="1" parent="g3"><mxGeometry x="147.8" y="341.8" width="32.6" height="32.6" as="geometry"/></mxCell><mxCell id="sc3" value="stop" style="html=1;whiteSpace=wrap;fontFamily=Arial;rounded=1;arcSize=30;fillColor=#F2F5F8;strokeColor=none;fontColor=#004B86;fontStyle=1;fontSize=12;" vertex="1" parent="g3"><mxGeometry x="353.3" y="376.8" width="94.1" height="43.2" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;&lt;font style=&quot;font-size:18.6px&quot; color=&quot;#004B86&quot;&gt;Import, compare, execute&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14.6px&quot; color=&quot;#56636E&quot;&gt;the same three proofs as Origin_TEST&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;rounded=1;arcSize=10;fillColor=#F2F5F8;strokeColor=none;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;" vertex="1" parent="g3"><mxGeometry x="17.3" y="460.8" width="432" height="76.8" as="geometry"/></mxCell><mxCell id="c4_n" value="13" style="html=1;whiteSpace=wrap;fontFamily=Arial;ellipse;fillColor=#006FAC;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=13.3;spacing=0;" vertex="1" parent="g3"><mxGeometry x="3.8" y="447.4" width="32.6" height="32.6" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;&lt;font style=&quot;font-size:18.6px&quot; color=&quot;#004B86&quot;&gt;Sweep and sign off&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14.6px&quot; color=&quot;#56636E&quot;&gt;PASS, EMPTY, SLOW or FAIL per resource with timing; one document per org&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;rounded=1;arcSize=10;fillColor=#F2F5F8;strokeColor=none;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;" vertex="1" parent="g3"><mxGeometry x="17.3" y="552" width="432" height="96" as="geometry"/></mxCell><mxCell id="c5_n" value="14" style="html=1;whiteSpace=wrap;fontFamily=Arial;ellipse;fillColor=#006FAC;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=13.3;spacing=0;" vertex="1" parent="g3"><mxGeometry x="3.8" y="538.6" width="32.6" height="32.6" as="geometry"/></mxCell><object id="d0" label="explicit prod flag required" tooltip="Prod writes refuse to run without the explicit prod flag; every other command is read-only against prod."><mxCell style="html=1;whiteSpace=wrap;fontFamily=Arial;rounded=1;arcSize=50;fillColor=#006FAC;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=16;" vertex="1" parent="g4"><mxGeometry x="17.3" y="72" width="432" height="48" as="geometry"/></mxCell></object><mxCell id="d1" value="&lt;b&gt;&lt;font style=&quot;font-size:18.6px&quot; color=&quot;#004B86&quot;&gt;Inventory snapshot&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14.6px&quot; color=&quot;#56636E&quot;&gt;the rollback baseline&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;rounded=1;arcSize=10;fillColor=#F2F5F8;strokeColor=none;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;" vertex="1" parent="g4"><mxGeometry x="17.3" y="134.4" width="432" height="72" as="geometry"/></mxCell><mxCell id="d1_n" value="15" style="html=1;whiteSpace=wrap;fontFamily=Arial;ellipse;fillColor=#006FAC;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=13.3;spacing=0;" vertex="1" parent="g4"><mxGeometry x="3.8" y="121" width="32.6" height="32.6" as="geometry"/></mxCell><mxCell id="d2" value="&lt;b&gt;&lt;font style=&quot;font-size:18.6px&quot; color=&quot;#004B86&quot;&gt;Same promotion, same proofs&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14.6px&quot; color=&quot;#56636E&quot;&gt;target datasource carried; rewritten; verified; imported; compared; executed&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;rounded=1;arcSize=10;fillColor=#F2F5F8;strokeColor=none;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;" vertex="1" parent="g4"><mxGeometry x="17.3" y="220.8" width="432" height="105.6" as="geometry"/></mxCell><mxCell id="d2_n" value="16" style="html=1;whiteSpace=wrap;fontFamily=Arial;ellipse;fillColor=#006FAC;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=13.3;spacing=0;" vertex="1" parent="g4"><mxGeometry x="3.8" y="207.4" width="32.6" height="32.6" as="geometry"/></mxCell><object id="d3" label="seven proofs pass?" tooltip="the seven proofs: 1 no source host, org path or datasource name survives in the package; 2 every reference to something outside the package exists on the target; 3 every field the views use resolves in its domain; 4 import without warnings; 5 re-export byte-equal inside the scope; 6 every resource executes; 7 datasource connection unchanged"><mxCell style="html=1;whiteSpace=wrap;fontFamily=Arial;rhombus;fillColor=#006FAC;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=14.6;spacingLeft=23;spacingRight=23;" vertex="1" parent="g4"><mxGeometry x="161.3" y="340.8" width="144" height="86.4" as="geometry"/></mxCell></object><mxCell id="d3_n" value="17" style="html=1;whiteSpace=wrap;fontFamily=Arial;ellipse;fillColor=#006FAC;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=13.3;spacing=0;" vertex="1" parent="g4"><mxGeometry x="147.8" y="327.4" width="32.6" height="32.6" as="geometry"/></mxCell><mxCell id="sd3" value="stop" style="html=1;whiteSpace=wrap;fontFamily=Arial;rounded=1;arcSize=30;fillColor=#F2F5F8;strokeColor=none;fontC