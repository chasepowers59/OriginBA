4.6px&quot; color=&quot;#F5EFE9&quot;&gt;unattended; they survive a dropped connection&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;rounded=1;arcSize=6;fillColor=none;strokeColor=#F5EFE9;strokeWidth=1.5;container=1;pointerEvents=0;align=left;verticalAlign=top;spacingLeft=14;spacingTop=4;fontColor=#F5EFE9;" vertex="1" parent="1"><mxGeometry x="1287.4" y="206.4" width="748.8" height="158.4" as="geometry"/></mxCell><mxCell id="p1" value="&lt;b&gt;&lt;font style=&quot;font-size:18.6px&quot; color=&quot;#0B3D7A&quot;&gt;Preflight&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14.6px&quot; color=&quot;#4C5D69&quot;&gt;the deploy user can read every source table and write the targets&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;rounded=1;arcSize=10;fillColor=#F5EFE9;strokeColor=none;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="77.8" y="240" width="240" height="96" as="geometry"/></mxCell><mxCell id="p2" value="&lt;b&gt;&lt;font style=&quot;font-size:18.6px&quot; color=&quot;#0B3D7A&quot;&gt;Create the 7 snapshot tables&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14.6px&quot; color=&quot;#4C5D69&quot;&gt;empty, with their keys&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;rounded=1;arcSize=10;fillColor=#F5EFE9;strokeColor=none;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="346.6" y="240" width="278.4" height="96" as="geometry"/></mxCell><mxCell id="p3" value="&lt;b&gt;&lt;font style=&quot;font-size:18.6px&quot; color=&quot;#0B3D7A&quot;&gt;Create the domain-support objects&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14.6px&quot; color=&quot;#4C5D69&quot;&gt;SA snapshot table, lookup seed, 8 CMS views, grants, synonyms&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;rounded=1;arcSize=10;fillColor=#F5EFE9;strokeColor=none;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="653.8" y="240" width="297.6" height="96" as="geometry"/></mxCell><mxCell id="p4" value="&lt;b&gt;&lt;font style=&quot;font-size:18.6px&quot; color=&quot;#0B3D7A&quot;&gt;Deploy the procedures&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14.6px&quot; color=&quot;#4C5D69&quot;&gt;baseline (the retained 24 months, once) and operational per table; the SA aged-balance refresh&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;rounded=1;arcSize=10;fillColor=#F5EFE9;strokeColor=none;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="980.2" y="240" width="278.4" height="96" as="geometry"/></mxCell><mxCell id="j0" value="&lt;b&gt;&lt;font style=&quot;font-size:13.3px&quot; color=&quot;#0B3D7A&quot;&gt;FT&lt;/font&gt;&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;rounded=1;arcSize=10;fillColor=#F5EFE9;strokeColor=none;align=center;verticalAlign=middle;spacingLeft=0;spacingRight=0;" vertex="1" parent="p5"><mxGeometry x="20.2" y="60.5" width="170.9" height="40.3" as="geometry"/></mxCell><mxCell id="j1" value="&lt;b&gt;&lt;font style=&quot;font-size:13.3px&quot; color=&quot;#0B3D7A&quot;&gt;Billed usage&lt;/font&gt;&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;rounded=1;arcSize=10;fillColor=#F5EFE9;strokeColor=none;align=center;verticalAlign=middle;spacingLeft=0;spacingRight=0;" vertex="1" parent="p5"><mxGeometry x="204.5" y="60.5" width="170.9" height="40.3" as="geometry"/></mxCell><mxCell id="j2" value="&lt;b&gt;&lt;font style=&quot;font-size:13.3px&quot; color=&quot;#0B3D7A&quot;&gt;SQ usage&lt;/font&gt;&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;rounded=1;arcSize=10;fillColor=#F5EFE9;strokeColor=none;align=center;verticalAlign=middle;spacingLeft=0;spacingRight=0;" vertex="1" parent="p5"><mxGeometry x="388.8" y="60.5" width="170.9" height="40.3" as="geometry"/></mxCell><mxCell id="j3" value="&l