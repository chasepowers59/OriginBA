	<detail>
		<band height="170">
			<property name="com.jaspersoft.studio.unit.height" value="px"/>
			<frame>
				<reportElement x="0" y="0" width="572" height="170" uuid="74ae1019-4fdf-4002-85fc-f304a0db1a59"/>
				<textField textAdjust="StretchHeight" isBlankWhenNull="true">
					<reportElement stretchType="RelativeToBandHeight" x="0" y="0" width="572" height="25" isPrintWhenDetailOverflows="true" uuid="e128db94-962a-4538-abce-134569b7c888">
						<property name="com.jaspersoft.studio.unit.x" value="px"/>
						<property name="com.jaspersoft.studio.unit.y" value="px"/>
						<property name="com.jaspersoft.studio.unit.height" value="px"/>
					</reportElement>
					<box topPadding="0" leftPadding="10" rightPadding="10"/>
					<textElement textAlignment="Left" verticalAlignment="Middle" markup="html">
						<font fontName="SansSerif" size="10" isBold="false"/>
						<paragraph lineSpacing="1_1_2"/>
					</textElement>
					<textFieldExpression><![CDATA["Date:<u>       "+new SimpleDateFormat("MMMM dd, yyyy").format($F{letterDate})+"</u>"]]></textFieldExpression>
				</textField>
				<textField textAdjust="StretchHeight" isBlankWhenNull="true">
					<reportElement stretchType="RelativeToBandHeight" x="0" y="40" width="572" height="130" isPrintWhenDetailOverflows="true" uuid="49cd1201-d61a-45b0-b1b2-5d6ef91f88e2">
						<property name="com.jaspersoft.studio.unit.x" value="px"/>
						<property name="com.jaspersoft.studio.unit.height" value="px"/>
						<property name="com.jaspersoft.studio.unit.y" value="px"/>
					</reportElement>
					<box topPadding="5" leftPadding="10" rightPadding="10"/>
					<textElement textAlignment="Left" verticalAlignment="Top" markup="html">
						<font fontName="SansSerif" size="10" isBold="false"/>
						<paragraph lineSpacing="1_1_2"/>
					</textElement>
					<textFieldExpression><![CDATA["Customer Name:<u>     "+($F{mailingInfoEntityName1}==null?"":$F{mailingInfoEntityName1})+
($F{mailingInfoEntityName2}==null?"":" "+$F{mailingInfoEntityName2})+
($F{mailingInfoEntityName3}==null?"":" "+$F{mailingInfoEntityName3})+"     </u><br />"+
"Mailing Address:<u>     "+($F{mailingInfoAddress1}==null?"":$F{mailingInfoAddress1})+
($F{mailingInfoCity}==null?"":", "+$F{mailingInfoCity})+
($F{mailingInfoState}==null?"":" " +$F{mailingInfoState})+ 
($F{mailingInfoPostal}==null?"":" "+$F{mailingInfoPostal})+"     </u><br />"+
"Service Address:<u>     "+($F{severanceDetailsAddress1}==null?"":$F{severanceDetailsAddress1})+
($F{severanceDetailsCity}==null?"":", "+$F{severanceDetailsCity})+
($F{severanceDetailsState}==null?"":" " + $F{severanceDetailsState})+
($F{severanceDetailsPostal}==null?"":" "+$F{severanceDetailsPostal})+"     </u><br />"+
"Utility Account Number:<u>     "+($F{severanceDetailsAccountId}==null?"":$F{severanceDetailsAccountId})+"     </u>"]]></textFieldExpression>
				</textField>
			</frame>
		</band>
		<band height="110" splitType="Stretch">
			<property name="com.jaspersoft.studio.unit.height" value="px"/>
			<frame>
				<reportElement x="0" y="0" width="572" height="110" uuid="74b851a6-3e32-4786-90d4-2334cdaa2287"/>
				<textField textAdjust="StretchHeight">
					<reportElement x="0" y="0" width="572" height="110" uuid="95d0e317-8ea0-48bb-ba9e-992431a4ad6e">
						<property name="com.jaspersoft.studio.unit.height" value="px"/>
						<property name="com.jaspersoft.studio.unit.y" value="px"/>
					</reportElement>
					<box topPadding="2" leftPadding="10" bottomPadding="2" rightPadding="10"/>
					<textElement textAlignment="Justified" verticalAlignment="Top" markup="html">
						<font fontName="SansSerif" size="10"/>
						<paragraph lineSpacing="1_1_2"/>
					</textElement>
					<textFieldExpression><![CDATA["Dear Utility customer,<br /><br />"+

"You are receiving this letter because we believe there may be a water leak on your side of the city installed water meter for your property.<br /><br />"+

"Los Alamos Department of Public Utilities recently received a software update to its handheld meter reading devices. This update provides us with additional information when reading water meters.<br /><br />"+

"One of the new pieces of data we obtain is whether there is a “constant” flow of water going through the meter. It is unable to provide us with what the flow rate may be; however, since there should be at least some time of day that water is not flowing through your meter, it does indicate that a leak is possible. The leak could be in the waterline to your home, in your irrigation system, or even as small as a dripping faucet or leaky toilet valve.<br /><br />"+

"If you contact our office, we can provide details of your water consumption and whether it appears to be excessive. In some cases, if you do have a water leak, you may be eligible for an adjustment to your utility account once we have proof that the leak has been repaired.<br /><br />"+

"If you have any questions please contact our office at (505) 662-8333."]]></textFieldExpression>
				</textField>
			</frame>
		</band>
		<band height="80">
			<textField textAdjust="StretchHeight" isBlankWhenNull="true">
				<reportElement stretchType="RelativeToBandHeight" x="0" y="0" width="572" height="80" isPrintWhenDetailOverflows="true" uuid="caf209ab-6e8d-4aa5-99e7-bce8857dcd31">
					<property name="com.jaspersoft.studio.unit.y" value="px"/>
					<property name="com.jaspersoft.studio.unit.x" value="px"/>
				</reportElement>
				<box topPadding="10" leftPadding="10" rightPadding="10"/>
				<textElement textAlignment="Left" verticalAlignment="Top" markup="html">
					<font fontName="SansSerif" size="10" isBold="false"/>
					<paragraph lineSpacing="1_1_2"/>
				</textElement>
				<textFieldExpression><![CDATA["Sincerely,<br />"+
"Los Alamos Department of Public Utilities"]]></textFieldExpression>
			</textField>
		</band>
	</detail>
