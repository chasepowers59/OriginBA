				<reportElement x="0" y="0" width="280" height="60" forecolor="#FF0D05" uuid="a4e7e425-a0e2-4dca-829f-a6adf1c7181b">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
					<property name="com.jaspersoft.studio.unit.y" value="px"/>
				</reportElement>
				<box topPadding="2" leftPadding="10" bottomPadding="2" rightPadding="10"/>
				<textElement textAlignment="Left" verticalAlignment="Top" markup="html">
					<font fontName="SansSerif" size="8"/>
					<paragraph lineSpacing="1_1_2"/>
				</textElement>
				<textFieldExpression><![CDATA["      if we do not receive payment or an agreement is not signed by time shown above, continuation of service will be allowed only upon payment in full of delinquent charges, and upon receipt of a deposit for this service account unless a deposit is currently held."]]></textFieldExpression>
			</textField>
			<frame>
				<reportElement x="292" y="0" width="280" height="70" uuid="52d05688-8dfc-4cd1-9b97-9521eab36754">
					<property name="com.jaspersoft.studio.unit.x" value="px"/>
					<property name="com.jaspersoft.studio.unit.y" value="px"/>
				</reportElement>
				<textField textAdjust="StretchHeight">
					<reportElement x="0" y="0" width="280" height="70" forecolor="#FF0D05" uuid="d927dc8f-7151-4fb1-be1a-06aff3369d25">
						<property name="com.jaspersoft.studio.unit.height" value="px"/>
						<property name="com.jaspersoft.studio.unit.y" value="px"/>
					</reportElement>
					<box topPadding="2" leftPadding="10" bottomPadding="2" rightPadding="10"/>
					<textElement textAlignment="Left" verticalAlignment="Top" markup="html">
						<font fontName="SansSerif" size="8"/>
						<paragraph lineSpacing="1_1_2"/>
					</textElement>
					<textFieldExpression><![CDATA["    Si no recibe el pago o no se firma un acuerdo en el tiempo que se muestra arriba, se permitirá la continuación del servicio solo con el pago total de los cargos atrasados ​​y con la recepción de un depósito para esta cuenta de servicio, a menos que se tenga un depósito actualmente."]]></textFieldExpression>
				</textField>
			</frame>
		</band>
		<band height="90">
			<line>
				<reportElement x="0" y="5" width="280" height="1" forecolor="#FF0D05" uuid="ed910c0e-4f0d-43a7-aa65-028d13724b66">
					<property name="com.jaspersoft.studio.unit.x" value="px"/>
					<property name="com.jaspersoft.studio.unit.width" value="px"/>
					<property name="com.jaspersoft.studio.unit.y" value="px"/>
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
			</line>
			<textField textAdjust="StretchHeight">
				<reportElement x="0" y="10" width="280" height="80" forecolor="#FF0D05" uuid="0a8e482a-39ee-41f3-8f19-522487cd2710">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
					<property name="com.jaspersoft.studio.unit.y" value="px"/>
				</reportElement>
				<box topPadding="2" leftPadding="10" bottomPadding="2" rightPadding="10"/>
				<textElement textAlignment="Left" verticalAlignment="Top" markup="html">
					<font fontName="SansSerif" size="8"/>
					<paragraph lineSpacing="1_1_2"/>
				</textElement>
				<textFieldExpression><![CDATA["     Once service is disconnected a reconnection charge must be paid for each utility reconnected during utility personnel's regular working hours.  After these hours and on weekends, an overtime charge will be made for each utility.  We connect guarantee reconnection  on the same day payment is made <br /><br /><br />"]]></textFieldExpression>
			</textField>
			<line>
				<reportElement x="292" y="5" width="280" height="1" forecolor="#FF0D05" uuid="a4a14594-49db-46af-a0a5-89051fa44df1">
					<property name="com.jaspersoft.studio.unit.x" value="px"/>
					<property name="com.jaspersoft.studio.unit.width" value="px"/>
					<property name="com.jaspersoft.studio.unit.y" value="px"/>
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
			</line>
			<textField textAdjust="StretchHeight">
				<reportElement x="292" y="10" width="280" height="80" forecolor="#FF0D05" uuid="1d31cbe0-d807-4332-93eb-b23451a9fdcb">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
					<property name="com.jaspersoft.studio.unit.y" value="px"/>
					<property name="com.jaspersoft.studio.unit.x" value="px"/>
				</reportElement>
				<box topPadding="2" leftPadding="10" bottomPadding="2" rightPadding="10"/>
				<textElement textAlignment="Left" verticalAlignment="Top" markup="html">
					<font fontName="SansSerif" size="8"/>
					<paragraph lineSpacing="1_1_2"/>
				</textElement>
				<textFieldExpression><![CDATA["     Una vez que se desconecta el servicio, se debe pagar un cargo de reconexión por cada servicio que se vuelva a conectar durante el horario de trabajo normal del personal del servicio. después de este horario y los fines de semana, se hará un cargo por horas extras por cada servicio. conectamos garantizamos la reconexión el mismo día que se realiza el pago <br /><br />"]]></textFieldExpression>
			</textField>
		</band>
		<band height="85">
			<textField textAdjust="StretchHeight" isBlankWhenNull="true">
				<reportElement stretchType="RelativeToBandHeight" x="0" y="5" width="280" height="80" isPrintWhenDetailOverflows="true" uuid="caf209ab-6e8d-4aa5-99e7-bce8857dcd31">
					<property name="com.jaspersoft.studio.unit.y" value="px"/>
					<property name="com.jaspersoft.studio.unit.x" value="px"/>
				</reportElement>
				<box topPadding="10" leftPadding="10" rightPadding="10"/>
				<textElement textAlignment="Center" verticalAlignment="Top" markup="styled">
					<font fontName="SansSerif" size="9" isBold="false"/>
					<paragraph lineSpacing="1_1_2"/>
				</textElement>
				<textFieldExpression><![CDATA["If you dispute the amount owing you have the right to confer with a representative of the City.<br />"+
"Pay directly at:<br /><br />"+
"Finance Department, City Hall<br />"+
"41 Center Street<br />"+ 
"Business Hours-8:00a.m. to 5:00p.m.<br />"+
"Monday through Friday<br />"+
"962-7201"]]></textFieldExpression>
			</textField>
			<textField textAdjust="StretchHeight" isBlankWhenNull="true">
				<reportElement stretchType="RelativeToBandHeight" x="292" y="5" width="280" height="80" isPrintWhenDetailOverflows="true" uuid="79dfc717-6602-40f3-a98c-2e8adc2d48a0">
					<property name="com.jaspersoft.studio.unit.y" value="px"/>
					<property name="com.jaspersoft.studio.unit.x" value="px"/>
				</reportElement>
				<box topPadding="10" leftPadding="10" rightPadding="10"/>
				<textElement textAlignment="Center" verticalAlignment="Top" markup="styled">
					<font fontName="SansSerif" size="9" isBold="false"/>
					<paragraph lineSpacing="1_1_2"/>
				</textElement>
				<textFieldExpression><![CDATA["Si disputa el monto adeudado, tiene derecho a consultar con un representante de la Ciudad.<br />"+
"Paga directamente en:<br /><br />"+
"Departamento de Finanzas, Ayuntamiento<br />"+
"41 Calle Center<br />"+ 
"Horario comercial - 8:00 a.m. a 5:00 p.m.<br />"+
"De lunes a viernes<br />"+
"962-7201"]]></textFieldExpression>
