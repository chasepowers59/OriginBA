      <filterString>CI_LOOKUP_VAL_L.FIELD_NAME == 'REF_STATUS_FLG                ' and CI_ACCT_PER.MAIN_CUST_SW == 'Y' and CI_LOOKUP_VAL_L.LANGUAGE_CD == 'ENG' and CI_COLL_AGY_L.LANGUAGE_CD == 'ENG' and CI_PER_NAME.NAME_TYPE_FLG == 'PRIM'</filterString>
      <joinInfo alias="CI_COLL_AGY_REF" referenceId="CI_COLL_AGY_REF"></joinInfo>
      <joinList>
        <join expr="CI_COLL_AGY_REF.COLL_AGY_REF_ID == CI_COLL_AGY_HIS.COLL_AGY_REF_ID" left="CI_COLL_AGY_REF" right="CI_COLL_AGY_HIS" type="leftOuter" weight="1"></join>
        <join expr="CI_COLL_AGY_REF.COLL_AGY_CD == CI_COLL_AGY_L.COLL_AGY_CD and CI_COLL_AGY_L.LANGUAGE_CD == 'ENG'" left="CI_COLL_AGY_REF" right="CI_COLL_AGY_L" type="inner" weight="1"></join>
        <join expr="CI_COLL_AGY_REF.REF_STATUS_FLG == CI_LOOKUP_VAL_L.FIELD_VALUE and CI_LOOKUP_VAL_L.FIELD_NAME == 'REF_STATUS_FLG' and CI_LOOKUP_VAL_L.LANGUAGE_CD == 'ENG'" left="CI_COLL_AGY_REF" right="CI_LOOKUP_VAL_L" type="inner" weight="1"></join>
        <join expr="CI_COLL_AGY_REF.USER_ID == SC_USER.USER_ID" left="CI_COLL_AGY_REF" right="SC_USER" type="inner" weight="1"></join>
        <join expr="CI_COLL_AGY_HIS.REF_HIST_RSN_FLG == CI_LOOKUP_VAL_L_1.FIELD_VALUE and CI_LOOKUP_VAL_L_1.FIELD_NAME == 'REF_HIST_RSN_FLG' and CI_LOOKUP_VAL_L_1.LANGUAGE_CD == 'ENG'" left="CI_COLL_AGY_HIS" right="CI_LOOKUP_VAL_L_1" type="leftOuter" weight="1"></join>
        <join expr="CI_COLL_AGY_REF.ACCT_ID == CI_ACCT_PER.ACCT_ID and CI_ACCT_PER.MAIN_CUST_SW == 'Y'" left="CI_COLL_AGY_REF" right="CI_ACCT_PER" type="inner" weight="1"></join>
        <join expr="CI_ACCT_PER.PER_ID == CI_PER_NAME.PER_ID and CI_ACCT_PER.MAIN_CUST_SW == 'Y' and CI_PER_NAME.NAME_TYPE_FLG == 'PRIM'" left="CI_ACCT_PER" right="CI_PER_NAME" type="inner" weight="1"></join>
      </joinList>
      <joinOptions></joinOptions>
      <tableRefList>
        <tableRef alwaysIncludeTable="false" tableAlias="CI_LOOKUP_VAL_L_1" tableId="CI_LOOKUP_VAL_L_1"></tableRef>
        <tableRef alwaysIncludeTable="false" tableAlias="CI_ACCT_PER" tableId="CI_ACCT_PER"></tableRef>
        <tableRef alwaysIncludeTable="false" tableAlias="CI_COLL_AGY_HIS" tableId="CI_COLL_AGY_HIS"></tableRef>
        <tableRef alwaysIncludeTable="false" tableAlias="SC_USER" tableId="SC_USER"></tableRef>
        <tableRef alwaysIncludeTable="false" tableAlias="CI_COLL_AGY_REF" tableId="CI_COLL_AGY_REF"></tableRef>
        <tableRef alwaysIncludeTable="false" tableAlias="CI_COLL_AGY_L" tableId="CI_COLL_AGY_L"></tableRef>
        <tableRef alwaysIncludeTable="false" tableAlias="CI_LOOKUP_VAL_L" tableId="CI_LOOKUP_VAL_L"></tableRef>
        <tableRef alwaysIncludeTable="false" tableAlias="CI_PER_NAME" tableId="CI_PER_NAME"></tableRef>
      </tableRefList>
    </jdbcTable>
  </resources>
</schema>
