        <field id="DAYS_OLD" dataSetExpression="ElapsedDays(Today(0), CI_COLL_AGY_REF.START_DT)" type="java.math.BigDecimal"></field>
        <field id="USER_ID_NAME" dataSetExpression="Concatenate(SC_USER.FIRST_NAME, ' ', SC_USER.LAST_NAME)" type="java.lang.String"></field>
        <field id="COLL_AGY_HIST_DISTINCT" dataSetExpression="CountDistinct(Concatenate(CI_COLL_AGY_HIS.COLL_AGY_REF_ID, '_', CI_COLL_AGY_HIS.SEQ_NUM), 'Current')" type="java.lang.Long"></field>
        <field id="ACCT_ID_DISTINCT" dataSetExpression="CountDistinct&#xA;(CI_COLL_AGY_REF.ACCT_ID, 'Current')&#xA;" type="java.lang.Long"></field>
