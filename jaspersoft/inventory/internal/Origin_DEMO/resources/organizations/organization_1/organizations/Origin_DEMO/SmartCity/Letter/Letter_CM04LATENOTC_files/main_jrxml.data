					<paragraph lineSpacing="Double"/>
				</textElement>
				<textFieldExpression><![CDATA["Due Date:  "+($F{collectionArrearsDate}==null?"":new SimpleDateFormat("MMMM dd, yyyy").format($F{collectionArrearsDate}))+"<br/>"+
"Amount Due: "+($F{amountStillOwed}==null?"":$F{amountStillOwed}) +"<br/>"+
"Amount Paid: <u>__________________________</u>"]]></textFieldExpression>
			</textField>
		</band>
	</detail>
</jasperReport>
