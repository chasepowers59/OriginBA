  <subFilterList>
    <subFilter id="filter_1" letter="A" sourceString="DYNAMIC">
      <expressionString>not (Master_Data.SA_STATUS in ('Pending Stop', 'Reactivated', 'Pending Start', 'Active'))</expressionString>
