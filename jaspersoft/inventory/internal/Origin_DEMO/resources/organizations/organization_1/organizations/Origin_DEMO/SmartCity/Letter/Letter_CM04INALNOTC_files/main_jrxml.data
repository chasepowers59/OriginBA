						<font fontName="SansSerif" size="10"/>
						<paragraph lineSpacing="1_1_2"/>
					</textElement>
					<textFieldExpression><![CDATA["We have not received payment or satisfactory payment arrangements on your closing bill for utility services at the above address. Your account will be assigned to our collection agency unless we receive payment in full by the due date of this letter. Additional costs may be incurred if your account is assigned to the collection agency. reference the above account number on your check and on any correspondence to our office to ensure accuracy.<br /><br />"]]></textFieldExpression>
				</textField>
