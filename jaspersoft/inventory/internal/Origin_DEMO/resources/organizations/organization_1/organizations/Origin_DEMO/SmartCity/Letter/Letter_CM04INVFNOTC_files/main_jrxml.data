						<font fontName="SansSerif" size="10"/>
						<paragraph lineSpacing="1_1_2"/>
					</textElement>
					<textFieldExpression><![CDATA["According to our records, the attached invoice(s), #"+($F{billId}==null?"":$F{billId})+", dated "+($F{billDate}==null?"":(new SimpleDateFormat("MM/dd/yyyy").format($F{billDate})))+" has not been paid. <br /><br />"+

"If payment is not received within thirty-five days of the date of this letter, this matter will be turned over to the Merchants Credit Association for collection. Any additional fees incurred will be your responsibility.<br /><br />"+
"Please contact our office at (505) 662-8333 to avoid collection procedures and to schedule payment arrangements.<br /><br />"]]></textFieldExpression>
				</textField>
			</frame>
