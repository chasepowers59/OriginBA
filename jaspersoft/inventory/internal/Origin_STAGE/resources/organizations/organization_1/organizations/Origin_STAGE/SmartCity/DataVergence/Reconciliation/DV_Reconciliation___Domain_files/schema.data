    <jdbcQuery id="CMS_ACTIVE_ACCOUNTS" datasourceId="Origin_STAGE_DS">
      <fieldList>
        <field id="ACCT_ID" type="java.lang.String"></field>
        <field id="ACTIVE_COUNT" type="java.math.BigDecimal"></field>
      </fieldList>
      <query>select acct_id, count('x') as active_count from cisadm.ci_sa sa
where sa.sa_status_flg IN ('10','20','30','40','50')
      and sa.version &gt;= 500
group by acct_id</query>
    </jdbcQuery>
    <jdbcQuery id="CMS_LL_PREMISES" datasourceId="Origin_STAGE_DS">
      <fieldList>
        <field id="LL_ID" type="java.lang.String"></field>
        <field id="PREMISE_COUNT" type="java.math.BigDecimal"></field>
      </fieldList>
      <query>select ll_id, count('x') as premise_count
        from cisadm.ci_prem
        group by ll_id</query>
    </jdbcQuery>
    <jdbcQuery id="CMS_SA_RS" datasourceId="Origin_STAGE_DS">
      <fieldList>
        <field id="SA_ID" type="java.lang.String"></field>
        <field id="RS_CD" type="java.lang.String"></field>
      </fieldList>
      <query>SELECT SA_ID, MAX(RS_CD) AS RS_CD
FROM
  CISADM.CI_SA_RS_HIST
WHERE
  VERSION &gt;= 500
GROUP BY SA_ID</query>
    </jdbcQuery>
    <jdbcQuery id="CMS_ACCT_BAL" datasourceId="Origin_STAGE_DS">
      <fieldList>
        <field id="ACCT_ID" type="java.lang.String"></field>
        <field id="CUR_BAL" type="java.math.BigDecimal"></field>
        <field id="TOT_BAL" type="java.math.BigDecimal"></field>
      </fieldList>
      <query>select acct_id,  sum(cur_bal) as cur_bal, sum(tot_bal) as tot_bal 
from cisadm.cms_sa_snapshot
group by acct_id</query>
    </jdbcQuery>
    <jdbcQuery id="CMS_ADJ_ARREARS_BALANCE" datasourceId="Origin_STAGE_DS">
      <fieldList>
        <field id="ADJ_TYPE_CD" type="java.lang.String"></field>
        <field id="TOT_ADJ_AMT" type="java.math.BigDecimal"></field>
        <field id="SA_ID" type="java.lang.String"></field>
      </fieldList>
      <query>select adj.sa_id, adj.adj_type_cd, sum(adj.adj_amt) as tot_adj_amt
from
  cisadm.ci_adj adj
where
   adj.adj_type_cd = 'CONVARS'
  and adj.version &gt;= 500
group by
  adj.sa_id, adj.adj_type_cd</query>
    </jdbcQuery>
    <jdbcQuery id="CMS_ASSET_NODE" datasourceId="Origin_STAGE_DS">
      <fieldList>
        <field id="NODE_ID" type="java.lang.String"></field>
        <field id="NODE_TYPE_CD" type="java.lang.String"></field>
        <field id="NODE_DPOS_FLG" type="java.lang.String"></field>
        <field id="ASSET_ID" type="java.lang.String"></field>
      </fieldList>
      <query>select 
  an1.asset_id, n.node_id, n.node_type_cd, n.node_dpos_flg
from
  cisadm.w1_asset_node an1,
  cisadm.w1_node n
where
  an1.eff_dttm = (
        select 
          max(an.eff_dttm)
        from
          cisadm.w1_asset_node an
        where
          an.asset_id = an1.asset_id
          )
  and an1.node_id = n.node_id</query>
    </jdbcQuery>
