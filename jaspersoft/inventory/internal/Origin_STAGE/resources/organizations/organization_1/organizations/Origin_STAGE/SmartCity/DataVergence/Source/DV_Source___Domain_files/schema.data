      <joinList>
        <join expr="DV_CUSTOMER_STG.CUST_NBR == DV_ACCOUNT_STG.PRIMARY_CUST_NBR" left="DV_CUSTOMER_STG" right="DV_ACCOUNT_STG" type="fullOuter" weight="1"></join>
