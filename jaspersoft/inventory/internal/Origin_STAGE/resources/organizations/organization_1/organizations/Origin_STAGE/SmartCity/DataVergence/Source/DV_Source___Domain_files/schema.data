        <join expr="DV_SA_STG.ACCT_NBR == DV_PAYMENT_STG.ACCT_NBR and DV_SA_STG.SA_NBR == DV_PAYMENT_STG.SA_NBR" left="DV_SA_STG" right="DV_PAYMENT_STG" type="leftOuter" weight="1"></join>
