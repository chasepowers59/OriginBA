      <joinInfo alias="W1_ASSET" referenceId="W1_ASSET"></joinInfo>
      <joinList>
        <join expr="W1_ASSET.ASSET_ID == W1_ASSET_NODE.ASSET_ID" left="W1_ASSET" right="W1_ASSET_NODE" type="inner" weight="1"></join>
        <join expr="W1_ASSET.ASSET_ID == CMS_W1_ASSET_IDENTIFIER_VW.ASSET_ID" left="W1_ASSET" right="CMS_W1_ASSET_IDENTIFIER_VW" type="inner" weight="1"></join>
        <join expr="W1_ASSET_NODE.NODE_ID == W1_NODE.NODE_ID" left="W1_ASSET_NODE" right="W1_NODE" type="inner" weight="1"></join>
        <join expr="W1_ASSET.ASSET_TYPE_CD == W1_ASSET_TYPE_L.ASSET_TYPE_CD and W1_ASSET_TYPE_L.LANGUAGE_CD == 'ENG'" left="W1_ASSET" right="W1_ASSET_TYPE_L" type="inner" weight="1"></join>
        <join expr="W1_ASSET.BUS_OBJ_CD == F1_BUS_OBJ_L.BUS_OBJ_CD and F1_BUS_OBJ_L.LANGUAGE_CD == 'ENG'" left="W1_ASSET" right="F1_BUS_OBJ_L" type="inner" weight="1"></join>
        <join expr="W1_ASSET.BO_STATUS_REASON_CD == F1_BUS_OBJ_STATUS_RSN_L.BO_STATUS_REASON_CD and F1_BUS_OBJ_STATUS_RSN_L.LANGUAGE_CD == 'ENG'" left="W1_ASSET" right="F1_BUS_OBJ_STATUS_RSN_L" type="leftOuter" weight="1"></join>
        <join expr="W1_ASSET.ASSET_COND_FLG == CI_LOOKUP_VAL_L.FIELD_VALUE and CI_LOOKUP_VAL_L.FIELD_NAME == 'ASSET_COND_FLG' and CI_LOOKUP_VAL_L.LANGUAGE_CD == 'ENG'" left="W1_ASSET" right="CI_LOOKUP_VAL_L" type="leftOuter" weight="1"></join>
        <join expr="W1_ASSET.SPECIFICATION_CD == W1_SPECIFICATION_L.SPECIFICATION_CD and W1_SPECIFICATION_L.LANGUAGE_CD == 'ENG'" left="W1_ASSET" right="W1_SPECIFICATION_L" type="leftOuter" weight="1"></join>
        <join expr="W1_ASSET.OWNING_ACCESS_GRP_CD == CI_ACC_GRP_L.ACCESS_GRP_CD and CI_ACC_GRP_L.LANGUAGE_CD == 'ENG'" left="W1_ASSET" right="CI_ACC_GRP_L" type="leftOuter" weight="1"></join>
        <join expr="W1_ASSET.MAINT_SPEC_CD == W1_SPECIFICATION_L_1.SPECIFICATION_CD and W1_SPECIFICATION_L_1.LANGUAGE_CD == 'ENG'" left="W1_ASSET" right="W1_SPECIFICATION_L_1" type="leftOuter" weight="1"></join>
        <join expr="W1_ASSET.ASSET_OWNERSHIP_FLG == CI_LOOKUP_VAL_L_1.FIELD_VALUE and CI_LOOKUP_VAL_L_1.FIELD_NAME == 'ASSET_OWNERSHIP_FLG' and CI_LOOKUP_VAL_L_1.LANGUAGE_CD == 'ENG'" left="W1_ASSET" right="CI_LOOKUP_VAL_L_1" type="leftOuter" weight="1"></join>
        <join expr="W1_ASSET.CONTRIBUTED_FLG == CI_LOOKUP_VAL_L_2.FIELD_VALUE and CI_LOOKUP_VAL_L_2.FIELD_NAME == 'CONTRIBUTED_FLG' and CI_LOOKUP_VAL_L_2.LANGUAGE_CD == 'ENG'" left="W1_ASSET" right="CI_LOOKUP_VAL_L_2" type="leftOuter" weight="1"></join>
        <join expr="W1_ASSET_NODE.FAILURE_FLG == CI_LOOKUP_VAL_L_4.FIELD_VALUE and CI_LOOKUP_VAL_L_4.FIELD_NAME == 'FAILURE_FLG' and CI_LOOKUP_VAL_L_4.LANGUAGE_CD == 'ENG'" left="W1_ASSET_NODE" right="CI_LOOKUP_VAL_L_4" type="leftOuter" weight="1"></join>
        <join expr="W1_ASSET_NODE.ASSET_DPOS_FLG == F1_EXT_LOOKUP_VAL_L.F1_EXT_LOOKUP_VALUE and F1_EXT_LOOKUP_VAL_L.BUS_OBJ_CD == 'W1-AssetDisposition' and F1_EXT_LOOKUP_VAL_L.LANGUAGE_CD == 'ENG'" left="W1_ASSET_NODE" right="F1_EXT_LOOKUP_VAL_L" type="inner" weight="1"></join>
        <join expr="W1_NODE.NODE_TYPE_CD == W1_NODE_TYPE_L.NODE_TYPE_CD and W1_NODE_TYPE_L.LANGUAGE_CD == 'ENG'" left="W1_NODE" right="W1_NODE_TYPE_L" type="inner" weight="1"></join>
        <join expr="W1_NODE.BUS_OBJ_CD == F1_BUS_OBJ_L_1.BUS_OBJ_CD and F1_BUS_OBJ_L_1.LANGUAGE_CD == 'ENG'" left="W1_NODE" right="F1_BUS_OBJ_L_1" type="inner" weight="1"></join>
        <join expr="W1_NODE.NODE_DPOS_FLG == CI_LOOKUP_VAL_L_3.FIELD_VALUE and CI_LOOKUP_VAL_L_3.FIELD_NAME == 'NODE_DPOS_FLG' and CI_LOOKUP_VAL_L_3.LANGUAGE_CD == 'ENG'" left="W1_NODE" right="CI_LOOKUP_VAL_L_3" type="inner" weight="1"></join>
        <join expr="W1_NODE.W1_OPERATION_FLG == CI_LOOKUP_VAL_L_5.FIELD_VALUE and CI_LOOKUP_VAL_L_5.FIELD_NAME == 'W1_OPERATION_FLG' and CI_LOOKUP_VAL_L_5.LANGUAGE_CD == 'ENG'" left="W1_NODE" right="CI_LOOKUP_VAL_L_5" type="leftOuter" weight="1"></join>
