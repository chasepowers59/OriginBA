    <jdbcQuery id="CM_FT_BAL" datasourceId="Origin_DEV_DS">
      <fieldList>
        <field id="SA_ID" type="java.lang.String"></field>
        <field id="CUR_AMT" type="java.math.BigDecimal"></field>
        <field id="TOT_AMT" type="java.math.BigDecimal"></field>
      </fieldList>
      <query>SELECT
  FT.SA_ID,
  SUM(FT.CUR_AMT) AS CUR_AMT,
  SUM(FT.TOT_AMT) AS TOT_AMT
FROM 
  CISADM.CI_FT FT
WHERE
  FT.REDUNDANT_SW = 'N' AND
  FT.FREEZE_SW = 'Y'
GROUP BY
  FT.SA_ID</query>
    </jdbcQuery>
