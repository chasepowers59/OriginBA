    <jdbcQuery id="CMS_COMPLETED_ACTIVITY_ID" datasourceId="Origin_DEV_DS">
      <fieldList>
        <field id="D1_ACTIVITY_ID" type="java.lang.String"></field>
      </fieldList>
      <query>SELECT DISTINCT D1_ACTIVITY_ID
 FROM CISADM.D1_ACTIVITY ACT ,
 CISADM.D1_ACTIVITY_TYPE ACTTYPE 
 WHERE ACT.ACTIVITY_TYPE_CD = ACTTYPE.ACTIVITY_TYPE_CD
 AND ACTIVITY_TYPE_CAT_FLG = 'D1FA'
 AND BO_STATUS_CD IN ('COMPLETED','DISCARDED')</query>
    </jdbcQuery>
