        <field id="CI_BATCH_CTRL_L.DESCRLONG" type="java.lang.String"></field>
        <field id="SCHEDULER_ID_DURATION_MINS" dataSetExpression="ElapsedMinutes(CI_BATCH_INST.END_DTTM, CI_BATCH_INST.START_DTTM)" type="java.math.BigDecimal"></field>
        <field id="BATCH_CD_DESCR" dataSetExpression="Concatenate(CI_BATCH_CTRL_L.BATCH_CD, ' (', CI_BATCH_CTRL_L.DESCR, ')')" type="java.lang.String"></field>
        <field id="SCHEDULER_ID_DISTINCT" dataSetExpression="CountDistinct(CI_BATCH_INST.SCHEDULER_ID, 'Current')" type="java.lang.Long"></field>
        <field id="SCHEDULER_ID_DURATION_HOURS" dataSetExpression="ElapsedHours(CI_BATCH_INST.END_DTTM, CI_BATCH_INST.START_DTTM)" type="java.math.BigDecimal"></field>
        <field id="BATCH_RUN_DISTINCT" dataSetExpression="CountDistinct(Concatenate(CI_BATCH_INST.BATCH_CD, '_', CI_BATCH_INST.BATCH_NBR), 'Current')" type="java.lang.Long"></field>
        <field id="BATCH_THREAD_DISTINCT" dataSetExpression="CountDistinct&#xA;(Concatenate(&#xA;CI_BATCH_INST.BATCH_CD, '_',CI_BATCH_INST.BATCH_NBR)&#xA;, '_', CI_BATCH_INST.BATCH_THREAD_NBR, 'Current')&#xA;" type="java.lang.Long"></field>
      </fieldList>
      <filterString>CI_LOOKUP_VAL_L.LANGUAGE_CD == 'ENG' and CI_BATCH_CTRL_L.LANGUAGE_CD == 'ENG' and CI_LOOKUP_VAL_L.FIELD_NAME == 'RUN_STATUS                    ' and CI_LOOKUP_VAL_L_1.FIELD_NAME == 'THREAD_STATUS                 ' and CI_LOOKUP_VAL_L_1.LANGUAGE_CD == 'ENG'</filterString>
      <joinInfo alias="CI_BATCH_INST" referenceId="CI_BATCH_INST"></joinInfo>
      <joinList>
        <join expr="CI_BATCH_INST.BATCH_CD == CI_BATCH_RUN.BATCH_CD and CI_BATCH_INST.BATCH_NBR == CI_BATCH_RUN.BATCH_NBR and CI_BATCH_INST.BATCH_RERUN_NBR == CI_BATCH_RUN.BATCH_RERUN_NBR" left="CI_BATCH_INST" right="CI_BATCH_RUN" type="inner" weight="1"></join>
        <join expr="CI_BATCH_INST.BATCH_CD == CI_BATCH_CTRL.BATCH_CD" left="CI_BATCH_INST" right="CI_BATCH_CTRL" type="inner" weight="1"></join>
