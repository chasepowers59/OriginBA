      <filterString>CI_LOOKUP_VAL_L.FIELD_NAME == 'WO_STATUS_FLG                 ' and CI_LOOKUP_VAL_L_1.FIELD_NAME == 'WO_STAT_RSN_FLG               '</filterString>
      <joinInfo alias="CI_WO_PROC" referenceId="CI_WO_PROC"></joinInfo>
      <joinList>
        <join expr="CI_WO_PROC.WO_PROC_ID == CI_WO_EVT.WO_PROC_ID" left="CI_WO_PROC" right="CI_WO_EVT" type="inner" weight="1"></join>
        <join expr="CI_WO_PROC.ACCT_ID == CI_ACCT.ACCT_ID" left="CI_WO_PROC" right="CI_ACCT" type="inner" weight="1"></join>
        <join expr="CI_ACCT.ACCT_ID == CI_ACCT_PER.ACCT_ID and CI_ACCT_PER.MAIN_CUST_SW == 'Y'" left="CI_ACCT" right="CI_ACCT_PER" type="inner" weight="1"></join>
        <join expr="CI_ACCT_PER.PER_ID == CI_PER_NAME.PER_ID and CI_PER_NAME.NAME_TYPE_FLG == 'PRIM'" left="CI_ACCT_PER" right="CI_PER_NAME" type="inner" weight="1"></join>
        <join expr="CI_WO_PROC.WO_PROC_TMPL_CD == CI_WO_PROC_TMPL_L.WO_PROC_TMPL_CD and CI_WO_PROC_TMPL_L.LANGUAGE_CD == 'ENG'" left="CI_WO_PROC" right="CI_WO_PROC_TMPL_L" type="inner" weight="1"></join>
        <join expr="CI_WO_PROC.WO_STATUS_FLG == CI_LOOKUP_VAL_L.FIELD_VALUE and CI_LOOKUP_VAL_L.FIELD_NAME == 'WO_STATUS_FLG' and CI_LOOKUP_VAL_L.LANGUAGE_CD == 'ENG'" left="CI_WO_PROC" right="CI_LOOKUP_VAL_L" type="inner" weight="1"></join>
        <join expr="CI_WO_PROC.WO_CNTL_CD == CI_WO_CNTL_L.WO_CNTL_CD and CI_WO_CNTL_L.LANGUAGE_CD == 'ENG'" left="CI_WO_PROC" right="CI_WO_CNTL_L" type="inner" weight="1"></join>
        <join expr="CI_WO_PROC.WO_STAT_RSN_FLG == CI_LOOKUP_VAL_L_1.FIELD_VALUE and CI_LOOKUP_VAL_L_1.FIELD_NAME == 'WO_STAT_RSN_FLG' and CI_LOOKUP_VAL_L_1.LANGUAGE_CD == 'ENG'" left="CI_WO_PROC" right="CI_LOOKUP_VAL_L_1" type="inner" weight="1"></join>
        <join expr="CI_WO_PROC.CRIT_PRIO_FLG == CI_LOOKUP_VAL_L_2.FIELD_VALUE and CI_LOOKUP_VAL_L_2.FIELD_NAME == 'CRIT_PRIO_FLG' and CI_LOOKUP_VAL_L_2.LANGUAGE_CD == 'ENG'" left="CI_WO_PROC" right="CI_LOOKUP_VAL_L_2" type="leftOuter" weight="1"></join>
        <join expr="CI_WO_EVT.WO_EVT_STAT_FLG == CI_LOOKUP_VAL_L_3.FIELD_VALUE and CI_LOOKUP_VAL_L_3.FIELD_NAME == 'WO_EVT_STAT_FLG' and CI_LOOKUP_VAL_L_3.LANGUAGE_CD == 'ENG'" left="CI_WO_EVT" right="CI_LOOKUP_VAL_L_3" type="inner" weight="1"></join>
        <join expr="CI_WO_EVT.WO_EVT_TYP_CD == CI_WO_EVT_TYP_L.WO_EVT_TYP_CD and CI_WO_EVT_TYP_L.LANGUAGE_CD == 'ENG'" left="CI_WO_EVT" right="CI_WO_EVT_TYP_L" type="inner" weight="1"></join>
        <join expr="CI_WO_EVT.WO_PROC_ID == CMS_IS_NEXT_WO_EVT.WO_PROC_ID and CI_WO_EVT.EVT_SEQ == CMS_IS_NEXT_WO_EVT.EVT_SEQ" left="CI_WO_EVT" right="CMS_IS_NEXT_WO_EVT" type="leftOuter" weight="1"></join>
        <join expr="CI_ACCT.BILL_CYC_CD == CI_BILL_CYC_L.BILL_CYC_CD and CI_BILL_CYC_L.LANGUAGE_CD == 'ENG'" left="CI_ACCT" right="CI_BILL_CYC_L" type="leftOuter" weight="1"></join>
        <join expr="CI_ACCT.ACCT_MGMT_GRP_CD == CI_ACCT_MGMT_GR_L.ACCT_MGMT_GRP_CD and CI_ACCT_MGMT_GR_L.LANGUAGE_CD == 'ENG'" left="CI_ACCT" right="CI_ACCT_MGMT_GR_L" type="leftOuter" weight="1"></join>
        <join expr="CI_ACCT.CUST_CL_CD == CI_CUST_CL_L.CUST_CL_CD and CI_CUST_CL_L.LANGUAGE_CD == 'ENG'" left="CI_ACCT" right="CI_CUST_CL_L" type="inner" weight="1"></join>
        <join expr="CI_ACCT.COLL_CL_CD == CI_COLL_CL_L.COLL_CL_CD and CI_COLL_CL_L.LANGUAGE_CD == 'ENG'" left="CI_ACCT" right="CI_COLL_CL_L" type="inner" weight="1"></join>
        <join expr="CI_ACCT.BUD_PLAN_CD == CI_BUD_PLAN_L.BUD_PLAN_CD and CI_BUD_PLAN_L.LANGUAGE_CD == 'ENG'" left="CI_ACCT" right="CI_BUD_PLAN_L" type="leftOuter" weight="1"></join>
        <join expr="CI_WO_PROC.WO_PROC_ID == CMS_WO_PROC_SA_ACTIVE.WO_PROC_ID" left="CI_WO_PROC" right="CMS_WO_PROC_SA_ACTIVE" type="leftOuter" weight="1"></join>
        <join expr="CI_WO_PROC.WO_PROC_ID == CMS_WO_PROC_SA_INACTIVE.WO_PROC_ID" left="CI_WO_PROC" right="CMS_WO_PROC_SA_INACTIVE" type="leftOuter" weight="1"></join>
      </joinList>
