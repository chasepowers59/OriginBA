        <field id="WO_PROC_ID" type="java.lang.String"></field>
        <field id="EVT_SEQ" type="java.math.BigDecimal"></field>
        <field id="IS_NEXT" type="java.lang.String"></field>
      </fieldList>
      <query>select 
  we.wo_proc_id
  ,min(we.evt_seq) as EVT_SEQ
  ,'Y' as IS_NEXT
from
  cisadm.ci_wo_evt we
where
  we.completion_dt is null
group by
  we.wo_proc_id</query>
    </jdbcQuery>
    <jdbcQuery id="CMS_WO_PROC_SA_ACTIVE" datasourceId="Origin_DEV_DS">
      <fieldList>
        <field id="WO_PROC_ID" type="java.lang.String"></field>
        <field id="ARS_AMT" type="java.math.BigDecimal"></field>
      </fieldList>
      <query>select 
  wps.wo_proc_id
  ,nvl(sum(wps.ars_amt),0) as ars_amt
from
  cisadm.ci_wo_proc_sa wps
where
  wps.wo_sa_stat_flg = '10'
group by
  wps.wo_proc_id</query>
    </jdbcQuery>
    <jdbcQuery id="CMS_WO_PROC_SA_INACTIVE" datasourceId="Origin_DEV_DS">
      <fieldList>
        <field id="WO_PROC_ID" type="java.lang.String"></field>
        <field id="ARS_AMT" type="java.math.BigDecimal"></field>
      </fieldList>
      <query>select 
  wps.wo_proc_id
  ,nvl(sum(wps.ars_amt),0) as ars_amt
from
  cisadm.ci_wo_proc_sa wps
where
  wps.wo_sa_stat_flg = '20'
group by
  wps.wo_proc_id</query>
    </jdbcQuery>
