        <join expr="CI_TNDR_CTL.USER_ID == SC_USER_1.USER_ID" left="CI_TNDR_CTL" right="SC_USER_1" type="leftOuter" weight="1"></join>
        <join expr="CI_TNDR_CTL.BALANCED_USER_ID == SC_USER.USER_ID" left="CI_TNDR_CTL" right="SC_USER" type="leftOuter" weight="1"></join>
        <join expr="CI_ACCT_PER.PER_ID == CI_PER_NAME.PER_ID and CI_PER_NAME.NAME_TYPE_FLG == 'PRIM' and CI_ACCT_PER.MAIN_CUST_SW == 'Y'" left="CI_ACCT_PER" right="CI_PER_NAME" type="inner" weight="1"></join>
