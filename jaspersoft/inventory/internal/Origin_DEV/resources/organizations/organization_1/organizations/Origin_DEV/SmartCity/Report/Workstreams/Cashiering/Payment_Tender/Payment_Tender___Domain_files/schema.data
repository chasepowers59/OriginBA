        <join expr="CI_PAY_TNDR.TNDR_CTL_ID == CI_TNDR_CTL.TNDR_CTL_ID" left="CI_PAY_TNDR" right="CI_TNDR_CTL" type="inner" weight="1"></join>
        <join expr="CI_TNDR_CTL.TNDR_SOURCE_CD == CI_TNDR_SRCE_L.TNDR_SOURCE_CD and CI_TNDR_SRCE_L.LANGUAGE_CD == 'ENG'" left="CI_TNDR_CTL" right="CI_TNDR_SRCE_L" type="inner" weight="1"></join>
