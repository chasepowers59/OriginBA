<?xml version="1.0" encoding="UTF-8"?>
<!-- DUMMY DATA in the shape the SmartCity letter pipeline really produces.
     The bilingual sewer service disconnection door tag. Every data element is EMPTY on purpose:
     the City's own artwork has ruled lines the service crew writes on at the door, so the
     template must render correctly with nothing merged. The record list is still the real one,
     so switching the tag to a merged tag later is a field binding, not a new extract.
     Verified against Ellensburg's own C1-LTPEX input files: the record node is
     /root/C1-LetterPrintRecord/letter, the *Details blocks are direct children of <letter>, and
     C1-SummaryLetterExtractRecord is a SIBLING of the letters at the end of the file.
     Which *Details blocks appear is the template's own extract record list in C2M (/lettertemplate).
     Replace this file with a real extract and only the field XPaths may need adjusting. -->
<root xmlns:xs="http://www.w3.org/2001/XMLSchema"><C1-LetterPrintRecord><customerContactId>1184900001</customerContactId><letter><customerContactDetails><personId>1184955501</personId><contactDate>2026-06-10</contactDate><contactTime>08.14.58</contactTime><contactClass>C&amp;C</contactClass><contactType>DOORTAG</contactType><letterTemplate>CIR-OD-DOORTAG</letterTemplate><letterDate>2026-06-10</letterDate></customerContactDetails><customerContactCharacteristics/><mailingInformationDetails><entityName1/><entityName2/><entityName3/><mailingCountry>USA</mailingCountry><mailingAddress1/><mailingAddress2/><mailingAddress3/><mailingAddress4/><mailingCity>Odessa</mailingCity><mailingNumber1/><mailingNumber2/><mailingHouseType/><mailingCounty>ECTOR</mailingCounty><mailingState>TX</mailingState><mailingPostal>79761</mailingPostal><geographicCode/><inCityLimit>Y</inCityLimit></mailingInformationDetails><personDetails/><personCharacteristics/><premiseDetails><premiseId/><premiseType>SFR</premiseType><cisDivision>OD</cisDivision><lifeSupportSensitiveLoad>N</lifeSupportSensitiveLoad><lifeSupportSensitiveLoadDescription/><country>USA</country><address1/><address2/><address3/><address4/><city>Odessa</city><number1/><number2/><houseType/><county>ECTOR</county><state>TX</state><postal>79761</postal><geographicCode/><inCityLimit>Y</inCityLimit></premiseDetails><premiseCharacteristics/><collectionDetails/><severanceDetails><severanceArrearsDate/><additionalEventDate/><address1/><city>Odessa</city><state>TX</state><postal>79761</postal><accountId/><amountStillOwed/><saType>WW-RES</saType><saTypeDescription>Residential Wastewater</saTypeDescription></severanceDetails><billDetails/><billCharacteristics/></letter></C1-LetterPrintRecord><C1-SummaryLetterExtractRecord><printerKey>0010</printerKey><batchCode>C1-LTPEX</batchCode><batchNumber>44</batchNumber><rerunNumber>0</rerunNumber><letterCount>1</letterCount><extractDateTime>2026-06-10-06.30.00</extractDateTime><ccIdStart>0000000000</ccIdStart><ccIdEnd>9999999999</ccIdEnd><threadNumber>1</threadNumber><numOfThreads>1</numOfThreads></C1-SummaryLetterExtractRecord></root>
