  <detail>
    <band height="126">
      <textField pattern="MMMM d, yyyy" isBlankWhenNull="true">
        <reportElement x="0" y="0" width="240" height="14" style="Base"/>
        <textFieldExpression><![CDATA[$F{letterDate}]]></textFieldExpression>
      </textField>
      <textField textAdjust="StretchHeight">
        <reportElement x="0" y="46" width="468" height="28" style="Body"/>
        <textElement markup="html"/>
        <textFieldExpression><![CDATA["RE:&nbsp;&nbsp;&nbsp;" + ($F{accountId} == null ? "" : $F{accountId}) + "<br/>"
          + ($F{serviceAddress} == null ? "" : $F{serviceAddress})]]></textFieldExpression>
      </textField>
      <textField>
        <reportElement x="0" y="104" width="468" height="14" style="Body"/>
        <textFieldExpression><![CDATA["Dear " + ($F{name1} == null || $F{name1}.trim().isEmpty() ? "Customer" : $F{name1})]]></textFieldExpression>
      </textField>
    </band>
    <band height="58">
      <textField textAdjust="StretchHeight">
        <reportElement x="0" y="0" width="468" height="54" style="Body"/>
        <textElement textAlignment="Justified" markup="html"><paragraph lineSpacing="Single"/></textElement>
        <textFieldExpression><![CDATA["It has come to the attention of the City of Odessa Billing and Collection Department that your "
          + "account for water, sewer, and/or trash service is now delinquent. It is our duty to inform you that we "
          + "are attempting to collect a debt, and any information obtained will be used for that purpose. We have "
          + "included pertinent information regarding the account below:"]]></textFieldExpression>
      </textField>
    </band>
    <band height="16">
      <staticText>
        <reportElement x="24" y="0" width="30" height="12" style="Base"/>
        <text><![CDATA[(1)]]></text>
      </staticText>
      <textField textAdjust="StretchHeight">
        <reportElement x="54" y="0" width="414" height="12" style="Body"/>
        <textElement markup="html"><paragraph lineSpacing="Single"/></textElement>
        <textFieldExpression><![CDATA["Amount of debt:&nbsp;&nbsp;" + $V{amountDue}]]></textFieldExpression>
      </textField>
    </band>
    <band height="16">
      <staticText>
        <reportElement x="24" y="0" width="30" height="12" style="Base"/>
        <text><![CDATA[(2)]]></text>
      </staticText>
      <textField textAdjust="StretchHeight">
        <reportElement x="54" y="0" width="414" height="12" style="Body"/>
        <textElement markup="html"><paragraph lineSpacing="Single"/></textElement>
        <textFieldExpression><![CDATA["Name of creditor to whom debt is owed:&nbsp;&nbsp;<b>City of Odessa</b>"]]></textFieldExpression>
      </textField>
    </band>
    <band height="16">
      <staticText>
        <reportElement x="24" y="0" width="30" height="12" style="Base"/>
        <text><![CDATA[(3)]]></text>
      </staticText>
      <textField textAdjust="StretchHeight">
        <reportElement x="54" y="0" width="414" height="12" style="Body"/>
        <textElement markup="html"><paragraph lineSpacing="Single"/></textElement>
        <textFieldExpression><![CDATA["You have <b>thirty (30) days after receipt of this notice</b> to dispute this debt or any portion of "
          + "this debt. If you do not dispute this debt or any portion of this debt within said thirty (30) days, "
          + "this debt will be assumed to be valid by the City."]]></textFieldExpression>
      </textField>
    </band>
    <band height="16">
      <staticText>
        <reportElement x="24" y="0" width="30" height="12" style="Base"/>
        <text><![CDATA[(4)]]></text>
      </staticText>
      <textField textAdjust="StretchHeight">
        <reportElement x="54" y="0" width="414" height="12" style="Body"/>
        <textElement markup="html"><paragraph lineSpacing="Single"/></textElement>
        <textFieldExpression><![CDATA["If you do notify the City of Odessa Billing and Collection Department <b>in writing within the "
          + "thirty-day period</b> that this debt, or any portion of this debt is disputed, the City will verify the "
          + "amount of this debt and send you a copy; or, if there is any judgment against you regarding this debt, "
          + "a copy of that judgment will be mailed to you by the City."]]></textFieldExpression>
      </textField>
    </band>
    <band height="28">
      <textField textAdjust="StretchHeight">
        <reportElement x="0" y="0" width="468" height="24" style="Body"/>
        <textElement textAlignment="Justified" markup="html"><paragraph lineSpacing="Single"/></textElement>
        <textFieldExpression><![CDATA["Please note that <b>if you do not</b> contact the City of Odessa Billing and Collection Department "
          + "<b>in writing within thirty (30) days after receipt of this notice</b> to dispute the amount of this debt "
          + "or satisfy this debt <b>within that same thirty (30) day period</b>, the City of Odessa will have no "
          + "alternative but to pursue legal action. In addition, the City of Odessa may collect reasonable "
          + "attorney's fees, pursuant to Chapter 38 of the Texas Civil Practice and Remedies Code and the Fair "
          + "Debt Collection Act."]]></textFieldExpression>
      </textField>
    </band>
    <band height="28">
      <textField textAdjust="StretchHeight">
        <reportElement x="0" y="0" width="468" height="24" style="Body"/>
        <textElement textAlignment="Justified" markup="html"><paragraph lineSpacing="Single"/></textElement>
        <textFieldExpression><![CDATA["It is City policy to notify an appropriate credit-reporting agency of any debts owed to the City of "
          + "Odessa. Such reporting may have already occurred. Any questions regarding your account may be "
          + "directed to Customer Service at (432) 335-3204. Payment can be made by mail to P. O. Box 4398, "
          + "Odessa, Texas 79760-4398, on-line at www.odessa-tx.gov, or in person at City Hall, located at "
          + "411 West 8<sup>th</sup> Street, Odessa, Texas."]]></textFieldExpression>
      </textField>
    </band>
    <band height="106">
      <staticText>
        <reportElement x="0" y="12" width="120" height="14" style="Base"/>
        <text><![CDATA[Sincerely,]]></text>
      </staticText>
