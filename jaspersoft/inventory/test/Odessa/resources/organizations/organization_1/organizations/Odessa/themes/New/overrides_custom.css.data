/* -------------------------------------------------------------------------------
    ABOUT CUSTOM OVERRIDES

    .overrides_custom css

    Place styles for simple UI customization in this file.

    This file is loaded after all other CSS, so selectors here will override
    rules in all other Jaspersoft css files.

    Using this file to customize your theme is the method most likely to
    preserve your customizations even if markup changes in future releases.

    Extensive customizations may be easier to implement by replacing one or
    more of the standard theme files in your custom theme folder.

    Future product releases may introduce new components. Styles for any new
    components will be in css files that you have overridden or replaced. Your
    theme will not have these new styles, so the new components may not display
    as desired until you add your own customizations for these components.

    All keyboard focus styles have been added to the section "ACCESSIBILITY
    FOCUS STYLES" below. If you wish to change these styles, simply uncomment
    and change the values to suit your needs.
   --------------------------------------------------------------------------------  */

/* GENERAL THEME */






/* ---------------------------- */
/*  ACCESSIBILITY FOCUS STYLES  */
/* ---------------------------- */
/*   1. Global Elements         */
/* ---------------------------- */
.menu.primaryNav .leaf.focus-visible .wrap,
.menu.primaryNav .node.focus-visible .wrap,
#metaLinks li.focus-visible:not(select) {
 /* Uncomment and change values to customize
    background-color: #0078bd; */
}

#globalSearch.control.searchLockup > .wrap > input[type=text]:focus,
#globalSearch .button.search.focus-visible,
#globalSearch .button.searchClear.focus-visible {
 /* Uncomment and change values to customize
    border: 1px solid #0098f0 !important;
    outline: 2px solid #0098f0 !important; */
}

#frameFooter #about a.focus-visible {
 /* Uncomment and change values to customize
    box-shadow:  0 -2px #bde7ff, 0 2px #0078bd; */
}

/* ---------------- */
/*   2. Buttons     */
/* ---------------- */
.action:focus-visible {
 /* Uncomment and change values to customize
    outline: 2px solid #666666; */
}

.action.primary:focus-visible,
.action.simple.focus-visible,
.toolbar > .list.buttonSet .leaf .focus-visible,
.button.search.focus-visible,
.button.searchClear.focus-visible {
 /* Uncomment and change values to customize
    outline: 2px solid #062e79; */
}

/* ----------------------------- */
/*   3. Controls and Inputs      */
/* ----------------------------- */
input[type="text"]:focus,
input[type="password"]:focus,
textarea:focus,
.control.combo > select.button:focus {
 /* Uncomment and change values to customize
    outline: 2px solid #062e79 !important; */
}

input[type="text"][readonly]:focus,
input[type="password"][readonly]:focus,
textarea[readonly]:focus {
 /* Uncomment and change values to customize
    outline-style: dotted !important; */
}

.control.switch .focus-visible + .wrap .track,
select.focus-visible,
input[type=checkbox].focus-visible,
input[type=radio].focus-visible,
#sortMode > .tab.selected:focus-visible:after,
#viewMode > .tab.selected.focus-visible:after {
 /* Uncomment and change values to customize
    outline: 2px solid #062e79; */
}

/* ---------------- */
/*   4. Menu        */
/* ---------------- */
.menu.vertical li > .wrap.over.focus-visible {
 /* Uncomment and change values to customize
    outline: 2px solid #062e79; */
}

/* ----------------------- */
/*   6. Text Elements      */
/* ----------------------- */
/* link */
a:focus-visible:not(.button) {
 /* Uncomment and change values to customize
    background-color: #bde7ff;
    box-shadow: 0 -2px #bde7ff, 0 2px #062e79;
    color: #062e79 !important;
    text-decoration: none; */
}

/* non-link text that requires focus */
.message.focus-visible {
 /* Uncomment and change values to customize
    background-color: #bde7ff;
    color: #212121;
    outline: 2px solid #062e79; */
}

/* ------------------------------- */
/*   7. Page & Dialog Specific     */
/* ------------------------------- */
/* Home Page */
.resourceBlock .buttonIconToggle:focus-visible,
.resourceBlock .buttonIconToggle.focus-visible,
.workflow-iconContainer .button.focus-visible {
 /* Uncomment and change values to customize
    outline: 2px solid #062e79; */
}

.workflowsBlock .focus-visible .workflow {
 /* Uncomment and change values to customize
    outline: 3px solid #062e79; */
}

/* Permissions Dialog */
.dialog.permissions .list.tabular .selected.subfocus > .wrap,
.dialog.permissions .list.tabular .focus-visible.subfocus:not(select) {
 /* Uncomment and change values to customize
    outline: 2px solid #062e79; */
}

.message.focus-visible {
 /* Uncomment and change values to customize
    background-color: #bde7ff;
    color: #212121;
    outline: 2px solid #062e79; */
}


/* ---------------------------------------------- */
/*   8. Library, Search, and Repository Pages     */
/* ---------------------------------------------- */
/* resource table rows and cells */
.list.tabular.resources .leaf.focus-visible > .wrap,
.list.tabular.resources .node.focus-visible > .wrap,
.list.tabular.resources .focus-visible.subfocus:not(li),
.list.tabular.resources .scheduled.selected > .wrap .scheduled.icon.focus-visible {
 /* Uncomment and change values to customize
    outline: 2px solid #062e79; */
}

/* Filter and Folder panel elements */
#repoBrowse .button.minimize.focus-visible,
#repoSearch .button.minimize.focus-visible,
#repoSearch .list.filters li.selected.subfocus.focus-visible > .wrap,
#filtersPanel .buttonIconToggle.focus-visible,
.folders .list > li.selected.focus-visible > .wrap,
.folders.selected.focus-visible > .wrap {
 /* Uncomment and change values to customize
    outline: 2px solid #062e79; */
}

/* ======================================================================
   OriginBA Stable v13 - conservative QA polish
   Built from the active SmartCity Analytics theme, not from stacked test CSS.
   Goals: keep Jasper layout behavior intact; brand only where safe.
   ====================================================================== */
:root {
    --origin-sapphire: #0078BD;
    --origin-blue: #3BAFE2;
    --origin-indigo: #1348AB;
    --origin-ink: #24313D;
    --origin-muted: #5E6A75;
    --origin-border: #D9E2EA;
    --origin-panel: #FFFFFF;
    --origin-page: #F4F7FA;
    --origin-selected: #DDEFF8;
}

html, body, input, select, textarea, button,
.banner, .menu, .panel, .column, .content, .list {
    font-family: source_sans_proregular, "Segoe UI", Verdana, Arial, sans-serif !important;
}

/* Header branding: simple, crisp, not bolded, no badge. */
.banner {
    background: linear-gradient(90deg, #0078BD 0%, #01529A 100%) !important;
    border-bottom: 1px solid #01529A !important;
    box-shadow: none !important;
}
#logo, .banner #logo, #frameHeader #logo {
    background-image: url(images/logo_reverse.svg) !important;
    background-repeat: no-repeat !important;
    background-position: left center !important;
    background-size: 158px 32px !important;
    width: 166px !important;
    height: 34px !important;
    margin: 0 18px 0 8px !important;
    padding: 0 !important;
    border: 0 !important;
    border-radius: 0 !important;
    box-shadow: none !important;
    background-color: transparent !important;
}
#logo:before, #logo:after,
.banner #logo:before, .banner #logo:after,
#frameHeader #logo:before, #frameHeader #logo:after {
    content: none !important;
    display: none !important;
}

/* Top nav: keep stock spacing/behavior, only normalize type and color. */
.menu.primaryNav .wrap,
.menu.primaryNav .wrap > .title,
.menu.primaryNav .node > .wrap,
.menu.primaryNav .node > .wrap > .title {
    font-family: source_sans_proregular, "Segoe UI", Verdana, Arial, sans-serif !important;
    font-weight: 500 !important;
    color: #FFFFFF !important;
}
.menu.primaryNav .wrap.over,
.menu.primaryNav .wrap.pressed {
    background-color: rgba(255,255,255,0.13) !important;
}

/* Global search: do not fight Jasper's layout. Just remove the broken white-panel effect. */
#globalSearch,
#globalSearch.control.searchLockup {
    background: transparent !important;
    border: 0 !important;
    box-shadow: none !important;
}
#globalSearch.control.searchLockup > .wrap,
#globalSearch.control.searchLockup > .right,
#globalSearch .button.search,
#globalSearch .button.searchClear {
    box-shadow: none !important;
}
#globalSearch.control.searchLockup > .wrap > input[type="text"] {
    font-family: source_sans_proregular, "Segoe UI", Verdana, Arial, sans-serif !important;
    color: #1F2933 !important;
}
#globalSearch.control.searchLockup > .wrap > input[type="text"]::placeholder {
    color: #64748B !important;
}

/* Page and panels: modern but restrained. */
body, #display, #frame, #mainContent {
    background: var(--origin-page) !important;
}
.column.decorated,
.panel, .jr-mPanel.jr,
.resourceBlock, .homeSidebar .section, .homeSidebar .pane {
    border-color: var(--origin-border) !important;
    box-shadow: 0 1px 3px rgba(16,42,67,0.06) !important;
}
.content .header > .title,
.resourceBlock-title,
.workflow-title,
.homeSidebar-title {
    color: var(--origin-ink) !important;
    font-weight: 500 !important;
}

/* Home page cards and buttons. */
.resourceBlock {
    border-radius: 6px !important;
    background: #FFFFFF !important;
}
.button.action.primary,
.button.action.primary.over,
.action.primary,
.jr-mButtonPrimary.jr {
    background-image: none !important;
    background-color: var(--origin-sapphire) !important;
    border-color: var(--origin-sapphire) !important;
    color: #FFFFFF !important;
    border-radius: 4px !important;
}
.button.action.primary.over,
.action.primary.over,
.jr-mButtonPrimary.jr:hover,
.jr-mButtonPrimary.jr-isHovered.jr {
    background-color: #01529A !important;
    border-color: #01529A !important;
}

/* Links and accents. */
a, a:link, a:visited,
.resourceName,
.resourceBlock a:link,
.resourceBlock a:visited,
.launcher,
.jr-mLinkTheme.jr {
    color: #0078BD !important;
}

/* Repository: preserve splitter/resize behavior. Only style colors. */
#repository #secondarySearchBox,
#repoBrowse, #repoSearch, #repoLibrary,
#resultsContainer, #resultsList,
.list.tabular, .list.resources {
    background: #FFFFFF !important;
}
.list.tabular.resources.header,
.list.tabular.jobs.header {
    background-color: #F8FAFC !important;
    border-bottom-color: #D9E2EA !important;
}
.list.tabular > li,
.list.resources > li {
    border-bottom-color: #E3E8EF !important;
}
.list > li.selected > .wrap,
.list > li.selected > .wrap.over,
.list.resources > li.selected,
.list.tabular > li.selected,
.jr-mTree-node.jr-isSelected.jr,
.jr-mTree-leaf.jr-isSelected.jr {
    background-color: var(--origin-selected) !important;
    color: var(--origin-ink) !important;
}
.list > li.selected > .wrap *,
.list.resources > li.selected *,
.list.tabular > li.selected * {
    color: var(--origin-ink) !important;
}
.list > li.selected a,
.list.resources > li.selected a,
.list.tabular > li.selected a {
    color: #01529A !important;
}

/* Sort controls: return to basic. No large boxes, no bright blue vertical focus bar. */
#sortMode, #viewMode,
#sortMode *, #viewMode * {
    box-shadow: none !important;
}
#sortMode .selected,
#sortMode .tab.selected,
#sortMode .button.selected,
#viewMode .selected,
#viewMode .tab.selected,
#viewMode .button.selected {
    background: #E9EEF3 !important;
    color: #263238 !important;
    border-color: #B8C3CE !important;
}
#sortMode *:focus,
#viewMode *:focus {
    outline: 1px solid #9FB0C0 !important;
    outline-offset: -1px !important;
}
#sortMode:before, #sortMode:after,
#viewMode:before, #viewMode:after,
#sortMode .selected:before, #sortMode .selected:after,
#viewMode .selected:before, #viewMode .selected:after {
    content: none !important;
    display: none !important;
}

/* Ad Hoc / report filters: selected values must be readable. */
.sList li.selected,
.sList li.active.selected,
.mSelect-svList > .selected .mSelect-svList-button,
.mSelect-svList > .active.selected .mSelect-svList-button,
.jr-mSelectlist-item.jr-isSelected.jr,
.jr-mSelectlist-item.jr-isSelected.jr-isHovered.jr,
.jr-mSelectlistSelected.jr > .jr-mSelectlist-item.jr {
    background-color: var(--origin-sapphire) !important;
    color: #FFFFFF !important;
}
.sList li.selected *,
.sList li.active.selected *,
.mSelect-svList > .selected .mSelect-svList-button *,
.mSelect-svList > .active.selected .mSelect-svList-button *,
.jr-mSelectlist-item.jr-isSelected.jr *,
.jr-mSelectlistSelected.jr > .jr-mSelectlist-item.jr * {
    color: #FFFFFF !important;
}
input, textarea, select,
.jr-mInput-text.jr,
.jr-mInput-search.jr,
.jr-mSelect.jr {
    background: #FFFFFF !important;
    color: #1F2933 !important;
    border-color: #AEB8C2 !important;
}

/* Login page: keep it clean; the theme cannot change server-side titles. */
#loginPage #copy {
    background: #F4F7FA !important;
}
#loginPage #loginForm {
    font-family: source_sans_proregular, "Segoe UI", Verdana, Arial, sans-serif !important;
}
#loginPage #loginForm fieldset label,
#loginPage #loginForm fieldset label .wrap {
    color: #0078BD !important;
    font-weight: 600 !important;
}
#loginPage .button.action.primary,
#loginPage #submitButton,
#loginPage input[type="submit"] {
    background-color: #0078BD !important;
    border-color: #0078BD !important;
    color: #FFFFFF !important;
}

/* Footer: remove Jasper text visually if it appears, but keep layout stable. */
#frameFooter {
    background-color: #0078BD !important;
    border-top: 1px solid #01529A !important;
}
#frameFooter #about a,
#frameFooter #copyright {
    color: #FFFFFF !important;
}
#frameFooter #about a {
    font-size: 0 !important;
}
#frameFooter #about a:after {
    content: "About OriginBA";
    font-size: 11px !important;
}


/* ======================================================================
   OriginBA Stable v14 - final QA corrections
   ====================================================================== */

/* Header: restore mark + crisp OriginBA text, no badge/white box. */
#logo, .banner #logo, #frameHeader #logo {
    background-image: url(images/logo_reverse.svg) !important;
    background-repeat: no-repeat !important;
    background-position: left center !important;
    background-size: 162px 32px !important;
    width: 170px !important;
    height: 34px !important;
    margin: 0 18px 0 8px !important;
    padding: 0 !important;
    border: 0 !important;
    border-radius: 0 !important;
    box-shadow: none !important;
    background-color: transparent !important;
}

/* Global search: keep native geometry, add a subtle visual placeholder until focused. */
#globalSearch.control.searchLockup {
    position: relative !important;
}
#globalSearch.control.searchLockup > .wrap {
    position: relative !important;
}
#globalSearch.control.searchLockup > .wrap:before {
    content: "Search";
    position: absolute;
    left: 10px;
    top: 50%;
    transform: translateY(-50%);
    font-family: source_sans_proregular, "Segoe UI", Verdana, Arial, sans-serif;
    font-size: 13px;
    font-weight: 400;
    color: #64748B;
    pointer-events: none;
    z-index: 1;
}
#globalSearch.control.searchLockup:focus-within > .wrap:before {
    display: none !important;
}
#globalSearch.control.searchLockup > .wrap > input[type="text"] {
    position: relative !important;
    z-index: 2 !important;
    background-color: transparent !important;
    font-family: source_sans_proregular, "Segoe UI", Verdana, Arial, sans-serif !important;
}
#globalSearch.control.searchLockup > .wrap > input[type="text"]:focus {
    background-color: #FFFFFF !important;
}

/* Make sure the repository splitter remains usable and visible but neutral. */
.sizer, .sizer.horizontal, .sizer.vertical,
.splitter, .splitter.horizontal, .splitter.vertical,
.ui-resizable-handle, .ui-resizable-e, .ui-resizable-w {
    opacity: 1 !important;
    pointer-events: auto !important;
}



/* ======================================================================
   OriginBA Stable v15 - search and empty-state corrections
   ====================================================================== */

/* Global search: restore a visible input box while keeping the CSS-only hint. */
#globalSearch.control.searchLockup {
    background: transparent !important;
    border: 0 !important;
    box-shadow: none !important;
    height: 28px !important;
}
#globalSearch.control.searchLockup > .wrap {
    position: relative !important;
    height: 28px !important;
    min-width: 210px !important;
    background: #FFFFFF !important;
    border: 1px solid #9FB0C0 !important;
    border-right: 0 !important;
    border-radius: 2px 0 0 2px !important;
    box-shadow: none !important;
    box-sizing: border-box !important;
}
#globalSearch.control.searchLockup > .right {
    height: 28px !important;
    width: 28px !important;
    background: #FFFFFF !important;
    border: 1px solid #9FB0C0 !important;
    border-left: 0 !important;
    border-radius: 0 2px 2px 0 !important;
    box-shadow: none !important;
    box-sizing: border-box !important;
}
#globalSearch .button.search,
#globalSearch .button.searchClear {
    height: 26px !important;
    width: 28px !important;
    border: 0 !important;
    background-color: transparent !important;
    box-shadow: none !important;
}
#globalSearch.control.searchLockup > .wrap:before {
    content: "Search";
    position: absolute;
    left: 10px;
    top: 50%;
    transform: translateY(-50%);
    font-family: source_sans_proregular, "Segoe UI", Verdana, Arial, sans-serif;
    font-size: 13px;
    font-weight: 400;
    color: #64748B;
    pointer-events: none;
    z-index: 1;
}
#globalSearch.control.searchLockup:focus-within > .wrap:before,
#globalSearch.control.searchLockup > .wrap.hasText:before {
    display: none !important;
}
#globalSearch.control.searchLockup > .wrap > input[type="text"] {
    position: relative !important;
    z-index: 2 !important;
    width: 100% !important;
    height: 26px !important;
    margin: 0 !important;
    padding: 2px 8px !important;
    background: transparent !important;
    border: 0 !important;
    color: #1F2933 !important;
    font-family: source_sans_proregular, "Segoe UI", Verdana, Arial, sans-serif !important;
    font-size: 13px !important;
    box-shadow: none !important;
    box-sizing: border-box !important;
}
#globalSearch.control.searchLockup > .wrap > input[type="text"]:focus {
    outline: none !important;
    background: transparent !important;
}
#globalSearch.control.searchLockup:focus-within > .wrap,
#globalSearch.control.searchLockup:focus-within > .right {
    border-color: #0078BD !important;
}
/* (v18.4) Kill Chrome's autofill highlight in the search field. Chrome paints
   a periwinkle #E8F0FE background on the input only (not the .right button
   area), which read as "blue fill + white notch". The inset shadow trick
   forces the field back to a clean white so the whole bar looks uniform. */
#globalSearch input[type="text"]:-webkit-autofill,
#globalSearch input[type="text"]:-webkit-autofill:hover,
#globalSearch input[type="text"]:-webkit-autofill:focus,
#globalSearch input[type="text"]:-webkit-autofill:active {
    -webkit-box-shadow: 0 0 0 1000px #FFFFFF inset !important;
    box-shadow: 0 0 0 1000px #FFFFFF inset !important;
    -webkit-text-fill-color: #1F2933 !important;
    caret-color: #1F2933 !important;
    transition: background-color 9999s ease-in-out 0s !important;
}

/* Repository empty state: center only the real empty-state element; do not force it visible. */
#resultsContainer,
#repoBrowse #resultsContainer,
#repoSearch #resultsContainer,
#repoLibrary #resultsContainer {
    position: relative !important;
}
#resultsContainer #nothingToDisplay,
#repoBrowse #resultsContainer #nothingToDisplay,
#repoSearch #resultsContainer #nothingToDisplay,
#repoLibrary #resultsContainer #nothingToDisplay {
    position: absolute !important;
    left: 50% !important;
    top: 50% !important;
    right: auto !important;
    bottom: auto !important;
    width: auto !important;
    min-width: 340px !important;
    max-width: 520px !important;
    margin: 0 !important;
    transform: translate(-50%, -50%) !important;
    text-align: center !important;
}
#resultsContainer #nothingToDisplay .message,
#repoBrowse #resultsContainer #nothingToDisplay .message,
#repoSearch #resultsContainer #nothingToDisplay .message,
#repoLibrary #resultsContainer #nothingToDisplay .message {
    max-width: 420px !important;
    min-width: 300px !important;
    margin: 0 auto !important;
    padding: 20px 28px !important;
    border: 1px solid #DDE4EC !important;
    border-radius: 8px !important;
    background: #FFFFFF !important;
    box-shadow: 0 1px 4px rgba(16,42,67,0.08) !important;
    color: #526173 !important;
    text-align: center !important;
}
#resultsContainer #nothingToDisplay .message-text,
#resultsContainer .nothingToDisplay .message-text {
    color: #526173 !important;
    font-family: source_sans_proregular, "Segoe UI", Verdana, Arial, sans-serif !important;
    font-weight: 400 !important;
    line-height: 1.4 !important;
}


/* ======================================================================
   OriginBA v15 filter/icon safety patch
   Purpose: preserve Jasper's icon fonts in Ad Hoc/Filter/Designer controls.
   Do NOT replace these with Aptos or Unicode; Edge is sensitive to this.
   ====================================================================== */
@font-face {
    font-family: "icons";
    src: url("jasper-ui/fonts/icons.eot");
    src: url("jasper-ui/fonts/icons.eot?#iefix") format("embedded-opentype"),
         url("jasper-ui/fonts/icons.woff") format("woff"),
         url("jasper-ui/fonts/icons.ttf") format("truetype"),
         url("jasper-ui/fonts/icons.svg#icons") format("svg");
    font-weight: normal;
    font-style: normal;
}
@font-face {
    font-family: "operators";
    src: url("fonts/operators.eot");
    src: url("fonts/operators.eot?#iefix") format("embedded-opentype"),
         url("fonts/operators.woff") format("woff"),
         url("fonts/operators.ttf") format("truetype"),
         url("fonts/operators.svg#operators") format("svg");
    font-weight: normal;
    font-style: normal;
}
.jr-mIcon,
.jr-mIcon.jr,
.jr-mIcon.mui,
.jr-mButton-icon.jr-mIcon,
.jr-mButton-icon.jr-mIcon.mui,
.jr-mButton-iconSmall.jr-mIcon,
.jr-mButton-iconSmall.jr-mIcon.mui,
.jr-mButton-iconSmaller.jr-mIcon,
.jr-mButton-iconSmallest.jr-mIcon,
span.jr-mIcon,
i.jr-mIcon,
[class*=" jr-mIcon"],
[class^="jr-mIcon"] {
    font-family: "icons" !important;
    font-weight: normal !important;
    font-style: normal !important;
    text-rendering: auto !important;
    -webkit-font-smoothing: antialiased !important;
    -moz-osx-font-smoothing: grayscale !important;
}
.jr-mIcon:before,
.jr-mButton-icon.jr-mIcon:before,
.jr-mButton-icon.jr-mIcon.mui:before,
.jr-mButton-iconSmall.jr-mIcon:before,
.jr-mButton-iconSmall.jr-mIcon.mui:before {
    font-family: "icons" !important;
    font-weight: normal !important;
    font-style: normal !important;
}
[class^="icon-"],
[class*=" icon-"] {
    font-family: "operators" !important;
    font-weight: normal !important;
    font-style: normal !important;
}

/* ======================================================================
   OriginBA top-right account/help/logout contrast fix
   Purpose: make header account links readable on blue banner.
   ====================================================================== */
#metaLinks,
#metaLinks li,
#metaLinks a,
#metaLinks a:link,
#metaLinks a:visited,
#metaLinks a:hover,
#metaLinks a:active,
.banner #metaLinks,
.banner #metaLinks li,
.banner #metaLinks a,
#frame #metaLinks a,
#header #metaLinks a,
#metaLinks #userID,
#metaLinks #help,
#metaLinks #logout {
    color: #FFFFFF !important;
}
#metaLinks a:hover,
#metaLinks a:focus,
#metaLinks li.over a,
#metaLinks li.pressed a {
    color: #FFFFFF !important;
    text-decoration: underline !important;
}


/* ======================================================================
   OriginBA v16 - Branded split-screen login + home branding (2026-08-12)
   Additive, theme-only, WCAG AA. Left brand panel (gradient + white logo
   + tagline) via #loginPage pseudo layers; login card floated into the
   white right zone. Collapses to a centered card under 860px.
   Uses existing images/logo_reverse.svg. No new image files.
   ====================================================================== */

/* --- LOGIN: replace stock photo; light right zone --- */
#loginPage {
    background: #F4F7FA !important;
    overflow: hidden !important;
}

/* Left brand panel: deep-blue gradient only (logo + tagline live on ::after). */
#loginPage::before {
    content: "";
    position: fixed;
    top: 0; left: 0;
    width: 42%; height: 100%;
    background: linear-gradient(160deg, #0A3A8C 0%, #062E79 55%, #01234F 100%);
    z-index: 1;
    pointer-events: none;
}

/* Logo + tagline as ONE centered block: logo sits in the top padding,
   tagline below it, and the whole block is centered in the blue panel
   both vertically and horizontally. Scales with the viewport. */
#loginPage::after {
    content: "Utility reporting, standardized.";
    position: fixed;
    left: 0; top: 50%;
    transform: translateY(-50%);
    width: 42%;
    box-sizing: border-box;
    padding: clamp(76px, 5.4vw, 112px) 40px 0;
    text-align: center;
    color: #BDE7FF;
    font-family: source_sans_proregular, "Segoe UI", Verdana, Arial, sans-serif;
    font-size: clamp(18px, 1.5vw, 26px); font-weight: 500; line-height: 1.4;
    background: url(images/logo_reverse.svg) no-repeat center top / clamp(280px, 22vw, 460px) auto;
    z-index: 2;
    pointer-events: none;
}

/* Hide stock welcome block that would collide with the panel */
#loginPage #welcome { display: none !important; }

/* Float the login card into the white right zone as an elevated card.
   position:fixed = anchored to viewport, robust regardless of DOM nesting. */
#loginPage .login {
    position: fixed !important;
    left: 71% !important;
    top: 50% !important;
    transform: translate(-50%, -50%) !important;
    margin: 0 !important;
    width: 360px !important;
    padding: 28px 28px 22px !important;
    background: #FFFFFF !important;
    border: 1px solid #D9E2EA !important;
    border-radius: 10px !important;
    box-shadow: 0 10px 30px rgba(6,46,121,0.14) !important;
    z-index: 3 !important;
}
#loginPage .login .header > .title {
    color: #062E79 !important;
    font-weight: 600 !important;
    font-size: 20px !important;
    margin-left: 0 !important;
}

/* Labels: Blue 700 on white = 7.9:1 AAA */
#loginPage #loginForm fieldset label,
#loginPage #loginForm fieldset label .wrap {
    color: #01529A !important;
    font-weight: 600 !important;
}

/* Copyright/copy band: subtle, bottom of the white right zone */
#loginPage #copy {
    background: transparent !important;
    top: auto !important; bottom: 18px !important;
    left: 42% !important; right: 0 !important; width: 58% !important;
    color: #64748B !important;
}

/* Top-right meta links readable over the blue panel */
#loginPage #metaLinks a { color: #FFFFFF !important; }

/* Responsive: under 860px collapse the split, center card on light bg */
@media (max-width: 860px) {
    #loginPage::before, #loginPage::after { display: none !important; }
    #loginPage .login { left: 50% !important; width: min(360px, 90vw) !important; }
    #loginPage #copy { left: 0 !important; width: 100% !important; text-align: center !important; }
}

/* --- HOME: branded section header bars + card accent --- */
#home_user .column.decorated.primary > .content > .header,
.column.decorated.home > .content > .header {
    background: linear-gradient(90deg, #062E79 0%, #01529A 100%) !important;
    border: 0 !important;
}
#home_user .column.decorated.primary > .content > .header > .title,
.column.decorated.home > .content > .header > .title {
    color: #FFFFFF !important;
    font-weight: 600 !important;
}
/* (v18) Removed the resource-card blue top accent - it rendered as unwanted
   blue bars on the Home sidebar sections. Cards keep their border + shadow. */


/* ======================================================================
   OriginBA v17 - Focus rings + dialog/table polish + toolbar (2026-08-12)
   Additive, WCAG AA. Activates the previously-commented focus outlines,
   brands dialog headers + list tables, and tints the dashboard toolbar.
   Icon fonts ("icons"/"operators") are never touched.
   ====================================================================== */

/* --- Keyboard focus rings (WCAG 2.4.7) - brand blue on light.
   (v18) Scoped to actual interactive CONTROLS only. The list-row, tree-node
   and resource-card selectors were removed because they rendered as a
   persistent blue bar under selected folders/rows, which read as clutter. --- */
a:focus-visible,
button:focus-visible,
input:focus-visible,
select:focus-visible,
textarea:focus-visible,
.button:focus-visible,
.action:focus-visible,
.button.action.primary:focus-visible {
    outline: 2px solid #0078BD !important;
    outline-offset: 2px !important;
    border-radius: 2px;
}
/* Focus on the blue banner/nav needs a light ring for contrast */
.menu.primaryNav .leaf.focus-visible .wrap,
.menu.primaryNav .node.focus-visible .wrap,
#metaLinks li.focus-visible:not(select),
#loginPage #metaLinks li.focus-visible:not(select) {
    outline: 2px solid #BDE7FF !important;
    outline-offset: 2px !important;
}
/* Text inputs: inset ring so it doesn't clip */
#globalSearch.control.searchLockup > .wrap > input[type="text"]:focus,
#loginPage #loginForm fieldset input:focus {
    outline: 2px solid #0078BD !important;
    outline-offset: 0 !important;
}

/* --- Dialog TITLE bars only (.header.mover) - brand navy, applied to every
   draggable overlay dialog so they all match (incl. the dashboard Filter
   Group, which was showing Jasper's default blue). (v18) Scoped to the
   .mover title bar so it NEVER bleeds into nested content headers - that
   bleed is what mis-colored the Data Chooser's left rail. --- */
.dialog .header.mover {
    background: linear-gradient(90deg, #062E79 0%, #01529A 100%) !important;
    border-bottom: 0 !important;
}
.dialog .header.mover .title {
    color: #FFFFFF !important;
    font-weight: 600 !important;
}
.dialog .header.mover .button.close,
.dialog .header.mover .close {
    filter: brightness(0) invert(1) !important;
}

/* --- Repository resources list ONLY: branded header + zebra rows.
   (v18) Scoped to .resources so it can't bleed into the Data Chooser,
   Ad Hoc designer, or filter lists (that broad bleed is what turned the
   Data Chooser rail blue). Zebra kept - confirmed good. --- */
.list.tabular.resources > .leaf > .header.wrap,
.list.tabular.resources .header.wrap {
    background: #EEF4FA !important;
    color: #062E79 !important;
    border-bottom: 1px solid #D9E2EA !important;
    font-weight: 600 !important;
}
.list.tabular.resources .leaf:nth-of-type(even) > .wrap {
    background: #F4F7FA !important;
}

/* --- Dashboard toolbar: (v18) reverted to stock. The tint + blue bottom
   edge read as "weird" against the dashboard chrome, so it's left native. --- */


/* ======================================================================
   OriginBA v18.1 - Login split-screen corrections (2026-08-12)
   The global header/footer branding was painting the login page's banner
   and footer, capping the clean blue/white split with full-width blue bars
   on top and bottom. Neutralize both on the login page ONLY.
   ====================================================================== */

/* Top banner: transparent -> blue left panel shows from the very top,
   right zone is clean white from the top (no full-width blue strip). */
#loginPage .banner,
#loginPage > .banner {
    background: transparent !important;
    background-color: transparent !important;
    border-bottom: 0 !important;
    box-shadow: none !important;
}
/* Meta links now sit over the white right zone -> dark, readable. */
#loginPage #metaLinks a,
#loginPage #metaLinks li {
    color: #01529A !important;
}

/* Bottom footer bar: hidden on the login splash only (covers footer as a
   sibling OR descendant of #loginPage, plus a modern :has() fallback). */
#loginPage ~ #frameFooter,
#loginPage + #frameFooter,
#loginPage #frameFooter,
body:has(#loginPage) #frameFooter {
    display: none !important;
}


/* ======================================================================
   OriginBA v18.5 - Data Chooser wizard step labels: fix blue-on-blue.
   Root cause: theme.css maps --jrs-theme-light/medium/dark ALL to brand
   blues, so Jasper's native step nav (which puts "light" text on "dark"
   boxes) renders blue-on-blue = invisible. Force readable contrast.
   Covers the modern vertical-tab component AND the legacy #flowControls nav.
   ====================================================================== */

/* Modern vertical-tab stepper (Ad Hoc Data Chooser) */
.jr-mTabVertical.jr .jr-mTab-item.jr {
    background-color: #EEF4FA !important;          /* inactive: light panel */
}
.jr-mTabVertical.jr .jr-mTab-item-label.jr {
    color: #062E79 !important;                     /* navy text on light box */
}
.jr-mTabVertical.jr .jr-mTab-item.jr-isActive.jr {
    background-color: #062E79 !important;          /* active: navy box */
}
.jr-mTabVertical.jr .jr-mTab-item.jr-isActive.jr .jr-mTab-item-label.jr {
    color: #FFFFFF !important;                      /* white on navy */
}
.jr-mTabVertical.jr .jr-mTab-item.jr:hover .jr-mTab-item-label.jr,
.jr-mTabVertical.jr .jr-mTab-item.jr-isHovered.jr .jr-mTab-item-label.jr {
    color: #01529A !important;
}

/* Legacy flow step nav (#flowControls): inactive light box + navy text;
   active/selected navy box + white text. Guarantees contrast either state. */
.flow #flowControls .step,
.flow #flowControls li,
.flow #flowControls .jr-mTab-item {
    background-color: #EEF4FA !important;
}
.flow #flowControls .step,
.flow #flowControls .step *,
.flow #flowControls li,
.flow #flowControls li *,
.flow #flowControls .jr-mTab-item-label {
    color: #062E79 !important;
}
.flow #flowControls .step.selected,
.flow #flowControls .step.active,
.flow #flowControls li.selected,
.flow #flowControls li.active,
.flow #flowControls .jr-mTab-item.jr-isActive {
    background-color: #062E79 !important;
}
.flow #flowControls .step.selected, .flow #flowControls .step.selected *,
.flow #flowControls .step.active,   .flow #flowControls .step.active *,
.flow #flowControls li.selected,    .flow #flowControls li.selected *,
.flow #flowControls li.active,      .flow #flowControls li.active *,
.flow #flowControls .jr-mTab-item.jr-isActive .jr-mTab-item-label {
    color: #FFFFFF !important;
}


/* ======================================================================
   ODESSA client theme - per-org overrides on the OriginBA v18.6 base.
   Color logo everywhere; on dark areas it sits on a white chip/card so the
   brand colors read (works for any client's color logo, no white version).
   ====================================================================== */

/* Header: bigger color Odessa logo on a white rounded chip (reads on navy) */
#logo, .banner #logo, #frameHeader #logo {
    background: #FFFFFF url(images/logo_reverse.svg) no-repeat center / auto 26px !important;
    border-radius: 6px !important;
    width: 104px !important;
    height: 36px !important;
    margin: 6px 18px 0 6px !important;
    padding: 0 !important;
    box-shadow: 0 1px 2px rgba(0,0,0,0.18) !important;
    background-color: #FFFFFF !important;
}
#logo:before, #logo:after,
.banner #logo:before, .banner #logo:after { content: none !important; display: none !important; }

/* Login panel: color logo on a centered white card, tagline below in navy */
#loginPage::after {
    content: "City of Odessa \00b7  Utility Reporting" !important;
    position: fixed !important;
    left: 21% !important;                 /* center of the 42% blue panel */
    top: 50% !important;
    transform: translate(-50%, -50%) !important;
    width: clamp(320px, 30vw, 480px) !important;
    background: #FFFFFF url(images/logo_reverse.svg) no-repeat center 34px / clamp(260px, 21vw, 410px) auto !important;
    color: #01529A !important;
    font-size: clamp(17px, 1.4vw, 22px) !important;
    font-weight: 600 !important;
    text-align: center !important;
    border-radius: 16px !important;
    padding: clamp(120px, 12vw, 175px) 28px 26px !important;
    box-shadow: 0 12px 34px rgba(0,0,0,0.28) !important;
    box-sizing: border-box !important;
}
