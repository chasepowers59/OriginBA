  <detail>
    <band height="214">
      <staticText>
        <reportElement x="0" y="0" width="468" height="24" style="Head"/>
        <textElement textAlignment="Center"/>
        <text><![CDATA[Sewer Service Disconnection Notice]]></text>
      </staticText>
      <textField textAdjust="StretchHeight">
        <reportElement x="0" y="34" width="468" height="44" style="Lede"/>
        <textElement markup="html"><paragraph lineSpacing="Single"/></textElement>
        <textFieldExpression><![CDATA["Pursuant to the authority and requirements contained in Article II of the &#8220;Water and Wastewater&#8221; Chapter of the City of Odessa Code, Sewer service will be disconnected at the location listed below."]]></textFieldExpression>
      </textField>
      <textField textAdjust="StretchHeight">
        <reportElement x="0" y="86" width="468" height="30" style="Body"/>
        <textElement textAlignment="Left" markup="html"><paragraph lineSpacing="Single"/></textElement>
        <textFieldExpression><![CDATA["You are hereby given notice that unless payment in full is made within <b>ten (10) days</b> from the date of this notice, the <b>Sewer service will be disconnected</b> without further notice."]]></textFieldExpression>
      </textField>
      <textField textAdjust="StretchHeight">
        <reportElement x="0" y="124" width="468" height="42" style="Body"/>
        <textElement textAlignment="Left" markup="html"><paragraph lineSpacing="Single"/></textElement>
        <textFieldExpression><![CDATA["If service is disconnected, no connection shall be made with the City system until payment for all amounts due has been received, including costs of disconnecting and reconnecting sewer service.&nbsp; Any unauthorized reconnection of Sewer service will result in criminal charges being filed and a $150.00 tampering fee."]]></textFieldExpression>
      </textField>
      <textField textAdjust="StretchHeight">
        <reportElement x="0" y="172" width="468" height="30" style="Body"/>
        <textElement textAlignment="Left" markup="html"><paragraph lineSpacing="Single"/></textElement>
        <textFieldExpression><![CDATA["Should you disagree with this notice, you may request a hearing within five (5) days from the date of this notice by contacting the Director of Billing and Collection at 411 W. 8<sup>th</sup> St. (432) 335-3210."]]></textFieldExpression>
      </textField>
    </band>
    <band height="252">
      <staticText>
        <reportElement x="0" y="0" width="468" height="24" style="Head"/>
        <textElement textAlignment="Center"/>
        <text><![CDATA[Notificación de Claúsura de Drenaje]]></text>
      </staticText>
      <textField textAdjust="StretchHeight">
        <reportElement x="0" y="34" width="468" height="44" style="Lede"/>
        <textElement markup="html"><paragraph lineSpacing="Single"/></textElement>
        <textFieldExpression><![CDATA["En conformidad con la autoridad de requisitos contenidos en el articulo II del capitulo de agua y drenaje del código de la ciudad de Odessa, su servicio de drenaje será clausurado en el lugar indicado."]]></textFieldExpression>
      </textField>
      <textField textAdjust="StretchHeight">
        <reportElement x="0" y="86" width="468" height="30" style="Body"/>
        <textElement textAlignment="Left" markup="html"><paragraph lineSpacing="Single"/></textElement>
        <textFieldExpression><![CDATA["Si no se ha recibido la cantidad de el pago completo en <b>diez (10) dias</b> de la fecha indicada en esta notificación, el <b>servicio sera clausurado</b> sin previo aviso."]]></textFieldExpression>
      </textField>
      <textField textAdjust="StretchHeight">
        <reportElement x="0" y="124" width="468" height="54" style="Body"/>
        <textElement textAlignment="Left" markup="html"><paragraph lineSpacing="Single"/></textElement>
        <textFieldExpression><![CDATA["Al ser el servicio clausurado, no habrá conección con el sistema de la ciudad, al menos que el pago sea recibido por la cantidad total é incluso con el costo de clausurar y de re-conectar el servicio del drenaje. Cualquier re-conección de drenaje hecha sin autorización resultará en cargos criminales, mas un costo de $150.00dlls por interferir."]]></textFieldExpression>
      </textField>
      <textField textAdjust="StretchHeight">
        <reportElement x="0" y="184" width="468" height="54" style="Body"/>
        <textElement textAlignment="Left" markup="html"><paragraph lineSpacing="Single"/></textElement>
        <textFieldExpression><![CDATA["Si usted cree que esta nota ha sido dada a usted injustamente, puede usted solicitar una cita en cinco (5) dias de la fecha indicada en esta notificación, hablando con la directora del departamento de &#8216;Billing and Collection&#8217;, ubicada en el primer piso de &#8216;City Hall&#8217;, 411 W. 8<sup>th</sup> St. (en la esquina de la calle 8 y Sam Houston)"]]></textFieldExpression>
      </textField>
    </band>
