      </textField>
    </band>
    <band height="60">
      <staticText>
        <reportElement x="0" y="0" width="46" height="13" style="Base"/>
        <text><![CDATA[RE:]]></text>
      </staticText>
      <textField textAdjust="StretchHeight">
        <reportElement x="46" y="0" width="422" height="42" style="Body"/>
        <textElement markup="html"><paragraph lineSpacing="Single"/></textElement>
        <textFieldExpression><![CDATA["Account #" + ($F{accountId} == null ? "" : $F{accountId}) + "<br/>"
          + "Service Address: " + ($F{serviceAddress} == null ? "" : $F{serviceAddress}) + "<br/>"
          + "Balance Due:&nbsp;&nbsp;" + $V{balanceDue}]]></textFieldExpression>
      </textField>
    </band>
    <band height="24">
      <staticText>
        <reportElement x="0" y="8" width="300" height="14" style="Base"/>
        <text><![CDATA[Dear Customer:]]></text>
      </staticText>
    </band>
    <band height="34">
      <textField textAdjust="StretchHeight">
        <reportElement x="0" y="0" width="468" height="28" style="Body"/>
        <textElement textAlignment="Left" markup="html"><paragraph lineSpacing="Single"/></textElement>
        <textFieldExpression><![CDATA["Our records indicate that your account is seriously PAST DUE.&nbsp; Our office has notified you of "
          + "this obligation with:"]]></textFieldExpression>
      </textField>
    </band>
    <band height="34">
      <staticText>
        <reportElement x="48" y="0" width="26" height="14" style="Base"/>
        <text><![CDATA[1.]]></text>
      </staticText>
      <textField textAdjust="StretchHeight">
        <reportElement x="74" y="0" width="394" height="28" style="Body"/>
        <textElement markup="html"><paragraph lineSpacing="Single"/></textElement>
        <textFieldExpression><![CDATA["account bills;"]]></textFieldExpression>
      </textField>
    </band>
    <band height="34">
      <staticText>
        <reportElement x="48" y="0" width="26" height="14" style="Base"/>
        <text><![CDATA[2.]]></text>
      </staticText>
      <textField textAdjust="StretchHeight">
        <reportElement x="74" y="0" width="394" height="28" style="Body"/>
        <textElement markup="html"><paragraph lineSpacing="Single"/></textElement>
        <textFieldExpression><![CDATA["delinquency notices; and"]]></textFieldExpression>
      </textField>
    </band>
    <band height="34">
      <staticText>
        <reportElement x="48" y="0" width="26" height="14" style="Base"/>
        <text><![CDATA[3.]]></text>
      </staticText>
      <textField textAdjust="StretchHeight">
        <reportElement x="74" y="0" width="394" height="28" style="Body"/>
        <textElement markup="html"><paragraph lineSpacing="Single"/></textElement>
        <textFieldExpression><![CDATA["a door tag advising you of the need to make payment at the risk of termination of service."]]></textFieldExpression>
      </textField>
    </band>
    <band height="76">
      <textField textAdjust="StretchHeight">
        <reportElement x="0" y="0" width="468" height="70" style="Body"/>
        <textElement textAlignment="Left" markup="html"><paragraph lineSpacing="Single"/></textElement>
        <textFieldExpression><![CDATA["The next step will be to refer your account to the City Attorney's office for collection of a debt "
          + "at which time legal fees will be assessed.&nbsp; In addition to any legal action, the City may interrupt "
          + "your sewer service by plugging the sewer and a fee of $200.00 will be charged to your account.&nbsp; An "
          + "<i>additional</i> fee of $200.00 will be assessed in order to have sewer service reconnected once it has "
          + "been plugged."]]></textFieldExpression>
      </textField>
    </band>
    <band height="64">
      <textField textAdjust="StretchHeight">
        <reportElement x="0" y="0" width="468" height="58" style="Body"/>
        <textElement textAlignment="Left" markup="html"><paragraph lineSpacing="Single"/></textElement>
        <textFieldExpression><![CDATA["Interruption of service is troublesome for everyone involved and is implemented only in extreme "
          + "cases.&nbsp; It is serious, time-consuming and expensive for both the City and our customers.&nbsp; Since "
          + "we are certain that you do not want this to occur, we strongly urge you to use whatever resources "
          + "available to you to promptly satisfy your obligation."]]></textFieldExpression>
      </textField>
    </band>
    <band height="80">
      <textField textAdjust="StretchHeight">
        <reportElement x="0" y="0" width="468" height="74" style="Body"/>
        <textElement textAlignment="Left" markup="html"><paragraph lineSpacing="Single"/></textElement>
        <textFieldExpression><![CDATA["Our office will delay referral of your account to the City Attorney's office for fourteen (14) days "
          + "from the date of this letter. If you will contact " + $P{SIGNED_BY} + ", " + $P{SIGNED_BY_TITLE}
          + " at 432-335-3204, within this fourteen (14) day period, our office will consider setting up a payment "
          + "plan for your account balance and delinquent fees.&nbsp; However, once your account is referred to the "
          + "City Attorney's office for collection of a debt, payment in full, including any legal fees and costs "
          + "assessed, will be required."]]></textFieldExpression>
      </textField>
    </band>
    <band height="48">
      <textField textAdjust="StretchHeight">
        <reportElement x="0" y="0" width="468" height="42" style="Body"/>
        <textElement textAlignment="Left" markup="html"><paragraph lineSpacing="Single"/></textElement>
        <textFieldExpression><![CDATA["Immediate attention to this matter will help ensure continued sewer service for this account.&nbsp; "
          + "Payment can be made by mail to Billing and Collection, P. O. Box 2552, Odessa, Texas 79760, on-line "
          + "at www.odessa-tx.gov, or in person at 411 West 8<sup>th</sup> Street, Odessa, Texas."]]></textFieldExpression>
      </textField>
    </band>
    <band height="104">
      <staticText>
        <reportElement x="0" y="14" width="120" height="14" style="Base"/>
        <text><![CDATA[Sincerely,]]></text>
      </staticText>
      <image scaleImage="RetainShape" isUsingCache="true" onErrorType="Blank" hAlign="Left">
