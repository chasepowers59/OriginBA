        <reportElement x="40" y="156" width="250" height="50" style="CityLine"/>
        <textElement markup="html"/>
        <textFieldExpression><![CDATA[$V{mailBlock}]]></textFieldExpression>
      </textField>
      <staticText>
        <reportElement x="330" y="148" width="200" height="10" style="Hint"/>
        <textElement><font size="7"/></textElement>
        <text><![CDATA[Promptly send to]]></text>
      </staticText>
      <line>
        <reportElement x="330" y="160" width="200" height="1" mode="Transparent"/>
        <graphicElement><pen lineWidth="0.7" lineColor="#C8CCD2"/></graphicElement>
      </line>
      <textField textAdjust="StretchHeight">
        <reportElement x="330" y="165" width="200" height="42" style="CityLine"/>
        <textElement markup="html"/>
        <textFieldExpression><![CDATA[$P{REMIT_TO}]]></textFieldExpression>
      </textField>
      <textField>
        <reportElement x="240" y="214" width="300" height="13" style="Scan"/>
        <textElement textAlignment="Right"/>
        <textFieldExpression><![CDATA[($F{accountId} == null ? "" : $F{accountId}) + String.format("%010d", $V{pastDue} == null ? 0 : $V{pastDue}.movePointRight(2).longValue())]]></textFieldExpression>
      </textField>
    </band>
  </detail>
</jasperReport>
