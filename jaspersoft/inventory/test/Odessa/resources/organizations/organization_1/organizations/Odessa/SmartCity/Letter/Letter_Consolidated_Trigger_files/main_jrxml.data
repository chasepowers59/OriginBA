<?xml version="1.0" encoding="UTF-8"?>
<!-- Bursting trigger: ONE PDF FOR THE WHOLE EXTRACT, named <LetterName>_<batchNumber>_<threadNumber>.
     Its query is the SUMMARY record, of which there is exactly one per file, so it schedules one job.

     JRXML 6.20, for JasperReports Server 8.1.0 PRO. UNLIKE THE LETTERS, this one has no generated
     7.x twin: the BurstingScriptlet class ships with JasperReports Server rather than with the
     JasperReports library, so it cannot be compiled or rendered outside the server and a converted
     copy would be an untested guess. At the 10.0 upgrade, open these two in Jaspersoft Studio 10
     and let it convert them, then re-point the letter report units at templates/ instead of
     templates/legacy/.

     One pair of triggers serves EVERY letter template. What varies is passed in:
       LetterName                       the report unit to run, e.g. Letter_CIR-OD-LATE
       net.sf.jasperreports.xml.source  the extract, handed straight to each child job
       ftp.*                            where the finished PDFs are delivered

     Set the ftp.* values on the scheduled job, never in the repository: ftp.password is a
     credential and a report unit's stored parameter defaults are readable by anyone who can open
     the report. -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="Letter-Consolidated-Trigger" pageWidth="595" pageHeight="842" whenNoDataType="AllSectionsNoDetail"
              columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
	<scriptlet name="bursting" class="com.jaspersoft.jasperreports.jrs.bursting.BurstingScriptlet">
		<property name="com.jaspersoft.jasperreports.jrs.bursting.result.variable" value="BurstedJob"/>
		<property name="com.jaspersoft.jasperreports.jrs.bursting.job.output.formats" value="PDF"/>
		<property name="com.jaspersoft.jasperreports.jrs.bursting.job.description" value="Letter-Consolidated-Trigger"/>
		<property name="com.jaspersoft.jasperreports.jrs.bursting.job.ftp.type" value="sftp"/>
		<property name="com.jaspersoft.jasperreports.jrs.bursting.job.repository.folder.uri" value="/SmartCity/Letter/export"/>
		<property name="com.jaspersoft.jasperreports.jrs.bursting.job.repository.timestamp.pattern" value="yyyy-MM-dd_HH.mm.ss"/>
		<property name="com.jaspersoft.jasperreports.jrs.bursting.job.repository.sequential.filenames_customSimpleMode" value="true"/>
		<propertyExpression name="com.jaspersoft.jasperreports.jrs.bursting.enabled"><![CDATA[true]]></propertyExpression>
		<propertyExpression name="com.jaspersoft.jasperreports.jrs.bursting.job.label"><![CDATA["Letter-Consolidated-Trigger"]]></propertyExpression>
		<propertyExpression name="com.jaspersoft.jasperreports.jrs.bursting.job.source.report.uri"><![CDATA["/SmartCity/Letter/"+$P{LetterName}]]></propertyExpression>
		<propertyExpression name="com.jaspersoft.jasperreports.jrs.bursting.job.source.parameter.net.sf.jasperreports.xml.source"><![CDATA[$P{net.sf.jasperreports.xml.source}]]></propertyExpression>
		<propertyExpression name="com.jaspersoft.jasperreports.jrs.bursting.job.base.output.filename"><![CDATA[$P{LetterName}+"_"+$F{batchNumber}+"_"+$F{threadNumber}]]></propertyExpression>
		<propertyExpression name="com.jaspersoft.jasperreports.jrs.bursting.job.alert.enabled"><![CDATA[false]]></propertyExpression>
		<propertyExpression name="com.jaspersoft.jasperreports.jrs.bursting.job.repository.overwrite.files"><![CDATA[true]]></propertyExpression>
		<propertyExpression name="com.jaspersoft.jasperreports.jrs.bursting.job.repository.save.to.repository"><![CDATA[false]]></propertyExpression>
		<propertyExpression name="com.jaspersoft.jasperreports.jrs.bursting.job.ftp.server.name"><![CDATA[$P{ftp.server.name}]]></propertyExpression>
		<propertyExpression name="com.jaspersoft.jasperreports.jrs.bursting.job.ftp.username"><![CDATA[$P{ftp.username}]]></propertyExpression>
		<propertyExpression name="com.jaspersoft.jasperreports.jrs.bursting.job.ftp.password"><![CDATA[$P{ftp.password}]]></propertyExpression>
		<propertyExpression name="com.jaspersoft.jasperreports.jrs.bursting.job.ftp.port"><![CDATA[$P{ftp.port}]]></propertyExpression>
		<propertyExpression name="com.jaspersoft.jasperreports.jrs.bursting.job.ftp.folder.path"><![CDATA[$P{ftp.folder.path}==null?"//":$P{ftp.folder.path}]]></propertyExpression>
	</scriptlet>
	<parameter name="net.sf.jasperreports.xml.source" class="java.lang.String"/>
	<parameter name="LetterName" class="java.lang.String"/>
	<parameter name="ftp.server.name" class="java.lang.String"/>
	<parameter name="ftp.folder.path" class="java.lang.String"/>
	<parameter name="ftp.password" class="java.lang.String"/>
	<parameter name="ftp.username" class="java.lang.String"/>
	<parameter name="ftp.port" class="java.lang.String"/>
	<queryString language="XPath">
		<![CDATA[/root/C1-SummaryLetterExtractRecord]]>
	</queryString>
	<field name="batchCode" class="java.lang.String">
		<property name="net.sf.jasperreports.xpath.field.expression" value="batchCode"/>
		<fieldDescription><![CDATA[batchCode]]></fieldDescription>
	</field>
	<field name="batchNumber" class="java.lang.String">
		<property name="net.sf.jasperreports.xpath.field.expression" value="batchNumber"/>
		<fieldDescription><![CDATA[batchNumber]]></fieldDescription>
	</field>
	<field name="rerunNumber" class="java.lang.String">
		<property name="net.sf.jasperreports.xpath.field.expression" value="rerunNumber"/>
		<fieldDescription><![CDATA[rerunNumber]]></fieldDescription>
	</field>
	<field name="letterCount" class="java.lang.String">
		<property name="net.sf.jasperreports.xpath.field.expression" value="letterCount"/>
		<fieldDescription><![CDATA[letterCount]]></fieldDescription>
	</field>
	<field name="extractDateTime" class="java.lang.String">
		<property name="net.sf.jasperreports.xpath.field.expression" value="extractDateTime"/>
		<fieldDescription><![CDATA[extractDateTime]]></fieldDescription>
	</field>
	<field name="ccIdStart" class="java.lang.String">
		<property name="net.sf.jasperreports.xpath.field.expression" value="ccIdStart"/>
		<fieldDescription><![CDATA[ccIdStart]]></fieldDescription>
	</field>
	<field name="ccIdEnd" class="java.lang.String">
		<property name="net.sf.jasperreports.xpath.field.expression" value="ccIdEnd"/>
		<fieldDescription><![CDATA[ccIdEnd]]></fieldDescription>
	</field>
	<field name="threadNumber" class="java.lang.String">
		<property name="net.sf.jasperreports.xpath.field.expression" value="threadNumber"/>
		<fieldDescription><![CDATA[threadNumber]]></fieldDescription>
	</field>
	<field name="numOfThreads" class="java.lang.String">
		<property name="net.sf.jasperreports.xpath.field.expression" value="numOfThreads"/>
		<fieldDescription><![CDATA[numOfThreads]]></fieldDescription>
	</field>
	<variable name="BurstedJob" class="com.jaspersoft.jasperserver.dto.job.ClientReportJob" calculation="System"/>
	<columnHeader>
		<band height="150">
			<staticText>
				<reportElement x="0" y="0" width="555" height="30"/>
				<textElement><font size="16" isBold="true"/></textElement>
				<text><![CDATA[Letter print, consolidated]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="40" width="200" height="20"/>
				<textElement><font size="11" isBold="true"/></textElement>
				<text><![CDATA[Letter template]]></text>
			</staticText>
			<textField isBlankWhenNull="true">
				<reportElement x="200" y="40" width="355" height="20"/>
				<textElement><font size="11"/></textElement>
				<textFieldExpression><![CDATA[$P{LetterName}]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement x="0" y="65" width="200" height="20"/>
				<textElement><font size="11" isBold="true"/></textElement>
				<text><![CDATA[Batch]]></text>
			</staticText>
			<textField isBlankWhenNull="true">
				<reportElement x="200" y="65" width="355" height="20"/>
				<textElement><font size="11"/></textElement>
				<textFieldExpression><![CDATA[$F{batchCode}+" "+$F{batchNumber}+" thread "+$F{threadNumber}+" of "+$F{numOfThreads}]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement x="0" y="90" width="200" height="20"/>
				<textElement><font size="11" isBold="true"/></textElement>
				<text><![CDATA[Letters in this extract]]></text>
			</staticText>
			<textField isBlankWhenNull="true">
				<reportElement x="200" y="90" width="355" height="20"/>
				<textElement><font size="11"/></textElement>
				<textFieldExpression><![CDATA[$F{letterCount}]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement x="0" y="115" width="200" height="20"/>
				<textElement><font size="11" isBold="true"/></textElement>
				<text><![CDATA[Extracted]]></text>
			</staticText>
			<textField isBlankWhenNull="true">
				<reportElement x="200" y="115" width="355" height="20"/>
				<textElement><font size="11"/></textElement>
				<textFieldExpression><![CDATA[$F{extractDateTime}]]></textFieldExpression>
			</textField>
		</band>
	</columnHeader>
</jasperReport>
