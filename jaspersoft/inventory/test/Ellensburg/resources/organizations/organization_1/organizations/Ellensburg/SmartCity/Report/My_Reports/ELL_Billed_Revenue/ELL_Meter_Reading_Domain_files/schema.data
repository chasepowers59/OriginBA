      <query>SELECT *
                   FROM   (SELECT SA.ACCT_ID,
                                  SASP1.SP_ID,
                                  SA.SA_ID,
                                  ROW_NUMBER()
                                    OVER (
                                      PARTITION BY SA.ACCT_ID
                                      ORDER BY SA.SA_ID DESC) RANK
                           FROM   CISADM.CI_SA_SP SASP1,
                                  CISADM.CI_SA SA
                           WHERE  SASP1.SA_ID = SA.SA_ID)
                   WHERE  RANK = 1</query>
    </jdbcQuery>
