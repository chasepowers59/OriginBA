        <field id="MSRMT_VAL10" type="java.math.BigDecimal"></field>
        <field id="BUS_OBJ_CD" type="java.lang.String"></field>
        <field id="CRE_DTTM" type="java.sql.Timestamp"></field>
        <field id="STATUS_UPD_DTTM" type="java.sql.Timestamp"></field>
        <field id="USER_EDITED_FLG" type="java.lang.String"></field>
        <field id="VERSION" type="java.math.BigDecimal"></field>
        <field id="LAST_UPDATE_DTTM" type="java.sql.Timestamp"></field>
        <field id="READING_VAL" type="java.math.BigDecimal"></field>
        <field id="COMBINED_MULTIPLIER" type="java.math.BigDecimal"></field>
        <field id="READING_COND_FLG" type="java.lang.String"></field>
      </fieldList>
      <query>SELECT MSR.*
FROM CISADM.D1_MSRMT MSR
 WHERE MSR.MSRMT_DTTM = (SELECT MAX(MSR1.MSRMT_DTTM)
                                       FROM   CISADM.D1_MSRMT MSR1
                                       WHERE
                     MSR1.MEASR_COMP_ID = MSR.MEASR_COMP_ID
                     AND MSR1.MSRMT_USE_FLG != 'D101'
                     AND TRUNC(MSR1.MSRMT_DTTM) &lt;= SYSDATE)</query>
    </jdbcQuery>
