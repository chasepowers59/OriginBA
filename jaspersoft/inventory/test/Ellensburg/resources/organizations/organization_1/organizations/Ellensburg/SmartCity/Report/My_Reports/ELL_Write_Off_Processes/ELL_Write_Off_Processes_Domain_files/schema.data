    <jdbcQuery id="WO_ARREARS" datasourceId="FondDuLac_DS">
      <fieldList>
        <field id="WO_PROC_ID" type="java.lang.String"></field>
        <field id="SUM_ARS_AMT_" fieldDBName="SUM(ARS_AMT)" type="java.math.BigDecimal"></field>
      </fieldList>
      <query>select WO_PROC_ID, sum(ars_AMT)  from cisadm.ci_wo_PROC_sa group by WO_PROC_ID</query>
    </jdbcQuery>
    <jdbcQuery id="Account_BAL" datasourceId="FondDuLac_DS">
      <fieldList>
        <field id="ACCT_ID" type="java.lang.String"></field>
        <field id="SUM_FT_CUR_AMT_" fieldDBName="SUM(FT.CUR_AMT)" type="java.math.BigDecimal"></field>
        <field id="SUM_FT_TOT_AMT_" fieldDBName="SUM(FT.TOT_AMT)" type="java.math.BigDecimal"></field>
      </fieldList>
      <query>select ac.acct_id, sum(ft.cur_amt),sum(ft.tot_amt) from cisadm.ci_acct ac, cisadm.ci_sa sa, cisadm.ci_ft ft 
where 
ac.acct_id = sa.acct_id and sa.sa_id = ft.sa_id and ft.not_in_ars_sw = 'N' and ft.freeze_sw = 'Y' and ft.redundant_sw='Y' group by ac.acct_id</query>
    </jdbcQuery>
    <jdbcQuery id="WO_PROC_SA_BAL" datasourceId="FondDuLac_DS">
      <fieldList>
        <field id="WO_PROC_ID" type="java.lang.String"></field>
        <field id="AMT" type="java.math.BigDecimal"></field>
        <field id="PAYMENTS" type="java.math.BigDecimal"></field>
        <field id="PAAMT" type="java.math.BigDecimal"></field>
        <field id="RUNNINGARS" type="java.math.BigDecimal"></field>
      </fieldList>
      <query>select c.wo_proc_id, (select Sum(sa.ars_amt) from cisadm.ci_wo_proc_sa sa where c.wo_proc_id = sa.wo_proc_id group by sa.wo_proc_id) amt 
       , (NVL((SELECT SUM(PAY.PAY_AMT) from CISADM.CI_PAY PAY where PAY.ACCT_ID = C.ACCT_ID and PAY.ILM_DT &gt;= c.CRE_DTTM and PAY.PAY_STATUS_FLG = '50'),0)) payments
       , (NVL((select sum(ftpa.cur_amt) from cisadm.ci_ft ftpa where ftpa.sa_id in (select sapa.sa_id from cisadm.ci_sa sapa where sapa.acct_id = C.ACCT_ID 
            and sapa.sa_type_cd = 'PA' and sapa.sa_status_flg in ('10','20','30','40')) and ftpa.not_in_ars_sw = 'N'),0)) paamt
       , (NVL((select Sum(sa.ars_amt) from cisadm.ci_wo_proc_sa sa where c.wo_proc_id = sa.wo_proc_id group by sa.wo_proc_id) ,0)) - 
       (NVL((SELECT SUM(PAY.PAY_AMT) from CISADM.CI_PAY PAY where PAY.ACCT_ID = C.ACCT_ID and PAY.ILM_DT &gt;= c.CRE_DTTM and PAY.PAY_STATUS_FLG = '50'),0)) +
        (NVL((select sum(ftpa.cur_amt) from cisadm.ci_ft ftpa where ftpa.sa_id in (select sapa.sa_id from cisadm.ci_sa sapa where sapa.acct_id = C.ACCT_ID 
            and sapa.sa_type_cd = 'PA' and sapa.sa_status_flg in ('10','20','30','40')) and ftpa.not_in_ars_sw = 'N'),0)) as runningars
       from CISADM.ci_wo_proc c</query>
    </jdbcQuery>
    <jdbcQuery id="CUST_NAME" datasourceId="FondDuLac_DS">
      <fieldList>
        <field id="ACCT_ID" type="java.lang.String"></field>
        <field id="PER_ID" type="java.lang.String"></field>
        <field id="ENTITY_NAME_UPR" type="java.lang.String"></field>
      </fieldList>
      <query>select a.Acct_id,a.per_id, b.entity_name_upr from cisadm.ci_acct_per a, cisadm.ci_per_name b where a.main_cust_sw = 'Y' and a.per_id = b.per_id and b.name_type_flg = 'PRIM' and b.prim_name_sw = 'Y'</query>
    </jdbcQuery>
    <jdbcQuery id="WO_SA_PREM" datasourceId="FondDuLac_DS">
      <fieldList>
        <field id="WO_PROC_ID" type="java.lang.String"></field>
        <field id="SA_ID" type="java.lang.String"></field>
        <field id="ARS_AMT" type="java.math.BigDecimal"></field>
        <field id="SVC_ADD" type="java.lang.String"></field>
        <field id="SA_TYPE_CD" type="java.lang.String"></field>
        <field id="DST_ID" type="java.lang.String"></field>
        <field id="GL_ACCT" type="java.lang.String"></field>
      </fieldList>
      <query>select a.wo_proc_id, a.sa_id, a.ars_amt, NVL((select c.address1 from cisadm.ci_prem c where c.prem_id = b.char_prem_id),' ') as SVC_ADD , b.sa_type_cd, c.dst_id,
    NVL((select d.GL_ACCT from cisadm.ci_dst_code_eff d where d.dst_id = c.dst_id and d.effdt = (select max(e.effdt) from cisadm.ci_dst_code_eff e where e.dst_id = d.dst_id)),' ') as GL_ACCT
from cisadm.ci_wo_proc_sa a, cisadm.ci_sa b, cisadm.ci_sa_type c where a.sa_id = b.sa_id and b.sa_type_cd = c.sa_type_cd</query>
    </jdbcQuery>
