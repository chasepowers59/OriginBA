					<paragraph lineSpacing="1_1_2"/>
				</textElement>
				<textFieldExpression><![CDATA["Please make checks payable to:"]]></textFieldExpression>
			</textField>
			<textField textAdjust="StretchHeight">
				<reportElement x="180" y="0" width="392" height="60" uuid="7297581c-2ff7-41be-8115-f4ed939edfeb">
