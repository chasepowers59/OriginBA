			<frame>
				<reportElement x="0" y="0" width="572" height="60" uuid="74b851a6-3e32-4786-90d4-2334cdaa2287"/>
				<textField textAdjust="StretchHeight">
					<reportElement stretchType="RelativeToBandHeight" x="0" y="0" width="572" height="60" uuid="95d0e317-8ea0-48bb-ba9e-992431a4ad6e">
						<property name="com.jaspersoft.studio.unit.height" value="px"/>
						<property name="com.jaspersoft.studio.unit.y" value="px"/>
					</reportElement>
					<box topPadding="2" leftPadding="10" bottomPadding="2" rightPadding="10">
						<pen lineWidth="1.0" lineStyle="Dotted"/>
						<topPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
						<leftPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
						<bottomPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
						<rightPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					</box>
					<textElement textAlignment="Justified" verticalAlignment="Top" markup="html">
						<font fontName="SansSerif" size="10"/>
						<paragraph lineSpacing="1_1_2"/>
					</textElement>
					<textFieldExpression><![CDATA["Dear Customer,<br />"+

"This is a reminder that your account is past due for the amount noted above.  As a result, a $10 late fee has been charged to your account.  This letter is being sent to you as a courtesy, to provide you with the opportunity to bring the account current.  We must receive the full past due amount on or before the due date to avoid removing the account from the budget payment plan.<br />"+

"If removed from the budget payment plan, the account will go into a past due status and be subject to our normal collections process.  There would be a six-month period of on-time payment history required before the account would be eligible to be on the budget payment plan again.<br />"+

"We accept payment by cash, check and electronic payments by card and check (fees associated with electronic payments). For phone payments, please call us at (509) 962-7201 or toll free (855) 529-2439 or you can pay online at www.ellensburgwa.gov and select the Pay Utility Bill option. If you have any questions or would like to make payment arrangements, please call us at (509) 962-7201. Thank you for your immediate attention to this matter. If payment has been made, thank you for your payment and please disregard this notice."]]></textFieldExpression>
				</textField>
			</frame>
		</band>
		<band height="60">
			<textField textAdjust="StretchHeight">
				<reportElement x="0" y="0" width="180" height="20" uuid="a2fbb4ab-3e6b-48b3-b6d1-99cb2b94bad5">
