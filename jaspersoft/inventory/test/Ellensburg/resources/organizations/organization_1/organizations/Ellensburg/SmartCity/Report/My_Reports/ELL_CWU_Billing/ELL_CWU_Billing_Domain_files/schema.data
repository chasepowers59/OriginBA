    <jdbcQuery id="ELL_DEVICE_DETAILS" datasourceId="Ellensburg_DS">
      <fieldList>
        <field id="SA_ID" type="java.lang.String"></field>
        <field id="D1_DEVICE_ID" type="java.lang.String"></field>
        <field id="SERIAL_NBR" type="java.lang.String"></field>
        <field id="BADGE_NBR" type="java.lang.String"></field>
      </fieldList>
      <query>SELECT Unique(DI2.ID_VALUE) AS BADGE_NBR, 
       SASP.SA_ID, 
--       SASP.SP_ID, 
--       SPID.D1_SP_ID, 
--       IE.DEVICE_CONFIG_ID, 
       DI.D1_DEVICE_ID, 
       DI.ID_VALUE AS SERIAL_NBR

FROM   CISADM.CI_SA_SP SASP,
       CISADM.D1_SP_IDENTIFIER SPID,
       CISADM.D1_INSTALL_EVT IE,
       CISADM.D1_DVC_CFG DC,
       CISADM.D1_DVC_IDENTIFIER DI,
       CISADM.D1_DVC_IDENTIFIER DI2
WHERE
SASP.SP_ID = SPID.ID_VALUE
AND SPID.SP_ID_TYPE_FLG = 'D1EI'
AND SPID.D1_SP_ID = IE.D1_SP_ID
AND IE.DEVICE_CONFIG_ID = DC.DEVICE_CONFIG_ID
AND IE.D1_REMOVAL_DTTM is null
AND DC.D1_DEVICE_ID = DI.D1_DEVICE_ID
AND DI.DVC_ID_TYPE_FLG = 'D1SN'
AND DC.D1_DEVICE_ID = DI2.D1_DEVICE_ID
AND DI2.DVC_ID_TYPE_FLG = 'D1BN'</query>
    </jdbcQuery>
    <jdbcQuery id="ELL_UNIT_RATE" datasourceId="Ellensburg_DS">
      <fieldList>
        <field id="CALC_GRP_CD" type="java.lang.String"></field>
        <field id="CALC_RULE_CD" type="java.lang.String"></field>
        <field id="CR_EXEC_SEQ" type="java.math.BigDecimal"></field>
        <field id="UNIT_RATE" type="java.math.BigDecimal"></field>
        <field id="CHAR_VAL" type="java.lang.String"></field>
        <field id="CHAR_TYPE_CD" type="java.lang.String"></field>
        <field id="EFFDT" type="java.sql.Timestamp"></field>
      </fieldList>
      <query>select CALC_GRP_CD,CALC_RULE_CD,CR_EXEC_SEQ,UNIT_RATE,CHAR_VAL,CHAR_TYPE_CD,EFFDT from  (SELECT 
    VD.CALC_GRP_CD, VD.CALC_RULE_CD, VD.CR_EXEC_SEQ, CAST(VD.VAL AS FLOAT) AS UNIT_RATE, '        ' AS CHAR_TYPE_CD,'                ' AS CHAR_VAL, TRUNC(SYSDATE) EFFDT
FROM (SELECT
       CR.CALC_GRP_CD, CR.CALC_RULE_CD, CR.CR_EXEC_SEQ,
       EXTRACTVALUE(VALUE(VALUEDETAILS), '/valueDetails/valueType') AS VALUE_TYPE,
       EXTRACTVALUE(VALUE(VALUEDETAILS), '/valueDetails/value') AS VAL,
       EXTRACTVALUE(VALUE(VALUEDETAILS), '/valueDetails/valueSource') AS VAL_SRC
    FROM
        CISADM.C1_CALC_RULE CR,
        TABLE(XMLSEQUENCE(EXTRACT(XMLPARSE(CONTENT CR.BO_DATA_AREA WELLFORMED), '/valueDetails'))) VALUEDETAILS
       WHERE EXTRACTVALUE(VALUE(VALUEDETAILS), '/valueDetails/valueSource') = 'C1VL' 
    ) VD
WHERE VD.VALUE_TYPE = 'U'
UNION
SELECT 
    VD.CALC_GRP_CD, VD.CALC_RULE_CD, VD.CR_EXEC_SEQ, BFV.VAL AS UNIT_RATE, 
     BFV.CHAR_TYPE_CD 
    AS CHAR_TYPE_CD, 
    BFV.CHAR_VAL
     AS CHAR_VAL,
    BFV.EFFDT
FROM (SELECT
       CR.CALC_GRP_CD, CR.CALC_RULE_CD, CR.CR_EXEC_SEQ, CR.BF_CD,
       EXTRACTVALUE(VALUE(VALUEDETAILS), '/valueDetails/valueType') AS VALUE_TYPE,
       EXTRACTVALUE(VALUE(VALUEDETAILS), '/valueDetails/value') AS VAL,
       EXTRACTVALUE(VALUE(VALUEDETAILS), '/valueDetails/valueSource') AS VAL_SRC
    FROM
        CISADM.C1_CALC_RULE CR,
        TABLE(XMLSEQUENCE(EXTRACT(XMLPARSE(CONTENT CR.BO_DATA_AREA WELLFORMED), '/valueDetails'))) VALUEDETAILS
       WHERE EXTRACTVALUE(VALUE(VALUEDETAILS), '/valueDetails/valueSource') = 'C1BF' 
    ) VD
    LEFT JOIN CISADM.CI_BF_VAL BFV ON BFV.BF_CD = VD.BF_CD
WHERE VD.VALUE_TYPE = 'U') a where a.effdt = (select max(b.effdt) from (SELECT 
    VD.CALC_GRP_CD, VD.CALC_RULE_CD, VD.CR_EXEC_SEQ, CAST(VD.VAL AS FLOAT) AS UNIT_RATE, '        ' AS CHAR_TYPE_CD,'                ' AS CHAR_VAL, TRUNC(SYSDATE) EFFDT
FROM (SELECT
       CR.CALC_GRP_CD, CR.CALC_RULE_CD, CR.CR_EXEC_SEQ,
       EXTRACTVALUE(VALUE(VALUEDETAILS), '/valueDetails/valueType') AS VALUE_TYPE,
       EXTRACTVALUE(VALUE(VALUEDETAILS), '/valueDetails/value') AS VAL,
       EXTRACTVALUE(VALUE(VALUEDETAILS), '/valueDetails/valueSource') AS VAL_SRC
    FROM
        CISADM.C1_CALC_RULE CR,
        TABLE(XMLSEQUENCE(EXTRACT(XMLPARSE(CONTENT CR.BO_DATA_AREA WELLFORMED), '/valueDetails'))) VALUEDETAILS
       WHERE EXTRACTVALUE(VALUE(VALUEDETAILS), '/valueDetails/valueSource') = 'C1VL' 
    ) VD
WHERE VD.VALUE_TYPE = 'U'
UNION
SELECT 
    VD.CALC_GRP_CD, VD.CALC_RULE_CD, VD.CR_EXEC_SEQ, BFV.VAL AS UNIT_RATE, 
     BFV.CHAR_TYPE_CD 
    AS CHAR_TYPE_CD, 
    BFV.CHAR_VAL
     AS CHAR_VAL,
    BFV.EFFDT
FROM (SELECT
       CR.CALC_GRP_CD, CR.CALC_RULE_CD, CR.CR_EXEC_SEQ, CR.BF_CD,
       EXTRACTVALUE(VALUE(VALUEDETAILS), '/valueDetails/valueType') AS VALUE_TYPE,
       EXTRACTVALUE(VALUE(VALUEDETAILS), '/valueDetails/value') AS VAL,
       EXTRACTVALUE(VALUE(VALUEDETAILS), '/valueDetails/valueSource') AS VAL_SRC
    FROM
        CISADM.C1_CALC_RULE CR,
        TABLE(XMLSEQUENCE(EXTRACT(XMLPARSE(CONTENT CR.BO_DATA_AREA WELLFORMED), '/valueDetails'))) VALUEDETAILS
       WHERE EXTRACTVALUE(VALUE(VALUEDETAILS), '/valueDetails/valueSource') = 'C1BF' 
    ) VD
    LEFT JOIN CISADM.CI_BF_VAL BFV ON BFV.BF_CD = VD.BF_CD
WHERE VD.VALUE_TYPE = 'U') b where b.calc_grp_cd = a.calc_grp_cd and a.calc_rule_cd = b.calc_rule_cd and b.cr_exec_seq = a.cr_exec_seq and  b.effdt&lt;=SYSDATE)</query>
    </jdbcQuery>
    <jdbcQuery id="ELL_CHARGE_TYPE" datasourceId="Ellensburg_DS">
      <fieldList>
        <field id="CALC_GRP_CD" type="java.lang.String"></field>
        <field id="CALC_RULE_CD" type="java.lang.String"></field>
        <field id="CHAR_TYPE_CD" type="java.lang.String"></field>
        <field id="CHAR_VAL" type="java.lang.String"></field>
        <field id="CHAR_VAL_DESC" type="java.lang.String"></field>
      </fieldList>
      <query>SELECT CRC.CALC_GRP_CD, CRC.CALC_RULE_CD, CRC.CHAR_TYPE_CD, CRC.CHAR_VAL, CVL.DESCR AS CHAR_VAL_DESC
FROM CISADM.C1_CALC_RULE_CHAR CRC, CISADM.CI_CHAR_VAL_L CVL
WHERE CRC.CHAR_TYPE_CD = 'CHGTYPE'
AND CVL.CHAR_TYPE_CD = CRC.CHAR_TYPE_CD
AND CVL.CHAR_VAL = CRC.CHAR_VAL</query>
    </jdbcQuery>
    <jdbcQuery id="ELL_BS_RS" datasourceId="Ellensburg_DS">
      <fieldList>
        <field id="BSEG_ID" type="java.lang.String"></field>
        <field id="START_DT" type="java.sql.Timestamp"></field>
        <field id="END_DT" type="java.sql.Timestamp"></field>
        <field id="RS_CD" type="java.lang.String"></field>
        <field id="EFFDT" type="java.sql.Timestamp"></field>
      </fieldList>
      <query>SELECT BSEG_ID, 
                 START_DT, 
                 END_DT, 
                 TRIM(RS_CD) RS_CD, 
                  EFFDT 
FROM CISADM.CI_BSEG_CALC</query>
    </jdbcQuery>
    <jdbcQuery id="ELL_BSEG_CALC_LN_DESCR_ON_BILL" datasourceId="Ellensburg_DS">
      <fieldList>
        <field id="BSEG_ID" type="java.lang.String"></field>
        <field id="DESCR_ON_BILL" type="java.lang.String"></field>
        <field id="HEADER_SEQ" type="java.math.BigDecimal"></field>
        <field id="SEQNO" type="java.math.BigDecimal"></field>
        <field id="CASEWHENDESCR_ON_BILLLIKE_@_THENSUBSTR_DESCR_ON_BILL_INSTR_DESCR_ON_BILL_@_1_ELSE_END_1" fieldDBName="CASEWHENDESCR_ON_BILLLIKE('%@%')THENSUBSTR(DESCR_ON_BILL,INSTR(DESCR_ON_BILL,'@')+1)ELSE''END" type="java.lang.String"></field>
        <field id="UOM" type="java.lang.String"></field>
      </fieldList>
      <query>select BSEG_ID,DESCR_ON_BILL, HEADER_SEQ, SEQNO,
case 
when DESCR_ON_BILL like ('%@%') then 
    substr(DESCR_ON_BILL, instr(DESCR_ON_BILL,'@')+1 ) 
else ' '    
end
,
case 
when DESCR_ON_BILL like ('Gas%') then 'CCF'
when DESCR_ON_BILL like ('%CCF%') then 'CCF'
when DESCR_ON_BILL like ('%KGAL%') then 'KGAL'
when DESCR_ON_BILL like ('Sewer%') then 'GAL'
when DESCR_ON_BILL like ('Water%') then 'GAL'
when DESCR_ON_BILL like ('%GAL%') then 'GAL'
when DESCR_ON_BILL like ('Stormwater%') then 'GAL'
when DESCR_ON_BILL like ('Electric%') then 'KWH'
when DESCR_ON_BILL like ('Demand%') then 'KWH'
else ' '    
end AS UOM
from cisadm.ci_bseg_calc_ln</query>
    </jdbcQuery>
