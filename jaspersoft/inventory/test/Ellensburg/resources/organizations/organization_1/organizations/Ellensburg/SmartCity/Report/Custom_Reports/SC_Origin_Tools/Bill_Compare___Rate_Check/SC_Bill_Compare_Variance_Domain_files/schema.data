<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.jaspersoft.com/2007/SL/XMLSchema" version="1.3">
  <dataIslands>
    <itemGroup id="DV_BC_MAIN" label="DV_BC_MAIN" resourceId="SC_BILL_COMPARE_VARIANCE"></itemGroup>
  </dataIslands>
  <dataSources>
    <jdbcDataSource id="Ellensburg_DS">
      <schemaMap>
        <entry key="defaultSchema">
          <string></string>
        </entry>
        <entry key="DATAVERGE1">
          <string>DATAVERGE1</string>
        </entry>
        <entry key="CISADM">
          <string>CISADM</string>
        </entry>
      </schemaMap>
    </jdbcDataSource>
  </dataSources>
  <items>
    <item id="BILL_STAT_FLG" label="Bill Status" resourceId="SC_BILL_COMPARE_VARIANCE.BILL_STAT_FLG"></item>
    <item id="BSEG_ID" label="Bill Segment ID" resourceId="SC_BILL_COMPARE_VARIANCE.BSEG_ID"></item>
    <item id="ACCT_ID" label="Account ID" resourceId="SC_BILL_COMPARE_VARIANCE.ACCT_ID"></item>
    <item id="ADDRESS1" label="Address" resourceId="SC_BILL_COMPARE_VARIANCE.ADDRESS1"></item>
    <item id="BILL_CYC_CD" label="Bill Cycle" resourceId="SC_BILL_COMPARE_VARIANCE.BILL_CYC_CD"></item>
    <item id="CIS_DIVISION" label="CIS Division" resourceId="SC_BILL_COMPARE_VARIANCE.CIS_DIVISION"></item>
    <item id="COMPLETE_DT" label="Completion Date/Time" resourceId="SC_BILL_COMPARE_VARIANCE.COMPLETE_DT"></item>
    <item id="DAYS" label="Days" resourceId="SC_BILL_COMPARE_VARIANCE.DAYS"></item>
    <item id="END_DT" label="End Date" resourceId="SC_BILL_COMPARE_VARIANCE.END_DT"></item>
    <item id="ENTITY_NAME" label="Name" resourceId="SC_BILL_COMPARE_VARIANCE.ENTITY_NAME"></item>
    <item id="EST_SW" label="Estimated" resourceId="SC_BILL_COMPARE_VARIANCE.EST_SW"></item>
    <item id="OLD_ACCT_ID" label="Old Account ID" resourceId="SC_BILL_COMPARE_VARIANCE.OLD_ACCT_ID"></item>
    <item id="RS_CD" label="Rate Schedule" resourceId="SC_BILL_COMPARE_VARIANCE.RS_CD"></item>
    <item id="SA_ID" label="Service Agreement" resourceId="SC_BILL_COMPARE_VARIANCE.SA_ID"></item>
    <item id="SA_TYPE_CD" label="SA Type" resourceId="SC_BILL_COMPARE_VARIANCE.SA_TYPE_CD"></item>
    <item id="SOURCE_BILL_ID" label="Source Bill ID" resourceId="SC_BILL_COMPARE_VARIANCE.SOURCE_BILL_ID"></item>
    <item id="SOURCE_BILL_SQ" label="Source Billed Service Quantity" resourceId="SC_BILL_COMPARE_VARIANCE.SOURCE_BILL_SQ"></item>
    <item id="SOURCE_CALC_AMT" label="Source Calculated Amount" resourceId="SC_BILL_COMPARE_VARIANCE.SOURCE_CALC_AMT"></item>
    <item id="START_DT" label="Start Date" resourceId="SC_BILL_COMPARE_VARIANCE.START_DT"></item>
    <item id="TARGET_BILL_ID" label="Target Bill ID" resourceId="SC_BILL_COMPARE_VARIANCE.TARGET_BILL_ID"></item>
    <item id="TARGET_BILL_SQ" label="Target Billed Service Quantity" resourceId="SC_BILL_COMPARE_VARIANCE.TARGET_BILL_SQ"></item>
    <item id="TARGET_CALC_AMT" label="Target Calculated Amount" resourceId="SC_BILL_COMPARE_VARIANCE.TARGET_CALC_AMT"></item>
    <item id="UOM_CD" label="Unit of Measure" resourceId="SC_BILL_COMPARE_VARIANCE.UOM_CD"></item>
    <item id="VAR_BILL_SQ" label="Variance Billed Service Quantity" resourceId="SC_BILL_COMPARE_VARIANCE.VAR_BILL_SQ"></item>
    <item id="VAR_CALC_AMT" label="Variance Calculated Amount" resourceId="SC_BILL_COMPARE_VARIANCE.VAR_CALC_AMT"></item>
    <item id="WIN_START_DT" label="Window Start Date" resourceId="SC_BILL_COMPARE_VARIANCE.WIN_START_DT"></item>
  </items>
  <resources>
    <jdbcQuery id="SC_BILL_COMPARE_VARIANCE" datasourceId="Ellensburg_DS">
      <fieldList>
        <field id="BILL_CYC_CD" type="java.lang.String"></field>
        <field id="SA_TYPE_CD" type="java.lang.String"></field>
        <field id="RS_CD" type="java.lang.String"></field>
        <field id="ADDRESS1" type="java.lang.String"></field>
        <field id="ACCT_ID" type="java.lang.String"></field>
        <field id="SA_ID" type="java.lang.String"></field>
        <field id="END_DT" type="java.sql.Timestamp"></field>
        <field id="CIS_DIVISION" type="java.lang.String"></field>
        <field id="OLD_ACCT_ID" type="java.lang.String"></field>
        <field id="TARGET_BILL_ID" type="java.lang.String"></field>
        <field id="SOURCE_BILL_ID" type="java.lang.String"></field>
        <field id="WIN_START_DT" type="java.sql.Timestamp"></field>
        <field id="COMPLETE_DT" type="java.sql.Timestamp"></field>
        <field id="START_DT" type="java.sql.Timestamp"></field>
        <field id="DAYS" type="java.math.BigDecimal"></field>
        <field id="EST_SW" type="java.lang.String"></field>
        <field id="ENTITY_NAME" type="java.lang.String"></field>
        <field id="TARGET_BILL_SQ" type="java.math.BigDecimal"></field>
        <field id="SOURCE_BILL_SQ" type="java.math.BigDecimal"></field>
        <field id="VAR_BILL_SQ" type="java.math.BigDecimal"></field>
        <field id="UOM_CD" type="java.lang.String"></field>
        <field id="TARGET_CALC_AMT" type="java.math.BigDecimal"></field>
        <field id="SOURCE_CALC_AMT" type="java.math.BigDecimal"></field>
        <field id="VAR_CALC_AMT" type="java.math.BigDecimal"></field>
        <field id="BILL_STAT_FLG" type="java.lang.String"></field>
        <field id="BSEG_ID" type="java.lang.String"></field>
      </fieldList>
      <query>SELECT * FROM (
    SELECT A.BILL_CYC_CD, 
        SA.SA_TYPE_CD, 
        BC.RS_CD, 
        P.ADDRESS1,
        A.ACCT_ID,
        SA.SA_ID,  
        BS.END_DT, 
        A.CIS_DIVISION, 
        SA.OLD_ACCT_ID, 
        B.BILL_ID AS TARGET_BILL_ID, 
        BB.BILL_ID AS SOURCE_BILL_ID,
        B.BILL_STAT_FLG, 
        B.WIN_START_DT, 
        TRUNC(B.COMPLETE_DTTM) COMPLETE_DT, 
        BS.START_DT, 
        (BS.END_DT-BS.START_DT) DAYS, 
        BS.EST_SW,
        PN.ENTITY_NAME,  
        BS.BSEG_ID,
        CCF.BILL_SQ AS TARGET_BILL_SQ, 
        CCF2.BILL_SQ AS SOURCE_BILL_SQ,
        CCF.BILL_SQ-CCF2.BILL_SQ AS VAR_BILL_SQ,
        CCF.UOM_CD,
        BC.CALC_AMT AS TARGET_CALC_AMT,
        BC2.CALC_AMT AS SOURCE_CALC_AMT,
        BC.CALC_AMT-BC2.CALC_AMT AS VAR_CALC_AMT
    FROM CISADM.CI_ACCT A
    JOIN CISADM.CI_ACCT_PER AP 
        ON A.ACCT_ID=AP.ACCT_ID
        AND MAIN_CUST_SW='Y'
    JOIN CISADM.CI_PER_NAME PN
        ON AP.PER_ID=PN.PER_ID
        AND PN.PRIM_NAME_SW='Y'
    JOIN CISADM.CI_BILL B
        ON A.ACCT_ID=B.ACCT_ID
    JOIN DATAVERGE1.DV_BC_BILL BB
        ON B.ACCT_ID = BB.ACCT_ID
    JOIN CISADM.CI_SA SA
        ON A.ACCT_ID=SA.ACCT_ID
    JOIN CISADM.CI_BSEG BS
        ON SA.SA_ID=BS.SA_ID
        AND B.BILL_ID=BS.BILL_ID
        AND BS.BSEG_STAT_FLG IN ('30','50')
    JOIN DATAVERGE1.DV_BC_BSEG BS2
       ON BS.SA_ID = BS2.SA_ID
       AND BB.BILL_ID = BS2.BILL_ID
       AND BS2.BSEG_STAT_FLG IN ('30','50')
       AND BS.END_DT = BS2.END_DT
       AND BS.START_DT = BS2.START_DT
    JOIN CISADM.CI_PREM P
        ON BS.PREM_ID=P.PREM_ID
    LEFT JOIN CISADM.CI_BSEG_SQ CCF
    ON BS.BSEG_ID=CCF.BSEG_ID
    AND CCF.UOM_CD != ' '
AND CCF.TOU_CD = ' '
AND CCF.SQI_CD = ' '    
    LEFT JOIN DATAVERGE1.DV_BC_BSEG_SQ CCF2
    ON BS2.BSEG_ID=CCF2.BSEG_ID
    AND CCF2.UOM_CD != ' '
AND CCF2.TOU_CD = ' '
AND CCF2.SQI_CD = ' '
AND CCF2.UOM_CD = CCF.UOM_CD
    LEFT JOIN (SELECT BSEG_ID, RS_CD, SUM(CALC_AMT) CALC_AMT, COUNT(*) HDR_CNT FROM CISADM.CI_BSEG_CALC GROUP BY BSEG_ID, RS_CD) BC
    ON BS.BSEG_ID=BC.BSEG_ID
    LEFT JOIN (SELECT BSEG_ID, RS_CD, SUM(CALC_AMT) CALC_AMT, COUNT(*) HDR_CNT FROM DATAVERGE1.DV_BC_BSEG_CALC GROUP BY BSEG_ID, RS_CD) BC2
    ON BS2.BSEG_ID=BC2.BSEG_ID
) WHERE (VAR_CALC_AMT != 0 or VAR_BILL_SQ != 0)</query>
    </jdbcQuery>
  </resources>
</schema>
