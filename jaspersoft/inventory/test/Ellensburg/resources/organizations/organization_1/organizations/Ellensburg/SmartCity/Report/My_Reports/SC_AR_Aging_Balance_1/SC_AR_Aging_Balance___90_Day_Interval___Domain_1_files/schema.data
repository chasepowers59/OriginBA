      <joinInfo alias="FDL_AGED_DETAILS" referenceId="FDL_AGED_DETAILS"></joinInfo>
      <joinList>
        <join expr="FDL_AGED_DETAILS.SA_ID == FDL_AGED_30.SA_ID" left="FDL_AGED_DETAILS" right="FDL_AGED_30" type="inner" weight="1"></join>
        <join expr="FDL_AGED_DETAILS.SA_ID == FDL_AGED_60.SA_ID" left="FDL_AGED_DETAILS" right="FDL_AGED_60" type="leftOuter" weight="1"></join>
        <join expr="FDL_AGED_DETAILS.SA_ID == FDL_AGED_90.SA_ID" left="FDL_AGED_DETAILS" right="FDL_AGED_90" type="leftOuter" weight="1"></join>
        <join expr="FDL_AGED_DETAILS.SA_ID == FDL_AGED_CURRENT.SA_ID" left="FDL_AGED_DETAILS" right="FDL_AGED_CURRENT" type="inner" weight="1"></join>
        <join expr="FDL_AGED_DETAILS.SA_ID == FDL_AGED_OLD.SA_ID" left="FDL_AGED_DETAILS" right="FDL_AGED_OLD" type="leftOuter" weight="1"></join>
        <join expr="FDL_AGED_DETAILS.ACCT_ID == CI_ACCT.ACCT_ID" left="FDL_AGED_DETAILS" right="CI_ACCT" type="inner" weight="1"></join>
      </joinList>
      <joinOptions suppressCircularJoins="true"></joinOptions>
      <query>SELECT
    a.bill_cyc_cd,
        a.CUST_CL_CD,
    sa.sa_type_cd,
    sa.END_DT,
    sa.sa_status_flg,
    p.address1 as ADDRESS1,
    a.acct_id,
    sa.sa_id,
    sat.dst_id,
    dst.gl_acct,
    pn.entity_name

FROM
         cisadm.ci_acct a
    JOIN cisadm.ci_acct_per      ap ON a.acct_id = ap.acct_id
                                  AND main_cust_sw = 'Y'
    JOIN cisadm.ci_per_name      pn ON ap.per_id = pn.per_id
                                  AND pn.prim_name_sw = 'Y'
    JOIN cisadm.ci_sa            sa ON a.acct_id = sa.acct_id
                            AND sa.sa_type_cd IN (
        SELECT
            sa_type_cd
        FROM
            cisadm.ci_sa_type
        WHERE
                allow_billing_sw = 'Y'
                and prem_req_sw = 'Y'
    )
    join cisadm.ci_sa_type  sat on sa.sa_type_cd = sat.sa_type_cd
    JOIN CISADM.CI_DST_CODE_EFF DST on saT.dst_id = DST.dst_id and DST.EFF_STATUS = 'A'
    JOIN cisadm.ci_prem          p ON sa.char_prem_id = p.prem_id
Union
SELECT
    a.bill_cyc_cd,
    a.cust_cl_cd,
    sa.sa_type_cd,
    sa.END_DT,
    sa.sa_status_flg,
    ' ' as ADDRESS1,
    a.acct_id,
    sa.sa_id,
    sat.dst_id,
    dst.gl_acct,
    pn.entity_name

FROM
         cisadm.ci_acct a
    JOIN cisadm.ci_acct_per      ap ON a.acct_id = ap.acct_id
                                  AND main_cust_sw = 'Y'
    JOIN cisadm.ci_per_name      pn ON ap.per_id = pn.per_id
                                  AND pn.prim_name_sw = 'Y'
    JOIN cisadm.ci_sa            sa ON a.acct_id = sa.acct_id
                            AND sa.sa_type_cd IN (
        SELECT
            sa_type_cd
        FROM
            cisadm.ci_sa_type
        WHERE
                --allow_billing_sw = 'Y'
                --and 
prem_req_sw = 'N'
    )
    join cisadm.ci_sa_type  sat on sa.sa_type_cd = sat.sa_type_cd
    JOIN CISADM.CI_DST_CODE_EFF DST on saT.dst_id = DST.dst_id and DST.EFF_STATUS = 'A'</query>
      <tableRefList>
        <tableRef alwaysIncludeTable="false" tableAlias="CI_ACCT" tableId="CI_ACCT"></tableRef>
        <tableRef alwaysIncludeTable="false" tableAlias="FDL_AGED_30" tableId="FDL_AGED_30"></tableRef>
        <tableRef alwaysIncludeTable="false" tableAlias="FDL_AGED_90" tableId="FDL_AGED_90"></tableRef>
        <tableRef alwaysIncludeTable="false" tableAlias="FDL_AGED_60" tableId="FDL_AGED_60"></tableRef>
        <tableRef alwaysIncludeTable="false" tableAlias="FDL_AGED_CURRENT" tableId="FDL_AGED_CURRENT"></tableRef>
        <tableRef alwaysIncludeTable="false" tableAlias="FDL_AGED_OLD" tableId="FDL_AGED_OLD"></tableRef>
        <tableRef alwaysIncludeTable="false" tableAlias="FDL_AGED_DETAILS" tableId="FDL_AGED_DETAILS"></tableRef>
      </tableRefList>
    </jdbcQuery>
  </resources>
</schema>
