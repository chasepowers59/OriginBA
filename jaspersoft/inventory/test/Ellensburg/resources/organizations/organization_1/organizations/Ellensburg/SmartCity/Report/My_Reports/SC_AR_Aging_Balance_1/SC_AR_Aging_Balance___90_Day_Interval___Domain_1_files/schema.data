    <jdbcQuery id="JoinTree_1" datasourceId="Ellensburg_DS">
      <fieldList>
        <field id="FDL_AGED_30.SA_ID" type="java.lang.String"></field>
        <field id="FDL_AGED_30.SUM_FT1_CUR_AMT__1" fieldDBName="SUM(FT1.CUR_AMT)" type="java.math.BigDecimal"></field>
        <field id="FDL_AGED_30.SUM_FT1_TOT_AMT__1" fieldDBName="SUM(FT1.TOT_AMT)" type="java.math.BigDecimal"></field>
