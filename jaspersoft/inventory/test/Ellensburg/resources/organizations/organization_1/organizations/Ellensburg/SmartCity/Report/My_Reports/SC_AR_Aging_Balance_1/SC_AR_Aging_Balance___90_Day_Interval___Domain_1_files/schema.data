  <resources>
    <jdbcQuery id="FDL_AGED_DETAILS" datasourceId="Ellensburg_DS">
      <fieldList>
        <field id="BILL_CYC_CD" type="java.lang.String"></field>
        <field id="SA_TYPE_CD" type="java.lang.String"></field>
        <field id="ADDRESS1" type="java.lang.String"></field>
        <field id="ACCT_ID" type="java.lang.String"></field>
        <field id="SA_ID" type="java.lang.String"></field>
        <field id="ENTITY_NAME" type="java.lang.String"></field>
        <field id="DST_ID" type="java.lang.String"></field>
        <field id="CUST_CL_CD" type="java.lang.String"></field>
        <field id="GL_ACCT" type="java.lang.String"></field>
        <field id="END_DT" type="java.sql.Timestamp"></field>
        <field id="SA_STATUS_FLG" type="java.lang.String"></field>
      </fieldList>
      <query>SELECT
    a.bill_cyc_cd,
        a.CUST_CL_CD,
    sa.sa_type_cd,
    sa.END_DT,
    sa.sa_status_flg,
    p.address1 as ADDRESS1,
    a.acct_id,
    sa.sa_id,
    sat.dst_id,
    dst.gl_acct,
    pn.entity_name

FROM
         cisadm.ci_acct a
    JOIN cisadm.ci_acct_per      ap ON a.acct_id = ap.acct_id
                                  AND main_cust_sw = 'Y'
    JOIN cisadm.ci_per_name      pn ON ap.per_id = pn.per_id
                                  AND pn.prim_name_sw = 'Y'
    JOIN cisadm.ci_sa            sa ON a.acct_id = sa.acct_id
                            AND sa.sa_type_cd IN (
        SELECT
            sa_type_cd
        FROM
            cisadm.ci_sa_type
        WHERE
                allow_billing_sw = 'Y'
                and prem_req_sw = 'Y'
    )
    join cisadm.ci_sa_type  sat on sa.sa_type_cd = sat.sa_type_cd
    JOIN CISADM.CI_DST_CODE_EFF DST on saT.dst_id = DST.dst_id and DST.EFF_STATUS = 'A'
    JOIN cisadm.ci_prem          p ON sa.char_prem_id = p.prem_id
Union
SELECT
    a.bill_cyc_cd,
    a.cust_cl_cd,
    sa.sa_type_cd,
    sa.END_DT,
    sa.sa_status_flg,
    ' ' as ADDRESS1,
    a.acct_id,
    sa.sa_id,
    sat.dst_id,
    dst.gl_acct,
    pn.entity_name

FROM
         cisadm.ci_acct a
    JOIN cisadm.ci_acct_per      ap ON a.acct_id = ap.acct_id
                                  AND main_cust_sw = 'Y'
    JOIN cisadm.ci_per_name      pn ON ap.per_id = pn.per_id
                                  AND pn.prim_name_sw = 'Y'
    JOIN cisadm.ci_sa            sa ON a.acct_id = sa.acct_id
                            AND sa.sa_type_cd IN (
        SELECT
            sa_type_cd
        FROM
            cisadm.ci_sa_type
        WHERE
                --allow_billing_sw = 'Y'
                --and 
prem_req_sw = 'N'
    )
    join cisadm.ci_sa_type  sat on sa.sa_type_cd = sat.sa_type_cd
    JOIN CISADM.CI_DST_CODE_EFF DST on saT.dst_id = DST.dst_id and DST.EFF_STATUS = 'A'</query>
    </jdbcQuery>
    <jdbcQuery id="FDL_AGED_30" datasourceId="Ellensburg_DS">
      <fieldList>
        <field id="SA_ID" type="java.lang.String"></field>
        <field id="SUM_FT1_CUR_AMT__1" fieldDBName="SUM(FT1.CUR_AMT)" type="java.math.BigDecimal"></field>
        <field id="SUM_FT1_TOT_AMT__1" fieldDBName="SUM(FT1.TOT_AMT)" type="java.math.BigDecimal"></field>
      </fieldList>
      <query>SELECT
            ft1.sa_id, sum(ft1.cur_amt),sum(ft1.tot_amt)
            
        FROM
            cisadm.ci_ft ft1
        WHERE
                ft1.freeze_sw = 'Y'
            AND ( ft1.ars_dt BETWEEN ( trunc(sysdate) - 30 ) AND trunc(sysdate) )
group by ft1.sa_id</query>
    </jdbcQuery>
    <jdbcQuery id="FDL_AGED_60" datasourceId="Ellensburg_DS">
      <fieldList>
        <field id="SA_ID" type="java.lang.String"></field>
        <field id="SUM_FT1_CUR_AMT__3" fieldDBName="SUM(FT1.CUR_AMT)" type="java.math.BigDecimal"></field>
        <field id="SUM_FT1_TOT_AMT__3" fieldDBName="SUM(FT1.TOT_AMT)" type="java.math.BigDecimal"></field>
      </fieldList>
      <query>SELECT
            ft1.sa_id, sum(ft1.cur_amt),sum(ft1.tot_amt)
        FROM
            cisadm.ci_ft ft1
        WHERE
                ft1.freeze_sw = 'Y'
            AND ( ft1.ars_dt BETWEEN ( trunc(sysdate) - 60) AND trunc(sysdate) - 31 )
group by ft1.sa_id</query>
    </jdbcQuery>
    <jdbcQuery id="FDL_AGED_90" datasourceId="Ellensburg_DS">
      <fieldList>
        <field id="SA_ID" type="java.lang.String"></field>
        <field id="SUM_FT1_CUR_AMT__2" fieldDBName="SUM(FT1.CUR_AMT)" type="java.math.BigDecimal"></field>
        <field id="SUM_FT1_TOT_AMT__2" fieldDBName="SUM(FT1.TOT_AMT)" type="java.math.BigDecimal"></field>
      </fieldList>
      <query>SELECT
            ft1.sa_id, sum(ft1.cur_amt),sum(ft1.tot_amt)
        FROM
            cisadm.ci_ft ft1
        WHERE
                ft1.freeze_sw = 'Y'
            AND ( ft1.ars_dt BETWEEN ( trunc(sysdate) - 90 ) AND trunc(sysdate) - 61 )
group by ft1.sa_id</query>
    </jdbcQuery>
    <jdbcQuery id="FDL_AGED_CURRENT" datasourceId="Ellensburg_DS">
      <fieldList>
        <field id="SA_ID" type="java.lang.String"></field>
        <field id="SUM_FT1_CUR_AMT_" fieldDBName="SUM(FT1.CUR_AMT)" type="java.math.BigDecimal"></field>
        <field id="SUM_FT1_TOT_AMT_" fieldDBName="SUM(FT1.TOT_AMT)" type="java.math.BigDecimal"></field>
      </fieldList>
      <query>SELECT
            ft1.sa_id,
            sum(ft1.cur_amt),sum(ft1.tot_amt)
            
        FROM
            cisadm.ci_ft ft1
        WHERE
                ft1.freeze_sw = 'Y'
            AND ( ft1.ars_dt &lt;= trunc(sysdate) )
group by ft1.sa_id</query>
    </jdbcQuery>
    <jdbcQuery id="FDL_AGED_OLD" datasourceId="Ellensburg_DS">
      <fieldList>
        <field id="SA_ID" type="java.lang.String"></field>
        <field id="SUM_FT1_CUR_AMT__4" fieldDBName="SUM(FT1.CUR_AMT)" type="java.math.BigDecimal"></field>
        <field id="SUM_FT1_TOT_AMT__4" fieldDBName="SUM(FT1.TOT_AMT)" type="java.math.BigDecimal"></field>
      </fieldList>
      <query>SELECT
            ft1.sa_id, sum(ft1.cur_amt),sum(ft1.tot_amt)
            
        FROM
            cisadm.ci_ft ft1
        WHERE
                ft1.freeze_sw = 'Y'
            AND ( ft1.ars_dt &lt;= trunc(sysdate) - 91)  
group by ft1.sa_id</query>
    </jdbcQuery>
