      <query>select sa.SA_ID, SA.sa_type_cd, sa.start_dt,sa.end_dt, sa.acct_id, sa.expire_dt, sa.sa_status_flg, sah.effdt, sah.rcr_chg_amt ,
    (NVL((select sum(ft.cur_amt) from cisadm.ci_ft ft where ft.sa_id = sa.sa_id and ft.freeze_sw = 'Y' and ft.redundant_sw = 'N'),0)) AS cur_amt
    ,(NVL((select sum(ft.TOT_amt) from cisadm.ci_ft ft where ft.sa_id = sa.sa_id and ft.freeze_sw = 'Y' and ft.redundant_sw = 'N'),0)) AS TOT_AMT,
    round((NVL((select sum(ft.TOT_amt) from cisadm.ci_ft ft where ft.sa_id = sa.sa_id and ft.freeze_sw = 'Y' and ft.redundant_sw = 'N'),0))/sah.rcr_chg_amt) as NO_INT,
    NVL((select count(bs.bseg_id) from cisadm.ci_bseg bs where bs.sa_id = sa.sa_id and bs.bseg_stat_flg='50'),0) as COMP_INSTALL,
    round((NVL((select sum(ft.TOT_amt) from cisadm.ci_ft ft where ft.sa_id = sa.sa_id and ft.freeze_sw = 'Y' and ft.redundant_sw = 'N'),0))/sah.rcr_chg_amt) - NVL((select count(bs.bseg_id) from cisadm.ci_bseg bs where bs.sa_id = sa.sa_id and bs.bseg_stat_flg='50'),0) as INSTALL_LEFT
    from cisadm.ci_sa sa, cisadm.ci_sa_rchg_hist sah where sa.sa_id = sah.sa_id and sa.sa_type_cd in (select sa_type_cd from cisadm.ci_sa_type where special_role_flg='PA')
