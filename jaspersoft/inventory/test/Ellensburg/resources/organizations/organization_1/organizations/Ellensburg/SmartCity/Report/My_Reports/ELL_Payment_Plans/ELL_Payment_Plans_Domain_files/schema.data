  <resources>
    <jdbcTable id="CI_FT" datasourceId="Newark1_DS" datasourceTableName="CI_FT" schemaAlias="CISADM">
      <fieldList>
        <field id="FT_ID" type="java.lang.String"></field>
        <field id="SIBLING_ID" type="java.lang.String"></field>
        <field id="SA_ID" type="java.lang.String"></field>
        <field id="PARENT_ID" type="java.lang.String"></field>
        <field id="GL_DIVISION" type="java.lang.String"></field>
        <field id="CIS_DIVISION" type="java.lang.String"></field>
        <field id="CURRENCY_CD" type="java.lang.String"></field>
        <field id="FT_TYPE_FLG" type="java.lang.String"></field>
        <field id="CUR_AMT" type="java.math.BigDecimal"></field>
        <field id="TOT_AMT" type="java.math.BigDecimal"></field>
        <field id="CRE_DTTM" type="java.sql.Timestamp"></field>
        <field id="FREEZE_SW" type="java.lang.String"></field>
        <field id="FREEZE_USER_ID" type="java.lang.String"></field>
        <field id="FREEZE_DTTM" type="java.sql.Timestamp"></field>
        <field id="ARS_DT" type="java.sql.Timestamp"></field>
        <field id="CORRECTION_SW" type="java.lang.String"></field>
        <field id="REDUNDANT_SW" type="java.lang.String"></field>
        <field id="NEW_DEBIT_SW" type="java.lang.String"></field>
        <field id="SHOW_ON_BILL_SW" type="java.lang.String"></field>
        <field id="NOT_IN_ARS_SW" type="java.lang.String"></field>
        <field id="BILL_ID" type="java.lang.String"></field>
        <field id="ACCOUNTING_DT" type="java.sql.Timestamp"></field>
        <field id="VERSION" type="java.math.BigDecimal"></field>
        <field id="XFERRED_OUT_SW" type="java.lang.String"></field>
        <field id="XFER_TO_GL_DT" type="java.sql.Timestamp"></field>
        <field id="GL_DISTRIB_STATUS" type="java.lang.String"></field>
        <field id="SCHED_DISTRIB_DT" type="java.sql.Timestamp"></field>
        <field id="BAL_CTL_GRP_ID" type="java.math.BigDecimal"></field>
        <field id="MATCH_EVT_ID" type="java.lang.String"></field>
      </fieldList>
      <filterString>FREEZE_SW == 'Y' and REDUNDANT_SW == 'N'</filterString>
    </jdbcTable>
    <jdbcQuery id="CM_CUS_DET" datasourceId="Newark1_DS">
      <fieldList>
        <field id="BILL_CYC_CD" type="java.lang.String"></field>
        <field id="ACCT_ID" type="java.lang.String"></field>
        <field id="ENTITY_NAME" type="java.lang.String"></field>
        <field id="CELLPHONE" type="java.lang.String"></field>
        <field id="HOMEPHONE" type="java.lang.String"></field>
        <field id="WORKPHONE" type="java.lang.String"></field>
        <field id="PRIMARYEMAIL" type="java.lang.String"></field>
      </fieldList>
      <query>SELECT
    a.bill_cyc_cd as BILL_CYC_CD,
    a.acct_id,
    pn.entity_name as ENTITY_NAME,
    (select ct.contact_value from cisadm.ci_acct_per ap, cisadm.c1_per_contdet ct where a.acct_id = ap.acct_id and ap.main_cust_sw='Y' and ap.per_id = ct.per_id and ct.cnd_primary_flg = 'C1YS' and ct.comm_rte_type_cd ='CELLPHONE' )
     AS CELLPHONE,
    (select ct.contact_value from cisadm.ci_acct_per ap, cisadm.c1_per_contdet ct where a.acct_id = ap.acct_id and ap.main_cust_sw='Y' and ap.per_id = ct.per_id and ct.cnd_primary_flg = 'C1YS' and ct.comm_rte_type_cd ='HOMEPHONE' )
     AS HOMEPHONE,
    (select ct.contact_value from cisadm.ci_acct_per ap, cisadm.c1_per_contdet ct where a.acct_id = ap.acct_id and ap.main_cust_sw='Y' and ap.per_id = ct.per_id and ct.cnd_primary_flg = 'C1YS' and ct.comm_rte_type_cd ='WORKPHONE' )
     AS WORKPHONE,     
	NVL((select ct.contact_value from cisadm.ci_acct_per ap, cisadm.c1_per_contdet ct where a.acct_id = ap.acct_id and ap.main_cust_sw='Y' and ap.per_id = ct.per_id and ct.cnd_primary_flg = 'C1YS' and ct.comm_rte_type_cd ='PRIMARYEMAIL'  ),' ') AS PRIMARYEMAIL
FROM
         cisadm.ci_acct a
    JOIN cisadm.ci_acct_per      ap ON a.acct_id = ap.acct_id
                                  AND main_cust_sw = 'Y'
    JOIN CISADM.cI_PER           per on ap.PER_ID = per.PER_Id                                  
    JOIN cisadm.ci_per_name      pn ON ap.per_id = pn.per_id
                                  AND pn.prim_name_sw = 'Y'</query>
    </jdbcQuery>
    <jdbcQuery id="CM_PA_SA" datasourceId="Newark1_DS">
      <fieldList>
        <field id="SA_ID" type="java.lang.String"></field>
        <field id="PROP_DCL_RSN_CD" type="java.lang.String"></field>
        <field id="PROP_SA_ID" type="java.lang.String"></field>
        <field id="CIS_DIVISION" type="java.lang.String"></field>
        <field id="SA_TYPE_CD" type="java.lang.String"></field>
        <field id="START_OPT_CD" type="java.lang.String"></field>
        <field id="START_DT" type="java.sql.Timestamp"></field>
        <field id="SA_STATUS_FLG" type="java.lang.String"></field>
        <field id="ACCT_ID" type="java.lang.String"></field>
        <field id="END_DT" type="java.sql.Timestamp"></field>
        <field id="OLD_ACCT_ID" type="java.lang.String"></field>
        <field id="CUST_READ_FLG" type="java.lang.String"></field>
        <field id="ALLOW_EST_SW" type="java.lang.String"></field>
        <field id="SIC_CD" type="java.lang.String"></field>
        <field id="CHAR_PREM_ID" type="java.lang.String"></field>
        <field id="TOT_TO_BILL_AMT" type="java.math.BigDecimal"></field>
        <field id="CURRENCY_CD" type="java.lang.String"></field>
        <field id="VERSION" type="java.math.BigDecimal"></field>
        <field id="SA_REL_ID" type="java.lang.String"></field>
        <field id="STRT_RSN_FLG" type="java.lang.String"></field>
        <field id="STOP_RSN_FLG" type="java.lang.String"></field>
        <field id="STRT_REQED_BY" type="java.lang.String"></field>
        <field id="STOP_REQED_BY" type="java.lang.String"></field>
        <field id="HIGH_BILL_AMT" type="java.math.BigDecimal"></field>
        <field id="INT_CALC_DT" type="java.sql.Timestamp"></field>
        <field id="CIAC_REVIEW_DT" type="java.sql.Timestamp"></field>
        <field id="BUS_ACTIVITY_DESC" type="java.lang.String"></field>
        <field id="IB_SA_CUTOFF_TM" type="java.sql.Timestamp"></field>
        <field id="IB_BASE_TM_DAY_FLG" type="java.lang.String"></field>
        <field id="ENRL_ID" type="java.lang.String"></field>
        <field id="SPECIAL_USAGE_FLG" type="java.lang.String"></field>
        <field id="PROP_SA_STAT_FLG" type="java.lang.String"></field>
        <field id="NBR_PYMNT_PERIODS" type="java.math.BigDecimal"></field>
        <field id="NB_RULE_CD" type="java.lang.String"></field>
        <field id="EXPIRE_DT" type="java.sql.Timestamp"></field>
        <field id="RENEWAL_DT" type="java.sql.Timestamp"></field>
        <field id="NB_APAY_FLG" type="java.lang.String"></field>
        <field id="SA_DATA_AREA" type="java.lang.String"></field>
        <field id="EFFDT" type="java.sql.Timestamp"></field>
        <field id="RCR_CHG_AMT" type="java.math.BigDecimal"></field>
      </fieldList>
      <query>Select sa.*, SACHR.EFFDT,SACHR.RCR_CHG_AMT from cisadm.ci_sa sa 
left join CISADM.CI_SA_RCHG_hist SACHR on SA.SA_ID = SACHR.SA_ID 
    where sa.sa_type_cd in (select sa_type_cd from cisadm.ci_sa_type where special_role_flg='PA')
        and SACHR.effdt = (SELECT MAX(EFFDT) from CISADM.CI_SA_RCHG_hist SACHR2 where SA.SA_ID = SACHR2.SA_ID )</query>
    </jdbcQuery>
    <jdbcQuery id="CM_SUM_FT" datasourceId="Newark1_DS">
      <fieldList>
        <field id="SA_ID" type="java.lang.String"></field>
        <field id="SUM_CUR_AMT_" fieldDBName="SUM(CUR_AMT)" type="java.math.BigDecimal"></field>
        <field id="SUM_TOT_AMT_" fieldDBName="SUM(TOT_AMT)" type="java.math.BigDecimal"></field>
      </fieldList>
      <query>SELECT SA_ID,SUM(cur_AMT),SUM(TOT_AMT) from CISADM.CI_FT where
freeze_SW='Y' and REDUNDANT_SW = 'Y' group by SA_ID</query>
    </jdbcQuery>
    <jdbcQuery id="CM_PA_SA_DETAILS" datasourceId="Newark1_DS">
      <fieldList>
        <field id="SA_ID" type="java.lang.String"></field>
        <field id="SA_TYPE_CD" type="java.lang.String"></field>
        <field id="START_DT" type="java.sql.Timestamp"></field>
        <field id="END_DT" type="java.sql.Timestamp"></field>
        <field id="ACCT_ID" type="java.lang.String"></field>
        <field id="EXPIRE_DT" type="java.sql.Timestamp"></field>
        <field id="SA_STATUS_FLG" type="java.lang.String"></field>
        <field id="EFFDT" type="java.sql.Timestamp"></field>
        <field id="RCR_CHG_AMT" type="java.math.BigDecimal"></field>
        <field id="CUR_AMT" type="java.math.BigDecimal"></field>
        <field id="TOT_AMT" type="java.math.BigDecimal"></field>
        <field id="NO_INT" type="java.math.BigDecimal"></field>
        <field id="COMP_INSTALL" type="java.math.BigDecimal"></field>
        <field id="INSTALL_LEFT" type="java.math.BigDecimal"></field>
      </fieldList>
      <query>select sa.SA_ID, SA.sa_type_cd, sa.start_dt,sa.end_dt, sa.acct_id, sa.expire_dt, sa.sa_status_flg, sah.effdt, sah.rcr_chg_amt ,
    (NVL((select sum(ft.cur_amt) from cisadm.ci_ft ft where ft.sa_id = sa.sa_id and ft.freeze_sw = 'Y' and ft.redundant_sw = 'N'),0)) AS cur_amt
    ,(NVL((select sum(ft.TOT_amt) from cisadm.ci_ft ft where ft.sa_id = sa.sa_id and ft.freeze_sw = 'Y' and ft.redundant_sw = 'N'),0)) AS TOT_AMT,
    round((NVL((select sum(ft.TOT_amt) from cisadm.ci_ft ft where ft.sa_id = sa.sa_id and ft.freeze_sw = 'Y' and ft.redundant_sw = 'N'),0))/sah.rcr_chg_amt) as NO_INT,
    NVL((select count(bs.bseg_id) from cisadm.ci_bseg bs where bs.sa_id = sa.sa_id and bs.bseg_stat_flg='50'),0) as COMP_INSTALL,
    round((NVL((select sum(ft.TOT_amt) from cisadm.ci_ft ft where ft.sa_id = sa.sa_id and ft.freeze_sw = 'Y' and ft.redundant_sw = 'N'),0))/sah.rcr_chg_amt) - NVL((select count(bs.bseg_id) from cisadm.ci_bseg bs where bs.sa_id = sa.sa_id and bs.bseg_stat_flg='50'),0) as INSTALL_LEFT
    from cisadm.ci_sa sa, cisadm.ci_sa_rchg_hist sah where sa.sa_id = sah.sa_id and sa.sa_type_cd in (select sa_type_cd from cisadm.ci_sa_type where special_role_flg='PA')
        and sah.effdt = (SELECT MAX(EFFDT) from CISADM.CI_SA_RCHG_hist SACHR2 where SA.SA_ID = SACHR2.SA_ID )</query>
    </jdbcQuery>
    <jdbcQuery id="CM_CUS_DET_1" datasourceId="Newark1_DS">
      <fieldList>
        <field id="BILL_CYC_CD" type="java.lang.String"></field>
        <field id="ACCT_ID" type="java.lang.String"></field>
        <field id="ENTITY_NAME" type="java.lang.String"></field>
        <field id="CELLPHONE" type="java.lang.String"></field>
        <field id="HOMEPHONE" type="java.lang.String"></field>
        <field id="WORKPHONE" type="java.lang.String"></field>
        <field id="PRIMARYEMAIL" type="java.lang.String"></field>
        <field id="ADDRESS1" type="java.lang.String"></field>
      </fieldList>
      <query>SELECT
    Distinct(a.bill_cyc_cd) as BILL_CYC_CD,
    a.acct_id,
    pn.entity_name as ENTITY_NAME,
    (select ct.contact_value from cisadm.ci_acct_per ap, cisadm.c1_per_contdet ct where a.acct_id = ap.acct_id and ap.main_cust_sw='Y' and ap.per_id = ct.per_id and ct.cnd_primary_flg = 'C1YS' and ct.comm_rte_type_cd ='CELLPHONE' )
     AS CELLPHONE,
    (select ct.contact_value from cisadm.ci_acct_per ap, cisadm.c1_per_contdet ct where a.acct_id = ap.acct_id and ap.main_cust_sw='Y' and ap.per_id = ct.per_id and ct.cnd_primary_flg = 'C1YS' and ct.comm_rte_type_cd ='HOMEPHONE' )
     AS HOMEPHONE,
    (select ct.contact_value from cisadm.ci_acct_per ap, cisadm.c1_per_contdet ct where a.acct_id = ap.acct_id and ap.main_cust_sw='Y' and ap.per_id = ct.per_id and ct.cnd_primary_flg = 'C1YS' and ct.comm_rte_type_cd ='WORKPHONE' )
     AS WORKPHONE,     
	NVL((select ct.contact_value from cisadm.ci_acct_per ap, cisadm.c1_per_contdet ct where a.acct_id = ap.acct_id and ap.main_cust_sw='Y' and ap.per_id = ct.per_id and ct.cnd_primary_flg = 'C1YS' and ct.comm_rte_type_cd ='PRIMARYEMAIL'  ),' ') AS PRIMARYEMAIL,
    P.address1
FROM
         cisadm.ci_acct a
    JOIN cisadm.ci_acct_per      ap ON a.acct_id = ap.acct_id
                                  AND main_cust_sw = 'Y'
    JOIN CISADM.cI_PER           per on ap.PER_ID = per.PER_Id                                  
    JOIN cisadm.ci_per_name      pn ON ap.per_id = pn.per_id
                                  AND pn.prim_name_sw = 'Y'
    JOIN CISADM.CI_SA SA
             ON     A.ACCT_ID = SA.ACCT_ID
                AND SA.SA_STATUS_FLG IN ('20', '30', '40')
                AND SA.SA_TYPE_CD IN
                        (SELECT SA_TYPE_CD
                           FROM CISADM.CI_SA_TYPE
                          WHERE ALLOW_BILLING_SW = 'Y' AND PREM_REQ_SW = 'Y')
    JOIN CISADM.CI_PREM P ON SA.CHAR_PREM_ID = P.PREM_ID</query>
    </jdbcQuery>
