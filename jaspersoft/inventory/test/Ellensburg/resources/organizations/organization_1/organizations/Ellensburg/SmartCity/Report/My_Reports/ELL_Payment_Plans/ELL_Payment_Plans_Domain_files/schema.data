        <field id="CM_PA_SA.RCR_CHG_AMT" type="java.math.BigDecimal"></field>
      </fieldList>
      <filterString>CI_FT.FREEZE_SW == 'Y' and CI_FT.REDUNDANT_SW == 'N'</filterString>
      <joinInfo alias="CM_PA_SA" referenceId="CM_PA_SA"></joinInfo>
      <joinList>
        <join expr="CM_PA_SA.ACCT_ID == CM_CUS_DET.ACCT_ID" left="CM_PA_SA" right="CM_CUS_DET" type="leftOuter" weight="1"></join>
        <join expr="CI_FT.SA_ID == CM_PA_SA.SA_ID" left="CI_FT" right="CM_PA_SA" type="inner" weight="1"></join>
        <join expr="CM_PA_SA.SA_ID == CM_SUM_FT.SA_ID" left="CM_PA_SA" right="CM_SUM_FT" type="inner" weight="1"></join>
      </joinList>
      <joinOptions suppressCircularJoins="true"></joinOptions>
      <query>Select sa.*, SACHR.EFFDT,SACHR.RCR_CHG_AMT from cisadm.ci_sa sa 
left join CISADM.CI_SA_RCHG_hist SACHR on SA.SA_ID = SACHR.SA_ID 
    where sa.sa_type_cd in (select sa_type_cd from cisadm.ci_sa_type where special_role_flg='PA')
        and SACHR.effdt = (SELECT MAX(EFFDT) from CISADM.CI_SA_RCHG_hist SACHR2 where SA.SA_ID = SACHR2.SA_ID )</query>
