<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.jaspersoft.com/2007/SL/XMLSchema" version="1.3">
  <dataIslands>
    <itemGroup id="ELL_COLL_AGY_REF" label="ELL_COLL_AGY_REF" resourceId="ELL_COLL_AGY_REF"></itemGroup>
  </dataIslands>
  <items>
    <item id="ACCT_ID" label="Account ID" resourceId="ELL_COLL_AGY_REF.ACCT_ID"></item>
    <item id="COLL_AGY_CD" label="Collection Agency" resourceId="ELL_COLL_AGY_REF.COLL_AGY_CD"></item>
    <item id="COLL_AGY_REF_ID" label="Collection Referral ID" resourceId="ELL_COLL_AGY_REF.COLL_AGY_REF_ID"></item>
    <item id="ENTITY_NAME" label="Customer Name" resourceId="ELL_COLL_AGY_REF.ENTITY_NAME"></item>
    <item id="REF_STATUS_FLG" label="Referral Status" resourceId="ELL_COLL_AGY_REF.REF_STATUS_FLG"></item>
    <item id="START_DT" label="Start Date" resourceId="ELL_COLL_AGY_REF.START_DT"></item>
    <item id="WO_PROC_ID" label="Write Off Process ID" resourceId="ELL_COLL_AGY_REF.WO_PROC_ID"></item>
  </items>
  <resources>
    <jdbcQuery id="ELL_COLL_AGY_REF" datasourceId="Ellensburg_DS">
      <fieldList>
        <field id="ACCT_ID" type="java.lang.String"></field>
        <field id="ENTITY_NAME" type="java.lang.String"></field>
        <field id="COLL_AGY_REF_ID" type="java.lang.String"></field>
        <field id="COLL_AGY_CD" type="java.lang.String"></field>
        <field id="REF_STATUS_FLG" type="java.lang.String"></field>
        <field id="START_DT" type="java.sql.Timestamp"></field>
        <field id="WO_PROC_ID" type="java.lang.String"></field>
      </fieldList>
      <query>SELECT CR.ACCT_ID, PN.ENTITY_NAME, CR.COLL_AGY_REF_ID, CR.COLL_AGY_CD, CR.REF_STATUS_FLG, CR.START_DT, CR.WO_PROC_ID 
FROM CISADM.CI_COLL_AGY_REF CR
INNER JOIN CISADM.CI_ACCT_PER AP ON AP.ACCT_ID = CR.ACCT_ID
    AND AP.MAIN_CUST_SW = 'Y'
INNER JOIN CISADM.CI_PER_NAME PN ON PN.PER_ID = AP.PER_ID
    AND PN.PRIM_NAME_SW = 'Y'
WHERE CR.REF_STATUS_FLG = 'A'
AND CR.VERSION &gt; 100
AND EXISTS (SELECT 1 FROM CISADM.CI_PAY P 
            INNER JOIN CISADM.CI_PAY_EVENT PE ON PE.PAY_EVENT_ID = P.PAY_EVENT_ID
                AND PE.PAY_DT &gt; '11-DEC-23'
            WHERE P.ACCT_ID = CR.ACCT_ID
            )
UNION 
SELECT CR.ACCT_ID, PN.ENTITY_NAME, CR.COLL_AGY_REF_ID, CR.COLL_AGY_CD, CR.REF_STATUS_FLG, CR.START_DT, CR.WO_PROC_ID 
FROM CISADM.CI_COLL_AGY_REF CR
INNER JOIN CISADM.CI_ACCT_PER AP ON AP.ACCT_ID = CR.ACCT_ID
    AND AP.MAIN_CUST_SW = 'Y'
INNER JOIN CISADM.CI_PER_NAME PN ON PN.PER_ID = AP.PER_ID
    AND PN.PRIM_NAME_SW = 'Y'
WHERE CR.REF_STATUS_FLG = 'A'
AND CR.VERSION &lt; 100
AND EXISTS (SELECT 1 FROM CISADM.CI_PAY P 
            INNER JOIN CISADM.CI_PAY_EVENT PE ON PE.PAY_EVENT_ID = P.PAY_EVENT_ID
                AND PE.PAY_DT &gt; CR.START_DT
            WHERE P.ACCT_ID = CR.ACCT_ID
            )</query>
    </jdbcQuery>
  </resources>
</schema>
