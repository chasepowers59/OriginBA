	<variable name="companyAddress" incrementType="Group" incrementGroup="accountId" class="java.lang.String">
		<expression><![CDATA[$F{companyAddress}.replace( "~", "\n" )]]></expression>
	</variable>
	<variable name="paymentInstruction" incrementType="Group" incrementGroup="accountId" class="java.lang.String">
		<expression><![CDATA[$F{paymentInstruction}.replace( "~", "\n" )]]></expression>
	</variable>
	<variable name="mailingPostal" class="java.lang.String">
		<expression><![CDATA[$F{mailingPostal}.length()>5?"00270903360940"+($F{mailingPostal}.substring( 0, 5 ))+"4":
"00270903360940"+($F{mailingPostal})+"4"]]></expression>
	</variable>
	<variable name="billDate" class="java.util.Date"/>
	<variable name="dueDate" class="java.util.Date"/>
