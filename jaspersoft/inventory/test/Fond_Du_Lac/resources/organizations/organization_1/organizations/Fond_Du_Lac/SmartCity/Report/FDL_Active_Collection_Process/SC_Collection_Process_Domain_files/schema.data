    <jdbcQuery id="FDL_CHAR_PREM" datasourceId="FondDuLac_DS">
      <fieldList>
        <field id="CHAR_PREM_ID" type="java.lang.String"></field>
        <field id="ACCT_ID" type="java.lang.String"></field>
      </fieldList>
      <query>SELECT DISTINCT CHAR_PREM_ID, ACCT_ID
FROM CISADM.CI_SA where sa_status_flg = '20'</query>
    </jdbcQuery>
    <jdbcQuery id="COLL_PROC_SA_BAL" datasourceId="FondDuLac_DS">
      <fieldList>
        <field id="COLL_PROC_ID" type="java.lang.String"></field>
        <field id="AMT" type="java.math.BigDecimal"></field>
        <field id="PAYMENTS" type="java.math.BigDecimal"></field>
        <field id="PAAMT" type="java.math.BigDecimal"></field>
        <field id="RUNNINGARS" type="java.math.BigDecimal"></field>
      </fieldList>
      <query>select c.coll_proc_id, (select Sum(sa.ars_amt) from cisadm.ci_coll_proc_sa sa where c.coll_proc_id = sa.coll_proc_id group by sa.coll_proc_id) amt 
       , (NVL((SELECT SUM(PAY.PAY_AMT) from CISADM.CI_PAY PAY where PAY.ACCT_ID = C.ACCT_ID and PAY.ILM_DT &gt;= c.CRE_DTTM and PAY.PAY_STATUS_FLG = '50'),0)) payments
       , (NVL((select sum(ftpa.cur_amt) from cisadm.ci_ft ftpa where ftpa.sa_id in (select sapa.sa_id from cisadm.ci_sa sapa where sapa.acct_id = C.ACCT_ID 
            and sapa.sa_type_cd = 'PA' and sapa.sa_status_flg in ('10','20','30','40')) and ftpa.not_in_ars_sw = 'N'),0)) paamt
       , (NVL((select Sum(sa.ars_amt) from cisadm.ci_coll_proc_sa sa where c.coll_proc_id = sa.coll_proc_id group by sa.coll_proc_id) ,0)) - 
       (NVL((SELECT SUM(PAY.PAY_AMT) from CISADM.CI_PAY PAY where PAY.ACCT_ID = C.ACCT_ID and PAY.ILM_DT &gt;= c.CRE_DTTM and PAY.PAY_STATUS_FLG = '50'),0)) +
        (NVL((select sum(ftpa.cur_amt) from cisadm.ci_ft ftpa where ftpa.sa_id in (select sapa.sa_id from cisadm.ci_sa sapa where sapa.acct_id = C.ACCT_ID 
            and sapa.sa_type_cd = 'PA' and sapa.sa_status_flg in ('10','20','30','40')) and ftpa.not_in_ars_sw = 'N'),0)) as runningars
       from CISADM.ci_coll_proc c</query>
    </jdbcQuery>
