<?xml version="1.0" encoding="UTF-8"?>
<jasperReport name="payments_by_tender_type_period" pageWidth="842" pageHeight="595" orientation="Landscape"
    columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20"
    whenNoDataType="AllSectionsNoDetail">
    <property name="net.sf.jasperreports.query.timeout" value="600"/>
    <property name="net.sf.jasperreports.export.xls.remove.empty.space.between.rows" value="true"/>
    <style name="Base" default="true" fontName="SansSerif" fontSize="9"/>
    <style name="TitleSapphire" style="Base" fontSize="18" bold="true" forecolor="#006FAC"/>
    <style name="H3" style="Base" fontSize="9" forecolor="#0F4761"/>
    <style name="HeaderSapphire" style="Base" fontSize="9" bold="true" forecolor="#FFFFFF" backcolor="#006FAC" mode="Opaque"/>
    <style name="RowBand" style="Base" fontSize="9" bold="true" forecolor="#000000" backcolor="#E7F2F8" mode="Opaque"/>
    <style name="SubHeader" style="Base" fontSize="8" forecolor="#5B6470"/>
    <style name="SubText" style="Base" fontSize="8" forecolor="#000000"/>
    <style name="SubTotal" style="Base" fontSize="8" bold="true" forecolor="#0F4761"/>
    <style name="TotalText" style="Base" fontSize="9" bold="true" forecolor="#000000" backcolor="#E7F2F8" mode="Opaque"/>
    <style name="FooterConfidential" style="Base" fontSize="7" forecolor="#5B6470"/>
    <query language="SQL"><![CDATA[
SELECT TRIM(t.tender_type_cd) AS TENDER_TYPE_CD, COALESCE(tl.descr, TRIM(t.tender_type_cd)) AS TENDER_TYPE_DESCR,
       COUNT(CASE WHEN NULLIF(TRIM(t.can_rsn_cd), '') IS NULL THEN 1 END) AS TENDERS,
       COALESCE(SUM(CASE WHEN NULLIF(TRIM(t.can_rsn_cd), '') IS NULL THEN t.tender_amt ELSE 0 END), 0) AS TENDER_AMT,
       COUNT(CASE WHEN NULLIF(TRIM(t.can_rsn_cd), '') IS NOT NULL THEN 1 END) AS CANCELLED,
       COALESCE(SUM(CASE WHEN NULLIF(TRIM(t.can_rsn_cd), '') IS NOT NULL THEN t.tender_amt ELSE 0 END), 0) AS CANCELLED_AMT,
       COUNT(DISTINCT t.payor_acct_id) AS PAYOR_ACCOUNTS
FROM CISADM.CI_PAY_TNDR t
JOIN CISADM.CI_PAY_EVENT e ON e.pay_event_id = t.pay_event_id
LEFT JOIN CISADM.CI_TENDER_TYPE_L tl ON tl.tender_type_cd = t.tender_type_cd AND tl.language_cd = 'ENG'
WHERE e.pay_dt >= $P{FROM_DT} AND e.pay_dt < $P{TO_DT} + INTERVAL '1' DAY
  AND $X{IN, TRIM(t.tender_type_cd), TENDER_TYPE_CD_F}
  AND ($P{PAYOR_ACCT_ID_F} IS NULL OR TRIM(t.payor_acct_id) = TRIM($P{PAYOR_ACCT_ID_F}))
  AND ($P{TNDR_CTL_ID_F} IS NULL OR TRIM(t.tndr_ctl_id) = TRIM($P{TNDR_CTL_ID_F}))
  AND ($P{MIN_AMT_F} IS NULL OR t.tender_amt >= $P{MIN_AMT_F})
GROUP BY TRIM(t.tender_type_cd), COALESCE(tl.descr, TRIM(t.tender_type_cd))
ORDER BY TENDER_AMT DESC
]]></query>
    <parameter name="FROM_DT" class="java.sql.Date">
        <defaultValueExpression><![CDATA[java.sql.Date.valueOf(java.time.LocalDate.now().withDayOfMonth(1).minusMonths(1).toString())]]></defaultValueExpression>
    </parameter>
    <parameter name="TO_DT" class="java.sql.Date">
        <defaultValueExpression><![CDATA[java.sql.Date.valueOf(java.time.LocalDate.now().withDayOfMonth(1).minusDays(1).toString())]]></defaultValueExpression>
    </parameter>
    <parameter name="TENDER_TYPE_CD_F" class="java.util.Collection">
        <defaultValueExpression><![CDATA[null]]></defaultValueExpression>
    </parameter>
    <parameter name="PAYOR_ACCT_ID_F" class="java.lang.String">
        <defaultValueExpression><![CDATA[null]]></defaultValueExpression>
    </parameter>
    <parameter name="TNDR_CTL_ID_F" class="java.lang.String">
        <defaultValueExpression><![CDATA[null]]></defaultValueExpression>
    </parameter>
    <parameter name="MIN_AMT_F" class="java.math.BigDecimal">
        <defaultValueExpression><![CDATA[null]]></defaultValueExpression>
    </parameter>
    <field name="TENDER_TYPE_CD" class="java.lang.String"/>
    <field name="TENDER_TYPE_DESCR" class="java.lang.String"/>
    <field name="TENDERS" class="java.lang.Long"/>
    <field name="TENDER_AMT" class="java.math.BigDecimal"/>
    <field name="CANCELLED" class="java.lang.Long"/>
    <field name="CANCELLED_AMT" class="java.math.BigDecimal"/>
    <field name="PAYOR_ACCOUNTS" class="java.lang.Long"/>
    <variable name="SUM_TENDERS" class="java.lang.Long" calculation="Sum">
        <expression><![CDATA[$F{TENDERS}]]></expression>
    </variable>
    <variable name="SUM_TENDER_AMT" class="java.math.BigDecimal" calculation="Sum">
        <expression><![CDATA[$F{TENDER_AMT}]]></expression>
    </variable>
    <variable name="SUM_CANCELLED" class="java.lang.Long" calculation="Sum">
        <expression><![CDATA[$F{CANCELLED}]]></expression>
    </variable>
    <variable name="SUM_CANCELLED_AMT" class="java.math.BigDecimal" calculation="Sum">
        <expression><![CDATA[$F{CANCELLED_AMT}]]></expression>
    </variable>
    <variable name="SUM_PAYOR_ACCOUNTS" class="java.lang.Long" calculation="Sum">
        <expression><![CDATA[$F{PAYOR_ACCOUNTS}]]></expression>
    </variable>
    <title height="52">
            <element kind="textField" x="0" y="0" width="802" height="26" style="TitleSapphire" hTextAlign="Left" vTextAlign="Middle" blankWhenNull="true" textAdjust="StretchHeight"><expression><![CDATA["Payments by Tender Type"]]></expression></element>
            <element kind="textField" x="0" y="28" width="802" height="16" style="H3" hTextAlign="Left" vTextAlign="Middle" blankWhenNull="true" textAdjust="StretchHeight"><expression><![CDATA["Payment date " + new java.text.SimpleDateFormat("yyyy-MM-dd").format($P{FROM_DT}) + " to " + new java.text.SimpleDateFormat("yyyy-MM-dd").format($P{TO_DT}) + "  |  cancelled = tender carries a cancel reason" + ($P{TENDER_TYPE_CD_F} == null || $P{TENDER_TYPE_CD_F}.isEmpty() ? "" : "  |  Tender types: " + String.join(", ", $P{TENDER_TYPE_CD_F})) + ($P{PAYOR_ACCT_ID_F} == null ? "" : "  |  Payor account ID: " + $P{PAYOR_ACCT_ID_F}) + ($P{TNDR_CTL_ID_F} == null ? "" : "  |  Tender control ID: " + $P{TNDR_CTL_ID_F}) + ($P{MIN_AMT_F} == null ? "" : "  |  Minimum tender amount: " + $P{MIN_AMT_F})]]></expression></element>
    </title>
    <columnHeader height="18">
            <element kind="staticText" x="0" y="0" width="60" height="18" style="HeaderSapphire" hTextAlign="Center" vTextAlign="Middle"><text><![CDATA[Type]]></text></element>
            <element kind="staticText" x="60" y="0" width="232" height="18" style="HeaderSapphire" hTextAlign="Center" vTextAlign="Middle"><text><![CDATA[Tender Type]]></text></element>
            <element kind="staticText" x="292" y="0" width="80" height="18" style="HeaderSapphire" hTextAlign="Center" vTextAlign="Middle"><text><![CDATA[Tenders]]></text></element>
            <element kind="staticText" x="372" y="0" width="120" height="18" style="HeaderSapphire" hTextAlign="Center" vTextAlign="Middle"><text><![CDATA[Amount]]></text></element>
            <element kind="staticText" x="492" y="0" width="80" height="18" style="HeaderSapphire" hTextAlign="Center" vTextAlign="Middle"><text><![CDATA[Cancelled]]></text></element>
            <element kind="staticText" x="572" y="0" width="120" height="18" style="HeaderSapphire" hTextAlign="Center" vTextAlign="Middle"><text><![CDATA[Cancelled Amt]]></text></element>
            <element kind="staticText" x="692" y="0" width="110" height="18" style="HeaderSapphire" hTextAlign="Center" vTextAlign="Middle"><text><![CDATA[Payors]]></text></element>
    </columnHeader>
    <detail>
        <band height="22" splitType="Prevent">
            <element kind="line" x="0" y="2" width="802" height="1"><pen lineWidth="0.75" lineColor="#006FAC"/></element>
            <element kind="textField" x="0" y="3" width="60" height="18" style="RowBand" hTextAlign="Left" vTextAlign="Middle" blankWhenNull="true" textAdjust="StretchHeight"><expression><![CDATA[$F{TENDER_TYPE_CD}]]></expression></element>
            <element kind="textField" x="60" y="3" width="232" height="18" style="RowBand" hTextAlign="Left" vTextAlign="Middle" blankWhenNull="true" textAdjust="StretchHeight"><expression><![CDATA[$F{TENDER_TYPE_DESCR}]]></expression></element>
            <element kind="textField" x="292" y="3" width="80" height="18" style="RowBand" hTextAlign="Right" vTextAlign="Middle" blankWhenNull="true" textAdjust="StretchHeight" pattern="#,##0"><expression><![CDATA[$F{TENDERS}]]></expression></element>
            <element kind="textField" x="372" y="3" width="120" height="18" style="RowBand" hTextAlign="Right" vTextAlign="Middle" blankWhenNull="true" textAdjust="StretchHeight" pattern="#,##0.00;(#,##0.00)"><expression><![CDATA[$F{TENDER_AMT}]]></expression></element>
            <element kind="textField" x="492" y="3" width="80" height="18" style="RowBand" hTextAlign="Right" vTextAlign="Middle" blankWhenNull="true" textAdjust="StretchHeight" pattern="#,##0"><expression><![CDATA[$F{CANCELLED}]]></expression></element>
            <element kind="textField" x="572" y="3" width="120" height="18" style="RowBand" hTextAlign="Right" vTextAlign="Middle" blankWhenNull="true" textAdjust="StretchHeight" pattern="#,##0.00;(#,##0.00)"><expression><![CDATA[$F{CANCELLED_AMT}]]></expression></element>
            <element kind="textField" x="692" y="3" width="110" height="18" style="RowBand" hTextAlign="Right" vTextAlign="Middle" blankWhenNull="true" textAdjust="StretchHeight" pattern="#,##0"><expression><![CDATA[$F{PAYOR_ACCOUNTS}]]></expression></element>
        </band>
        <band height="20" splitType="Stretch">
            <element kind="subreport" x="24" y="0" width="778" height="20" positionType="Float" removeLineWhenBlank="true" usingCache="false">
                <parameter name="FROM_DT"><expression><![CDATA[$P{FROM_DT}]]></expression></parameter>
                <parameter name="TO_DT"><expression><![CDATA[$P{TO_DT}]]></expression></parameter>
                <parameter name="TENDER_TYPE_CD_F"><expression><![CDATA[$P{TENDER_TYPE_CD_F}]]></expression></parameter>
                <parameter name="PAYOR_ACCT_ID_F"><expression><![CDATA[$P{PAYOR_ACCT_ID_F}]]></expression></parameter>
                <parameter name="TNDR_CTL_ID_F"><expression><![CDATA[$P{TNDR_CTL_ID_F}]]></expression></parameter>
                <parameter name="MIN_AMT_F"><expression><![CDATA[$P{MIN_AMT_F}]]></expression></parameter>
                <parameter name="TENDER_TYPE_CD"><expression><![CDATA[$F{TENDER_TYPE_CD}]]></expression></parameter>
                <connectionExpression><![CDATA[$P{REPORT_CONNECTION}]]></connectionExpression>
                <expression><![CDATA["repo:payments_by_tender_type_month"]]></expression>
            </element>
        </band>
    </detail>
    <pageFooter height="14">
            <element kind="textField" x="0" y="0" width="600" height="14" style="FooterConfidential" hTextAlign="Left" vTextAlign="Middle" blankWhenNull="true" textAdjust="StretchHeight"><expression><![CDATA["@2026, Origin Utility, Inc / Proprietary & Confidential"]]></expression></element>
            <element kind="textField" x="600" y="0" width="150" height="14" style="FooterConfidential" hTextAlign="Right" vTextAlign="Middle" blankWhenNull="true" textAdjust="StretchHeight"><expression><![CDATA["Page " + $V{PAGE_NUMBER} + " of"]]></expression></element>
            <element kind="textField" x="750" y="0" width="52" height="14" style="FooterConfidential" hTextAlign="Left" vTextAlign="Middle" blankWhenNull="true" textAdjust="StretchHeight" evaluationTime="Report"><expression><![CDATA[" " + $V{PAGE_NUMBER}]]></expression></element>
    </pageFooter>
    <summary height="24">
            <element kind="line" x="0" y="2" width="802" height="1"><pen lineWidth="1.0" lineColor="#006FAC"/></element>
            <element kind="staticText" x="0" y="4" width="60" height="18" style="TotalText" hTextAlign="Left" vTextAlign="Middle"><text><![CDATA[Total]]></text></element>
            <element kind="staticText" x="60" y="4" width="232" height="18" style="TotalText" hTextAlign="Left" vTextAlign="Middle"><text><![CDATA[]]></text></element>
            <element kind="textField" x="292" y="4" width="80" height="18" style="TotalText" hTextAlign="Right" vTextAlign="Middle" blankWhenNull="true" textAdjust="StretchHeight" pattern="#,##0"><expression><![CDATA[$V{SUM_TENDERS}]]></expression></element>
            <element kind="textField" x="372" y="4" width="120" height="18" style="TotalText" hTextAlign="Right" vTextAlign="Middle" blankWhenNull="true" textAdjust="StretchHeight" pattern="#,##0.00;(#,##0.00)"><expression><![CDATA[$V{SUM_TENDER_AMT}]]></expression></element>
            <element kind="textField" x="492" y="4" width="80" height="18" style="TotalText" hTextAlign="Right" vTextAlign="Middle" blankWhenNull="true" textAdjust="StretchHeight" pattern="#,##0"><expression><![CDATA[$V{SUM_CANCELLED}]]></expression></element>
            <element kind="textField" x="572" y="4" width="120" height="18" style="TotalText" hTextAlign="Right" vTextAlign="Middle" blankWhenNull="true" textAdjust="StretchHeight" pattern="#,##0.00;(#,##0.00)"><expression><![CDATA[$V{SUM_CANCELLED_AMT}]]></expression></element>
            <element kind="textField" x="692" y="4" width="110" height="18" style="TotalText" hTextAlign="Right" vTextAlign="Middle" blankWhenNull="true" textAdjust="StretchHeight" pattern="#,##0"><expression><![CDATA[$V{SUM_PAYOR_ACCOUNTS}]]></expression></element>
    </summary>
</jasperReport>
