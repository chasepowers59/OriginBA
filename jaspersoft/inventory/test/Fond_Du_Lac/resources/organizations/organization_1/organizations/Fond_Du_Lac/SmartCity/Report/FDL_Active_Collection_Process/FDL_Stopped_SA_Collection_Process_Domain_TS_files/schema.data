        <item id="COLL_PROC_ID" label="Collection Process ID" resourceId="JoinTree_1.CI_COLL_PROC_SA.COLL_PROC_ID"></item>
        <item id="COLL_SA_STAT_FLG" label="Status" resourceId="JoinTree_1.CI_COLL_PROC_SA.COLL_SA_STAT_FLG"></item>
        <item id="CURRENCY_CD" label="Currency Code" resourceId="JoinTree_1.CI_COLL_PROC_SA.CURRENCY_CD"></item>
        <item id="SA_ID_1" label="Service Agreement" resourceId="JoinTree_1.CI_COLL_PROC_SA.SA_ID"></item>
      </items>
    </itemGroup>
    <itemGroup id="STOPPED_SA" label="Stopped Service Agreements" resourceId="JoinTree_1">
      <items>
        <item id="END_DT" label="End Date" resourceId="JoinTree_1.STOPPED_SA.END_DT"></item>
        <item id="SA_ID" label="Service Agreement" resourceId="JoinTree_1.STOPPED_SA.SA_ID"></item>
      </items>
    </itemGroup>
    <itemGroup id="FDL_CHAR_PREM" label="FDL_CHAR_PREM" resourceId="JoinTree_1">
