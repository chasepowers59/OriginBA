    <itemGroup id="CI_PREM_GEO" label="CI_PREM_GEO" resourceId="JoinTree_1">
      <items>
        <item id="GEO_TYPE_CD" label="GEO_TYPE_CD" resourceId="JoinTree_1.CI_PREM_GEO.GEO_TYPE_CD"></item>
        <item id="GEO_VAL" label="GEO_VAL" resourceId="JoinTree_1.CI_PREM_GEO.GEO_VAL"></item>
        <item id="PREM_ID" label="PREM_ID" resourceId="JoinTree_1.CI_PREM_GEO.PREM_ID"></item>
        <item id="VERSION" label="VERSION" resourceId="JoinTree_1.CI_PREM_GEO.VERSION"></item>
      </items>
    </itemGroup>
  </itemGroups>
  <resources>
    <jdbcTable id="CI_COLL_PROC" datasourceId="FondDuLac_DS" datasourceTableName="CI_COLL_PROC" schemaAlias="CISADM">
      <fieldList>
        <field id="COLL_PROC_ID" type="java.lang.String"></field>
        <field id="COLL_PROC_TMPL_CD" type="java.lang.String"></field>
        <field id="COLL_CL_CNTL_CD" type="java.lang.String"></field>
        <field id="ACCT_ID" type="java.lang.String"></field>
        <field id="CURRENCY_CD" type="java.lang.String"></field>
        <field id="COLL_STATUS_FLG" type="java.lang.String"></field>
        <field id="COLL_STAT_RSN_FLG" type="java.lang.String"></field>
        <field id="COLL_CAT_PRIO_FLG" type="java.lang.String"></field>
        <field id="CRIT_PRIO_FLG" type="java.lang.String"></field>
        <field id="CRE_DTTM" type="java.sql.Timestamp"></field>
        <field id="COLL_ARS_DT" type="java.sql.Timestamp"></field>
        <field id="ARS_AMT" type="java.math.BigDecimal"></field>
        <field id="TRIGGER_BP_SW" type="java.lang.String"></field>
        <field id="COMMENTS" type="java.lang.String"></field>
        <field id="VERSION" type="java.math.BigDecimal"></field>
      </fieldList>
    </jdbcTable>
    <jdbcTable id="CI_COLL_PROC_SA" datasourceId="FondDuLac_DS" datasourceTableName="CI_COLL_PROC_SA" schemaAlias="CISADM">
      <fieldList>
        <field id="COLL_PROC_ID" type="java.lang.String"></field>
        <field id="SA_ID" type="java.lang.String"></field>
        <field id="CURRENCY_CD" type="java.lang.String"></field>
        <field id="COLL_SA_STAT_FLG" type="java.lang.String"></field>
        <field id="ARS_AMT" type="java.math.BigDecimal"></field>
        <field id="VERSION" type="java.math.BigDecimal"></field>
      </fieldList>
    </jdbcTable>
    <jdbcTable id="CI_PREM_GEO" datasourceId="FondDuLac_DS" datasourceTableName="CI_PREM_GEO" schemaAlias="CISADM">
      <fieldList>
        <field id="PREM_ID" type="java.lang.String"></field>
        <field id="GEO_TYPE_CD" type="java.lang.String"></field>
        <field id="GEO_VAL" type="java.lang.String"></field>
        <field id="VERSION" type="java.math.BigDecimal"></field>
      </fieldList>
      <filterString>GEO_TYPE_CD == 'PARCELSH'</filterString>
    </jdbcTable>
    <jdbcTable id="CI_PREM_CHAR" datasourceId="FondDuLac_DS" datasourceTableName="CI_PREM_CHAR" schemaAlias="CISADM">
      <fieldList>
        <field id="PREM_ID" type="java.lang.String"></field>
        <field id="CHAR_TYPE_CD" type="java.lang.String"></field>
        <field id="CHAR_VAL" type="java.lang.String"></field>
        <field id="EFFDT" type="java.sql.Timestamp"></field>
        <field id="VERSION" type="java.math.BigDecimal"></field>
        <field id="ADHOC_CHAR_VAL" type="java.lang.String"></field>
        <field id="CHAR_VAL_FK1" type="java.lang.String"></field>
        <field id="CHAR_VAL_FK2" type="java.lang.String"></field>
        <field id="CHAR_VAL_FK3" type="java.lang.String"></field>
        <field id="CHAR_VAL_FK4" type="java.lang.String"></field>
        <field id="CHAR_VAL_FK5" type="java.lang.String"></field>
        <field id="SRCH_CHAR_VAL" type="java.lang.String"></field>
      </fieldList>
    </jdbcTable>
    <jdbcQuery id="STOPPED_SA" datasourceId="FondDuLac_DS">
      <fieldList>
        <field id="SA_ID" type="java.lang.String"></field>
        <field id="END_DT" type="java.sql.Timestamp"></field>
      </fieldList>
      <query>SELECT SA_ID, END_DT from CISADM.CI_SA where SA_STATUS_FLG='40'</query>
    </jdbcQuery>
    <jdbcQuery id="FDL_CHAR_PREM" datasourceId="FondDuLac_DS">
      <fieldList>
        <field id="CHAR_PREM_ID" type="java.lang.String"></field>
        <field id="ACCT_ID" type="java.lang.String"></field>
      </fieldList>
      <query>SELECT DISTINCT CHAR_PREM_ID, ACCT_ID
FROM CISADM.CI_SA</query>
    </jdbcQuery>
    <jdbcQuery id="JoinTree_1" datasourceId="FondDuLac_DS">
      <fieldList>
        <field id="STOPPED_SA.SA_ID" type="java.lang.String"></field>
        <field id="STOPPED_SA.END_DT" type="java.sql.Timestamp"></field>
        <field id="CI_COLL_PROC.COLL_PROC_ID" type="java.lang.String"></field>
        <field id="CI_COLL_PROC.COLL_PROC_TMPL_CD" type="java.lang.String"></field>
        <field id="CI_COLL_PROC.COLL_CL_CNTL_CD" type="java.lang.String"></field>
        <field id="CI_COLL_PROC.ACCT_ID" type="java.lang.String"></field>
        <field id="CI_COLL_PROC.CURRENCY_CD" type="java.lang.String"></field>
        <field id="CI_COLL_PROC.COLL_STATUS_FLG" type="java.lang.String"></field>
        <field id="CI_COLL_PROC.COLL_STAT_RSN_FLG" type="java.lang.String"></field>
        <field id="CI_COLL_PROC.COLL_CAT_PRIO_FLG" type="java.lang.String"></field>
        <field id="CI_COLL_PROC.CRIT_PRIO_FLG" type="java.lang.String"></field>
        <field id="CI_COLL_PROC.CRE_DTTM" type="java.sql.Timestamp"></field>
        <field id="CI_COLL_PROC.COLL_ARS_DT" type="java.sql.Timestamp"></field>
        <field id="CI_COLL_PROC.ARS_AMT" type="java.math.BigDecimal"></field>
        <field id="CI_COLL_PROC.TRIGGER_BP_SW" type="java.lang.String"></field>
        <field id="CI_COLL_PROC.COMMENTS" type="java.lang.String"></field>
        <field id="CI_COLL_PROC.VERSION" type="java.math.BigDecimal"></field>
        <field id="FDL_CHAR_PREM.CHAR_PREM_ID" type="java.lang.String"></field>
        <field id="FDL_CHAR_PREM.ACCT_ID" type="java.lang.String"></field>
        <field id="CI_PREM_GEO.PREM_ID" type="java.lang.String"></field>
        <field id="CI_PREM_GEO.GEO_TYPE_CD" type="java.lang.String"></field>
        <field id="CI_PREM_GEO.GEO_VAL" type="java.lang.String"></field>
        <field id="CI_PREM_GEO.VERSION" type="java.math.BigDecimal"></field>
        <field id="CI_COLL_PROC_SA.COLL_PROC_ID" type="java.lang.String"></field>
        <field id="CI_COLL_PROC_SA.SA_ID" type="java.lang.String"></field>
        <field id="CI_COLL_PROC_SA.CURRENCY_CD" type="java.lang.String"></field>
        <field id="CI_COLL_PROC_SA.COLL_SA_STAT_FLG" type="java.lang.String"></field>
        <field id="CI_COLL_PROC_SA.ARS_AMT" type="java.math.BigDecimal"></field>
        <field id="CI_COLL_PROC_SA.VERSION" type="java.math.BigDecimal"></field>
      </fieldList>
      <filterString>CI_PREM_GEO.GEO_TYPE_CD == 'PARCELSH'</filterString>
      <joinInfo alias="STOPPED_SA" referenceId="STOPPED_SA"></joinInfo>
      <joinList>
        <join expr="STOPPED_SA.SA_ID == CI_COLL_PROC_SA.SA_ID" left="STOPPED_SA" right="CI_COLL_PROC_SA" type="inner" weight="1"></join>
        <join expr="CI_COLL_PROC_SA.COLL_PROC_ID == CI_COLL_PROC.COLL_PROC_ID" left="CI_COLL_PROC_SA" right="CI_COLL_PROC" type="inner" weight="1"></join>
        <join expr="CI_PREM_GEO.PREM_ID == FDL_CHAR_PREM.CHAR_PREM_ID" left="CI_PREM_GEO" right="FDL_CHAR_PREM" type="inner" weight="1"></join>
        <join expr="CI_COLL_PROC.ACCT_ID == FDL_CHAR_PREM.ACCT_ID" left="CI_COLL_PROC" right="FDL_CHAR_PREM" type="inner" weight="1"></join>
      </joinList>
      <joinOptions></joinOptions>
      <query>SELECT SA_ID, END_DT from CISADM.CI_SA where SA_STATUS_FLG='40'</query>
      <tableRefList>
        <tableRef alwaysIncludeTable="false" tableAlias="CI_PREM_GEO" tableId="CI_PREM_GEO"></tableRef>
        <tableRef alwaysIncludeTable="false" tableAlias="STOPPED_SA" tableId="STOPPED_SA"></tableRef>
        <tableRef alwaysIncludeTable="false" tableAlias="CI_COLL_PROC" tableId="CI_COLL_PROC"></tableRef>
        <tableRef alwaysIncludeTable="false" tableAlias="FDL_CHAR_PREM" tableId="FDL_CHAR_PREM"></tableRef>
        <tableRef alwaysIncludeTable="false" tableAlias="CI_COLL_PROC_SA" tableId="CI_COLL_PROC_SA"></tableRef>
      </tableRefList>
    </jdbcQuery>
  </resources>
</schema>
