        <join expr="STOPPED_SA.SA_ID == CI_COLL_PROC_SA.SA_ID" left="STOPPED_SA" right="CI_COLL_PROC_SA" type="inner" weight="1"></join>
        <join expr="CI_COLL_PROC_SA.COLL_PROC_ID == CI_COLL_PROC.COLL_PROC_ID" left="CI_COLL_PROC_SA" right="CI_COLL_PROC" type="inner" weight="1"></join>
        <join expr="CI_COLL_PROC.ACCT_ID == FDL_CHAR_PREM.ACCT_ID" left="CI_COLL_PROC" right="FDL_CHAR_PREM" type="leftOuter" weight="1"></join>
        <join expr="FDL_CHAR_PREM.CHAR_PREM_ID == CI_PREM_GEO.PREM_ID" left="FDL_CHAR_PREM" right="CI_PREM_GEO" type="rightOuter" weight="1"></join>
        <join expr="FDL_CHAR_PREM.CHAR_PREM_ID == CI_PREM.PREM_ID" left="FDL_CHAR_PREM" right="CI_PREM" type="inner" weight="1"></join>
      </joinList>
      <joinOptions suppressCircularJoins="true"></joinOptions>
      <query>SELECT SA_ID, END_DT from CISADM.CI_SA where SA_STATUS_FLG='40'</query>
