    <jdbcQuery id="FDL_CHAR_PREM" datasourceId="FondDuLac_DS">
      <fieldList>
        <field id="CHAR_PREM_ID" type="java.lang.String"></field>
        <field id="ACCT_ID" type="java.lang.String"></field>
      </fieldList>
      <query>SELECT DISTINCT CHAR_PREM_ID, ACCT_ID
FROM CISADM.CI_SA where sa_status_flg = '20'</query>
    </jdbcQuery>
    <jdbcQuery id="JoinTree_1" datasourceId="FondDuLac_DS">
      <fieldList>
