        <field id="BSEG_STAT_FLG" type="java.lang.String"></field>
        <field id="CRE_DTTM" type="java.sql.Timestamp"></field>
        <field id="STAT_CHG_DTTM" type="java.sql.Timestamp"></field>
        <field id="REBILL_SEG_ID" type="java.lang.String"></field>
        <field id="VERSION" type="java.math.BigDecimal"></field>
        <field id="MASTER_BSEG_ID" type="java.lang.String"></field>
        <field id="QUOTE_DTL_ID" type="java.lang.String"></field>
        <field id="BILL_SCNR_ID" type="java.lang.String"></field>
        <field id="MDM_START_DTTM" type="java.sql.Timestamp"></field>
        <field id="MDM_END_DTTM" type="java.sql.Timestamp"></field>
        <field id="BSEG_DATA_AREA" type="java.lang.String"></field>
        <field id="ILM_DT" type="java.sql.Timestamp"></field>
        <field id="ILM_ARCH_SW" type="java.lang.String"></field>
      </fieldList>
      <query>select * from cisadm.ci_bseg a where a.end_dt = (select max(b.end_dt) from cisadm.ci_bseg b where a.sa_id = b.sa_id)</query>
    </jdbcQuery>
