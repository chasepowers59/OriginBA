<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.jaspersoft.com/2007/SL/XMLSchema" version="1.3">
  <dataIslands>
    <itemGroup id="JoinTree_1" label="JoinTree_1" resourceId="JoinTree_1"></itemGroup>
  </dataIslands>
  <itemGroups>
    <itemGroup id="FDL_AGED_90" label="FDL_AGED_90" resourceId="JoinTree_1">
      <items>
        <item id="AMOUNT_1" label="90 Days" resourceId="JoinTree_1.FDL_AGED_90.AMOUNT"></item>
      </items>
    </itemGroup>
    <itemGroup id="FDL_AGED_CURRENT" label="FDL_AGED_CURRENT" resourceId="JoinTree_1">
      <items>
        <item id="AMOUNT" label="Current" resourceId="JoinTree_1.FDL_AGED_CURRENT.AMOUNT"></item>
        <item id="DST_ID_1" label="Distribution Code" resourceId="JoinTree_1.FDL_AGED_CURRENT.DST_ID"></item>
        <item id="FT_ID" label="FT Id" resourceId="JoinTree_1.FDL_AGED_CURRENT.FT_ID"></item>
        <item id="DESCR" label="Distribution" resourceId="JoinTree_1.FDL_AGED_CURRENT.DESCR"></item>
      </items>
    </itemGroup>
    <itemGroup id="FDL_AGED_DETAILS" label="FDL_AGED_DETAILS" resourceId="JoinTree_1">
      <items>
        <item id="ACCT_ID" label="Account Id" resourceId="JoinTree_1.FDL_AGED_DETAILS.ACCT_ID"></item>
        <item id="ADDRESS1" label="Address 1" resourceId="JoinTree_1.FDL_AGED_DETAILS.ADDRESS1"></item>
        <item id="BILL_CYC_CD" label="Bill Cycle Code" resourceId="JoinTree_1.FDL_AGED_DETAILS.BILL_CYC_CD"></item>
        <item id="ENTITY_NAME" label="Entity Name" resourceId="JoinTree_1.FDL_AGED_DETAILS.ENTITY_NAME"></item>
        <item id="SA_ID" label="Service Agreement Id" resourceId="JoinTree_1.FDL_AGED_DETAILS.SA_ID"></item>
        <item id="SA_TYPE_CD" label="SA Type" resourceId="JoinTree_1.FDL_AGED_DETAILS.SA_TYPE_CD"></item>
      </items>
    </itemGroup>
    <itemGroup id="FDL_AGED_180" label="FDL_AGED_180" resourceId="JoinTree_1">
      <items>
        <item id="AMOUNT_2" label="180 Days" resourceId="JoinTree_1.FDL_AGED_180.AMOUNT"></item>
      </items>
    </itemGroup>
    <itemGroup id="FDL_AGED_270" label="FDL_AGED_270" resourceId="JoinTree_1">
      <items>
        <item id="AMOUNT_3" label="270 Days" resourceId="JoinTree_1.FDL_AGED_270.AMOUNT"></item>
      </items>
    </itemGroup>
    <itemGroup id="FDL_AGED_OLD" label="FDL_AGED_OLD" resourceId="JoinTree_1">
      <items>
        <item id="AMOUNT_4" label="271 Days and older" resourceId="JoinTree_1.FDL_AGED_OLD.AMOUNT"></item>
      </items>
    </itemGroup>
  </itemGroups>
  <resources>
    <jdbcQuery id="FDL_AGED_DETAILS" datasourceId="FondDuLac_DS">
      <fieldList>
        <field id="BILL_CYC_CD" type="java.lang.String"></field>
        <field id="SA_TYPE_CD" type="java.lang.String"></field>
        <field id="ADDRESS1" type="java.lang.String"></field>
        <field id="ACCT_ID" type="java.lang.String"></field>
        <field id="SA_ID" type="java.lang.String"></field>
        <field id="ENTITY_NAME" type="java.lang.String"></field>
        <field id="DST_ID" type="java.lang.String"></field>
      </fieldList>
      <query>SELECT
    a.bill_cyc_cd,
    sa.sa_type_cd,
    p.address1,
    a.acct_id,
    sa.sa_id,
    sat.dst_id,
    pn.entity_name

FROM
         cisadm.ci_acct a
    JOIN cisadm.ci_acct_per      ap ON a.acct_id = ap.acct_id
                                  AND main_cust_sw = 'Y'
    JOIN cisadm.ci_per_name      pn ON ap.per_id = pn.per_id
                                  AND pn.prim_name_sw = 'Y'
    JOIN cisadm.ci_sa            sa ON a.acct_id = sa.acct_id
                            AND sa.sa_type_cd IN (
        SELECT
            sa_type_cd
        FROM
            cisadm.ci_sa_type
        WHERE
                allow_billing_sw = 'Y'
            AND prem_req_sw = 'Y'
    )
    join cisadm.ci_sa_type  sat on sa.sa_type_cd = sat.sa_type_cd
    JOIN cisadm.ci_prem          p ON sa.char_prem_id = p.prem_id</query>
    </jdbcQuery>
    <jdbcQuery id="FDL_AGED_CURRENT" datasourceId="FondDuLac_DS">
      <fieldList>
        <field id="SA_ID" type="java.lang.String"></field>
        <field id="FT_ID" type="java.lang.String"></field>
        <field id="DST_ID" type="java.lang.String"></field>
        <field id="AMOUNT" type="java.math.BigDecimal"></field>
        <field id="DESCR" type="java.lang.String"></field>
      </fieldList>
      <query>select Ft.ft_id,ft.sa_id,ftgl.dst_id,dst.descr,ftgl.amount from cisadm.ci_ft_gl ftgl, cisadm.ci_ft ft , cisadm.ci_dst_code_l dst where ft.ft_id = ftgl.ft_id and ftgl.dst_id = dst.dst_id</query>
    </jdbcQuery>
    <jdbcQuery id="FDL_AGED_OLD" datasourceId="FondDuLac_DS">
      <fieldList>
        <field id="FT_ID" type="java.lang.String"></field>
        <field id="SA_ID" type="java.lang.String"></field>
        <field id="DST_ID" type="java.lang.String"></field>
        <field id="DESCR" type="java.lang.String"></field>
        <field id="AMOUNT" type="java.math.BigDecimal"></field>
      </fieldList>
      <query>select Ft.ft_id,ft.sa_id,ftgl.dst_id,dst.descr,ftgl.amount from cisadm.ci_ft_gl ftgl, cisadm.ci_ft ft , cisadm.ci_dst_code_l dst where ft.ars_dt &lt;= trunc(sysdate) - 271 
and ft.ft_id = ftgl.ft_id and ftgl.dst_id = dst.dst_id</query>
    </jdbcQuery>
    <jdbcQuery id="FDL_AGED_90" datasourceId="FondDuLac_DS">
      <fieldList>
        <field id="FT_ID" type="java.lang.String"></field>
        <field id="SA_ID" type="java.lang.String"></field>
        <field id="DST_ID" type="java.lang.String"></field>
        <field id="DESCR" type="java.lang.String"></field>
        <field id="AMOUNT" type="java.math.BigDecimal"></field>
      </fieldList>
      <query>select Ft.ft_id,ft.sa_id,ftgl.dst_id,dst.descr,ftgl.amount from cisadm.ci_ft_gl ftgl, cisadm.ci_ft ft , cisadm.ci_dst_code_l dst where ft.ars_dt BETWEEN ( trunc(sysdate) - 90 ) AND trunc(sysdate) 
and ft.ft_id = ftgl.ft_id and ftgl.dst_id = dst.dst_id</query>
    </jdbcQuery>
    <jdbcQuery id="FDL_AGED_270" datasourceId="FondDuLac_DS">
      <fieldList>
        <field id="FT_ID" type="java.lang.String"></field>
        <field id="SA_ID" type="java.lang.String"></field>
        <field id="DST_ID" type="java.lang.String"></field>
        <field id="DESCR" type="java.lang.String"></field>
        <field id="AMOUNT" type="java.math.BigDecimal"></field>
      </fieldList>
      <query>select Ft.ft_id,ft.sa_id,ftgl.dst_id,dst.descr,ftgl.amount from cisadm.ci_ft_gl ftgl, cisadm.ci_ft ft , cisadm.ci_dst_code_l dst where ft.ars_dt BETWEEN ( trunc(sysdate) - 270 ) AND trunc(sysdate) - 181 
and ft.ft_id = ftgl.ft_id and ftgl.dst_id = dst.dst_id</query>
    </jdbcQuery>
    <jdbcQuery id="FDL_AGED_180" datasourceId="FondDuLac_DS">
      <fieldList>
        <field id="FT_ID" type="java.lang.String"></field>
        <field id="SA_ID" type="java.lang.String"></field>
        <field id="DST_ID" type="java.lang.String"></field>
        <field id="DESCR" type="java.lang.String"></field>
        <field id="AMOUNT" type="java.math.BigDecimal"></field>
      </fieldList>
      <query>select Ft.ft_id,ft.sa_id,ftgl.dst_id,dst.descr,ftgl.amount from cisadm.ci_ft_gl ftgl, cisadm.ci_ft ft , cisadm.ci_dst_code_l dst where ft.ars_dt BETWEEN ( trunc(sysdate) - 180 ) AND trunc(sysdate) - 91 
and ft.ft_id = ftgl.ft_id and ftgl.dst_id = dst.dst_id</query>
    </jdbcQuery>
    <jdbcQuery id="JoinTree_1" datasourceId="FondDuLac_DS">
      <fieldList>
        <field id="FDL_AGED_DETAILS.BILL_CYC_CD" type="java.lang.String"></field>
        <field id="FDL_AGED_DETAILS.SA_TYPE_CD" type="java.lang.String"></field>
        <field id="FDL_AGED_DETAILS.ADDRESS1" type="java.lang.String"></field>
        <field id="FDL_AGED_DETAILS.ACCT_ID" type="java.lang.String"></field>
        <field id="FDL_AGED_DETAILS.SA_ID" type="java.lang.String"></field>
        <field id="FDL_AGED_DETAILS.ENTITY_NAME" type="java.lang.String"></field>
        <field id="FDL_AGED_DETAILS.DST_ID" type="java.lang.String"></field>
        <field id="FDL_AGED_CURRENT.SA_ID" type="java.lang.String"></field>
        <field id="FDL_AGED_CURRENT.FT_ID" type="java.lang.String"></field>
        <field id="FDL_AGED_CURRENT.DST_ID" type="java.lang.String"></field>
        <field id="FDL_AGED_CURRENT.AMOUNT" type="java.math.BigDecimal"></field>
        <field id="FDL_AGED_CURRENT.DESCR" type="java.lang.String"></field>
        <field id="FDL_AGED_90.FT_ID" type="java.lang.String"></field>
        <field id="FDL_AGED_90.SA_ID" type="java.lang.String"></field>
        <field id="FDL_AGED_90.DST_ID" type="java.lang.String"></field>
        <field id="FDL_AGED_90.DESCR" type="java.lang.String"></field>
        <field id="FDL_AGED_90.AMOUNT" type="java.math.BigDecimal"></field>
        <field id="FDL_AGED_OLD.FT_ID" type="java.lang.String"></field>
        <field id="FDL_AGED_OLD.SA_ID" type="java.lang.String"></field>
        <field id="FDL_AGED_OLD.DST_ID" type="java.lang.String"></field>
        <field id="FDL_AGED_OLD.DESCR" type="java.lang.String"></field>
        <field id="FDL_AGED_OLD.AMOUNT" type="java.math.BigDecimal"></field>
        <field id="FDL_AGED_270.FT_ID" type="java.lang.String"></field>
        <field id="FDL_AGED_270.SA_ID" type="java.lang.String"></field>
        <field id="FDL_AGED_270.DST_ID" type="java.lang.String"></field>
        <field id="FDL_AGED_270.DESCR" type="java.lang.String"></field>
        <field id="FDL_AGED_270.AMOUNT" type="java.math.BigDecimal"></field>
        <field id="FDL_AGED_180.FT_ID" type="java.lang.String"></field>
        <field id="FDL_AGED_180.SA_ID" type="java.lang.String"></field>
        <field id="FDL_AGED_180.DST_ID" type="java.lang.String"></field>
        <field id="FDL_AGED_180.DESCR" type="java.lang.String"></field>
        <field id="FDL_AGED_180.AMOUNT" type="java.math.BigDecimal"></field>
      </fieldList>
      <joinInfo alias="FDL_AGED_DETAILS" referenceId="FDL_AGED_DETAILS"></joinInfo>
      <joinList>
        <join expr="FDL_AGED_DETAILS.SA_ID == FDL_AGED_CURRENT.SA_ID" left="FDL_AGED_DETAILS" right="FDL_AGED_CURRENT" type="inner" weight="1"></join>
        <join expr="FDL_AGED_DETAILS.SA_ID == FDL_AGED_90.SA_ID" left="FDL_AGED_DETAILS" right="FDL_AGED_90" type="inner" weight="1"></join>
        <join expr="FDL_AGED_DETAILS.SA_ID == FDL_AGED_OLD.SA_ID" left="FDL_AGED_DETAILS" right="FDL_AGED_OLD" type="inner" weight="1"></join>
        <join expr="FDL_AGED_DETAILS.SA_ID == FDL_AGED_270.SA_ID" left="FDL_AGED_DETAILS" right="FDL_AGED_270" type="inner" weight="1"></join>
        <join expr="FDL_AGED_DETAILS.SA_ID == FDL_AGED_180.SA_ID" left="FDL_AGED_DETAILS" right="FDL_AGED_180" type="inner" weight="1"></join>
      </joinList>
      <joinOptions></joinOptions>
      <query>SELECT
    a.bill_cyc_cd,
    sa.sa_type_cd,
    p.address1,
    a.acct_id,
    sa.sa_id,
    sat.dst_id,
    pn.entity_name

FROM
         cisadm.ci_acct a
    JOIN cisadm.ci_acct_per      ap ON a.acct_id = ap.acct_id
                                  AND main_cust_sw = 'Y'
    JOIN cisadm.ci_per_name      pn ON ap.per_id = pn.per_id
                                  AND pn.prim_name_sw = 'Y'
    JOIN cisadm.ci_sa            sa ON a.acct_id = sa.acct_id
                            AND sa.sa_type_cd IN (
        SELECT
            sa_type_cd
        FROM
            cisadm.ci_sa_type
        WHERE
                allow_billing_sw = 'Y'
            AND prem_req_sw = 'Y'
    )
    join cisadm.ci_sa_type  sat on sa.sa_type_cd = sat.sa_type_cd
    JOIN cisadm.ci_prem          p ON sa.char_prem_id = p.prem_id</query>
      <tableRefList>
        <tableRef alwaysIncludeTable="false" tableAlias="FDL_AGED_180" tableId="FDL_AGED_180"></tableRef>
        <tableRef alwaysIncludeTable="false" tableAlias="FDL_AGED_90" tableId="FDL_AGED_90"></tableRef>
        <tableRef alwaysIncludeTable="false" tableAlias="FDL_AGED_270" tableId="FDL_AGED_270"></tableRef>
        <tableRef alwaysIncludeTable="false" tableAlias="FDL_AGED_CURRENT" tableId="FDL_AGED_CURRENT"></tableRef>
        <tableRef alwaysIncludeTable="false" tableAlias="FDL_AGED_OLD" tableId="FDL_AGED_OLD"></tableRef>
        <tableRef alwaysIncludeTable="false" tableAlias="FDL_AGED_DETAILS" tableId="FDL_AGED_DETAILS"></tableRef>
      </tableRefList>
    </jdbcQuery>
  </resources>
</schema>
