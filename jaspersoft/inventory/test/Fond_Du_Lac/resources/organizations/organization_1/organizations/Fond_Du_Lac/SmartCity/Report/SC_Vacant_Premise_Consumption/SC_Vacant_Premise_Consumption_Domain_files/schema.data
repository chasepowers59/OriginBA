      <filterString>D1_SP_IDENTIFIER.SP_ID_TYPE_FLG == 'D1EP' and D1_US_IDENTIFIER.US_ID_TYPE_FLG == 'D2EI' and CI_SA.SA_STATUS_FLG in ('40', '60') and D1_US_SP.D1_USAGE_FLG == 'D1AD'</filterString>
