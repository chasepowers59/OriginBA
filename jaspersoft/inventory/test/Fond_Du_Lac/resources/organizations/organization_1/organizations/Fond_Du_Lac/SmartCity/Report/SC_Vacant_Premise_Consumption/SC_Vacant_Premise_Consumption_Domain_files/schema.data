    <jdbcQuery id="SC_ACTIVE_SA" datasourceId="FondDuLac_DS">
      <fieldList>
        <field id="D1_SP_ID" type="java.lang.String"></field>
      </fieldList>
      <query>SELECT SP.D1_SP_ID
FROM CISADM.D1_SP SP
WHERE SP.D1_SP_ID NOT IN
(SELECT USSP.D1_SP_ID
 FROM CISADM.D1_US_SP USSP 
WHERE USSP.D1_SP_ID = SP.D1_SP_ID 
AND USSP.START_DTTM &lt; SYSDATE 
AND (USSP.D1_STOP_DTTM IS NULL OR USSP.D1_STOP_DTTM &gt; SYSDATE))</query>
    </jdbcQuery>
    <jdbcQuery id="SC_US_START_DTTM" datasourceId="FondDuLac_DS">
      <fieldList>
        <field id="START_DTTM" type="java.sql.Timestamp"></field>
        <field id="D1_SP_ID" type="java.lang.String"></field>
      </fieldList>
      <query>SELECT MAX(START_DTTM) AS START_DTTM, D1_SP_ID 
FROM CISADM.D1_US_SP
GROUP BY D1_SP_ID</query>
    </jdbcQuery>
