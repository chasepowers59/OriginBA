        <join expr="D1_US_SP.US_ID == D1_US_IDENTIFIER.US_ID and D1_US_SP.D1_STOP_DTTM != NULL" left="D1_US_SP" right="D1_US_IDENTIFIER" type="inner" weight="1"></join>
        <join expr="D1_SP_IDENTIFIER.D1_SP_ID == D1_US_SP.D1_SP_ID" left="D1_SP_IDENTIFIER" right="D1_US_SP" type="inner" weight="1"></join>
        <join expr="D1_INSTALL_EVT.D1_SP_ID == D1_US_SP.D1_SP_ID" left="D1_INSTALL_EVT" right="D1_US_SP" type="inner" weight="1"></join>
        <join expr="D1_INSTALL_EVT.DEVICE_CONFIG_ID == D1_MEASR_COMP.DEVICE_CONFIG_ID" left="D1_INSTALL_EVT" right="D1_MEASR_COMP" type="inner" weight="1"></join>
        <join expr="D1_MEASR_COMP.MEASR_COMP_ID == D1_MSRMT.MEASR_COMP_ID" left="D1_MEASR_COMP" right="D1_MSRMT" type="inner" weight="1"></join>
        <join expr="D1_SP_IDENTIFIER.ID_VALUE == CI_PREM.PREM_ID" left="D1_SP_IDENTIFIER" right="CI_PREM" type="inner" weight="1"></join>
        <join expr="D1_MSRMT.MSRMT_LOCAL_DTTM &gt; D1_US_SP.D1_STOP_DTTM" left="D1_MSRMT" right="D1_US_SP" type="inner" weight="1"></join>
        <join expr="D1_MEASR_COMP_TYPE_L.MEASR_COMP_TYPE_CD == D1_MEASR_COMP.MEASR_COMP_TYPE_CD" left="D1_MEASR_COMP_TYPE_L" right="D1_MEASR_COMP" type="inner" weight="1"></join>
        <join expr="D1_SP_IDENTIFIER.D1_SP_ID == D1_INSTALL_EVT.D1_SP_ID" left="D1_SP_IDENTIFIER" right="D1_INSTALL_EVT" type="inner" weight="1"></join>
        <join expr="D1_US_SP.D1_SP_ID == SC_ACTIVE_SA.D1_SP_ID" left="D1_US_SP" right="SC_ACTIVE_SA" type="inner" weight="1"></join>
        <join expr="SC_US_START_DTTM.D1_SP_ID == D1_US_SP.D1_SP_ID and D1_US_SP.START_DTTM == SC_US_START_DTTM.START_DTTM" left="SC_US_START_DTTM" right="D1_US_SP" type="inner" weight="1"></join>
