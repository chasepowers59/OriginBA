        <field id="CI_FT.ARS_DT" type="java.sql.Timestamp"></field>
        <field id="CI_FT.CORRECTION_SW" type="java.lang.String"></field>
        <field id="CI_FT.REDUNDANT_SW" type="java.lang.String"></field>
        <field id="CI_FT.NEW_DEBIT_SW" type="java.lang.String"></field>
        <field id="CI_FT.SHOW_ON_BILL_SW" type="java.lang.String"></field>
        <field id="CI_FT.NOT_IN_ARS_SW" type="java.lang.String"></field>
        <field id="CI_FT.BILL_ID" type="java.lang.String"></field>
        <field id="CI_FT.ACCOUNTING_DT" type="java.sql.Timestamp"></field>
        <field id="CI_FT.VERSION" type="java.math.BigDecimal"></field>
        <field id="CI_FT.XFERRED_OUT_SW" type="java.lang.String"></field>
        <field id="CI_FT.XFER_TO_GL_DT" type="java.sql.Timestamp"></field>
        <field id="CI_FT.GL_DISTRIB_STATUS" type="java.lang.String"></field>
        <field id="CI_FT.SCHED_DISTRIB_DT" type="java.sql.Timestamp"></field>
        <field id="CI_FT.BAL_CTL_GRP_ID" type="java.math.BigDecimal"></field>
        <field id="CI_FT.MATCH_EVT_ID" type="java.lang.String"></field>
