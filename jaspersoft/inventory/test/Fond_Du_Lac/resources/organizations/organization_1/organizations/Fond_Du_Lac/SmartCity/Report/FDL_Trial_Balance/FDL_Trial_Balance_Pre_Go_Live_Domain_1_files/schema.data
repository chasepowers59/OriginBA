        <field id="FREEZE_SW" type="java.lang.String"></field>
      </fieldList>
      <query>select DCL.DST_ID, DCL.DESCR, FT.FREEZE_SW,
    SUM(FT.CUR_AMT), SUM(FT.TOT_AMT) from cisadm.ci_ft FT, cisadm.CI_SA sa, cisadm.ci_sa_type SAT, cisadm.CI_DST_CODE_L DCL
    where FT.SA_ID = SA.SA_ID
          and FT.ars_dt between trunc(sysdate) -180 and trunc(sysdate) - 91
          and SA.SA_TYPE_CD = SAT.SA_TYPE_CD
          and SAT.DST_ID = DCL.DST_ID
    group by DCL.DST_ID, DCL.DESCR, FT.FREEZE_SW</query>
    </jdbcQuery>
    <jdbcQuery id="FDL_TRIAL_BAL_270" datasourceId="FondDuLac_DS">
