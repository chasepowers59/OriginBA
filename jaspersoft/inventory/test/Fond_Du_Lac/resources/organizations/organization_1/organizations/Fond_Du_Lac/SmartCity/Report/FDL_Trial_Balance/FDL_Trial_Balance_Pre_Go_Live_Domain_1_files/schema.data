        <tableRef alwaysIncludeTable="false" tableAlias="FDL_TRIAL_BAL_90" tableId="FDL_TRIAL_BAL_90"></tableRef>
        <tableRef alwaysIncludeTable="false" tableAlias="CI_FT" tableId="CI_FT"></tableRef>
        <tableRef alwaysIncludeTable="false" tableAlias="FDL_TRIAL_BAL_270" tableId="FDL_TRIAL_BAL_270"></tableRef>
        <tableRef alwaysIncludeTable="false" tableAlias="CI_FT_GL" tableId="CI_FT_GL"></tableRef>
        <tableRef alwaysIncludeTable="false" tableAlias="FDL_TRIAL_BAL_180" tableId="FDL_TRIAL_BAL_180"></tableRef>
        <tableRef alwaysIncludeTable="false" tableAlias="FDL_TRIAL_BAL_OLD" tableId="FDL_TRIAL_BAL_OLD"></tableRef>
      </tableRefList>
    </jdbcQuery>
