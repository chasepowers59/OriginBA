<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.jaspersoft.com/2007/SL/XMLSchema" version="1.3">
  <dataIslands>
    <itemGroup id="JoinTree_1" label="JoinTree_1" resourceId="JoinTree_1"></itemGroup>
  </dataIslands>
  <itemGroups>
    <itemGroup id="FDL_TRIAL_BAL_180" label="FDL_TRIAL_BAL_180" resourceId="JoinTree_1">
      <items>
