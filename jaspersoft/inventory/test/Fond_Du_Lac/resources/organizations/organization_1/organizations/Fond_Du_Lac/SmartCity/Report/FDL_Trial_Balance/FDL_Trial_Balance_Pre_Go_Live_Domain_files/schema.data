        <item id="DST_ID" label="Dist Code" resourceId="JoinTree_1.FDL_TRIAL_BAL_O.DST_ID"></item>
        <item id="FREEZE_SW" label="Frozen Switch" resourceId="JoinTree_1.FDL_TRIAL_BAL_O.FREEZE_SW"></item>
