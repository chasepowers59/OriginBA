      <joinInfo alias="FDL_TRIAL_BAL_O" referenceId="FDL_TRIAL_BAL_O"></joinInfo>
      <joinList>
        <join expr="FDL_TRIAL_BAL_O.DST_ID == FDL_TRIAL_BAL_90.DST_ID" left="FDL_TRIAL_BAL_O" right="FDL_TRIAL_BAL_90" type="inner" weight="1"></join>
        <join expr="FDL_TRIAL_BAL_O.DST_ID == FDL_TRIAL_BAL_180.DST_ID" left="FDL_TRIAL_BAL_O" right="FDL_TRIAL_BAL_180" type="inner" weight="1"></join>
        <join expr="FDL_TRIAL_BAL_O.DST_ID == FDL_TRIAL_BAL_270.DST_ID" left="FDL_TRIAL_BAL_O" right="FDL_TRIAL_BAL_270" type="inner" weight="1"></join>
        <join expr="FDL_TRIAL_BAL_O.DST_ID == FDL_TRIAL_BAL_OLD.DST_ID" left="FDL_TRIAL_BAL_O" right="FDL_TRIAL_BAL_OLD" type="inner" weight="1"></join>
      </joinList>
      <joinOptions></joinOptions>
      <query>select DCL.DST_ID, DCL.DESCR, FT.FREEZE_SW,
    SUM(FT.CUR_AMT), SUM(FT.TOT_AMT) from cisadm.ci_ft FT, cisadm.CI_SA sa, cisadm.ci_sa_type SAT, cisadm.CI_DST_CODE_L DCL
