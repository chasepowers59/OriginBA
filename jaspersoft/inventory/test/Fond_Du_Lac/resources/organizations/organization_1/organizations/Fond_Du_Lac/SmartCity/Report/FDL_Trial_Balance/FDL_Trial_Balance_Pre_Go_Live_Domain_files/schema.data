    <item id="SUM_FT_CUR_AMT__5" label="271 Days and Older (Current)" resourceId="JoinTree_1.FDL_TRIAL_BAL_OLD.SUM_FT_CUR_AMT__5"></item>
    <item id="SUM_FT_TOT_AMT__6" label="271 Days and Older (Payoff)" resourceId="JoinTree_1.FDL_TRIAL_BAL_OLD.SUM_FT_TOT_AMT__6"></item>
  </items>
  <resources>
    <jdbcQuery id="FDL_TRIAL_BAL_O" datasourceId="FondDuLac_DS">
      <fieldList>
        <field id="DST_ID" type="java.lang.String"></field>
        <field id="DESCR" type="java.lang.String"></field>
        <field id="SUM_FT_CUR_AMT_" fieldDBName="SUM(FT.CUR_AMT)" type="java.math.BigDecimal"></field>
        <field id="SUM_FT_TOT_AMT_" fieldDBName="SUM(FT.TOT_AMT)" type="java.math.BigDecimal"></field>
        <field id="FREEZE_SW" type="java.lang.String"></field>
      </fieldList>
      <query>select DCL.DST_ID, DCL.DESCR, FT.FREEZE_SW,
    SUM(FT.CUR_AMT), SUM(FT.TOT_AMT) from cisadm.ci_ft FT, cisadm.CI_SA sa, cisadm.ci_sa_type SAT, cisadm.CI_DST_CODE_L DCL
    where FT.SA_ID = SA.SA_ID
          and SA.SA_TYPE_CD = SAT.SA_TYPE_CD
          and SAT.DST_ID = DCL.DST_ID
    group by DCL.DST_ID, DCL.DESCR, FT.FREEZE_SW</query>
    </jdbcQuery>
    <jdbcQuery id="FDL_TRIAL_BAL_90" datasourceId="FondDuLac_DS">
      <fieldList>
        <field id="DST_ID" type="java.lang.String"></field>
        <field id="DESCR" type="java.lang.String"></field>
        <field id="SUM_FT_CUR_AMT__1" fieldDBName="SUM(FT.CUR_AMT)" type="java.math.BigDecimal"></field>
        <field id="SUM_FT_TOT_AMT__2" fieldDBName="SUM(FT.TOT_AMT)" type="java.math.BigDecimal"></field>
        <field id="FREEZE_SW" type="java.lang.String"></field>
      </fieldList>
      <query>select DCL.DST_ID, DCL.DESCR, FT.FREEZE_SW,
    SUM(FT.CUR_AMT), SUM(FT.TOT_AMT) from cisadm.ci_ft FT, cisadm.CI_SA sa, cisadm.ci_sa_type SAT, cisadm.CI_DST_CODE_L DCL
    where FT.SA_ID = SA.SA_ID
          and FT.ars_dt between trunc(sysdate) -90 and trunc(sysdate)
          and SA.SA_TYPE_CD = SAT.SA_TYPE_CD
          and SAT.DST_ID = DCL.DST_ID
    group by DCL.DST_ID, DCL.DESCR, FT.FREEZE_SW</query>
    </jdbcQuery>
    <jdbcQuery id="FDL_TRIAL_BAL_180" datasourceId="FondDuLac_DS">
      <fieldList>
        <field id="DST_ID" type="java.lang.String"></field>
        <field id="DESCR" type="java.lang.String"></field>
        <field id="SUM_FT_CUR_AMT__2" fieldDBName="SUM(FT.CUR_AMT)" type="java.math.BigDecimal"></field>
        <field id="SUM_FT_TOT_AMT__4" fieldDBName="SUM(FT.TOT_AMT)" type="java.math.BigDecimal"></field>
        <field id="FREEZE_SW" type="java.lang.String"></field>
      </fieldList>
      <query>select DCL.DST_ID, DCL.DESCR, FT.FREEZE_SW,
    SUM(FT.CUR_AMT), SUM(FT.TOT_AMT) from cisadm.ci_ft FT, cisadm.CI_SA sa, cisadm.ci_sa_type SAT, cisadm.CI_DST_CODE_L DCL
    where FT.SA_ID = SA.SA_ID
          and FT.ars_dt between trunc(sysdate) -180 and trunc(sysdate) - 91
          and SA.SA_TYPE_CD = SAT.SA_TYPE_CD
          and SAT.DST_ID = DCL.DST_ID
    group by DCL.DST_ID, DCL.DESCR, FT.FREEZE_SW</query>
    </jdbcQuery>
    <jdbcQuery id="FDL_TRIAL_BAL_270" datasourceId="FondDuLac_DS">
      <fieldList>
        <field id="DST_ID" type="java.lang.String"></field>
        <field id="DESCR" type="java.lang.String"></field>
        <field id="SUM_FT_CUR_AMT__3" fieldDBName="SUM(FT.CUR_AMT)" type="java.math.BigDecimal"></field>
        <field id="SUM_FT_TOT_AMT__3" fieldDBName="SUM(FT.TOT_AMT)" type="java.math.BigDecimal"></field>
        <field id="FREEZE_SW" type="java.lang.String"></field>
      </fieldList>
      <query>select DCL.DST_ID, DCL.DESCR, FT.FREEZE_SW,
    SUM(FT.CUR_AMT), SUM(FT.TOT_AMT) from cisadm.ci_ft FT, cisadm.CI_SA sa, cisadm.ci_sa_type SAT, cisadm.CI_DST_CODE_L DCL
    where FT.SA_ID = SA.SA_ID
          and FT.ars_dt between trunc(sysdate) -270 and trunc(sysdate) - 181
          and SA.SA_TYPE_CD = SAT.SA_TYPE_CD
          and SAT.DST_ID = DCL.DST_ID
    group by DCL.DST_ID, DCL.DESCR, FT.FREEZE_SW</query>
    </jdbcQuery>
    <jdbcQuery id="FDL_TRIAL_BAL_OLD" datasourceId="FondDuLac_DS">
      <fieldList>
        <field id="DST_ID" type="java.lang.String"></field>
        <field id="DESCR" type="java.lang.String"></field>
        <field id="FREEZE_SW" type="java.lang.String"></field>
        <field id="SUM_FT_CUR_AMT__5" fieldDBName="SUM(FT.CUR_AMT)" type="java.math.BigDecimal"></field>
        <field id="SUM_FT_TOT_AMT__6" fieldDBName="SUM(FT.TOT_AMT)" type="java.math.BigDecimal"></field>
      </fieldList>
      <query>select DCL.DST_ID, DCL.DESCR, FT.FREEZE_SW,
    SUM(FT.CUR_AMT), SUM(FT.TOT_AMT) from cisadm.ci_ft FT, cisadm.CI_SA sa, cisadm.ci_sa_type SAT, cisadm.CI_DST_CODE_L DCL
    where FT.SA_ID = SA.SA_ID
          and FT.ars_dt &lt;= trunc(sysdate) - 271
          and SA.SA_TYPE_CD = SAT.SA_TYPE_CD
          and SAT.DST_ID = DCL.DST_ID
    group by DCL.DST_ID, DCL.DESCR, FT.FREEZE_SW</query>
    </jdbcQuery>
    <jdbcQuery id="JoinTree_1" datasourceId="FondDuLac_DS">
