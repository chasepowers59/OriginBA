        <field id="FDL_TRIAL_BAL_90.DESCR" type="java.lang.String"></field>
        <field id="FDL_TRIAL_BAL_90.SUM_FT_CUR_AMT__1" fieldDBName="SUM(FT.CUR_AMT)" type="java.math.BigDecimal"></field>
        <field id="FDL_TRIAL_BAL_90.SUM_FT_TOT_AMT__2" fieldDBName="SUM(FT.TOT_AMT)" type="java.math.BigDecimal"></field>
