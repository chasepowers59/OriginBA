/* ----------------- */
/*  01. BASE RULES   */
/* ----------------- */
.list .leaf, .list .node {
    overflow: hidden;
}

.list,
.leaf {
    -webkit-tap-highlight-color: transparent; /* "turn off" link highlight for iPad */
}

.leaf.visibleOverflow {
    overflow: visible;
}

.list li > .wrap {
    margin-bottom: 0;
}

.list .loading > .wrap > .icon {
    background-image: url(images/list_node_animation.gif);
    background-position: 0 2px;
    background-repeat: no-repeat;
}

.list .leaf.loading > .wrap > .icon {
    background-position: 0 0;
    height: 16px;
    width: 16px;
}

.list[disabled] .button {
    cursor: default;
}

ul.decorated li {
    margin: 1em;
    padding-left: 15px;
    position: relative;
}

ul.decorated li:before {
    background-image: url("images/disclosure_indicators_icons_sprite.svg");
    background-position: -32px -120px;
    background-repeat: no-repeat;
    background-size: 170px;
    content: "";
    height: 15px;
    left: 0;
    position: absolute;
    top: 0;
    width: 12px;
}

.hideRoot > .node > .collapsible {
    margin-left: 0;
}

.hideRoot > .node > .wrap {
    display: none !important;
}

.node.closed .list,
.node.loading .list {
    display: none;
}

/* States */
.list > li > .wrap.over {
    /* background-color: #efefef; replaced with different color variable below, aug 2024 */
    background-color: var(--background-grey-04) /* #f4f4f4 */
}

/*.list.doesNotHaveFocus .selected > .wrap {
    background-color: #999999;
} not found anywhere, remove if there are no problems, aug 2024 */

.list > li > .wrap.pressed,
.list > li.selected > .wrap,
.list > li.selected > .wrap.over {
    background-color: var(--jrs-theme-light);
    border-radius: 1px;
}

.list li.focus-visible > .wrap,
.list li.selected.focus-visible > .wrap,
.list li.selected.focus-visible > .wrap {
    outline: 2px solid var(--jrs-theme-dark);
    outline-offset: -2px;
}

.list > li.selected > a.wrap,
.list > li > div.pressed > div > p > a {
    color: #ffffff;
}

.list.responsive > li > .wrap.pressed {
    background-color: var(--jrs-theme-light);
}

/* we're not supposed to use j- classnames for styling */
/* TODO: come up with non j- classname */
.subcontainer .j-view-port-chunk > ul {
    padding: 0;
}

.hideRoot > .node > .subcontainer > .j-view-port-chunk > .collapsible {
    margin-left: 0;
}


/* ----------------- */
/*  02. META LINKS   */
/* ----------------- */
/* moved meta links from theme.css */
/* semantic list, doesn't use .list classname */
#metaLinks {
    color: #ffffff;
    height: 39px;
    margin-right: 270px;
}

#metaLinks li,
#metaLinks a,
#metaLinks a:hover,
#metaLinks a:active {
    color: inherit;
}

#metaLinks li {
    float: left;
    font-family: source_sans_proregular, Franklin Gothic, Verdana, Arial, sans-serif;
    font-size: 14px;
    margin: 0;
    padding: 0 8px;
    line-height: 39px;
}

#metaLinks #userID {
    font-family: source_sans_probold, Franklin Gothic Medium, Verdana, Arial, sans-serif;
}

#metaLinks > #help {
    margin-left: 6px;
    margin-right: 6px;
}

#metaLinks li.last {
    border-right: none;
}

#userID {
    max-width: 270px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

/* iPads (portrait and landscape) */
@media only screen
and (min-device-width : 768px)
and (max-device-width : 1024px)
and (orientation:portrait) {
    #metaLinks #userID,
    #metaLinks #help {
        display: none;
    }
}

/* #metaLinks li.subfocus:not(select) */
#metaLinks li.focus-visible:not(select) {
    background-color: var(--jrs-theme-light);
}

/* Responsive behavior for banner */
@media only screen and (max-width: 1100px) {
    #metaLinks {
        margin-right: 200px;
    }
}
@media only screen and (max-width: 820px) {
    #metaLinks {
        margin-right: 140px;
    }
}
@media only screen and (max-width: 750px) {
    #metaLinks {
        margin-right: 132px;
    }
    #metaLinks li {
        font-size: 13px;
    }
    #metaLinks #help {
        margin-right: 0;
    }
    #metaLinks #userID {
        display: none;
    }
}


/* ------------------------- */
/*  03. TOOLBAR BUTTON SET   */
/* ------------------------- */
.list.buttonSet,
.list.buttonSet .node,
.list.buttonSet .leaf,
.list.buttons,
.list.buttons .node,
.list.buttons .leaf {
    clear: none;
    float: left;
}

.list.buttonSet > li.node,
.list.buttonSet > li.leaf,
.list.toolsRight > li.leaf {
    overflow: visible;
}

.toolbar > .list.buttonSet .leaf,
.toolbar > .list.buttonSet .node,
.toolbar > .list.toolsRight .leaf {
    height: 100%;
    padding: 0 !important;
}

.toolbar > .buttonSet,
.toolbar .list.buttonSet,
.toolbar .list.buttonSet .button.capsule {
    height: 100%;
}
.list.buttonSet .list.buttonSet {
    margin-right: 12px;
}

.list.buttonSet .leaf.separator,
.list.buttons .leaf.separator {
    height: 1px;
    width: 20px;
}

/* iPads (portrait and landscape) */
@media only screen
and (min-device-width : 768px)
and (max-device-width : 1024px) {
    .list.buttonSet .leaf.separator {
        width: 0;
    }
    .list.column.simple {
        width: 542px;
    }
}

.list.buttonSet .leaf.divider,
.list.toolsRight .leaf.divider {
    margin: 0 4px;
    position: relative;
}
.list.toolsRight .leaf.divider {
    float: left;
}
.list.buttonSet .leaf.divider:last-of-type {
    margin-right: 0;
}
.list.toolsRight .leaf.divider:first-of-type {
    margin-left: 0;
}

/* States */
.toolbar > .list.buttonSet .leaf .focus-visible {
    border: 1px solid #ffffff;
    outline: 2px solid var(--jrs-theme-dark);
    outline-offset: -2px;
}


/* ------------------ */
/*  04. COLLAPSIBLE   */
/* ------------------ */
.list.collapsible {
    margin: 0;
}

.list.tabular.collapsible > li > .wrap > .column > h3,
.list.tabular.collapsible > li > .wrap > .column > p {
    font-weight: normal;
    margin-right: 4px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space:nowrap;
}

.collapsible .list {
    margin-left: 2em;
}

.collapsible > li,
.filters > li,
.fields > li {
    background-repeat: no-repeat;
    line-height: 2.5em;
    position: relative;
    white-space: nowrap;
}

.collapsible.type_tables > li .collapsible > li,
.collapsible.type_sets > li .collapsible > li {
    line-height: 2em;
}

.collapsible > li > .wrap,
.list.tabular > li > .wrap,
.list.filters > li > .wrap,
.list.fields > li > .wrap {
    color: var(--text-medium);
    display: block;
    margin: 0;
    overflow: hidden;
    padding: 0 5px;
    position: relative;
    text-decoration: none;
    text-overflow: ellipsis;
    white-space: nowrap;
} /* SHARED */

.collapsible > li > .wrap > .icon {
    background-image: url(images/lists_sprite.png);
    background-position: 7px 30px;
    background-repeat: no-repeat;
    float: left;
    height: 20px;
    margin: 0 3px 0 0;
    position: relative;
    top: 1px;
    width: 20px;
}

.list.collapsible > li > .header.wrap {
    border: none;
    background: #e0e0e0;
    border-radius: 0;
    border-bottom: 1px solid #ccc;
    cursor: default;
    margin: 0;
}

.collapsible input {
    margin: 1px auto;
}

.collapsible .selected {
    font-weight: inherit;
}

/* States */
.list.collapsible > li > .wrap.pressed,
.list.collapsible > li > .selected > .wrap,
.list.collapsible .selected > .wrap {
    color: #ffffff;
}


/* ----------------- */
/*  05. FILTERS      */
/* ----------------- */
/* Repo Search, Manage Server Settings, Data Chooser Pre-filters */
.list.filters > .leaf {}

.list.filters > .leaf.editMode {
    border-bottom: 1px solid var(--border-grey-10);
}

.list.filters .wrap.header {
    font-weight: bold;
    min-height: 0;
}

.list.filters .condition,
.list.filters .fieldName {
    color: #999999;
} /* found in data chooser, moved from theme.css */

.list.filters:not(.tabular) > .leaf.selected > .wrap, /* needed "not tabular" for Data Chooser Pre-filters */
.list.filters > li.selected > .wrap.pressed,
.list.filters > li.selected > .wrap .launcher {
    color: var(--jrs-theme-medium);
}

.list.filters > .leaf:not(.selected) > .wrap.over,
.list.filters > .leaf:not(.selected) > .wrap.pressed {
    background-color: var(--jrs-theme-light);
    color: #ffffff;
}

.list.filters > .leaf.selected.cursor > .wrap.over {
    color: var(--text-light);
}

.list.filters > .leaf > .wrap > .icon {
    background-image: url(images/disclosure_indicators_icons_sprite.svg);
    background-position: -26px -119px;
    background-repeat: no-repeat;
    background-size: 170px;
    float: left;
    height: 20px;
    margin: 5px 3px 0 0;
    position: relative;
    visibility: hidden;
    width: 20px;
}

.list.filters > .leaf.selected > .wrap > .icon {
    visibility: visible;
}

.list.filters .leaf .wrap.separator {
    cursor: default;
}


/* ------------------------- */
/*  06. FIELDS & MEASURES    */
/* ------------------------- */
.list.fields {
    padding-bottom: 5px;
}

.list.fields > li > .wrap,
.list > li.fields > .wrap,
.list.fields li > .wrap {
    border: 1px solid var(--border-grey-20);
    border-radius: 4px;
    margin: 3px 2% 0 2px;
}

.list.fields > .leaf > .wrap,
.list.fields .leaf > .wrap,
.fields.leaf > .wrap {
    padding-left: 9px;
}

/* iPads (portrait and landscape) */
/* SHORT-TERM FIX FOR WIDTH PROBLEM. HOPE THERE IS A BETTER SOLUTION */
@media only screen
and (min-device-width : 768px)
and (max-device-width : 1024px) {
    #selFieldsPanel > #fieldsTreeRoot,
    #sourceFieldsTree,
    #destinationFieldsTree {
        width: 100%;
    }
    #selFieldsPanel #fieldsTreeRoot * li > ul,
    #sourceFieldsTree * li > ul,
    #destinationFieldsTree * li > ul{
        width: 88%;
    }
}

.fields > .node > .wrap > .icon,
.fields .node > .wrap > .icon,
.fields.node > .wrap > .icon {
    background-image: url(images/disclosure_indicators_icons_sprite.svg);
    background-repeat: no-repeat;
    background-size: 170px;
    height: 26px;
    margin-right: 5px;
    top: 0;
    width: 15px;
} /* used in Data Chooser */

.fields > .leaf > .wrap > .icon,
.fields.leaf > .wrap > .icon,
.fields .leaf > .wrap > .icon {
    display: none;
}

.list.fields .node.closed > .wrap > .icon {
    background-position: 0 -383px;
}
.list.fields .node.selected.closed > .wrap > .icon {
    background-position: -60px -383px;
}

.list.fields .node.open > .wrap > .icon {
    background-position: 3px -323px;
}
.list.fields .node.selected.open > .wrap > .icon {
    background-position: -58px -323px;
}

.list.fields .node[disabled] > .wrap > .icon {
    opacity: .6;
}

.fields.tabular > .node > .wrap > .icon,
.fields.tabular.node > .wrap > .icon,
.fields.tabular .node > .wrap > .icon {
    left: 5px;
} /* used in Data Chooser, Display step */

#dimensionsTree .collapsible > li > .wrap > .icon:not(.error),
#measuresTree .collapsible > li > .wrap > .icon:not(.error) {
    background-image: url("images/adhoc_datatree_icons_sprite@1x.png");
    background-size: 80px;
}

/* 2x icons */
@media (-webkit-min-device-pixel-ratio: 2), (min-resolution: 192dpi) {
    #dimensionsTree .collapsible > li > .wrap > .icon:not(.error),
    #measuresTree .collapsible > li > .wrap > .icon:not(.error) {
        background-image: url("images/adhoc_datatree_icons_sprite@2x.png");
    }
}

/* alert icon for tree item */
#dimensionsTree .collapsible > li > .wrap > .icon.error,
#measuresTree .collapsible > li > .wrap > .icon.error {
    background-image: url("images/alert_icons_sprite.svg");
    background-position: 0 1px;
    background-repeat: no-repeat;
    background-size: auto;
}

#dimensionsTree .collapsible > li.selected > .wrap > .icon.error,
#measuresTree .collapsible > li.selected > .wrap > .icon.error {
    background-position: 0 1px;
}

/* olap dimensions */
.dimension .list.folders .leaf > .wrap > .icon {
    background-position: 0 -420px;
    width: 30px;
}
.dimension .list.folders .leaf.selected > .wrap > .icon {
    background-position: -50px -420px;
}

.dimension .list.folders .node.open > .wrap > .icon {
    background-position: 0 -359px;
    width: 30px;
}
.dimension .list.folders .node.selected.open > .wrap > .icon {
    background-position: -50px -359px;
}

.dimension .list.folders .node.closed > .wrap > .icon {
    background-position: 0 -389px;
    width: 30px;
}
.dimension .list.folders .node.selected.closed > .wrap > .icon {
    background-position: -50px -389px;
}

/* generic field & measure (using string and numeric icons accordingly) */
.attribute .list.folders .leaf > .wrap > .icon,
.attribute .list.folders .leaf.string > .wrap > .icon {
    background-position: -3px -60px;
    width: 30px;
}
.attribute .list.folders .leaf.selected > .wrap > .icon,
.attribute .list.folders .leaf.string.selected > .wrap > .icon {
    background-position: -53px -60px;
}
.measure .list.folders .leaf > .wrap > .icon,
.measure .list.folders .leaf.numeric > .wrap > .icon {
    background-position: -2px -90px;
    width: 30px;
}
.measure .list.folders .leaf.selected > .wrap > .icon,
.measure .list.folders .leaf.numeric.selected > .wrap > .icon {
    background-position: -52px -90px;
}

/* number as field */
.attribute .list.folders .leaf.numeric > .wrap > .icon {
    background-position: -3px -510px;
    width: 30px;
}
.attribute .list.folders .leaf.numeric.selected > .wrap > .icon {
    background-position: -53px -510px;
}

/* string as measure */
.measure .list.folders .leaf.string > .wrap > .icon {
    background-position: -2px -480px;
    width: 30px;
}
.measure .list.folders .leaf.string.selected > .wrap > .icon {
    background-position: -52px -480px;
}

/* date field & measure */
.attribute .list.folders .leaf.date > .wrap > .icon {
    background-position: 0 -180px;
    width: 30px;
}
.attribute .list.folders .leaf.date.selected > .wrap > .icon {
    background-position: -50px -180px;
}
.measure .list.folders .leaf.date > .wrap > .icon {
    background-position: 0 -210px;
    width: 30px;
}
.measure .list.folders .leaf.date.selected > .wrap > .icon {
    background-position: -50px -210px;
}

/* time field & measure */
.attribute .list.folders .leaf.time > .wrap > .icon {
    background-position: -1px -240px;
    width: 30px;
}
.attribute .list.folders .leaf.time.selected > .wrap > .icon {
    background-position: -51px -240px;
}
.measure .list.folders .leaf.time > .wrap > .icon {
    background-position: -1px -270px;
    width: 30px;
}
.measure .list.folders .leaf.time.selected > .wrap > .icon {
    background-position: -51px -270px;
}

/* boolean field & measure */
.attribute .list.folders .leaf.boolean > .wrap > .icon {
    background-position: 0 -300px;
    width: 30px;
}
.attribute .list.folders .leaf.boolean.selected > .wrap > .icon {
    background-position: -50px -300px;
    width: 30px;
}
.measure .list.folders .leaf.boolean > .wrap > .icon {
    background-position: 0 -330px;
    width: 30px;
}
.measure .list.folders .leaf.boolean.selected > .wrap > .icon {
    background-position: -50px -330px;
}

/* calculated field & measure */
.attribute .list.folders .leaf.calculatedField > .wrap > .icon {
    background-position: -3px -120px;
    width: 30px;
}
.attribute .list.folders .leaf.calculatedField.selected > .wrap > .icon:not(.error) {
    background-position: -53px -120px;
}
.measure .list.folders .leaf.calculatedField > .wrap > .icon {
    background-position: -2px -150px;
    width: 30px;
}
.measure .list.folders .leaf.calculatedField.selected > .wrap > .icon:not(.error) {
    background-position: -52px -150px;
}

/* folder open */
.measure .list.folders .node.open > .wrap > .icon,
.attribute .list.folders .node.open > .wrap > .icon {
    background-position: -1px -30px;
    width: 30px;
}
.measure .list.folders .node.open.selected > .wrap > .icon,
.attribute .list.folders .node.open.selected > .wrap > .icon {
    background-position: -51px -30px;
}

/* folder closed */
.measure .list.folders .node.closed > .wrap > .icon,
.attribute .list.folders .node.closed > .wrap > .icon {
    background-position: -1px 0;
    width: 30px;
}
.measure .list.folders .node.closed.selected > .wrap > .icon,
.attribute .list.folders .node.closed.selected > .wrap > .icon {
    background-position: -51px 0;
}

.list.folders .leaf.calculatedField > .wrap > .icon.error {
    background-image: url("images/message_icons_sprite.png");
    background-position: 0 4px;
    background-size: auto;
    float: right;
    width: 20px;
}

.list.twoColumn.fields .leaf .column.two input {
    width:100%;
    margin-top:5px;
}

.list.fields > .leaf.ascending > .wrap > .icon,
.list.fields > .leaf.descending > .wrap > .icon {
    background-image: url(images/sort_indicators_icons_sprite@1x.png);
    background-repeat: no-repeat;
    background-size: 13px;
    height: 17px;
    width: 13px;
    margin-right:5px;
    display: inline-block;
    top: 2px;
}

/* 2x icons */
@media (-webkit-min-device-pixel-ratio: 2), (min-resolution: 192dpi) {
    .list.fields > .leaf.ascending > .wrap > .icon,
    .list.fields > .leaf.descending > .wrap > .icon {
        background-image: url("images/sort_indicators_icons_sprite@2x.png");
    }
}

.list.fields > .leaf.ascending > .wrap > .icon {
    background-position: 0 6px;
}

.list.fields > .leaf.ascending > .wrap > .icon.over,
.list.fields > .leaf.ascending.selected > .wrap > .icon {
    background-position: 0 -18px;
}

.list.fields > .leaf.ascending > .wrap > .icon.pressed {
    background-position: 0 -46px;
}

.list.fields > .leaf.descending > .wrap > .icon {
    background-position: 0 -74px;
}

.list.fields > .leaf.descending > .wrap > .icon.over,
.list.fields > .leaf.descending.selected > .wrap > .icon {
    background-position: 0 -98px;
}

.list.fields > .leaf.descending > .wrap > .icon.pressed {
    background-position: 0 -124px;
}

/* measures */
.list.measures .leaf {
    line-height: 1.5em;
}

.list.measures .icon {
    background-image: url(images/lists_sprite.png);
    background-repeat: no-repeat;
    display: inline-block;
    height: 12px;
    width: 11px;
    position: relative;
    top: 2px;
}

.list.measures .icon.natural {
    background-position: left -942px;
}

.list.measures .icon.numeric.ascending {
    background-position: left -989px;
}

.list.measures .icon.numeric.descending {
    background-position: left -965px;
}


/* --------------------- */
/*  07. STEP INDICATOR   */
/* --------------------- */
/* stepIndicator only appears in Add Query UI */
.list.stepIndicator .node {
    margin-left: 20px;
    margin-top:5px;
}

.stepIndicator .icon {
    background-image: url(images/disclosure_indicators_icons_sprite.svg);
    background-position: -26px -119px;
    background-repeat: no-repeat;
    background-size: 170px;
    float: left;
    height: 20px;
    margin: 5px 3px 0 0;
    position: relative;
    visibility: hidden;
    width: 20px;
}

.list.stepIndicator .selected .icon {
    visibility: visible;
}

.list.stepIndicator > li > .wrap,
.list.stepIndicator > .selected > .wrap {
    background-color: transparent;
    font-size: 12px;
    height: 2.5em;
    line-height: 2.5em;
}

.list.stepIndicator .selected > .wrap {
    color: var(--jrs-theme-medium);
    font-weight: bold;
}


/* ------------ */
/*  08. FLAT    */
/* ------------ */
.list.flat .node > .wrap.header {
    display:block;
}

.list.flat .node > .wrap {
    display: none;
}

.list.flat .list {
    margin-left: 0;
}


/* ------------------ */
/*  09. PLUS-MINUS    */
/* ------------------ */
.plusminus.collapsible > li > .wrap > .icon {
    background-image: url(images/disclosure_indicators_sprite.png);
}

.plusminus .node > .wrap {
    height: 20px;
}

.plusminus .node.open > .wrap > .icon {
    background-position: 2px -697px;
}

.plusminus .node.closed > .wrap > .icon {
    background-position: 2px -673px;
}

.plusminus .node > .wrap > .jrbookmark {
    color: var(--jrs-theme-light);
}


/* -------------- */
/*  10. FOLDERS   */
/* -------------- */
.folders.collapsible > li > .wrap, /* for root node */
.folders .collapsible > li > .wrap {
    font-family: source_sans_proregular, Franklin Gothic, Verdana, Arial, sans-serif;
    font-size: 13px;
    height: 26px;
}

.folders.collapsible > li > .wrap > .icon, /* for root node */
.folders .collapsible > li > .wrap > .icon {
    background-image: url(images/file_tree_icons_sprite.svg);
    background-repeat: no-repeat;
    height: 24px;
    width: 34px;
}

.folders.collapsible > li .collapsible > li, /* for root node */
.folders .collapsible.folders > li .collapsible > li {
    line-height: 26px;
}

.folders .node > .wrap {
    margin-left: 0;
}

.folders .node > .icon {
    margin-right:5px;
}

.folders .node.readonly > .wrap > .icon {
    opacity: 0.5;
    filter: alpha(opacity=50);
}

/* theme folder */
.list.folders .node.activeTheme {
    font-weight: bold;
}

/* folder closed */
.folders .node.closed > .wrap > .icon {
    background-position: 0 2px;
}
.folders .node.closed.selected > .wrap > .icon {
    background-position: -58px 2px;
}

/* folder open */
.folders .node.open > .wrap > .icon {
    background-position: 0 -28px;
}
.folders .node.open.selected > .wrap > .icon {
    background-position: -58px -28px;
}

/* olap */
.folders .leaf.olap > .wrap > .icon {
    background-position: 0 -58px;
}
.folders .leaf.olap.selected > .wrap > .icon {
    background-position: -58px -58px;
}

/* domain */
.folders .leaf.domain > .wrap > .icon {
    background-position: 0 -87px;
}
.folders .leaf.domain.selected > .wrap > .icon {
    background-position: -58px -87px;
}

/* topic */
.folders .leaf.topic > .wrap > .icon {
    background-position: -0 -118px;
}
.folders .leaf.topic.selected > .wrap > .icon {
    background-position: -58px -118px;
}

/* domain topic */
.folders .leaf.domain.topic > .wrap > .icon {
    background-position: 0 -147px;
}
.folders .leaf.domain.topic.selected > .wrap > .icon {
    background-position: -58px -147px;
}

/* ad hoc view */
.folders .leaf.adhocDataView > .wrap > .icon,
#advLocationTree .folders .leaf > .wrap > .icon {
    background-position: 0 -177px;
}
.folders .leaf.adhocDataView > .wrap > .icon,
#advLocationTree .folders .leaf.selected > .wrap > .icon {
    background-position: -58px -177px;
}

/* report */
.folders .leaf.report > .wrap > .icon {
    background-position: 0 -207px;
}
.folders .leaf.report.selected > .wrap > .icon {
    background-position: -58px -207px;
}

/* dashboard */
.folders .leaf.dashboard > .wrap > .icon {
    background-position: 0 -237px;
}
.folders .leaf.dashboard.selected > .wrap > .icon {
    background-position: -58px -237px;
}

#node1.folders.node {
    line-height: 2em;
}

#foldersTree {
    margin-top:2px;
    -webkit-user-select: none; /* disable cut copy paste */
    -webkit-touch-callout: none; /* disable callout, image save panel */
}

/* Keyboard Focus */
.folders .list > li.selected.focus-visible > .wrap,
.folders.selected.focus-visible > .wrap {
    outline: 2px solid var(--jrs-theme-dark);
    outline-offset: -2px;
}


/* ----------------- */
/*  11. HORIZONTAL   */
/* ----------------- */
.horizontal li {
    float:left;
    margin: 0 .4em 0 0;
    padding-right:.4em;
}

.horizontal .last {
    border-right: none;
}

.horizontal.responsive .wrap.over,
.horizontal.responsive .wrap.pressed {
    text-decoration: underline;
}

.horizontal.path li {
    background: url(images/lists_sprite.png) right -345px no-repeat;
    border: none;
    padding-left:0;
}

.horizontal.path .last {
    background: none;
}


/* --------------------- */
/*  12. INPUT CONTROLS   */
/* --------------------- */
.list.inputControls {
    margin: 8px 0 0 0;
    min-width: 200px;
}

.list.inputControls .leaf {
    margin: 2px 0 0 0;
}

.row > .content > .body > .list.inputControls .leaf {
    clear: none;
    float: left;
}

.list.inputControls .inputSet {
    height: auto;
    overflow-y: auto;
}

.list.inputControls .control.radio .inputSet,
.list.inputControls .control.checkbox .inputSet {
    overflow-y: auto;
    overflow-x: hidden;
}

.list.inputControls .sizable {
    height: 68px;
    min-height: 68px;
}

.list.inputControls .control.checkbox .inputSet.sizable,
.list.inputControls .control.radio .inputSet.sizable {
    border: 1px solid var(--border-grey-16);
    box-sizing: border-box;
    margin-bottom: 2px;
    overflow-x: hidden;
    padding: 4px;
    width: 97%;
}


@media screen and (-webkit-min-device-pixel-ratio:0) {
    /* Chrome only */
    .list.inputControls .control.checkbox .inputSet,
    .list.inputControls .control.multiple.radio .inputSet {
        border: none ;
    }
}

.list.inputControls .control.radio .inputSet.sizable li {
    overflow: visible;
    width: 200px;
}

.control.select.multiple.radio li {
    width: auto !important;
} /* width rule so background highlight extends full width */

.dialog .list.inputControls {
    width:auto;
}

.list.inputControls label .wrap,
.list.inputControls div .wrap {
    font-weight: bold;
    line-height: 2em;
    white-space: normal;
}

.list.inputControls fieldset .wrap {
    font-weight: normal;
}

.list.inputControls fieldset legend {
    font-weight: bold;
    margin-bottom: 4px;
    margin-left: -5px;
}

.list.inputControls div.select.multiple .wrap,
.list.inputControls label.select > .wrap {
    white-space: normal;
}

@media screen and (-webkit-min-device-pixel-ratio:0) {
    /* chrome and safari do not render legend margins correctly */
    .list.inputControls fieldset legend + * {
        -webkit-margin-top-collapse: separate;
        margin-top: 6px;
    }
}

@media all and (-webkit-min-device-pixel-ratio:10000), not all and (-webkit-min-device-pixel-ratio:0) {
    /* opera does not render legend margins correctly */
    .list.inputControls fieldset legend {
        padding-bottom:6px;
    }
}

.list.inputControls fieldset label {
    margin-bottom: 3px;
}

.list.inputControls fieldset {
    padding-left: 5px;
}

.list.inputControls input {
    width: 100%;
}



/* ----------------------- */
/*  13. LINKED RESOURCES   */
/* ----------------------- */
.list.linkedResources .icon {
    display: none;
}

.list.linkedResources .wrap > .column.one,
.list.linkedResources .wrap > .column.two,
.list.linkedResources .wrap > .column.three {
    overflow: hidden;
    padding-right: 5px;
    text-overflow: ellipsis;
}

.list.linkedResources.twoColumn .wrap > .column.one {
    width: 65%;
}

.list.linkedResources.twoColumn .wrap > .column.two {
    width: 30%;
}

.list.linkedResources.threeColumn .wrap > .column.one {
    width: 50%;
}

.list.linkedResources.threeColumn .wrap > .column.two {
    width: 20%
}

.list.linkedResources.threeColumn .wrap > .column.three {
    text-align: right;
    width: 15%;
}

.list.linkedResources .wrap,
.list.linkedResources .header.wrap {
    border-top: none;
    line-height: 2.5em;
    padding-left: 20px;
    position: relative;
}

.list.linkedResources .header.wrap {
    border-bottom: none;
    color: var(--text-light);
}

.list.linkedResources .node:first-of-type {
    margin-bottom: 22px;
}

.list.linkedResources #bundlesList > .leaf {
    height: 22px;
}

.list.linkedResources .wrap .wrap {
    padding-left: 0;
}



/* --------------- */
/*  14. LOCATION   */
/* --------------- */
.locationSelector {
    height: 100%;
}

.list.locations {
    height: 100%;
    position: relative;
}

.list.locations > .leaf {
    overflow: visible; /* prevents focus style from getting cut off */
    padding-bottom: 10px;
}



/* ----------------- */
/*  15. NAME VALUE   */
/* ----------------- */
.list.name-value .icon {
    display: none;
}

.list.name-value .column .warning {
    display: none;
}

.list.name-value .column.error {
    height: auto;
}

.list.name-value .column.error .warning {
    display: block;
    line-height: normal;
}

.list.name-value .column.one,
.list.name-value .column.two {
    width: 35%;
}

.list.name-value .column.three {
    width: auto;
}

.list.name-value #name,
.list.name-value #value {
    width: 95%;
}

/* iPads (portrait and landscape) */
@media only screen
and (min-device-width : 768px)
and (max-device-width : 1024px) {
    .list.name-value #name,
    .list.name-value #value {
        width: 80%;
    }
}

.list.name-value .column.two,
.list.name-value .column.three {
    margin-right: 5px;
    overflow: hidden;
}

.list.name-value .column.three {
    text-align: right;
}

.list.name-value .wrap,
.list.name-value .header.wrap {
    padding-left: 20px;
}

.list.name-value .wrap .wrap {
    padding-left: 0;
}



/* ---------------------- */
/*  16. TABLE STRUCTURE   */
/* ---------------------- */
/*  16a. base rules       */
/* ---------------------- */
.tabular {
    color: var(--text-light);
    list-style: none;
    margin: 0;
}

.list.tabular .column {
    float: left;
    line-height: 32px;
    margin:0;
    overflow: hidden;
    padding:0;
    position: relative;
    word-wrap: normal;
}

.list.tabular > li > .wrap > .column > input {
    width: 100%;
}

.list.tabular .resourceName {
    cursor: default;
}

.list.tabular .icon {
    float: left;
}

.list.tabular > li > .wrap {
    border-top: 1px solid var(--border-grey-10);
    clear: both;
    padding-left: 20px;
}

/*.list.tabular input[type="text"] {
    height: 22px;
} Can only find one instance of text field in table, and base input rule is sufficient. Jan 2023 */

.list.tabular > li.first > .wrap {
    border-top: none;
}

.list.tabular > .leaf > .header.wrap,
.list.tabular > .node > .header.wrap {
    background-color: var(--background-grey-10);
    height: 2.5em;
    margin: 0;
}

.list.tabular .header.wrap > .icon {
    display: none;
}

.list.column.simple {
    border-right: 1px solid var(--background-grey-10);
    margin-right: 45px;
    overflow: auto;
}

.list.tabular > li > .wrap > .column > * {
    margin-bottom: 0;
}

.list.tabular > li > .wrap > .column > .separator {
    height: 32px;
}

/* -------------------- */
/*  16b. two-column     */
/* -------------------- */
.list.twoColumn > .node > .collapsible {
    margin-left: 0;
}

.list.twoColumn .wrap .column.one {
    width: 48%;
}

.list.twoColumn .wrap .column.one {
    float: left;
    margin-left: 7px;
    overflow: hidden;
}

.list.twoColumn .wrap .column.two {
    width: auto;
}

/* ---------------------- */
/*  16c. three-column     */
/* ---------------------- */
.list.threeColumn .wrap .column {
    width: 32%;
}

/* -------------------- */
/*  16d. four-column    */
/* -------------------- */
.list.tabular.fourColumn,
.list.tabular.sevenColumn {
    min-width: 700px;
}

/* iPads (portrait and landscape) */
@media only screen
and (min-device-width : 768px)
and (max-device-width : 1024px) {
    .list.tabular.fourColumn {
        min-width: 600px;
    }
}

.list.tabular.fourColumn .column {
    width: 25%;
}

.list.tabular.fourColumn .column.one {
    margin-right: 10px;
}

.list.tabular.fourColumn .column.four {
    position: absolute;
    top: 2px;
    right: 15px;
    left: auto;
}

/* -------------------- */
/*  16e. five-column    */
/* -------------------- */
/* five-column table only appears in Server Settings > Ad Hoc Cache */
.list.tabular.fiveColumn .column {
    display: inline-block;
    height: auto;
    line-height: normal;
    vertical-align: top;
    overflow: visible;
}

.list.tabular.fiveColumn .header > .wrap {
    background-color: var(--background-grey-03);
    border: none;
    color: var(--text-dark);
    font-family: source_sans_prosemibold, Franklin Gothic Medium, Verdana, Arial, sans-serif;
    font-size: 13px;
    font-weight: normal;
    height: 32px;
    padding: 0 8px;
}

.list.tabular.fiveColumn > .list:not(.header) > .wrap {
    font-family: source_sans_proregular, Franklin Gothic, Verdana, Arial, sans-serif;
    font-size: 13px;
    padding: 8px;
}

.list.tabular.fiveColumn .header .wrap .column {
    line-height: 32px;
}

.list.tabular.fiveColumn .leaf,
.list.tabular.fiveColumn .node {
    overflow: visible;
}

.list.fiveColumn .leaf > .wrap {
    padding: 5px 5px 5px 20px;
    white-space: nowrap;
}

.list.tabular.fiveColumn .column .wrap {
    border: none;
}

.list.fiveColumn .wrap > .column.one {
    white-space: nowrap;
    width: 10%;
}

.list.fiveColumn .wrap > .column.two {
    margin-left: 8px;
    width: 52%;
}

.list.fiveColumn .wrap > .column.three {
    padding: 0 8px;
    text-align: center;
    white-space: nowrap;
    width: 13%;
}

.list.fiveColumn .wrap > .column.four {
    text-align: center;
    white-space: nowrap;
    width: 13%;
    min-width: 120px;
}

.list.fiveColumn .wrap > .column.five {
    text-align: right;
    width: 10%;
}

.list.fiveColumn .wrap > .column.five .button {
    margin-right: 0;
}

.list.tabular.fiveColumn > li > .wrap > .column > .query {
    display: -webkit-box;
    font-family: source_sans_prosemibold, Franklin Gothic, Verdana, Arial, sans-serif;
    font-size: 13px;
    font-weight: normal;
    line-height: 1.4;
    margin-bottom: 5px;
    max-height: 7.2em;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 5;
    white-space: pre;
}

.list.tabular.fiveColumn > li > .wrap > .column > .path {
    line-height: 1.5;
    margin-top: 12px;
}

/* ------------------- */
/*  16f. six-column    */
/* ------------------- */
.list.tabular.sixColumn .leaf,
.list.tabular.sixColumn .node {
    overflow: visible;
}

.list.tabular.sixColumn .column.one {
    width: 6%;
    border: none;
}

.list.tabular.sixColumn .column.two {
    width: 42%;
}

.list.tabular.sixColumn .column.three {
    width: 10%;
}

.list.tabular.sixColumn .column.four {
    width: 30%;
}

.list.tabular.sixColumn .column.five {
    width: 6%;
}

.list.tabular.sixColumn .column.six {
    width: 5%;
}

/* ----------------------- */
/*  16g. tabular filters   */
/* ----------------------- */
.list.tabular.filters.twoColumn > .leaf > .dialog.inlay.filter,
.list.tabular.filters.twoColumn > .leaf.editMode > .wrap {
    display: none;
}

.list.tabular.filters.twoColumn > .leaf.editMode > .panel.inlay,
.list.tabular.filters.twoColumn > .leaf > .wrap {
    display: block;
}

.list.tabular.filters.twoColumn .wrap {
    background-color: transparent;
}

.list.tabular.filters.twoColumn .wrap > .column {
    height: auto;
    line-height: 18px;
    margin-top: 8px;
    margin-right: 2%;
    margin-bottom: 8px;
    min-width: 55px;
}

.list.tabular.filters.twoColumn .wrap > .column.one {
    width: 60%;
}

.list.tabular.filters.twoColumn .wrap > .column.two {
    float: right;
    width: 30%;
}

/* iPads (portrait and landscape) */
@media only screen
and (min-device-width : 768px)
and (max-device-width : 1024px) {
    .list.tabular.filters.twoColumn .wrap > .column.one {
        width: 50%;
    }
    .list.tabular.filters.twoColumn .wrap > .column.two {
        width: 40%;
    }
}

.list.tabular.filters.twoColumn .wrap > .column.two > .lock {
    margin-right: 3%;
}

.list.tabular.filters.twoColumn .wrap > .column.two > .actions {
    position: absolute;
    top:0;
    right: 0;
}

.list.tabular.filters > .leaf > .wrap > .condition > .operation {
    font-style: italic;
}

.list.tabular.filters > .leaf > .wrap > .condition > .value {
    font-weight: bold;
    white-space: normal;
}

.list.tabular.filters > .leaf > .condition > .wrap > .value.concatenator {
    font-style: italic;
    font-weight: normal;
}



/* ------------------------- */
/*  17. RESOURCES AND JOBS   */
/* ------------------------- */
/*  17a. shared rules        */
/* ------------------------- */
.list.tabular.resources,
.list.tabular.jobs {
    height: auto;
    max-width: none;
    border-right: none;
}

/* .list.tabular.resources.header, this has been hidden on repository pages, July 2022 */
.list.tabular.resources #resultsListHeader_item1, /* add classname .header to this element in markup */
.list.tabular.jobs.header {
    background-color: var(--background-grey-03);
    border-bottom: 1px solid var(--border-grey-10);
    cursor: default;
    height: 32px;
    inset: unset;
    margin-top: 2px;
    margin-right: 0 !important;
    overflow: hidden;
    position: relative;
    white-space: nowrap;
    z-index: 8; /* must be lower than #systemMessageConsole */
} /* create page-specific styles if there are issues */

.list.tabular.header.resources .resources,
.list.tabular.header.jobs .leaf {
    font-family: source_sans_prosemibold, Franklin Gothic Medium, Verdana, Arial, sans-serif;
}

.list.tabular.resources .first,
.list.tabular.jobs .first {
    border-top: none;
}

.list.tabular.resources .resources,
.list.tabular.jobs .leaf {
    border-right: none;
    font-family: source_sans_proregular, Franklin Gothic, Verdana, Arial, sans-serif;
    font-size: 13px;
    font-weight: normal;
}  /* create page-specific styles if there are issues */


.list.tabular.resources .wrap,
.list.tabular.jobs .wrap {
    border-top: none;
    border-right: none;
    border-bottom: 1px solid var(--border-grey-10);
    height: 32px;
    padding: 0;
    white-space: nowrap;
}

.responsive .stripe.wrap {
    background-color: #F2F8FE;
}

.list.tabular.resources .column,
.list.tabular.jobs .column {
    display: inline-block;
    height: 32px;
    vertical-align: top;
}  /* create page-specific styles if there are issues */

.list.resources .column.one {
    border: none;
    margin: 0 !important;
    width: 66px;
}

.list.tabular.resources .separator,
.list.tabular.jobs .separator {
    height: inherit;
    left: 23px;
    position: absolute;
    top: 0;
    width: 0;
}

/* --------------------- */
/*  17b. resources       */
/* --------------------- */
.list.tabular.resources .list {
    margin-left: 4em;
} /* must be before .list.resources.sublist style below */

.list.tabular.resources.sublist {
    margin-left: 0;
    margin-top: 0;
}

.list.tabular.resources .icon.disclosure {
    left: 48px;
}

.list.tabular.resources #resultsListHeader_item1 {
    margin-top: 0;
    position: sticky;
    top: 0;
    z-index: 999;
}

.list.tabular.resources  #resultsListHeader_item1  .wrap:hover .favorite.icon {
    opacity: 0;
}

.list.tabular.resources .resourceName a {
    color: var(--jrs-theme-medium)
}

.list.tabular.resources #resultsListHeader_item1 .resourceName {
    color: var(--text-light);
    font-family: source_sans_proregular, Franklin Gothic, Verdana, Arial, sans-serif;
    font-size: 13px;
    font-weight: normal;
}

.list.tabular.resources p,
.list.tabular.resources .resourceType {
    color: var(--text-light);
}

.list.tabular.resources .column.one {
    border: none;
    margin: 0 !important;
    width: 66px;
}

.list.tabular.resources.twoColumn .column.one {
    width: 20px;
}

.list.tabular.resources .column.two {
    white-space: normal;
    width: 64%;
}

.list.tabular.resources .column.three {
    left: auto;
    padding-left: 4px;
    position: absolute !important;
    right: 19%;
    width: 11%;
}

.list.tabular.resources .column.four {
    right: 0 !important;
    top:0 !important;
    width: 19%;
    white-space: normal;
}

.list.tabular.resources .column.four * {
    text-align: right;
}

.list.tabular.resources.twoColumn .column.two {
    width: 80%;
}

.wrap.dragging.resources > .column {
    position: relative;
    overflow: hidden;
    z-index: 20;
}

.wrap.dragging.resources > .column.one,
.wrap.dragging.resources > .column.three,
.wrap.dragging.resources > .column.four,
.wrap.dragging.resources > .column > .resourceDescription {
    display: none;
}

.list.tabular.resources .createdDate,
.list.tabular.resources .modifiedDate {
    display: inline-block;
    height: 31px;
    overflow: hidden;
    padding: 0 0 0 4px;
    text-align: left !important;
    width: 43%;
    white-space: nowrap;
}

/* iPads (portrait and landscape) */
@media only screen
and (min-device-width : 768px)
and (max-device-width : 1024px) {
    #manage_roles .list.twoColumn .wrap .column.one {
        width: 88%;
    }
}

.list.tabular.resources .resourceName {
    color: var(--jrs-theme-medium);
    display: inline-block;
    font-family: source_sans_prosemibold, Franklin Gothic, Verdana, Arial, sans-serif;
    font-size: 13px;
    font-weight: normal;
    line-height: 32px;
    margin: 0;
    padding-left: 4px;
    width: 40%;
}

.list.tabular.resources.sublist .resourceName > a {
    color: var(--jrs-theme-medium);
    padding-left: 24px;
}

.list.tabular.resources .resourceDescription {
    display: inline-block;
    margin: 0;
    /* min-height: 1em; Dec 2022, delete if there are no issues */
    min-height: 31px;
    padding-left: 4px;
    position: absolute;
    width: 57%;
}

@-moz-document url-prefix() {
    .list.tabular.resources .resourceDescription {
        position: relative;
    }
}

.list.tabular.resources .icon {
    position: absolute;
    top: 5px;
}

/* favorite button */
.list.resources .wrap .favorite.icon {
    background-position: -27px -471px;
    background-size: 170px;
    height: 27px;
    left: 2px;
    opacity: 0;
    top: 2px;
    width: 20px;
}

.list.resources > li.favorite > .wrap .favorite.icon {
    opacity: 1;
}

/* scheduled button */
.list.resources .wrap .scheduled.icon {
    left: 26px;
    width: 20px;
    height: 27px;
    top: 2px;
    visibility: hidden;
}

.list.resources > .scheduled > .wrap .scheduled.icon {
    background-position: -28px -413px; /* blue */
    visibility: visible;
}

.list.resources > .scheduled > .wrap .scheduled.icon[role=columnheader] {
    background-position: 2px -413px;
    cursor: auto;
}

/* disclosure expand-collapse button */
.list.resources > .leaf > .wrap > .column > .disclosure.icon {
    /* Hides icon for reports without options. Report without
    option is 'leaf', report with options is 'node' */
    background-image: none;
    cursor: default;
}
.list.resources .disclosure.icon {
    background-image: url(images/disclosure_indicators_icons_sprite.svg);
    background-repeat: no-repeat;
    background-size: 170px;
}

/* States */
/* rows and cells */
.list.tabular.resources .selected .wrap p,
.list.tabular.resources .selected .wrap .resourceName a,
.list.tabular.resources .selected .wrap .resourceType {
    color: #ffffff;
}

.list.tabular.resources .selected .sublist p,
.list.tabular.resources .selected .sublist .resourceDescription,
.list.tabular.resources .selected .sublist .resourceType {
    color: var(--text-light);
}

.list.tabular.resources .selected.open .sublist .resourceName > a {
    color: var(--jrs-theme-medium)
}

/* favorites button */
.list.resources .wrap:hover .favorite.icon {
    background-position: 3px -500px; /* outline grey */
    opacity: 1;
}

.list.resources > .selected > .wrap:hover .favorite.icon {
    background-position: -57px -500px; /* outline white */
    opacity: 1;
}

.list.resources > .favorite > .wrap:hover .favorite.icon,
.list.resources > .favorite.selected > .wrap:focus-within .favorite.icon {
    background-position: -27px -471px; /* solid blue */
}

.list.resources > .favorite.selected > .wrap .favorite.icon,
.list.resources > .favorite.selected > .wrap:hover .favorite.icon {
    background-position: -57px -471px; /* solid white */
}

/* scheduled button */
.list.resources > .scheduled.subfocus > .wrap .scheduled.icon {
    background-position: -28px -413px; /* blue */
}

.list.resources .scheduled.selected > .wrap .scheduled.icon {
    background-position: -58px -413px; /* white */
}

/* disclosure expand-collapse button */
.list.resources .node.closed > .wrap .disclosure.icon,
.list.resources .node.closed.subfocus > .wrap .disclosure.icon {
    background-position: -30px -385px;
}

.list.resources .node.closed.selected > .wrap .disclosure.icon,
.list.resources .node.closed.selected.subfocus > .wrap .disclosure.icon {
    background-position: -60px -385px;
}

.list.resources .node.open > .wrap .disclosure.icon,
.list.resources .node.open.subfocus > .wrap .disclosure.icon {
    background-position: -30px -325px;
}

.list.resources .node.open.selected > .wrap .disclosure.icon,
.list.resources .node.open.selected.subfocus > .wrap .disclosure.icon {
    background-position: -60px -325px;
}

/* Keyboard Focus */
.list.tabular.resources .leaf.focus-visible > .wrap,
.list.tabular.resources .node.focus-visible > .wrap {
    /* row focus outline */
    outline: 2px solid var(--jrs-theme-dark);
    outline-offset: -2px;
}

.list.tabular.resources .focus-visible.subfocus:not(li) {
    /* cell focus outline */
    outline: 2px solid var(--jrs-theme-dark);
    outline-offset: -2px;
    line-height: 30px;
    padding-top: 1px;
}

.list.tabular.resources .wrap:focus-within {
    /* hides selected row background color when cells are focused */
    background-color: transparent;
}

.list.tabular.resources > .node.open .leaf.selected .wrap:focus-within a,
.list.tabular.resources > .node.selected .wrap:focus-within a,
.list.tabular.resources > .leaf.selected .wrap:focus-within a {
    /* cell focus text color */
    color: var(--jrs-theme-medium);
}

.list.tabular.resources .selected .wrap:focus-within p,
.list.tabular.resources .selected .wrap:focus-within .resourceType,
.resources.node.open .resources.leaf.selected .wrap:focus-within p,
.resources.node.open .resources.leaf.selected .wrap:focus-within .resourceType,
.resources.node.open .resources.leaf.selected .wrap:focus-within .resourceName {
    /* cell focus text color */
    color: var(--text-light);
}

.list.tabular.resources .resourceType.focus-visible.subfocus {
    /* reduce height so focus outline for "Type" isn't obscured */
    height: 31px;
}

.list.tabular.resources .favorite.focus-visible.subfocus {
    /* favorites button focus outline position */
    outline-offset: 0;
}

.list.tabular.resources .favorite.focus-visible.subfocus[aria-checked="false"] {
    /* favorites button focus for item that isn't a favorite */
    opacity: 1;
    background-position: 3px -500px;
}

.list.tabular.resources .scheduled.selected .wrap:focus-within .scheduled.icon {
    /* scheduled icon position */
    background-position: -28px -413px; /* blue */
}

.list.tabular.resources .scheduled.selected > .wrap .scheduled.icon.focus-visible {
    /* scheduled button cell focus */
    border-radius: 0;
    outline-offset: 0;
    line-height: 30px;
    padding-top: 1px;
    outline: 2px solid var(--jrs-theme-dark);
}

.list.tabular.resources .selected.open .wrap:focus-within .disclosure.icon {
    /* disclosure icon position when other cells have focus */
    background-position: -30px -325px;
}

/* ---------------- */
/*  17c. jobs       */
/* ---------------- */
.list.jobs .jobResource,
.list.jobs .jobResourcePath,
.list.jobs .jobName,
.list.jobs .jobDescription,
.list.jobs .jobID,
.list.jobs .jobOwner,
.list.jobs .lastRanDate,
.list.jobs .nextRunDate,
.list.jobs .jobState {
    height: 24px;
    overflow: hidden;
    padding-left: 4px;
    white-space: nowrap;
}

.list.jobs .jobName {
    display: inline-block;
    width: 60%;
}

.list.jobs .jobOwner {
    display: inline-block;
    width: 36%;
}

.list.jobs .lastRanDate,
.list.jobs .nextRunDate {
    display: inline-block;
    width: 48%;
}

.list.jobs .jobEnabled {
    display: inline-block;
    float: none;
    height: 24px;
    overflow: hidden;
    padding-left: 2px;
    padding-right: 2px;
    text-align: center;
    white-space: nowrap;
    width: 120px;
}

#listOfJobs p {
    color: var(--text-light);
}

/* table body only */
#resultsList .jobEnabled {
    text-align: center;
}

.list.jobs .jobEdit,
.list.jobs .jobDelete {
    display: inline-block;
    float: right;
    height: auto;
    line-height: 16px;
    margin: 0 4px;
    overflow: hidden;
    padding: 5px 0;
    text-align: center;
    vertical-align: top;
    white-space: nowrap;
    width: 28px;
}

.singleReportView .body .list.tabular.jobs .jobName,
.masterView .body .list.tabular.jobs .jobResource {
    font-weight: bold;
}

/* set left */
.responsive.setLeft .responsive {
    margin-left: 0;
}

.responsive.setLeft .responsive .node .wrap {
    padding-left: 20px;
}
.responsive.setLeft .responsive .node .leaf .wrap {
    padding-left: 30px;
}

.responsive.setLeft .responsive .node .node .wrap {
    padding-left: 40px;
}

.responsive.setLeft .responsive .node .node .leaf .wrap {
    padding-left: 50px;
}

.responsive.setLeft .responsive .node .node .node .wrap {
    padding-left: 60px;
}

.responsive.setLeft .responsive .node .node .node .leaf .wrap {
    padding-left: 70px;
}


/* --------------- */
/*  18. MESSAGES   */
/* --------------- */
.list.tabular.collapsible.header.type_messages {
    background-color: var(--background-grey-03);
    border-bottom: 1px solid var(--border-grey-10);
    cursor: default;
    height: 32px;
    margin-top: 2px;
    position: absolute;
    left: 0;
    right: 0;
    overflow:hidden;
    white-space:nowrap;
    z-index: 8; /* must be lower than #systemMessageConsole */
}

.list.tabular.collapsible.type_messages  {
    font-family: source_sans_proregular, Franklin Gothic, Verdana, Arial, sans-serif;
    font-size: 13px;
    font-weight: normal;
}

.list.tabular.collapsible.type_messages.header .leaf {
    font-family: source_sans_prosemibold, Franklin Gothic Medium, Verdana, Arial, sans-serif;
}

.list.tabular.collapsible.header.type_messages .column.one,
.list.tabular.collapsible.type_messages .column.one {
    width: 46%;
}

.list.tabular.collapsible.header.type_messages .column:not(.one),
.list.tabular.collapsible.type_messages .column:not(.one) {
    width: 18%;
}

.list.tabular.collapsible.type_messages .subject {
    font-weight: normal;
}

.list.tabular.collapsible.type_messages .unread .subject {
    font-family: source_sans_probold, Franklin Gothic Medium, Arial Black;
}

.list.tabular.collapsible.type_messages.tabular.fourColumn .column.four {
    top: 0;
}


/* --------------- */
/*  19. SETTINGS   */
/* --------------- */
.list.settings {
    max-width: 800px;
}

.list.settings .header > .title {
    height: auto;
}

.list.settings .panel.pane.settings .header > .title {
    color: var(--jrs-theme-medium)
}

.list.settings .node > .wrap {
    font-family: source_sans_proregular, Franklin Gothic, Verdana, Arial, sans-serif;
    height: 28px;
}

.list.settings .node > .wrap .title {
    color: var(--text-medium);
    font-size: 16px;
    line-height: 28px;
    margin-bottom: 0;
}

.list.settings .node > .description {
    background-color: #ffffff;
    border: none;
    color: var(--text-light);
    font-family: source_sans_proregular, Franklin Gothic, Verdana, Arial, sans-serif;
    font-size: 13px;
    line-height: 1.3;
    margin: 2px 0 0 0;
    padding: 5px 0 10px 0;
}

.list.settings .column .actions > .button:not(.primary):not(.focus-visible) {
    outline: 1px solid #919191;
    outline-offset: -1px;
}

.list.settings .column .actions > .button:disabled:not(.primary) {
    outline: 1px solid #cecece;
    outline-offset: -1px;
}


/* ------------ */
/*  20. BASIC   */
/* ------------ */
/* I can only find this in report viewer, bookmarks */
.type_basic .node > .wrap > .icon {
    background-image: url(images/disclosure_indicators_icons_sprite.svg);
    background-size: 170px;
}

.type_basic .node.open > .wrap > .icon {
    background-position: -26px -237px;
}

.type_basic .node.closed > .wrap > .icon {
    background-position: -26px -296px;
}

.list.type_basic li > .wrap.pressed,
.list.type_basic li > .wrap:hover {
    /* background-color: #efefef; replaced with different color variable below, aug 2024 */
    background-color: var(--background-grey-04) /* #f4f4f4 */
}

.collapsible.type_basic li {
    line-height: 2.2em;
}

.list.type_basic .wrap a {
    color: var(--jrs-theme-medium);
}

.collapsible.type_basic .collapsible {
    margin-top: -2px;
    margin-left: 1.5em;
}


/* ----------- */
/*  21. SETS   */
/* ----------- */
/* is used in ad hoc Choose Visible Fields dialog
   was used in old domain designer
   not sure if it's used anywhere else */
.type_sets .node > .wrap > .icon {
    width: 19px;
}

.type_sets .leaf > .wrap > .icon {
    width: 12px;
}

.type_sets .node > .wrap {
    margin-left: 0;
}

.type_sets .node > .icon {
    margin-right:5px;
}

.type_sets .node.open > .wrap > .icon,
.type_sets .node.open > .wrap.pressed > .icon {
    background-position: 0 -176px;
}

.type_sets .node.closed > .wrap > .icon,
.type_sets .node.closed > .wrap.pressed > .icon {
    background-position: 0 -207px;
}

.type_sets .leaf > .wrap > .icon {
    background-position: 0 -398px;
}


/* ------------------ */
/*  22. ATTRIBUTES    */
/* ------------------ */
.list.type_attributes {
    margin: 5px auto;
}

.list.type_attributes .node {
    display: block;
    margin-bottom: 15px;
}

.list.type_attributes .leaf {
    display: inline;
}

/* -------------------------- */
/*  23. NO RESULTS MESSAGE    */
/* -------------------------- */
.list div.noSearchResults {
    text-align: center;
}

.panel.dialog.overlay.ui-resizable.selectFolder .hideRoot > .node > .subcontainer > .j-view-port-chunk > .collapsible {
    margin-left: 0;
}