  <subFilterList>
    <subFilter id="filter_1" letter="A" sourceString="DYNAMIC">
      <expressionString>FT_ADJ.ADJ_TYPE_DESC in ('ACCT CREATE/CON FEE', 'ADD''L PICKUP NO TAX', 'ADDITIONAL PICKUP', 'AFTER HOURS FEE', 'CC CHARGE BACK', 'COMPACT FLOURESCENT REBATE', 'CONTAINER VIOLATION FEE', 'Conversion Payment Return Adjustment', 'DELINQ FEE WSUD', 'DELINQUENT FEE', 'DELINQUENT FEE - COMMERCIAL', 'IRRIGATION PROGRAM REBATE', 'LATE FEE', 'METER TEST FEE', 'MIS CHRGE NO TAX EL', 'MISC CHARGE - SANITATION ONLY', 'MISCELLANEOUS FEE', 'Miscellaneous Credit - Drainage', 'Miscellaneous Credit - Electric', 'Miscellaneous Credit - Roadway', 'Miscellaneous Credit - Wastewater', 'Miscellaneous Credit - Water', 'NON-SUFFICIENT FUNDS/RETURNED CHECK FEE', 'OTHER WATER FEE', 'REFUND CREDIT BALANCE VIA A/P', 'REFUND CREDIT BALANCE VIA A/P [SYSTEM GENERATED]', 'RES GARB COLLECTION', 'SANITATION', 'SANITATION CONTAINER - NOT FOR CREDIT USE', 'SYNC CURRENT BAL W/ PAYOFF BAL', 'SYNC CURRENT BAL W/PAYOFF BAL', 'TAMPERING FEE', 'TEXAS A&amp;M DISCOUNT', 'THERMOSTAT REBATE', 'WATER TEMP CON FEE', 'WELLBORN WATER SUD ADJUSTMENT', 'WICKSON WATER SUD ADJUSTMENT', 'Water Leak Adjustment', 'XFER BALANCE')</expressionString>
      <parameterizedExpressionString>FT_ADJ.ADJ_TYPE_DESC in ADJ_TYPE_DESC_1</parameterizedExpressionString>
    </subFilter>
    <subFilter id="filter_2" letter="B" sourceString="DYNAMIC">
      <expressionString>betweenDates(FT_CORE.CRE_DTTM, 'MONTH-1', 'DAY-0')</expressionString>
      <parameterizedExpressionString>betweenDates(FT_CORE.CRE_DTTM, CRE_DTTM_1, CRE_DTTM_2)</parameterizedExpressionString>
    </subFilter>
    <subFilter id="filter_3" letter="C" sourceString="DYNAMIC">
      <expressionString>FT_ADJ.ADJ_STATUS_DESC == 'Frozen'</expressionString>
      <parameterizedExpressionString>FT_ADJ.ADJ_STATUS_DESC == ADJ_STATUS_DESC_1</parameterizedExpressionString>
    </subFilter>
    <subFilter id="filter_4" letter="D" sourceString="DYNAMIC">
      <expressionString>isAnyValue(FT_SA_ACCT.CUST_CL_DESC)</expressionString>
      <parameterizedExpressionString>FT_SA_ACCT.CUST_CL_DESC in CUST_CL_DESC_1</parameterizedExpressionString>
    </subFilter>
