      <joinInfo alias="CI_SA" referenceId="CI_SA"></joinInfo>
      <joinList>
        <join expr="CI_SA.SA_ID == CI_SA_CONTERM.SA_ID" left="CI_SA" right="CI_SA_CONTERM" type="leftOuter" weight="1"></join>
        <join expr="CI_SA_CONTERM.SA_ID == CI_TOU_CONT_VAL.SA_ID and CI_SA_CONTERM.CONTERM_TYPE_FLG == CI_TOU_CONT_VAL.CONTERM_TYPE_FLG and CI_SA_CONTERM.START_DT == CI_TOU_CONT_VAL.START_DT and CI_SA_CONTERM.BF_CD == CI_TOU_CONT_VAL.BF_CD and CI_SA_CONTERM.TOU_GRP_CD == CI_TOU_CONT_VAL.TOU_GRP_CD" left="CI_SA_CONTERM" right="CI_TOU_CONT_VAL" type="leftOuter" weight="1"></join>
        <join expr="CI_SA.ACCT_ID == CI_ACCT.ACCT_ID" left="CI_SA" right="CI_ACCT" type="leftOuter" weight="1"></join>
        <join expr="CI_ACCT.ACCT_ID == CI_ACCT_PER.ACCT_ID and CI_ACCT_PER.MAIN_CUST_SW == 'Y'" left="CI_ACCT" right="CI_ACCT_PER" type="leftOuter" weight="1"></join>
        <join expr="CI_ACCT_PER.PER_ID == CI_PER_NAME.PER_ID and CI_PER_NAME.NAME_TYPE_FLG == 'PRIM'" left="CI_ACCT_PER" right="CI_PER_NAME" type="leftOuter" weight="1"></join>
