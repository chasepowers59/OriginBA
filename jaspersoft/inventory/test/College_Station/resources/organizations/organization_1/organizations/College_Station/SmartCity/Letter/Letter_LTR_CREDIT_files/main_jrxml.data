					<textFieldExpression><![CDATA["Customer Name:      "+ ($F{entityName1}==null?"":$F{entityName1})+ "<br />" +
"Service Address:      "+ ($F{mailingAddress1}==null?"":$F{mailingAddress1})+($F{mailingCity}==null?"":$F{mailingCity})+", "+
($F{mailingState}==null?"":$F{mailingState})+" " + ($F{mailingPostal}==null?"":$F{mailingPostal})+ "<br />"]]></textFieldExpression>
				</textField>
				<textField textAdjust="StretchHeight">
					<reportElement x="0" y="150" width="572" height="330" uuid="95d0e317-8ea0-48bb-ba9e-992431a4ad6e">
						<property name="com.jaspersoft.studio.unit.height" value="px"/>
					</reportElement>
					<box topPadding="2" leftPadding="10" bottomPadding="2" rightPadding="10"/>
					<textElement textAlignment="Justified" verticalAlignment="Top" markup="html">
						<font fontName="Arial" size="12"/>
						<paragraph lineSpacing="1_1_2"/>
					</textElement>
					<textFieldExpression><![CDATA["We have provided utility service to the above referenced customer and have been asked to furnish credit information on their account.<br /><br />"+

"In reviewing the last 12 months of service, and based on our criteria, this customer has established a credit rating of <b>GOOD</b>. There are 2 late fees and no returned payment items. Customer was never interrupted for non-payment.<br /><br />"+

"We hope this information is helpful to you. <br />"+
"Please feel free to contact us for further assistance. <br /><br />"+

"Thank you! <br /><br />"+

"City of College Station<br />"+
"Utility Customer Service<br />"+
"<font size=2>PO Box 10230</font><br />"+
"<font size=2>310 Krenek Tap Rd</font><br />"+
"<font size=2>College Station, Tx 77845</font><br />"+
"<font size=2>979-764-3535</font><br />"+
"<font size=2>1-800-849-6623</font><br />"+
"<font size=2><u>www.cstx.gov/ucs</u></font><br /><br />"+

"<b>*Excellent</b> credit rating is defined as two or less late payments received in the past 12 months. <br /><br />"+
"<b>*Good</b> credit rating is defined as more than two late payments received in the most recent 12 months.   <br /><br />"]]></textFieldExpression>
				</textField>
				<textField textAdjust="StretchHeight" pattern="MM/dd/yyyy" isBlankWhenNull="true">
					<reportElement stretchType="RelativeToBandHeight" x="0" y="13" width="572" height="25" isPrintWhenDetailOverflows="true" uuid="d7579dbe-11a6-40d0-bda2-9699ba8e4977">
