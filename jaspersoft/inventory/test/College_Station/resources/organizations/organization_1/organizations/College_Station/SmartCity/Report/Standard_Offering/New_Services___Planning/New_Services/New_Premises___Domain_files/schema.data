<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.jaspersoft.com/2007/SL/XMLSchema" version="1.3">
  <dataIslands>
    <itemGroup id="C1_CS_REQ_PREM_NEW_REQ" label="New Premise Requests" resourceId="C1_CS_REQ_PREM_NEW_REQ"></itemGroup>
  </dataIslands>
  <dataSources>
    <jdbcDataSource id="CollegeStation_DS">
      <schemaMap>
        <entry key="defaultSchema">
          <string></string>
        </entry>
        <entry key="CISADM">
          <string>CISADM</string>
        </entry>
      </schemaMap>
    </jdbcDataSource>
  </dataSources>
  <itemGroups>
    <itemGroup id="C1_CS_REQ_PREM_NEW_REQ_REQ" label="Request" resourceId="C1_CS_REQ_PREM_NEW_REQ">
      <items>
        <item id="CS_REQ_PREM_ID" label="Premise Request ID" resourceId="C1_CS_REQ_PREM_NEW_REQ.CS_REQ_PREM_ID"></item>
        <item id="CS_REQ_ID" label="Customer Service Request ID" resourceId="C1_CS_REQ_PREM_NEW_REQ.CS_REQ_ID"></item>
        <item id="BUS_OBJ_CD" label="Business Object Code" resourceId="C1_CS_REQ_PREM_NEW_REQ.BUS_OBJ_CD"></item>
        <item id="BO_STATUS_CD" label="Business Object Status" resourceId="C1_CS_REQ_PREM_NEW_REQ.BO_STATUS_CD"></item>
        <item id="BO_STATUS_REASON_CD" label="Status Reason Code" resourceId="C1_CS_REQ_PREM_NEW_REQ.BO_STATUS_REASON_CD"></item>
        <item id="CRE_DTTM" label="Create Date Time" resourceId="C1_CS_REQ_PREM_NEW_REQ.CRE_DTTM"></item>
        <item id="STATUS_UPD_DTTM" label="Status Update Date Time" resourceId="C1_CS_REQ_PREM_NEW_REQ.STATUS_UPD_DTTM"></item>
        <item id="CS_REQ_PREM_ACT_FLG" label="Premise Active Flag" resourceId="C1_CS_REQ_PREM_NEW_REQ.CS_REQ_PREM_ACT_FLG"></item>
        <item id="CS_REQ_ERR_HNDL_FLG" label="Error Handling Flag" resourceId="C1_CS_REQ_PREM_NEW_REQ.CS_REQ_ERR_HNDL_FLG"></item>
        <item defaultAgg="CountDistinct" dimensionOrMeasure="Measure" id="DISTINCT_PREMISE_COUNT" label="Distinct Premise Count" resourceId="C1_CS_REQ_PREM_NEW_REQ.PREM_ID"></item>
      </items>
    </itemGroup>
    <itemGroup id="C1_CS_REQ_PREM_NEW_REQ_PREM" label="Premise" resourceId="C1_CS_REQ_PREM_NEW_REQ">
      <items>
        <item id="PREM_ID" label="Premise ID" resourceId="C1_CS_REQ_PREM_NEW_REQ.PREM_ID"></item>
        <item id="PREM_VERSION" label="Premise Version" resourceId="C1_CS_REQ_PREM_NEW_REQ.PREM_VERSION"></item>
        <item id="PREM_TYPE_CD" label="Premise Type Code" resourceId="C1_CS_REQ_PREM_NEW_REQ.PREM_TYPE_CD"></item>
        <item id="CIS_DIVISION" label="CIS Division" resourceId="C1_CS_REQ_PREM_NEW_REQ.CIS_DIVISION"></item>
        <item id="LL_ID" label="Landlord ID" resourceId="C1_CS_REQ_PREM_NEW_REQ.LL_ID"></item>
        <item id="KEY_SW" label="Key Switch" resourceId="C1_CS_REQ_PREM_NEW_REQ.KEY_SW"></item>
        <item id="KEY_ID" label="Key ID" resourceId="C1_CS_REQ_PREM_NEW_REQ.KEY_ID"></item>
        <item id="OK_TO_ENTER_SW" label="OK To Enter Switch" resourceId="C1_CS_REQ_PREM_NEW_REQ.OK_TO_ENTER_SW"></item>
        <item id="MR_INSTR_CD" label="Meter Read Instruction Code" resourceId="C1_CS_REQ_PREM_NEW_REQ.MR_INSTR_CD"></item>
        <item id="MR_INSTR_DETAILS" label="Meter Read Instruction Details" resourceId="C1_CS_REQ_PREM_NEW_REQ.MR_INSTR_DETAILS"></item>
        <item id="MR_WARN_CD" label="Meter Read Warning Code" resourceId="C1_CS_REQ_PREM_NEW_REQ.MR_WARN_CD"></item>
        <item id="TREND_AREA_CD" label="Trend Area Code" resourceId="C1_CS_REQ_PREM_NEW_REQ.TREND_AREA_CD"></item>
        <item id="ADDRESS1" label="Address 1" resourceId="C1_CS_REQ_PREM_NEW_REQ.ADDRESS1"></item>
        <item id="ADDRESS1_UPR" label="Address 1 Upper" resourceId="C1_CS_REQ_PREM_NEW_REQ.ADDRESS1_UPR"></item>
        <item id="ADDRESS2" label="Address 2" resourceId="C1_CS_REQ_PREM_NEW_REQ.ADDRESS2"></item>
        <item id="ADDRESS3" label="Address 3" resourceId="C1_CS_REQ_PREM_NEW_REQ.ADDRESS3"></item>
        <item id="ADDRESS4" label="Address 4" resourceId="C1_CS_REQ_PREM_NEW_REQ.ADDRESS4"></item>
        <item id="MAIL_ADDR_SW" label="Mail Address Switch" resourceId="C1_CS_REQ_PREM_NEW_REQ.MAIL_ADDR_SW"></item>
        <item id="CITY" label="City" resourceId="C1_CS_REQ_PREM_NEW_REQ.CITY"></item>
        <item id="CITY_UPR" label="City Upper" resourceId="C1_CS_REQ_PREM_NEW_REQ.CITY_UPR"></item>
        <item id="NUM1" label="House Number 1" resourceId="C1_CS_REQ_PREM_NEW_REQ.NUM1"></item>
        <item id="NUM2" label="House Number 2" resourceId="C1_CS_REQ_PREM_NEW_REQ.NUM2"></item>
        <item id="COUNTY" label="County" resourceId="C1_CS_REQ_PREM_NEW_REQ.COUNTY"></item>
        <item id="POSTAL" label="Postal" resourceId="C1_CS_REQ_PREM_NEW_REQ.POSTAL"></item>
        <item id="HOUSE_TYPE" label="House Type" resourceId="C1_CS_REQ_PREM_NEW_REQ.HOUSE_TYPE"></item>
        <item id="GEO_CODE" label="Geo Code" resourceId="C1_CS_REQ_PREM_NEW_REQ.GEO_CODE"></item>
        <item id="IN_CITY_LIMIT" label="In City Limit" resourceId="C1_CS_REQ_PREM_NEW_REQ.IN_CITY_LIMIT"></item>
        <item id="COUNTRY" label="Country" resourceId="C1_CS_REQ_PREM_NEW_REQ.COUNTRY"></item>
        <item id="STATE" label="State" resourceId="C1_CS_REQ_PREM_NEW_REQ.STATE"></item>
        <item id="TIME_ZONE_CD" label="Time Zone Code" resourceId="C1_CS_REQ_PREM_NEW_REQ.TIME_ZONE_CD"></item>
        <item id="LS_SL_FLG" label="Line/Service Line Flag" resourceId="C1_CS_REQ_PREM_NEW_REQ.LS_SL_FLG"></item>
        <item id="LS_SL_DESCR" label="Line/Service Line Description" resourceId="C1_CS_REQ_PREM_NEW_REQ.LS_SL_DESCR"></item>
        <item id="PRNT_PREM_ID" label="Parent Premise ID" resourceId="C1_CS_REQ_PREM_NEW_REQ.PRNT_PREM_ID"></item>
        <item id="ILM_ARCH_SW" label="ILM Archive Switch" resourceId="C1_CS_REQ_PREM_NEW_REQ.ILM_ARCH_SW"></item>
        <item id="ILM_DT" label="ILM Date" resourceId="C1_CS_REQ_PREM_NEW_REQ.ILM_DT"></item>
      </items>
    </itemGroup>
    <itemGroup id="C1_CS_REQ_PREM_NEW_REQ_CHAR" label="Characteristics" resourceId="C1_CS_REQ_PREM_NEW_REQ">
      <items>
        <item defaultAgg="Sum" dimensionOrMeasure="Measure" id="CHAR_ROW_COUNT" label="Characteristic Row Count" resourceId="C1_CS_REQ_PREM_NEW_REQ.CHAR_ROW_COUNT"></item>
        <item id="HAS_CHAR_SW" label="Has Characteristics" resourceId="C1_CS_REQ_PREM_NEW_REQ.HAS_CHAR_SW"></item>
        <item id="CHAR_VALUES" label="Characteristic Values" resourceId="C1_CS_REQ_PREM_NEW_REQ.CHAR_VALUES"></item>
      </items>
    </itemGroup>
    <itemGroup id="C1_CS_REQ_PREM_NEW_REQ_AUDIT" label="Audit" resourceId="C1_CS_REQ_PREM_NEW_REQ">
      <items>
        <item id="VERSION" label="Version" resourceId="C1_CS_REQ_PREM_NEW_REQ.VERSION"></item>
      </items>
    </itemGroup>
  </itemGroups>
  <resources>
    <jdbcQuery id="C1_CS_REQ_PREM_NEW_REQ" datasourceId="CollegeStation_DS">
      <fieldList>
        <field id="CS_REQ_PREM_ID" type="java.lang.String"></field>
        <field id="CS_REQ_ID" type="java.lang.String"></field>
        <field id="BUS_OBJ_CD" type="java.lang.String"></field>
        <field id="BO_STATUS_CD" type="java.lang.String"></field>
        <field id="BO_STATUS_REASON_CD" type="java.lang.String"></field>
        <field id="CRE_DTTM" type="java.sql.Timestamp"></field>
        <field id="STATUS_UPD_DTTM" type="java.sql.Timestamp"></field>
        <field id="CS_REQ_PREM_ACT_FLG" type="java.lang.String"></field>
        <field id="CS_REQ_ERR_HNDL_FLG" type="java.lang.String"></field>
        <field id="PREM_TYPE_CD" type="java.lang.String"></field>
        <field id="CIS_DIVISION" type="java.lang.String"></field>
        <field id="LL_ID" type="java.lang.String"></field>
        <field id="KEY_SW" type="java.lang.String"></field>
        <field id="KEY_ID" type="java.lang.String"></field>
        <field id="OK_TO_ENTER_SW" type="java.lang.String"></field>
        <field id="MR_INSTR_CD" type="java.lang.String"></field>
        <field id="MR_INSTR_DETAILS" type="java.lang.String"></field>
        <field id="MR_WARN_CD" type="java.lang.String"></field>
        <field id="TREND_AREA_CD" type="java.lang.String"></field>
        <field id="ADDRESS1" type="java.lang.String"></field>
        <field id="ADDRESS1_UPR" type="java.lang.String"></field>
        <field id="ADDRESS2" type="java.lang.String"></field>
        <field id="ADDRESS3" type="java.lang.String"></field>
        <field id="ADDRESS4" type="java.lang.String"></field>
        <field id="MAIL_ADDR_SW" type="java.lang.String"></field>
        <field id="CITY" type="java.lang.String"></field>
        <field id="CITY_UPR" type="java.lang.String"></field>
        <field id="NUM1" type="java.lang.String"></field>
        <field id="NUM2" type="java.lang.String"></field>
        <field id="COUNTY" type="java.lang.String"></field>
        <field id="POSTAL" type="java.lang.String"></field>
        <field id="HOUSE_TYPE" type="java.lang.String"></field>
        <field id="GEO_CODE" type="java.lang.String"></field>
        <field id="IN_CITY_LIMIT" type="java.lang.String"></field>
        <field id="COUNTRY" type="java.lang.String"></field>
        <field id="STATE" type="java.lang.String"></field>
        <field id="TIME_ZONE_CD" type="java.lang.String"></field>
        <field id="LS_SL_FLG" type="java.lang.String"></field>
        <field id="LS_SL_DESCR" type="java.lang.String"></field>
        <field id="PRNT_PREM_ID" type="java.lang.String"></field>
        <field id="PREM_ID" type="java.lang.String"></field>
        <field id="PREM_VERSION" type="java.math.BigDecimal"></field>
        <field id="ILM_ARCH_SW" type="java.lang.String"></field>
        <field id="ILM_DT" type="java.sql.Timestamp"></field>
        <field id="VERSION" type="java.math.BigDecimal"></field>
        <field id="CHAR_ROW_COUNT" type="java.math.BigDecimal"></field>
        <field id="HAS_CHAR_SW" type="java.lang.String"></field>
        <field id="CHAR_VALUES" type="java.lang.String"></field>
      </fieldList>
      <query>SELECT
    r.cs_req_prem_id,
    r.cs_req_id,
    r.bus_obj_cd,
    r.bo_status_cd,
    r.bo_status_reason_cd,
    r.cre_dttm,
    r.status_upd_dttm,
    r.cs_req_prem_act_flg,
    r.cs_req_err_hndl_flg,
    r.prem_type_cd,
    r.cis_division,
    r.ll_id,
    r.key_sw,
    r.key_id,
    r.ok_to_enter_sw,
    r.mr_instr_cd,
    r.mr_instr_details,
    r.mr_warn_cd,
    r.trend_area_cd,
    r.address1,
    r.address1_upr,
    r.address2,
    r.address3,
    r.address4,
    r.mail_addr_sw,
    r.city,
    r.city_upr,
    r.num1,
    r.num2,
    r.county,
    r.postal,
    r.house_type,
    r.geo_code,
    r.in_city_limit,
    r.country,
    r.state,
    r.time_zone_cd,
    r.ls_sl_flg,
    r.ls_sl_descr,
    r.prnt_prem_id,
    r.prem_id,
    r.prem_version,
    r.ilm_arch_sw,
    r.ilm_dt,
    r.version,
    NVL(c.char_row_count, 0) AS char_row_count,
    CASE WHEN NVL(c.char_row_count, 0) &gt; 0 THEN 'Y' ELSE 'N' END AS has_char_sw,
    c.char_values
FROM cisadm.c1_cs_req_prem r
LEFT JOIN (
    SELECT
        cs_req_prem_id,
        COUNT(*) AS char_row_count,
        LISTAGG(srch_char_val, ' | ') WITHIN GROUP (ORDER BY srch_char_val) AS char_values
    FROM cisadm.c1_cs_req_prem_char
    GROUP BY cs_req_prem_id
) c
    ON c.cs_req_prem_id = r.cs_req_prem_id</query>
    </jdbcQuery>
  </resources>
</schema>
