<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.jaspersoft.com/2007/SL/XMLSchema" version="1.3">
  <dataIslands>
    <itemGroup id="JoinTree_1" label="JoinTree_1" resourceId="JoinTree_1"></itemGroup>
  </dataIslands>
  <dataSources>
    <jdbcDataSource id="CollegeStation_DS">
      <schemaMap>
        <entry key="defaultSchema">
          <string></string>
        </entry>
        <entry key="CISADM">
          <string>CISADM</string>
        </entry>
      </schemaMap>
    </jdbcDataSource>
  </dataSources>
  <itemGroups>
    <itemGroup id="CS_TRIAL_BALANCE" label="CS_TRIAL_BALANCE" resourceId="JoinTree_1">
      <items>
        <item id="A0" label="Total" resourceId="JoinTree_1.CS_TRIAL_BALANCE.A0"></item>
        <item id="A15" label="Current" resourceId="JoinTree_1.CS_TRIAL_BALANCE.A15"></item>
        <item id="A45" label="15-45 Days" resourceId="JoinTree_1.CS_TRIAL_BALANCE.A45"></item>
        <item id="A90" label="45-90 Days" resourceId="JoinTree_1.CS_TRIAL_BALANCE.A90"></item>
        <item id="AOLD" label="90+ Days" resourceId="JoinTree_1.CS_TRIAL_BALANCE.AOLD"></item>
        <item id="DESCR" label="Description" resourceId="JoinTree_1.CS_TRIAL_BALANCE.DESCR"></item>
        <item id="DST_ID" label="Distribution Code" resourceId="JoinTree_1.CS_TRIAL_BALANCE.DST_ID"></item>
        <item id="GL_ACCT" label="GL Account" resourceId="JoinTree_1.CI_DST_CODE_EFF.GL_ACCT"></item>
      </items>
    </itemGroup>
  </itemGroups>
  <resources>
    <jdbcTable id="CI_DST_CODE_EFF" datasourceId="CollegeStation_DS" datasourceTableName="CI_DST_CODE_EFF" schemaAlias="CISADM">
      <fieldList>
        <field id="DST_ID" type="java.lang.String"></field>
        <field id="EFFDT" type="java.sql.Timestamp"></field>
        <field id="EFF_STATUS" type="java.lang.String"></field>
        <field id="GL_ACCT" type="java.lang.String"></field>
        <field id="VERSION" type="java.math.BigDecimal"></field>
        <field id="STATISTICS_CD" type="java.lang.String"></field>
        <field id="FUND_CD" type="java.lang.String"></field>
      </fieldList>
      <filterString>EFF_STATUS == 'A'</filterString>
    </jdbcTable>
    <jdbcQuery id="CS_TRIAL_BALANCE" datasourceId="CollegeStation_DS">
      <fieldList>
        <field id="DST_ID" type="java.lang.String"></field>
        <field id="DESCR" type="java.lang.String"></field>
        <field id="A0" type="java.math.BigDecimal"></field>
        <field id="A45" type="java.math.BigDecimal"></field>
        <field id="A90" type="java.math.BigDecimal"></field>
        <field id="AOLD" type="java.math.BigDecimal"></field>
        <field id="A15" type="java.math.BigDecimal"></field>
      </fieldList>
      <query>select DCL.DST_ID, DCL.DESCR, FTGL0.a0, FTGL15.a15, FTGL45.a45, FTGL90.a90, FTGLOLD.aold from CISADM.CI_DST_CODE_L DCL 
LEFT JOIN (SELECT DST_ID ,SUM(AMOUNT) as aold FROM CISADM.CI_FT_GL WHERE FT_ID IN (select FT1.FT_ID from cisadm.CI_FT FT1 where FT1.ARS_DT &lt;= trunc(SYSDATE) - 91) group by DST_ID) FTGLOLD on FTGLOLD.DST_ID = DCL.DST_ID
LEFT JOIN (SELECT DST_ID ,SUM(AMOUNT) as a90 FROM CISADM.CI_FT_GL WHERE FT_ID IN (select FT1.FT_ID from cisadm.CI_FT FT1 where FT1.ARS_DT between trunc(SYSDATE) -90 and trunc(SYSDATE - 46)) group by DST_ID) FTGL90 on FTGL90.DST_ID = DCL.DST_ID
LEFT JOIN (SELECT DST_ID ,SUM(AMOUNT) as a45 FROM CISADM.CI_FT_GL WHERE FT_ID IN (select FT1.FT_ID from cisadm.CI_FT FT1 where FT1.ARS_DT between trunc(SYSDATE) -45 and trunc(SYSDATE) -16) group by DST_ID) FTGL45 on FTGL45.DST_ID = DCL.DST_ID  
LEFT JOIN (SELECT DST_ID ,SUM(AMOUNT) as a15 FROM CISADM.CI_FT_GL WHERE FT_ID IN (select FT1.FT_ID from cisadm.CI_FT FT1 where FT1.ARS_DT between trunc(SYSDATE) -15 and trunc(SYSDATE)) group by DST_ID) FTGL15 on FTGL15.DST_ID = DCL.DST_ID
LEFT JOIN (SELECT DST_ID ,SUM(AMOUNT) as a0 FROM CISADM.CI_FT_GL WHERE FT_ID IN (select FT1.FT_ID from cisadm.CI_FT FT1 where FT1.ARS_DT &lt;= trunc(SYSDATE)) group by DST_ID) FTGL0 on FTGL0.DST_ID = DCL.DST_ID</query>
    </jdbcQuery>
    <jdbcQuery id="JoinTree_1" datasourceId="CollegeStation_DS">
      <fieldList>
        <field id="CS_TRIAL_BALANCE.DST_ID" type="java.lang.String"></field>
        <field id="CS_TRIAL_BALANCE.DESCR" type="java.lang.String"></field>
        <field id="CS_TRIAL_BALANCE.A0" type="java.math.BigDecimal"></field>
        <field id="CS_TRIAL_BALANCE.A45" type="java.math.BigDecimal"></field>
        <field id="CS_TRIAL_BALANCE.A90" type="java.math.BigDecimal"></field>
        <field id="CS_TRIAL_BALANCE.AOLD" type="java.math.BigDecimal"></field>
        <field id="CS_TRIAL_BALANCE.A15" type="java.math.BigDecimal"></field>
        <field id="CI_DST_CODE_EFF.DST_ID" type="java.lang.String"></field>
        <field id="CI_DST_CODE_EFF.EFFDT" type="java.sql.Timestamp"></field>
        <field id="CI_DST_CODE_EFF.EFF_STATUS" type="java.lang.String"></field>
        <field id="CI_DST_CODE_EFF.GL_ACCT" type="java.lang.String"></field>
        <field id="CI_DST_CODE_EFF.VERSION" type="java.math.BigDecimal"></field>
        <field id="CI_DST_CODE_EFF.STATISTICS_CD" type="java.lang.String"></field>
        <field id="CI_DST_CODE_EFF.FUND_CD" type="java.lang.String"></field>
      </fieldList>
      <filterString>CI_DST_CODE_EFF.EFF_STATUS == 'A'</filterString>
      <joinInfo alias="CS_TRIAL_BALANCE" referenceId="CS_TRIAL_BALANCE"></joinInfo>
      <joinList>
        <join expr="CS_TRIAL_BALANCE.DST_ID == CI_DST_CODE_EFF.DST_ID" left="CS_TRIAL_BALANCE" right="CI_DST_CODE_EFF" type="inner" weight="1"></join>
      </joinList>
      <joinOptions></joinOptions>
      <query>select DCL.DST_ID, DCL.DESCR, FTGL0.a0, FTGL15.a15, FTGL45.a45, FTGL90.a90, FTGLOLD.aold from CISADM.CI_DST_CODE_L DCL 
LEFT JOIN (SELECT DST_ID ,SUM(AMOUNT) as aold FROM CISADM.CI_FT_GL WHERE FT_ID IN (select FT1.FT_ID from cisadm.CI_FT FT1 where FT1.ARS_DT &lt;= trunc(SYSDATE) - 91) group by DST_ID) FTGLOLD on FTGLOLD.DST_ID = DCL.DST_ID
LEFT JOIN (SELECT DST_ID ,SUM(AMOUNT) as a90 FROM CISADM.CI_FT_GL WHERE FT_ID IN (select FT1.FT_ID from cisadm.CI_FT FT1 where FT1.ARS_DT between trunc(SYSDATE) -90 and trunc(SYSDATE - 46)) group by DST_ID) FTGL90 on FTGL90.DST_ID = DCL.DST_ID
LEFT JOIN (SELECT DST_ID ,SUM(AMOUNT) as a45 FROM CISADM.CI_FT_GL WHERE FT_ID IN (select FT1.FT_ID from cisadm.CI_FT FT1 where FT1.ARS_DT between trunc(SYSDATE) -45 and trunc(SYSDATE) -16) group by DST_ID) FTGL45 on FTGL45.DST_ID = DCL.DST_ID  
LEFT JOIN (SELECT DST_ID ,SUM(AMOUNT) as a15 FROM CISADM.CI_FT_GL WHERE FT_ID IN (select FT1.FT_ID from cisadm.CI_FT FT1 where FT1.ARS_DT between trunc(SYSDATE) -15 and trunc(SYSDATE)) group by DST_ID) FTGL15 on FTGL15.DST_ID = DCL.DST_ID
LEFT JOIN (SELECT DST_ID ,SUM(AMOUNT) as a0 FROM CISADM.CI_FT_GL WHERE FT_ID IN (select FT1.FT_ID from cisadm.CI_FT FT1 where FT1.ARS_DT &lt;= trunc(SYSDATE)) group by DST_ID) FTGL0 on FTGL0.DST_ID = DCL.DST_ID</query>
      <tableRefList>
        <tableRef alwaysIncludeTable="false" tableAlias="CS_TRIAL_BALANCE" tableId="CS_TRIAL_BALANCE"></tableRef>
        <tableRef alwaysIncludeTable="false" tableAlias="CI_DST_CODE_EFF" tableId="CI_DST_CODE_EFF"></tableRef>
      </tableRefList>
    </jdbcQuery>
  </resources>
</schema>
