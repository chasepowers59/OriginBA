        <field id="MATCH_VAL" type="java.lang.String"></field>
        <field id="ILM_DT" type="java.sql.Timestamp"></field>
        <field id="ILM_ARCH_SW" type="java.lang.String"></field>
      </fieldList>
      <filterString>PAY_STATUS_FLG == '60'</filterString>
    </jdbcTable>
    <jdbcTable id="CI_PAY_CAN_RSN_L" datasourceId="CollegeStation_DS" datasourceTableName="CI_PAY_CAN_RSN_L" schemaAlias="CISADM">
