    <jdbcTable id="CI_TENDER_TYPE_L" datasourceId="CollegeStation_DS" datasourceTableName="CI_TENDER_TYPE_L" schemaAlias="CISADM">
      <fieldList>
        <field id="TENDER_TYPE_CD" type="java.lang.String"></field>
        <field id="LANGUAGE_CD" type="java.lang.String"></field>
        <field id="DESCR" type="java.lang.String"></field>
        <field id="VERSION" type="java.math.BigDecimal"></field>
      </fieldList>
      <filterString>LANGUAGE_CD == 'ENG' and TENDER_TYPE_CD in ('CCHK', 'CHEC', 'TPCK')</filterString>
    </jdbcTable>
    <jdbcQuery id="CS_PREMISE" datasourceId="CollegeStation_DS">
      <fieldList>
        <field id="ACCT_ID" type="java.lang.String"></field>
        <field id="PREM_ID" type="java.lang.String"></field>
        <field id="ADDRESS1" type="java.lang.String"></field>
        <field id="CITY" type="java.lang.String"></field>
        <field id="STATE" type="java.lang.String"></field>
        <field id="POSTAL" type="java.lang.String"></field>
        <field id="COUNTRY" type="java.lang.String"></field>
        <field id="CIS_DIVISION" type="java.lang.String"></field>
      </fieldList>
      <query>SELECT DISTINCT SA.ACCT_ID, P.PREM_ID, P.ADDRESS1, P.CITY, P.STATE, P.POSTAL, P.COUNTRY, P.CIS_DIVISION FROM CISADM.CI_PREM P, CISADM.CI_SA SA WHERE P.PREM_ID = SA.CHAR_PREM_ID</query>
    </jdbcQuery>
