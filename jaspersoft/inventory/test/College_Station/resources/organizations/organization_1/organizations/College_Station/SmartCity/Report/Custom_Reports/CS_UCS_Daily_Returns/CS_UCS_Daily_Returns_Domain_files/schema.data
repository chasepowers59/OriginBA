    <jdbcTable id="CI_PAY" datasourceId="CollegeStation_DS" datasourceTableName="CI_PAY" schemaAlias="CISADM">
      <fieldList>
        <field id="PAY_ID" type="java.lang.String"></field>
        <field id="PAY_EVENT_ID" type="java.lang.String"></field>
        <field id="CAN_RSN_CD" type="java.lang.String"></field>
