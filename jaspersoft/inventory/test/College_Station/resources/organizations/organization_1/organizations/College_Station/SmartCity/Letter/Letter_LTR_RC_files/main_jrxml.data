					</textElement>
					<textFieldExpression><![CDATA[($F{entityName1}==null?"":$F{entityName1})+ "<br />" +
($F{mailingAddress1}==null?"":$F{mailingAddress1})+($F{mailingCity}==null?"":$F{mailingCity})+", "+
($F{mailingState}==null?"":$F{mailingState})+" " + ($F{mailingPostal}==null?"":$F{mailingPostal})+ "<br />"]]></textFieldExpression>
				</textField>
				<textField textAdjust="StretchHeight" pattern="MM/dd/yyyy">
					<reportElement x="0" y="79" width="572" height="358" uuid="95d0e317-8ea0-48bb-ba9e-992431a4ad6e">
						<property name="com.jaspersoft.studio.unit.height" value="px"/>
					</reportElement>
					<box topPadding="2" leftPadding="10" bottomPadding="2" rightPadding="10"/>
					<textElement textAlignment="Justified" verticalAlignment="Top" markup="html">
						<font fontName="Arial" size="12"/>
						<paragraph lineSpacing="1_1_2"/>
					</textElement>
					<textFieldExpression><![CDATA["Dear Customer,<br /><br />"+

"Your check that was presented to pay the above referenced account has been returned due to NSF.  As of the date of this letter, we will no longer be able to accept checks as a form of payment on this utility account.  All future payments must be made in the form of Cash, Cashier Check, Money Order, or Credit Card. <br /><br />"+

"The check amount of $"+$F{tenderAmount}.setScale(2)+" plus a $"+$F{adjustmentAmount}.setScale(2) +" returned check fee has been charged to your utility account. Please remit the total amount of <u><b>$"+new BigDecimal(SUM($F{tenderAmount},$F{adjustmentAmount}).toString()).setScale(2)+" PRIOR TO 5:00PM ON " +DATEFORMAT($F{CMS_DUED},"MM/dd/yyyy")+ "</u></b> to avoid interruption of service.  Credit card payments may be made by calling (979) 764-Epay (3729), by logging in to our website, epay.cstx.gov, or with a customer service representative by calling (979) 764-3535 during normal business hours.  You will need your utility account number to make a credit card payment by phone.  <br /><br />"+

"Should you have any questions regarding this notice, please contact us at (979) 764-3535.  Thank you for your cooperation in this matter. <br /><br />"]]></textFieldExpression>
				</textField>
				<textField textAdjust="StretchHeight" isBlankWhenNull="true">
					<reportElement stretchType="RelativeToBandHeight" x="0" y="28" width="70" height="47" isPrintWhenDetailOverflows="true" uuid="d71d9aad-922f-47b3-88f6-92e414be2c6d">
						<property name="com.jaspersoft.studio.unit.x" value="px"/>
