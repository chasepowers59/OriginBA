        <item id="SUM_CUR_AMT" label="Total Due" resourceId="JoinTree_5.CS_ACCT_DET_AUTO_CALL.SUM_CUR_AMT"></item>
        <item id="CONTACT_DATE" label="Contact Date" resourceId="JoinTree_5.CS_ACCT_DET_AUTO_CALL.CONTACT_DATE"></item>
