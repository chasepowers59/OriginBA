    <subFilter id="filter_6" letter="F" sourceString="DYNAMIC">
      <expressionString>startsWith(BSEG_SQ_CUSTOMER.ACCT_ID, '')</expressionString>
      <parameterizedExpressionString>startsWith(BSEG_SQ_CUSTOMER.ACCT_ID, ACCT_ID_1)</parameterizedExpressionString>
    </subFilter>
    <subFilter id="filter_1" letter="A" sourceString="DYNAMIC">
      <expressionString>betweenDates(BSEG_SQ_BILLING.BILL_DT, ts'2026-09-01', 'DAY-0')</expressionString>
      <parameterizedExpressionString>betweenDates(BSEG_SQ_BILLING.BILL_DT, BILL_DT_1, BILL_DT_2)</parameterizedExpressionString>
    </subFilter>
    <subFilter id="filter_2" letter="B" sourceString="DYNAMIC">
      <expressionString>BSEG_SQ_DETERMINANT.UOM_DESC in ('Kilowatt', 'Kilowatt-Hours', 'Mille Gallons')</expressionString>
      <parameterizedExpressionString>BSEG_SQ_DETERMINANT.UOM_DESC in UOM_DESC_1</parameterizedExpressionString>
    </subFilter>
    <subFilter id="filter_3" letter="C" sourceString="DYNAMIC">
      <expressionString>BSEG_SQ_BILLING.BSEG_STAT_DESC == 'Frozen'</expressionString>
      <parameterizedExpressionString>BSEG_SQ_BILLING.BSEG_STAT_DESC == BSEG_STAT_DESC_1</parameterizedExpressionString>
    </subFilter>
    <subFilter id="filter_7" letter="G" sourceString="DYNAMIC">
      <expressionString>isAnyValue(BSEG_SQ_CUSTOMER.SA_TYPE_DESC)</expressionString>
      <parameterizedExpressionString>BSEG_SQ_CUSTOMER.SA_TYPE_DESC in SA_TYPE_DESC_1</parameterizedExpressionString>
    </subFilter>
    <subFilter id="filter_4" letter="D" sourceString="DYNAMIC">
      <expressionString>BSEG_SQ_DETERMINANT.SQI_DESC == null</expressionString>
      <parameterizedExpressionString>BSEG_SQ_DETERMINANT.SQI_DESC == SQI_DESC_1</parameterizedExpressionString>
    </subFilter>
    <subFilter id="filter_8" letter="H" sourceString="DYNAMIC">
      <expressionString>BSEG_SQ_DETERMINANT.TOTAL_BILL_SQ &gt; 0</expressionString>
      <parameterizedExpressionString>BSEG_SQ_DETERMINANT.TOTAL_BILL_SQ &gt; TOTAL_BILL_SQ_1</parameterizedExpressionString>
    </subFilter>
  </subFilterList>
