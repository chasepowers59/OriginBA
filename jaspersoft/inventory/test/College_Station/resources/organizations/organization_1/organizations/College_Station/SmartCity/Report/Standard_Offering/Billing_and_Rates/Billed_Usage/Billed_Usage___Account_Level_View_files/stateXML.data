  <subFilterList>
    <subFilter id="filter_5" letter="E" sourceString="DYNAMIC">
      <expressionString>startsWith(BSEG_SQ_CUSTOMER.CUSTOMER_NAME, '')</expressionString>
      <parameterizedExpressionString>startsWith(BSEG_SQ_CUSTOMER.CUSTOMER_NAME, CUSTOMER_NAME_1)</parameterizedExpressionString>
