    <jdbcQuery id="CS_LATEST_SA_RS_HIST" datasourceId="CollegeStation_DS">
      <fieldList>
        <field id="EFFDT" type="java.sql.Timestamp"></field>
        <field id="SA_ID" type="java.lang.String"></field>
      </fieldList>
      <query>SELECT MAX(SARH.EFFDT) AS EFFDT, SARH.SA_ID FROM CISADM.CI_SA_RS_HIST SARH GROUP BY SARH.SA_ID</query>
    </jdbcQuery>
    <jdbcQuery id="CS_LATEST_SA_RATE_CHAR" datasourceId="CollegeStation_DS">
      <fieldList>
        <field id="SA_ID" type="java.lang.String"></field>
        <field id="CHAR_TYPE_CD" type="java.lang.String"></field>
        <field id="SRCH_CHAR_VAL" type="java.lang.String"></field>
      </fieldList>
      <query>SELECT SAC.SA_ID, SAC.CHAR_TYPE_CD, SAC.SRCH_CHAR_VAL 
FROM CISADM.CI_SA_CHAR SAC
WHERE SAC.CHAR_TYPE_CD IN ('2YC','PCT-SA','NUM-SA','PCT-DR','PCT-SA','RES-SA','UNITS-DR','UNITS-RM','UNITS-SW','4YC','4YD','6YC','8YD','90G','400G') 
AND SAC.EFFDT = (SELECT MAX(SAC2.EFFDT) FROM CISADM.CI_SA_CHAR SAC2 WHERE SAC2.CHAR_TYPE_CD = SAC.CHAR_TYPE_CD AND SAC2.SA_ID = SAC.SA_ID)</query>
    </jdbcQuery>
