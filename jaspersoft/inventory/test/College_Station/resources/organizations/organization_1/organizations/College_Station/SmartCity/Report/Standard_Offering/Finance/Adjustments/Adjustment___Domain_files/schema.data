        <field id="ADJ_AGE.OPEN_OVER_30_DAYS" type="java.lang.String"></field>
        <field id="IS_FROZEN" dataSetExpression="CaseWhen(CI_ADJ.ADJ_STATUS_FLG == '50', 'Y', 'N')" type="java.lang.String"></field>
        <field id="IS_CANCELED" dataSetExpression="CaseWhen(CI_ADJ.ADJ_STATUS_FLG == '60', 'Y', 'N')" type="java.lang.String"></field>
        <field id="IS_OPEN" dataSetExpression="CaseWhen(CI_ADJ.ADJ_STATUS_FLG != '50' and CI_ADJ.ADJ_STATUS_FLG != '60', 'Y', 'N')" type="java.lang.String"></field>
        <field id="AMOUNT_DIRECTION" dataSetExpression="CaseWhen(CI_ADJ.ADJ_AMT &lt; 0, 'Credit', 'Debit')" type="java.lang.String"></field>
        <field id="IS_TRANSFER" dataSetExpression="CaseWhen(IsNull(CI_ADJ.XFER_ADJ_ID) or CI_ADJ.XFER_ADJ_ID == ' ', 'N', 'Y')" type="java.lang.String"></field>
        <field id="IS_ON_BEHALF" dataSetExpression="CaseWhen(IsNull(CI_ADJ.BEHALF_SA_ID) or CI_ADJ.BEHALF_SA_ID == ' ', 'N', 'Y')" type="java.lang.String"></field>
        <field id="HAS_APPROVAL_REQUEST" dataSetExpression="CaseWhen(IsNull(CI_ADJ.APPR_REQ_ID) or CI_ADJ.APPR_REQ_ID == ' ', 'N', 'Y')" type="java.lang.String"></field>
        <field id="IS_AP_ADJ_TYPE" dataSetExpression="CaseWhen(IsNull(CI_ADJ_TYPE.AP_REQ_TYPE_CD) or CI_ADJ_TYPE.AP_REQ_TYPE_CD == ' ', 'N', 'Y')" type="java.lang.String"></field>
        <field id="HAS_AP_REQUEST" dataSetExpression="CaseWhen(IsNull(CI_ADJ_APREQ.AP_REQ_ID), 'N', 'Y')" type="java.lang.String"></field>
        <field id="AP_ACTION_NEEDED" dataSetExpression="CaseWhen(CI_ADJ_APREQ.PYMNT_SEL_STAT_FLG == 'X' and (CI_ADJ.ADJ_STATUS_FLG == '30' or CI_ADJ.ADJ_STATUS_FLG == '50'), 'Y', 'N')" type="java.lang.String"></field>
        <field id="PAID_BUT_ADJ_CANCELED" dataSetExpression="CaseWhen(CI_ADJ_APREQ.PYMNT_SEL_STAT_FLG == 'P' and CI_ADJ.ADJ_STATUS_FLG == '60', 'Y', 'N')" type="java.lang.String"></field>
        <field id="HAS_FT" dataSetExpression="CaseWhen(IsNull(ADJ_FT.ADJ_ID), 'N', 'Y')" type="java.lang.String"></field>
        <field id="HAS_CHARACTERISTICS" dataSetExpression="CaseWhen(IsNull(ADJ_CHAR.ADJ_ID), 'N', 'Y')" type="java.lang.String"></field>
        <field id="SA_IS_ACTIVE" dataSetExpression="CaseWhen(CI_SA.SA_STATUS_FLG == '20', 'Y', 'N')" type="java.lang.String"></field>
        <field id="SA_IS_REVENUE_BEARING" dataSetExpression="CaseWhen(CI_SA_TYPE.SPECIAL_ROLE_FLG == 'PA' or CI_SA_TYPE.SPECIAL_ROLE_FLG == 'CD' or CI_SA_TYPE.SPECIAL_ROLE_FLG == 'WO' or CI_SA_TYPE.SPECIAL_ROLE_FLG == 'LO' or CI_SA_TYPE.SPECIAL_ROLE_FLG == 'NB', 'N', 'Y')" type="java.lang.String"></field>
        <field id="CUSTOMER_IS_PERSON" dataSetExpression="CaseWhen(CI_PER.PER_OR_BUS_FLG == 'P', 'Y', 'N')" type="java.lang.String"></field>
        <field id="ADJ_DIST" dataSetExpression="CountDistinct(CI_ADJ.ADJ_ID, 'Current')" type="java.lang.Long"></field>
        <field id="SA_DIST" dataSetExpression="CountDistinct(CI_ADJ.SA_ID, 'Current')" type="java.lang.Long"></field>
        <field id="ACCT_DIST" dataSetExpression="CountDistinct(CI_SA.ACCT_ID, 'Current')" type="java.lang.Long"></field>
        <field id="AP_REQ_DIST" dataSetExpression="CountDistinct(CI_ADJ_APREQ.AP_REQ_ID, 'Current')" type="java.lang.Long"></field>
      </fieldList>
      <joinInfo alias="CI_ADJ" referenceId="CI_ADJ"></joinInfo>
      <joinList>
        <join expr="CI_ADJ.ADJ_TYPE_CD == CI_ADJ_TYPE.ADJ_TYPE_CD" left="CI_ADJ" right="CI_ADJ_TYPE" type="leftOuter" weight="1"></join>
        <join expr="CI_ADJ.ADJ_TYPE_CD == CI_ADJ_TYPE_L.ADJ_TYPE_CD and CI_ADJ_TYPE_L.LANGUAGE_CD == 'ENG'" left="CI_ADJ" right="CI_ADJ_TYPE_L" type="leftOuter" weight="1"></join>
        <join expr="CI_ADJ_TYPE.DST_ID == CI_DST_CODE_L.DST_ID and CI_DST_CODE_L.LANGUAGE_CD == 'ENG'" left="CI_ADJ_TYPE" right="CI_DST_CODE_L" type="leftOuter" weight="1"></join>
        <join expr="CI_ADJ_TYPE.APPR_PROF_CD == TYPE_APPR_PROF_L.APPR_PROF_CD and TYPE_APPR_PROF_L.LANGUAGE_CD == 'ENG'" left="CI_ADJ_TYPE" right="TYPE_APPR_PROF_L" type="leftOuter" weight="1"></join>
        <join expr="CI_ADJ_TYPE.AD_FRZ_OPT_FLG == FRZ_OPT_L.FIELD_VALUE and FRZ_OPT_L.FIELD_NAME == 'AD_FRZ_OPT_FLG' and FRZ_OPT_L.LANGUAGE_CD == 'ENG'" left="CI_ADJ_TYPE" right="FRZ_OPT_L" type="leftOuter" weight="1"></join>
        <join expr="CI_ADJ_TYPE.ADJ_AMT_TYPE_FLG == AMT_TYPE_L.FIELD_VALUE and AMT_TYPE_L.FIELD_NAME == 'ADJ_AMT_TYPE_FLG' and AMT_TYPE_L.LANGUAGE_CD == 'ENG'" left="CI_ADJ_TYPE" right="AMT_TYPE_L" type="leftOuter" weight="1"></join>
        <join expr="CI_ADJ.CAN_RSN_CD == CI_ADJ_CAN_RSN_L.CAN_RSN_CD and CI_ADJ_CAN_RSN_L.LANGUAGE_CD == 'ENG'" left="CI_ADJ" right="CI_ADJ_CAN_RSN_L" type="leftOuter" weight="1"></join>
        <join expr="CI_ADJ.CURRENCY_CD == CI_CURRENCY_CD_L.CURRENCY_CD and CI_CURRENCY_CD_L.LANGUAGE_CD == 'ENG'" left="CI_ADJ" right="CI_CURRENCY_CD_L" type="leftOuter" weight="1"></join>
        <join expr="CI_ADJ.ADJ_STATUS_FLG == ADJ_STAT_L.FIELD_VALUE and ADJ_STAT_L.FIELD_NAME == 'ADJ_STATUS_FLG' and ADJ_STAT_L.LANGUAGE_CD == 'ENG'" left="CI_ADJ" right="ADJ_STAT_L" type="leftOuter" weight="1"></join>
        <join expr="CI_ADJ.ADJ_ID == ADJ_FT.ADJ_ID" left="CI_ADJ" right="ADJ_FT" type="leftOuter" weight="1"></join>
        <join expr="CI_ADJ.ADJ_ID == ADJ_CHAR.ADJ_ID" left="CI_ADJ" right="ADJ_CHAR" type="leftOuter" weight="1"></join>
        <join expr="CI_ADJ.ADJ_ID == ADJ_AGE.ADJ_ID" left="CI_ADJ" right="ADJ_AGE" type="leftOuter" weight="1"></join>
        <join expr="CI_ADJ.APPR_REQ_ID == CI_APPR_REQ.APPR_REQ_ID" left="CI_ADJ" right="CI_APPR_REQ" type="leftOuter" weight="1"></join>
        <join expr="CI_APPR_REQ.APPR_PROF_CD == CI_APPR_PROF_L.APPR_PROF_CD and CI_APPR_PROF_L.LANGUAGE_CD == 'ENG'" left="CI_APPR_REQ" right="CI_APPR_PROF_L" type="leftOuter" weight="1"></join>
        <join expr="CI_APPR_REQ.BUS_OBJ_CD == APPR_STAT_L.BUS_OBJ_CD and CI_APPR_REQ.BO_STATUS_CD == APPR_STAT_L.BO_STATUS_CD and APPR_STAT_L.LANGUAGE_CD == 'ENG'" left="CI_APPR_REQ" right="APPR_STAT_L" type="leftOuter" weight="1"></join>
        <join expr="CI_ADJ.XFER_ADJ_ID == CI_ADJ_XFER.ADJ_ID" left="CI_ADJ" right="CI_ADJ_XFER" type="leftOuter" weight="1"></join>
        <join expr="CI_ADJ_XFER.ADJ_TYPE_CD == CI_ADJ_TYPE_L_XFER.ADJ_TYPE_CD and CI_ADJ_TYPE_L_XFER.LANGUAGE_CD == 'ENG'" left="CI_ADJ_XFER" right="CI_ADJ_TYPE_L_XFER" type="leftOuter" weight="1"></join>
        <join expr="CI_ADJ_XFER.SA_ID == CI_SA_XFER.SA_ID" left="CI_ADJ_XFER" right="CI_SA_XFER" type="leftOuter" weight="1"></join>
        <join expr="CI_ADJ.ADJ_ID == CI_ADJ_APREQ.ADJ_ID" left="CI_ADJ" right="CI_ADJ_APREQ" type="leftOuter" weight="1"></join>
        <join expr="CI_ADJ_APREQ.PYMNT_SEL_STAT_FLG == REQ_STAT_L.FIELD_VALUE and REQ_STAT_L.FIELD_NAME == 'PYMNT_SEL_STAT_FLG' and REQ_STAT_L.LANGUAGE_CD == 'ENG'" left="CI_ADJ_APREQ" right="REQ_STAT_L" type="leftOuter" weight="1"></join>
        <join expr="CI_ADJ_APREQ.PYMNT_METHOD_FLG == PAY_METHOD_L.FIELD_VALUE and PAY_METHOD_L.FIELD_NAME == 'PYMNT_METHOD_FLG' and PAY_METHOD_L.LANGUAGE_CD == 'ENG'" left="CI_ADJ_APREQ" right="PAY_METHOD_L" type="leftOuter" weight="1"></join>
        <join expr="CI_ADJ.SA_ID == CI_SA.SA_ID" left="CI_ADJ" right="CI_SA" type="leftOuter" weight="1"></join>
        <join expr="CI_SA.SA_STATUS_FLG == SA_STAT_L.FIELD_VALUE and SA_STAT_L.FIELD_NAME == 'SA_STATUS_FLG' and SA_STAT_L.LANGUAGE_CD == 'ENG'" left="CI_SA" right="SA_STAT_L" type="leftOuter" weight="1"></join>
        <join expr="CI_SA.STRT_RSN_FLG == STRT_RSN_L.FIELD_VALUE and STRT_RSN_L.FIELD_NAME == 'STRT_RSN_FLG' and STRT_RSN_L.LANGUAGE_CD == 'ENG'" left="CI_SA" right="STRT_RSN_L" type="leftOuter" weight="1"></join>
        <join expr="CI_SA.STOP_RSN_FLG == STOP_RSN_L.FIELD_VALUE and STOP_RSN_L.FIELD_NAME == 'STOP_RSN_FLG' and STOP_RSN_L.LANGUAGE_CD == 'ENG'" left="CI_SA" right="STOP_RSN_L" type="leftOuter" weight="1"></join>
        <join expr="CI_SA.CIS_DIVISION == CI_SA_TYPE.CIS_DIVISION and CI_SA.SA_TYPE_CD == CI_SA_TYPE.SA_TYPE_CD" left="CI_SA" right="CI_SA_TYPE" type="leftOuter" weight="1"></join>
        <join expr="CI_SA.CIS_DIVISION == CI_SA_TYPE_L.CIS_DIVISION and CI_SA.SA_TYPE_CD == CI_SA_TYPE_L.SA_TYPE_CD and CI_SA_TYPE_L.LANGUAGE_CD == 'ENG'" left="CI_SA" right="CI_SA_TYPE_L" type="leftOuter" weight="1"></join>
        <join expr="CI_SA_TYPE.SVC_TYPE_CD == CI_SVC_TYPE_L.SVC_TYPE_CD and CI_SVC_TYPE_L.LANGUAGE_CD == 'ENG'" left="CI_SA_TYPE" right="CI_SVC_TYPE_L" type="leftOuter" weight="1"></join>
        <join expr="CI_SA.ACCT_ID == CI_ACCT.ACCT_ID" left="CI_SA" right="CI_ACCT" type="leftOuter" weight="1"></join>
        <join expr="CI_ACCT.CIS_DIVISION == CI_CIS_DIVISION_L.CIS_DIVISION and CI_CIS_DIVISION_L.LANGUAGE_CD == 'ENG'" left="CI_ACCT" right="CI_CIS_DIVISION_L" type="leftOuter" weight="1"></join>
        <join expr="CI_ACCT.CUST_CL_CD == CI_CUST_CL_L.CUST_CL_CD and CI_CUST_CL_L.LANGUAGE_CD == 'ENG'" left="CI_ACCT" right="CI_CUST_CL_L" type="leftOuter" weight="1"></join>
        <join expr="CI_ACCT.COLL_CL_CD == CI_COLL_CL_L.COLL_CL_CD and CI_COLL_CL_L.LANGUAGE_CD == 'ENG'" left="CI_ACCT" right="CI_COLL_CL_L" type="leftOuter" weight="1"></join>
        <join expr="CI_ACCT.BILL_CYC_CD == CI_BILL_CYC_L.BILL_CYC_CD and CI_BILL_CYC_L.LANGUAGE_CD == 'ENG'" left="CI_ACCT" right="CI_BILL_CYC_L" type="leftOuter" weight="1"></join>
        <join expr="CI_ACCT.ACCT_MGMT_GRP_CD == CI_ACCT_MGMT_GR_L.ACCT_MGMT_GRP_CD and CI_ACCT_MGMT_GR_L.LANGUAGE_CD == 'ENG'" left="CI_ACCT" right="CI_ACCT_MGMT_GR_L" type="leftOuter" weight="1"></join>
        <join expr="CI_ACCT.BUD_PLAN_CD == CI_BUD_PLAN_L.BUD_PLAN_CD and CI_BUD_PLAN_L.LANGUAGE_CD == 'ENG'" left="CI_ACCT" right="CI_BUD_PLAN_L" type="leftOuter" weight="1"></join>
        <join expr="CI_ACCT.ACCT_ID == CI_ACCT_PER.ACCT_ID and CI_ACCT_PER.MAIN_CUST_SW == 'Y'" left="CI_ACCT" right="CI_ACCT_PER" type="leftOuter" weight="1"></join>
        <join expr="CI_ACCT_PER.PER_ID == CI_PER_NAME.PER_ID and CI_PER_NAME.NAME_TYPE_FLG == 'PRIM'" left="CI_ACCT_PER" right="CI_PER_NAME" type="leftOuter" weight="1"></join>
        <join expr="CI_ACCT_PER.PER_ID == CI_PER.PER_ID" left="CI_ACCT_PER" right="CI_PER" type="leftOuter" weight="1"></join>
        <join expr="CI_PER.PER_OR_BUS_FLG == PER_BUS_L.FIELD_VALUE and PER_BUS_L.FIELD_NAME == 'PER_OR_BUS_FLG' and PER_BUS_L.LANGUAGE_CD == 'ENG'" left="CI_PER" right="PER_BUS_L" type="leftOuter" weight="1"></join>
        <join expr="CI_SA.CHAR_PREM_ID == CI_PREM.PREM_ID" left="CI_SA" right="CI_PREM" type="leftOuter" weight="1"></join>
        <join expr="CI_PREM.PREM_TYPE_CD == CI_PREM_TYPE_L.PREM_TYPE_CD and CI_PREM_TYPE_L.LANGUAGE_CD == 'ENG'" left="CI_PREM" right="CI_PREM_TYPE_L" type="leftOuter" weight="1"></join>
        <join expr="CI_ACCT.MAILING_PREM_ID == CI_PREM_MAIL.PREM_ID" left="CI_ACCT" right="CI_PREM_MAIL" type="leftOuter" weight="1"></join>
      </joinList>
