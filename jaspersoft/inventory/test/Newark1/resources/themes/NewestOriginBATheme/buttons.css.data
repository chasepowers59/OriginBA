/* -------------------- */
/*  01. BASIC BUTTON    */
/* -------------------- */
.button {
    background-color: transparent;
    border: 0;
    border-radius: 0;
    color: var(--text-light);
    cursor: pointer;
    padding: 0;
    position: relative;
    overflow: visible; /* removes extra side padding in IE */
    -webkit-tap-highlight-color: transparent; /* "turns off" link highlight for iPad */
}

.button.disabled,
.button[disabled] {
    color: #aaaaaa;
    cursor: default;
}

.button .wrap {
    display: block !important;
    font-family: inherit; /* fixes the problem that some browsers are rendering in lucida grande */
    font-size: 11px;
    position: relative;
    white-space: nowrap;
}

.button .icon,
.button .indicator {
    background-repeat: no-repeat;
    display: inline-block;
}

.button .indicator {
    background-image: url(images/disclosure_indicators_sprite.png);
    height: 24px;
    position: absolute;
    right: 0;
    top: 0;
    width: 11px;
}

.button .icon {
    height: 24px;
    position: absolute;
    top: 0;
    left: 0;
    width: 24px;
}

.button::-moz-focus-inner {
    border: none; /* overrides extra padding in Firefox */
    padding: 0;
}

/* States */
.button.up.over,
.button.up.pressed,
.button.down.over,
.button.down.pressed {
    color: #ffffff;
}

button[disabled] .icon,
button[disabled] .indicator {
    opacity: 0.3;
}


/* --------------------- */
/*  02. ACTION BUTTON    */
/* --------------------- */
/*  02a. Base rules      */
/* --------------------- */
.action {
    border-radius: 2px;
    display: inline-block;
    margin-right: 5px;
    min-height: 28px;
    padding: 0 15px 0 0;
    text-align: center;
    text-decoration: none;
}

.action > .wrap {
    background-position: left 0;
    font-family: source_sans_prosemibold, Franklin Gothic Medium, Verdana, Arial, sans-serif;
    font-size: 14px;
    font-weight: normal;
    line-height: 28px;
    padding-left: 15px;
}

.footer .action {
    margin-top: 4px;
}

/* Keyboard Focus */
.action:focus-visible{
    outline: 2px solid var(--border-grey-60);
    outline-offset: 1px;
}

.action.primary:focus-visible {
    outline: 2px solid var(--jrs-theme-dark);
    outline-offset: 1px;
}

/* States */
.action,
.action.over,
.action.pressed,
.action.pressed.over,
.action.square.pressed,
.action.square.pressed.over {
    background-color: var(--background-grey-10);
}

.action.over,
.action.square.over {
    background-color: var(--background-grey-54);
}

.action.primary,
.action.primary.pressed,
.action.primary.pressed.over {
    background-color: var(--jrs-theme-light);
    background-image: none;
}

.button.action.primary.disabled,
.button.action.primary[disabled] {
    opacity: .4;
}

.action.primary.over {
    background-color: var(--jrs-theme-medium);
}

.button.action.pressed {
    color: var(--text-light);
}

.button.up.primary,
.button.up.primary.over,
.button.up.primary.pressed {
    color: #ffffff;
}

.action.checking {
    cursor: default;
}

/*  --------------------- */
/*   02b. Square action   */
/*  --------------------- */
.action.square {
    text-align: center;
    width: 34px;
}

.action.square > .wrap {
    background-position: left top;
    height: 32px;
    margin-top: 0;
    margin-bottom: 0;
    padding: 0;
    text-indent: -5000px;
    width: 20px;
}

.action.square > .wrap > .icon {
    background-image: url(images/button_action_icons_sprite@1x.png);
    background-repeat: no-repeat;
    background-size: 240px;
    display: block;
    height: 32px;
    width: 34px;
}

/* 2x icons */
@media (-webkit-min-device-pixel-ratio: 2),(min-resolution: 192dpi) {
    .action.square > .wrap > .icon {
        background-image: url(images/button_action_icons_sprite@2x.png);
    }
}

/*  -------------------- */
/*   02c. Small action   */
/*  -------------------- */
/*  introduced October 2014, occurs in redesigned Select Data dialog box  */
.action.square.small {
    margin: 0;
    min-height: 24px;
    padding: 0;
    width: auto;
}

.action.square.small > .wrap {
    height: 24px;
    width: 24px;
}

.action.square.small.tree > .wrap,
.action.square.small.list > .wrap {
    width: 30px;
}

.action.square.small > .wrap > .icon {
    display: block;
    height: 24px;
    width: 30px;
}

/* States */
/* background color */
.action.small.down.over {
    background-color: var(--jrs-theme-medium);
}

.action.small.pressed.over,
.action.small.down,
.action.small.down.pressed {
    background-color: var(--jrs-theme-light);
}

.action.small.down.focus-visible {
    outline: 2px solid #11429e;
    outline-offset: 1px;
}

/* icon position  */
.action.small.tree.up .icon {
    background-position: -56px -175px;
}

.action.small.tree.up.over .icon,
.action.small.tree.up.pressed .icon,
.action.small.tree.down .icon,
.action.small.tree.down.over .icon {
    background-position: -86px -175px;
}

.action.small.list.up .icon {
    background-position: -115px -445px;
}

.action.small.list.up.over .icon,
.action.small.list.up.pressed .icon,
.action.small.list.down .icon,
.action.small.list.down.over .icon {
    background-position: -146px -445px;
}

/* ---------------------- */
/*   02d. Simple action   */
/* ---------------------- */
.action.simple {
    background: url("images/button_action_icons_sprite@1x.png") no-repeat scroll 0 0 transparent;
    background-size: 240px;
    border-radius: 1px;
    display: inline-block;
    height: 18px;
    margin: 0;
    min-height: 18px;
    padding: 0;
    width: 18px;
}

/* 2x icons */
@media (-webkit-min-device-pixel-ratio: 2),(min-resolution: 192dpi) {
    .action.simple {
        background-image: url(images/button_action_icons_sprite@2x.png);
    }
}

.action.simple.button.save {
    background-position: -120px -210px;
}

.action.simple.button.edit {
    background-position: 0 -331px;
}

.action.simple.button.delete {
    background-position: -1px -541px;
}

.action.simple.button.cancel {
    background-position: -120px -180px;
}

.action.simple.button.add {
    background-position: -60px -300px;
    height: 100%;
}

/* Keyboard Focus */
.action.simple.focus-visible {
    outline: 2px solid var(--jrs-theme-dark);
    outline-offset: 2px;
}


/* -------------------- */
/*  03. MATH BUTTON     */
/* -------------------- */
.button.math {
    background: var(--background-grey-02);
    border: 1px solid var(--border-grey-10);
    border-radius: 1px;
    cursor: pointer;
    display: inline-block;
    height: 24px;
    margin-right: 3px;
    margin-bottom: 6px;
    -moz-user-select: none;
    padding-left: 4px;
    padding-right: 4px;
    position: relative;
}

.button.math > .icon {
    height: 24px;
    line-height: 24px;
    position: relative;
    width: auto;
}

/* icon fonts for formula buttons */
@font-face {
    font-family: 'operators';
    src: url('fonts/operators.eot');
    src: url('fonts/operators.eot?#iefix') format('embedded-opentype'),
    url('fonts/operators.woff') format('woff'),
    url('fonts/operators.ttf') format('truetype'),
    url('fonts/operators.svg#operators') format('svg');
    font-weight: normal;
    font-style: normal;
}

[class^="icon-"], [class*=" icon-"] {
    font-family: 'operators';
    speak: none;
    font-style: normal;
    font-weight: normal;
    font-variant: normal;
    text-transform: none;
    line-height: 1;

    /* Better Font Rendering =========== */
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
}

.button.math [class^="icon-"], [class*=" icon-"] {
    font-size: 13px;
    line-height: 18px;
}

.icon-add:before {
    content: "\61";
}

.icon-subtract:before {
    content: "\62";
}

.icon-multiply:before {
    content: "\63";
}

.icon-divide:before {
    content: "\64";
}

.icon-percent:before {
    content: "\65";
}

.icon-parenLeft:before {
    content: "\66";
}

.icon-parenRight:before {
    content: "\67";
}

.icon-colon:before {
    content: "\68";
}

.icon-equal:before {
    content: "\69";
}

.icon-notEqual:before {
    content: "\6a";
}

.icon-greaterThan:before {
    content: "\6b";
}

.icon-lessThan:before {
    content: "\6c";
}

.icon-greaterEqual:before {
    content: "\6d";
}

.icon-lessEqual:before {
    content: "\6e";
}

.icon-and:before {
    content: "\6f";
}

.icon-or:before {
    content: "\70";
}

.icon-not:before {
    content: "\71";
}

.icon-in:before {
    content: "\72";
}

.icon-startsWith:before {
    content: "\73";
}

.icon-endsWith:before {
    content: "\74";
}

.icon-contains:before {
    content: "\75";
}


/* ----------------------- */
/*  04. CAPSULE BUTTON     */
/* ----------------------- */
/*  04a. Base Rules        */
/* ----------------------- */
button.capsule {
    display: inline-block;
    height: 24px;
    margin-right: -1px;
    text-decoration: none;
    width: 32px;
}

.button.capsule.mutton {
    width: 36px;
}

.button.capsule .wrap {
    height: 22px;
    line-height: 14px;
}

.button.capsule .wrap > .icon {
    height: 22px;
    width: 30px;
}

.button.capsule.mutton .wrap {
    padding: 0 6px;
}

/* disclosure indicator icon positions for capsule buttons */
.button.capsule .indicator {
    background-image: url(images/disclosure_indicators_icons_sprite.svg);
    background-size: 170px;
    background-position: -1px -80px;
    right: 2px;
}

.button.capsule.over .indicator,
.button.capsule.pressed .indicator {
    background-position: -61px -80px;
    right: 2px;
}

/* --------------------- */
/*  04b. Text capsule    */
/* --------------------- */
.button.capsule.text {
    border-left: 1px solid var(--border-grey-20);
    border-right: 1px solid #ffffff;
    font-family: source_sans_prosemibold, Franklin Gothic Medium, Verdana, Arial, sans-serif;
    font-weight: normal;
    margin: 0;
    width: auto;
}

.button.capsule.text .wrap {
    font-size: 13px;
}

.button.capsule.text.first {
    border-left: none;
}

.button.capsule.text .wrap {
    height: 100%;
    line-height: 28px;
    padding: 0 12px;
}

.button.capsule.text.mutton .wrap {
    padding-right: 16px;
}

/* States */
.button.capsule.disabled {}
.button.capsule.up {}

.button.capsule.down,
.button.capsule.down.over,
.button.capsule.down.pressed,
.button.capsule.superfocus.subfocus:hover {
    color: #ffffff;
}

.button.capsule.up.over,
.button.capsule.superfocus.subfocus:not([disabled]):hover,
.button.capsule.down,
.button.capsule.down.over,
.button.capsule.down.pressed {
    background-color: var(--jrs-theme-medium);
}

.button.capsule.up.pressed,
.button.capsule.superfocus.subfocus.pressed {
    background-color: var(--jrs-theme-light);
}

.button.capsule.down {}
.button.capsule.down.pressed {}


/* ------------------------- */
/*  05. DISCLOSURE BUTTON    */
/* ------------------------- */
.button.disclosure {
    background-color: transparent;
    background-image: url(images/disclosure_indicators_sprite.png);
    background-repeat: no-repeat;
    display: inline-block;
    height: 22px;
    vertical-align: middle;
    width: 16px;
    z-index: 10;
}

.closed .button.disclosure,
.minimized .button.disclosure {
    background-position: 0 -205px;
}

/* States */
.closed .button.disclosure.over,
.minimized .button.disclosure.over {
    background-position: 0 -229px;
}

.closed .button.disclosure.pressed,
.minimized .button.disclosure.pressed {
    background-position: 0 -257px;
}

.button.disclosure,
.button.disclosure.down {
    background-position: 0 -286px;
}

.button.disclosure.over,
.button.disclosure.down.over {
    background-position: 0 -310px;
}

.button.disclosure.pressed,
.button.disclosure.down.pressed {
    background-position: 0 -336px;
}

.button.disclosure.focus-visible {
    border-radius: 1px;
    outline: 2px solid var(--jrs-theme-dark);
    outline-offset: -3px;
}

/* ----------------------- */
/*  06. MINIMIZE BUTTON    */
/* ----------------------- */
.button.minimize {
    background-color: var(--background-grey-40);
    background-image: url(images/disclosure_indicators_icons_sprite.svg);
    background-repeat: no-repeat;
    background-position: -61px -172px;
    background-size: 170px;
    display: inline-block;
    height: 32px;
    margin-top: 0;
    width: 14px;
    z-index: 10;
}

/* States */
.minimized > .button.minimize,
.minimized > .button.minimize.over,
.minimized > .button.minimize.pressed {
    background-position: -57px -202px;
    width: 24px;
}


/* ---------------------- */
/*  07. OPTIONS BUTTON    */
/* ---------------------- */
.button.options {
    background-color: var(--background-grey-10);
    margin-right: 5px;
    padding: 0 15px 0 0;
    text-align: center;
}

.button.options > .wrap {
    height: 21px;
    line-height: 22px;
    padding: 0 0 0 15px;
}

.filter .button.options {
    border-width: 0;
    margin-left: 20px;
    margin-right: 10px;
}

.filter .button.options > .wrap {
    border-width: 0;
}

/* States */
.button.options.over {
    background-color: var(--background-grey-29);
}

.button.options.pressed {
    background: var(--background-grey-10);
}


/* --------------------- */
/*  08. PICKER BUTTON    */
/* --------------------- */
.button.picker {
    background-image: url("images/button_action_icons_sprite@1x.png");
    background-color: transparent;
    background-position: -119px -87px;
    background-repeat: no-repeat;
    background-size: 240px;
    display: inline;
    height: 26px;
    margin-left: 2px;
    vertical-align: top;
    width: 22px;
    z-index: 10;
}

/* 2x icons */
@media (-webkit-min-device-pixel-ratio: 2),(min-resolution: 192dpi) {
    .button.picker {
        background-image: url(images/button_action_icons_sprite@2x.png);
    }
}

.button.picker.superfocus,
.button.picker.focus-visible,
button.jr-mInput-datetrigger.focus-visible {
    border-color: transparent !important;
    outline: 2px solid var(--jrs-theme-dark) !important;
    outline-offset: -2px;
}


/* ------------------------ */
/*  09. SCHEDULED BUTTON    */
/* ------------------------ */
.button.scheduled {
    background-image: url(images/disclosure_indicators_icons_sprite.svg);
    background-position: -30px -416px;
    background-repeat: no-repeat;
    background-size: 170px;
    display: inline-block;
    height: 22px;
    position: relative;
    width: 20px;
    z-index: 10;
}

/* States */
.button.scheduled.over {}
.button.scheduled.pressed {}


/* ------------------------ */
/*  10. FAVORITES BUTTON    */
/* ------------------------ */
.button.favorite {
    background-image: url(images/disclosure_indicators_icons_sprite.svg);
    background-repeat: no-repeat;
    display: inline-block;
    position: relative;
    z-index: 10;
}

/* States */
.button.favorite.over {}
.button.favorite.pressed {}



/* -------------------- */
/*  11. SEARCH BUTTON   */
/* -------------------- */
.button.search {
    background-image: url(images/search_icons_sprite@1x.png);
    background-repeat: no-repeat;
    background-size: 80px;
    border-left: none;
    height: 24px;
    width: 24px;
}

/* 2x icons */
@media (-webkit-min-device-pixel-ratio: 2),(min-resolution: 192dpi) {
    .button.search {
        background-image: url(images/search_icons_sprite@2x.png);
    }
}

/* States */
.button.search.up,
.button.search.over,
.button.search.pressed,
.button.search.disabled {
    background-position: -26px -56px;
}


/* ------------------- */
/*  12. MOVE BUTTON    */
/* ------------------- */
/* Background image is 'button_action_icons_sprite' - set in section 2a */
.move.right .icon,
.move.right.over.pressed .icon {
    background-position: 8px -24px;
}

.move.right.over .icon {
    background-position: -23px -24px;
}

.move.left .icon,
.move.left.over.pressed .icon {
    background-position: 6px 6px;
}

.move.left.over .icon {
    background-position: -24px 6px;
}

.move.toRight .icon,
.move.toRight.pressed .icon {
    background-position: 8px -144px;
}

.move.toRight.over .icon {
    background-position: -22px -144px;
}

.move.toLeft .icon,
.move.toLeft.pressed .icon {
    background-position: 6px -114px;
}

.move.toLeft.over .icon {
    background-position: -24px -114px;
}

.move.upward .icon {
    background-position: 7px -55px;
}

.move.upward.over .icon,
.move.upward.pressed .icon {
    background-position: -23px -55px;
}

.move.downward .icon {
    background-position: 7px -82px;
}

.move.downward.over .icon,
.move.downward.pressed .icon {
    background-position: -23px -82px;
}

.move.toTop .icon {
    background-position: 7px -234px;
}

.move.toTop.over .icon,
.move.toTop.pressed .icon {
    background-position: -23px -234px;
}

.move.toBottom .icon {
    background-position: 7px -262px;
}

.move.toBottom.over .icon,
.move.toBottom.pressed .icon {
    background-position: -23px -262px;
}