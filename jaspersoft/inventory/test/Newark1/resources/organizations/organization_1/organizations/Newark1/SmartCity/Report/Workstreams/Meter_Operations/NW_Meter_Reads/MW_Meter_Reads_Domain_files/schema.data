        <item id="C2M_ACCT_ID" label="Account ID" resourceId="JoinTree_2.Meter_Reads.C2M_ACCT_ID"></item>
        <item id="D1_INSTALL_DTTM" label="Installation Date/Time" resourceId="JoinTree_2.Meter_Reads.D1_INSTALL_DTTM"></item>
        <item id="METER_SIZE" label="Meter Size" resourceId="JoinTree_2.Meter_Reads.METER_SIZE"></item>
        <item id="MEASURING_UNIT" label="Measuring Unit" resourceId="JoinTree_2.Meter_Reads.MEASURING_UNIT"></item>
        <item id="CURRENT_READ_DATE" label="Current Read Date" resourceId="JoinTree_2.Meter_Reads.CURRENT_READ_DATE"></item>
        <item id="CURRENT_READING" label="Current Reading" resourceId="JoinTree_2.Meter_Reads.CURRENT_READING"></item>
        <item id="MEASR_COMP_ID" label="Measuring Component" resourceId="JoinTree_2.Meter_Reads.MEASR_COMP_ID"></item>
        <item id="MSRMT_COND_FLG" label="Current Measurement Condition" resourceId="JoinTree_2.Meter_Reads.MSRMT_COND_FLG"></item>
        <item id="PREVIOUS_MSRMT_COND_FLG" label="Previous Measurement Condition" resourceId="JoinTree_2.Meter_Reads.PREVIOUS_MSRMT_COND_FLG"></item>
        <item id="PREVIOUS_READ_DATE" label="Previous Read Date" resourceId="JoinTree_2.Meter_Reads.PREVIOUS_READ_DATE"></item>
