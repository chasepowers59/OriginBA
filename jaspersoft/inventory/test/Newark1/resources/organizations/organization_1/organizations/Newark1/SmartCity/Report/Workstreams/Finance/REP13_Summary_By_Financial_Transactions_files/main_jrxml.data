	<subDataset name="PaymentsPerSAType" uuid="c262520e-ec59-453c-a8a2-a45a16d7150d">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="Newark - JRS TST DB"/>
		<parameter name="Start_Date" class="java.sql.Date"/>
		<parameter name="End_Date" class="java.sql.Date"/>
		<queryString language="SQL">
			<![CDATA[SELECT * FROM
(WITH 
PAY_PER_SATY_OLDER_THAN_STARTDT AS (
    SELECT 	/*+ FULL(FT) */
    				SA.SA_TYPE_CD, 
    				NVL(SUM(FT.CUR_AMT), 0) BEGINNING_BALANCE, 
    				NVL(COUNT(FT.FT_ID), 0) AS BEGINNING_COUNT
    FROM CISADM.CI_FT FT,
        CISADM.CI_SA SA
    WHERE FT.SA_ID = SA.SA_ID
    AND FT.FREEZE_SW = 'Y'
    AND FT.FT_TYPE_FLG IN ('PS')
    AND $X{LESS, FT.FREEZE_DTTM, Start_Date}
    AND NOT EXISTS (
                SELECT 'X' FROM CISADM.CI_FT FT1
                WHERE FT1.PARENT_ID = FT.PARENT_ID
                AND FT1.SIBLING_ID = FT.SIBLING_ID
                AND FT1.FREEZE_SW = 'Y'
                AND FT1.FT_TYPE_FLG = 'PX')
    GROUP BY SA.SA_TYPE_CD
),
PAY_PER_SATY_WITHIN_START_END AS (
    SELECT 	/*+ INDEX(CI_FT CM_INDEX1) */
				    SA.SA_TYPE_CD, 
				    NVL(SUM(FT.CUR_AMT), 0) CURRENT_BALANCE, 
				    NVL(COUNT(FT.FT_ID), 0) AS CURRENT_COUNT
    FROM CISADM.CI_FT FT,
        CISADM.CI_SA SA
    WHERE FT.SA_ID = SA.SA_ID
    AND FT.FREEZE_SW = 'Y'
    AND FT.FT_TYPE_FLG IN ('PS')
    AND ($X{[BETWEEN], FT.FREEZE_DTTM, Start_Date, End_Date})
    AND NOT EXISTS (
                SELECT 'X' FROM CISADM.CI_FT FT1
                WHERE FT1.PARENT_ID = FT.PARENT_ID
                AND FT1.SIBLING_ID = FT.SIBLING_ID
                AND FT1.FREEZE_SW = 'Y'
                AND FT1.FT_TYPE_FLG = 'PX')
    GROUP BY SA.SA_TYPE_CD
)
SELECT
    SAT.SA_TYPE_CD SA_TYPE,
    NVL(OLDER_STRT.BEGINNING_BALANCE, 0) BEGINNING_BALANCE,
    NVL(OLDER_STRT.BEGINNING_COUNT, 0) BEGINNING_COUNT,
    NVL(WITHIN_STRT_END.CURRENT_BALANCE, 0) CURRENT_BALANCE,
    NVL(BFV.VAL, 0) PAYMENT_VARIANCE,
    NVL(WITHIN_STRT_END.CURRENT_COUNT, 0) CURRENT_COUNT
FROM CISADM.CI_SA_TYPE SAT
LEFT JOIN PAY_PER_SATY_OLDER_THAN_STARTDT OLDER_STRT
    ON OLDER_STRT.SA_TYPE_CD = SAT.SA_TYPE_CD
LEFT JOIN PAY_PER_SATY_WITHIN_START_END WITHIN_STRT_END
    ON WITHIN_STRT_END.SA_TYPE_CD = SAT.SA_TYPE_CD
LEFT JOIN (SELECT SUM(BFV.VAL) VAL, SAT.SA_TYPE_CD 
            FROM 
                CISADM.CI_BF_VAL BFV,
                CISADM.CI_SA_TYPE SAT
            WHERE BFV.BF_CD = 'VAR-PAY'
            AND BFV.CHAR_TYPE_CD = 'VAR-PAY'
            AND TRIM(BFV.CHAR_VAL) = TRIM(SAT.SA_TYPE_CD)
			AND ($X{[BETWEEN], BFV.EFFDT, Start_Date, End_Date})
			GROUP BY SAT.SA_TYPE_CD) BFV
ON BFV.SA_TYPE_CD = SAT.SA_TYPE_CD
ORDER BY SAT.SA_TYPE_CD)]]>
		</queryString>
		<field name="SA_TYPE" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="SA_TYPE"/>
			<property name="com.jaspersoft.studio.field.label" value="SA_TYPE"/>
		</field>
		<field name="BEGINNING_BALANCE" class="java.math.BigDecimal">
			<property name="com.jaspersoft.studio.field.name" value="BEGINNING_BALANCE"/>
			<property name="com.jaspersoft.studio.field.label" value="BEGINNING_BALANCE"/>
		</field>
		<field name="BEGINNING_COUNT" class="java.math.BigDecimal">
			<property name="com.jaspersoft.studio.field.name" value="BEGINNING_COUNT"/>
			<property name="com.jaspersoft.studio.field.label" value="BEGINNING_COUNT"/>
		</field>
		<field name="CURRENT_BALANCE" class="java.math.BigDecimal">
			<property name="com.jaspersoft.studio.field.name" value="CURRENT_BALANCE"/>
			<property name="com.jaspersoft.studio.field.label" value="CURRENT_BALANCE"/>
		</field>
		<field name="PAYMENT_VARIANCE" class="java.math.BigDecimal">
			<property name="com.jaspersoft.studio.field.name" value="PAYMENT_VARIANCE"/>
			<property name="com.jaspersoft.studio.field.label" value="PAYMENT_VARIANCE"/>
		</field>
		<field name="CURRENT_COUNT" class="java.math.BigDecimal">
			<property name="com.jaspersoft.studio.field.name" value="CURRENT_COUNT"/>
			<property name="com.jaspersoft.studio.field.label" value="CURRENT_COUNT"/>
		</field>
	</subDataset>
	<subDataset name="CancelledPaymentsPerCancelReason" uuid="a96f7e4d-6fc3-4722-8ce2-a5fb031aae77">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="Newark PROD"/>
		<parameter name="Start_Date" class="java.sql.Date"/>
		<parameter name="End_Date" class="java.sql.Date"/>
		<queryString language="SQL">
			<![CDATA[SELECT
    PAY.CAN_RSN_CD AS CANCEL_REASON,
    NVL (SUM(FT1.TOT_AMT), 0) AS BEGINNING_BALANCE,
    NVL (COUNT(FT1.FT_ID), 0) AS BEGINNING_COUNT,
    NVL (SUM(FT2.TOT_AMT), 0) AS CURRENT_BALANCE,
    NVL (COUNT(FT2.FT_ID), 0) AS CURRENT_COUNT
FROM CISADM.CI_PAY PAY
LEFT JOIN CISADM.CI_FT FT1
    ON PAY.PAY_ID = FT1.PARENT_ID
    AND FT1.FT_TYPE_FLG IN ('PX')
    AND $X{LESS, FT1.FREEZE_DTTM, Start_Date}
LEFT JOIN CISADM.CI_FT FT2
    ON PAY.PAY_ID = FT2.PARENT_ID
    AND FT2.FT_TYPE_FLG IN ('PX')
    AND $X{[BETWEEN], FT2.FREEZE_DTTM, Start_Date, End_Date}
WHERE 1 = 1
    AND PAY.PAY_STATUS_FLG = '60'
GROUP BY PAY.CAN_RSN_CD
ORDER BY PAY.CAN_RSN_CD]]>
		</queryString>
		<field name="CANCEL_REASON" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="CANCEL_REASON"/>
			<property name="com.jaspersoft.studio.field.label" value="CANCEL_REASON"/>
		</field>
		<field name="BEGINNING_BALANCE" class="java.math.BigDecimal">
			<property name="com.jaspersoft.studio.field.name" value="BEGINNING_BALANCE"/>
			<property name="com.jaspersoft.studio.field.label" value="BEGINNING_BALANCE"/>
		</field>
		<field name="BEGINNING_COUNT" class="java.math.BigDecimal">
			<property name="com.jaspersoft.studio.field.name" value="BEGINNING_COUNT"/>
			<property name="com.jaspersoft.studio.field.label" value="BEGINNING_COUNT"/>
		</field>
		<field name="CURRENT_BALANCE" class="java.math.BigDecimal">
			<property name="com.jaspersoft.studio.field.name" value="CURRENT_BALANCE"/>
			<property name="com.jaspersoft.studio.field.label" value="CURRENT_BALANCE"/>
		</field>
		<field name="CURRENT_COUNT" class="java.math.BigDecimal">
			<property name="com.jaspersoft.studio.field.name" value="CURRENT_COUNT"/>
			<property name="com.jaspersoft.studio.field.label" value="CURRENT_COUNT"/>
		</field>
	</subDataset>
	<subDataset name="BillSegmentsPerSAType" uuid="1664a67d-8476-41b1-8677-df91731cab19">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="Newark - JRS TST DB"/>
		<parameter name="Start_Date" class="java.sql.Date"/>
		<parameter name="End_Date" class="java.sql.Date"/>
		<queryString language="SQL">
			<![CDATA[SELECT *
FROM   
(WITH BS_PER_SATY_OLDER_THAN_STARTDT AS
       (
                   SELECT   /*+ FULL(FT) */
                            SA.SA_TYPE_CD,
                            NVL(SUM(FT.CUR_AMT), 0)    BEGINNING_BALANCE,
                            NVL(COUNT(FT.FT_ID), 0) AS BEGINNING_COUNT
                   FROM     CISADM.CI_FT FT,
                            CISADM.CI_SA SA
                   WHERE    FT.SA_ID = SA.SA_ID
                   AND      FT.FREEZE_SW = 'Y'
                   AND      FT.FT_TYPE_FLG IN ('BS','BX')
                   AND $X{LESS, FT.FREEZE_DTTM, Start_Date}
                   GROUP BY SA.SA_TYPE_CD ),
             BS_PER_SATY_WITHIN_START_END AS
       (
                   SELECT   /*+ INDEX(CI_FT CM_INDEX1) */
                            SA.SA_TYPE_CD,
                            NVL(SUM(FT.CUR_AMT), 0)     CURRENT_BALANCE,
                            NVL(COUNT(FT.FT_ID), 0 ) AS CURRENT_COUNT
                   FROM     CISADM.CI_FT FT,
                            CISADM.CI_SA SA
                   WHERE    FT.SA_ID = SA.SA_ID
                   AND      FT.FREEZE_SW = 'Y'
                   AND      FT.FT_TYPE_FLG IN ('BS',
                                               'BX')
                   AND      ($X{[BETWEEN], FT.FREEZE_DTTM, Start_Date, End_Date})
                   GROUP BY SA.SA_TYPE_CD
        )
SELECT    SAT.SA_TYPE_CD                          SA_TYPE,
          NVL(OLDER_STRT.BEGINNING_BALANCE, 0)    BEGINNING_BALANCE,
          NVL(OLDER_STRT.BEGINNING_COUNT, 0)      BEGINNING_COUNT,
          NVL(WITHIN_STRT_END.CURRENT_BALANCE, 0) CURRENT_BALANCE,
          NVL(BFV.VAL, 0)                         BILL_VARIANCE,
          NVL(WITHIN_STRT_END.CURRENT_COUNT, 0)   CURRENT_COUNT
FROM      CISADM.CI_SA_TYPE SAT
LEFT JOIN BS_PER_SATY_OLDER_THAN_STARTDT OLDER_STRT
ON        OLDER_STRT.SA_TYPE_CD = SAT.SA_TYPE_CD
LEFT JOIN BS_PER_SATY_WITHIN_START_END WITHIN_STRT_END
ON        WITHIN_STRT_END.SA_TYPE_CD = SAT.SA_TYPE_CD
LEFT JOIN
          (
                 SELECT SUM(BFV.VAL) VAL,
                        SAT.SA_TYPE_CD
                 FROM   CISADM.CI_BF_VAL BFV,
                        CISADM.CI_SA_TYPE SAT
                 WHERE  BFV.BF_CD = 'VAR-BILL'
                 AND    BFV.CHAR_TYPE_CD = 'VAR-BILL'
                 AND    TRIM(BFV.CHAR_VAL) = TRIM(SAT.SA_TYPE_CD)
                 AND ($X{[BETWEEN], BFV.EFFDT, Start_Date, End_Date})
                 GROUP BY SAT.SA_TYPE_CD
           ) BFV
ON        BFV.SA_TYPE_CD = SAT.SA_TYPE_CD
ORDER BY  SAT.SA_TYPE_CD)]]>
		</queryString>
		<field name="SA_TYPE" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="SA_TYPE"/>
			<property name="com.jaspersoft.studio.field.label" value="SA_TYPE"/>
		</field>
		<field name="BEGINNING_BALANCE" class="java.math.BigDecimal">
			<property name="com.jaspersoft.studio.field.name" value="BEGINNING_BALANCE"/>
			<property name="com.jaspersoft.studio.field.label" value="BEGINNING_BALANCE"/>
		</field>
		<field name="BEGINNING_COUNT" class="java.math.BigDecimal">
			<property name="com.jaspersoft.studio.field.name" value="BEGINNING_COUNT"/>
			<property name="com.jaspersoft.studio.field.label" value="BEGINNING_COUNT"/>
		</field>
		<field name="CURRENT_BALANCE" class="java.math.BigDecimal">
			<property name="com.jaspersoft.studio.field.name" value="CURRENT_BALANCE"/>
			<property name="com.jaspersoft.studio.field.label" value="CURRENT_BALANCE"/>
		</field>
		<field name="BILL_VARIANCE" class="java.math.BigDecimal">
			<property name="com.jaspersoft.studio.field.name" value="BILL_VARIANCE"/>
			<property name="com.jaspersoft.studio.field.label" value="BILL_VARIANCE"/>
		</field>
		<field name="CURRENT_COUNT" class="java.math.BigDecimal">
			<property name="com.jaspersoft.studio.field.name" value="CURRENT_COUNT"/>
			<property name="com.jaspersoft.studio.field.label" value="CURRENT_COUNT"/>
		</field>
	</subDataset>
	<subDataset name="AdjustmentsPerAdjustmentType" uuid="21079e12-e725-40f1-86ed-1aa01904676f">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="Newark - JRS TST DB"/>
		<parameter name="Start_Date" class="java.sql.Date"/>
		<parameter name="End_Date" class="java.sql.Date"/>
		<queryString language="SQL">
			<![CDATA[SELECT A.ADJ_TYPE, A.BEGINNING_BALANCE, A.BEGINNING_COUNT, B.CURRENT_BALANCE, B.CURRENT_COUNT
FROM
(SELECT /*+ FULL(FT)*/
    ADJ.ADJ_TYPE_CD AS ADJ_TYPE,
    NVL (SUM(FT1.TOT_AMT), 0) AS BEGINNING_BALANCE,
    NVL (COUNT(FT1.FT_ID), 0) AS BEGINNING_COUNT
FROM CISADM.CI_ADJ ADJ
LEFT JOIN CISADM.CI_FT FT1
    ON FT1.SIBLING_ID = ADJ.ADJ_ID
    AND FT1.FT_TYPE_FLG IN ('AD', 'AX')
    AND $X{LESS, FT1.FREEZE_DTTM, Start_Date}
GROUP BY ADJ.ADJ_TYPE_CD) A,
(SELECT /*+ INDEX(CI_FT CM_INDEX1) */
    ADJ.ADJ_TYPE_CD AS ADJ_TYPE,
    NVL (SUM(FT2.TOT_AMT), 0) AS CURRENT_BALANCE,
    NVL (COUNT(FT2.FT_ID), 0) AS CURRENT_COUNT
FROM CISADM.CI_ADJ ADJ
LEFT JOIN CISADM.CI_FT FT2
    ON FT2.SIBLING_ID = ADJ.ADJ_ID
    AND FT2.FT_TYPE_FLG IN ('AD', 'AX')
    AND $X{[BETWEEN], FT2.FREEZE_DTTM, Start_Date, End_Date}
GROUP BY ADJ.ADJ_TYPE_CD) B
where A.ADJ_TYPE=B.ADJ_TYPE
ORDER BY 1]]>
		</queryString>
		<field name="ADJ_TYPE" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="ADJ_TYPE"/>
			<property name="com.jaspersoft.studio.field.label" value="ADJ_TYPE"/>
		</field>
		<field name="BEGINNING_BALANCE" class="java.math.BigDecimal">
			<property name="com.jaspersoft.studio.field.name" value="BEGINNING_BALANCE"/>
			<property name="com.jaspersoft.studio.field.label" value="BEGINNING_BALANCE"/>
		</field>
		<field name="BEGINNING_COUNT" class="java.math.BigDecimal">
			<property name="com.jaspersoft.studio.field.name" value="BEGINNING_COUNT"/>
			<property name="com.jaspersoft.studio.field.label" value="BEGINNING_COUNT"/>
		</field>
		<field name="CURRENT_BALANCE" class="java.math.BigDecimal">
			<property name="com.jaspersoft.studio.field.name" value="CURRENT_BALANCE"/>
			<property name="com.jaspersoft.studio.field.label" value="CURRENT_BALANCE"/>
		</field>
		<field name="CURRENT_COUNT" class="java.math.BigDecimal">
			<property name="com.jaspersoft.studio.field.name" value="CURRENT_COUNT"/>
			<property name="com.jaspersoft.studio.field.label" value="CURRENT_COUNT"/>
		</field>
	</subDataset>
	<subDataset name="LPCAdjustmentPerSAType" uuid="f861b92a-b486-4ace-9b50-7ba7de56d007">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="Newark - JRS TST DB"/>
		<parameter name="Start_Date" class="java.sql.Date"/>
		<parameter name="End_Date" class="java.sql.Date"/>
		<queryString language="SQL">
			<![CDATA[SELECT /*+ INDEX(CI_FT CM_INDEX1) */
    SA.SA_TYPE_CD AS SA_TYPE,
    NVL (SUM(FT.TOT_AMT), 0) AS CURRENT_BALANCE,
    NVL (COUNT(FT.FT_ID), 0) AS CURRENT_COUNT
FROM CISADM.CI_ADJ ADJ
INNER JOIN CISADM.CI_SA SA ON SA.SA_ID = ADJ.SA_ID
INNER JOIN CISADM.CI_FT FT ON FT.SIBLING_ID = ADJ.ADJ_ID
    AND FT.FT_TYPE_FLG IN ('AD', 'AX')
    AND FT.FREEZE_SW = 'Y'
    AND FT.SA_ID = SA.SA_ID
    AND ($X{[BETWEEN], FT.FREEZE_DTTM, Start_Date, End_Date})
WHERE ADJ.ADJ_TYPE_CD = 'LPC'
GROUP BY SA.SA_TYPE_CD
ORDER BY SA.SA_TYPE_CD]]>
		</queryString>
		<field name="SA_TYPE" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="SA_TYPE"/>
			<property name="com.jaspersoft.studio.field.label" value="SA_TYPE"/>
		</field>
		<field name="CURRENT_BALANCE" class="java.math.BigDecimal">
			<property name="com.jaspersoft.studio.field.name" value="CURRENT_BALANCE"/>
			<property name="com.jaspersoft.studio.field.label" value="CURRENT_BALANCE"/>
		</field>
		<field name="CURRENT_COUNT" class="java.math.BigDecimal">
			<property name="com.jaspersoft.studio.field.name" value="CURRENT_COUNT"/>
			<property name="com.jaspersoft.studio.field.label" value="CURRENT_COUNT"/>
		</field>
		<group name="SA_TYPE">
			<groupExpression><![CDATA[$F{SA_TYPE}]]></groupExpression>
		</group>
	</subDataset>
	<subDataset name="BankruptcyPerSAType" uuid="999dae95-3109-4121-9374-69790323c08f">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="Newark - JRS TST DB"/>
		<parameter name="Start_Date" class="java.sql.Date"/>
		<parameter name="End_Date" class="java.sql.Date"/>
		<queryString language="SQL">
			<![CDATA[SELECT SA_TYPE_CD, SUM(BEGINNING_BALANCE) AS BEGINNING_BALANCE, SUM(BEGINNING_COUNT) AS BEGINNING_COUNT, SUM(CURRENT_BALANCE) AS CURRENT_BALANCE, SUM(CURRENT_COUNT) AS CURRENT_COUNT
FROM (
    SELECT XFRSA.SA_TYPE_CD AS SA_TYPE_CD, NVL(SUM(FT.TOT_AMT),0) AS BEGINNING_BALANCE, NVL(COUNT(FT.FT_ID),0) AS BEGINNING_COUNT, 0 AS CURRENT_BALANCE, 0 AS CURRENT_COUNT
    FROM CISADM.CI_SA SA, 
         CISADM.CI_FT FT,
         CISADM.CI_ADJ AD,
         CISADM.CI_ADJ XFR,
         CISADM.CI_SA XFRSA
    WHERE 1=1
    AND SA.SA_TYPE_CD = 'WO-BKRPT'
    AND FT.SA_ID = SA.SA_ID
    AND FT.FREEZE_SW = 'Y'
    AND $X{LESS, FT.FREEZE_DTTM, Start_Date}
    AND AD.ADJ_ID = FT.SIBLING_ID
    AND AD.XFER_ADJ_ID != ' '
    AND AD.XFER_ADJ_ID = XFR.ADJ_ID
    AND XFRSA.SA_ID = XFR.SA_ID
    GROUP BY XFRSA.SA_TYPE_CD 
    UNION
    SELECT SA.SA_TYPE_CD AS SA_TYPE_CD, NVL(SUM(FT.TOT_AMT),0) AS BEGINNING_BALANCE, NVL(COUNT(FT.FT_ID),0) AS BEGINNING_COUNT, 0 AS CURRENT_BALANCE, 0 AS CURRENT_COUNT
    FROM CISADM.CI_SA SA, 
         CISADM.CI_FT FT,
         CISADM.CI_ADJ AD
    WHERE 1=1
    AND SA.SA_TYPE_CD = 'WO-BKRPT'
    AND FT.SA_ID = SA.SA_ID
    AND FT.FREEZE_SW = 'Y'
    AND $X{LESS, FT.FREEZE_DTTM, Start_Date}
    AND AD.ADJ_ID = FT.SIBLING_ID
    AND AD.XFER_ADJ_ID = ' '
    GROUP BY SA.SA_TYPE_CD 
    UNION 
    SELECT XFRSA.SA_TYPE_CD AS SA_TYPE_CD, 0 AS BEGINNING_BALANCE, 0 AS BEGINNING_COUNT, NVL(SUM(FT.TOT_AMT),0) AS CURRENT_BALANCE, NVL(COUNT(FT.FT_ID),0) AS CURRENT_COUNT
    FROM CISADM.CI_SA SA, 
         CISADM.CI_FT FT,
         CISADM.CI_ADJ AD,
         CISADM.CI_ADJ XFR,
         CISADM.CI_SA XFRSA
    WHERE 1=1
    AND SA.SA_TYPE_CD = 'WO-BKRPT'
    AND FT.SA_ID = SA.SA_ID
    AND FT.FREEZE_SW = 'Y'
    AND ($X{[BETWEEN], FT.FREEZE_DTTM, Start_Date, End_Date})
    AND AD.ADJ_ID = FT.SIBLING_ID
    AND AD.XFER_ADJ_ID != ' '
    AND AD.XFER_ADJ_ID = XFR.ADJ_ID
    AND XFRSA.SA_ID = XFR.SA_ID
    GROUP BY XFRSA.SA_TYPE_CD
    UNION
    SELECT SA.SA_TYPE_CD AS SA_TYPE_CD, 0 AS BEGINNING_BALANCE, 0 AS BEGINNING_COUNT, NVL(SUM(FT.TOT_AMT),0) AS CURRENT_BALANCE, NVL(COUNT(FT.FT_ID),0) AS CURRENT_COUNT
    FROM CISADM.CI_SA SA, 
         CISADM.CI_FT FT,
         CISADM.CI_ADJ AD
    WHERE 1=1
    AND SA.SA_TYPE_CD = 'WO-BKRPT'
    AND FT.SA_ID = SA.SA_ID
    AND FT.FREEZE_SW = 'Y'
    AND ($X{[BETWEEN], FT.FREEZE_DTTM, Start_Date, End_Date})
    AND AD.ADJ_ID = FT.SIBLING_ID
    AND AD.XFER_ADJ_ID = ' '
    GROUP BY SA.SA_TYPE_CD
)
GROUP BY SA_TYPE_CD
ORDER BY SA_TYPE_CD]]>
		</queryString>
		<field name="SA_TYPE_CD" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="SA_TYPE_CD"/>
			<property name="com.jaspersoft.studio.field.label" value="SA_TYPE_CD"/>
		</field>
		<field name="BEGINNING_BALANCE" class="java.math.BigDecimal">
			<property name="com.jaspersoft.studio.field.name" value="BEGINNING_BALANCE"/>
			<property name="com.jaspersoft.studio.field.label" value="BEGINNING_BALANCE"/>
		</field>
		<field name="BEGINNING_COUNT" class="java.math.BigDecimal">
			<property name="com.jaspersoft.studio.field.name" value="BEGINNING_COUNT"/>
			<property name="com.jaspersoft.studio.field.label" value="BEGINNING_COUNT"/>
		</field>
		<field name="CURRENT_BALANCE" class="java.math.BigDecimal">
			<property name="com.jaspersoft.studio.field.name" value="CURRENT_BALANCE"/>
			<property name="com.jaspersoft.studio.field.label" value="CURRENT_BALANCE"/>
		</field>
		<field name="CURRENT_COUNT" class="java.math.BigDecimal">
			<property name="com.jaspersoft.studio.field.name" value="CURRENT_COUNT"/>
			<property name="com.jaspersoft.studio.field.label" value="CURRENT_COUNT"/>
		</field>
	</subDataset>
