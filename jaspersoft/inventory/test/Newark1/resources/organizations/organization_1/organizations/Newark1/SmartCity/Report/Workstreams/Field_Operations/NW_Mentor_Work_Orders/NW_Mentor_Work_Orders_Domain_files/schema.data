<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.jaspersoft.com/2007/SL/XMLSchema" version="1.3">
  <dataIslands>
    <itemGroup id="Mentor_Work_Orders" label="Mentor_Work_Orders" resourceId="Mentor_Work_Orders"></itemGroup>
  </dataIslands>
  <items>
    <item id="ACTIVITY_TYPE_CD" label="ACTIVITY_TYPE_CD" resourceId="Mentor_Work_Orders.ACTIVITY_TYPE_CD"></item>
    <item id="ADDRESS1" label="ADDRESS1" resourceId="Mentor_Work_Orders.ADDRESS1"></item>
    <item id="BO_STATUS_CD" label="BO_STATUS_CD" resourceId="Mentor_Work_Orders.BO_STATUS_CD"></item>
    <item id="BUS_OBJ_CD" label="BUS_OBJ_CD" resourceId="Mentor_Work_Orders.BUS_OBJ_CD"></item>
    <item id="CRE_DTTM" label="CRE_DTTM" resourceId="Mentor_Work_Orders.CRE_DTTM"></item>
    <item id="D1_ACTIVITY_ID" label="D1_ACTIVITY_ID" resourceId="Mentor_Work_Orders.D1_ACTIVITY_ID"></item>
    <item id="D1_SP_ID" label="D1_SP_ID" resourceId="Mentor_Work_Orders.D1_SP_ID"></item>
    <item id="END_DTTM" label="END_DTTM" resourceId="Mentor_Work_Orders.END_DTTM"></item>
    <item id="FIELD_TASK_TYPE" label="FIELD_TASK_TYPE" resourceId="Mentor_Work_Orders.FIELD_TASK_TYPE"></item>
    <item id="ORCHESTRATION_ACTIVITY" label="ORCHESTRATION_ACTIVITY" resourceId="Mentor_Work_Orders.ORCHESTRATION_ACTIVITY"></item>
    <item id="PARENT_ACTIVITY" label="PARENT_ACTIVITY" resourceId="Mentor_Work_Orders.PARENT_ACTIVITY"></item>
    <item id="SPECIFIC_ACTIVITY" label="SPECIFIC_ACTIVITY" resourceId="Mentor_Work_Orders.SPECIFIC_ACTIVITY"></item>
    <item id="OUTBOUND_COMMUNICATION" label="OUTBOUND_COMMUNICATION" resourceId="Mentor_Work_Orders.OUTBOUND_COMMUNICATION"></item>
    <item id="INBOUND_COMMUNICATION" label="INBOUND_COMMUNICATION" resourceId="Mentor_Work_Orders.INBOUND_COMMUNICATION"></item>
    <item id="START_DTTM" label="START_DTTM" resourceId="Mentor_Work_Orders.START_DTTM"></item>
    <item id="STATUS_CONDITION" label="STATUS_CONDITION" resourceId="Mentor_Work_Orders.STATUS_CONDITION"></item>
    <item id="STATUS_UPD_DTTM" label="STATUS_UPD_DTTM" resourceId="Mentor_Work_Orders.STATUS_UPD_DTTM"></item>
  </items>
  <resources>
    <jdbcQuery id="Mentor_Work_Orders" datasourceId="Newark1_DS">
      <fieldList>
        <field id="D1_ACTIVITY_ID" type="java.lang.String"></field>
        <field id="D1_SP_ID" type="java.lang.String"></field>
        <field id="ADDRESS1" type="java.lang.String"></field>
        <field id="BUS_OBJ_CD" type="java.lang.String"></field>
        <field id="BO_STATUS_CD" type="java.lang.String"></field>
        <field id="ACTIVITY_TYPE_CD" type="java.lang.String"></field>
        <field id="FIELD_TASK_TYPE" type="java.lang.String"></field>
        <field id="START_DTTM" type="java.sql.Timestamp"></field>
        <field id="END_DTTM" type="java.sql.Timestamp"></field>
        <field id="CRE_DTTM" type="java.sql.Timestamp"></field>
        <field id="STATUS_UPD_DTTM" type="java.sql.Timestamp"></field>
        <field id="STATUS_CONDITION" type="java.lang.String"></field>
        <field id="ORCHESTRATION_ACTIVITY" fieldDBName="ORCHESTRATION ACTIVITY" type="java.lang.String"></field>
        <field id="SPECIFIC_ACTIVITY" fieldDBName="SPECIFIC ACTIVITY" type="java.lang.String"></field>
        <field id="PARENT_ACTIVITY" type="java.lang.String"></field>
        <field id="OUTBOUND_COMMUNICATION" type="java.lang.String"></field>
        <field id="INBOUND_COMMUNICATION" type="java.lang.String"></field>
      </fieldList>
      <filterString>not (BUS_OBJ_CD in ('D1-CancelOrchestration        ', 'D1-CutServiceForNonPayment    ', 'D1-UpdateOrchestration        ')) and FIELD_TASK_TYPE != 'D1-CutForNonPayment'</filterString>
      <query>SELECT 
    ACT.D1_ACTIVITY_ID, 
    SP.D1_SP_ID,
    SP.ADDRESS1,
    ACT.BUS_OBJ_CD, 
    ACT.BO_STATUS_CD, 
    ACT.ACTIVITY_TYPE_CD,
    ACT.FIELD_TASK_TYPE,
    ACT.CRE_DTTM, 
    ACT.START_DTTM, 
    ACT.END_DTTM, 
    ACT.STATUS_UPD_DTTM, 
    LK.DESCR "STATUS_CONDITION", 
    OA.REL_ACTIVITY_ID "ORCHESTRATION ACTIVITY", 
    SA.REL_ACTIVITY_ID "SPECIFIC ACTIVITY",
    PR.REL_ACTIVITY_ID "PARENT_ACTIVITY",
    CO.D1_COMM_ID "OUTBOUND_COMMUNICATION",
    CI.D1_COMM_ID "INBOUND_COMMUNICATION"
FROM CISADM.D1_ACTIVITY ACT
INNER JOIN CISADM.D1_ACTIVITY_TYPE AT ON AT.ACTIVITY_TYPE_CD = ACT.ACTIVITY_TYPE_CD
    AND EXISTS (SELECT 1 FROM CISADM.F1_BUS_OBJ BOAT, CISADM.F1_BUS_OBJ_OPT BOOAT
                WHERE BOAT.BUS_OBJ_CD = AT.BUS_OBJ_CD
                AND BOOAT.BUS_OBJ_CD = AT.BUS_OBJ_CD
                AND BOOAT.BUS_OBJ_CD = BOAT.BUS_OBJ_CD
                AND BOOAT.BUS_OBJ_OPT_FLG = 'D1MA' 
                AND BOOAT.BUS_OBJ_OPT_VAL = 'D1SO')
INNER JOIN (SELECT BO.BUS_OBJ_CD, BOST.BO_STATUS_CD 
            FROM CISADM.F1_BUS_OBJ BO, CISADM.F1_BUS_OBJ_STATUS BOST
            WHERE BO.PARENT_BO_CD = '                              '
            AND BO.BUS_OBJ_CD = BOST.BUS_OBJ_CD
            AND NOT EXISTS (SELECT 1 FROM CISADM.F1_BUS_OBJ_STATUS_OPT BSTO
                            WHERE 1=1
                            AND BSTO.BUS_OBJ_CD = BO.BUS_OBJ_CD
                            AND BSTO.BO_STATUS_CD = BOST.BO_STATUS_CD
                            AND BSTO.BO_OPT_FLG = 'D1LS'
                            AND BSTO.BO_OPT_VAL = 'DISCARDED')
            UNION
            SELECT CBO.BUS_OBJ_CD, PBOST.BO_STATUS_CD 
            FROM CISADM.F1_BUS_OBJ CBO, CISADM.F1_BUS_OBJ PBO, CISADM.F1_BUS_OBJ_STATUS PBOST
            WHERE CBO.PARENT_BO_CD != '                              '
            AND PBO.BUS_OBJ_CD = CBO.PARENT_BO_CD
            AND PBOST.BUS_OBJ_CD = PBO.BUS_OBJ_CD
            AND NOT EXISTS (SELECT 1 FROM CISADM.F1_BUS_OBJ_STATUS_OPT BSTO
                            WHERE 1=1
                            AND BSTO.BUS_OBJ_CD = PBO.BUS_OBJ_CD
                            AND BSTO.BO_STATUS_CD = PBOST.BO_STATUS_CD
                            AND BSTO.BO_OPT_FLG = 'D1LS'
                            AND BSTO.BO_OPT_VAL = 'DISCARDED')
            ) BSTO 
                ON BSTO.BUS_OBJ_CD = ACT.BUS_OBJ_CD
             AND BSTO.BO_STATUS_CD =  ACT.BO_STATUS_CD
LEFT JOIN CISADM.D1_ACTIVITY_REL_OBJ OBSP ON OBSP.D1_ACTIVITY_ID = ACT.D1_ACTIVITY_ID
    AND OBSP.MAINT_OBJ_CD = 'D1-SP'
LEFT JOIN CISADM.D1_SP SP ON SP.D1_SP_ID = OBSP.PK_VALUE1
LEFT JOIN CISADM.D1_ACTIVITY_REL OA ON OA.D1_ACTIVITY_ID = ACT.D1_ACTIVITY_ID
    AND OA.ACTIVITY_REL_TYPE_FLG = 'D1OA'
LEFT JOIN CISADM.D1_ACTIVITY_REL SA ON SA.D1_ACTIVITY_ID = ACT.D1_ACTIVITY_ID
    AND SA.ACTIVITY_REL_TYPE_FLG = 'D1SA'
LEFT JOIN CISADM.D1_ACTIVITY_REL PR ON PR.D1_ACTIVITY_ID = ACT.D1_ACTIVITY_ID
    AND PR.ACTIVITY_REL_TYPE_FLG = 'D1PR'
INNER JOIN CISADM.F1_BUS_OBJ_STATUS BST ON BST.BUS_OBJ_CD = BSTO.BUS_OBJ_CD
    AND BST.BO_STATUS_CD = BSTO.BO_STATUS_CD
INNER JOIN CISADM.CI_LOOKUP LK ON LK.FIELD_NAME = 'BO_STATUS_COND_FLG'
    AND LK.FIELD_VALUE = BST.BO_STATUS_COND_FLG
    AND LK.EFF_STATUS = 'A'
    AND LK.LANGUAGE_CD = 'ENG'
LEFT JOIN CISADM.D1_COMM_OUT_REL_OBJ CO ON CO.COMM_REL_OBJ_TYPE_FLG = 'D1PA'
    AND CO.PK_VALUE1 = ACT.D1_ACTIVITY_ID
    AND CO.MAINT_OBJ_CD = 'D1-ACTIVITY' 
LEFT JOIN CISADM.D1_COMM_IN_IDENTIFIER CI ON CI.COMM_ID_TYPE_FLG = 'D1TI'
    AND CI.ID_VALUE = ACT.D1_ACTIVITY_ID</query>
    </jdbcQuery>
  </resources>
</schema>
