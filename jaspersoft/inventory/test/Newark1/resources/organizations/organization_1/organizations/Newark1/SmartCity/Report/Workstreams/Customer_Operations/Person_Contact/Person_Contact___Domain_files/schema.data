    <jdbcQuery id="CM_PERSON_ACCOUNTS" datasourceId="Newark1_DS">
      <fieldList>
        <field id="PER_ID" type="java.lang.String"></field>
        <field id="ACCOUNTS" type="java.math.BigDecimal"></field>
      </fieldList>
      <query>SELECT 
  AP.PER_ID,
  COUNT('X') AS ACCOUNTS
FROM
  CISADM.CI_ACCT_PER AP
GROUP BY 
  AP.PER_ID</query>
    </jdbcQuery>
