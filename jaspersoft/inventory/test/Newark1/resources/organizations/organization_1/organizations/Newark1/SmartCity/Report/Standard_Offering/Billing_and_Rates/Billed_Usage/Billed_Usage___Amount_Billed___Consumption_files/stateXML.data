  <subFilterList>
    <subFilter id="filter_7" letter="F" sourceString="DYNAMIC">
      <expressionString>startsWith(CI_BILL.ACCT_ID, '')</expressionString>
      <parameterizedExpressionString>startsWith(CI_BILL.ACCT_ID, ACCT_ID_1)</parameterizedExpressionString>
    </subFilter>
    <subFilter id="filter_8" letter="G" sourceString="DYNAMIC">
      <expressionString>startsWith(NewSet2.ENTITY_NAME_UPR, '')</expressionString>
      <parameterizedExpressionString>startsWith(NewSet2.ENTITY_NAME_UPR, ENTITY_NAME_UPR_1)</parameterizedExpressionString>
    </subFilter>
    <subFilter id="filter_5" letter="B" sourceString="DYNAMIC">
      <expressionString>betweenDates(CI_BILL.BILL_DT, ts'2026-06-01', ts'2026-06-30')</expressionString>
      <parameterizedExpressionString>betweenDates(CI_BILL.BILL_DT, BILL_DT_1, BILL_DT_2)</parameterizedExpressionString>
    </subFilter>
    <subFilter id="filter_3" letter="D" sourceString="DYNAMIC">
      <expressionString>isAnyValue(NewSet1.DESCR_6)</expressionString>
      <parameterizedExpressionString>NewSet1.DESCR_6 in DESCR_6_1</parameterizedExpressionString>
    </subFilter>
    <subFilter id="filter_4" letter="A" sourceString="DYNAMIC">
      <expressionString>NewSet1.DESCR_20 in ('Gallons')</expressionString>
      <parameterizedExpressionString>NewSet1.DESCR_20 in DESCR_20_1</parameterizedExpressionString>
    </subFilter>
    <subFilter id="filter_1" letter="I" sourceString="DYNAMIC">
      <expressionString>NewSet1.DESCR_25 in ('Mega Gallons')</expressionString>
      <parameterizedExpressionString>NewSet1.DESCR_25 in DESCR_25_1</parameterizedExpressionString>
    </subFilter>
    <subFilter id="filter_2" letter="C" sourceString="DYNAMIC">
      <expressionString>NewSet1.DESCR_11 in ('Fire Line Metered Service (Newark)', 'Fire Line Unmetered Service (Newark)', 'PVSC Tiered Service (Newark)', 'Waste Water Tiered Service (Newark)', 'Water Out of Town Service (Newark)', 'Water Tiered Service (Newark)')</expressionString>
      <parameterizedExpressionString>NewSet1.DESCR_11 in DESCR_11_1</parameterizedExpressionString>
    </subFilter>
    <subFilter id="filter_6" letter="E" sourceString="DYNAMIC">
      <expressionString>NewSet1.DESCR_5 == 'Frozen'</expressionString>
      <parameterizedExpressionString>NewSet1.DESCR_5 == DESCR_5_1</parameterizedExpressionString>
    </subFilter>
    <subFilter id="filter_9" letter="H" sourceString="DYNAMIC">
      <expressionString>NewSet1.DESCR_22 == null</expressionString>
      <parameterizedExpressionString>NewSet1.DESCR_22 == DESCR_22_1</parameterizedExpressionString>
    </subFilter>
    <subFilter id="filter_10" letter="J" sourceString="DYNAMIC">
      <expressionString>CI_PREM.ADDRESS1 != null</expressionString>
      <parameterizedExpressionString>CI_PREM.ADDRESS1 != ADDRESS1_1</parameterizedExpressionString>
    </subFilter>
    <subFilter id="filter_11" letter="K" sourceString="DYNAMIC">
      <expressionString>CI_BSEG_SQ.BILL_SQ != 0</expressionString>
      <parameterizedExpressionString>CI_BSEG_SQ.BILL_SQ != BILL_SQ_1</parameterizedExpressionString>
    </subFilter>
  </subFilterList>
  <title>Usage Consumption &amp; Amount $ Billed, by Account ID &amp; Customer Name</title>
