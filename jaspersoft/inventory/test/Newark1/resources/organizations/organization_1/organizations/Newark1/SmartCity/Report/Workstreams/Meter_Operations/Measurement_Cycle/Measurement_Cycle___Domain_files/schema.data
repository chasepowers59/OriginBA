        <join expr="CMS_LATEST_MSRMT_CYC_RTE_SCHED.MSRMT_CYC_CD == D1_MSRMT_CYC_RTE_L.MSRMT_CYC_CD and CMS_LATEST_MSRMT_CYC_RTE_SCHED.MSRMT_CYC_RTE_CD == D1_MSRMT_CYC_RTE_L.MSRMT_CYC_RTE_CD and D1_MSRMT_CYC_RTE_L.LANGUAGE_CD == 'ENG'" left="CMS_LATEST_MSRMT_CYC_RTE_SCHED" right="D1_MSRMT_CYC_RTE_L" type="inner" weight="1"></join>
        <join expr="D1_SP_MSRMT_CYC_SCHED_RTE.BUS_OBJ_CD == F1_BUS_OBJ_L.BUS_OBJ_CD and F1_BUS_OBJ_L.LANGUAGE_CD == 'ENG'" left="D1_SP_MSRMT_CYC_SCHED_RTE" right="F1_BUS_OBJ_L" type="inner" weight="1"></join>
        <join expr="D1_SP_MSRMT_CYC_SCHED_RTE.BUS_OBJ_CD == F1_BUS_OBJ_STATUS_L.BUS_OBJ_CD and D1_SP_MSRMT_CYC_SCHED_RTE.BO_STATUS_CD == F1_BUS_OBJ_STATUS_L.BO_STATUS_CD and F1_BUS_OBJ_STATUS_L.LANGUAGE_CD == 'ENG'" left="D1_SP_MSRMT_CYC_SCHED_RTE" right="F1_BUS_OBJ_STATUS_L" type="inner" weight="1"></join>
        <join expr="D1_SP.D1_SP_TYPE_CD == D1_SP_TYPE_L.D1_SP_TYPE_CD and D1_SP_TYPE_L.LANGUAGE_CD == 'ENG'" left="D1_SP" right="D1_SP_TYPE_L" type="inner" weight="1"></join>
