        <join expr="D1_SP.DISCONN_LOC_FLG == CI_LOOKUP_VAL_L.FIELD_VALUE and CI_LOOKUP_VAL_L.FIELD_NAME == 'DISCONN_LOC_FLG' and CI_LOOKUP_VAL_L.LANGUAGE_CD == 'ENG'" left="D1_SP" right="CI_LOOKUP_VAL_L" type="leftOuter" weight="1"></join>
        <join expr="D1_SP.SP_SRC_STAT_FLG == CI_LOOKUP_VAL_L_1.FIELD_VALUE and CI_LOOKUP_VAL_L_1.FIELD_NAME == 'SP_SRC_STAT_FLG' and CI_LOOKUP_VAL_L_1.LANGUAGE_CD == 'ENG'" left="D1_SP" right="CI_LOOKUP_VAL_L_1" type="inner" weight="1"></join>
        <join expr="D1_MSRMT_CYC_SCHED_RTE.SCHED_STAT_FLG == CI_LOOKUP_VAL_L_2.FIELD_VALUE and CI_LOOKUP_VAL_L_2.FIELD_NAME == 'SCHED_STAT_FLG' and CI_LOOKUP_VAL_L_2.LANGUAGE_CD == 'ENG'" left="D1_MSRMT_CYC_SCHED_RTE" right="CI_LOOKUP_VAL_L_2" type="inner" weight="1"></join>
