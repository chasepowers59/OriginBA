    <jdbcQuery id="CMS_LATEST_MSRMT_CYC_RTE_SCHED" datasourceId="Newark1_DS">
      <fieldList>
        <field id="MSRMT_CYC_CD" type="java.lang.String"></field>
        <field id="MSRMT_CYC_RTE_CD" type="java.lang.String"></field>
        <field id="SCHED_SELECTION_DT" type="java.sql.Timestamp"></field>
      </fieldList>
      <query>select 
  mcsr.msrmt_cyc_cd,
  mcsr.msrmt_cyc_rte_cd,
  max(sched_selection_dt) as sched_selection_dt
from 
  cisadm.d1_msrmt_cyc_sched_rte mcsr
where
  mcsr.sched_selection_dt &lt;= trunc(sysdate)
group by
  mcsr.msrmt_cyc_cd,
  mcsr.msrmt_cyc_rte_cd</query>
    </jdbcQuery>
    <jdbcQuery id="CMS_SP_WITH_MR_DOWLOAD_ACTIVITY" datasourceId="Newark1_DS">
      <fieldList>
        <field id="D1_SP_ID" type="java.lang.String"></field>
        <field id="SCHED_SEL_DT" type="java.sql.Timestamp"></field>
        <field id="WITH_MR_DOWNLOAD_ACTIVITY" type="java.lang.String"></field>
      </fieldList>
      <query>select 
  actro.pk_value1 as D1_SP_ID,
  trunc(act.cre_dttm) as SCHED_SEL_DT,
  'Y' as WITH_MR_DOWNLOAD_ACTIVITY
from 
  cisadm.D1_ACTIVITY_REL_OBJ actro, 
  cisadm.d1_activity act
where 
  actro.maint_obj_cd = 'D1-SP' 
  and act.d1_activity_id = actro.d1_activity_id 
  and act.bus_obj_cd = 'D1-MeterReadDownloadActivity'</query>
    </jdbcQuery>
    <jdbcQuery id="CMS_SP_WITH_SPE" datasourceId="Newark1_DS">
      <fieldList>
        <field id="D1_SP_ID" type="java.lang.String"></field>
        <field id="SCHED_SELECTION_DT" type="java.sql.Timestamp"></field>
        <field id="WITH_SPE" type="java.lang.String"></field>
      </fieldList>
      <query>select 
  sp.D1_SP_ID,
  sp.SCHED_SELECTION_DT,
  'N' as WITH_SPE
from 
  CISADM.D1_SP_MSRMT_CYC_SCHED_RTE sp
where 
 (
-- SPs that never had an MXU
not exists (select 'x' from CISADM.d1_sp_eqpmnt x where x.d1_sp_id = sp.d1_sp_id)
or
-- SPs that used to have an MXU but were removed, and no new MXU has been put back in its place
exists (select 'x' from CISADM.d1_sp_eqpmnt x where x.d1_sp_id = sp.d1_sp_id and x.d1_removal_dttm &lt;= sp.sched_selection_dt and not exists (select 'x' from CISADM.d1_sp_eqpmnt y where y.d1_sp_id = x.d1_sp_id and y.d1_install_dttm &lt;= sp.sched_selection_dt))
or
-- SPs that have an MXU actively installed, but the asset is not active
exists (select 'x' from CISADM.d1_sp_eqpmnt x, CISADM.d1_dvc y where x.d1_sp_id = sp.d1_sp_id and x.d1_device_id = y.d1_device_id and x.d1_removal_dttm is null and y.bo_status_cd &lt;&gt; 'ACTIVE' and not exists (select 'x' from CISADM.d1_sp_eqpmnt y where y.d1_sp_id = x.d1_sp_id and y.d1_install_dttm &lt;= sp.sched_selection_dt))
)</query>
    </jdbcQuery>
