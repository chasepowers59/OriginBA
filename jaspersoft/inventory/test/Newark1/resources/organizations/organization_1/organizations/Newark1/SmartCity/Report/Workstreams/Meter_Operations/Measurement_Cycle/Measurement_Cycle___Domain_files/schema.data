        <join expr="D1_MSRMT_CYC_SCHED.PRE_GEN_RTE_FLG == CI_LOOKUP_VAL_L_4.FIELD_VALUE and CI_LOOKUP_VAL_L_4.FIELD_NAME == 'PRE_GEN_RTE_FLG' and CI_LOOKUP_VAL_L_4.LANGUAGE_CD == 'ENG'" left="D1_MSRMT_CYC_SCHED" right="CI_LOOKUP_VAL_L_4" type="inner" weight="1"></join>
        <join expr="D1_MSRMT_CYC_SCHED.BUS_OBJ_CD == F1_BUS_OBJ_L_2.BUS_OBJ_CD and F1_BUS_OBJ_L_2.LANGUAGE_CD == 'ENG'" left="D1_MSRMT_CYC_SCHED" right="F1_BUS_OBJ_L_2" type="inner" weight="1"></join>
        <join expr="D1_MSRMT_CYC_RTE.BUS_OBJ_CD == F1_BUS_OBJ_L_3.BUS_OBJ_CD and F1_BUS_OBJ_L_3.LANGUAGE_CD == 'ENG'" left="D1_MSRMT_CYC_RTE" right="F1_BUS_OBJ_L_3" type="inner" weight="1"></join>
        <join expr="D1_MSRMT_CYC_SCHED_RTE.D1_SCHED_TYPE_FLG == CI_LOOKUP_VAL_L_5.FIELD_VALUE and CI_LOOKUP_VAL_L_5.FIELD_NAME == 'D1_SCHED_TYPE_FLG' and CI_LOOKUP_VAL_L_5.LANGUAGE_CD == 'ENG'" left="D1_MSRMT_CYC_SCHED_RTE" right="CI_LOOKUP_VAL_L_5" type="inner" weight="1"></join>
        <join expr="D1_MSRMT_CYC_RTE.D1_SPR_CD == D1_SPR_L.D1_SPR_CD and D1_SPR_L.LANGUAGE_CD == 'ENG'" left="D1_MSRMT_CYC_RTE" right="D1_SPR_L" type="leftOuter" weight="1"></join>
        <join expr="D1_SP_MSRMT_CYC_SCHED_RTE.D1_SP_ID == CMS_SP_WITH_MR_DOWLOAD_ACTIVITY.D1_SP_ID and D1_SP_MSRMT_CYC_SCHED_RTE.SCHED_SELECTION_DT == CMS_SP_WITH_MR_DOWLOAD_ACTIVITY.SCHED_SEL_DT" left="D1_SP_MSRMT_CYC_SCHED_RTE" right="CMS_SP_WITH_MR_DOWLOAD_ACTIVITY" type="leftOuter" weight="1"></join>
        <join expr="D1_SP_MSRMT_CYC_SCHED_RTE.D1_SP_ID == CMS_SP_WITH_SPE.D1_SP_ID and D1_SP_MSRMT_CYC_SCHED_RTE.SCHED_SELECTION_DT == CMS_SP_WITH_SPE.SCHED_SELECTION_DT" left="D1_SP_MSRMT_CYC_SCHED_RTE" right="CMS_SP_WITH_SPE" type="leftOuter" weight="1"></join>
      </joinList>
      <joinOptions></joinOptions>
      <query>select 
  mcsr.msrmt_cyc_cd,
  mcsr.msrmt_cyc_rte_cd,
  max(sched_selection_dt) as sched_selection_dt
from 
  cisadm.d1_msrmt_cyc_sched_rte mcsr
where
  mcsr.sched_selection_dt &lt;= trunc(sysdate)
group by
  mcsr.msrmt_cyc_cd,
  mcsr.msrmt_cyc_rte_cd</query>
