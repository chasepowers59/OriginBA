        END AS SA_TYPE_CD,
        CASE
        WHEN
                SA.OLD_ACCT_ID IN ('0000013924',
                                   '0000013925',
                                   '0000051670',
                                   '0000013928')
        THEN
                'BELLEVILLE'
        WHEN
                SA.OLD_ACCT_ID IN ('0000013927',
                                   '0000013931',
                                   '0000051057')
        THEN
                'COE'
        WHEN
                SA.OLD_ACCT_ID IN ('0000013934',
                                   '0000013935',
                                   '0000013936',
                                   '0000013940',
                                   '0000013941',
                                   '0000013942')
        THEN
                'WAYNE'
        WHEN
                SA.OLD_ACCT_ID = '0000013943'
        THEN
                'BLOOMFIELD'
        WHEN
                SA.OLD_ACCT_ID IN ('0000013945',
                                   '0000013948',
                                   '0000045781')
        THEN
                'PEQUANNOCK'
        WHEN
                SA.OLD_ACCT_ID = '0000013951'
        THEN
                'ELIZABETH'
        WHEN
                SA.OLD_ACCT_ID IN ('0000050719',
                                   '0000052861')
        THEN
                'ORANGE'
        ELSE
                SA.SA_TYPE_CD
        END AS OOT_SA_TYP_CD,
        SA.ACCT_ID          ,
        SA.OLD_ACCT_ID      ,
        SA.CHAR_PREM_ID     ,
        PREM.ADDRESS1
FROM
        CISADM.CI_SA SA
INNER JOIN
        CISADM.CI_PREM_CHAR PC
ON
        PC.PREM_ID = SA.CHAR_PREM_ID
AND     PC.CHAR_TYPE_CD = 'PVSCRATE'
INNER JOIN
        CISADM.CI_PREM PREM
ON
        PREM.PREM_ID = SA.CHAR_PREM_ID
INNER JOIN
        CISADM.CI_BSEG BSEG
ON
        BSEG.SA_ID = SA.SA_ID
AND     BSEG.BSEG_STAT_FLG = '50'
INNER JOIN
        CISADM.CI_BSEG_SQ BSQ
ON
        BSQ.BSEG_ID = BSEG.BSEG_ID
AND     BSQ.UOM_CD  = 'CF'
AND     BSQ.TOU_CD  = ' '
AND     BSQ.SQI_CD  = ' '
WHERE
        SA.SA_TYPE_CD IN ('W-COM', 'W-IND', 'W-OOT', 'W-RES')
AND BSEG.END_DT >= $P{Start_Date}
AND ((BSEG.END_DT <= $P{End_Date}
    AND SA.SA_TYPE_CD IN ( 'W-COM', 'W-IND', 'W-RES' ))
    OR (BSEG.END_DT <= $P{End_Date} + 5
    AND SA.SA_TYPE_CD IN ( 'W-OOT' )))]]>
		</queryString>
