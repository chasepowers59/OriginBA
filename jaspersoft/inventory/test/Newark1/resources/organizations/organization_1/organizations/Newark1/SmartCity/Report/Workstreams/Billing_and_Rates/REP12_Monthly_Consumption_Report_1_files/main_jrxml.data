	<subDataset name="MonthlyConsumptionReport" uuid="8ce37615-64b8-4692-8be9-981637faafcf">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="Newark - JRS TST DB"/>
		<parameter name="Start_Date" class="java.sql.Date"/>
		<parameter name="End_Date" class="java.sql.Date"/>
		<queryString language="SQL">
			<![CDATA[SELECT
        BSEG.BILL_ID ,
        BSEG.BSEG_ID ,
        BSEG.SA_ID   ,
        BSEG.START_DT,
        BSEG.END_DT  ,
        BSQ.BILL_SQ  ,
        CASE
        WHEN
                PC.CHAR_VAL = 'M1'
        THEN
                'M1'
        WHEN
                PC.CHAR_VAL = 'MS1'
        THEN
                'MS1'
        ELSE
                SA.SA_TYPE_CD
        END AS SA_TYPE_CD,
        CASE
        WHEN
                SA.OLD_ACCT_ID IN ('0000013924',
                                   '0000013925',
                                   '0000051670',
                                   '0000013928')
        THEN
                'BELLEVILLE'
        WHEN
                SA.OLD_ACCT_ID IN ('0000013927',
                                   '0000013931',
                                   '0000051057')
        THEN
                'COE'
        WHEN
                SA.OLD_ACCT_ID IN ('0000013934',
                                   '0000013935',
                                   '0000013936',
                                   '0000013940',
                                   '0000013941',
                                   '0000013942')
        THEN
                'WAYNE'
        WHEN
                SA.OLD_ACCT_ID = '0000013943'
        THEN
                'BLOOMFIELD'
        WHEN
                SA.OLD_ACCT_ID IN ('0000013945',
                                   '0000013948',
                                   '0000045781')
        THEN
                'PEQUANNOCK'
        WHEN
                SA.OLD_ACCT_ID = '0000013951'
        THEN
                'ELIZABETH'
        WHEN
                SA.OLD_ACCT_ID IN ('0000050719',
                                   '0000052861')
        THEN
                'ORANGE'
        ELSE
                SA.SA_TYPE_CD
        END AS OOT_SA_TYP_CD,
        SA.ACCT_ID          ,
        SA.OLD_ACCT_ID      ,
        SA.CHAR_PREM_ID     ,
        PREM.ADDRESS1
FROM
        CISADM.CI_SA SA
INNER JOIN
        CISADM.CI_PREM_CHAR PC
ON
        PC.PREM_ID = SA.CHAR_PREM_ID
AND     PC.CHAR_TYPE_CD = 'PVSCRATE'
INNER JOIN
        CISADM.CI_PREM PREM
ON
        PREM.PREM_ID = SA.CHAR_PREM_ID
INNER JOIN
        CISADM.CI_BSEG BSEG
ON
        BSEG.SA_ID = SA.SA_ID
AND     BSEG.BSEG_STAT_FLG = '50'
INNER JOIN
        CISADM.CI_BSEG_SQ BSQ
ON
        BSQ.BSEG_ID = BSEG.BSEG_ID
AND     BSQ.UOM_CD  = 'CF'
AND     BSQ.TOU_CD  = ' '
AND     BSQ.SQI_CD  = ' '
WHERE
        SA.SA_TYPE_CD IN ('W-COM', 'W-IND', 'W-OOT', 'W-RES')
AND BSEG.END_DT >= $P{Start_Date}
AND ((BSEG.END_DT <= $P{End_Date}
    AND SA.SA_TYPE_CD IN ( 'W-COM', 'W-IND', 'W-RES' ))
    OR (BSEG.END_DT <= $P{End_Date} + 5
    AND SA.SA_TYPE_CD IN ( 'W-OOT' )))]]>
		</queryString>
		<field name="BILL_ID" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="BILL_ID"/>
			<property name="com.jaspersoft.studio.field.label" value="BILL_ID"/>
		</field>
		<field name="BSEG_ID" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="BSEG_ID"/>
			<property name="com.jaspersoft.studio.field.label" value="BSEG_ID"/>
		</field>
		<field name="SA_ID" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="SA_ID"/>
			<property name="com.jaspersoft.studio.field.label" value="SA_ID"/>
		</field>
		<field name="START_DT" class="java.sql.Timestamp">
			<property name="com.jaspersoft.studio.field.name" value="START_DT"/>
			<property name="com.jaspersoft.studio.field.label" value="START_DT"/>
		</field>
		<field name="END_DT" class="java.sql.Timestamp">
			<property name="com.jaspersoft.studio.field.name" value="END_DT"/>
			<property name="com.jaspersoft.studio.field.label" value="END_DT"/>
		</field>
		<field name="BILL_SQ" class="java.math.BigDecimal">
			<property name="com.jaspersoft.studio.field.name" value="BILL_SQ"/>
			<property name="com.jaspersoft.studio.field.label" value="BILL_SQ"/>
		</field>
		<field name="SA_TYPE_CD" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="SA_TYPE_CD"/>
			<property name="com.jaspersoft.studio.field.label" value="SA_TYPE_CD"/>
		</field>
		<field name="OOT_SA_TYP_CD" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="OOT_SA_TYP_CD"/>
			<property name="com.jaspersoft.studio.field.label" value="OOT_SA_TYP_CD"/>
		</field>
		<field name="ACCT_ID" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="ACCT_ID"/>
			<property name="com.jaspersoft.studio.field.label" value="ACCT_ID"/>
		</field>
		<field name="OLD_ACCT_ID" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="OLD_ACCT_ID"/>
			<property name="com.jaspersoft.studio.field.label" value="OLD_ACCT_ID"/>
		</field>
		<field name="CHAR_PREM_ID" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="CHAR_PREM_ID"/>
			<property name="com.jaspersoft.studio.field.label" value="CHAR_PREM_ID"/>
		</field>
		<field name="ADDRESS1" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="ADDRESS1"/>
			<property name="com.jaspersoft.studio.field.label" value="ADDRESS1"/>
		</field>
	</subDataset>
	<subDataset name="MonthlyConsumptionReportCrossTab" uuid="0ed76363-9678-45ab-b28f-0846d4c8aefc">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="One Empty Record"/>
		<parameter name="Start_Date" class="java.sql.Date"/>
		<parameter name="End_Date" class="java.sql.Date"/>
		<queryString language="SQL">
			<![CDATA[SELECT
TO_CHAR(TRUNC(BSEG.END_DT, 'MM'),'YYYY-MM') AS MONTH,
SUM(BSQ.BILL_SQ) AS BILL_SQ,
SA.SA_TYPE_CD,
SA.OOT_SA_TYP_CD
FROM   
    (SELECT
        SA.SA_ID,
        CASE
                WHEN PC.CHAR_VAL = 'M1' THEN 'M1'
                WHEN PC.CHAR_VAL = 'MS1' THEN 'MS1'
                ELSE SA.SA_TYPE_CD
        END AS SA_TYPE_CD,
        SA.ACCT_ID,
        SA.OLD_ACCT_ID,
        SA.CHAR_PREM_ID,
        CASE
            WHEN SA.OLD_ACCT_ID = '0000013924' THEN 'BELLEVILLE'
            WHEN SA.OLD_ACCT_ID = '0000013925' THEN 'BELLEVILLE'
            WHEN SA.OLD_ACCT_ID = '0000051670' THEN 'BELLEVILLE'
            WHEN SA.OLD_ACCT_ID = '0000013928' THEN 'BELLEVILLE'
            WHEN SA.OLD_ACCT_ID = '0000013927' THEN 'COE'
            WHEN SA.OLD_ACCT_ID = '0000013931' THEN 'COE'
            WHEN SA.OLD_ACCT_ID = '0000051057' THEN 'COE'
            WHEN SA.OLD_ACCT_ID = '0000013934' THEN 'WAYNE'
            WHEN SA.OLD_ACCT_ID = '0000013935' THEN 'WAYNE'
            WHEN SA.OLD_ACCT_ID = '0000013936' THEN 'WAYNE'
            WHEN SA.OLD_ACCT_ID = '0000013940' THEN 'WAYNE'
            WHEN SA.OLD_ACCT_ID = '0000013941' THEN 'WAYNE'
            WHEN SA.OLD_ACCT_ID = '0000013942' THEN 'WAYNE'
            WHEN SA.OLD_ACCT_ID = '0000013943' THEN 'BLOOMFIELD'
            WHEN SA.OLD_ACCT_ID = '0000013945' THEN 'PEQUANNOCK'
            WHEN SA.OLD_ACCT_ID = '0000013948' THEN 'PEQUANNOCK'
            WHEN SA.OLD_ACCT_ID = '0000045781' THEN 'PEQUANNOCK'
            WHEN SA.OLD_ACCT_ID = '0000013951' THEN 'ELIZABETH'
            WHEN SA.OLD_ACCT_ID = '0000050719' THEN 'ORANGE'
            WHEN SA.OLD_ACCT_ID = '0000052861' THEN 'ORANGE'
            ELSE SA.SA_TYPE_CD
        END AS OOT_SA_TYP_CD
        FROM   CISADM.CI_SA SA, CISADM.CI_PREM_CHAR PC
        WHERE  SA.CHAR_PREM_ID = PC.PREM_ID
        AND PC.CHAR_TYPE_CD = 'PVSCRATE'
        AND SA.SA_TYPE_CD IN ( 'W-COM', 'W-IND', 'W-OOT', 'W-RES')
    ) SA
    INNER JOIN CISADM.CI_PREM PREM
        ON PREM.PREM_ID = SA.CHAR_PREM_ID
    INNER JOIN CISADM.CI_BSEG BSEG
        ON BSEG.SA_ID = SA.SA_ID
    INNER JOIN CISADM.CI_BSEG_SQ BSQ
        ON BSQ.BSEG_ID = BSEG.BSEG_ID
        AND BSQ.UOM_CD = 'CF'
        AND BSQ.TOU_CD = ' '
        AND BSQ.SQI_CD = ' '    
WHERE
BSEG.END_DT >= $P{Start_Date}
AND ((BSEG.END_DT <= $P{End_Date})
    OR (BSEG.END_DT <= $P{End_Date} + 5
        AND SA.SA_TYPE_CD IN ( 'W-OOT' )))
AND BSEG.BSEG_STAT_FLG = '50'
GROUP BY TRUNC(BSEG.END_DT, 'MM'), SA.OOT_SA_TYP_CD,SA.SA_TYPE_CD
ORDER BY MONTH DESC]]>
		</queryString>
		<field name="MONTH" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="BILL_ID"/>
			<property name="com.jaspersoft.studio.field.label" value="BILL_ID"/>
		</field>
		<field name="BILL_SQ" class="java.math.BigDecimal">
			<property name="com.jaspersoft.studio.field.name" value="BILL_SQ"/>
			<property name="com.jaspersoft.studio.field.label" value="BILL_SQ"/>
		</field>
		<field name="SA_TYPE_CD" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="SA_TYPE_CD"/>
			<property name="com.jaspersoft.studio.field.label" value="SA_TYPE_CD"/>
		</field>
		<field name="OOT_SA_TYP_CD" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="OOT_SA_TYP_CD"/>
			<property name="com.jaspersoft.studio.field.label" value="OOT_SA_TYP_CD"/>
		</field>
	</subDataset>
	<subDataset name="MonthlyCrossTab" uuid="877cdb8c-0797-4ecc-aea4-0c004215a144">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
