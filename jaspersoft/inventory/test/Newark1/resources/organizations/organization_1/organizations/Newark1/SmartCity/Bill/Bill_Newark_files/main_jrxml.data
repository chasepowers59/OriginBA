						</box>
					</element>
					<element kind="staticText" uuid="f672cefb-b7d5-481b-a7c9-31a46407ca6c" x="148" y="76" width="120" height="82" fontName="Arial" fontSize="6.5" hTextAlign="Center" vTextAlign="Top">
						<text><![CDATA[Call 1(888)-877-0450 to pay by phone with credit card. You can pay 24 hours a day. Your payment will post immediately.]]></text>
						<property name="com.jaspersoft.studio.unit.width" value="px"/>
						<property name="com.jaspersoft.studio.unit.height" value="px"/>
						<box padding="3">
							<rightPen lineWidth="0.25" lineStyle="Solid" lineColor="#C6C6C6"/>
						</box>
					</element>
					<element kind="staticText" uuid="6cd9464f-ae5e-41d5-886a-4f1fb61f8a33" x="268" y="76" width="121" height="82" fontName="Arial" fontSize="6.5" hTextAlign="Center">
						<text><![CDATA[Residents can pay in person by cash, check, money order or credit card at the Water Department office in City Hall:

920 Mayor Kenneth A Gibson Blvd
Room 117
Newark, New Jersey 07102
Checks and money orders are payable to: City of Newark Water Department]]></text>
						<property name="com.jaspersoft.studio.unit.width" value="px"/>
						<property name="com.jaspersoft.studio.unit.height" value="px"/>
						<box padding="3">
							<rightPen lineWidth="0.25" lineStyle="Solid" lineColor="#C6C6C6"/>
						</box>
					</element>
					<element kind="staticText" uuid="e5de1f13-bfd2-47a0-8904-272da831aa5c" x="389" y="76" width="120" height="82" fontName="Arial" fontSize="6.5" hTextAlign="Center">
						<text><![CDATA[Customers can mail their payments to the Department. Make checks payable to City of Newark Water Department and Send to:

City of Newark Water Department
920 Mayor Kenneth A Gibson Blvd
Room 117
Newark, New Jersey 07102]]></text>
						<property name="com.jaspersoft.studio.unit.width" value="px"/>
						<property name="com.jaspersoft.studio.unit.height" value="px"/>
						<box padding="3">
							<rightPen lineWidth="0.0"/>
						</box>
					</element>
					<element kind="image" uuid="098d1115-e092-42d5-96e2-327fc90894d3" x="60" y="27" width="54" height="37" printWhenGroupChanges="BillAccountIDSubGroup">
						<expression><![CDATA["repo:e_billing.png"]]></expression>
					</element>
					<element kind="image" uuid="279c3efb-2d08-44bd-bf6d-7c18a192463f" x="184" y="27" width="45" height="37" printWhenGroupChanges="BillAccountIDSubGroup">
