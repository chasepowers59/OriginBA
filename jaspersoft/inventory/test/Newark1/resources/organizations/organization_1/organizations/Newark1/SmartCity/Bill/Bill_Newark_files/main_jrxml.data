					</element>
					<element kind="image" uuid="11b50030-040d-4353-80dd-ec383713b25b" x="421" y="27" width="46" height="37" printWhenGroupChanges="BillAccountIDSubGroup">
						<expression><![CDATA["repo:ByMail.png"]]></expression>
					</element>
				</element>
				<property name="com.jaspersoft.studio.unit.height" value="px"/>
			</band>
		</groupFooter>
	</group>
