						</datasetRun>
						<contents height="12" width="540">
							<element kind="textField" uuid="f5394d76-d7bd-49ad-afdc-a2112438e69e" x="80" y="0" width="110" height="12" fontName="Arial" fontSize="8.0" textAdjust="ScaleFont" hTextAlign="Center" vTextAlign="Middle">
								<expression><![CDATA[DATEFORMAT(DATE(Integer.valueOf($F{startReadDttm}.substring(0,4)),Integer.valueOf($F{startReadDttm}.substring(5,7)),Integer.valueOf($F{startReadDttm}.substring(8,10))), "MM/dd/yy") + " - " + DATEFORMAT(DATE(Integer.valueOf($F{endReadDttm}.substring(0,4)),Integer.valueOf($F{endReadDttm}.substring(5,7)),Integer.valueOf($F{endReadDttm}.substring(8,10))), "MM/dd/yy")]]></expression>
								<property name="com.jaspersoft.studio.unit.width" value="px"/>
								<property name="com.jaspersoft.studio.unit.height" value="px"/>
								<box>
									<topPen lineWidth="0.0" lineStyle="Solid" lineColor="#C6C6C6"/>
									<leftPen lineWidth="0.0" lineStyle="Solid" lineColor="#C6C6C6"/>
