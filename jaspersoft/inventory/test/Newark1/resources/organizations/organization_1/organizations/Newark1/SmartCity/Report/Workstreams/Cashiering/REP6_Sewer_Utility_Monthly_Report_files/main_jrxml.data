	<parameter name="Start_Date" class="java.sql.Date"/>
	<parameter name="End_Date" class="java.sql.Date"/>
	<queryString language="SQL">
		<![CDATA[SELECT 
    ACCT.ACCT_ID AS ACCOUNT_ID,
    SA.SA_TYPE_CD,
    'PAYMENTS RECEIVED' AS PAYMENT_TYPE,
    SUM(FT.CUR_AMT) AS TOTAL
FROM
    CISADM.CI_ACCT ACCT,
    CISADM.CI_SA SA,
    CISADM.CI_SA_TYPE SAT,
    CISADM.CI_FT FT
WHERE 1 = 1 
    AND SA.ACCT_ID = ACCT.ACCT_ID
    AND SAT.SA_TYPE_CD = SA.SA_TYPE_CD
    AND SAT.CIS_DIVISION = SA.CIS_DIVISION
    AND SAT.SVC_TYPE_CD = 'WW'  
    AND FT.SA_ID = SA.SA_ID
    AND FT.FREEZE_SW = 'Y'
    AND FT.FT_TYPE_FLG = 'PS'
    AND $X{[BETWEEN], FT.FREEZE_DTTM, Start_Date, End_Date}
GROUP BY ACCT.ACCT_ID, SA.SA_TYPE_CD
UNION ALL
SELECT 
    ACCT.ACCT_ID AS ACCOUNT_ID,
    SA.SA_TYPE_CD,
    'PAYMENTS RETURNED' AS PAYMENT_TYPE,
    SUM(FT.CUR_AMT) AS TOTAL
FROM
    CISADM.CI_ACCT ACCT,
    CISADM.CI_SA SA,
    CISADM.CI_SA_TYPE SAT,
    CISADM.CI_FT FT,
    CISADM.CI_PAY PAY
WHERE 1 = 1 
    AND SA.ACCT_ID = ACCT.ACCT_ID
    AND SAT.SA_TYPE_CD = SA.SA_TYPE_CD
    AND SAT.CIS_DIVISION = SA.CIS_DIVISION
    AND SAT.SVC_TYPE_CD = 'WW'  
    AND FT.SA_ID = SA.SA_ID
    AND FT.FREEZE_SW = 'Y'
    AND FT.FT_TYPE_FLG = 'PX'
    AND $X{[BETWEEN], FT.FREEZE_DTTM, Start_Date, End_Date}
    AND PAY.PAY_ID = FT.PARENT_ID
    AND PAY.PAY_STATUS_FLG = '60'
    AND PAY.CAN_RSN_CD = 'NSF'
GROUP BY ACCT.ACCT_ID, SA.SA_TYPE_CD]]>
	</queryString>
	<field name="ACCOUNT_ID" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="ACCOUNT_ID"/>
		<property name="com.jaspersoft.studio.field.label" value="ACCOUNT_ID"/>
	</field>
	<field name="SA_TYPE_CD" class="java.lang.String">
