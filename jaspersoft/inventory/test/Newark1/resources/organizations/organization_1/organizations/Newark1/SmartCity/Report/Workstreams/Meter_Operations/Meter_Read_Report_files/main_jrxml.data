	<subDataset name="MeterReadReport" uuid="60724ef9-d927-4799-9251-4edeffd8e145">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="Newark-JRS2C2M-TST"/>
		<parameter name="Report_Date" class="java.sql.Date"/>
		<queryString language="SQL">
			<![CDATA[SELECT PCHAR.CHAR_VAL PROPERTY_TYPE,
       PREM.ADDRESS1  ADDRESS,
       SASP.ACCT_ID     C2M_ACCT_ID,
       SASP.OLD_ACCT_ID AS400_ACCT_ID,
       MSR.MSRMT_DTTM   CURRENT_READ_DATE,
       MSR.READING_VAL  CURRENT_READING,
       MSR2.MSRMT_DTTM  PREVIOUS_READ_DATE,
       MSR2.READING_VAL PREVIOUS_READING
FROM   CISADM.CI_PREM PREM
       LEFT JOIN CISADM.CI_PREM_CHAR PCHAR
              ON PCHAR.PREM_ID = PREM.PREM_ID
                 AND PCHAR.CHAR_TYPE_CD = 'PRPRTYTY'
       INNER JOIN CISADM.CI_SP SP
               ON SP.PREM_ID = PREM.PREM_ID
       INNER JOIN (SELECT *
                   FROM   (SELECT SA.ACCT_ID,
                                  SA.OLD_ACCT_ID,
                                  SASP1.SP_ID,
                                  SA.SA_ID,
                                  ROW_NUMBER()
                                    OVER (
                                      PARTITION BY SA.ACCT_ID
                                      ORDER BY SA.SA_ID DESC) RANK
                           FROM   CISADM.CI_SA_SP SASP1,
                                  CISADM.CI_SA SA
                           WHERE  SASP1.SA_ID = SA.SA_ID)
                   WHERE  RANK = 1) SASP
               ON SASP.SP_ID = SP.SP_ID
       INNER JOIN CISADM.D1_SP_IDENTIFIER SPIDENTIFIER
               ON SPIDENTIFIER.SP_ID_TYPE_FLG = 'D1EI'
                  AND SPIDENTIFIER.ID_VALUE = SASP.SP_ID
       INNER JOIN CISADM.D1_SP MDMSP
               ON MDMSP.D1_SP_ID = SPIDENTIFIER.D1_SP_ID
       INNER JOIN CISADM.D1_INSTALL_EVT IE
               ON IE.D1_SP_ID = MDMSP.D1_SP_ID
                  AND ( IE.D1_REMOVAL_DTTM IS NULL OR IE.D1_REMOVAL_DTTM >= $P{Report_Date})
       INNER JOIN CISADM.D1_MEASR_COMP MC
               ON MC.DEVICE_CONFIG_ID = IE.DEVICE_CONFIG_ID
       LEFT JOIN CISADM.D1_MSRMT MSR
              ON MSR.MEASR_COMP_ID = MC.MEASR_COMP_ID
                 AND MSR.MSRMT_DTTM = (SELECT MAX(MSR1.MSRMT_DTTM)
                                       FROM   CISADM.D1_MSRMT MSR1
                                       WHERE
                     MSR1.MEASR_COMP_ID = MSR.MEASR_COMP_ID
                     AND MSR1.MSRMT_USE_FLG != 'D101'
                     AND MSR1.MSRMT_DTTM <= $P{Report_Date})
       LEFT JOIN CISADM.D1_MSRMT MSR2
              ON MSR2.MEASR_COMP_ID = MSR.MEASR_COMP_ID
                 AND MSR2.MSRMT_DTTM = MSR.PREV_MSRMT_DTTM
                 AND MSR2.MSRMT_USE_FLG != 'D101']]>
		</queryString>
		<field name="PROPERTY_TYPE" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="PROPERTY_TYPE"/>
			<property name="com.jaspersoft.studio.field.label" value="PROPERTY_TYPE"/>
		</field>
		<field name="ADDRESS" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="ADDRESS"/>
			<property name="com.jaspersoft.studio.field.label" value="ADDRESS"/>
		</field>
		<field name="C2M_ACCT_ID" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="C2M_ACCT_ID"/>
			<property name="com.jaspersoft.studio.field.label" value="C2M_ACCT_ID"/>
		</field>
		<field name="AS400_ACCT_ID" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="AS400_ACCT_ID"/>
			<property name="com.jaspersoft.studio.field.label" value="AS400_ACCT_ID"/>
		</field>
		<field name="CURRENT_READ_DATE" class="java.sql.Timestamp">
			<property name="com.jaspersoft.studio.field.name" value="CURRENT_READ_DATE"/>
			<property name="com.jaspersoft.studio.field.label" value="CURRENT_READ_DATE"/>
		</field>
		<field name="CURRENT_READING" class="java.math.BigDecimal">
			<property name="com.jaspersoft.studio.field.name" value="CURRENT_READING"/>
			<property name="com.jaspersoft.studio.field.label" value="CURRENT_READING"/>
		</field>
		<field name="PREVIOUS_READ_DATE" class="java.sql.Timestamp">
			<property name="com.jaspersoft.studio.field.name" value="PREVIOUS_READ_DATE"/>
			<property name="com.jaspersoft.studio.field.label" value="PREVIOUS_READ_DATE"/>
		</field>
		<field name="PREVIOUS_READING" class="java.math.BigDecimal">
			<property name="com.jaspersoft.studio.field.name" value="PREVIOUS_READING"/>
			<property name="com.jaspersoft.studio.field.label" value="PREVIOUS_READING"/>
		</field>
	</subDataset>
	<parameter name="Report_Date" class="java.sql.Date"/>
	<queryString language="SQL">
		<![CDATA[SELECT 1 FROM CISADM.CI_ACCT WHERE ROWNUM = 1]]>
	</queryString>
	<field name="1" class="java.math.BigDecimal">
		<property name="com.jaspersoft.studio.field.name" value="1"/>
		<property name="com.jaspersoft.studio.field.label" value="1"/>
	</field>
