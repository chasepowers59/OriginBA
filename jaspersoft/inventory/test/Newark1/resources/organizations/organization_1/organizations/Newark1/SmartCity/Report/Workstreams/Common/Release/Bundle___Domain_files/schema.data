        <field id="USER_ID_NAME" dataSetExpression="Concatenate(SC_USER.FIRST_NAME, ' ', SC_USER.LAST_NAME)" type="java.lang.String"></field>
        <field id="PRIMARY_KEYS" dataSetExpression="Concatenate(F1_BNDL_ENTITY.PK_VALUE1, ',', F1_BNDL_ENTITY.PK_VALUE2, ',', F1_BNDL_ENTITY.PK_VALUE3, ',', F1_BNDL_ENTITY.PK_VALUE4, ',', F1_BNDL_ENTITY.PK_VALUE5)" type="java.lang.String"></field>
        <field id="BNDL_ID_DIST" dataSetExpression="CountDistinct(F1_BNDL.BNDL_ID, 'Current')" type="java.lang.Long"></field>
        <field id="BNDL_ID_SEQNO_DIST" dataSetExpression="CountDistinct(Concatenate(F1_BNDL_ENTITY.BNDL_ID, '_', F1_BNDL_ENTITY.SEQNO), 'Current')" type="java.lang.Long"></field>
