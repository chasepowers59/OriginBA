      <filterString>CI_LOOKUP_VAL_L.FIELD_NAME == 'BNDL_TYPE_FLG                 ' and CI_LOOKUP_VAL_L.LANGUAGE_CD == 'ENG' and F1_BUS_OBJ_L.LANGUAGE_CD == 'ENG' and CI_MD_MO_L.LANGUAGE_CD == 'ENG' and F1_BUS_OBJ_STATUS_L.LANGUAGE_CD == 'ENG'</filterString>
      <joinInfo alias="F1_BNDL" referenceId="F1_BNDL"></joinInfo>
      <joinList>
        <join expr="F1_BNDL.BNDL_ID == F1_BNDL_ENTITY.BNDL_ID" left="F1_BNDL" right="F1_BNDL_ENTITY" type="leftOuter" weight="1"></join>
        <join expr="F1_BNDL.BNDL_TYPE_FLG == CI_LOOKUP_VAL_L.FIELD_VALUE and CI_LOOKUP_VAL_L.FIELD_NAME == 'BNDL_TYPE_FLG' and CI_LOOKUP_VAL_L.LANGUAGE_CD == 'ENG'" left="F1_BNDL" right="CI_LOOKUP_VAL_L" type="inner" weight="1"></join>
        <join expr="F1_BNDL.BUS_OBJ_CD == F1_BUS_OBJ_L.BUS_OBJ_CD and F1_BUS_OBJ_L.LANGUAGE_CD == 'ENG'" left="F1_BNDL" right="F1_BUS_OBJ_L" type="inner" weight="1"></join>
        <join expr="F1_BNDL.BUS_OBJ_CD == F1_BUS_OBJ_STATUS_L.BUS_OBJ_CD and F1_BNDL.BO_STATUS_CD == F1_BUS_OBJ_STATUS_L.BO_STATUS_CD and F1_BUS_OBJ_STATUS_L.LANGUAGE_CD == 'ENG'" left="F1_BNDL" right="F1_BUS_OBJ_STATUS_L" type="inner" weight="1"></join>
        <join expr="F1_BNDL.USER_ID == SC_USER.USER_ID" left="F1_BNDL" right="SC_USER" type="inner" weight="1"></join>
        <join expr="F1_BNDL_ENTITY.MAINT_OBJ_CD == CI_MD_MO_L.MAINT_OBJ_CD and CI_MD_MO_L.LANGUAGE_CD == 'ENG'" left="F1_BNDL_ENTITY" right="CI_MD_MO_L" type="inner" weight="1"></join>
        <join expr="F1_BNDL_ENTITY.USER_ID == SC_USER_1.USER_ID" left="F1_BNDL_ENTITY" right="SC_USER_1" type="leftOuter" weight="1"></join>
      </joinList>
