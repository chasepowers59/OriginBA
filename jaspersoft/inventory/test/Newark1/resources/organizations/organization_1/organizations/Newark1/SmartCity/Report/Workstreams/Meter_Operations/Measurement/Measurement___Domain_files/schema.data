      <filterString>F1_BUS_OBJ_L.LANGUAGE_CD == 'ENG' and F1_BUS_OBJ_STATUS_L.LANGUAGE_CD == 'ENG'</filterString>
      <joinInfo alias="D1_DVC" referenceId="D1_DVC"></joinInfo>
      <joinList>
        <join expr="D1_DVC.D1_DEVICE_ID == D1_DVC_CFG.D1_DEVICE_ID" left="D1_DVC" right="D1_DVC_CFG" type="leftOuter" weight="1"></join>
        <join expr="D1_DVC_CFG.DEVICE_CONFIG_ID == D1_INSTALL_EVT.DEVICE_CONFIG_ID" left="D1_DVC_CFG" right="D1_INSTALL_EVT" type="leftOuter" weight="1"></join>
        <join expr="D1_DVC.BUS_OBJ_CD == F1_BUS_OBJ_L.BUS_OBJ_CD and F1_BUS_OBJ_L.LANGUAGE_CD == 'ENG'" left="D1_DVC" right="F1_BUS_OBJ_L" type="inner" weight="1"></join>
        <join expr="D1_DVC.MANUFACTURER_CD == D1_MANUFACTURER_L.MANUFACTURER_CD and D1_MANUFACTURER_L.LANGUAGE_CD == 'ENG'" left="D1_DVC" right="D1_MANUFACTURER_L" type="leftOuter" weight="1"></join>
        <join expr="D1_DVC.MANUFACTURER_CD == D1_MODEL_L.MANUFACTURER_CD and D1_DVC.D1_MODEL_CD == D1_MODEL_L.D1_MODEL_CD and D1_MODEL_L.LANGUAGE_CD == 'ENG'" left="D1_DVC" right="D1_MODEL_L" type="leftOuter" weight="1"></join>
        <join expr="D1_DVC.D1_SPR_CD == D1_SPR_L.D1_SPR_CD and D1_SPR_L.LANGUAGE_CD == 'ENG'" left="D1_DVC" right="D1_SPR_L" type="leftOuter" weight="1"></join>
        <join expr="D1_DVC.IN_DATA_SHIFT_FLG == CI_LOOKUP_VAL_L.FIELD_VALUE and CI_LOOKUP_VAL_L.FIELD_NAME == 'IN_DATA_SHIFT_FLG' and CI_LOOKUP_VAL_L.LANGUAGE_CD == 'ENG'" left="D1_DVC" right="CI_LOOKUP_VAL_L" type="leftOuter" weight="1"></join>
        <join expr="D1_DVC.BUS_OBJ_CD == F1_BUS_OBJ_STATUS_L.BUS_OBJ_CD and D1_DVC.BO_STATUS_CD == F1_BUS_OBJ_STATUS_L.BO_STATUS_CD and F1_BUS_OBJ_STATUS_L.LANGUAGE_CD == 'ENG'" left="D1_DVC" right="F1_BUS_OBJ_STATUS_L" type="inner" weight="1"></join>
        <join expr="D1_DVC.BO_STATUS_REASON_CD == F1_BUS_OBJ_STATUS_RSN_L.BO_STATUS_REASON_CD and F1_BUS_OBJ_STATUS_RSN_L.LANGUAGE_CD == 'ENG'" left="D1_DVC" right="F1_BUS_OBJ_STATUS_RSN_L" type="leftOuter" weight="1"></join>
        <join expr="D1_DVC.ARMING_REQ_FLG == CI_LOOKUP_VAL_L_1.FIELD_VALUE and CI_LOOKUP_VAL_L_1.FIELD_NAME == 'ARMING_REQ_FLG' and CI_LOOKUP_VAL_L_1.LANGUAGE_CD == 'ENG'" left="D1_DVC" right="CI_LOOKUP_VAL_L_1" type="leftOuter" weight="1"></join>
        <join expr="D1_DVC.HEAD_END_REGISTR_STATUS_FLG == CI_LOOKUP_VAL_L_2.FIELD_VALUE and CI_LOOKUP_VAL_L_2.FIELD_NAME == 'HEAD_END_REGISTR_STATUS_FLG' and CI_LOOKUP_VAL_L_2.LANGUAGE_CD == 'ENG'" left="D1_DVC" right="CI_LOOKUP_VAL_L_2" type="leftOuter" weight="1"></join>
        <join expr="D1_DVC.D1_CMD_SET_CD == D1_COMMAND_SET_L.D1_CMD_SET_CD and D1_COMMAND_SET_L.LANGUAGE_CD == 'ENG'" left="D1_DVC" right="D1_COMMAND_SET_L" type="leftOuter" weight="1"></join>
        <join expr="D1_DVC.ACCESS_GRP_CD == CI_ACC_GRP_L.ACCESS_GRP_CD and CI_ACC_GRP_L.LANGUAGE_CD == 'ENG'" left="D1_DVC" right="CI_ACC_GRP_L" type="leftOuter" weight="1"></join>
        <join expr="D1_DVC.DEVICE_TYPE_CD == D1_DVC_TYPE_L.DEVICE_TYPE_CD and D1_DVC_TYPE_L.LANGUAGE_CD == 'ENG'" left="D1_DVC" right="D1_DVC_TYPE_L" type="inner" weight="1"></join>
        <join expr="D1_DVC_CFG.DEVICE_CONFIG_TYPE_CD == D1_DVC_CFG_TYPE_L.DEVICE_CONFIG_TYPE_CD and D1_DVC_CFG_TYPE_L.LANGUAGE_CD == 'ENG'" left="D1_DVC_CFG" right="D1_DVC_CFG_TYPE_L" type="leftOuter" weight="1"></join>
        <join expr="D1_DVC_CFG.BUS_OBJ_CD == F1_BUS_OBJ_STATUS_L_1.BUS_OBJ_CD and F1_BUS_OBJ_STATUS_L_1.LANGUAGE_CD == 'ENG' and D1_DVC_CFG.BO_STATUS_CD == F1_BUS_OBJ_STATUS_L_1.BO_STATUS_CD" left="D1_DVC_CFG" right="F1_BUS_OBJ_STATUS_L_1" type="leftOuter" weight="1"></join>
        <join expr="D1_DVC_CFG.TIME_ZONE_CD == CI_TIME_ZONE_L.TIME_ZONE_CD and CI_TIME_ZONE_L.LANGUAGE_CD == 'ENG'" left="D1_DVC_CFG" right="CI_TIME_ZONE_L" type="leftOuter" weight="1"></join>
        <join expr="D1_DVC_CFG.BUS_OBJ_CD == F1_BUS_OBJ_L_1.BUS_OBJ_CD and F1_BUS_OBJ_L_1.LANGUAGE_CD == 'ENG'" left="D1_DVC_CFG" right="F1_BUS_OBJ_L_1" type="leftOuter" weight="1"></join>
        <join expr="D1_DVC_CFG.BO_STATUS_REASON_CD == F1_BUS_OBJ_STATUS_RSN_L_1.BO_STATUS_REASON_CD and F1_BUS_OBJ_STATUS_RSN_L_1.LANGUAGE_CD == 'ENG'" left="D1_DVC_CFG" right="F1_BUS_OBJ_STATUS_RSN_L_1" type="leftOuter" weight="1"></join>
        <join expr="D1_DVC.D1_DEVICE_ID == CM_DVC_ACCT.D1_DEVICE_ID" left="D1_DVC" right="CM_DVC_ACCT" type="leftOuter" weight="1"></join>
        <join expr="CM_DVC_ACCT.ACCT_ID == CI_ACCT_PER.ACCT_ID and CI_ACCT_PER.MAIN_CUST_SW == 'Y'" left="CM_DVC_ACCT" right="CI_ACCT_PER" type="leftOuter" weight="1"></join>
        <join expr="CI_ACCT_PER.PER_ID == CI_PER_NAME.PER_ID and CI_PER_NAME.NAME_TYPE_FLG == 'PRIM'" left="CI_ACCT_PER" right="CI_PER_NAME" type="leftOuter" weight="1"></join>
        <join expr="D1_DVC.D1_DEVICE_ID == CMS_D1_DVC_CHAR_VW.D1_DEVICE_ID" left="D1_DVC" right="CMS_D1_DVC_CHAR_VW" type="leftOuter" weight="1"></join>
        <join expr="D1_DVC.D1_DEVICE_ID == CMS_D1_DVC_IDENTIFIER_VW.D1_DEVICE_ID" left="D1_DVC" right="CMS_D1_DVC_IDENTIFIER_VW" type="leftOuter" weight="1"></join>
        <join expr="CMS_D1_DVC_CHAR_VW.MXU_TYPE == CI_CHAR_VAL_L.CHAR_VAL and CI_CHAR_VAL_L.CHAR_TYPE_CD == 'CMCMXUTY' and CI_CHAR_VAL_L.LANGUAGE_CD == 'ENG'" left="CMS_D1_DVC_CHAR_VW" right="CI_CHAR_VAL_L" type="leftOuter" weight="1"></join>
