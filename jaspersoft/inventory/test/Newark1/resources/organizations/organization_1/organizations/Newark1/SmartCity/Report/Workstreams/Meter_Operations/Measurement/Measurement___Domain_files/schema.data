    <jdbcQuery id="CM_DVC_ACCT" datasourceId="Newark1_DS">
      <fieldList>
        <field id="D1_DEVICE_ID" type="java.lang.String"></field>
        <field id="DEVICE_CONFIG_ID" type="java.lang.String"></field>
        <field id="D1_SP_ID" type="java.lang.String"></field>
        <field id="SP_ID" type="java.lang.String"></field>
        <field id="ACCT_ID" type="java.lang.String"></field>
      </fieldList>
      <query>select
  distinct dvcfg.d1_device_id, dvcfg.device_config_id, ievt.d1_sp_id, spid.id_value as sp_id, sa.acct_id
from 
  cisadm.d1_dvc_cfg dvcfg,
  cisadm.d1_install_evt ievt,
  cisadm.d1_sp_identifier spid,
  cisadm.ci_sa_sp sasp,
  cisadm.ci_sa sa
where 
  dvcfg.bo_status_cd = 'ACTIVE'
  and dvcfg.device_config_id = ievt.device_config_id
  and ievt.d1_sp_id = spid.d1_sp_id
  and spid.sp_id_type_flg = 'D1EI'
  and spid.id_value = sasp.sp_id
  and sasp.sa_id = sa.sa_id
  and sa.sa_status_flg in ('10','20','30','40','50')</query>
    </jdbcQuery>
