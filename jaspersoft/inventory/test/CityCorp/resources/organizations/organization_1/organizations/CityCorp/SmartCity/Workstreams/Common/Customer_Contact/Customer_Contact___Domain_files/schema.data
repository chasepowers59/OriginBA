        <field id="CI_CC_CL_L.DESCR" type="java.lang.String"></field>
        <field id="CC_ID_DIST" dataSetExpression="CountDistinct(CI_CC.CC_ID, 'Current')" type="java.lang.Long"></field>
        <field id="DAYS_OLD" dataSetExpression="ElapsedDays(Today(0), CI_CC.CC_DTTM)" type="java.math.BigDecimal"></field>
        <field id="USER_ID_NAME" dataSetExpression="Concatenate(SC_USER.FIRST_NAME, ' ', SC_USER.LAST_NAME)" type="java.lang.String"></field>
      </fieldList>
      <filterString>CI_CC_TYPE_L.LANGUAGE_CD == 'ENG' and CI_LOOKUP_VAL_L.LANGUAGE_CD == 'ENG' and CI_LOOKUP_VAL_L.FIELD_NAME == 'CC_ENTITY_FLG                 ' and CI_CC_CL_L.LANGUAGE_CD == 'ENG'</filterString>
      <joinInfo alias="CI_CC" referenceId="CI_CC"></joinInfo>
      <joinList>
        <join expr="CI_CC.CC_CL_CD == CI_CC_CL_L.CC_CL_CD and CI_CC_CL_L.LANGUAGE_CD == 'ENG'" left="CI_CC" right="CI_CC_CL_L" type="inner" weight="1"></join>
        <join expr="CI_CC.CC_CL_CD == CI_CC_TYPE_L.CC_CL_CD and CI_CC.CC_TYPE_CD == CI_CC_TYPE_L.CC_TYPE_CD and CI_CC_TYPE_L.LANGUAGE_CD == 'ENG'" left="CI_CC" right="CI_CC_TYPE_L" type="inner" weight="1"></join>
        <join expr="CI_CC.CC_ENTITY_FLG == CI_LOOKUP_VAL_L.FIELD_VALUE and CI_LOOKUP_VAL_L.FIELD_NAME == 'CC_ENTITY_FLG' and CI_LOOKUP_VAL_L.LANGUAGE_CD == 'ENG'" left="CI_CC" right="CI_LOOKUP_VAL_L" type="leftOuter" weight="1"></join>
        <join expr="CI_CC.PER_ID == CI_PER_PRIM_VW.PER_ID" left="CI_CC" right="CI_PER_PRIM_VW" type="inner" weight="1"></join>
        <join expr="CI_CC.USER_ID == SC_USER.USER_ID" left="CI_CC" right="SC_USER" type="inner" weight="1"></join>
      </joinList>
      <joinOptions></joinOptions>
      <tableRefList>
        <tableRef alwaysIncludeTable="false" tableAlias="CI_CC_CL_L" tableId="CI_CC_CL_L"></tableRef>
        <tableRef alwaysIncludeTable="false" tableAlias="CI_PER_PRIM_VW" tableId="CI_PER_PRIM_VW"></tableRef>
        <tableRef alwaysIncludeTable="false" tableAlias="SC_USER" tableId="SC_USER"></tableRef>
        <tableRef alwaysIncludeTable="false" tableAlias="CI_CC" tableId="CI_CC"></tableRef>
        <tableRef alwaysIncludeTable="false" tableAlias="CI_LOOKUP_VAL_L" tableId="CI_LOOKUP_VAL_L"></tableRef>
        <tableRef alwaysIncludeTable="false" tableAlias="CI_CC_TYPE_L" tableId="CI_CC_TYPE_L"></tableRef>
      </tableRefList>
    </jdbcTable>
  </resources>
</schema>
