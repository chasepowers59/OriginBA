      <joinInfo alias="CI_BILL" referenceId="CI_BILL"></joinInfo>
      <joinList>
        <join expr="CI_BILL.BILL_ID == CI_FT.BILL_ID and CI_BILL.BILL_STAT_FLG == 'C' and CI_FT.FREEZE_SW == 'Y' and CI_FT.FT_TYPE_FLG in ('BS', 'BX')" left="CI_BILL" right="CI_FT" type="inner" weight="1"></join>
        <join expr="CI_FT.SIBLING_ID == CI_BSEG.BSEG_ID" left="CI_FT" right="CI_BSEG" type="inner" weight="1"></join>
        <join expr="CI_BSEG_SQ.BSEG_ID == CI_BSEG.BSEG_ID and CI_BSEG_SQ.UOM_CD != ' ' and CI_BSEG_SQ.TOU_CD == ' ' and CI_BSEG_SQ.SQI_CD == ' '" left="CI_BSEG_SQ" right="CI_BSEG" type="inner" weight="1"></join>
        <join expr="CI_SA.SA_ID == CI_BSEG.SA_ID" left="CI_SA" right="CI_BSEG" type="inner" weight="1"></join>
        <join expr="CI_PREM.PREM_ID == CI_SA.CHAR_PREM_ID" left="CI_PREM" right="CI_SA" type="inner" weight="1"></join>
        <join expr="CI_ACCT.ACCT_ID == CI_BILL.ACCT_ID" left="CI_ACCT" right="CI_BILL" type="inner" weight="1"></join>
        <join expr="CI_SA.ACCT_ID == CI_ACCT.ACCT_ID" left="CI_SA" right="CI_ACCT" type="inner" weight="1"></join>
        <join expr="CI_CUST_CL_L.LANGUAGE_CD == 'ENG' and CI_CUST_CL_L.CUST_CL_CD == CI_ACCT.CUST_CL_CD" left="CI_CUST_CL_L" right="CI_ACCT" type="inner" weight="1"></join>
        <join expr="CI_PREM_CHAR.PREM_ID == CI_PREM.PREM_ID and CI_PREM_CHAR.CHAR_TYPE_CD == 'CTYLIMIT'" left="CI_PREM_CHAR" right="CI_PREM" type="rightOuter" weight="1"></join>
      </joinList>
      <joinOptions includeAllDataIslandJoins="true"></joinOptions>
