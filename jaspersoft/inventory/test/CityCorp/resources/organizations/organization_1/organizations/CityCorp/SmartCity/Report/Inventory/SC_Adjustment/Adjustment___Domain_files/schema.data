        <join expr="CI_ADJ.ADJ_STATUS_FLG == CI_LOOKUP_VAL_L.FIELD_VALUE and CI_LOOKUP_VAL_L.FIELD_NAME == 'ADJ_STATUS_FLG' and CI_LOOKUP_VAL_L.LANGUAGE_CD == 'ENG'" left="CI_ADJ" right="CI_LOOKUP_VAL_L" type="inner" weight="1"></join>
        <join expr="CI_ADJ.CAN_RSN_CD == CI_ADJ_CAN_RSN_L.CAN_RSN_CD and CI_ADJ_CAN_RSN_L.LANGUAGE_CD == 'ENG'" left="CI_ADJ" right="CI_ADJ_CAN_RSN_L" type="leftOuter" weight="1"></join>
        <join expr="CI_ADJ.ADJ_ID == CI_ADJ_APREQ.ADJ_ID" left="CI_ADJ" right="CI_ADJ_APREQ" type="leftOuter" weight="1"></join>
        <join expr="CI_ADJ_APREQ.PYMNT_SEL_STAT_FLG == CI_LOOKUP_VAL_L_1.FIELD_VALUE and CI_LOOKUP_VAL_L_1.FIELD_NAME == 'PYMNT_SEL_STAT_FLG' and CI_LOOKUP_VAL_L_1.LANGUAGE_CD == 'ENG'" left="CI_ADJ_APREQ" right="CI_LOOKUP_VAL_L_1" type="leftOuter" weight="1"></join>
