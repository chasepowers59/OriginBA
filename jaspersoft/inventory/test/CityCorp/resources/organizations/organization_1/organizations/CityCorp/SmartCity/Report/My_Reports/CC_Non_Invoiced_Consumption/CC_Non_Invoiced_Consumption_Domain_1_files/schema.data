    <jdbcQuery id="NON_INVOICED_USG" datasourceId="CityCorp_DS">
      <fieldList>
        <field id="MEASR_COMP_ID" type="java.lang.String"></field>
        <field id="MSRMT_DTTM" type="java.sql.Timestamp"></field>
        <field id="READING_VAL" type="java.math.BigDecimal"></field>
        <field id="MSRMT_VAL" type="java.math.BigDecimal"></field>
      </fieldList>
      <query>SELECT  M.MEASR_COMP_ID    AS "MEASR_COMP_ID",
        M.MSRMT_LOCAL_DTTM AS "MSRMT_DTTM",
        M.READING_VAL      AS "READING_VAL",
        M.MSRMT_VAL        AS "MSRMT_VAL"
FROM    CISADM.D1_MSRMT M
        JOIN CISADM.D1_MEASR_COMP MC
          ON M.MEASR_COMP_ID = MC.MEASR_COMP_ID
        LEFT JOIN CISADM.D1_INSTALL_EVT IE
          ON MC.DEVICE_CONFIG_ID = IE.DEVICE_CONFIG_ID
        INNER JOIN CISADM.D1_SP_IDENTIFIER D1SP
          ON IE.D1_SP_ID = D1SP.D1_SP_ID
          AND D1SP.SP_ID_TYPE_FLG = 'D1EI'
WHERE   M.MSRMT_USE_FLG &lt;&gt; 'D101'
        AND NOT EXISTS (SELECT 1 
              FROM (SELECT SP_ID, 
                           START_READ_DTTM AS READ_DTTM,
                           START_REG_READING AS READING_VAL
                    FROM   CISADM.CI_BSEG_READ
                    WHERE  TRIM(SP_ID) IS NOT NULL AND
                           TRIM(UOM_CD) IS NOT NULL AND
                           TRIM(TOU_CD) IS NULL AND 
                           TRIM(SQI_CD) IS NULL
                    UNION ALL
                    SELECT SP_ID,
                           END_READ_DTTM AS READ_DTTM,
                           END_REG_READING AS READING_VAL
                    FROM   CISADM.CI_BSEG_READ
                    WHERE  TRIM(SP_ID) IS NOT NULL AND
                           TRIM(UOM_CD) IS NOT NULL AND
                           TRIM(TOU_CD) IS NULL AND 
                           TRIM(SQI_CD) IS NULL) X
              WHERE D1SP.ID_VALUE = X.SP_ID
                    AND X.READ_DTTM = M.MSRMT_LOCAL_DTTM
                    AND X.READING_VAL = M.READING_VAL)</query>
    </jdbcQuery>
    <jdbcQuery id="SA_AND_STATUS" datasourceId="CityCorp_DS">
      <fieldList>
        <field id="SA_ID" type="java.lang.String"></field>
        <field id="SA_STATUS" type="java.lang.String"></field>
      </fieldList>
      <query>select SA_ID, 
       CASE SA_STATUS_FLG
       WHEN '05' THEN 'Incomplete'
       WHEN '10' THEN 'Pending Start'
       WHEN '20' THEN 'Active'
       WHEN '30' THEN 'Pending Stop'
       WHEN '40' THEN 'Stopped'
       WHEN '50' THEN 'Reactivated'
       WHEN '60' THEN 'Closed'
       ELSE 'Canceled'
       END AS SA_STATUS
from cisadm.ci_sa</query>
    </jdbcQuery>
