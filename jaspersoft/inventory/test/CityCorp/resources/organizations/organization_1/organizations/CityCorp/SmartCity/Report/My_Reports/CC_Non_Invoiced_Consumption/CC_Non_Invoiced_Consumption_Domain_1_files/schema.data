      <filterString>CI_SA_TYPE.SVC_TYPE_CD in ('S', 'W', 'WW')</filterString>
      <joinInfo alias="D1_MEASR_COMP" referenceId="D1_MEASR_COMP"></joinInfo>
      <joinList>
        <join expr="D1_MEASR_COMP.DEVICE_CONFIG_ID == D1_DVC_CFG.DEVICE_CONFIG_ID" left="D1_MEASR_COMP" right="D1_DVC_CFG" type="leftOuter" weight="1"></join>
        <join expr="D1_DVC_CFG.DEVICE_CONFIG_ID == D1_INSTALL_EVT.DEVICE_CONFIG_ID" left="D1_DVC_CFG" right="D1_INSTALL_EVT" type="leftOuter" weight="1"></join>
        <join expr="D1_INSTALL_EVT.D1_SP_ID == D1_SP_IDENTIFIER.D1_SP_ID" left="D1_INSTALL_EVT" right="D1_SP_IDENTIFIER" type="inner" weight="1"></join>
        <join expr="D1_SP_IDENTIFIER.ID_VALUE == CI_SP.SP_ID and D1_SP_IDENTIFIER.SP_ID_TYPE_FLG == 'D1EI'" left="D1_SP_IDENTIFIER" right="CI_SP" type="inner" weight="1"></join>
        <join expr="CI_SP.PREM_ID == CI_PREM.PREM_ID" left="CI_SP" right="CI_PREM" type="inner" weight="1"></join>
        <join expr="CI_PREM.PREM_ID == CI_SA.CHAR_PREM_ID" left="CI_PREM" right="CI_SA" type="leftOuter" weight="1"></join>
        <join expr="CI_SA.ACCT_ID == CI_ACCT.ACCT_ID" left="CI_SA" right="CI_ACCT" type="inner" weight="1"></join>
        <join expr="CI_ACCT.ACCT_ID == CI_ACCT_PER.ACCT_ID and CI_ACCT_PER.MAIN_CUST_SW == 'Y'" left="CI_ACCT" right="CI_ACCT_PER" type="inner" weight="1"></join>
        <join expr="CI_ACCT_PER.PER_ID == CI_PER_NAME.PER_ID and CI_PER_NAME.PRIM_NAME_SW == 'Y'" left="CI_ACCT_PER" right="CI_PER_NAME" type="inner" weight="1"></join>
        <join expr="NON_INVOICED_USG.MEASR_COMP_ID == D1_MEASR_COMP.MEASR_COMP_ID" left="NON_INVOICED_USG" right="D1_MEASR_COMP" type="inner" weight="1"></join>
        <join expr="CI_SA.SA_TYPE_CD == CI_SA_TYPE.SA_TYPE_CD" left="CI_SA" right="CI_SA_TYPE" type="inner" weight="1"></join>
        <join expr="SA_AND_STATUS.SA_ID == CI_SA.SA_ID" left="SA_AND_STATUS" right="CI_SA" type="inner" weight="1"></join>
      </joinList>
