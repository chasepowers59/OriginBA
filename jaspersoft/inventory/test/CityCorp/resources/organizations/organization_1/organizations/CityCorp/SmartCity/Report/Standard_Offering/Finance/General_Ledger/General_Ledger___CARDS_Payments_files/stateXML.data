  <subFilterList>
    <subFilter id="filter_1" letter="A" sourceString="DYNAMIC">
      <expressionString>ACCT_SERVICE.SA_TYPE_DESC == 'Sanitation CARDS Charges'</expressionString>
      <parameterizedExpressionString>ACCT_SERVICE.SA_TYPE_DESC == SA_TYPE_DESC_1</parameterizedExpressionString>
    </subFilter>
    <subFilter id="filter_2" letter="B" sourceString="DYNAMIC">
      <expressionString>betweenDates(FT_CORE.ACCOUNTING_DT, ts'2026-07-01', ts'2026-07-20')</expressionString>
      <parameterizedExpressionString>betweenDates(FT_CORE.ACCOUNTING_DT, ACCOUNTING_DT_1, ACCOUNTING_DT_2)</parameterizedExpressionString>
    </subFilter>
    <subFilter id="filter_3" letter="C" sourceString="DYNAMIC">
      <expressionString>FT_CORE.CIS_DIVISION == 'WM   '</expressionString>
      <parameterizedExpressionString>FT_CORE.CIS_DIVISION == CIS_DIVISION_1</parameterizedExpressionString>
    </subFilter>
    <subFilter id="filter_4" letter="D" sourceString="DYNAMIC">
      <expressionString>isAnyValue(SNAPSHOT_AUDIT.BATCH_NBR)</expressionString>
      <parameterizedExpressionString>SNAPSHOT_AUDIT.BATCH_NBR in BATCH_NBR_1</parameterizedExpressionString>
    </subFilter>
    <subFilter id="filter_5" letter="E" sourceString="DYNAMIC">
      <expressionString>GL_LINE.DST_DESC == 'Accounts Receivable - CARDS'</expressionString>
      <parameterizedExpressionString>GL_LINE.DST_DESC == DST_DESC_1</parameterizedExpressionString>
