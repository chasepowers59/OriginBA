    <item id="Description" label="Description" resourceId="CC_LL_DETAILS.Description"></item>
    <item id="Inside_City?" label="Inside City" resourceId="CC_LL_DETAILS.Inside_City?"></item>
    <item id="Landlord_ID" label="Landlord ID" resourceId="CC_LL_DETAILS.Landlord_ID"></item>
    <item id="Landlord_Name" label="Landlord Name" resourceId="CC_LL_DETAILS.Landlord_Name"></item>
    <item id="Life_Support_Sensitive_Load_Details" label="Life Support Sensitive Load Details" resourceId="CC_LL_DETAILS.Life_Support_Sensitive_Load_Details"></item>
    <item id="Life_Support_Sensitive_Load?" label="Life Support / Sensitive Load" resourceId="CC_LL_DETAILS.Life_Support_Sensitive_Load?"></item>
