    <item id="Premise_Type_Description" label="Premise Type Description" resourceId="CC_LL_DETAILS.Premise_Type_Description"></item>
    <item id="Sanitation_Covered?" label="Sanitation Covered" resourceId="CC_LL_DETAILS.Sanitation_Covered?"></item>
    <item id="Sanitation_End_Date" label="Sanitation End Date" resourceId="CC_LL_DETAILS.Sanitation_End_Date"></item>
