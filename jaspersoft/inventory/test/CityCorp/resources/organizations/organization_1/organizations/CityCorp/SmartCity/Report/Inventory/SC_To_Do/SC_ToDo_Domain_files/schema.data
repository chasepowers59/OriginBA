        <field id="CI_MSG_L.DESCRLONG_OVRD" type="java.lang.String"></field>
        <field id="CI_MSG_L.MESSAGE_TEXT_OVRD" type="java.lang.String"></field>
        <field id="CI_MSG_L.OWNER_FLG" type="java.lang.String"></field>
        <field id="CI_TD_TYPE.TD_TYPE_CD" type="java.lang.String"></field>
        <field id="CI_TD_TYPE.CRE_BATCH_CD" type="java.lang.String"></field>
        <field id="CI_TD_TYPE.MESSAGE_CAT_NBR" type="java.math.BigDecimal"></field>
        <field id="CI_TD_TYPE.MESSAGE_NBR" type="java.math.BigDecimal"></field>
        <field id="CI_TD_TYPE.RTE_BATCH_CD" type="java.lang.String"></field>
        <field id="CI_TD_TYPE.VERSION" type="java.math.BigDecimal"></field>
        <field id="CI_TD_TYPE.OWNER_FLG" type="java.lang.String"></field>
        <field id="CI_TD_TYPE.TD_USAGE_TYPE_FLG" type="java.lang.String"></field>
