    <jdbcTable id="CI_TD_SRTKEY_TY" datasourceId="CityCorp_DS" datasourceTableName="CI_TD_SRTKEY_TY" schemaAlias="CISADM">
      <fieldList>
        <field id="TD_TYPE_CD" type="java.lang.String"></field>
