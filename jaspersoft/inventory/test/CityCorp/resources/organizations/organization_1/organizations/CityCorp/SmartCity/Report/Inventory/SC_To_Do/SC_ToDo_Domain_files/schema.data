    <jdbcTable id="CI_TD_DRLKEY_TY" datasourceId="CityCorp_DS" datasourceTableName="CI_TD_DRLKEY_TY" schemaAlias="CISADM">
      <fieldList>
        <field id="TD_TYPE_CD" type="java.lang.String"></field>
        <field id="SEQ_NUM" type="java.math.BigDecimal"></field>
        <field id="FLD_NAME" type="java.lang.String"></field>
        <field id="TBL_NAME" type="java.lang.String"></field>
        <field id="VERSION" type="java.math.BigDecimal"></field>
        <field id="OWNER_FLG" type="java.lang.String"></field>
      </fieldList>
    </jdbcTable>
    <jdbcTable id="CI_TD_DRLKEY" datasourceId="CityCorp_DS" datasourceTableName="CI_TD_DRLKEY" schemaAlias="CISADM">
      <fieldList>
        <field id="TD_ENTRY_ID" type="java.lang.String"></field>
        <field id="SEQ_NUM" type="java.math.BigDecimal"></field>
        <field id="KEY_VALUE" type="java.lang.String"></field>
        <field id="VERSION" type="java.math.BigDecimal"></field>
      </fieldList>
    </jdbcTable>
    <jdbcQuery id="DRILL_KEY_INFO" datasourceId="CityCorp_DS">
      <fieldList>
        <field id="TD_ENTRY_ID" type="java.lang.String"></field>
        <field id="FLD_NAME" type="java.lang.String"></field>
        <field id="KEY_VALUE" type="java.lang.String"></field>
      </fieldList>
      <query>SELECT TD.TD_ENTRY_ID, 
LISTAGG(
        TRIM(TDKTY.FLD_NAME),
        ','
    ) WITHIN GROUP(
    ORDER BY
        TDKTY.SEQ_NUM
    ) AS FLD_NAME,
LISTAGG(
        TRIM(TDK.KEY_VALUE),
        ','
    ) WITHIN GROUP(
    ORDER BY
        TDK.SEQ_NUM
    ) AS KEY_VALUE
FROM CISADM.CI_TD_ENTRY TD
INNER JOIN CISADM.CI_TD_DRLKEY TDK ON TDK.TD_ENTRY_ID = TD.TD_ENTRY_ID 
INNER JOIN CISADM.CI_TD_DRLKEY_TY TDKTY ON TDKTY.TD_TYPE_CD = TD.TD_TYPE_CD AND TDK.SEQ_NUM = TDKTY.SEQ_NUM 
GROUP BY TD.TD_ENTRY_ID</query>
    </jdbcQuery>
    <jdbcTable id="JoinTree_1" datasourceId="CityCorp_DS" datasourceTableName="CI_TD_ENTRY" schemaAlias="CISADM">
      <fieldList>
