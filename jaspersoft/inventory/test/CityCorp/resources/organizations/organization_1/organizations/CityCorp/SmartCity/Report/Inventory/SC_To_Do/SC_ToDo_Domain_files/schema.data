        <field id="CI_TD_SRTKEY.VERSION" type="java.math.BigDecimal"></field>
        <field id="CI_MSG_L.MESSAGE_CAT_NBR" type="java.math.BigDecimal"></field>
        <field id="CI_MSG_L.MESSAGE_NBR" type="java.math.BigDecimal"></field>
        <field id="CI_MSG_L.LANGUAGE_CD" type="java.lang.String"></field>
        <field id="CI_MSG_L.MESSAGE_TEXT" type="java.lang.String"></field>
        <field id="CI_MSG_L.DESCRLONG" type="java.lang.String"></field>
