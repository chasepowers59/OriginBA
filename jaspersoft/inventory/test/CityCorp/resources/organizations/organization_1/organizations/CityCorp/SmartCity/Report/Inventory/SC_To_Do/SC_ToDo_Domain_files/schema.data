        <field id="CI_TD_SRTKEY_TY.TD_TYPE_CD" type="java.lang.String"></field>
        <field id="CI_TD_SRTKEY_TY.SEQ_NUM" type="java.math.BigDecimal"></field>
        <field id="CI_TD_SRTKEY_TY.VERSION" type="java.math.BigDecimal"></field>
        <field id="CI_TD_SRTKEY_TY.DEFAULT_SW" type="java.lang.String"></field>
        <field id="CI_TD_SRTKEY_TY.ORDER_FLG" type="java.lang.String"></field>
        <field id="CI_TD_SRTKEY_TY.OWNER_FLG" type="java.lang.String"></field>
        <field id="DRILL_KEY_INFO.TD_ENTRY_ID" type="java.lang.String"></field>
        <field id="DRILL_KEY_INFO.FLD_NAME" type="java.lang.String"></field>
        <field id="DRILL_KEY_INFO.KEY_VALUE" type="java.lang.String"></field>
      </fieldList>
      <filterString>CI_TD_TYPE_L.LANGUAGE_CD == 'ENG' and CI_MSG_L.LANGUAGE_CD == 'ENG'</filterString>
      <joinInfo alias="CI_TD_ENTRY" referenceId="CI_TD_ENTRY"></joinInfo>
      <joinList>
        <join expr="CI_TD_ENTRY.TD_TYPE_CD == CI_TD_TYPE.TD_TYPE_CD" left="CI_TD_ENTRY" right="CI_TD_TYPE" type="inner" weight="1"></join>
        <join expr="CI_TD_TYPE.TD_TYPE_CD == CI_TD_TYPE_L.TD_TYPE_CD" left="CI_TD_TYPE" right="CI_TD_TYPE_L" type="inner" weight="1"></join>
        <join expr="CI_TD_SRTKEY_TY.TD_TYPE_CD == CI_TD_TYPE.TD_TYPE_CD and CI_TD_SRTKEY_TY.DEFAULT_SW == 'Y'" left="CI_TD_SRTKEY_TY" right="CI_TD_TYPE" type="inner" weight="1"></join>
        <join expr="CI_TD_SRTKEY.TD_ENTRY_ID == CI_TD_ENTRY.TD_ENTRY_ID" left="CI_TD_SRTKEY" right="CI_TD_ENTRY" type="inner" weight="1"></join>
        <join expr="CI_TD_SRTKEY.SEQ_NUM == CI_TD_SRTKEY_TY.SEQ_NUM" left="CI_TD_SRTKEY" right="CI_TD_SRTKEY_TY" type="inner" weight="1"></join>
        <join expr="CI_MSG_L.MESSAGE_CAT_NBR == CI_TD_ENTRY.MESSAGE_CAT_NBR and CI_MSG_L.MESSAGE_NBR == CI_TD_ENTRY.MESSAGE_NBR" left="CI_MSG_L" right="CI_TD_ENTRY" type="inner" weight="1"></join>
        <join expr="DRILL_KEY_INFO.TD_ENTRY_ID == CI_TD_ENTRY.TD_ENTRY_ID" left="DRILL_KEY_INFO" right="CI_TD_ENTRY" type="inner" weight="1"></join>
      </joinList>
      <joinOptions includeAllDataIslandJoins="true"></joinOptions>
      <tableRefList>
        <tableRef alwaysIncludeTable="false" tableAlias="CI_TD_TYPE_L" tableId="CI_TD_TYPE_L"></tableRef>
        <tableRef alwaysIncludeTable="false" tableAlias="CI_MSG_L" tableId="CI_MSG_L"></tableRef>
        <tableRef alwaysIncludeTable="false" tableAlias="CI_TD_TYPE" tableId="CI_TD_TYPE"></tableRef>
        <tableRef alwaysIncludeTable="false" tableAlias="CI_TD_ENTRY" tableId="CI_TD_ENTRY"></tableRef>
        <tableRef alwaysIncludeTable="false" tableAlias="CI_TD_SRTKEY_TY" tableId="CI_TD_SRTKEY_TY"></tableRef>
        <tableRef alwaysIncludeTable="false" tableAlias="DRILL_KEY_INFO" tableId="DRILL_KEY_INFO"></tableRef>
        <tableRef alwaysIncludeTable="false" tableAlias="CI_TD_SRTKEY" tableId="CI_TD_SRTKEY"></tableRef>
      </tableRefList>
    </jdbcTable>
  </resources>
