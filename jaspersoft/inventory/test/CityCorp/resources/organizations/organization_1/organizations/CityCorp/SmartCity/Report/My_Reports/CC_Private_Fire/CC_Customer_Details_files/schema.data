        <field id="CHAR_VAL_FK4" type="java.lang.String"></field>
        <field id="CHAR_VAL_FK5" type="java.lang.String"></field>
        <field id="SRCH_CHAR_VAL" type="java.lang.String"></field>
      </fieldList>
      <query>SELECT
PREM.PREM_ID,  
PREM.PREM_TYPE_CD,  
PREM.CIS_DIVISION,  
PREM.LL_ID,  
PREM.KEY_SW,  
PREM.KEY_ID,  
PREM.OK_TO_ENTER_SW,  
PREM.MR_INSTR_CD,  
PREM.MR_INSTR_DETAILS,  
PREM.MR_WARN_CD,  
PREM.TREND_AREA_CD,  
PREM.ADDRESS1,  
PREM.ADDRESS2,  
PREM.ADDRESS3,  
PREM.ADDRESS4,  
PREM.MAIL_ADDR_SW,  
PREM.CITY,  
PREM.NUM1,  
PREM.NUM2,  
PREM.COUNTY,  
PREM.POSTAL,  
PREM.HOUSE_TYPE,  
PREM.GEO_CODE,  
PREM.IN_CITY_LIMIT,  
PREM.STATE ,  
PREM.COUNTRY,   
PREM.ADDRESS1_UPR,  
PREM.CITY_UPR,  
PREM.LS_SL_FLG,  
PREM.LS_SL_DESCR,  
PREM.PRNT_PREM_ID,  
PREM.PREM_DATA_AREA, 
SPID.D1_SP_ID, 
SPID.SP_ID_TYPE_FLG, 
SPID.ID_VALUE, 
IE.INSTALL_EVT_ID, 
IE.D1_INSTALL_DTTM, 
IE.D1_REMOVAL_DTTM, 
IE.INSTALLATION_CONST, 
IE.BUS_OBJ_CD IE_BUS_OBJ_CD, 
IE.BO_STATUS_CD IE_BO_STATUS_CD, 
IE.BO_STATUS_REASON_CD IE_BO_STATUS_REASON_CD, 
IE.STATUS_UPD_DTTM IE_STATUS_UPD_DTTM, 
IE.CRE_DTTM IE_CRE_DTTM, 
IE.ARM_STAT_FLG, 
IE.BO_DATA_AREA IE_BO_DATA_AREA, 
DC.DEVICE_CONFIG_ID,
DC.DEVICE_CONFIG_TYPE_CD,
DC.BUS_OBJ_CD DC_BUS_OBJ_CD,
DC.D1_DEVICE_ID,
DC.EFF_DTTM,
DC.TIME_ZONE_CD,
DC.BO_STATUS_CD DC_BO_STATUS_CD,
DC.STATUS_UPD_DTTM DC_STATUS_UPD_DTTM,
DC.BO_STATUS_REASON_CD DC_BO_STATUS_REASON_CD,
DC.CRE_DTTM DC_CRE_DTTM,
DC.BO_DATA_AREA DC_BO_DATA_AREA,
SPCH.CHAR_TYPE_CD, 
SPCH.EFFDT, 
SPCH.CHAR_VAL, 
SPCH.ADHOC_CHAR_VAL, 
SPCH.CHAR_VAL_FK1, 
SPCH.CHAR_VAL_FK2, 
SPCH.CHAR_VAL_FK3, 
SPCH.CHAR_VAL_FK4, 
SPCH.CHAR_VAL_FK5, 
SPCH.SRCH_CHAR_VAL
FROM CISADM.CI_PREM PREM 
INNER JOIN CISADM.D1_SP_IDENTIFIER SPID ON SPID.SP_ID_TYPE_FLG = 'D1EP' AND SPID.ID_VALUE = PREM.PREM_ID
INNER JOIN CISADM.D1_INSTALL_EVT IE ON IE.D1_SP_ID = SPID.D1_SP_ID AND (IE.D1_REMOVAL_DTTM IS NULL OR IE.D1_REMOVAL_DTTM &gt; SYSDATE)
INNER JOIN CISADM.D1_DVC_CFG DC ON DC.DEVICE_CONFIG_ID = IE.DEVICE_CONFIG_ID
LEFT JOIN CISADM.D1_SP_CHAR SPCH ON SPCH.D1_SP_ID = SPID.D1_SP_ID
    AND SPCH.EFFDT = (SELECT MAX(SPCH1.EFFDT) 
                    FROM CISADM.D1_SP_CHAR SPCH1 
                    WHERE SPCH1.D1_SP_ID = SPCH.D1_SP_ID 
                    AND SPCH1.CHAR_TYPE_CD = SPCH.CHAR_TYPE_CD
                    AND SPCH1.EFFDT &lt;= SYSDATE)</query>
    </jdbcQuery>
