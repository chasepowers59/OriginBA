      <joinInfo alias="CI_SA" referenceId="CI_SA"></joinInfo>
      <joinList>
        <join expr="CI_SA.ACCT_ID == CI_ACCT.ACCT_ID and not (CI_SA.SA_STATUS_FLG in ('50', '60', '70'))" left="CI_SA" right="CI_ACCT" type="inner" weight="1"></join>
        <join expr="CI_ACCT_PER.ACCT_ID == CI_SA.ACCT_ID and CI_ACCT_PER.MAIN_CUST_SW == 'Y'" left="CI_ACCT_PER" right="CI_SA" type="inner" weight="1"></join>
        <join expr="CI_PER_NAME.PER_ID == CI_ACCT_PER.PER_ID and CI_PER_NAME.PRIM_NAME_SW == 'Y'" left="CI_PER_NAME" right="CI_ACCT_PER" type="inner" weight="1"></join>
        <join expr="V_RIGHT_SIDE.PREM_ID == CI_SA.CHAR_PREM_ID" left="V_RIGHT_SIDE" right="CI_SA" type="inner" weight="1"></join>
