  <resources>
    <jdbcQuery id="BILL_DATA" datasourceId="CityCorp_DS">
      <fieldList>
        <field id="PER_ID" type="java.lang.String"></field>
        <field id="ACCT_ID" type="java.lang.String"></field>
        <field id="ENTITY_NAME" type="java.lang.String"></field>
        <field id="PREM_ID" type="java.lang.String"></field>
        <field id="ADDRESS1" type="java.lang.String"></field>
        <field id="BILL_ID" type="java.lang.String"></field>
        <field id="SP_ID" type="java.lang.String"></field>
        <field id="START_READ_DTTM" type="java.sql.Timestamp"></field>
        <field id="END_READ_DTTM" type="java.sql.Timestamp"></field>
        <field id="FINAL_REG_QTY" type="java.math.BigDecimal"></field>
        <field id="BILL_DT" type="java.sql.Timestamp"></field>
        <field id="BILL_CYC_CD" type="java.lang.String"></field>
      </fieldList>
      <query>SELECT DISTINCT AP.PER_ID, ACT.ACCT_ID, PN.ENTITY_NAME, PREM.PREM_ID, PREM.ADDRESS1, B.BILL_ID, B.BILL_DT, B.BILL_CYC_CD, BSR.SP_ID, BSR.START_READ_DTTM, BSR.END_READ_DTTM, BSR.FINAL_REG_QTY
FROM CISADM.CI_BILL B
INNER JOIN CISADM.CI_FT FT ON FT.BILL_ID = B.BILL_ID AND FT.FT_TYPE_FLG IN ('BS','BX') AND FT.FREEZE_SW = 'Y'
INNER JOIN CISADM.CI_BSEG BS ON BS.BSEG_ID = FT.SIBLING_ID
INNER JOIN CISADM.CI_BSEG_READ BSR ON BSR.BSEG_ID = BS.BSEG_ID AND BSR.USAGE_FLG = 'X' AND BSR.SP_ID != ' ' AND BSR.UOM_CD = 'TGAL' AND BSR.TOU_CD = ' ' AND BSR.SQI_CD = ' '
INNER JOIN CISADM.CI_ACCT ACT ON ACT.ACCT_ID = B.ACCT_ID
INNER JOIN CISADM.CI_ACCT_PER AP ON AP.ACCT_ID = ACT.ACCT_ID AND AP.MAIN_CUST_SW = 'Y'
INNER JOIN CISADM.CI_PER_NAME PN ON PN.PER_ID = AP.PER_ID AND PN.PRIM_NAME_SW = 'Y'
INNER JOIN CISADM.CI_SA SA ON SA.ACCT_ID = ACT.ACCT_ID AND SA.SA_ID = BS.SA_ID
INNER JOIN CISADM.CI_PREM PREM ON PREM.PREM_ID = SA.CHAR_PREM_ID
WHERE B.BILL_STAT_FLG = 'C'</query>
    </jdbcQuery>
    <jdbcQuery id="MSRMT_DATA" datasourceId="CityCorp_DS">
      <fieldList>
        <field id="PREM_ID" type="java.lang.String"></field>
        <field id="PREM_TYPE_CD" type="java.lang.String"></field>
        <field id="ADDRESS1" type="java.lang.String"></field>
        <field id="CITY" type="java.lang.String"></field>
        <field id="POSTAL" type="java.lang.String"></field>
        <field id="STATE" type="java.lang.String"></field>
        <field id="D1_SP_ID" type="java.lang.String"></field>
        <field id="D1_SP_TYPE_CD" type="java.lang.String"></field>
        <field id="MSRMT_CYC_CD" type="java.lang.String"></field>
        <field id="MSRMT_CYC_RTE_CD" type="java.lang.String"></field>
        <field id="MSRMT_CYC_RTE_SEQ" type="java.math.BigDecimal"></field>
        <field id="MSRMT_DTTM" type="java.sql.Timestamp"></field>
        <field id="MSRMT_COND_FLG" type="java.lang.String"></field>
        <field id="MSRMT_LOCAL_DTTM" type="java.sql.Timestamp"></field>
        <field id="MSRMT_VAL" type="java.math.BigDecimal"></field>
        <field id="READING_VAL" type="java.math.BigDecimal"></field>
        <field id="COMBINED_MULTIPLIER" type="java.math.BigDecimal"></field>
        <field id="RANK" type="java.math.BigDecimal"></field>
        <field id="CCB_SP_ID" type="java.lang.String"></field>
      </fieldList>
      <query>SELECT PREM.PREM_ID, 
       PREM.PREM_TYPE_CD, 
       PREM.ADDRESS1, 
       PREM.CITY, 
       PREM.POSTAL, 
       PREM.STATE, 
       SPID2.ID_VALUE "CCB_SP_ID",
       SP.D1_SP_ID, 
       SP.D1_SP_TYPE_CD, 
       SP.MSRMT_CYC_CD, 
       SP.MSRMT_CYC_RTE_CD, 
       SP.MSRMT_CYC_RTE_SEQ,
       M.MSRMT_DTTM, 
       M.MSRMT_COND_FLG,
       M.MSRMT_LOCAL_DTTM,
       M.MSRMT_VAL,
       M.READING_VAL,
       M.COMBINED_MULTIPLIER,
       ROW_NUMBER() OVER (PARTITION BY SP.D1_SP_ID ORDER BY PREM.PREM_ID, M.MSRMT_LOCAL_DTTM DESC) RANK
FROM CISADM.CI_PREM PREM 
INNER JOIN CISADM.D1_SP_IDENTIFIER SPID ON SPID.SP_ID_TYPE_FLG = 'D1EP' AND SPID.ID_VALUE = PREM.PREM_ID
INNER JOIN CISADM.D1_SP_IDENTIFIER SPID2 ON SPID2.SP_ID_TYPE_FLG = 'D1EI' AND SPID2.D1_SP_ID = SPID.D1_SP_ID
INNER JOIN CISADM.D1_SP SP ON SP.D1_SP_ID = SPID.D1_SP_ID
INNER JOIN CISADM.D1_INSTALL_EVT IE ON IE.D1_SP_ID = SPID.D1_SP_ID
INNER JOIN CISADM.D1_DVC_CFG DC ON DC.DEVICE_CONFIG_ID = IE.DEVICE_CONFIG_ID
INNER JOIN CISADM.D1_MEASR_COMP MC ON MC.DEVICE_CONFIG_ID = DC.DEVICE_CONFIG_ID
INNER JOIN CISADM.D1_MSRMT M ON M.MEASR_COMP_ID = MC.MEASR_COMP_ID AND M.MSRMT_USE_FLG != 'D101' AND M.VERSION &lt; 500</query>
    </jdbcQuery>
    <jdbcQuery id="JoinTree_1" datasourceId="CityCorp_DS">
      <fieldList>
        <field id="BILL_DATA.PER_ID" type="java.lang.String"></field>
        <field id="BILL_DATA.ACCT_ID" type="java.lang.String"></field>
        <field id="BILL_DATA.ENTITY_NAME" type="java.lang.String"></field>
        <field id="BILL_DATA.PREM_ID" type="java.lang.String"></field>
        <field id="BILL_DATA.ADDRESS1" type="java.lang.String"></field>
        <field id="BILL_DATA.BILL_ID" type="java.lang.String"></field>
        <field id="BILL_DATA.SP_ID" type="java.lang.String"></field>
        <field id="BILL_DATA.START_READ_DTTM" type="java.sql.Timestamp"></field>
        <field id="BILL_DATA.END_READ_DTTM" type="java.sql.Timestamp"></field>
        <field id="BILL_DATA.FINAL_REG_QTY" type="java.math.BigDecimal"></field>
        <field id="BILL_DATA.BILL_DT" type="java.sql.Timestamp"></field>
        <field id="BILL_DATA.BILL_CYC_CD" type="java.lang.String"></field>
        <field id="MSRMT_DATA.PREM_ID" type="java.lang.String"></field>
        <field id="MSRMT_DATA.PREM_TYPE_CD" type="java.lang.String"></field>
        <field id="MSRMT_DATA.ADDRESS1" type="java.lang.String"></field>
        <field id="MSRMT_DATA.CITY" type="java.lang.String"></field>
        <field id="MSRMT_DATA.POSTAL" type="java.lang.String"></field>
        <field id="MSRMT_DATA.STATE" type="java.lang.String"></field>
        <field id="MSRMT_DATA.D1_SP_ID" type="java.lang.String"></field>
        <field id="MSRMT_DATA.D1_SP_TYPE_CD" type="java.lang.String"></field>
        <field id="MSRMT_DATA.MSRMT_CYC_CD" type="java.lang.String"></field>
        <field id="MSRMT_DATA.MSRMT_CYC_RTE_CD" type="java.lang.String"></field>
        <field id="MSRMT_DATA.MSRMT_CYC_RTE_SEQ" type="java.math.BigDecimal"></field>
        <field id="MSRMT_DATA.MSRMT_DTTM" type="java.sql.Timestamp"></field>
        <field id="MSRMT_DATA.MSRMT_COND_FLG" type="java.lang.String"></field>
        <field id="MSRMT_DATA.MSRMT_LOCAL_DTTM" type="java.sql.Timestamp"></field>
        <field id="MSRMT_DATA.MSRMT_VAL" type="java.math.BigDecimal"></field>
        <field id="MSRMT_DATA.READING_VAL" type="java.math.BigDecimal"></field>
        <field id="MSRMT_DATA.COMBINED_MULTIPLIER" type="java.math.BigDecimal"></field>
        <field id="MSRMT_DATA.RANK" type="java.math.BigDecimal"></field>
        <field id="MSRMT_DATA.CCB_SP_ID" type="java.lang.String"></field>
      </fieldList>
      <joinInfo alias="BILL_DATA" referenceId="BILL_DATA"></joinInfo>
      <joinList>
        <join expr="BILL_DATA.PREM_ID == MSRMT_DATA.PREM_ID and BILL_DATA.SP_ID == MSRMT_DATA.CCB_SP_ID" left="BILL_DATA" right="MSRMT_DATA" type="leftOuter" weight="1"></join>
      </joinList>
      <joinOptions></joinOptions>
      <query>SELECT DISTINCT AP.PER_ID, ACT.ACCT_ID, PN.ENTITY_NAME, PREM.PREM_ID, PREM.ADDRESS1, B.BILL_ID, B.BILL_DT, B.BILL_CYC_CD, BSR.SP_ID, BSR.START_READ_DTTM, BSR.END_READ_DTTM, BSR.FINAL_REG_QTY
FROM CISADM.CI_BILL B
INNER JOIN CISADM.CI_FT FT ON FT.BILL_ID = B.BILL_ID AND FT.FT_TYPE_FLG IN ('BS','BX') AND FT.FREEZE_SW = 'Y'
INNER JOIN CISADM.CI_BSEG BS ON BS.BSEG_ID = FT.SIBLING_ID
INNER JOIN CISADM.CI_BSEG_READ BSR ON BSR.BSEG_ID = BS.BSEG_ID AND BSR.USAGE_FLG = 'X' AND BSR.SP_ID != ' ' AND BSR.UOM_CD = 'TGAL' AND BSR.TOU_CD = ' ' AND BSR.SQI_CD = ' '
INNER JOIN CISADM.CI_ACCT ACT ON ACT.ACCT_ID = B.ACCT_ID
INNER JOIN CISADM.CI_ACCT_PER AP ON AP.ACCT_ID = ACT.ACCT_ID AND AP.MAIN_CUST_SW = 'Y'
INNER JOIN CISADM.CI_PER_NAME PN ON PN.PER_ID = AP.PER_ID AND PN.PRIM_NAME_SW = 'Y'
INNER JOIN CISADM.CI_SA SA ON SA.ACCT_ID = ACT.ACCT_ID AND SA.SA_ID = BS.SA_ID
INNER JOIN CISADM.CI_PREM PREM ON PREM.PREM_ID = SA.CHAR_PREM_ID
WHERE B.BILL_STAT_FLG = 'C'</query>
      <tableRefList>
        <tableRef alwaysIncludeTable="false" tableAlias="BILL_DATA" tableId="BILL_DATA"></tableRef>
        <tableRef alwaysIncludeTable="false" tableAlias="MSRMT_DATA" tableId="MSRMT_DATA"></tableRef>
      </tableRefList>
    </jdbcQuery>
  </resources>
</schema>
