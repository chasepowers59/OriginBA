        <item id="D1_SP_TYPE_CD" label="Service Point Type" resourceId="JoinTree_1.MSRMT_DATA.D1_SP_TYPE_CD"></item>
        <item id="MSRMT_COND_FLG" label="Condition" resourceId="JoinTree_1.MSRMT_DATA.MSRMT_COND_FLG"></item>
        <item id="MSRMT_CYC_CD" label="Measurement Cycle" resourceId="JoinTree_1.MSRMT_DATA.MSRMT_CYC_CD"></item>
        <item id="MSRMT_CYC_RTE_CD" label="Route" resourceId="JoinTree_1.MSRMT_DATA.MSRMT_CYC_RTE_CD"></item>
