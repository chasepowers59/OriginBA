      <joinInfo alias="W1_ASSET" referenceId="W1_ASSET"></joinInfo>
      <joinList>
        <join expr="W1_ASSET.ASSET_ID == W1_SVC_HIST.ASSET_ID" left="W1_ASSET" right="W1_SVC_HIST" type="inner" weight="1"></join>
        <join expr="W1_ASSET.ASSET_ID == CMS_W1_ASSET_IDENTIFIER_VW.ASSET_ID" left="W1_ASSET" right="CMS_W1_ASSET_IDENTIFIER_VW" type="inner" weight="1"></join>
        <join expr="W1_ASSET.ASSET_TYPE_CD == W1_ASSET_TYPE_L.ASSET_TYPE_CD and W1_ASSET_TYPE_L.LANGUAGE_CD == 'ENG'" left="W1_ASSET" right="W1_ASSET_TYPE_L" type="inner" weight="1"></join>
