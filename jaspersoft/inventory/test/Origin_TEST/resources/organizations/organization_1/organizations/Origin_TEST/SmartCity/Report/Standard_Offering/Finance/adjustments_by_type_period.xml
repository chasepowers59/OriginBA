                    <name>ADJ_TYPE_CD_F_query</name>
                    <version>0</version>
                    <label>ADJ_TYPE_CD_F_query</label>
                    <creationDate>2026-09-18T16:21:52.000Z</creationDate>
                    <updateDate>2026-09-18T11:09:57.000Z</updateDate>
                    <language>sql</language>
                    <queryString>SELECT TRIM(adj_type_cd) AS CODE, TRIM(adj_type_cd) || ' - ' || descr AS DESCR FROM CISADM.CI_ADJ_TYPE_L l WHERE l.language_cd = 'ENG' AND EXISTS (SELECT 1 FROM CISADM.CI_ADJ a WHERE a.adj_type_cd = l.adj_type_cd AND a.cre_dt &gt;= CURRENT_DATE - INTERVAL '3' YEAR) ORDER BY 1</queryString>
                    <dataSource>
                        <uri>/organizations/organization_1/organizations/Origin_TEST/DataSource/Origin_TEST_DS</uri>
                    </dataSource>
                </localResource>
            </query>
            <queryVisibleColumn>DESCR</queryVisibleColumn>
            <queryValueColumn>CODE</queryValueColumn>
            <componentType>default</componentType>
