    <jdbcQuery id="FT_GL_SUMMARY" datasourceId="Origin_TEST_DS">
      <fieldList>
        <field id="SIBLING_ID" type="java.lang.String"></field>
        <field id="GL_AMOUNT_SUM" type="java.math.BigDecimal"></field>
        <field id="DST_ID" type="java.lang.String"></field>
        <field id="GL_ACCT" type="java.lang.String"></field>
        <field id="ACCOUNTING_DT" type="java.sql.Timestamp"></field>
      </fieldList>
      <query>SELECT ft.SIBLING_ID,
       SUM(CASE WHEN gl.AMOUNT &lt; 0 THEN gl.AMOUNT ELSE 0 END)   AS GL_AMOUNT_SUM,
       MIN(CASE WHEN gl.AMOUNT &lt; 0 THEN gl.DST_ID END)           AS DST_ID,
       MIN(CASE WHEN gl.AMOUNT &lt; 0 THEN gl.GL_ACCT END)          AS GL_ACCT,
       MIN(ft.ACCOUNTING_DT)                                       AS ACCOUNTING_DT
FROM   CISADM.CI_FT    ft
JOIN   CISADM.CI_FT_GL gl ON gl.FT_ID = ft.FT_ID
GROUP BY ft.SIBLING_ID</query>
    </jdbcQuery>
