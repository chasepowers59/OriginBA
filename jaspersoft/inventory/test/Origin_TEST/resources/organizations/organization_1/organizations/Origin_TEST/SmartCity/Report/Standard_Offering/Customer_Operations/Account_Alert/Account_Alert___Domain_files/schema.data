        <field id="C1_PER_CONTDET.CONTACT_NAME" type="java.lang.String"></field>
        <field id="C1_PER_CONTDET.CONTACT_EXT_ID" type="java.lang.String"></field>
        <field id="ACCT_ID_DISTINCT" dataSetExpression="CountDistinct(CI_ACCT.ACCT_ID, 'Current')" type="java.lang.Long"></field>
        <field id="BILL_PRT_INTERCEPT_NAME" dataSetExpression="Concatenate(SC_USER.FIRST_NAME, ' ', SC_USER.LAST_NAME)" type="java.lang.String"></field>
        <field id="IS_EFFECTIVE" dataSetExpression="CaseWhen(ElapsedDays(Today(0), CI_ACCT_ALERT.START_DT) &gt; 0 and (IsNull(CI_ACCT_ALERT.END_DT) or ElapsedDays(Today(0), CI_ACCT_ALERT.END_DT) &lt; -1), 'Y', 'N')" type="java.lang.String"></field>
        <field id="ACCT_ALERT_DISTINCT" dataSetExpression="CountDistinct(Concatenate(CI_ACCT_ALERT.ACCT_ID, '_', CI_ACCT_ALERT.ALERT_TYPE_CD, '_', CI_ACCT_ALERT.START_DT), 'Current')" type="java.lang.Long"></field>
        <field id="GL_AMOUNT_SUM" dataSetExpression="FT_GL_SUMMARY.GL_AMOUNT_SUM" type="java.math.BigDecimal"></field>
        <field id="GL_VARIANCE" dataSetExpression="CI_BSEG_CALC.CALC_AMT + FT_GL_SUMMARY.GL_AMOUNT_SUM" type="java.math.BigDecimal"></field>
      </fieldList>
      <filterString>CI_COLL_CL_L.LANGUAGE_CD == 'ENG' and CI_ACCT_PER.MAIN_CUST_SW == 'Y' and CI_CUST_CL_L.LANGUAGE_CD == 'ENG' and CI_ALERT_TYPE_L.LANGUAGE_CD == 'ENG' and CI_PER_NAME.NAME_TYPE_FLG == 'PRIM'</filterString>
      <joinInfo alias="CI_ACCT" referenceId="CI_ACCT"></joinInfo>
      <joinList>
        <join expr="CI_ACCT.ACCT_ID == CI_ACCT_ALERT.ACCT_ID" left="CI_ACCT" right="CI_ACCT_ALERT" type="inner" weight="1"></join>
        <join expr="CI_ACCT.ACCT_ID == CI_ACCT_PER.ACCT_ID and CI_ACCT_PER.MAIN_CUST_SW == 'Y'" left="CI_ACCT" right="CI_ACCT_PER" type="inner" weight="1"></join>
        <join expr="CI_ACCT_ALERT.ALERT_TYPE_CD == CI_ALERT_TYPE_L.ALERT_TYPE_CD and CI_ALERT_TYPE_L.LANGUAGE_CD == 'ENG'" left="CI_ACCT_ALERT" right="CI_ALERT_TYPE_L" type="inner" weight="1"></join>
        <join expr="CI_ACCT.BILL_CYC_CD == CI_BILL_CYC_L.BILL_CYC_CD and CI_BILL_CYC_L.LANGUAGE_CD == 'ENG'" left="CI_ACCT" right="CI_BILL_CYC_L" type="leftOuter" weight="1"></join>
        <join expr="CI_ACCT.CIS_DIVISION == CI_CIS_DIVISION_L.CIS_DIVISION and CI_CIS_DIVISION_L.LANGUAGE_CD == 'ENG'" left="CI_ACCT" right="CI_CIS_DIVISION_L" type="leftOuter" weight="1"></join>
        <join expr="CI_ACCT.COLL_CL_CD == CI_COLL_CL_L.COLL_CL_CD and CI_COLL_CL_L.LANGUAGE_CD == 'ENG'" left="CI_ACCT" right="CI_COLL_CL_L" type="inner" weight="1"></join>
        <join expr="CI_ACCT.CUST_CL_CD == CI_CUST_CL_L.CUST_CL_CD and CI_CUST_CL_L.LANGUAGE_CD == 'ENG'" left="CI_ACCT" right="CI_CUST_CL_L" type="inner" weight="1"></join>
        <join expr="CI_ACCT.BUD_PLAN_CD == CI_BUD_PLAN_L.BUD_PLAN_CD and CI_BUD_PLAN_L.LANGUAGE_CD == 'ENG'" left="CI_ACCT" right="CI_BUD_PLAN_L" type="leftOuter" weight="1"></join>
        <join expr="CI_ACCT.BILL_PRT_INTERCEPT == SC_USER.USER_ID" left="CI_ACCT" right="SC_USER" type="leftOuter" weight="1"></join>
        <join expr="CI_ACCT_PER.PER_ID == CI_PER_NAME.PER_ID and CI_PER_NAME.NAME_TYPE_FLG == 'PRIM' and CI_ACCT_PER.MAIN_CUST_SW == 'Y'" left="CI_ACCT_PER" right="CI_PER_NAME" type="inner" weight="1"></join>
        <join expr="CI_ACCT.ACCT_ID == CI_SA.ACCT_ID" left="CI_ACCT" right="CI_SA" type="leftOuter" weight="1"></join>
        <join expr="CI_SA.SA_ID == CI_BSEG.SA_ID" left="CI_SA" right="CI_BSEG" type="leftOuter" weight="1"></join>
        <join expr="CI_BSEG.BSEG_ID == CI_BSEG_CALC.BSEG_ID" left="CI_BSEG" right="CI_BSEG_CALC" type="inner" weight="1"></join>
        <join expr="CI_BSEG.BSEG_ID == FT_GL_SUMMARY.SIBLING_ID" left="CI_BSEG" right="FT_GL_SUMMARY" type="leftOuter" weight="1"></join>
        <join expr="CI_ACCT_PER.PER_ID == C1_PER_CONTDET.PER_ID" left="CI_ACCT_PER" right="C1_PER_CONTDET" type="leftOuter" weight="1"></join>
      </joinList>
      <joinOptions></joinOptions>
