    <jdbcTable id="SC_APP_SERVICE_L_1" datasourceId="Origin_TEST_DS" datasourceTableName="SC_APP_SERVICE_L" schemaAlias="CISADM">
      <fieldList>
        <field id="APP_SVC_ID" type="java.lang.String"></field>
