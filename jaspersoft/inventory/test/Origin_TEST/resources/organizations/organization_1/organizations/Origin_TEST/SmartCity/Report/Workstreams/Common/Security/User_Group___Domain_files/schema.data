    <jdbcQuery id="CMS_EXCLUDED_APP_SVC" datasourceId="Origin_TEST_DS">
      <fieldList>
        <field id="USR_GRP_ID" type="java.lang.String"></field>
        <field id="APP_SVC_ID" type="java.lang.String"></field>
        <field id="USER_IDS" type="java.lang.String"></field>
      </fieldList>
      <query>SELECT 
    ugu2.usr_grp_id,
    ugp2.app_svc_id,
    LISTAGG(trim(ugu2.user_id), ',') WITHIN GROUP (ORDER BY ugu2.user_id) AS user_ids
FROM 
    cisadm.sc_usr_grp_usr ugu2
JOIN 
    cisadm.sc_usr_grp_prof ugp2 ON ugp2.usr_grp_id = ugu2.usr_grp_id
--WHERE ugp2.usr_grp_id NOT IN ('ALL_SERVICES', 'ALL_SERVICES_READ')
GROUP BY 
    ugu2.usr_grp_id, ugp2.app_svc_id
ORDER BY 
    ugu2.usr_grp_id</query>
    </jdbcQuery>
    <jdbcTable id="JoinTree_1" datasourceId="Origin_TEST_DS" datasourceTableName="SC_USER" schemaAlias="CISADM">
