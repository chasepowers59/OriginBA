        <field id="SC_USER.DASHBOARD_STATE_FLG" type="java.lang.String"></field>
        <field id="SC_USER_GROUP_L.USR_GRP_ID" type="java.lang.String"></field>
        <field id="SC_USER_GROUP_L.LANGUAGE_CD" type="java.lang.String"></field>
        <field id="SC_USER_GROUP_L.DESCR" type="java.lang.String"></field>
        <field id="SC_USER_GROUP_L.VERSION" type="java.math.BigDecimal"></field>
        <field id="SC_USER_GROUP_L.OWNER_FLG" type="java.lang.String"></field>
        <field id="SC_USER_GROUP.USR_GRP_ID" type="java.lang.String"></field>
        <field id="SC_USER_GROUP.VERSION" type="java.math.BigDecimal"></field>
        <field id="SC_USER_GROUP.OWNER_FLG" type="java.lang.String"></field>
        <field id="SC_USR_GRP_PROF.USR_GRP_ID" type="java.lang.String"></field>
        <field id="SC_USR_GRP_PROF.APP_SVC_ID" type="java.lang.String"></field>
        <field id="SC_USR_GRP_PROF.EXPIRATION_DT" type="java.sql.Timestamp"></field>
        <field id="SC_USR_GRP_PROF.VERSION" type="java.math.BigDecimal"></field>
        <field id="SC_USR_GRP_PROF.OWNER_FLG" type="java.lang.String"></field>
        <field id="USER_ID_NAME" dataSetExpression="Concatenate(SC_USER.FIRST_NAME, ' ', SC_USER.LAST_NAME)" type="java.lang.String"></field>
        <field id="USER_GROUP_DESC" dataSetExpression="Concatenate(SC_USER_GROUP_L.DESCR, ' (', trim(SC_USER_GROUP_L.USR_GRP_ID), ')')" type="java.lang.String"></field>
        <field id="APP_SVC_DESC" dataSetExpression="Concatenate(SC_APP_SERVICE_L.DESCR, ' (', trim(SC_APP_SERVICE_L.APP_SVC_ID), ')')" type="java.lang.String"></field>
      </fieldList>
      <joinInfo alias="SC_USER" referenceId="SC_USER"></joinInfo>
      <joinList>
        <join expr="SC_USER.USER_ID == SC_USR_GRP_USR.USER_ID" left="SC_USER" right="SC_USR_GRP_USR" type="rightOuter" weight="1"></join>
        <join expr="SC_USR_GRP_USR.USR_GRP_ID == SC_USER_GROUP.USR_GRP_ID" left="SC_USR_GRP_USR" right="SC_USER_GROUP" type="rightOuter" weight="1"></join>
        <join expr="SC_USER_GROUP.USR_GRP_ID == SC_USER_GROUP_L.USR_GRP_ID and SC_USER_GROUP_L.LANGUAGE_CD == 'ENG'" left="SC_USER_GROUP" right="SC_USER_GROUP_L" type="inner" weight="1"></join>
        <join expr="SC_USER_GROUP.USR_GRP_ID == SC_USR_GRP_PROF.USR_GRP_ID" left="SC_USER_GROUP" right="SC_USR_GRP_PROF" type="inner" weight="1"></join>
        <join expr="SC_USR_GRP_PROF.APP_SVC_ID == SC_APP_SERVICE.APP_SVC_ID" left="SC_USR_GRP_PROF" right="SC_APP_SERVICE" type="inner" weight="1"></join>
        <join expr="SC_APP_SERVICE.APP_SVC_ID == SC_APP_SERVICE_L.APP_SVC_ID and SC_APP_SERVICE_L.LANGUAGE_CD == 'ENG'" left="SC_APP_SERVICE" right="SC_APP_SERVICE_L" type="inner" weight="1"></join>
      </joinList>
      <joinOptions></joinOptions>
      <tableRefList>
        <tableRef alwaysIncludeTable="false" tableAlias="SC_USR_GRP_USR" tableId="SC_USR_GRP_USR"></tableRef>
        <tableRef alwaysIncludeTable="false" tableAlias="SC_USER" tableId="SC_USER"></tableRef>
        <tableRef alwaysIncludeTable="false" tableAlias="SC_USER_GROUP_L" tableId="SC_USER_GROUP_L"></tableRef>
        <tableRef alwaysIncludeTable="false" tableAlias="SC_APP_SERVICE" tableId="SC_APP_SERVICE"></tableRef>
        <tableRef alwaysIncludeTable="false" tableAlias="SC_APP_SERVICE_L" tableId="SC_APP_SERVICE_L"></tableRef>
        <tableRef alwaysIncludeTable="false" tableAlias="SC_USER_GROUP" tableId="SC_USER_GROUP"></tableRef>
        <tableRef alwaysIncludeTable="false" tableAlias="SC_USR_GRP_PROF" tableId="SC_USR_GRP_PROF"></tableRef>
      </tableRefList>
    </jdbcTable>
  </resources>
