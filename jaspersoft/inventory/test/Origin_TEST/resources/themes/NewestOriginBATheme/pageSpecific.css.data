/* ------------------------- */
/*  START 01. Add Resources  */
/* ------------------------- */
/* shared */
#stepDisplay fieldset.row.oneColumn div.header {
    overflow: hidden;
    border-bottom: 1px solid var(--border-grey-16);
}

#stepDisplay fieldset.row.oneColumn div.title {
    float: left !important;
}

#stepDisplay fieldset.row.oneColumn label.control.inline {
    float: left;
}

#addResource_locateQuery #newQueryLink.disabled, /* JasperReport step 4: Query */
#addResource_locateDataSource #newDataSourceLink.disabled /* Query step 2: Link a Data Source */ {
    color: var(--text-light);
}

/* RESOURCE: File */
#addResourceFile #stepDisplay > .inputs.oneColumn > .column .header > span {
    height: 28px;
    line-height: 28px;
    margin-left: 6px;
}

#addResourceFile .twoColumn_equal .column {
    margin: 20px;
    padding: 0 5px;
}

#addResourceFile #fileTypeLabel.error > .message.warning {
    display: inline;
    position: absolute;
    left: 100%;
    top: 6px;
    margin-left: 10px;
}

#addResourceFile .inputs .primary .footer .description {
    /* I can't find this element anywhere on Add File page */
    background-color: #EEEEEE;
    border-bottom: 1px solid #E0E0E0;
    height: 1.3em;
    line-height: 1.3em;
    margin-bottom: 1em;
    margin-left: -20px;
    overflow: hidden;
    padding: 5px 25px;
}

/* RESOURCE: JasperReport */
#addReport_SetUp #noLink,
#addReport_SetUp #create {
    display: none;
} /* can't find */

#addReport_JRXML #noLink,
#addReport_JRXML #create {
    display: none;
} /* can't find */

/* JasperReport step 1: Set Up  */
.list.locations .control.browser.fakeFileUpload {
    margin-bottom: 12px;
    overflow: hidden;
}

.fakeFileUpload input[type='file'] {
    opacity: 0;
    filter: alpha(opacity=0);
    position: absolute;
    width: auto;
    right: 0;
    cursor: pointer;
}

.fakeFileUpload input[readonly] {
    border: 1px solid #c1c1c1;
    border-top-color: #848484;
    border-bottom-color: #e1e1e1;
}

.fakeFileUpload input[disabled] {
    background: #f0f0f0 url("images/input_bkgd.png") repeat-x;
}

/* JasperReport step 2: Controls & Resources */
#addReport_Controls .inputs > .primary .body {
    padding: 0;
}

/* NEW, Aug 2024 */
#addReport_Controls .list.linkedResources > .node {
    margin-bottom: 0;
    padding-bottom: 28px;
}

#addReport_Controls .list.linkedResources > #resources {
    padding-bottom: 12px;
}

#addReport_Controls .list.linkedResources > #controls .leaf:only-child {
    margin-top: -8px;
}

#addReport_Controls .list.linkedResources > .node > .wrap.header {
    background-color: #ffffff;
    border: none;
    margin-bottom: 12px;
    padding-left: 0;
}

#addReport_Controls .list.linkedResources > .node .leaf > .wrap {
    padding-left: 0;
}

#addReport_Controls .list.linkedResources > .node > .wrap.header .column.one {
    color: #212121;
    font-family: source_sans_prosemibold, Franklin Gothic Medium, Verdana, Arial, sans-serif;
    font-size: 16px;
    font-weight: normal;
}

#addReport_Controls .list.linkedResources > .node .leaf {
    padding-left: 4px;
}

#addReport_Controls #controlOptions .leaf:has(.input.control.text) {
    margin-left: 0;
    min-width: 500px;
    width: 60%;
}

#addReport_Controls .list.linkedResources > .node:not(:last-child) .leaf:not(:last-child) {
    border-bottom: 1px solid #e5eaed;
}

#addReport_Controls .list.linkedResources > .node .leaf:last-child {
    margin-top: 8px;
}

#addReport_Controls .list.linkedResources > #controlOptions .leaf:last-child {
    margin-top: 16px;
}

#addReport_Controls .list.linkedResources > .node .leaf .column.one > .emphasis {
    font-weight: normal;
}

#addReport_Controls .list.linkedResources > .node .leaf .column.three {
    width: 25%;
}

#addReport_Controls .list.linkedResources .control > .wrap {
    color: #444444;
}

#addReport_Controls #baseName {
    min-width: 500px;
    width: 60%;
}

#addReport_Controls #baseName .wrap {
    padding-left: 0;
}

#addReport_Controls #baseName  input[readonly] {
    color: #999999;
}
/* end NEW */

#addReport_Controls .tabular.linkedResources > .node > .wrap.header {
    background-color: #ffffff;
    border: none
}

#addReport_Controls .tabular.linkedResources > .node > .wrap.header .column.one {
    color: #212121;
    font-family: source_sans_prosemibold, Franklin Gothic Medium, Verdana, Arial, sans-serif;
    font-size: 16px;
    font-weight: normal;
}

#controlOptions .wrap {
    border: none;
    line-height: normal;
}

#controlOptions .select,
#controlOptions .checkBox {
    display: inline-block;
    margin-top: 5px;
}

#controlOptions .select {
    margin-right: 10px;
    width: auto;
}

#controlOptions .header.wrap {
    background-color: transparent;
}

/* JasperReport step 3: Data Source */
#addResource_locateDataSource #fromLocal {
    display: none;
} /* can't find */

/* JasperReport step 4: Query */
#addResource_locateQuery #fromLocal {
    display: none;
} /* can't find */


