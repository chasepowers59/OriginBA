}

#reportViewer #dataRefreshButton {
    border: none;
    height: 28px;
    margin-left: 6px;
}

#reportViewer #dataRefreshButton .wrap {
    background: none;
    height: 21px;
}

#reportViewer #dataRefreshButton .icon {
    background-image: url(images/button_action_icons_sprite@1x.png);
    background-repeat: no-repeat;
    background-size: 240px;
    background-position: -54px -239px;
    width: 100%;
}
/* 2x icons */
@media (-webkit-min-device-pixel-ratio: 2),(min-resolution: 192dpi) {
    #reportViewer #dataRefreshButton .icon {
        background-image: url(images/button_action_icons_sprite@2x.png);
    }
}

#reportViewer #dataRefreshButton.up.over .icon,
#reportViewer #dataRefreshButton.up.pressed .icon {
    background-position: -84px -239px;
}

#reportViewer .twoColumn .primary.column {
    margin-left: 2px;
    /* left: 300px; inline styles will always override this */
}

#reportViewFrame.column.decorated > .content {
    overflow-x: auto;
}

#reportViewFrame.column.decorated > .content > .body {
    min-width: 1050px;
    overflow-x: auto;
    top: 32px !important;
    margin-top: 0;
}

#reportViewFrame .header > .list.buttonSet {
    height: 28px;
    margin-left: 10px;
}

div.body.swipeScroll {
    position: absolute !important;
}

@media only screen
and (min-device-width: 768px)
and (max-device-width: 1024px) {
    #reportViewer > #frame > .content > .body.twoColumn > .primary.column.decorated {
        left: 300px;
    }
}

#reportViewer.nothingToDisplay .report,
#reportViewer.nothingToDisplay .control.paging {
    display: none;
}

#reportViewer #display.controlPage .primary.column {
    display: none;
}

#reportViewer #display.controlPage .secondary.column {
    width: auto;
    left: 0;
    right: 0;
}

#reportViewer #display.controlPage .secondary.column .sizer,
#reportViewer #display.controlPage .secondary.column .minimize {
    display: none;
}

#reportViewer #display.controlPage .secondary.column .sizer.vertical {
    display: block;
}

#reportViewer #display.controlPage .list.inputControls {
    width: 300px;
    margin-left: 20px;
}

#reportViewer #reportContainer {
    padding-top: 2px; /* prevents report from overlapping toolbar */
}

#reportContainer.alertMode {
    padding-top: 0 !important;
}

#reportContainer table,
#reportContainer tbody,
#reportContainer tfoot,
#reportContainer thead,
#reportContainer tr,
#reportContainer th,
#reportContainer td {
    /* resets for rendered reports */
    font-size: 1%;
    vertical-align: top;
    line-height: normal;
    text-align: left;
}

#reportContainer dialog td {
    font-size: 13px;
}

#reportContainer .inputControls a {
    color: inherit;
} /* this is needed because of the next two rules, found in multiselect input control */

#reportContainer a {
    color: var(--jrs-theme-light);
} /* not sure what this element is */

#reportContainer a:active {
    color: var(--jrs-theme-medium);
} /* not sure what this element is */

#reportContainer .column {
    position: static;
}

#reportContainer #innerPagination td,
#reportContainer #innerPagination input {
    font-size: 11px;
    font-family: Verdana, Arial, Helvetica, sans-serif;
    vertical-align: middle;
}

#reportContainer #innerPagination input {
    text-align: right;
    width: 40px;
}

/* inputControls - left panel */
#reportViewer .twoColumn .secondary.column {
    min-width: 249px;
    /* width: 300px; inline styles will always override this */
    z-index: 1;
}

#reportViewer .twoColumn #inputControlsForm.minimized {
    background-color: var(--background-grey-16);
    border-right: none;
}

#reportViewer .twoColumn #inputControlsForm.minimized .button.minimize {
    background-position: -57px -202px;
    width: 24px;
}

/* panel type icon shown in minimized panel */
#reportViewer .twoColumn #inputControlsForm.minimized > .icon.minimize {
    background-image: url(images/button_action_icons_sprite@1x.png);
    background-repeat: no-repeat;
    background-size: 240px;
    cursor: pointer;
    height: 32px;
    width: 24px;
}
/* 2x icons */
@media (-webkit-min-device-pixel-ratio: 2), (min-resolution: 192dpi) {
    #reportViewer .twoColumn #inputControlsForm.minimized > .icon.minimize {
        background-image: url(images/button_action_icons_sprite@2x.png);
    }
}

#reportViewer .twoColumn #inputControlsForm.minimized > .icon.minimize {
    background-position: -57px -24px;
}

#reportViewer .twoColumn #inputControlsForm.minimized .vtitle {
    display: none !important;
} /* ELEMENT REPLACED BY .icon.minimize */

#reportViewer #inputControlsForm .button.minimize {
    background-color: var(--background-grey-47);
    background-image: url(images/disclosure_indicators_icons_sprite.svg);
    background-repeat: no-repeat;
    background-position: -61px -172px;
    background-size: 170px;
    display: inline-block;
    height: 32px;
    margin-top: 0;
    width: 14px;
    z-index: 10;
}

#reportViewer #inputControlsForm > .content > .header {
    background-color: var(--background-grey-16);
    border-bottom: 0;
    height: 32px;
}

#reportViewer #inputControlsForm > .content > .header > .title {
    color: var(--text-dark);
    display: inline-block;
    font-family: source_sans_proregular, Franklin Gothic, Verdana, Arial, sans-serif;
    font-size: 15px;
    font-weight: normal !important;
    height: 32px;
    line-height: 32px;
    margin-left: 11px;
    overflow: hidden;
    vertical-align: top;
}

#reportViewer #inputControlsForm > .content.hasFooter > .footer {
    align-items: center;
    background-color: var(--background-grey-03);
    display: flex;
    height: 38px;
    padding: 0 8px;
}

/* blank canvas messages */
#reportViewer .topOfPage  ~ div > #nothingToDisplay {
    top: 10px !important;
}

#reportViewer #nothingToDisplay {
    align-self: center;
    display: flex;
    height: auto !important;
    justify-content: center;
    margin: 0 !important;
    position: relative !important;
    top: 100px !important;
    right: auto !important;
    bottom: auto !important;
    left: auto !important;
    width: 99%  !important;
}

#reportViewer #nothingToDisplay .content {
    background-color: var(--background-grey-03);
}

#reportViewer #nothingToDisplay .message {
    background-color: transparent;
    border: none;
    color: var(--text-light);
    display: block;
    font-family: source_sans_proregular, Franklin Gothic, Verdana, Arial, sans-serif;
    font-size: 18px;
    padding: 22px;
}

#reportViewer .nothingToDisplay .message-text {
    display: block;
    font-weight: normal;
    line-height: 1.4;
}

#reportViewer .nothingToDisplay .message > .icon {
    display: block;
}

/* inputControls - savedValues display case */
#reportViewer #inputControls.showingSubHeader > .content > .header > .sub.header,
#reportViewer #inputControlsForm.showingSubHeader > .content > .header > .sub.header {
    height: 52px;
    padding: 6px 10px;
    border-bottom: 1px solid var(--border-grey-13);
}

#reportViewer #inputControlsForm.showingSubHeader.column.secondary > .content > .header > .sub.header {
    background-color: var(--background-grey-03);
}

#reportViewer #inputControlsForm .sub.header {
    height: 52px;
    padding: 6px 10px;
    border-bottom: none;
}

#reportViewer #inputControlsForm > .content > .body {
    padding: 8px;
    top: 32px;
}

#reportViewer #inputControlsForm.minimized {
    min-width: 0;
}

#reportViewer #inputControlsForm > .content > .footer > .button {
    margin-top: 0;
}

#reportViewer #inputControls.showingSubHeader > .content > .body,
#reportViewer #inputControlsForm.showingSubHeader > .content > .body {
    margin-top: 40px;
}

#reportViewer #inputControlsForm .sub.header .control.select {
    margin: 0;
}

#reportViewer #inputControlsForm .control.select.multiple .sizer.vertical span {
    position: relative;
    left: 45%;
}

#reportViewer .calendar {
    z-index: 1000 !important;
}

#reportViewer #reportOptionsSelect {
    width: auto;
    max-width: 98%;
    margin-left: 0;
}

#reportViewer .saveAs > .content > .body .groupBox {
    top: 170px;
    right: 18px;
    left: 18px;
}

/* Top of page input controls */
#reportViewFrame .topOfPage .warning {
    float: left;
}

/* Inner pagination of report. Used always in dashboards and optional in view report */
#innerPagination {
    display: table;
    margin: 0 auto;
}

#innerPagination .currentPage {
    text-align: right;
    width: 30px;
}

#innerPagination .button > .wrap > .icon {
    background-image: url("images/inner_pagination_sprite.png");
    height: 15px;
    width: 15px;
}

#innerPagination .button > .wrap {
    height: 12px;
    width: 15px;
}

#innerPagination .toLeft .wrap > .icon {
    background-position: 0 -2px;
}

#innerPagination .left .wrap > .icon {
    background-position: 0 -16px;
}

#innerPagination .right .wrap > .icon {
    background-position: 0 -44px;
}

#innerPagination .toRight .wrap > .icon {
    background-position: 0 -30px;
}

#innerPagination .toLeft[disabled] .wrap > .icon {
    background-position: -15px -2px;
}

#innerPagination .left[disabled] .wrap > .icon {
    background-position: -15px -16px;
}

#innerPagination .right[disabled] .wrap > .icon {
    background-position: -15px -44px;
}

#innerPagination .toRight[disabled] .wrap > .icon {
    background-position: -15px -30px;
}

div#reportPartsContainer span {
    line-height: 22px !important;
    min-width: auto !important;
    padding: 0 12px !important;
}

div#reportPartsContainer span {
    font-weight: bold !important;
}

/* report toc tabs */
#reportPartsController {
    display: flex;
    flex: 1 1 auto;
    justify-content: flex-end;
    padding-right: 3px;
    top: 0;
}

#reportPartsContainer .reportPart {
    border: 1px solid transparent;
    border-top-right-radius: 3px;
    border-top-left-radius: 3px;
    cursor: pointer;
    display: inline-block;
    height: 32px;
    line-height: 22px;
    margin: 0 2px;
    min-width: 60px;
    position: relative;
    top: 6px;
    white-space: nowrap;
    zoom: 1;
}

#reportPartsContainer .reportPart.active {
    background-color: var(--jrs-theme-dark);
    border-bottom: transparent;
}


#reportPartsContainer .reportPart.over span {
    color: var(--jrs-theme-medium);
}

#reportPartsContainer .reportPart span {
    color: var(--text-light);
    display: block;
    font-size: 14px;
    height: 100%;
    line-height: 32px;
    min-width: 60px;
    padding: 0 12px;
    text-align: center;
    width: auto;
}

#reportPartsContainer .reportPart.active span {
    color: #ffffff;
}

#reportPartsContainer .control.search {
    height: 28px;
    margin-top: 6px;
}

#reportPartsContainer .control.search .button.action {
    height: 28px;
}

#reportPartsContainer .button.action.up.over {
    background-color: var(--jrs-theme-medium);
}

/* legacy keyboard focus styles */
#reportViewer .toolsRight input[type=text]:focus {
    outline: 2px dotted orange !important;
    outline-offset: -2px;
}

#reportPartsContainer.buttonSet.superfocus {
    outline: 2px solid orange;
    outline-offset: -2px;
    padding-left: 2px;
    margin-left: -2px;
}

#reportPartsContainer.buttonSet.superfocus .reportPart.active {
    height: 30px;
}

#reportPartsContainer.buttonSet.superfocus .leaf.subfocus .button {
    height: 30px;
}

#viewerToolbar .buttonSet.superfocus {
    border: 2px solid orange;
    margin-left: -2px;
}

#viewerToolbar .toolsRight.superfocus {
    border: 2px solid orange;
    margin-left: -2px;
}

#reportViewer .menu.dropDown ul.superfocus li.subfocus,
#reportViewer .leaf.subfocus.focus-visible > .reportPart.over,
#reportViewer .leaf:focus .button.action,
#reportViewer .leaf:focus .button.capsule,
#dataRefreshButton:focus {
    outline: 1px dotted royalblue;
}

#reportViewer .menu.dropDown:focus-within {
    outline: 2px solid orange;
}

.leaf:focus .textPlus,
.leaf:focus #page_current {
    outline: 2px dotted orange;
}
/* --------- */
/*  END 15.  */
/* --------- */


/* ---------------------- */
/*  START 16. Repository  */
/* ---------------------- */
/* Shared Styles */
#resultsContainer {
    background-color: transparent;
    height: 100%;
    inset: unset;
    margin-top: 2px;
    position: relative;
}

#resultsContainer #nothingToDisplay {
    align-self: center;
    display: flex;
    justify-content: center;
    width: 100%;
    /* styles below are needed to overerride inline styles */
    margin: 0 !important;
    position: relative !important;
    top: 36% !important;
    right: auto !important;
    bottom: auto !important;
    left: auto !important;
}

#resultsContainer #nothingToDisplay .message {
    background-color: var(--background-grey-03);
    border: none;
    color: var(--text-light);
    display: block;
    font-family: source_sans_proregular, Franklin Gothic, Verdana, Arial, sans-serif;
    font-size: 18px;
    padding: 22px;
    max-width: 325px;
}

#resultsContainer .nothingToDisplay .message-text {
    display: block;
    font-weight: normal;
    line-height: 1.4;
}

#resultsContainer .nothingToDisplay .message > .icon {
    display: block;
}

#repoBrowse #display > .column.decorated.primary,
#repoSearch #display > .column.decorated.primary {
    margin-left: 2px;
    min-width: 500px;
}

#repoLibrary .column.decorated > .content,
#repoBrowse .column.decorated.primary > .content,
#repoSearch .column.decorated.primary > .content {
    display: flex;
    flex-direction: column;
    height: 100%;
    inset: unset;
    position: relative;
} /* for better vertical scroll behavior */

#repoBrowse .column.decorated.secondary > .content > .header,
#repoSearch .column.decorated.secondary > .content > .header {
    background-color: var(--background-grey-16);
    border-bottom: 0;
    height: 32px;
}

#repoBrowse .column.decorated.secondary > .content > .header > .title,
#repoSearch .column.decorated.secondary > .content > .header > .title {
    color: var(--text-dark);
    display: inline-block;
    font-family: source_sans_proregular, Franklin Gothic, Verdana, Arial, sans-serif;
    font-size: 15px;
    font-weight: normal !important;
    height: 32px;
    line-height: 32px;
    margin-left: 11px;
    vertical-align: top;
    overflow: hidden;
}

#repoSearch .list.resources .column.two,
#repoBrowse .list.resources .column.two {
    width: 63%;
}

#repoSearch .list.resources .resourceDescription,
#repoBrowse .list.resources .resourceDescription {
    max-width: 55%;
    min-height: 31px;
    min-width: 20%;
    width: auto;
}

#repoBrowse #results .subheader,
#repoSearch #results .subheader,
#repoLibrary #results .subheader {
    height: auto;
}

#repoBrowse #results .toolbar,
#repoSearch #results .toolbar,
#repoLibrary #results .toolbar {
    border-top: none;
    display: flex;
    padding: 0 10px 0 5px;
    justify-content: space-between;
    align-items: center;
}

#repoBrowse #sortMode,
#repoSearch #sortMode,
#repoLibrary #sortMode {
    position: relative;
    top: unset;
    right: unset;
}

#repoBrowse .list.buttonSet {
    border-right: 1px solid var(--border-grey-20);
}

#repoLibrary #results .toolbar .buttonSet,
#repoSearch #results .toolbar .buttonSet {
    display: none;
}

#repoBrowse #results div.subheader {
    background: transparent;
    height: auto;
    position: relative;
    z-index: 1;
}

#repoBrowse #resultsListHeader,
#repoLibrary #resultsListHeader,
#repoSearch #resultsListHeader {
    margin-top: 2px;
}

#repoSearch .list.tabular.fourColumn,
#repoBrowse .list.tabular.fourColumn {
    min-width: 0;
}

#repoBrowse #filters,
#repoBrowse #frame .searchLockup,
#repoBrowse .column.primary .sub.header {
    display: none;
}

#resultsList ul.sublist li.selected p {
    color: #ffffff !important;
}

/* Keyboard Focus */
#repoBrowse .button.minimize.focus-visible,
#repoSearch .button.minimize.focus-visible {
    outline: 2px solid var(--jrs-theme-dark);
    outline-offset: -2px;
}

/* Browse */
#repoBrowse .column.secondary > .content > .body {
    top: 32px;
}

#repoBrowse .wrap.dragging.resources > .column.two {
    width: auto;
}

#repoBrowse .toolbar .button.capsule.text .wrap {
    line-height: 32px;
}

#repoBrowse #sortMode #relevance {
    display: none;
}

#repoBrowse .resourceLabelID {
    word-wrap: break-word;
    margin-top: 6px;
    padding: 2px 3px;
    color: var(--text-dark);
}

/* Library */
#repoLibrary {
    font-family: source_sans_proregular, Franklin Gothic, Verdana, Arial, sans-serif;
    overflow-y: hidden;
}

#repoLibrary #display > .column.decorated.primary {
    min-width: 500px;
}

#repoLibrary #secondarySearchBox.searchLockup,
#repoSearch #secondarySearchBox.searchLockup {
    float: none;
    margin-top: 0;
    margin-left: 6px;
    width: 300px;
}

#repoLibrary .switch {
    margin-left: 16px;
}

#repoLibrary #folders,
#repoLibrary #filters {
    display: none;
}

#repoLibrary .column.primary > .content > .body.showingSubHeader {
    margin-top: 28px;
}

#repoLibrary .column.secondary > .content > .body {
    top: 27px;
}

/* Search */
/* NOTE: #filtersPanel only appears in Repository Search, so those rules are here */
#repoSearch {
    overflow-y: hidden;
}

#repoSearch .column.primary > .content > .subheader .toolbar {
    display: none;
}

#repoSearch .column.secondary > .content > .body {
    top: 34px;
    bottom: 0;
}

#filtersPanel > .panel > .header {
    background-color: var(--background-grey-08);
    border-bottom: none;
    border-top: 1px solid var(--border-grey-16);
    font-family: source_sans_proregular, Franklin Gothic, Verdana, Arial, sans-serif;
    height: 32px;
}

#filtersPanel > .panel:first-of-type > .header {
    border-top: none;
}

#filtersPanel > .panel > .header > .buttonIconToggle {
    background-color: transparent;
    background-image: url(images/disclosure_indicators_icons_sprite.svg);
    background-size: 170px;
    border: none;
    float: left;
    height: 32px;
    margin: 0;
    padding: 0;
    transform: none;
    width: 22px;
}

#filtersPanel > .panel.open > .header > .buttonIconToggle {
    background-position: 83px -230px;
}

#filtersPanel > .panel.closed > .header > .buttonIconToggle {
    background-position: 83px -290px;
}

#filtersPanel > .panel > .header >  .title {
    color: var(--text-dark);
    font-size: 13px;
    font-weight: normal;
    height: 32px;
    line-height: 33px;
}

#filtersPanel > .panel .subcontainer {
    margin-top: 4px;
}

#filtersPanel > .panel.closed .subcontainer {
    display: none;
}

#repoSearch .list.filters {
    font-family: source_sans_proregular, Franklin Gothic, Verdana, Arial, sans-serif;
    font-size: 13px;
    font-weight: normal !important;
    margin-bottom: 7px;
}

#repoSearch .list.filters > li > .wrap,
#repoSearch .list.filters > li.selected > .wrap,
#repoSearch .list.filters > li > .wrap.separator {
    background-color: transparent;
    border: none;
}

#repoSearch .list.filters .leaf > .wrap,
#repoSearch .list.filters .node > .wrap {
    color: var(--text-light);
    height: 28px;
    line-height: 28px;
    min-height: 28px;
}

#repoSearch .list.filters li.last.closed {
    height: 10px;
}

#repoSearch .list.filters li.selected > .wrap,
#repoSearch .list.filters li > .wrap.over {
    color: var(--jrs-theme-medium);
}

#repoSearch .column.primary .subheader .sub.header {
    background-color: var(--background-grey-03);
    height: 32px;
}

#repoSearch .column.primary .subheader .sub.header .label {
    color: var(--text-light);
    float: left;
    font-family: source_sans_probold, Franklin Gothic, Verdana, Arial, sans-serif;
    font-weight: normal;
    font-size: 13px;
    line-height: 32px;
    margin: 0 0 0 10px;
}

#filtersPanel .scrollWrapper {
    width: 100%; /* Use this style if useTransform is disabled. This will affect horizontal swipe scroll*/
}

/* keyboard focus styles */
#filtersPanel .buttonIconToggle.focus-visible {
    outline: 2px solid var(--jrs-theme-dark);
    outline-offset: -2px;
}

#repoSearch .list.filters li.selected.subfocus.focus-visible > .wrap {
    outline: 2px solid var(--jrs-theme-dark);
    outline-offset: -2px;
}

#repoSearch .list.filters li:not(.selected).subfocus.focus-visible > .wrap {
    background-color: #bde7ff;
    outline: 2px solid var(--jrs-theme-dark);
    outline-offset: -2px;
}


/* responsive behavior */
@media only screen
and (min-device-width: 768px)
and (max-device-width: 1024px)
and (orientation: portrait) {
    #repoBrowse .list.resources .column.two {
        width: 77%;
    }

    #repoBrowse .list.resources .column.three {
        right: 0;
        width: 15%
    }

    #repoBrowse .column.four {
        display: none;
    }

    #repoLibrary .list.resources .column.two {
        width: 77%;
    }

    #repoLibrary .list.resources .column.three {
        right: 0;
        width: 15%
    }

    #repoLibrary .column.four {
        display: none;
    }
}
/* --------- */
/*  END 16.  */
/* --------- */


/* ---------------------------------- */
/*  START 17. Saved Values Selector   */
/* ---------------------------------- */
#savedValuesSelector {
    margin-left: 20px;
    width: 95%;
}

#savedValuesSelector select {
    display: block;
    margin: 8px 0 0;
    max-width: 95%;
}

#savedValuesSelectorOnPupup {
    margin-left: 50px;
    width: 75%;
}

#savedValuesSelectorOnPupup select {
    display: block;
    margin: 8px 0 0;
    width: 100%;
}


/* --------------------- */
/*  START 18. Scheduler  */
/* --------------------- */
.schedulerAccelerator {
    height: 100%;
    position: relative;
}

.schedulerApp .nothingToDisplay {
    top: 37%;
    left: calc(50% - 300px);
    min-width: 600px;
    overflow: hidden;
    margin: 0;
    padding: 28px 8px;
    text-align: center;
}

.schedulerApp .list.jobs .action.over,
.schedulerApp .list.jobs .action.pressed,
.schedulerApp .list.jobs .action.square.over,
.schedulerApp .list.jobs .action.square.pressed {
    background-color: transparent;
}

.schedulerApp .singleReportView > .content > .body {
    top: 66px;
}

.schedulerApp .singleReportView .list {
    margin-top: 0;
}

.schedulerApp .tabs .tabSet.horizontal {
    background-color: transparent;
    font-family: source_sans_proregular, Franklin Gothic, Verdana, Arial, sans-serif;
    font-weight: normal;
    height: auto;
}

.schedulerApp .tabs .tabSet.horizontal .tab {
    height: auto;
}

.schedulerApp .tabs .tabSet.horizontal .button {
    border: 1px solid transparent;
    border-top-right-radius: 3px;
    border-top-left-radius: 3px;
    cursor: pointer;
    display: inline-block;
    height: 32px;
    line-height: 22px;
    margin: 0 2px;
    min-width: 60px;
    padding: 0;
    position: relative;
    white-space: nowrap;
    zoom: 1;
}

.schedulerApp .tabs .tabSet.horizontal .tab .wrap {
    color: var(--text-light);
    display: block;
    font-size: 14px;
    font-weight: normal;
    height: 32px;
    line-height: 32px;
    min-width: 60px;
    padding: 0 12px;
    text-align: center;
    width: auto;
}

.schedulerApp .tabs .tabSet.anchor {
    display: none;
}

