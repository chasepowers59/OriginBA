    align-self: center;
    flex: 0 1 auto;
    display: flex;
    height: 32px;
    position: relative;
}

#reportViewer .header > .title + .controls + .refresh {
    margin-left: 16px;
}

#reportViewer .header .controls .list.buttonSet .leaf.divider {
    background-color: var(--border-grey-13); /* vertical divider, so border variable is okay */
    height: 20px;
    margin: 6px 6px 0 6px;
    width: 1px;
}

#reportViewer .header .controls .list.buttonSet .leaf {
    height: 100%
}

#reportViewer .header .controls .list.buttonSet .button {
    border: none;
