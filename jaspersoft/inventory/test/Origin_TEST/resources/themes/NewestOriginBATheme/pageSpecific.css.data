/* --------------------------- */
/*  START 19. Server Settings  */
/* --------------------------- */
/* left panel menu */
#serverSettingsMenu > .content > .header {
    background-color: var(--background-grey-16);
    border-bottom: 0;
    height: 32px;
}

#serverSettingsMenu > .content > .header > .title {
    color: var(--text-dark);
    display: inline-block;
    font-family: source_sans_proregular, Franklin Gothic, Verdana, Arial, sans-serif;
    font-size: 15px;
    font-weight: normal !important;
    height: 32px;
    line-height: 32px;
    margin-left: 11px;
    vertical-align: top;
    overflow: hidden;
}

#serverSettingsMenu > .content > .body {
    top: 34px;
    bottom: 0;
}

#serverSettingsMenu .list.filters {
    font-family: source_sans_proregular, Franklin Gothic, Verdana, Arial, sans-serif;
    font-size: 13px;
    font-weight: normal !important;
    margin: 6px 0;
}

#serverSettingsMenu .list.filters > li > .wrap,
#serverSettingsMenu .list.filters > li.selected > .wrap,
#serverSettingsMenu .list.filters > li > .wrap.separator {
    background-color: transparent;
    border: none;
}

#serverSettingsMenu .list.filters .leaf > .wrap {
    color: var(--text-light);
    height: 30px;
    line-height: 30px;
    min-height: 30px;
}

#serverSettingsMenu .list.filters li.last.closed {
    height: 10px;
}

#serverSettingsMenu .list.filters li.selected > .wrap,
#serverSettingsMenu .list.filters li > .wrap.over {
    color: var(--jrs-theme-medium);
}

/* general and shared styles */
/* #settings is the parent container on every page except Log Collectors, where it is #logCollectors */
#settings > .content > .body > .title,
#logCollectors .body > .title {
    color: var(--jrs-theme-medium);
    display: inline-block;
    font-family: source_sans_proregular, Franklin Gothic, Verdana, Arial, sans-serif;
    font-size: 18px;
    line-height: 24px;
    margin-bottom: 24px;
}

#settings.column.decorated.primary,
#logCollectors.column.decorated.primary {
    font-family: source_sans_proregular, Franklin Gothic, Verdana, Arial, sans-serif;
    overflow: auto;
}

#settings.column.primary > .content > .header,
#logCollectors.column.primary > .content > .header {
    background-color: #ffffff;
    font-size: 18px;
    height: 76px;
    padding-left: 24px;
}

#settings.column.primary > .content > .header > .title,
#logCollectors.column.primary > .content > .header > .title {
    font-size: 18px;
    margin: 24px 0;
    padding-left: 0;
}

#settings > .content > .body,
#logCollectors > .content > .body {
    padding: 24px;
}

#settings.column.primary .body:not(.twoColumn),
#logCollectors.column.primary .body {
    top: 0;
}

#analysisOptions #settings > .content.hasFooter > .footer,
#logSettings #settings > .content.hasFooter > .footer,
#designerOptions #settings > .content.hasFooter > .footer,
#awsOptions #settings > .content.hasFooter > .footer {
    /* hide footer on select settings pages */
    display: none;
}

#analysisOptions #settings > .content.hasFooter > .body,
#logSettings #settings > .content.hasFooter > .body,
#designerOptions #settings > .content.hasFooter > .body,
#awsOptions #settings > .content.hasFooter > .body {
    /* hide footer on select settings pages */
    bottom: 0;
}

/* Log Collectors */
#logCollectors .LogCollectors > .subheader {
    display: flex;
    justify-content: flex-end;
    height: 28px;
    margin-bottom: 16px;
}

#logCollectors .body > .title {
    margin-bottom: 0;
}

#logCollectors .toolbar {
    background-color: transparent;
}

#logCollectors .button.action {
    border-radius: 2px;
}

/* Ad Hoc Settings, OLAP Settings, and Cloud Settings pages  */
/* analysisOptions is OLAP Settings */
#analysisOptions .content > .body > .title {
    margin-bottom: 0;
}

#analysisOptions .subheader {
    height: 28px;
    display: flex;
    justify-content: end;
    margin-bottom: 12px;
    max-width: 800px;
    margin-top: -28px;
}

#analysisOptions .subheader + .list.twoColumn {
    border: 1px solid var(--border-grey-10);
    border-collapse: separate;
    border-radius: 3px;
    margin-top: 24px;
    max-width: 800px;
} /* for CE */

#analysisOptions .subheader + .list.twoColumn .leaf:first-child > .wrap {
    border-top: none;
} /* for CE */

#analysisOptions .subheader + .list.twoColumn .leaf .column.one {
    line-height: 16px;
    padding-top: 9px;
    padding-bottom: 7px;
    width: 56%
} /* for CE */

#analysisOptions .subheader + .list.twoColumn .leaf .column.two {
    line-height: 16px;
    padding-top: 9px;
    padding-bottom: 7px;
    white-space: normal;
    word-break: break-word;
    width: 42%;
} /* for CE */

#designerOptions #settings > .content > .body > .list .list,
#analysisOptions #settings > .content > .body > .list .list,
#awsOptions #settings > .content > .body > .list .list {
    margin-top: 12px;
    margin-bottom: 54px;
}

#designerOptions #settings > .content > .body > .list .list > li:nth-child(odd),
#analysisOptions #settings > .content > .body > .list .list > li:nth-child(odd),
#awsOptions #settings  > .content > .body > .list .list > li:nth-child(odd) {
    background-color: var(--background-grey-02);
    border-radius: 2px;
}

#awsOptions .pane.settings .column.primary {
    flex: 1 1 auto;
    padding-right: 80px;
}

#awsOptions .pane.settings .control.text {
    display: flex;
    flex-direction: column;
}

#awsOptions .pane.settings .control.text > .wrap,
#awsOptions .pane.settings .control.text > input {
    margin-bottom: 4px;
    margin-left: 28px;
    width: auto;
}

#awsOptions .pane.settings .control.text > .message.warning {
    margin-left: 28px;
    margin-top: 4px;
}

#awsOptions .pane.settings .control.description {
    margin-left: 30px;
}

#analysisOptions .list.settings .control.description {
    word-break: break-word;
}

#serverAttributes #settings.column.primary .footer,
#restoreDefaults #settings.column.primary .footer {
    bottom: 17px;
    left: 200px;
    position: fixed;
}
/* for facelift END */


/* Log Settings */
.logSettings {
    border: 1px solid var(--border-grey-10);
    border-radius: 4px;
}

.logSettings .list.tabular {
    font-family: source_sans_proregular, Franklin Gothic, Verdana, Arial, sans-serif;
    font-size: 13px;
    font-weight: normal;
}

.logSettings .list.tabular .header > .wrap {
    background-color: var(--background-grey-03);
    border: none;
    font-family: source_sans_prosemibold, Franklin Gothic Medium, Verdana, Arial, sans-serif;
    font-size: 13px;
    font-weight: normal;
    height: 32px;
    padding: 0 5px 0 20px;
}

.logSettings .list.tabular .header > .wrap > .column {
    color: var(--text-dark) !important;
}

.logSettings .list.tabular > li:first-child .wrap {
    border-top: none;
}

.logSettings .list.tabular .wrap {
    display: flex;
    flex-direction: row;
}

.logSettings .list.tabular .wrap .column.one,
.logSettings .list.tabular .wrap .column.two,
.logSettings .list.tabular .wrap .column.three {
    display: inline-block;
    line-height: 1.5;
    padding: 7px 16px 4px 0;
    min-height: 32px;
    white-space: normal;
    width: 32%;
    word-wrap: break-word;
}

.logSettings .list.tabular .wrap .column.one {
    color: var(--text-medium);
    flex: 1 1 auto;
}

.logSettings .list.tabular .wrap .column.two {
    color: var(--text-light);
    flex: 1 1 auto;
    padding-left: 2px; /* so text input focus outline doesn't get cut off */
}

.logSettings .list.tabular .wrap .column.three {
    flex: 1 1 0;
    text-align: left;
    padding-left: 16px;
}

.logSettings .list.tabular .wrap .column.three > select {
    display: inline-block;
    margin: 0;
    width: auto;
}

/* Ad Hoc Cache */
#designerCache .subheader {
    height: 28px;
    display: flex;
    justify-content: space-between;
    margin-bottom: 12px;
}

#designerCache .list.tabular {
    border: 1px solid var(--border-grey-10);
    border-radius: 4px;
    min-width: 900px;
    overflow: hidden;
}

#designerCache.nothingToDisplay .list.tabular.fiveColumn {
    display: none;
}

#designerCache .list.tabular > .leaf.header > .wrap > .column {
    line-height: 1em;
}

#designerCache .list.tabular > .leaf.header > .wrap > .column > p {
    margin-bottom: 0;
}

#designerCache #sortMode {;
    inset: unset;
    position: relative;
}

#designerCache .list.tabular > .leaf.running {
    font-style: italic;
}

#designerCache .list.tabular > .leaf.running > .wrap > .column.one {
    background-image: url(images/list_node_animation.gif);
    background-repeat: no-repeat;
    height: 16px;
}

/* importDataFile */
#importDataFile #fileUploadForm {
    margin: 24px;
    width: 400px;
}

#importDataFile #uploadFile {
    height: 22px;
    width: 100%;
}

#importDataFile .inputSet .leaf > .inputSet .leaf {
    overflow: hidden;
    padding: 3px 17px 0 17px;
}

#browseRepo .control.radio.complex, #blankTemplate .control.radio.complex {
    display: inline-block;
}

/* secret key */
#secretKey .control.radio.twoLine {
    margin-bottom: 10px;
}

#secretKey .control.radio.twoLine > .wrap {
    line-height: 16px;
}

#secretKey input[type="text"],
#secretKey input[type="password"] {
    height: 28px;
}

#secretKey .button.action > .wrap {
    margin-left: 0;
}

/* exportDataFile */
#exportDataFile .export-view {
    min-width: 810px;
    width: 80%;
}

#exportDataFile #filenameId {
    width: 300px;
} /* can't find filenameId in UI anywhere */

#selectRolesUsers {
    margin: 4px;
    width: 750px;
    height: 220px;
    -webkit-user-select: none; /* webkit only */
}

#selectRolesUsers .selectedRoles {
    margin-right: 8px;
}

#selectRolesUsers input[type=text] {
    height: 20px;
    width: 320px;
}

#awsOptions .list.settings .control.input.text {
    display: flex;
    flex-direction: column-reverse;
}
/* --------- */
/*  END 19.  */
/* --------- */


/* ---------------------------------- */
/*  START 20. Server & System Errors  */
/* ---------------------------------- */
/* server error */
#serverError .flow .inputs {
    min-height: 0;
}

#serverError #stepDisplay {
    display: block;
    margin-left: 160px;
}

#serverError #frame {
    min-height: 325px;
}

#serverError .row.instructions {
    margin: 100px auto;
    border: 1px solid var(--border-grey-16);
    width: 400px;
}

#serverError .flow .inputs > .primary > .content > .body {
    bottom: 25px;
}

#serverError .flow .inputs > .primary > .content > .footer {
    height: 25px;
    padding: 0;
}

#serverError #completeStackTrace p,
#serverError #errorMessages p {
    margin-left: 20px;
}

#serverError #completeStackTrace p {
    white-space: pre;
}

#serverError #closeErrorPage.closeIcon {
    float: right;
    width: 19px;
    height: 19px;
    margin: 5px;
    background: url("images/dialogClose.png");
    cursor: pointer;
}

/* system error */
#systemError.anonymous .primaryNav,
#systemError.anonymous #globalSearch,
#systemError.anonymous #userID,
#systemError.anonymous #main_logOut {
    display: none;
}

#systemError.anonymous #help {
    border: none;
}
/* --------- */
/*  END 20.  */
/* --------- */


/* ---------------------------------- */
/*  START 21. SETTINGS, AD HOC CACHE  */
/* ---------------------------------- */
/* move to Server Settings section above */
#designerCache #detail {
    height: 400px;
    width: 400px;
}

#designerCache #detail .data {
    white-space: pre;
    margin-left: 5px;
}

#designerCache.nothingToDisplay .list.tabular.fiveColumn {
    display: none;
}

#designerCache .list.tabular > .leaf.header > .wrap > .column {
    line-height: 1em;
}

#designerCache .list.tabular > .leaf.header > .wrap > .column > p {
    margin-bottom: 0;
}

#designerCache .list.fiveColumn .wrap > .column.one {
    text-align: center;
    white-space: nowrap;
    width: 11%;
    min-width: 130px;
}

#designerCache .list.fiveColumn .wrap > .column.two {
    padding: 0 16px;
    width: 56%;
}

.list.fiveColumn.tabular .header .wrap .column.two {
    margin-left: 8px;
}

#designerCache .list.fiveColumn .wrap > .column.three {
    padding: 0 8px;
    text-align: center;
    white-space: nowrap;
    width: 11%;
}

#designerCache .list.fiveColumn .wrap > .column.four {
    text-align: center;
    white-space: nowrap;
    width: 11%;
    min-width: 120px;
}

#designerCache .list.fiveColumn .wrap > .column.five {
    width: auto;
}

#designerCache .list.fiveColumn.tabular > .list.header div.wrap {
    background-color: #edf2f8;
    height: 28px;
    padding-top: 0;
    padding-bottom: 0;
    padding-left: 10px;
}

#designerCache .list.fiveColumn.tabular > .list.header div.wrap > .column {
    line-height: 28px;
}

#designerCache #sortMode {;
    top: 4px;
}

#designerCache .list.fiveColumn.tabular > .list div.wrap {
    min-width: 1020px;
    padding-top: 10px;
    padding-bottom: 12px;
}

#designerCache .list.fiveColumn .query {
    line-height: 1.182em;
    margin-bottom: 5px;
    max-height: 6em;
    overflow: hidden;
    white-space: pre;
}

#designerCache .list.tabular > .leaf.running {
    font-style: italic;
}

#designerCache .list.tabular > .leaf.running > .wrap > .column.one {
    background-image: url(images/list_node_animation.gif);
    background-repeat: no-repeat;
    height: 16px;
}
/* --------- */
/*  END 21.  */
/* --------- */


/* ------------------------- */
/*  START 22. SINGLE SELECT  */
/* ------------------------- */
/* I'm not sure if we use sSelect any more */
.sSelect {
    position: relative;
    display: inline-block;
    box-sizing: border-box;
    width: 100%;
}

.topOfPage .sSelect {
    width: 220px;
}

.sSelect.collapsed > .sSelect-listContainer {
    /* do not hide component because of IE bug with keeping scroll position */
    left: -9999px;
}

.sSelect-input {
    background-color: #ffffff;
    background-clip: padding-box;
    -moz-background-clip: padding;
    -webkit-background-clip: padding-box;
    box-sizing: border-box;
    color: var(--text-dark) !important;
    display: block;
    height: 26px;
    line-height: 24px;
    margin-top: 4px;
    overflow: hidden;
    padding: 0 0 0 8px;
    position: relative;
    text-decoration: none;
}

.sSelect-input:hover {
    text-decoration: none;
}

.sSelect-input:active {
    color: var(--text-dark);
}

.sSelect-input > span {
    white-space: nowrap;
}

.sSelect.collapsed.focused .sSelect-input {
    border: 1px solid orange;
}

.sSelect.expanded .sSelect-input {
    border-bottom: 0;
}

.sSelect-disclosureContainer {
    display: block;
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: 20px;
}

.sSelect-disclosure {
    display: block;
    height: 100%;
    width: 100%;
    background: #ffffff no-repeat;
}

.sSelect.expanded .sSelect-disclosure {}

.sSelect.collapsed .sSelect-disclosure {
    background-image: url("images/panels_icons_sprite.png");
    background-position: -5px -325px;
}

.sSelect .control.searchLockup > .button.search {
    background-image: url(images/panels_icons_sprite.png);
    background-position: 0 -326px
}

.sSelect-listContainer {
    background: #ffffff;
    box-sizing: border-box;
    border: 1px solid #aaa;
    border-top: 0;
    border-bottom: 0;
    position: absolute;
    width: 100%;
    z-index: 1001;
}

/* start - iPad */
.sSelect.ipad .sSelect-input,
.sSelect.ipad input.sSelect-input[type="text"] {
    height: 30px;
    line-height: 26px;
    background-position: right -117px;
}

.sSelect.ipad .sSelect-disclosureContainer {
    width: 20px;
}

.sSelect.ipad.collapsed .sSelect-disclosure {
    background-position: -5px -323px;
}

.sSelect.ipad.expanded .sSelect-disclosure {
}

.sSelect.ipad .control.searchLockup > .wrap,
.sSelect.ipad .control.searchLockup > .wrap > input[type="text"] {
    height: 24px;
}

.sSelect.ipad .control.searchLockup .button.search {
    height: 25px;
    background-position: 0 -325px
}

.sSelect-dropDown.ipad .sSelect-list li {
    height: 35px;
    line-height: 35px;
}
/* end - iPad */

.sSelect-sSearch {
    position: relative;
    z-index: 1010;
    white-space: nowrap;
    padding: 3px 4px;
    margin: 0 0 2px 0;
    border-top: 1px solid #ececec;
}

.sSelect .searchLockup {
    float: none;
    width: auto;
    margin: 1px 0;
}

.sSelect .control.searchLockup > .wrap {
    background-color: #ffffff !important;
}

.sSelect .control.searchLockup > .button.search {
    border-left: 0 !important;
}

.sSelect .control.searchLockup > .wrap > input[type="text"] {
    box-sizing: border-box;
    height: 100%;
    padding-right: 28px;
    width: 100%;
}

.sSelect-list {
    margin: 0;
    padding: 0;
    position: relative;
}

.sSelect-list li {
    cursor: pointer;
    line-height: 16px;
    padding: 0 6px;
    white-space: nowrap;
}

.sSelect-list li a {
    text-decoration: none;
}

.sSelect-dropDown {
    position: absolute;
    background-color: #ffffff;
    z-index: 1001;
    -moz-box-shadow: 0 4px 4px rgba(51, 51, 51, 0.5);
    -webkit-box-shadow: 0 4px 4px rgba(51, 51, 51, 0.5);
    box-shadow: 0 4px 4px rgba(51, 51, 51, 0.5);

    /* border */
    box-sizing: border-box;
    border: 1px solid #aaa;
    border-top: 0;
}

.sSelect-dropDown .sList {
    border: none;
}

/* special width requirements to match other input controls */
.list.inputControls .ssPlaceholder,
.list.inputControls .msPlaceholder {
    width: 100%;
}

.msPlaceholder:disabled,
.msPlaceholder[disabled] {
    opacity: .4;
}

.topOfPage .ssPlaceholder > div {
    min-width: 220px;
}
/* --------- */
/*  END 22.  */
/* --------- */


