}

#reportViewer .header .controls .list.buttonSet #viewAlertList .icon {
    background-position: -115px -569px;
}

#reportViewer .header .controls .list.buttonSet #viewAlertList.over .icon,
#reportViewer .header .controls .list.buttonSet #viewAlertList.pressed .icon,
