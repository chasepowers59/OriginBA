}

#reportViewer .header .controls .list.buttonSet #viewAlertList.hasAlerts.over .icon,
#reportViewer .header .controls .list.buttonSet #viewAlertList.hasAlerts.pressed .icon,
#reportViewer .header .controls .list.buttonSet #viewAlertList.hasAlerts.down .icon {
    background-position: -205px -539px;
}

#reportViewer .list.buttonSet > .node.conditional {
