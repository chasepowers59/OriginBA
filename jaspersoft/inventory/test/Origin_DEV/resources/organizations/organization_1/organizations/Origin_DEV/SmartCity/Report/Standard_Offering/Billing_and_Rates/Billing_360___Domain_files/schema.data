        <field id="BSEG_SQ_ROW_COUNT" dataSetExpression="CountDistinct(Concatenate(CI_BSEG_SQ.BSEG_ID, '_', CI_BSEG_SQ.UOM_CD, '_', CI_BSEG_SQ.TOU_CD, '_', CI_BSEG_SQ.SQI_CD), 'Current')" type="java.lang.Long"></field>
        <field id="BSEG_READ_ROW_COUNT" dataSetExpression="CountDistinct(Concatenate(CI_BSEG_READ.BSEG_ID, '_', CI_BSEG_READ.SEQNO), 'Current')" type="java.lang.Long"></field>
        <field id="BSEG_CALC_HEADER_COUNT" dataSetExpression="CountDistinct(Concatenate(CI_BSEG_CALC.BSEG_ID, '_', CI_BSEG_CALC.HEADER_SEQ), 'Current')" type="java.lang.Long"></field>
        <field id="BSEG_CALC_LINE_COUNT" dataSetExpression="CountDistinct(Concatenate(CI_BSEG_CALC_LN.BSEG_ID, '_', CI_BSEG_CALC_LN.HEADER_SEQ, '_', CI_BSEG_CALC_LN.SEQNO), 'Current')" type="java.lang.Long"></field>
        <field id="BSEG_ITEM_COUNT" dataSetExpression="CountDistinct(Concatenate(CI_BSEG_ITEM.BSEG_ID, '_', CI_BSEG_ITEM.SEQNO), 'Current')" type="java.lang.Long"></field>
        <field id="BSEG_EXCEPTION_COUNT" dataSetExpression="CountDistinct(Concatenate(CI_BSEG_EXCP.BSEG_ID, '_', CI_BSEG_EXCP.MESSAGE_CAT_NBR, '_', CI_BSEG_EXCP.MESSAGE_NBR, '_', CI_BSEG_EXCP.CRE_DTTM), 'Current')" type="java.lang.Long"></field>
        <field id="BILL_ROUTING_COUNT" dataSetExpression="CountDistinct(Concatenate(CI_BILL_ROUTING.BILL_ID, '_', CI_BILL_ROUTING.SEQNO), 'Current')" type="java.lang.Long"></field>
        <field id="BILL_MESSAGE_COUNT" dataSetExpression="CountDistinct(Concatenate(CI_BILL_MSGS.BILL_ID, '_', CI_BILL_MSGS.BILL_MSG_CD), 'Current')" type="java.lang.Long"></field>
        <field id="BILL_MESSAGE_PARAMETER_COUNT" dataSetExpression="CountDistinct(Concatenate(CI_BILL_MSG_PRM.BILL_ID, '_', CI_BILL_MSG_PRM.BILL_MSG_CD, '_', CI_BILL_MSG_PRM.SEQ_NUM), 'Current')" type="java.lang.Long"></field>
        <field id="BILL_CHARACTERISTIC_COUNT" dataSetExpression="CountDistinct(Concatenate(CI_BILL_CHAR.BILL_ID, '_', CI_BILL_CHAR.CHAR_TYPE_CD, '_', CI_BILL_CHAR.SEQ_NUM), 'Current')" type="java.lang.Long"></field>
        <field id="BILL_SA_SUMMARY_COUNT" dataSetExpression="CountDistinct(Concatenate(CI_BILL_SA.BILL_ID, '_', CI_BILL_SA.SA_ID), 'Current')" type="java.lang.Long"></field>
        <field id="BILL_EXCEPTION_COUNT" dataSetExpression="CountDistinct(Concatenate(CI_BILL_EXCP.BILL_ID, '_', CI_BILL_EXCP.MESSAGE_CAT_NBR, '_', CI_BILL_EXCP.MESSAGE_NBR), 'Current')" type="java.lang.Long"></field>
      </fieldList>
      <joinInfo alias="CI_BILL" referenceId="CI_BILL"></joinInfo>
      <joinList>
        <join expr="CI_BILL.BILL_ID == CI_BSEG.BILL_ID" left="CI_BILL" right="CI_BSEG" type="leftOuter" weight="1"></join>
        <join expr="CI_BILL.ACCT_ID == CI_ACCT.ACCT_ID" left="CI_BILL" right="CI_ACCT" type="leftOuter" weight="1"></join>
        <join expr="CI_ACCT.ACCT_ID == CI_ACCT_PER.ACCT_ID and CI_ACCT_PER.MAIN_CUST_SW == 'Y'" left="CI_ACCT" right="CI_ACCT_PER" type="leftOuter" weight="1"></join>
        <join expr="CI_ACCT_PER.PER_ID == CI_PER_NAME.PER_ID and CI_PER_NAME.NAME_TYPE_FLG == 'PRIM'" left="CI_ACCT_PER" right="CI_PER_NAME" type="leftOuter" weight="1"></join>
        <join expr="CI_BSEG.SA_ID == CI_SA.SA_ID" left="CI_BSEG" right="CI_SA" type="leftOuter" weight="1"></join>
        <join expr="CI_BILL.BILL_CYC_CD == BILL_CYCLE_L.BILL_CYC_CD and BILL_CYCLE_L.LANGUAGE_CD == 'ENG'" left="CI_BILL" right="BILL_CYCLE_L" type="leftOuter" weight="1"></join>
        <join expr="CI_BSEG.BILL_CYC_CD == BSEG_CYCLE_L.BILL_CYC_CD and BSEG_CYCLE_L.LANGUAGE_CD == 'ENG'" left="CI_BSEG" right="BSEG_CYCLE_L" type="leftOuter" weight="1"></join>
        <join expr="CI_BILL.BILL_STAT_FLG == BILL_STATUS_L.FIELD_VALUE and BILL_STATUS_L.FIELD_NAME == 'BILL_STAT_FLG' and BILL_STATUS_L.LANGUAGE_CD == 'ENG'" left="CI_BILL" right="BILL_STATUS_L" type="leftOuter" weight="1"></join>
        <join expr="CI_BILL.DOC_TYPE_FLG == BILL_DOC_TYPE_L.FIELD_VALUE and BILL_DOC_TYPE_L.FIELD_NAME == 'DOC_TYPE_FLG' and BILL_DOC_TYPE_L.LANGUAGE_CD == 'ENG'" left="CI_BILL" right="BILL_DOC_TYPE_L" type="leftOuter" weight="1"></join>
        <join expr="CI_BSEG.BSEG_STAT_FLG == BSEG_STATUS_L.FIELD_VALUE and BSEG_STATUS_L.FIELD_NAME == 'BSEG_STAT_FLG' and BSEG_STATUS_L.LANGUAGE_CD == 'ENG'" left="CI_BSEG" right="BSEG_STATUS_L" type="leftOuter" weight="1"></join>
        <join expr="CI_BSEG.CAN_RSN_CD == BSEG_CAN_RSN_L.CAN_RSN_CD and BSEG_CAN_RSN_L.LANGUAGE_CD == 'ENG'" left="CI_BSEG" right="BSEG_CAN_RSN_L" type="leftOuter" weight="1"></join>
        <join expr="CI_BSEG.BSEG_ID == CI_BSEG_SQ.BSEG_ID" left="CI_BSEG" right="CI_BSEG_SQ" type="leftOuter" weight="1"></join>
        <join expr="CI_BSEG.BSEG_ID == CI_BSEG_READ.BSEG_ID" left="CI_BSEG" right="CI_BSEG_READ" type="leftOuter" weight="1"></join>
        <join expr="CI_BSEG.BSEG_ID == CI_BSEG_CALC.BSEG_ID" left="CI_BSEG" right="CI_BSEG_CALC" type="leftOuter" weight="1"></join>
        <join expr="CI_BSEG_CALC.BSEG_ID == CI_BSEG_CALC_LN.BSEG_ID and CI_BSEG_CALC.HEADER_SEQ == CI_BSEG_CALC_LN.HEADER_SEQ" left="CI_BSEG_CALC" right="CI_BSEG_CALC_LN" type="leftOuter" weight="1"></join>
        <join expr="CI_BSEG.BSEG_ID == CI_BSEG_ITEM.BSEG_ID" left="CI_BSEG" right="CI_BSEG_ITEM" type="leftOuter" weight="1"></join>
