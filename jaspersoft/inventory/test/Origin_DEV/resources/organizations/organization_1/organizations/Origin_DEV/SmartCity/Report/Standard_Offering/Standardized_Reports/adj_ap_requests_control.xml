            <name>REQ_STATUS_F</name>
            <version>0</version>
            <label>A/P request status (blank = all)</label>
            <creationDate>2026-09-23T14:49:19.000Z</creationDate>
            <updateDate>2026-09-23T14:49:19.000Z</updateDate>
            <type>4</type>
            <mandatory>false</mandatory>
            <readOnly>false</readOnly>
            <visible>true</visible>
            <query>
                <localResource exportedWithPermissions="false" xsi:type="query">
                    <folder>/organizations/organization_1/organizations/Origin_DEV/SmartCity/Report/Standard_Offering/Standardized_Reports/adj_ap_requests_control_files/REQ_STATUS_F_files</folder>
                    <name>REQ_STATUS_F_query</name>
                    <version>0</version>
                    <label>REQ_STATUS_F_query</label>
                    <creationDate>2026-09-23T14:49:19.000Z</creationDate>
                    <updateDate>2026-09-23T14:49:19.000Z</updateDate>
                    <language>sql</language>
                    <queryString>SELECT TRIM(l.field_value) AS CODE, TRIM(l.field_value) || ' - ' || l.descr AS DESCR FROM CISADM.CI_LOOKUP_VAL_L l WHERE TRIM(l.field_name) = 'PYMNT_SEL_STAT_FLG' AND l.language_cd = 'ENG' AND EXISTS (SELECT 1 FROM CISADM.CI_ADJ_APREQ r JOIN CISADM.CI_ADJ a ON a.adj_id = r.adj_id WHERE TRIM(r.pymnt_sel_stat_flg) = TRIM(l.field_value) AND a.cre_dt &gt;= CURRENT_DATE - INTERVAL '3' YEAR) ORDER BY 1</queryString>
                    <dataSource>
                        <uri>/organizations/organization_1/organizations/Origin_DEV/DataSource/Origin_DEV_DS</uri>
                    </dataSource>
                </localResource>
            </query>
            <queryVisibleColumn>DESCR</queryVisibleColumn>
            <queryValueColumn>CODE</queryValueColumn>
        </localResource>
