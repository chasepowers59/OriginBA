            <query>
                <localResource exportedWithPermissions="false" xsi:type="query">
                    <folder>/organizations/organization_1/organizations/Origin_DEV/SmartCity/Report/Standard_Offering/Billing_and_Rates/billing_by_cycle_period_files/BILL_CYC_CD_F_files</folder>
                    <name>BILL_CYC_CD_F_query</name>
                    <version>0</version>
                    <label>BILL_CYC_CD_F_query</label>
                    <creationDate>2026-09-18T11:09:54.000Z</creationDate>
                    <updateDate>2026-09-18T11:09:54.000Z</updateDate>
                    <language>sql</language>
                    <queryString>SELECT TRIM(bill_cyc_cd) AS CODE, TRIM(bill_cyc_cd) || ' - ' || descr AS DESCR FROM CISADM.CI_BILL_CYC_L l WHERE l.language_cd = 'ENG' AND EXISTS (SELECT 1 FROM CISADM.CI_BILL b WHERE b.bill_cyc_cd = l.bill_cyc_cd AND b.bill_dt &gt;= CURRENT_DATE - INTERVAL '3' YEAR) ORDER BY 1</queryString>
                    <dataSource>
                        <uri>/organizations/organization_1/organizations/Origin_DEV/DataSource/Origin_DEV_DS</uri>
                    </dataSource>
                </localResource>
            </query>
            <queryVisibleColumn>DESCR</queryVisibleColumn>
            <queryValueColumn>CODE</queryValueColumn>
        </localResource>
