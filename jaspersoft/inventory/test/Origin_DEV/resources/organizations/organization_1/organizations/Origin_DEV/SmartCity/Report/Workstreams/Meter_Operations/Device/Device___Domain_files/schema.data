    <jdbcQuery id="CMS_DVC_ACCT" datasourceId="Origin_DEV_DS">
      <fieldList>
        <field id="D1_DEVICE_ID" type="java.lang.String"></field>
        <field id="D1_SP_ID" type="java.lang.String"></field>
        <field id="SP_ID" type="java.lang.String"></field>
        <field id="ACCT_ID" type="java.lang.String"></field>
        <field id="SA_STATUS_FLG" type="java.lang.String"></field>
      </fieldList>
      <query>select
  distinct dvcfg.d1_device_id, ievt.d1_sp_id, spid.id_value as sp_id, sa.acct_id, sa.sa_status_flg
from 
  cisadm.d1_dvc_cfg dvcfg,
  cisadm.d1_install_evt ievt,
  cisadm.d1_sp_identifier spid,
  cisadm.ci_sa_sp sasp,
  cisadm.ci_sa sa
where 
  dvcfg.bo_status_cd = 'ACTIVE'
  and dvcfg.device_config_id = ievt.device_config_id
  and ievt.d1_sp_id = spid.d1_sp_id
  and spid.sp_id_type_flg = 'D1EI'
  and spid.id_value = sasp.sp_id
  and sasp.sa_id = sa.sa_id
  and sa.sa_status_flg in ('10','20','30','40','50')
and dvcfg.eff_dttm = (select max(dvcfg2.eff_dttm) from cisadm.d1_dvc_cfg dvcfg2 where dvcfg2.d1_device_id = dvcfg.d1_device_id)</query>
    </jdbcQuery>
    <jdbcQuery id="CMS_IEVT_LATEST" datasourceId="Origin_DEV_DS">
      <fieldList>
        <field id="DEVICE_CONFIG_ID" type="java.lang.String"></field>
        <field id="LATEST_INSTALL_DTTM" type="java.sql.Timestamp"></field>
      </fieldList>
      <query>select
  ievt.device_config_id, max(d1_install_dttm) as LATEST_INSTALL_DTTM
from
  cisadm.d1_install_evt ievt
group by 
  ievt.device_config_id</query>
    </jdbcQuery>
    <jdbcQuery id="CMS_DVC_CFG_EFFECTIVE" datasourceId="Origin_DEV_DS">
      <fieldList>
        <field id="D1_DEVICE_ID" type="java.lang.String"></field>
        <field id="LATEST_EFFDT" type="java.sql.Timestamp"></field>
      </fieldList>
      <query>select
  dvcfg.d1_device_id, max(dvcfg.eff_dttm) "LATEST_EFFDT"
from
  cisadm.d1_dvc_cfg dvcfg
where
  dvcfg.eff_dttm &lt;= TRUNC(SYSDATE)
group by 
  dvcfg.d1_device_id</query>
    </jdbcQuery>
    <jdbcQuery id="CMS_DVC_EVT_LATEST" datasourceId="Origin_DEV_DS">
      <fieldList>
        <field id="D1_DEVICE_ID" type="java.lang.String"></field>
        <field id="LATEST_DEVT_DTTM" type="java.sql.Timestamp"></field>
      </fieldList>
      <query>select
  devt.d1_device_id, max(devt.dvc_evt_dttm) LATEST_DEVT_DTTM
from
  cisadm.d1_dvc_evt devt
where
  devt.dvc_evt_dttm &lt; sysdate
group by
  devt.d1_device_id</query>
    </jdbcQuery>
