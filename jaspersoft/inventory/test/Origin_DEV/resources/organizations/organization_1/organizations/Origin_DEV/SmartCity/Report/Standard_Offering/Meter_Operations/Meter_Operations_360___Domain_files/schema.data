      <joinInfo alias="D1_INSTALL_EVT" referenceId="D1_INSTALL_EVT"></joinInfo>
      <joinList>
        <join expr="D1_INSTALL_EVT.DEVICE_CONFIG_ID == D1_DVC_CFG.DEVICE_CONFIG_ID" left="D1_INSTALL_EVT" right="D1_DVC_CFG" type="leftOuter" weight="1"></join>
        <join expr="D1_DVC_CFG.D1_DEVICE_ID == D1_DVC.D1_DEVICE_ID" left="D1_DVC_CFG" right="D1_DVC" type="leftOuter" weight="1"></join>
        <join expr="D1_DVC.D1_DEVICE_ID == CMS_D1_DVC_IDENTIFIER_VW.D1_DEVICE_ID" left="D1_DVC" right="CMS_D1_DVC_IDENTIFIER_VW" type="leftOuter" weight="1"></join>
        <join expr="D1_DVC.D1_DEVICE_ID == D1_DVC_IDENTIFIER.D1_DEVICE_ID" left="D1_DVC" right="D1_DVC_IDENTIFIER" type="leftOuter" weight="1"></join>
        <join expr="D1_DVC.D1_DEVICE_ID == D1_DVC_CHAR.D1_DEVICE_ID" left="D1_DVC" right="D1_DVC_CHAR" type="leftOuter" weight="1"></join>
        <join expr="D1_DVC.D1_DEVICE_ID == D1_DVC_EVT.D1_DEVICE_ID" left="D1_DVC" right="D1_DVC_EVT" type="leftOuter" weight="1"></join>
        <join expr="D1_DVC_CFG.DEVICE_CONFIG_ID == D1_MEASR_COMP.DEVICE_CONFIG_ID" left="D1_DVC_CFG" right="D1_MEASR_COMP" type="leftOuter" weight="1"></join>
        <join expr="D1_MEASR_COMP.MEASR_COMP_ID == D1_MSRMT.MEASR_COMP_ID" left="D1_MEASR_COMP" right="D1_MSRMT" type="leftOuter" weight="1"></join>
        <join expr="D1_MEASR_COMP.MEASR_COMP_ID == D1_INIT_MSRMT_DATA.MEASR_COMP_ID" left="D1_MEASR_COMP" right="D1_INIT_MSRMT_DATA" type="leftOuter" weight="1"></join>
        <join expr="D1_INIT_MSRMT_DATA.INIT_MSRMT_DATA_ID == D1_VEE_EXCP.INIT_MSRMT_DATA_ID" left="D1_INIT_MSRMT_DATA" right="D1_VEE_EXCP" type="leftOuter" weight="1"></join>
        <join expr="D1_INSTALL_EVT.D1_SP_ID == D1_SP.D1_SP_ID" left="D1_INSTALL_EVT" right="D1_SP" type="leftOuter" weight="1"></join>
        <join expr="D1_DVC.D1_DEVICE_ID == CMS_DVC_ACCT.D1_DEVICE_ID" left="D1_DVC" right="CMS_DVC_ACCT" type="leftOuter" weight="1"></join>
        <join expr="CMS_DVC_ACCT.SP_ID == CI_SP.SP_ID" left="CMS_DVC_ACCT" right="CI_SP" type="leftOuter" weight="1"></join>
        <join expr="CI_SP.PREM_ID == CI_PREM.PREM_ID" left="CI_SP" right="CI_PREM" type="leftOuter" weight="1"></join>
        <join expr="CMS_DVC_ACCT.ACCT_ID == CI_ACCT_PER.ACCT_ID and CI_ACCT_PER.MAIN_CUST_SW == 'Y'" left="CMS_DVC_ACCT" right="CI_ACCT_PER" type="leftOuter" weight="1"></join>
        <join expr="CI_ACCT_PER.PER_ID == CI_PER_NAME.PER_ID and CI_PER_NAME.PRIM_NAME_SW == 'Y'" left="CI_ACCT_PER" right="CI_PER_NAME" type="leftOuter" weight="1"></join>
        <join expr="CMS_D1_DVC_IDENTIFIER_VW.ASSET_ID == W1_ASSET.ASSET_ID" left="CMS_D1_DVC_IDENTIFIER_VW" right="W1_ASSET" type="leftOuter" weight="1"></join>
        <join expr="W1_ASSET.ASSET_ID == W1_ASSET_IDENTIFIER.ASSET_ID" left="W1_ASSET" right="W1_ASSET_IDENTIFIER" type="leftOuter" weight="1"></join>
        <join expr="W1_ASSET.ASSET_ID == W1_ASSET_NODE.ASSET_ID" left="W1_ASSET" right="W1_ASSET_NODE" type="leftOuter" weight="1"></join>
        <join expr="W1_ASSET_NODE.NODE_ID == W1_NODE.NODE_ID" left="W1_ASSET_NODE" right="W1_NODE" type="leftOuter" weight="1"></join>
        <join expr="W1_ASSET.ASSET_ID == W1_ASSET_CHAR.ASSET_ID" left="W1_ASSET" right="W1_ASSET_CHAR" type="leftOuter" weight="1"></join>
        <join expr="D1_INSTALL_EVT.D1_SP_ID == D1_US_SP.D1_SP_ID" left="D1_INSTALL_EVT" right="D1_US_SP" type="leftOuter" weight="1"></join>
        <join expr="D1_US_SP.US_ID == D1_US.US_ID" left="D1_US_SP" right="D1_US" type="leftOuter" weight="1"></join>
        <join expr="D1_US.US_ID == D1_USAGE.US_ID" left="D1_US" right="D1_USAGE" type="leftOuter" weight="1"></join>
        <join expr="D1_USAGE.D1_USAGE_ID == D1_USAGE_SCALAR_DTL.D1_USAGE_ID" left="D1_USAGE" right="D1_USAGE_SCALAR_DTL" type="leftOuter" weight="1"></join>
        <join expr="D1_USAGE.D1_USAGE_ID == D1_USAGE_PERIOD_SQ.D1_USAGE_ID" left="D1_USAGE" right="D1_USAGE_PERIOD_SQ" type="leftOuter" weight="1"></join>
        <join expr="D1_USAGE.D1_USAGE_ID == D1_USAGE_EXCP.D1_USAGE_ID" left="D1_USAGE" right="D1_USAGE_EXCP" type="leftOuter" weight="1"></join>
      </joinList>
