        <field id="D1_MSRMT.CRE_DTTM" type="java.sql.Timestamp"></field>
        <field id="D1_MSRMT.VERSION" type="java.math.BigDecimal"></field>
        <field id="D1_MSRMT.MSRMT_VAL1" type="java.math.BigDecimal"></field>
        <field id="D1_MSRMT.MSRMT_VAL2" type="java.math.BigDecimal"></field>
        <field id="D1_MSRMT.MSRMT_VAL3" type="java.math.BigDecimal"></field>
        <field id="D1_MSRMT.MSRMT_VAL4" type="java.math.BigDecimal"></field>
        <field id="D1_MSRMT.MSRMT_VAL5" type="java.math.BigDecimal"></field>
        <field id="DEVICE_COUNT" dataSetExpression="CountDistinct(D1_DVC.D1_DEVICE_ID, 'Current')" type="java.lang.Long"></field>
        <field id="ASSET_COUNT" dataSetExpression="CountDistinct(W1_ASSET.ASSET_ID, 'Current')" type="java.lang.Long"></field>
        <field id="INSTALL_EVENT_COUNT" dataSetExpression="CountDistinct(D1_INSTALL_EVT.INSTALL_EVT_ID, 'Current')" type="java.lang.Long"></field>
        <field id="MEASURING_COMPONENT_COUNT" dataSetExpression="CountDistinct(D1_MEASR_COMP.MEASR_COMP_ID, 'Current')" type="java.lang.Long"></field>
        <field id="MEASUREMENT_COUNT" dataSetExpression="CountDistinct(Concatenate(D1_MSRMT.MEASR_COMP_ID, '_', D1_MSRMT.MSRMT_DTTM), 'Current')" type="java.lang.Long"></field>
        <field id="USAGE_TRANSACTION_COUNT" dataSetExpression="CountDistinct(D1_USAGE.D1_USAGE_ID, 'Current')" type="java.lang.Long"></field>
        <field id="USAGE_EXCEPTION_COUNT" dataSetExpression="CountDistinct(D1_USAGE_EXCP.USAGE_EXCP_ID, 'Current')" type="java.lang.Long"></field>
        <field id="VEE_EXCEPTION_COUNT" dataSetExpression="CountDistinct(D1_VEE_EXCP.VEE_EXCP_ID, 'Current')" type="java.lang.Long"></field>
