            <query>
                <localResource exportedWithPermissions="false" xsi:type="query">
                    <folder>/organizations/organization_1/organizations/Origin_DEV/SmartCity/Report/Standard_Offering/Cashiering/payments_by_tender_type_period_files/TENDER_TYPE_CD_F_files</folder>
                    <name>TENDER_TYPE_CD_F_query</name>
                    <version>0</version>
                    <label>TENDER_TYPE_CD_F_query</label>
                    <creationDate>2026-09-18T11:09:55.000Z</creationDate>
                    <updateDate>2026-09-18T11:09:55.000Z</updateDate>
                    <language>sql</language>
                    <queryString>SELECT TRIM(tender_type_cd) AS CODE, TRIM(tender_type_cd) || ' - ' || descr AS DESCR FROM CISADM.CI_TENDER_TYPE_L l WHERE l.language_cd = 'ENG' AND EXISTS (SELECT 1 FROM CISADM.CI_PAY_TNDR t JOIN CISADM.CI_PAY_EVENT e ON e.pay_event_id = t.pay_event_id WHERE t.tender_type_cd = l.tender_type_cd AND e.pay_dt &gt;= CURRENT_DATE - INTERVAL '3' YEAR) ORDER BY 1</queryString>
                    <dataSource>
                        <uri>/organizations/organization_1/organizations/Origin_DEV/DataSource/Origin_DEV_DS</uri>
                    </dataSource>
                </localResource>
            </query>
            <queryVisibleColumn>DESCR</queryVisibleColumn>
            <queryValueColumn>CODE</queryValueColumn>
        </localResource>
