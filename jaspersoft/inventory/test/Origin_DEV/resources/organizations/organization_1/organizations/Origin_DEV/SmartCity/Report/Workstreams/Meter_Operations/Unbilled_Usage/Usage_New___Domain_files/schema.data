  <resources>
    <jdbcTable id="D1_USAGE" datasourceId="Origin_DEV_DS" datasourceTableName="D1_USAGE" schemaAlias="CISADM">
      <fieldList>
        <field id="D1_USAGE_ID" type="java.lang.String"></field>
        <field id="US_ID" type="java.lang.String"></field>
        <field id="USG_EXT_ID" type="java.lang.String"></field>
        <field id="BUS_OBJ_CD" type="java.lang.String"></field>
        <field id="BO_STATUS_CD" type="java.lang.String"></field>
        <field id="BO_STATUS_REASON_CD" type="java.lang.String"></field>
        <field id="START_DTTM" type="java.sql.Timestamp"></field>
        <field id="END_DTTM" type="java.sql.Timestamp"></field>
        <field id="STATUS_UPD_DTTM" type="java.sql.Timestamp"></field>
        <field id="SCH_SELECTION_DT" type="java.sql.Timestamp"></field>
        <field id="USG_GRP_CD" type="java.lang.String"></field>
        <field id="D1_USG_CAL_TYPE_CD" type="java.lang.String"></field>
        <field id="USG_SRC_FLG" type="java.lang.String"></field>
        <field id="MSRMT_CYC_CD" type="java.lang.String"></field>
        <field id="MSRMT_CYC_RTE_CD" type="java.lang.String"></field>
        <field id="D1_SPR_CD" type="java.lang.String"></field>
        <field id="USED_ON_BILL_FLG" type="java.lang.String"></field>
        <field id="LINKED_TO_FRZN_BSEG_FLG" type="java.lang.String"></field>
        <field id="TOT_USG_TRANS_CNT" type="java.math.BigDecimal"></field>
      </fieldList>
      <filterString>BUS_OBJ_CD == 'D2-UsageTransaction           ' and START_DTTM &gt;= ts'2025-11-01'</filterString>
    </jdbcTable>
    <jdbcTable id="D1_US" datasourceId="Origin_DEV_DS" datasourceTableName="D1_US" schemaAlias="CISADM">
      <fieldList>
        <field id="US_ID" type="java.lang.String"></field>
        <field id="BUS_OBJ_CD" type="java.lang.String"></field>
        <field id="BO_STATUS_CD" type="java.lang.String"></field>
        <field id="US_TYPE_CD" type="java.lang.String"></field>
        <field id="D1_SPR_CD" type="java.lang.String"></field>
        <field id="USG_APPR_REQ_FLG" type="java.lang.String"></field>
        <field id="US_STAT_COND_FLG" type="java.lang.String"></field>
        <field id="D1_BILL_CYC_CD" type="java.lang.String"></field>
        <field id="DIVISION_CD" type="java.lang.String"></field>
        <field id="TIME_ZONE_CD" type="java.lang.String"></field>
        <field id="ACCESS_GRP_CD" type="java.lang.String"></field>
        <field id="START_DTTM" type="java.sql.Timestamp"></field>
        <field id="END_DTTM" type="java.sql.Timestamp"></field>
        <field id="STATUS_UPD_DTTM" type="java.sql.Timestamp"></field>
        <field id="MOST_RECENT_TRANS_DTTM" type="java.sql.Timestamp"></field>
      </fieldList>
      <filterString>BO_STATUS_CD == 'ACTIVE'</filterString>
    </jdbcTable>
