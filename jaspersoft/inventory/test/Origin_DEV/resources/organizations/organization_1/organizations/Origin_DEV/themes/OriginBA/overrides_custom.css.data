/*
 * OriginBA custom theme for JasperReports Server
 * Built from overrides_custom.css only.
 */

:root {
    --origin-sapphire: #006FAC;
    --origin-blue: #3BAFE2;
    --origin-indigo: #1348AB;
    --origin-cream: #F5F0EB;
    --origin-text: #102A43;
    --origin-border: #D9E2EC;
    --origin-success: #64D0DE;
    --origin-warning: #E9870D;
    --origin-danger: #BE4D21;
    --origin-shadow: 0 8px 24px rgba(16, 32, 63, 0.10);
    --origin-radius: 10px;
}

html,
body,
input,
select,
textarea,
button,
.button,
.jr,
.jr * {
    font-family: Aptos, "Segoe UI", Arial, sans-serif;
}

html,
body {
    background: var(--origin-cream);
    color: var(--origin-text);
}

body {
    text-rendering: optimizeLegibility;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
}

a,
a:link,
a:visited,
.textAccent02,
.jr-mLinkTheme.jr,
.jr-mButtonLink.jr,
.jr-mButton-labelTheme.jr {
    color: var(--origin-sapphire);
}

a:hover,
a:active,
.workflow-description a:hover,
.resourceBlock a:hover {
    color: var(--origin-indigo);
}

.banner,
#frameFooter {
    background: linear-gradient(90deg, var(--origin-indigo), var(--origin-sapphire));
    color: #ffffff;
    box-shadow: var(--origin-shadow);
}

.banner *,
#frameFooter * {
    color: #ffffff;
}

#frameFooter {
    border-top: 1px solid rgba(255, 255, 255, 0.18);
}

.column.decorated,
.panel,
.resourceBlock,
.list.tabular,
.list.resources,
.list.jobs,
.dialog,
.jive_dialog,
.jr-mPanel.jr,
.jr-mDialog.jr,
.jr-mTablePresentation.jr,
#loginPage #copy,
#loginPage #loginForm,
.content .body,
.flow #stepDisplay .column.primary,
.flow #stepDisplay .column.secondary {
    border-radius: var(--origin-radius);
    box-shadow: var(--origin-shadow);
}

.column.decorated > .content > .header,
.column.decorated > .content > .header > .subheader,
.resourceBlock-header,
.list.tabular.resources.header,
.list.tabular.jobs.header,
.jr-mPanel-header.jr,
.jr-mDialog-header.jr,
.jr-mTablePresentation.jr .jr-mTable-header.jr {
    background: linear-gradient(180deg, #ffffff 0%, #f8fafc 100%);
    border-bottom: 1px solid var(--origin-border);
}

.button,
.button.action,
.button.capsule,
.jr-mButton.jr,
.jr-mButtonPrimary.jr,
.jr-mButtonOutline.jr,
.jr-mTab-item.jr,
.menu.primaryNav .wrap,
.menu.vertical li > .wrap,
.list > li > .wrap,
.list.filters > li > .wrap,
.sList li,
.mSelect-svList-button {
    border-radius: 8px;
    transition: background-color 0.15s ease, color 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease, transform 0.15s ease;
}

.button:hover,
.button:focus,
.jr-mButton.jr:hover,
.jr-mButton.jr:focus,
.jr-mTab-item.jr:hover,
.list > li > .wrap:hover {
    transform: translateY(-1px);
}

.button.action.primary,
.button.action.primary.pressed,
.button.action.primary.pressed.over,
.jr-mButtonPrimary.jr,
.jr-mButtonAction.jr-mButtonOutline.jr-isDown.jr {
    background: var(--origin-indigo);
    background-image: none;
    color: #ffffff;
    border-color: var(--origin-indigo);
}

.button.action.primary.over,
.jr-mButtonPrimary.jr:hover,
.jr-mButtonPrimary.jr:focus {
    background: var(--origin-sapphire);
    border-color: var(--origin-sapphire);
}

.button.capsule.up.over,
.button.capsule.down,
.button.capsule.down.over,
.button.capsule.down.pressed,
.button.capsule.superfocus.subfocus:hover,
#reportViewer .toolsRight .button.action.up.over,
#reportViewer .toolsRight .button.action.up.pressed,
#reportViewer .toolsRight .button.action.down,
#reportViewer .toolsRight .button.action.down.over,
#reportViewer .toolsRight .button.action.down.pressed,
#reportViewer #asyncCancel,
#reportViewer .toolbar #fileOptions.pressed,
#reportViewer .toolbar #export.pressed,
#designer .toolbar .buttonSet .node > .button.pressed,
#tableOptions.over,
#chartOptions.over,
#reportPartsContainer .button.action.up.over,
.dashboardToolbar #save.pressed,
.dashboardToolbar #export.pressed,
.dashboardCanvas .dashletToolbar .button.text.cancelDashletButton,
.dashboardCanvas .dashletToolbar .button.exportDashletButton.pressed,
.sourceDialogNew .header .button.over.subfocus {
    background: var(--origin-sapphire);
    color: #ffffff;
}

.button.capsule.up.pressed,
.button.capsule.superfocus.subfocus.pressed,
.button.capsule.down.over,
.action.small.up.over,
.action.small.up.pressed,
.action.small.pressed.over,
.action.small.down,
.action.small.down.over,
.action.small.down.pressed {
    background: var(--origin-blue);
    color: #ffffff;
}

.addNewItem,
a.addNewItem {
    border: 1px solid var(--origin-indigo);
    color: var(--origin-indigo);
    background: rgba(255,255,255,0.72);
}

.addNewItem:hover,
a.addNewItem:hover {
    background: rgba(0,111,172,0.08);
}

.menu.primaryNav .wrap.over,
.menu.primaryNav .wrap.pressed,
.menu.vertical li > .wrap.over,
.menu.vertical li > .wrap.pressed,
#metaLinks li.subfocus:not(select),
.list > li.selected > .wrap,
.list > li.selected > .wrap.over,
.list.filters > li > .wrap.over,
.list.filters > li > .wrap.pressed,
.list.filters > li:not(.selected) > .wrap.over,
.list.filters > li:not(.selected) > .wrap.pressed,
.sList li.selected,
.mSelect-svList > .selected .mSelect-svList-button,
.sList li.active.selected,
.mSelect-svList > .active.selected .mSelect-svList-button,
.authorityPicker .selected,
.authorityPicker .highlighted.selected,
.tabSet.vertical.buttons .selected .button,
.tabSet.vertical.buttons .selected .button.over,
.tabSet.vertical.buttons .selected .button.pressed,
.tabSet.horizontal.buttons .selected > .button > .wrap,
.tabSet.text .selected.tab > .wrap,
.tabSet.text .selected.tab > .wrap.over,
.tabSet.text .selected.tab > .wrap.pressed,
.jr-mSelectlist-item.jr-isSelected.jr,
.jr-mSelectlistSelected.jr > .jr-mSelectlist-item.jr,
.jr-mTab-item.jr-isActive.jr {
    background: var(--origin-sapphire);
    color: #ffffff;
}

.list.filters > li:not(.selected) > .wrap.over .launcher,
.list.filters > li:not(.selected) > .wrap.pressed .launcher,
.jr-mButtonAction.jr-mButtonOutline.jr-isDown.jr .jr-mButton-label.jr,
.jr-mButtonPrimary.jr .jr-mButton-label.jr,
.jr-mTab-item.jr-isActive.jr .jr-mTab-item-label.jr {
    color: #ffffff;
}

.list.resources.sublist .resourceName > a,
.resourceName,
.resourceBlock-title,
.homeSidebar-title,
.workflow-title,
.content .header > .title,
.panel.info.system .message,
.textAccent02,
.fsection,
#reportContainer a,
#scheduler_editor #stepDisplay > fieldset > legend,
.plusminus .node > .wrap > .jrbookmark,
.jr-mDomain-header.jr,
.jr-mDomain-mode-title-text.jr,
.jr-mDialog-header-title.jr,
.jr-mPanel-header-title.jr,
.jr-mLinkTheme.jr,
.jr-mPanel-header-title.jr,
.jr-mTablePresentation.jr .jr-mTable-rowDropzone.jr-isHovered.jr {
    color: var(--origin-indigo);
}

#systemMessage {
    color: var(--origin-indigo);
    font-weight: 700;
    text-align: center;
}

#loginPage {
    background: linear-gradient(135deg, #eef5fb 0%, var(--origin-cream) 55%, #ffffff 100%);
}

#loginPage #copy {
    background:
        linear-gradient(145deg, rgba(19, 72, 171, 0.98), rgba(0, 111, 172, 0.92)),
        url("images/login-hero.svg");
    background-position: center center, right 24px bottom 24px;
    background-repeat: no-repeat, no-repeat;
    background-size: cover, 220px auto;
    border: 1px solid rgba(255,255,255,0.18);
    color: #ffffff;
    overflow: hidden;
    position: relative;
}

#loginPage #copy::before {
    content: "OriginBA";
    display: block;
    font-size: 34px;
    font-weight: 700;
    letter-spacing: 0.4px;
    margin: 24px 24px 8px;
    color: #ffffff;
}

#loginPage #copy::after {
    content: "Business Analytics Portal";
    display: block;
    font-size: 14px;
    font-weight: 500;
    opacity: 0.9;
    margin: 0 24px 24px;
    color: #ffffff;
}

#loginPage #loginForm {
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid rgba(217, 226, 236, 0.85);
}

#loginPage #loginForm fieldset label .wrap,
#loginPage #loginForm fieldset label,
#loginPage #metaLinks li,
#loginPage #metaLinks a,
#loginPage #metaLinks a:hover,
#loginPage #metaLinks a:active {
    color: var(--origin-indigo);
}

#loginPage #frameFooter {
    border-top: 1px solid rgba(255,255,255,0.22);
    height: 18px;
}

#loginForm .devices {
    background-position: center 0;
    background-size: auto;
}

/* Improve focus visibility across the UI */
.button:focus,
.jr-mButton.jr:focus,
input:focus,
select:focus,
textarea:focus,
a:focus {
    outline: 2px solid rgba(59, 175, 226, 0.55);
    outline-offset: 2px;
}

/* Gentle surface treatment */
.panel.tooltip .message.label,
.jive_dialog .dialogHeader,
.jr-mTooltip.jr,
.jr-mTooltipBottom.jr:before,
.jr-mTooltipBottomRight:before,
.jr-mTooltipBottomLeft:before,
.jr-mTooltipTop:after,
.jr-mTooltipTopRight:after,
.jr-mTooltipTopLeft:after {
    color: #ffffff;
    background-color: var(--origin-indigo);
    border-color: var(--origin-indigo);
}

/* Keep drag interactions visible but on-brand */
.wrap.dragging,
.overlay.col.dragging,
.overlay.group.dragging,
.overlay.xtab.gr.dragging,
.overlay.xtab.m.dragging,
.overlay.legend.dragging,
.dragMultiple.dragging .wrap {
    background-color: var(--origin-sapphire) !important;
}

/* Modern table/list polish */
.list.tabular.resources.header,
.list.tabular.jobs.header,
.jr-mTablePresentation.jr .jr-mTable-header.jr {
    background-color: rgba(245, 240, 235, 0.96);
}

.list.tabular.resources.header,
.list.tabular.jobs.header,
.jr-mTablePresentation.jr .jr-mTable-header.jr,
.list.resources.sublist .resourceName > a {
    border-color: var(--origin-border);
}

.resourcePath,
.palette16,
.button.capsule.down.disabled,
.button.capsule.down[disabled] {
    color: #8A4A1D;
}

/* stronger, cleaner footer text */
#frameFooter #about a,
#frameFooter #about a:link,
#frameFooter #about a:visited,
#frameFooter #about a:hover,
#frameFooter #about a:active,
#frameFooter #copyright {
    color: rgba(255,255,255,0.88);
}

/* on-brand palette helpers */
.palette09,
.palette09_bkgd,
.button.action.jumbo,
.resourceBlock a:link,
.resourceBlock a:visited,
.resourceBlock a:hover,
.resourceBlock a:active,
.workflow-description a:hover {
    color: var(--origin-sapphire);
}

.palette10,
.palette10_bkgd,
#metaLinks a:active {
    color: var(--origin-blue);
}

.palette11,
.palette11_bkgd,
.column.decorated.minimized .vtitle,
#filter-container .filterName,
#expression-container .filterName,
.textAccent02,
#needHelp,
#needHelp:hover,
#reportContainer a,
#resultsContainer .resourceName,
.workflow-buttonContainer .button {
    color: var(--origin-indigo);
}

.palette13,
.palette13_bkgd,
.textAccent,
.button.action.jumbo.over {
    color: var(--origin-warning);
}

.palette14,
.palette14_bkgd,
#needHelp:active,
.button.action.jumbo.pressed {
    color: var(--origin-danger);
}

.palette15,
.palette15_bkgd,
.button.capsule.down {
    color: #8A4A1D;
}

.palette16_bkgd {
    background-color: #C9682C;
}

/* Small spacing cleanup for common cards */
.column.decorated > .content > .body,
.panel > .body,
.resourceBlock,
.list.resources,
.list.jobs,
.jr-mPanel.jr,
.jr-mDialog.jr {
    background: rgba(255,255,255,0.94);
}

