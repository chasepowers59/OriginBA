    <variable name="FIRST_BATCH_CD" class="java.lang.String" calculation="First">
        <variableExpression><![CDATA[$F{SNAPSHOT_AUDIT.BATCH_CD}]]></variableExpression>
    </variable>
    <variable name="MAX_FREEZE_DTTM" class="java.sql.Timestamp" calculation="Highest">
        <variableExpression><![CDATA[$F{SNAPSHOT_AUDIT.FREEZE_DTTM}]]></variableExpression>
    </variable>
    <variable name="FIRST_FREEZE_USER" class="java.lang.String" calculation="First">
        <variableExpression><![CDATA[$F{SNAPSHOT_AUDIT.FREEZE_USER_NAME}]]></variableExpression>
    </variable>
    <variable name="MAX_LOAD_DTTM" class="java.sql.Timestamp" calculation="Highest">
        <variableExpression><![CDATA[$F{SNAPSHOT_AUDIT.LOAD_DTTM}]]></variableExpression>
    </variable>
    <variable name="TOTAL_GL_LINES" class="java.lang.Integer" calculation="Count">
        <variableExpression><![CDATA[$F{GL_LINE.FT_ID}]]></variableExpression>
        <initialValueExpression><![CDATA[0]]></initialValueExpression>
    </variable>
    <variable name="DISTINCT_FTS" class="java.lang.Long" calculation="DistinctCount">
        <variableExpression><![CDATA[$F{GL_LINE.FT_ID}]]></variableExpression>
        <initialValueExpression><![CDATA[0L]]></initialValueExpression>
    </variable>
    <variable name="DISTINCT_GL_ACCTS" class="java.lang.Long" calculation="DistinctCount">
        <variableExpression><![CDATA[$F{GL_LINE.GL_ACCT}]]></variableExpression>
        <initialValueExpression><![CDATA[0L]]></initialValueExpression>
    </variable>
    <variable name="TOTAL_GL_AMOUNT" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{GL_LINE.GL_AMOUNT}]]></variableExpression>
        <initialValueExpression><![CDATA[java.math.BigDecimal.ZERO]]></initialValueExpression>
    </variable>
    <variable name="TOTAL_STAT_AMOUNT" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{GL_LINE.STATISTIC_AMOUNT}]]></variableExpression>
        <initialValueExpression><![CDATA[java.math.BigDecimal.ZERO]]></initialValueExpression>
    </variable>
    <variable name="MISSING_GL_ACCT_CNT" class="java.lang.Integer" calculation="Sum">
        <variableExpression><![CDATA[($F{GL_LINE.GL_ACCT} == null || $F{GL_LINE.GL_ACCT}.trim().length() == 0) ? 1 : 0]]></variableExpression>
        <initialValueExpression><![CDATA[0]]></initialValueExpression>
    </variable>
    <variable name="ZERO_AMOUNT_CNT" class="java.lang.Integer" calculation="Sum">
        <variableExpression><![CDATA[($F{GL_LINE.GL_AMOUNT} == null || $F{GL_LINE.GL_AMOUNT}.compareTo(java.math.BigDecimal.ZERO) == 0) ? 1 : 0]]></variableExpression>
        <initialValueExpression><![CDATA[0]]></initialValueExpression>
    </variable>
    <variable name="STATUS_ISSUE_CNT" class="java.lang.Integer" calculation="Sum">
        <variableExpression><![CDATA[
($F{FT_CORE.GL_DISTRIB_STATUS_DESC} == null
 || !($F{FT_CORE.GL_DISTRIB_STATUS_DESC}.toUpperCase().contains("DISTRIBUT")
   || $F{FT_CORE.GL_DISTRIB_STATUS_DESC}.toUpperCase().contains("COMPLETE")
   || $F{FT_CORE.GL_DISTRIB_STATUS_DESC}.toUpperCase().contains("POST"))) ? 1 : 0
        ]]></variableExpression>
        <initialValueExpression><![CDATA[0]]></initialValueExpression>
    </variable>

    <filterExpression><![CDATA[
($P{BATCH_NBR_FILTER} != null)
&& ($F{GL_LINE.FT_ID} != null)
&& ($P{BATCH_CD_FILTER} == null || $P{BATCH_CD_FILTER}.trim().length() == 0
    || ($F{SNAPSHOT_AUDIT.BATCH_CD} != null && $F{SNAPSHOT_AUDIT.BATCH_CD}.equalsIgnoreCase($P{BATCH_CD_FILTER}.trim())))
&& ($P{GL_STATUS_FILTER} == null || $P{GL_STATUS_FILTER}.trim().length() == 0
    || ($F{FT_CORE.GL_DISTRIB_STATUS_DESC} != null && $F{FT_CORE.GL_DISTRIB_STATUS_DESC}.toUpperCase().contains($P{GL_STATUS_FILTER}.trim().toUpperCase())))
&& ($P{GL_ACCT_FILTER} == null || $P{GL_ACCT_FILTER}.trim().length() == 0
    || ($F{GL_LINE.GL_ACCT} != null && $F{GL_LINE.GL_ACCT}.toUpperCase().contains($P{GL_ACCT_FILTER}.trim().toUpperCase())))
&& ($P{MIN_ABS_GROUP_AMOUNT} == null || $F{GL_LINE.GL_AMOUNT} == null || $F{GL_LINE.GL_AMOUNT}.abs().compareTo($P{MIN_ABS_GROUP_AMOUNT}) >= 0)
&& (($P{ONLY_EXCEPTION_GROUPS} == null || !$P{ONLY_EXCEPTION_GROUPS}.booleanValue())
    || ($F{GL_LINE.GL_ACCT} == null || $F{GL_LINE.GL_ACCT}.trim().length() == 0)
    || ($F{GL_LINE.GL_AMOUNT} == null || $F{GL_LINE.GL_AMOUNT}.compareTo(java.math.BigDecimal.ZERO) == 0)
    || ($F{FT_CORE.GL_DISTRIB_STATUS_DESC} == null
        || !($F{FT_CORE.GL_DISTRIB_STATUS_DESC}.toUpperCase().contains("DISTRIBUT")
             || $F{FT_CORE.GL_DISTRIB_STATUS_DESC}.toUpperCase().contains("COMPLETE")
             || $F{FT_CORE.GL_DISTRIB_STATUS_DESC}.toUpperCase().contains("POST"))))
    ]]></filterExpression>

