                <textFieldExpression><![CDATA[
($F{GL_LINE.GL_ACCT} == null || $F{GL_LINE.GL_ACCT}.trim().length() == 0 || $F{GL_LINE.GL_AMOUNT} == null || $F{GL_LINE.GL_AMOUNT}.compareTo(java.math.BigDecimal.ZERO) == 0) ? "ERROR"
