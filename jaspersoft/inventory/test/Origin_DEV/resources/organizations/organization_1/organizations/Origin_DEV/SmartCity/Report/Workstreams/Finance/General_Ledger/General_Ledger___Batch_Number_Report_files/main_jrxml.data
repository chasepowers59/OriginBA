"Batch Code: " + ($V{FIRST_BATCH_CD} == null ? "UNKNOWN" : $V{FIRST_BATCH_CD})
+ " | Freeze User: " + ($V{FIRST_FREEZE_USER} == null ? "UNKNOWN" : $V{FIRST_FREEZE_USER})
+ " | Freeze Dttm: " + ($V{MAX_FREEZE_DTTM} == null ? "N/A" : new java.text.SimpleDateFormat("yyyy-MM-dd HH:mm").format($V{MAX_FREEZE_DTTM}))
+ " | Snapshot Load: " + ($V{MAX_LOAD_DTTM} == null ? "N/A" : new java.text.SimpleDateFormat("yyyy-MM-dd HH:mm").format($V{MAX_LOAD_DTTM}))
                ]]></textFieldExpression></textField>
                <textField evaluationTime="Report"><reportElement x="10" y="28" width="1130" height="16" uuid="cf2ec281-281e-4794-bf5f-60bbec4c1e72"/><textFieldExpression><![CDATA[
"GL Lines: " + $V{TOTAL_GL_LINES}
+ " | Distinct FTs: " + $V{DISTINCT_FTS}
+ " | Distinct GL Accounts: " + $V{DISTINCT_GL_ACCTS}
+ " | Net GL Amount: " + new java.text.DecimalFormat("#,##0.00").format($V{TOTAL_GL_AMOUNT})
+ " | Statistic Amount: " + new java.text.DecimalFormat("#,##0.00").format($V{TOTAL_STAT_AMOUNT})
                ]]></textFieldExpression></textField>
                <textField evaluationTime="Report"><reportElement x="10" y="48" width="1130" height="16" uuid="766d1bdb-bc5d-418a-b0c8-bc6785a5c8c4"/><textFieldExpression><![CDATA[
