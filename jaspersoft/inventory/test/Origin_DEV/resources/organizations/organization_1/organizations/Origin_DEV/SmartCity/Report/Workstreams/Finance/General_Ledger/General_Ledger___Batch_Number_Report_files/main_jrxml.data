+ " | BATCH_CD=" + (($P{BATCH_CD_FILTER} == null || $P{BATCH_CD_FILTER}.trim().length() == 0) ? "ALL" : $P{BATCH_CD_FILTER}.trim())
+ " | STATUS=" + (($P{GL_STATUS_FILTER} == null || $P{GL_STATUS_FILTER}.trim().length() == 0) ? "ALL" : $P{GL_STATUS_FILTER}.trim())
+ " | GL_ACCT=" + (($P{GL_ACCT_FILTER} == null || $P{GL_ACCT_FILTER}.trim().length() == 0) ? "ALL" : $P{GL_ACCT_FILTER}.trim())
+ " | EXCEPTIONS_ONLY=" + (($P{ONLY_EXCEPTION_GROUPS} != null && $P{ONLY_EXCEPTION_GROUPS}.booleanValue()) ? "Y" : "N")
                ]]></textFieldExpression>
            </textField>

