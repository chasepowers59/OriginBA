        <item id="ACTIVE_SERVICE_AGREEMENT_COUNT" label="ACTIVE_SERVICE_AGREEMENT_COUNT" resourceId="SingleReportQuery.ACTIVE_SERVICE_AGREEMENT_COUNT"></item>
        <item id="BILL_COUNT" label="BILL_COUNT" resourceId="SingleReportQuery.BILL_COUNT"></item>
        <item id="BILL_CYCLE_CODE_1" label="BILL_CYCLE_CODE" resourceId="SingleReportQuery.BILL_CYCLE_CODE"></item>
        <item id="BILL_CYCLE_DESCRIPTION_1" label="BILL_CYCLE_DESCRIPTION" resourceId="SingleReportQuery.BILL_CYCLE_DESCRIPTION"></item>
