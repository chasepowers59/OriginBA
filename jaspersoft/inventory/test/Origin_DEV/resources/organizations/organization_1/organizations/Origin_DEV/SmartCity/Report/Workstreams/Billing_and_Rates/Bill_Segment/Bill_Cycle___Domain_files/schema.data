  <resources>
    <jdbcQuery id="SingleReportQuery" datasourceId="Origin_DEV_DS">
      <fieldList>
        <field id="BILL_CYCLE_CODE" type="java.lang.String"></field>
        <field id="BILL_CYCLE_DESCRIPTION" type="java.lang.String"></field>
        <field id="BILL_SEGMENT_COUNT" type="java.math.BigDecimal"></field>
        <field id="BILL_COUNT" type="java.math.BigDecimal"></field>
        <field id="ACTIVE_SERVICE_AGREEMENT_COUNT" type="java.math.BigDecimal"></field>
        <field id="ACTIVE_ACCOUNT_COUNT" type="java.math.BigDecimal"></field>
        <field id="FIRST_BILL_DATE" type="java.sql.Timestamp"></field>
        <field id="LAST_BILL_DATE" type="java.sql.Timestamp"></field>
        <field id="MOST_RECENT_BILL_CYCLE_SW" type="java.lang.String"></field>
        <field id="GLOBAL_MOST_RECENT_CYCLE_SW" type="java.lang.String"></field>
      </fieldList>
      <query>SELECT
  X.BILL_CYCLE_CODE,
  X.BILL_CYCLE_DESCRIPTION,
  COUNT(*) AS BILL_SEGMENT_COUNT,
  COUNT(DISTINCT X.BILL_ID) AS BILL_COUNT,
  COUNT(DISTINCT X.SA_ID) AS ACTIVE_SERVICE_AGREEMENT_COUNT,
  COUNT(DISTINCT X.ACCT_ID) AS ACTIVE_ACCOUNT_COUNT,
  MIN(X.EVENT_DATE) AS FIRST_BILL_DATE,
  MAX(X.EVENT_DATE) AS LAST_BILL_DATE,
  CASE
    WHEN MAX(X.CYCLE_LAST_EVENT_DATE) = MAX(MAX(X.CYCLE_LAST_EVENT_DATE)) OVER () THEN 'Y'
    ELSE 'N'
  END AS MOST_RECENT_BILL_CYCLE_SW,
  CASE
    WHEN MAX(X.CYCLE_LAST_EVENT_DATE) = MAX(MAX(X.CYCLE_LAST_EVENT_DATE)) OVER () THEN 'Y'
    ELSE 'N'
  END AS GLOBAL_MOST_RECENT_CYCLE_SW
FROM (
  SELECT
    TRIM(S.BILL_CYC_CD) AS BILL_CYCLE_CODE,
    NVL(L.BILL_CYCLE_DESCRIPTION, 'Cycle ' || TRIM(S.BILL_CYC_CD)) AS BILL_CYCLE_DESCRIPTION,
    S.BILL_ID,
    S.SA_ID,
    SA.ACCT_ID,
    TRUNC(NVL(B.BILL_DT, S.CRE_DTTM)) AS EVENT_DATE,
    MAX(TRUNC(NVL(B.BILL_DT, S.CRE_DTTM))) OVER (PARTITION BY TRIM(S.BILL_CYC_CD)) AS CYCLE_LAST_EVENT_DATE
  FROM CISADM.CI_BSEG S
  JOIN CISADM.CI_SA SA
    ON SA.SA_ID = S.SA_ID
   AND NULLIF(TRIM(SA.SA_STATUS_FLG), '') = '20'
  LEFT JOIN CISADM.CI_BILL B
    ON B.BILL_ID = S.BILL_ID
  LEFT JOIN (
    SELECT
      TRIM(BILL_CYC_CD) AS BILL_CYCLE_CODE,
      MAX(DESCR) AS BILL_CYCLE_DESCRIPTION
    FROM CISADM.CI_BILL_CYC_L
    WHERE LANGUAGE_CD IN ('ENG', 'EN')
    GROUP BY TRIM(BILL_CYC_CD)
  ) L
    ON L.BILL_CYCLE_CODE = TRIM(S.BILL_CYC_CD)
  WHERE TRIM(S.BILL_CYC_CD) IS NOT NULL
) X
WHERE X.EVENT_DATE = X.CYCLE_LAST_EVENT_DATE
GROUP BY
  X.BILL_CYCLE_CODE,
  X.BILL_CYCLE_DESCRIPTION</query>
    </jdbcQuery>
    <jdbcQuery id="DrillDownQuery" datasourceId="Origin_DEV_DS">
      <fieldList>
        <field id="BILL_CYCLE_CODE" type="java.lang.String"></field>
        <field id="BILL_CYCLE_DESCRIPTION" type="java.lang.String"></field>
        <field id="ACCOUNT_ID" type="java.lang.String"></field>
        <field id="SERVICE_AGREEMENT_ID" type="java.lang.String"></field>
        <field id="PREMISE_ID" type="java.lang.String"></field>
        <field id="BILL_ID" type="java.lang.String"></field>
        <field id="BILL_SEGMENT_ID" type="java.lang.String"></field>
        <field id="BILL_DATE" type="java.sql.Timestamp"></field>
        <field id="BILL_CREATE_DATE" type="java.sql.Timestamp"></field>
        <field id="BSEG_CREATE_DATE" type="java.sql.Timestamp"></field>
        <field id="BILL_STATUS_CODE" type="java.lang.String"></field>
        <field id="BILL_STATUS_DESCRIPTION" type="java.lang.String"></field>
        <field id="BSEG_STATUS_CODE" type="java.lang.String"></field>
        <field id="BSEG_STATUS_DESCRIPTION" type="java.lang.String"></field>
        <field id="IS_ERROR_SW" type="java.lang.String"></field>
        <field id="ERROR_REASON" type="java.lang.String"></field>
        <field id="CYCLE_LAST_EVENT_DATE" type="java.sql.Timestamp"></field>
        <field id="MOST_RECENT_BILL_CYCLE_SW" type="java.lang.String"></field>
        <field id="EVENT_DATE" type="java.sql.Timestamp"></field>
        <field id="GLOBAL_MOST_RECENT_CYCLE_SW" type="java.lang.String"></field>
      </fieldList>
      <query>SELECT
  X.BILL_CYCLE_CODE,
  X.BILL_CYCLE_DESCRIPTION,
  X.ACCOUNT_ID,
  X.SERVICE_AGREEMENT_ID,
  X.PREMISE_ID,
  X.BILL_ID,
  X.BILL_SEGMENT_ID,
  X.BILL_DATE,
  X.BILL_CREATE_DATE,
  X.BSEG_CREATE_DATE,
  X.BILL_STATUS_CODE,
  X.BILL_STATUS_DESCRIPTION,
  X.BSEG_STATUS_CODE,
  X.BSEG_STATUS_DESCRIPTION,
  X.IS_ERROR_SW,
  X.ERROR_REASON,
  X.EVENT_DATE,
  X.CYCLE_LAST_EVENT_DATE,
  CASE
    WHEN X.CYCLE_LAST_EVENT_DATE = MAX(X.CYCLE_LAST_EVENT_DATE) OVER () THEN 'Y'
    ELSE 'N'
  END AS MOST_RECENT_BILL_CYCLE_SW,
  CASE
    WHEN X.CYCLE_LAST_EVENT_DATE = MAX(X.CYCLE_LAST_EVENT_DATE) OVER () THEN 'Y'
    ELSE 'N'
  END AS GLOBAL_MOST_RECENT_CYCLE_SW
FROM (
  SELECT
    TRIM(S.BILL_CYC_CD) AS BILL_CYCLE_CODE,
    NVL(C.BILL_CYCLE_DESCRIPTION, 'Cycle ' || TRIM(S.BILL_CYC_CD)) AS BILL_CYCLE_DESCRIPTION,
    SA.ACCT_ID AS ACCOUNT_ID,
    S.SA_ID AS SERVICE_AGREEMENT_ID,
    S.PREM_ID AS PREMISE_ID,
    S.BILL_ID,
    S.BSEG_ID AS BILL_SEGMENT_ID,
    TRUNC(B.BILL_DT) AS BILL_DATE,
    TRUNC(B.CRE_DTTM) AS BILL_CREATE_DATE,
    TRUNC(S.CRE_DTTM) AS BSEG_CREATE_DATE,
    TRIM(B.BILL_STAT_FLG) AS BILL_STATUS_CODE,
    NVL(BS.STATUS_DESCRIPTION, 'BILL_STATUS_' || TRIM(B.BILL_STAT_FLG)) AS BILL_STATUS_DESCRIPTION,
    TRIM(S.BSEG_STAT_FLG) AS BSEG_STATUS_CODE,
    NVL(SS.STATUS_DESCRIPTION, 'BSEG_STATUS_' || TRIM(S.BSEG_STAT_FLG)) AS BSEG_STATUS_DESCRIPTION,
    CASE
      WHEN REGEXP_LIKE(UPPER(NVL(SS.STATUS_DESCRIPTION, '')), 'ERROR|EXCEPTION|FAIL|CANCEL')
        OR REGEXP_LIKE(UPPER(NVL(BS.STATUS_DESCRIPTION, '')), 'ERROR|EXCEPTION|FAIL|CANCEL')
      THEN 'Y'
      ELSE 'N'
    END AS IS_ERROR_SW,
    CASE
      WHEN REGEXP_LIKE(UPPER(NVL(SS.STATUS_DESCRIPTION, '')), 'ERROR|EXCEPTION|FAIL|CANCEL')
      THEN SS.STATUS_DESCRIPTION
      WHEN REGEXP_LIKE(UPPER(NVL(BS.STATUS_DESCRIPTION, '')), 'ERROR|EXCEPTION|FAIL|CANCEL')
      THEN BS.STATUS_DESCRIPTION
      ELSE NULL
    END AS ERROR_REASON,
    TRUNC(NVL(B.BILL_DT, S.CRE_DTTM)) AS EVENT_DATE,
    MAX(TRUNC(NVL(B.BILL_DT, S.CRE_DTTM))) OVER (PARTITION BY TRIM(S.BILL_CYC_CD)) AS CYCLE_LAST_EVENT_DATE
  FROM CISADM.CI_BSEG S
  JOIN CISADM.CI_SA SA
    ON SA.SA_ID = S.SA_ID
   AND NULLIF(TRIM(SA.SA_STATUS_FLG), '') = '20'
  LEFT JOIN CISADM.CI_BILL B
    ON B.BILL_ID = S.BILL_ID
  LEFT JOIN (
    SELECT
      TRIM(BILL_CYC_CD) AS BILL_CYCLE_CODE,
      MAX(DESCR) AS BILL_CYCLE_DESCRIPTION
    FROM CISADM.CI_BILL_CYC_L
    WHERE LANGUAGE_CD IN ('ENG', 'EN')
    GROUP BY TRIM(BILL_CYC_CD)
  ) C
    ON C.BILL_CYCLE_CODE = TRIM(S.BILL_CYC_CD)
  LEFT JOIN (
    SELECT
      TRIM(FIELD_VALUE) AS STATUS_CODE,
      MAX(DESCR) AS STATUS_DESCRIPTION
    FROM CISADM.CI_LOOKUP_VAL_L
    WHERE TRIM(FIELD_NAME) = 'BILL_STAT_FLG'
      AND LANGUAGE_CD = 'ENG'
    GROUP BY TRIM(FIELD_VALUE)
  ) BS
    ON BS.STATUS_CODE = TRIM(B.BILL_STAT_FLG)
  LEFT JOIN (
    SELECT
      TRIM(FIELD_VALUE) AS STATUS_CODE,
      MAX(DESCR) AS STATUS_DESCRIPTION
    FROM CISADM.CI_LOOKUP_VAL_L
    WHERE TRIM(FIELD_NAME) = 'BSEG_STAT_FLG'
      AND LANGUAGE_CD = 'ENG'
    GROUP BY TRIM(FIELD_VALUE)
  ) SS
    ON SS.STATUS_CODE = TRIM(S.BSEG_STAT_FLG)
  WHERE TRIM(S.BILL_CYC_CD) IS NOT NULL
) X
WHERE X.EVENT_DATE = X.CYCLE_LAST_EVENT_DATE</query>
    </jdbcQuery>
    <jdbcQuery id="ExpectedCounts" datasourceId="Origin_DEV_DS">
      <fieldList>
        <field id="BILL_CYCLE_CODE" type="java.lang.String"></field>
        <field id="BILL_CYCLE_DESCRIPTION" type="java.lang.String"></field>
        <field id="EXPECTED_ACTIVE_SA_COUNT" type="java.math.BigDecimal"></field>
        <field id="EXPECTED_ACTIVE_ACCOUNT_COUNT" type="java.math.BigDecimal"></field>
        <field id="ACTUAL_BILLED_SA_COUNT" type="java.math.BigDecimal"></field>
        <field id="ACTUAL_BILLED_ACCOUNT_COUNT" type="java.math.BigDecimal"></field>
        <field id="ACTUAL_BILL_SEGMENT_COUNT" type="java.math.BigDecimal"></field>
        <field id="ACTUAL_BILL_COUNT" type="java.math.BigDecimal"></field>
        <field id="MISSING_ACTIVE_SA_COUNT" type="java.math.BigDecimal"></field>
        <field id="MISSING_ACTIVE_ACCOUNT_COUNT" type="java.math.BigDecimal"></field>
        <field id="SA_COMPLETION_PCT" type="java.math.BigDecimal"></field>
        <field id="CYCLE_LAST_EVENT_DATE" type="java.sql.Timestamp"></field>
        <field id="MOST_RECENT_BILL_CYCLE_SW" type="java.lang.String"></field>
      </fieldList>
      <query>SELECT
  E.BILL_CYCLE_CODE,
  E.BILL_CYCLE_DESCRIPTION,
  E.EXPECTED_ACTIVE_SA_COUNT,
  E.EXPECTED_ACTIVE_ACCOUNT_COUNT,
  NVL(A.ACTUAL_BILLED_SA_COUNT, 0) AS ACTUAL_BILLED_SA_COUNT,
  NVL(A.ACTUAL_BILLED_ACCOUNT_COUNT, 0) AS ACTUAL_BILLED_ACCOUNT_COUNT,
  NVL(A.ACTUAL_BILL_SEGMENT_COUNT, 0) AS ACTUAL_BILL_SEGMENT_COUNT,
  NVL(A.ACTUAL_BILL_COUNT, 0) AS ACTUAL_BILL_COUNT,
  E.EXPECTED_ACTIVE_SA_COUNT - NVL(A.ACTUAL_BILLED_SA_COUNT, 0) AS MISSING_ACTIVE_SA_COUNT,
  E.EXPECTED_ACTIVE_ACCOUNT_COUNT - NVL(A.ACTUAL_BILLED_ACCOUNT_COUNT, 0) AS MISSING_ACTIVE_ACCOUNT_COUNT,
  ROUND(
    100 * NVL(A.ACTUAL_BILLED_SA_COUNT, 0) / NULLIF(E.EXPECTED_ACTIVE_SA_COUNT, 0),
    2
  ) AS SA_COMPLETION_PCT,
  A.CYCLE_LAST_EVENT_DATE,
  CASE
    WHEN A.CYCLE_LAST_EVENT_DATE = MAX(A.CYCLE_LAST_EVENT_DATE) OVER () THEN 'Y'
    ELSE 'N'
  END AS MOST_RECENT_BILL_CYCLE_SW
FROM (
  SELECT
    TRIM(AC.BILL_CYC_CD) AS BILL_CYCLE_CODE,
    NVL(L.DESCR, 'Cycle ' || TRIM(AC.BILL_CYC_CD)) AS BILL_CYCLE_DESCRIPTION,
    COUNT(DISTINCT SA.SA_ID) AS EXPECTED_ACTIVE_SA_COUNT,
    COUNT(DISTINCT SA.ACCT_ID) AS EXPECTED_ACTIVE_ACCOUNT_COUNT
  FROM CISADM.CI_SA SA
  JOIN CISADM.CI_ACCT AC
    ON AC.ACCT_ID = SA.ACCT_ID
  LEFT JOIN (
    SELECT
      TRIM(BILL_CYC_CD) AS BILL_CYCLE_CODE,
      MAX(DESCR) AS DESCR
    FROM CISADM.CI_BILL_CYC_L
    WHERE LANGUAGE_CD IN ('ENG', 'EN')
    GROUP BY TRIM(BILL_CYC_CD)
  ) L
    ON L.BILL_CYCLE_CODE = TRIM(AC.BILL_CYC_CD)
  WHERE NULLIF(TRIM(SA.SA_STATUS_FLG), '') = '20'
    AND TRIM(AC.BILL_CYC_CD) IS NOT NULL
  GROUP BY TRIM(AC.BILL_CYC_CD), NVL(L.DESCR, 'Cycle ' || TRIM(AC.BILL_CYC_CD))
) E
LEFT JOIN (
  SELECT
    X.BILL_CYCLE_CODE,
    COUNT(*) AS ACTUAL_BILL_SEGMENT_COUNT,
    COUNT(DISTINCT X.BILL_ID) AS ACTUAL_BILL_COUNT,
    COUNT(DISTINCT X.SA_ID) AS ACTUAL_BILLED_SA_COUNT,
    COUNT(DISTINCT X.ACCT_ID) AS ACTUAL_BILLED_ACCOUNT_COUNT,
    MAX(X.CYCLE_LAST_EVENT_DATE) AS CYCLE_LAST_EVENT_DATE
  FROM (
    SELECT
      TRIM(S.BILL_CYC_CD) AS BILL_CYCLE_CODE,
      S.BILL_ID,
      S.SA_ID,
      SA.ACCT_ID,
      TRUNC(NVL(B.BILL_DT, S.CRE_DTTM)) AS EVENT_DATE,
      MAX(TRUNC(NVL(B.BILL_DT, S.CRE_DTTM))) OVER (PARTITION BY TRIM(S.BILL_CYC_CD)) AS CYCLE_LAST_EVENT_DATE
    FROM CISADM.CI_BSEG S
    JOIN CISADM.CI_SA SA
      ON SA.SA_ID = S.SA_ID
     AND NULLIF(TRIM(SA.SA_STATUS_FLG), '') = '20'
    LEFT JOIN CISADM.CI_BILL B
      ON B.BILL_ID = S.BILL_ID
    WHERE TRIM(S.BILL_CYC_CD) IS NOT NULL
  ) X
  WHERE X.EVENT_DATE = X.CYCLE_LAST_EVENT_DATE
  GROUP BY X.BILL_CYCLE_CODE
) A
  ON A.BILL_CYCLE_CODE = E.BILL_CYCLE_CODE
ORDER BY E.BILL_CYCLE_CODE</query>
    </jdbcQuery>
  </resources>
</schema>
