        <item id="ACTUAL_BILL_SEGMENT_COUNT" label="ACTUAL_BILL_SEGMENT_COUNT" resourceId="ExpectedCounts.ACTUAL_BILL_SEGMENT_COUNT"></item>
        <item id="ACTUAL_BILLED_ACCOUNT_COUNT" label="ACTUAL_BILLED_ACCOUNT_COUNT" resourceId="ExpectedCounts.ACTUAL_BILLED_ACCOUNT_COUNT"></item>
        <item id="ACTUAL_BILLED_SA_COUNT" label="ACTUAL_BILLED_SA_COUNT" resourceId="ExpectedCounts.ACTUAL_BILLED_SA_COUNT"></item>
        <item id="BILL_CYCLE_CODE_2" label="BILL_CYCLE_CODE" resourceId="ExpectedCounts.BILL_CYCLE_CODE"></item>
        <item id="BILL_CYCLE_DESCRIPTION_2" label="BILL_CYCLE_DESCRIPTION" resourceId="ExpectedCounts.BILL_CYCLE_DESCRIPTION"></item>
        <item id="CYCLE_LAST_EVENT_DATE_1" label="CYCLE_LAST_EVENT_DATE" resourceId="ExpectedCounts.CYCLE_LAST_EVENT_DATE"></item>
        <item id="EXPECTED_ACTIVE_ACCOUNT_COUNT" label="EXPECTED_ACTIVE_ACCOUNT_COUNT" resourceId="ExpectedCounts.EXPECTED_ACTIVE_ACCOUNT_COUNT"></item>
        <item id="EXPECTED_ACTIVE_SA_COUNT" label="EXPECTED_ACTIVE_SA_COUNT" resourceId="ExpectedCounts.EXPECTED_ACTIVE_SA_COUNT"></item>
