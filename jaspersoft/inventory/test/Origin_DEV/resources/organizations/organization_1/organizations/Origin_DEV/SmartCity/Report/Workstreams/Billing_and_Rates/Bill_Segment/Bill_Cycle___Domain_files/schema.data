        <item id="SERVICE_AGREEMENT_ID" label="SERVICE_AGREEMENT_ID" resourceId="DrillDownQuery.SERVICE_AGREEMENT_ID"></item>
        <item id="PREMISE_ID" label="PREMISE_ID" resourceId="DrillDownQuery.PREMISE_ID"></item>
        <item id="MOST_RECENT_BILL_CYCLE_SW" label="MOST_RECENT_BILL_CYCLE_SW" resourceId="DrillDownQuery.MOST_RECENT_BILL_CYCLE_SW"></item>
