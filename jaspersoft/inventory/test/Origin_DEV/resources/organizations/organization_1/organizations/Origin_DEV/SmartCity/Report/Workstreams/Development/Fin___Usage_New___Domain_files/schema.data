        <field id="CI_FT.NEW_DEBIT_SW" type="java.lang.String"></field>
        <field id="CI_FT.SHOW_ON_BILL_SW" type="java.lang.String"></field>
        <field id="CI_FT.CRE_DTTM" type="java.sql.Timestamp"></field>
        <field id="CI_FT.VERSION" type="java.math.BigDecimal"></field>
        <field id="CI_ACCT.ACCT_ID" type="java.lang.String"></field>
        <field id="CI_ACCT.CUST_CL_CD" type="java.lang.String"></field>
        <field id="CI_ACCT.BILL_CYC_CD" type="java.lang.String"></field>
        <field id="CI_ACCT.CURRENCY_CD" type="java.lang.String"></field>
        <field id="CI_ACCT.VERSION" type="java.math.BigDecimal"></field>
        <field id="CI_BSEG.BSEG_ID" type="java.lang.String"></field>
        <field id="CI_BSEG.BILL_ID" type="java.lang.String"></field>
        <field id="CI_BSEG.SA_ID" type="java.lang.String"></field>
        <field id="CI_BSEG.BILL_CYC_CD" type="java.lang.String"></field>
        <field id="CI_BSEG.WIN_START_DT" type="java.util.Date"></field>
