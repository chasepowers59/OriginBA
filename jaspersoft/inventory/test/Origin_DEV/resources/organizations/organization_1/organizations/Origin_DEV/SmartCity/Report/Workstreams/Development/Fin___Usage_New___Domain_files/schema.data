        <field id="CI_BSEG.CLOSING_BSEG_SW" type="java.lang.String"></field>
        <field id="CI_BSEG.PREM_ID" type="java.lang.String"></field>
        <field id="CI_BSEG.CRE_DTTM" type="java.sql.Timestamp"></field>
        <field id="CI_BSEG.VERSION" type="java.math.BigDecimal"></field>
        <field id="CI_PER_NAME.PER_ID" type="java.lang.String"></field>
        <field id="CI_PER_NAME.ENTITY_NAME" type="java.lang.String"></field>
        <field id="CI_PER_NAME.ENTITY_NAME_UPR" type="java.lang.String"></field>
        <field id="CI_PER_NAME.NAME_TYPE_FLG" type="java.lang.String"></field>
        <field id="CI_PER_NAME.PRIM_NAME_SW" type="java.lang.String"></field>
        <field id="CI_PER_NAME.VERSION" type="java.math.BigDecimal"></field>
        <field id="D1_USAGE_PERIOD_SQ.D1_USAGE_ID" type="java.lang.String"></field>
        <field id="D1_USAGE_PERIOD_SQ.QUANTITY" type="java.math.BigDecimal"></field>
        <field id="D1_USAGE_PERIOD_SQ.D1_UOM_CD" type="java.lang.String"></field>
        <field id="D1_USAGE_PERIOD_SQ.D1_SQI_CD" type="java.lang.String"></field>
        <field id="D1_USAGE_PERIOD_SQ.D1_TOU_CD" type="java.lang.String"></field>
        <field id="D1_USAGE_PERIOD_SQ.VERSION" type="java.math.BigDecimal"></field>
        <field id="CI_LOOKUP_VAL_L.FIELD_NAME" type="java.lang.String"></field>
        <field id="CI_LOOKUP_VAL_L.FIELD_VALUE" type="java.lang.String"></field>
        <field id="CI_LOOKUP_VAL_L.LANGUAGE_CD" type="java.lang.String"></field>
        <field id="CI_LOOKUP_VAL_L.DESCR" type="java.lang.String"></field>
        <field id="CI_LOOKUP_VAL_L.VERSION" type="java.math.BigDecimal"></field>
        <field id="CI_ACCT_PER.ACCT_ID" type="java.lang.String"></field>
        <field id="CI_ACCT_PER.PER_ID" type="java.lang.String"></field>
        <field id="CI_ACCT_PER.MAIN_CUST_SW" type="java.lang.String"></field>
        <field id="CI_ACCT_PER.ACCT_REL_TYPE_CD" type="java.lang.String"></field>
        <field id="CI_ACCT_PER.FIN_RESP_SW" type="java.lang.String"></field>
        <field id="CI_ACCT_PER.VERSION" type="java.math.BigDecimal"></field>
        <field id="D1_USAGE.D1_USAGE_ID" type="java.lang.String"></field>
        <field id="D1_USAGE.USG_EXT_ID" type="java.lang.String"></field>
        <field id="D1_USAGE.BO_STATUS_CD" type="java.lang.String"></field>
        <field id="D1_USAGE.START_DTTM" type="java.sql.Timestamp"></field>
        <field id="D1_USAGE.END_DTTM" type="java.sql.Timestamp"></field>
        <field id="D1_USAGE.USG_GRP_CD" type="java.lang.String"></field>
        <field id="D1_USAGE.USG_SRC_FLG" type="java.lang.String"></field>
        <field id="D1_USAGE.CRE_DTTM" type="java.sql.Timestamp"></field>
        <field id="D1_USAGE.VERSION" type="java.math.BigDecimal"></field>
        <field id="BILLING_DAYS" dataSetExpression="ElapsedDays(CI_BSEG.START_DT, CI_BSEG.END_DT)" type="java.math.BigDecimal"></field>
        <field id="FT_COUNT" dataSetExpression="CountDistinct(CI_FT.FT_ID, 'Current')" type="java.lang.Long"></field>
        <field id="TOTAL_CUR_AMT" dataSetExpression="Sum(CI_FT.CUR_AMT, 'Current')" type="java.math.BigDecimal"></field>
        <field id="TOTAL_TOT_AMT" dataSetExpression="Sum(CI_FT.TOT_AMT, 'Current')" type="java.math.BigDecimal"></field>
        <field id="USAGE_TXN_COUNT" dataSetExpression="CountDistinct(D1_USAGE.D1_USAGE_ID, 'Current')" type="java.lang.Long"></field>
        <field id="TOTAL_USAGE_QTY" dataSetExpression="Sum(D1_USAGE_PERIOD_SQ.QUANTITY, 'Current')" type="java.math.BigDecimal"></field>
        <field id="NO_USAGE_FLG" dataSetExpression="IIF(IsNull(C1_USAGE.USAGE_ID), 'Y', 'N')" type="java.lang.String"></field>
      </fieldList>
      <filterString>CI_LOOKUP_VAL_L.LANGUAGE_CD == 'ENG' and Trim(CI_LOOKUP_VAL_L.FIELD_NAME) == 'BSEG_STAT_FLG' and CI_ACCT_PER.MAIN_CUST_SW == 'Y' and CI_FT.FREEZE_SW == 'Y' and CI_PER_NAME.NAME_TYPE_FLG == 'PRIM'</filterString>
      <joinInfo alias="CI_BSEG" referenceId="CI_BSEG"></joinInfo>
      <joinList>
        <join expr="CI_BSEG.SA_ID == CI_SA.SA_ID" left="CI_BSEG" right="CI_SA" type="inner" weight="1"></join>
        <join expr="CI_SA.ACCT_ID == CI_ACCT.ACCT_ID" left="CI_SA" right="CI_ACCT" type="inner" weight="1"></join>
        <join expr="CI_BSEG.SA_ID == CI_FT.SA_ID and CI_BSEG.BILL_ID == CI_FT.BILL_ID" left="CI_BSEG" right="CI_FT" type="inner" weight="1"></join>
        <join expr="CI_BSEG.SA_ID == C1_USAGE.SA_ID and CI_BSEG.BSEG_ID == C1_USAGE.BSEG_ID" left="CI_BSEG" right="C1_USAGE" type="leftOuter" weight="1"></join>
        <join expr="C1_USAGE.USAGE_ID == D1_USAGE.USG_EXT_ID" left="C1_USAGE" right="D1_USAGE" type="leftOuter" weight="1"></join>
        <join expr="D1_USAGE.D1_USAGE_ID == D1_USAGE_PERIOD_SQ.D1_USAGE_ID" left="D1_USAGE" right="D1_USAGE_PERIOD_SQ" type="leftOuter" weight="1"></join>
        <join expr="CI_ACCT.ACCT_ID == CI_ACCT_PER.ACCT_ID and CI_ACCT_PER.MAIN_CUST_SW == 'Y'" left="CI_ACCT" right="CI_ACCT_PER" type="leftOuter" weight="1"></join>
        <join expr="CI_ACCT_PER.PER_ID == CI_PER_NAME.PER_ID and CI_PER_NAME.NAME_TYPE_FLG == 'PRIM'" left="CI_ACCT_PER" right="CI_PER_NAME" type="leftOuter" weight="1"></join>
        <join expr="CI_BSEG.BSEG_STAT_FLG == CI_LOOKUP_VAL_L.FIELD_VALUE and Trim(CI_LOOKUP_VAL_L.FIELD_NAME) == 'BSEG_STAT_FLG' and CI_LOOKUP_VAL_L.LANGUAGE_CD == 'ENG'" left="CI_BSEG" right="CI_LOOKUP_VAL_L" type="leftOuter" weight="1"></join>
      </joinList>
      <joinOptions></joinOptions>
      <tableRefList>
        <tableRef alwaysIncludeTable="false" tableAlias="C1_USAGE" tableId="C1_USAGE"></tableRef>
        <tableRef alwaysIncludeTable="false" tableAlias="CI_ACCT" tableId="CI_ACCT"></tableRef>
        <tableRef alwaysIncludeTable="false" tableAlias="CI_BSEG" tableId="CI_BSEG"></tableRef>
        <tableRef alwaysIncludeTable="false" tableAlias="CI_SA" tableId="CI_SA"></tableRef>
        <tableRef alwaysIncludeTable="false" tableAlias="CI_FT" tableId="CI_FT"></tableRef>
        <tableRef alwaysIncludeTable="false" tableAlias="CI_ACCT_PER" tableId="CI_ACCT_PER"></tableRef>
        <tableRef alwaysIncludeTable="false" tableAlias="D1_USAGE_PERIOD_SQ" tableId="D1_USAGE_PERIOD_SQ"></tableRef>
        <tableRef alwaysIncludeTable="false" tableAlias="CI_LOOKUP_VAL_L" tableId="CI_LOOKUP_VAL_L"></tableRef>
        <tableRef alwaysIncludeTable="false" tableAlias="D1_USAGE" tableId="D1_USAGE"></tableRef>
        <tableRef alwaysIncludeTable="false" tableAlias="CI_PER_NAME" tableId="CI_PER_NAME"></tableRef>
      </tableRefList>
    </jdbcTable>
  </resources>
</schema>
