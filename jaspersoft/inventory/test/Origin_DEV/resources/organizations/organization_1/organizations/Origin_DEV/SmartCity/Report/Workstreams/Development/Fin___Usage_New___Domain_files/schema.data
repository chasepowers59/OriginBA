        <field id="CI_FT.FT_ID" type="java.lang.String"></field>
        <field id="CI_FT.SA_ID" type="java.lang.String"></field>
        <field id="CI_FT.BILL_ID" type="java.lang.String"></field>
        <field id="CI_FT.FT_TYPE_FLG" type="java.lang.String"></field>
