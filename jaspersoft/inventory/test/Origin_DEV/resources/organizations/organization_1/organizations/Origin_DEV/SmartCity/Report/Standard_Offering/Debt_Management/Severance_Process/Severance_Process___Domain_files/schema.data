    <jdbcQuery id="CMS_IS_NEXT_SEV_EVT" datasourceId="Origin_DEV_DS">
      <fieldList>
        <field id="SEV_PROC_ID" type="java.lang.String"></field>
        <field id="EVT_SEQ" type="java.math.BigDecimal"></field>
        <field id="IS_NEXT" type="java.lang.String"></field>
      </fieldList>
      <query>select 
  se.sev_proc_id
  ,min(se.evt_seq) as EVT_SEQ
  ,'Y' as IS_NEXT
from
  cisadm.ci_sev_evt se
where
  se.completion_dt is null
group by
  se.sev_proc_id</query>
    </jdbcQuery>
