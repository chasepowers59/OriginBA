      <filterString>CI_LOOKUP_VAL_L.FIELD_NAME == 'SEV_STATUS_FLG                ' and CI_LOOKUP_VAL_L_1.FIELD_NAME == 'SEV_STAT_RSN_FLG              '</filterString>
      <joinInfo alias="CI_SEV_PROC" referenceId="CI_SEV_PROC"></joinInfo>
      <joinList>
        <join expr="CI_SEV_PROC.SA_ID == CI_SA.SA_ID" left="CI_SEV_PROC" right="CI_SA" type="inner" weight="1"></join>
        <join expr="CI_SEV_PROC.SEV_PROC_ID == CI_SEV_EVT.SEV_PROC_ID" left="CI_SEV_PROC" right="CI_SEV_EVT" type="inner" weight="1"></join>
        <join expr="CI_SA.ACCT_ID == CI_ACCT.ACCT_ID" left="CI_SA" right="CI_ACCT" type="inner" weight="1"></join>
        <join expr="CI_ACCT.ACCT_ID == CI_ACCT_PER.ACCT_ID and CI_ACCT_PER.MAIN_CUST_SW == 'Y'" left="CI_ACCT" right="CI_ACCT_PER" type="inner" weight="1"></join>
        <join expr="CI_ACCT_PER.PER_ID == CI_PER_NAME.PER_ID and CI_PER_NAME.NAME_TYPE_FLG == 'PRIM'" left="CI_ACCT_PER" right="CI_PER_NAME" type="inner" weight="1"></join>
        <join expr="CI_SEV_EVT.SEV_PROC_ID == CMS_IS_NEXT_SEV_EVT.SEV_PROC_ID and CI_SEV_EVT.EVT_SEQ == CMS_IS_NEXT_SEV_EVT.EVT_SEQ" left="CI_SEV_EVT" right="CMS_IS_NEXT_SEV_EVT" type="leftOuter" weight="1"></join>
        <join expr="CI_SEV_PROC.SEV_STATUS_FLG == CI_LOOKUP_VAL_L.FIELD_VALUE and CI_LOOKUP_VAL_L.FIELD_NAME == 'SEV_STATUS_FLG' and CI_LOOKUP_VAL_L.LANGUAGE_CD == 'ENG'" left="CI_SEV_PROC" right="CI_LOOKUP_VAL_L" type="inner" weight="1"></join>
        <join expr="CI_SEV_PROC.SEV_STAT_RSN_FLG == CI_LOOKUP_VAL_L_1.FIELD_VALUE and CI_LOOKUP_VAL_L_1.FIELD_NAME == 'SEV_STAT_RSN_FLG' and CI_LOOKUP_VAL_L_1.LANGUAGE_CD == 'ENG'" left="CI_SEV_PROC" right="CI_LOOKUP_VAL_L_1" type="inner" weight="1"></join>
        <join expr="CI_SEV_PROC.CRIT_PRIO_FLG == CI_LOOKUP_VAL_L_2.FIELD_VALUE and CI_LOOKUP_VAL_L_2.FIELD_NAME == 'CRIT_PRIO_FLG' and CI_LOOKUP_VAL_L_2.LANGUAGE_CD == 'ENG'" left="CI_SEV_PROC" right="CI_LOOKUP_VAL_L_2" type="leftOuter" weight="1"></join>
        <join expr="CI_SEV_PROC.SEV_PROC_TMPL_CD == CI_SEV_PROC_TMP_L.SEV_PROC_TMPL_CD and CI_SEV_PROC_TMP_L.LANGUAGE_CD == 'ENG'" left="CI_SEV_PROC" right="CI_SEV_PROC_TMP_L" type="inner" weight="1"></join>
        <join expr="CI_SEV_EVT.SEV_EVT_STAT_FLG == CI_LOOKUP_VAL_L_3.FIELD_VALUE and CI_LOOKUP_VAL_L_3.FIELD_NAME == 'SEV_EVT_STAT_FLG' and CI_LOOKUP_VAL_L_3.LANGUAGE_CD == 'ENG'" left="CI_SEV_EVT" right="CI_LOOKUP_VAL_L_3" type="inner" weight="1"></join>
        <join expr="CI_SEV_EVT.SEV_EVT_TYPE_CD == CI_SEV_EVT_TYPE_L.SEV_EVT_TYPE_CD and CI_SEV_EVT_TYPE_L.LANGUAGE_CD == 'ENG'" left="CI_SEV_EVT" right="CI_SEV_EVT_TYPE_L" type="inner" weight="1"></join>
        <join expr="CI_SA.SA_STATUS_FLG == CI_LOOKUP_VAL_L_4.FIELD_VALUE and CI_LOOKUP_VAL_L_4.FIELD_NAME == 'SA_STATUS_FLG' and CI_LOOKUP_VAL_L_4.LANGUAGE_CD == 'ENG'" left="CI_SA" right="CI_LOOKUP_VAL_L_4" type="inner" weight="1"></join>
        <join expr="CI_SA.CIS_DIVISION == CI_SA_TYPE_L.CIS_DIVISION and CI_SA.SA_TYPE_CD == CI_SA_TYPE_L.SA_TYPE_CD" left="CI_SA" right="CI_SA_TYPE_L" type="inner" weight="1"></join>
