      <joinInfo alias="PE_PAY_EVENT" referenceId="PE_PAY_EVENT"></joinInfo>
      <joinList>
        <join expr="PE_PAY_EVENT.PAY_EVENT_ID == PE_PAY.PAY_EVENT_ID" left="PE_PAY_EVENT" right="PE_PAY" type="leftOuter" weight="1"></join>
        <join expr="PE_PAY_EVENT.PAY_EVENT_ID == PE_PAY_TENDER.PAY_EVENT_ID" left="PE_PAY_EVENT" right="PE_PAY_TENDER" type="leftOuter" weight="1"></join>
        <join expr="PE_PAY.PAY_ID == PE_PAY_SEG.PAY_ID" left="PE_PAY" right="PE_PAY_SEG" type="leftOuter" weight="1"></join>
        <join expr="PE_PAY_SEG.SA_ID == PE_SA.SA_ID" left="PE_PAY_SEG" right="PE_SA" type="leftOuter" weight="1"></join>
        <join expr="PE_PAY_TENDER.TNDR_CTL_ID == PE_TENDER_CONTROL.TNDR_CTL_ID" left="PE_PAY_TENDER" right="PE_TENDER_CONTROL" type="leftOuter" weight="1"></join>
        <join expr="PE_TENDER_CONTROL.DEP_CTL_ID == PE_DEPOSIT_CONTROL.DEP_CTL_ID" left="PE_TENDER_CONTROL" right="PE_DEPOSIT_CONTROL" type="leftOuter" weight="1"></join>
        <join expr="PE_DEPOSIT_CONTROL.DEP_CTL_ID == PE_TENDER_DEPOSIT.DEP_CTL_ID" left="PE_DEPOSIT_CONTROL" right="PE_TENDER_DEPOSIT" type="leftOuter" weight="1"></join>
        <join expr="PE_TENDER_CONTROL.TNDR_CTL_ID == PE_TENDER_END_BALANCE.TNDR_CTL_ID" left="PE_TENDER_CONTROL" right="PE_TENDER_END_BALANCE" type="leftOuter" weight="1"></join>
        <join expr="PE_PAY.ACCT_ID == PE_ACCOUNT.ACCT_ID" left="PE_PAY" right="PE_ACCOUNT" type="leftOuter" weight="1"></join>
        <join expr="PE_ACCOUNT.ACCT_ID == PE_MAIN_CUSTOMER.ACCT_ID and PE_MAIN_CUSTOMER.MAIN_CUST_SW == 'Y'" left="PE_ACCOUNT" right="PE_MAIN_CUSTOMER" type="leftOuter" weight="1"></join>
        <join expr="PE_MAIN_CUSTOMER.PER_ID == PE_PERSON.PER_ID" left="PE_MAIN_CUSTOMER" right="PE_PERSON" type="leftOuter" weight="1"></join>
        <join expr="PE_MAIN_CUSTOMER.PER_ID == PE_PRIMARY_NAME.PER_ID and PE_PRIMARY_NAME.PRIM_NAME_SW == 'Y'" left="PE_MAIN_CUSTOMER" right="PE_PRIMARY_NAME" type="leftOuter" weight="1"></join>
        <join expr="PE_PERSON.PER_ID == PE_CONTACT_DETAIL.PER_ID" left="PE_PERSON" right="PE_CONTACT_DETAIL" type="leftOuter" weight="1"></join>
        <join expr="PE_ACCOUNT.ACCT_ID == PE_PAY_PLAN.ACCT_ID" left="PE_ACCOUNT" right="PE_PAY_PLAN" type="leftOuter" weight="1"></join>
        <join expr="PE_PAY_PLAN.PP_ID == PE_PAY_PLAN_SCHEDULE.PP_ID" left="PE_PAY_PLAN" right="PE_PAY_PLAN_SCHEDULE" type="leftOuter" weight="1"></join>
        <join expr="PE_PAY.PAY_STATUS_FLG == PE_PAY_STATUS.FIELD_VALUE and PE_PAY_STATUS.FIELD_NAME == 'PAY_STATUS_FLG' and PE_PAY_STATUS.LANGUAGE_CD == 'ENG'" left="PE_PAY" right="PE_PAY_STATUS" type="leftOuter" weight="1"></join>
        <join expr="PE_PAY.CAN_RSN_CD == PE_PAY_CANCEL_REASON.CAN_RSN_CD and PE_PAY_CANCEL_REASON.LANGUAGE_CD == 'ENG'" left="PE_PAY" right="PE_PAY_CANCEL_REASON" type="leftOuter" weight="1"></join>
        <join expr="PE_PAY.MATCH_TYPE_CD == PE_MATCH_TYPE.MATCH_TYPE_CD and PE_MATCH_TYPE.LANGUAGE_CD == 'ENG'" left="PE_PAY" right="PE_MATCH_TYPE" type="leftOuter" weight="1"></join>
        <join expr="PE_PAY_TENDER.TNDR_STATUS_FLG == PE_TENDER_STATUS.FIELD_VALUE and PE_TENDER_STATUS.FIELD_NAME == 'TNDR_STATUS_FLG' and PE_TENDER_STATUS.LANGUAGE_CD == 'ENG'" left="PE_PAY_TENDER" right="PE_TENDER_STATUS" type="leftOuter" weight="1"></join>
        <join expr="PE_PAY_TENDER.CAN_RSN_CD == PE_TENDER_CANCEL_REASON.CAN_RSN_CD and PE_TENDER_CANCEL_REASON.LANGUAGE_CD == 'ENG'" left="PE_PAY_TENDER" right="PE_TENDER_CANCEL_REASON" type="leftOuter" weight="1"></join>
        <join expr="PE_PAY_TENDER.TENDER_TYPE_CD == PE_TENDER_TYPE.TENDER_TYPE_CD and PE_TENDER_TYPE.LANGUAGE_CD == 'ENG'" left="PE_PAY_TENDER" right="PE_TENDER_TYPE" type="leftOuter" weight="1"></join>
        <join expr="PE_TENDER_CONTROL.TNDR_CTL_ST_FLG == PE_TENDER_CONTROL_STATUS.FIELD_VALUE and PE_TENDER_CONTROL_STATUS.FIELD_NAME == 'TNDR_CTL_ST_FLG' and PE_TENDER_CONTROL_STATUS.LANGUAGE_CD == 'ENG'" left="PE_TENDER_CONTROL" right="PE_TENDER_CONTROL_STATUS" type="leftOuter" weight="1"></join>
        <join expr="PE_TENDER_CONTROL.TNDR_SOURCE_CD == PE_TENDER_SOURCE.TNDR_SOURCE_CD and PE_TENDER_SOURCE.LANGUAGE_CD == 'ENG'" left="PE_TENDER_CONTROL" right="PE_TENDER_SOURCE" type="leftOuter" weight="1"></join>
        <join expr="PE_DEPOSIT_CONTROL.DEP_CTL_STATUS_FLG == PE_DEPOSIT_STATUS.FIELD_VALUE and PE_DEPOSIT_STATUS.FIELD_NAME == 'DEP_CTL_STATUS_FLG' and PE_DEPOSIT_STATUS.LANGUAGE_CD == 'ENG'" left="PE_DEPOSIT_CONTROL" right="PE_DEPOSIT_STATUS" type="leftOuter" weight="1"></join>
        <join expr="PE_PAY_PLAN.PAY_METH_CD == PE_PAY_METHOD.PAY_METH_CD and PE_PAY_METHOD.LANGUAGE_CD == 'ENG'" left="PE_PAY_PLAN" right="PE_PAY_METHOD" type="leftOuter" weight="1"></join>
        <join expr="PE_PAY_PLAN.PP_TYPE_CD == PE_PAY_PLAN_TYPE.PP_TYPE_CD and PE_PAY_PLAN_TYPE.LANGUAGE_CD == 'ENG'" left="PE_PAY_PLAN" right="PE_PAY_PLAN_TYPE" type="leftOuter" weight="1"></join>
        <join expr="PE_PAY_PLAN.PP_STAT_FLG == PE_PAY_PLAN_STATUS.FIELD_VALUE and PE_PAY_PLAN_STATUS.FIELD_NAME == 'PP_STAT_FLG' and PE_PAY_PLAN_STATUS.LANGUAGE_CD == 'ENG'" left="PE_PAY_PLAN" right="PE_PAY_PLAN_STATUS" type="leftOuter" weight="1"></join>
        <join expr="PE_PAY_EVENT.PAY_EVENT_ID == DC_PAY_EVENT.PAY_EVENT_ID" left="PE_PAY_EVENT" right="DC_PAY_EVENT" type="leftOuter" weight="1"></join>
        <join expr="DC_DEPOSIT_CONTROL.DEP_CTL_ID == DC_TENDER_CONTROL.DEP_CTL_ID" left="DC_DEPOSIT_CONTROL" right="DC_TENDER_CONTROL" type="leftOuter" weight="1"></join>
        <join expr="DC_TENDER_CONTROL.TNDR_CTL_ID == DC_PAY_TENDER.TNDR_CTL_ID" left="DC_TENDER_CONTROL" right="DC_PAY_TENDER" type="leftOuter" weight="1"></join>
        <join expr="DC_PAY_TENDER.PAY_EVENT_ID == DC_PAY_EVENT.PAY_EVENT_ID" left="DC_PAY_TENDER" right="DC_PAY_EVENT" type="leftOuter" weight="1"></join>
        <join expr="DC_PAY_EVENT.PAY_EVENT_ID == DC_PAY.PAY_EVENT_ID" left="DC_PAY_EVENT" right="DC_PAY" type="leftOuter" weight="1"></join>
        <join expr="DC_DEPOSIT_CONTROL.DEP_CTL_ID == DC_TENDER_DEPOSIT.DEP_CTL_ID" left="DC_DEPOSIT_CONTROL" right="DC_TENDER_DEPOSIT" type="leftOuter" weight="1"></join>
        <join expr="DC_TENDER_CONTROL.TNDR_CTL_ID == DC_TENDER_END_BALANCE.TNDR_CTL_ID" left="DC_TENDER_CONTROL" right="DC_TENDER_END_BALANCE" type="leftOuter" weight="1"></join>
        <join expr="DC_PAY_TENDER.PAYOR_ACCT_ID == DC_ACCOUNT.ACCT_ID" left="DC_PAY_TENDER" right="DC_ACCOUNT" type="leftOuter" weight="1"></join>
        <join expr="DC_ACCOUNT.ACCT_ID == DC_MAIN_CUSTOMER.ACCT_ID and DC_MAIN_CUSTOMER.MAIN_CUST_SW == 'Y'" left="DC_ACCOUNT" right="DC_MAIN_CUSTOMER" type="leftOuter" weight="1"></join>
        <join expr="DC_MAIN_CUSTOMER.PER_ID == DC_PERSON.PER_ID" left="DC_MAIN_CUSTOMER" right="DC_PERSON" type="leftOuter" weight="1"></join>
        <join expr="DC_MAIN_CUSTOMER.PER_ID == DC_PRIMARY_NAME.PER_ID and DC_PRIMARY_NAME.PRIM_NAME_SW == 'Y'" left="DC_MAIN_CUSTOMER" right="DC_PRIMARY_NAME" type="leftOuter" weight="1"></join>
        <join expr="DC_DEPOSIT_CONTROL.DEP_CTL_STATUS_FLG == DC_DEPOSIT_STATUS.FIELD_VALUE and DC_DEPOSIT_STATUS.FIELD_NAME == 'DEP_CTL_STATUS_FLG' and DC_DEPOSIT_STATUS.LANGUAGE_CD == 'ENG'" left="DC_DEPOSIT_CONTROL" right="DC_DEPOSIT_STATUS" type="leftOuter" weight="1"></join>
        <join expr="DC_DEPOSIT_CONTROL.TNDR_SRCE_TYPE_FLG == DC_TENDER_SOURCE_TYPE.FIELD_VALUE and DC_TENDER_SOURCE_TYPE.FIELD_NAME == 'TNDR_SRCE_TYPE_FLG' and DC_TENDER_SOURCE_TYPE.LANGUAGE_CD == 'ENG'" left="DC_DEPOSIT_CONTROL" right="DC_TENDER_SOURCE_TYPE" type="leftOuter" weight="1"></join>
        <join expr="DC_TENDER_CONTROL.TNDR_CTL_ST_FLG == DC_TENDER_CONTROL_STATUS.FIELD_VALUE and DC_TENDER_CONTROL_STATUS.FIELD_NAME == 'TNDR_CTL_ST_FLG' and DC_TENDER_CONTROL_STATUS.LANGUAGE_CD == 'ENG'" left="DC_TENDER_CONTROL" right="DC_TENDER_CONTROL_STATUS" type="leftOuter" weight="1"></join>
        <join expr="DC_TENDER_CONTROL.TNDR_SOURCE_CD == DC_TENDER_SOURCE.TNDR_SOURCE_CD and DC_TENDER_SOURCE.LANGUAGE_CD == 'ENG'" left="DC_TENDER_CONTROL" right="DC_TENDER_SOURCE" type="leftOuter" weight="1"></join>
        <join expr="DC_TENDER_CONTROL.BATCH_CD == DC_BATCH_CONTROL.BATCH_CD and DC_BATCH_CONTROL.LANGUAGE_CD == 'ENG'" left="DC_TENDER_CONTROL" right="DC_BATCH_CONTROL" type="leftOuter" weight="1"></join>
        <join expr="DC_PAY_TENDER.TENDER_TYPE_CD == DC_TENDER_TYPE.TENDER_TYPE_CD and DC_TENDER_TYPE.LANGUAGE_CD == 'ENG'" left="DC_PAY_TENDER" right="DC_TENDER_TYPE" type="leftOuter" weight="1"></join>
        <join expr="DC_TENDER_DEPOSIT.BANK_CD == DC_BANK.BANK_CD and DC_BANK.LANGUAGE_CD == 'ENG'" left="DC_TENDER_DEPOSIT" right="DC_BANK" type="leftOuter" weight="1"></join>
        <join expr="DC_TENDER_DEPOSIT.BANK_CD == DC_BANK_ACCOUNT.BANK_CD and DC_TENDER_DEPOSIT.BANK_ACCT_KEY == DC_BANK_ACCOUNT.BANK_ACCT_KEY and DC_BANK_ACCOUNT.LANGUAGE_CD == 'ENG'" left="DC_TENDER_DEPOSIT" right="DC_BANK_ACCOUNT" type="leftOuter" weight="1"></join>
        <join expr="PE_ACCOUNT.ACCT_ID == PP_ACCOUNT.ACCT_ID" left="PE_ACCOUNT" right="PP_ACCOUNT" type="leftOuter" weight="1"></join>
        <join expr="PP_PAY_PLAN.PP_ID == PP_PAY_PLAN_SCHEDULE.PP_ID" left="PP_PAY_PLAN" right="PP_PAY_PLAN_SCHEDULE" type="leftOuter" weight="1"></join>
        <join expr="PP_PAY_PLAN.ACCT_ID == PP_ACCOUNT.ACCT_ID" left="PP_PAY_PLAN" right="PP_ACCOUNT" type="leftOuter" weight="1"></join>
        <join expr="PP_ACCOUNT.ACCT_ID == PP_MAIN_CUSTOMER.ACCT_ID and PP_MAIN_CUSTOMER.MAIN_CUST_SW == 'Y'" left="PP_ACCOUNT" right="PP_MAIN_CUSTOMER" type="leftOuter" weight="1"></join>
