        <join expr="PP_PAY_PLAN.PP_CAN_RSN_FLG == PP_PAY_PLAN_CANCEL_REASON.FIELD_VALUE and PP_PAY_PLAN_CANCEL_REASON.FIELD_NAME == 'PP_CAN_RSN_FLG' and PP_PAY_PLAN_CANCEL_REASON.LANGUAGE_CD == 'ENG'" left="PP_PAY_PLAN" right="PP_PAY_PLAN_CANCEL_REASON" type="leftOuter" weight="1"></join>
