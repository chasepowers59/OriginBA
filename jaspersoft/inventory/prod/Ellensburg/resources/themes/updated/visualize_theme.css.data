:root {
    --jrs-theme-light: #e0f0f9;
    --jrs-theme-medium-light: #0078bd;
    --jrs-theme-medium-dark: #01529a;
    --jrs-theme-dark: #062e79;
}

textarea[readonly]:focus {
    cursor: not-allowed;
    outline-style: dotted !important;
}

select.focus-visible {
    border-radius: 1px;
    outline: 2px solid var(--jrs-theme-dark);
    outline-offset: 2px;
}

input[type=checkbox].focus-visible,
input[type=radio].focus-visible {
    outline: 2px solid var(--jrs-theme-dark);
    outline-offset: 2px;
}
/* jquery calendar picker */
.jr .ui-datepicker .ui-datepicker-prev:focus-visible,
.jr .ui-datepicker .ui-datepicker-next:focus-visible,
.jr .ui-datepicker td[data-handler="selectDay"]:focus-within {
    background-color: transparent;
    box-shadow: none;
    outline: 2px solid var(--jrs-theme-dark);
    outline-offset: -1px;
}

.jr .ui-datepicker button[class^="ui-datepicker-"]:focus-visible {
    outline: 2px solid var(--jrs-theme-dark);
    outline-offset: 1px;
    border-radius: 2px;
}

/* Keyboard Focus */
.control.switch .focus-visible + .wrap .track {
    outline: 2px solid var(--jrs-theme-dark);
    outline-offset: 1px;
}
/* Keyboard Focus */
.button.search.focus-visible,
.button.searchClear.focus-visible {
    outline: 2px solid var(--jrs-theme-dark);
    outline-offset: 0;
}

input[type=checkbox].focus-visible,
input[type=radio].focus-visible,
input[type=text].focus-visible {
    outline: 2px solid var(--jrs-theme-dark);
    outline-offset: 2px;
}

.jr-mItemselector-button.focus-visible.jr {
    outline: 2px solid var(--jrs-theme-dark);
    outline-offset: -1px;
    z-index: 99;
}

.jive_chartSettingsIcon:focus,
.jive_chartSettingsIcon:focus-visible {
     outline: 2px solid var(--jrs-theme-dark);
     outline-offset: 2px;
}