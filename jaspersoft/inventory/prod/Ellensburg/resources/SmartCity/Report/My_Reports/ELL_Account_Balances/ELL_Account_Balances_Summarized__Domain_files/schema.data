      <joinInfo alias="C1_BI_SA_SNAPSHOT_SUM" referenceId="C1_BI_SA_SNAPSHOT_SUM"></joinInfo>
      <joinList>
        <join expr="C1_BI_SA_SNAPSHOT_SUM.ACCT_ID == CI_ACCT.ACCT_ID" left="C1_BI_SA_SNAPSHOT_SUM" right="CI_ACCT" type="leftOuter" weight="1"></join>
        <join expr="C1_BI_SA_SNAPSHOT_SUM.PER_ID == CM_PER_CONTACTS.PER_ID" left="C1_BI_SA_SNAPSHOT_SUM" right="CM_PER_CONTACTS" type="leftOuter" weight="1"></join>
        <join expr="C1_BI_SA_SNAPSHOT_SUM.PREMISE == CI_PREM.PREM_ID" left="C1_BI_SA_SNAPSHOT_SUM" right="CI_PREM" type="leftOuter" weight="1"></join>
        <join expr="C1_BI_SA_SNAPSHOT_SUM.PER_ID == CM_PER_CHAR_LOW_INCOME.PER_ID" left="C1_BI_SA_SNAPSHOT_SUM" right="CM_PER_CHAR_LOW_INCOME" type="leftOuter" weight="1"></join>
        <join expr="C1_BI_SA_SNAPSHOT_SUM.ACCT_ID == MAILING_PREM.ACCT_ID" left="C1_BI_SA_SNAPSHOT_SUM" right="MAILING_PREM" type="leftOuter" weight="1"></join>
      </joinList>
      <joinOptions suppressCircularJoins="true"></joinOptions>
      <query>Select sp.acct_id,sp.per_id, max(nvl((select distinct(char_prem_id) from cisadm.ci_sa sa where sa.sa_id = sp.sa_id), ' ' )) as premise , sum(sp.cur_bal),sum(sp.tot_bal)
from CISADM.C1_BI_SA_SNAPSHOT sp where sp.c1_snapshot_dt = (select max(sp2.c1_snapshot_dt) from cisadm.C1_BI_SA_SNAPSHOT sp2 where sp.acct_id = sp2.acct_id and sp.per_id = sp2.per_id) group by sp.acct_id,sp.per_id</query>
      <tableRefList>
        <tableRef alwaysIncludeTable="false" tableAlias="CI_ACCT" tableId="CI_ACCT"></tableRef>
        <tableRef alwaysIncludeTable="false" tableAlias="C1_BI_SA_SNAPSHOT_SUM" tableId="C1_BI_SA_SNAPSHOT_SUM"></tableRef>
        <tableRef alwaysIncludeTable="false" tableAlias="CI_PREM" tableId="CI_PREM"></tableRef>
