      <items>
        <item id="Account_ID_1" label="Account ID" resourceId="ELL_SEV_PROC_ACTIVE_SA.Account_ID_1"></item>
        <item id="Creation_Date_Time_8" label="Create Date/Time" resourceId="ELL_SEV_PROC_ACTIVE_SA.Creation_Date_Time_8"></item>
        <item id="SA_ID_2" label="Service Agreement" resourceId="ELL_SEV_PROC_ACTIVE_SA.SA_ID_2"></item>
        <item id="SA_Status_4" label="SA Status" resourceId="ELL_SEV_PROC_ACTIVE_SA.SA_Status_4"></item>
        <item id="SA_Type_3" label="SA Type" resourceId="ELL_SEV_PROC_ACTIVE_SA.SA_Type_3"></item>
