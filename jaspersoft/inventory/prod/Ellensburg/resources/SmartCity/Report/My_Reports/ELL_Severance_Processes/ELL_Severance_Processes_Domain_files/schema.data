        <item id="Severance_Event_Status_10" label="Severance Event Status" resourceId="ELL_SEV_PROC_ACTIVE_SA.Severance_Event_Status_10"></item>
        <item id="Severance_Event_Trigger_Date_11" label="Trigger Date" resourceId="ELL_SEV_PROC_ACTIVE_SA.Severance_Event_Trigger_Date_11"></item>
        <item id="Severance_Event_Type_9" label="Severance Event Type" resourceId="ELL_SEV_PROC_ACTIVE_SA.Severance_Event_Type_9"></item>
        <item id="Severance_ID_5" label="Severance Process ID" resourceId="ELL_SEV_PROC_ACTIVE_SA.Severance_ID_5"></item>
        <item id="Severance_Status_7" label="Severance Status" resourceId="ELL_SEV_PROC_ACTIVE_SA.Severance_Status_7"></item>
