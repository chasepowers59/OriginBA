      </items>
    </itemGroup>
  </itemGroups>
  <resources>
    <jdbcQuery id="ELL_SEV_PROC_STOPPED_SA" datasourceId="Ellensburg_DS">
      <fieldList>
        <field id="Account_ID" fieldDBName="Account ID" type="java.lang.String"></field>
        <field id="SA_ID" fieldDBName="SA ID" type="java.lang.String"></field>
        <field id="SA_Type" fieldDBName="SA Type" type="java.lang.String"></field>
        <field id="SA_Status" fieldDBName="SA Status" type="java.lang.String"></field>
        <field id="Severance_ID" fieldDBName="Severance ID" type="java.lang.String"></field>
        <field id="Severance_Template" fieldDBName="Severance Template" type="java.lang.String"></field>
        <field id="Severance_Status" fieldDBName="Severance Status" type="java.lang.String"></field>
        <field id="Creation_Date_Time" fieldDBName="Creation Date/Time" type="java.sql.Timestamp"></field>
        <field id="Severance_Event_Type" fieldDBName="Severance Event Type" type="java.lang.String"></field>
        <field id="Severance_Event_Status" fieldDBName="Severance Event Status" type="java.lang.String"></field>
        <field id="Severance_Event_Trigger_Date" fieldDBName="Severance Event Trigger Date" type="java.sql.Timestamp"></field>
        <field id="Severance_Event_Completion_Date" fieldDBName="Severance Event Completion Date" type="java.sql.Timestamp"></field>
      </fieldList>
      <query>SELECT 
    SA.ACCT_ID AS "Account ID",
    SA.SA_ID AS "SA ID",
    SA.SA_TYPE_CD AS "SA Type",
    (SELECT DESCR FROM CISADM.CI_LOOKUP WHERE FIELD_NAME = 'SA_STATUS_FLG' AND FIELD_VALUE = SA.SA_STATUS_FLG) AS "SA Status",
    SEV_PROC.SEV_PROC_ID AS "Severance ID",
    SEV_PROC.SEV_PROC_TMPL_CD AS "Severance Template",
    (SELECT DESCR FROM CISADM.CI_LOOKUP WHERE FIELD_NAME = 'SEV_STATUS_FLG' AND FIELD_VALUE = SEV_PROC.SEV_STATUS_FLG) AS "Severance Status",
    SEV_PROC.CRE_DTTM AS "Creation Date/Time",
    SEV_EVT.SEV_EVT_TYPE_CD AS "Severance Event Type",
    (SELECT DESCR FROM CISADM.CI_LOOKUP WHERE FIELD_NAME = 'SEV_EVT_STAT_FLG' AND FIELD_VALUE = SEV_EVT.SEV_EVT_STAT_FLG) AS "Severance Event Status",
    SEV_EVT.TRIGGER_DT AS "Severance Event Trigger Date",
    SEV_EVT.COMPLETION_DT AS "Severance Event Completion Date"
FROM 
    CISADM.CI_SA SA,
    CISADM.CI_SEV_PROC SEV_PROC,
    CISADM.CI_SEV_EVT SEV_EVT
WHERE
    SEV_PROC.SA_ID = SA.SA_ID
    AND SEV_PROC.SEV_PROC_ID = SEV_EVT.SEV_PROC_ID
    AND SA.SA_STATUS_FLG = 60
    AND SEV_EVT.SEV_EVT_STAT_FLG = 30
    AND NOT EXISTS 
        (SELECT
            1
        FROM
            CISADM.D1_INSTALL_EVT IE,
            CISADM.D1_SP_IDENTIFIER MDM_SPI,
            CISADM.CI_SP CCB_SP,
            CISADM.CI_SA_SP SASP,
            CISADM.CI_SA SA_SUB
        WHERE
            IE.D1_SP_ID = MDM_SPI.D1_SP_ID
            AND MDM_SPI.ID_VALUE = CCB_SP.SP_ID
            AND CCB_SP.SP_ID = SASP.SP_ID
            AND SASP.SA_ID = SA_SUB.SA_ID
            AND SA_SUB.SA_ID = SA.SA_ID
        )
    AND SEV_PROC.SEV_PROC_ID = 
        (SELECT SEV_PROC_ID
         FROM CISADM.CI_SEV_PROC SEV_PROC_SUB
         WHERE SEV_PROC_SUB.SA_ID = SEV_PROC.SA_ID
         AND SEV_PROC_SUB.SEV_STATUS_FLG = 20
         ORDER BY SEV_PROC_SUB.CRE_DTTM DESC
         FETCH FIRST 1 ROWS ONLY)</query>
    </jdbcQuery>
    <jdbcQuery id="ELL_SEV_PROC_ACTIVE_SA" datasourceId="Ellensburg_DS">
      <fieldList>
        <field id="Account_ID_1" fieldDBName="Account ID" type="java.lang.String"></field>
        <field id="SA_ID_2" fieldDBName="SA ID" type="java.lang.String"></field>
        <field id="SA_Type_3" fieldDBName="SA Type" type="java.lang.String"></field>
        <field id="SA_Status_4" fieldDBName="SA Status" type="java.lang.String"></field>
        <field id="Severance_ID_5" fieldDBName="Severance ID" type="java.lang.String"></field>
        <field id="Severance_Template_6" fieldDBName="Severance Template" type="java.lang.String"></field>
        <field id="Severance_Status_7" fieldDBName="Severance Status" type="java.lang.String"></field>
        <field id="Creation_Date_Time_8" fieldDBName="Creation Date/Time" type="java.sql.Timestamp"></field>
        <field id="Severance_Event_Type_9" fieldDBName="Severance Event Type" type="java.lang.String"></field>
        <field id="Severance_Event_Status_10" fieldDBName="Severance Event Status" type="java.lang.String"></field>
        <field id="Severance_Event_Trigger_Date_11" fieldDBName="Severance Event Trigger Date" type="java.sql.Timestamp"></field>
        <field id="Severance_Event_Completion_Date_12" fieldDBName="Severance Event Completion Date" type="java.sql.Timestamp"></field>
      </fieldList>
      <query>SELECT 
    SA.ACCT_ID AS "Account ID",
    SA.SA_ID AS "SA ID",
    SA.SA_TYPE_CD AS "SA Type",
    (SELECT DESCR FROM CISADM.CI_LOOKUP WHERE FIELD_NAME = 'SA_STATUS_FLG' AND FIELD_VALUE = SA.SA_STATUS_FLG) AS "SA Status",
    SEV_PROC.SEV_PROC_ID AS "Severance ID",
    SEV_PROC.SEV_PROC_TMPL_CD AS "Severance Template",
    (SELECT DESCR FROM CISADM.CI_LOOKUP WHERE FIELD_NAME = 'SEV_STATUS_FLG' AND FIELD_VALUE = SEV_PROC.SEV_STATUS_FLG) AS "Severance Status",
    SEV_PROC.CRE_DTTM AS "Creation Date/Time",
    SEV_EVT.SEV_EVT_TYPE_CD AS "Severance Event Type",
    (SELECT DESCR FROM CISADM.CI_LOOKUP WHERE FIELD_NAME = 'SEV_EVT_STAT_FLG' AND FIELD_VALUE = SEV_EVT.SEV_EVT_STAT_FLG) AS "Severance Event Status",
    SEV_EVT.TRIGGER_DT AS "Severance Event Trigger Date",
    SEV_EVT.COMPLETION_DT AS "Severance Event Completion Date"
FROM 
    CISADM.CI_SA SA,
    CISADM.CI_SEV_PROC SEV_PROC,
    CISADM.CI_SEV_EVT SEV_EVT
WHERE
    SEV_PROC.SA_ID = SA.SA_ID
    AND SEV_PROC.SEV_PROC_ID = SEV_EVT.SEV_PROC_ID
    AND SA.SA_STATUS_FLG = 20
    AND SEV_PROC.SEV_STATUS_FLG = 10
    AND SEV_EVT.SEV_EVT_STAT_FLG = 10
    AND (SEV_EVT.TRIGGER_DT - SYSDATE) &lt;= 3
    AND NOT EXISTS 
        (SELECT
            1
        FROM
            CISADM.D1_INSTALL_EVT IE,
            CISADM.D1_SP_IDENTIFIER MDM_SPI,
            CISADM.CI_SP CCB_SP,
            CISADM.CI_SA_SP SASP,
            CISADM.CI_SA SA_SUB
        WHERE
            IE.D1_SP_ID = MDM_SPI.D1_SP_ID
            AND MDM_SPI.ID_VALUE = CCB_SP.SP_ID
            AND CCB_SP.SP_ID = SASP.SP_ID
            AND SASP.SA_ID = SA_SUB.SA_ID
            AND SA_SUB.SA_ID = SA.SA_ID
        )</query>
    </jdbcQuery>
  </resources>
</schema>
