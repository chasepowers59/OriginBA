  <subFilterList>
    <subFilter id="filter_1" letter="A" sourceString="DYNAMIC">
      <expressionString>isAnyValue(CI_FT.FT_TYPE_FLG)</expressionString>
      <parameterizedExpressionString>CI_FT.FT_TYPE_FLG in FT_TYPE_FLG_1</parameterizedExpressionString>
    </subFilter>
    <subFilter id="filter_6" letter="B" sourceString="DYNAMIC">
      <expressionString>CI_FT_PROC.BATCH_NBR != 1</expressionString>
      <parameterizedExpressionString>CI_FT_PROC.BATCH_NBR != BATCH_NBR_1</parameterizedExpressionString>
