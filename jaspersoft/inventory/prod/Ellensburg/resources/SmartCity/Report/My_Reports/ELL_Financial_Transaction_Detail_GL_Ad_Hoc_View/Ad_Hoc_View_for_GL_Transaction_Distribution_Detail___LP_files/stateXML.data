    </subFilter>
    <subFilter id="filter_4" letter="E" sourceString="DYNAMIC">
      <expressionString>CI_FT_PROC.BATCH_CD == 'C1-GLFCX'</expressionString>
      <parameterizedExpressionString>CI_FT_PROC.BATCH_CD == BATCH_CD_1</parameterizedExpressionString>
