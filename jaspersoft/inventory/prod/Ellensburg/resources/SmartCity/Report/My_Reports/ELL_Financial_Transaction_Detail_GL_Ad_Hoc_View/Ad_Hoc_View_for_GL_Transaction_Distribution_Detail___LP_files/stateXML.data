    <subFilter id="filter_5" letter="F" sourceString="DYNAMIC">
      <expressionString>CI_FT.FREEZE_SW == 'Y'</expressionString>
      <parameterizedExpressionString>CI_FT.FREEZE_SW == FREEZE_SW_1</parameterizedExpressionString>
    </subFilter>
    <subFilter id="filter_7" letter="G" sourceString="DYNAMIC">
