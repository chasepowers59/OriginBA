        <item id="RCR_CHG_AMT" label="Recurrning Charge Amount" resourceId="JoinTree_1.CI_SA_RCHG_HIST.RCR_CHG_AMT"></item>
        <item id="SA_ID" label="SA Id" resourceId="JoinTree_1.CI_SA_RCHG_HIST.SA_ID"></item>
