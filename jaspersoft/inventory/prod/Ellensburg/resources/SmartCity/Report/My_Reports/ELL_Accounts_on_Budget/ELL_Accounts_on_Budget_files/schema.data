  <resources>
    <jdbcTable id="CI_SA" datasourceId="Ellensburg_DS" datasourceTableName="CI_SA" schemaAlias="CISADM">
      <fieldList>
        <field id="SA_ID" type="java.lang.String"></field>
        <field id="PROP_DCL_RSN_CD" type="java.lang.String"></field>
        <field id="PROP_SA_ID" type="java.lang.String"></field>
        <field id="CIS_DIVISION" type="java.lang.String"></field>
        <field id="SA_TYPE_CD" type="java.lang.String"></field>
        <field id="START_OPT_CD" type="java.lang.String"></field>
        <field id="START_DT" type="java.sql.Timestamp"></field>
        <field id="SA_STATUS_FLG" type="java.lang.String"></field>
        <field id="ACCT_ID" type="java.lang.String"></field>
        <field id="END_DT" type="java.sql.Timestamp"></field>
        <field id="OLD_ACCT_ID" type="java.lang.String"></field>
        <field id="CUST_READ_FLG" type="java.lang.String"></field>
        <field id="ALLOW_EST_SW" type="java.lang.String"></field>
        <field id="SIC_CD" type="java.lang.String"></field>
        <field id="CHAR_PREM_ID" type="java.lang.String"></field>
