    <jdbcQuery id="CM_PER_CONTACTS" datasourceId="Ellensburg_DS">
      <fieldList>
        <field id="PER_ID" type="java.lang.String"></field>
        <field id="SEQ_NUM" type="java.math.BigDecimal"></field>
        <field id="ENTITY_NAME" type="java.lang.String"></field>
        <field id="NAME_TYPE_FLG" type="java.lang.String"></field>
        <field id="VERSION" type="java.math.BigDecimal"></field>
        <field id="PRIM_NAME_SW" type="java.lang.String"></field>
        <field id="ENTITY_NAME_UPR" type="java.lang.String"></field>
        <field id="PRIMARYEMAIL" type="java.lang.String"></field>
        <field id="PRIM_PHONE" type="java.lang.String"></field>
      </fieldList>
      <query>Select PN.*,
    CASE 
    WHEN NVL((select ct.contact_value from cisadm.c1_per_contdet ct where ct.per_id = PN.per_id and ct.comm_rte_type_cd ='HOMEPHONE' and cnd_primary_flg = 'C1YS' and CND_ACTINACT_FLG = 'C1AC' ),' ') &lt;&gt; ' ' THEN
         NVL((select ct.contact_value from cisadm.c1_per_contdet ct where ct.per_id = PN.per_id and ct.comm_rte_type_cd ='HOMEPHONE' and cnd_primary_flg = 'C1YS' and CND_ACTINACT_FLG = 'C1AC' ),' ')
	WHEN NVL((select ct.contact_value from cisadm.c1_per_contdet ct where ct.per_id = PN.per_id and ct.comm_rte_type_cd ='CELLPHONE' and cnd_primary_flg = 'C1YS' and CND_ACTINACT_FLG = 'C1AC' ),' ') &lt;&gt; ' ' THEN
	     NVL((select ct.contact_value from cisadm.c1_per_contdet ct where ct.per_id = PN.per_id and ct.comm_rte_type_cd ='CELLPHONE' and cnd_primary_flg = 'C1YS' and CND_ACTINACT_FLG = 'C1AC' ),' ')
    WHEN NVL((select ct.contact_value from cisadm.c1_per_contdet ct where ct.per_id = PN.per_id and ct.comm_rte_type_cd ='WORKPHONE' and cnd_primary_flg = 'C1YS' and CND_ACTINACT_FLG = 'C1AC' ),' ')  &lt;&gt; ' ' THEN
         NVL((select ct.contact_value from cisadm.c1_per_contdet ct where ct.per_id = PN.per_id and ct.comm_rte_type_cd ='WORKPHONE' and cnd_primary_flg = 'C1YS' and CND_ACTINACT_FLG = 'C1AC' ),' ') 
    ELSE ' '
    end as PRIM_PHONE,
    NVL((select ct.contact_value from cisadm.c1_per_contdet ct where ct.per_id = PN.per_id and ct.comm_rte_type_cd ='PRIMARYEMAIL' and cnd_primary_flg = 'C1YS' and CND_ACTINACT_FLG = 'C1AC' ),' ') AS PRIMARYEMAIL
from
    CISADM.CI_PER_NAME PN
    
where pn.name_type_flg = 'PRIM'
    and pn.prim_name_sw = 'Y'</query>
    </jdbcQuery>
