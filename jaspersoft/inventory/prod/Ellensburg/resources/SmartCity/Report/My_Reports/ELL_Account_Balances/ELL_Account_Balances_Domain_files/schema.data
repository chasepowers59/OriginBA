    <jdbcQuery id="MAILING_PREM" datasourceId="Ellensburg_DS">
      <fieldList>
        <field id="ACCT_ID" type="java.lang.String"></field>
        <field id="PER_ID" type="java.lang.String"></field>
        <field id="ADDRESS1" type="java.lang.String"></field>
        <field id="ADDRESS2" type="java.lang.String"></field>
        <field id="CITY" type="java.lang.String"></field>
        <field id="POSTAL" type="java.lang.String"></field>
        <field id="STATE" type="java.lang.String"></field>
        <field id="COUNTRY" type="java.lang.String"></field>
      </fieldList>
      <query>Select ap.acct_id, ap.per_id,
    CASE
    WHEN ap.bill_addr_srce_flg ='PER ' THEN (select ao.address1 from cisadm.CI_PER ao where ao.per_id = ap.per_id)
    WHEN ap.bill_addr_srce_flg ='PREM' THEN (SELECT pr.ADDRESS1_UPR from cisadm.ci_prem pr where pr.prem_id = (select a.mailing_prem_id from cisadm.ci_acct a where a.acct_id = ap.acct_id))
    WHEN ap.bill_addr_srce_flg ='ACOV' THEN (select ao.address1 from cisadm.CI_PER_ADDR_OVRD ao where ao.acct_id = ap.acct_id and ao.per_id = ap.per_id)
    ELSE ' ' 
    END as address1,
    CASE
    WHEN ap.bill_addr_srce_flg ='PER ' THEN (select ao.address2 from cisadm.CI_PER ao where ao.per_id = ap.per_id)
    WHEN ap.bill_addr_srce_flg ='PREM' THEN (SELECT pr.ADDRESS2 from cisadm.ci_prem pr where pr.prem_id = (select a.mailing_prem_id from cisadm.ci_acct a where a.acct_id = ap.acct_id))
    WHEN ap.bill_addr_srce_flg ='ACOV' THEN (select ao.address2 from cisadm.CI_PER_ADDR_OVRD ao where ao.acct_id = ap.acct_id and ao.per_id = ap.per_id)
    ELSE ' ' 
    END as address2,    
    CASE
    WHEN ap.bill_addr_srce_flg ='PER ' THEN (select ao.city from cisadm.CI_PER ao where ao.per_id = ap.per_id)
    WHEN ap.bill_addr_srce_flg ='PREM' THEN (SELECT pr.city_upr from cisadm.ci_prem pr where pr.prem_id = (select a.mailing_prem_id from cisadm.ci_acct a where a.acct_id = ap.acct_id))
    WHEN ap.bill_addr_srce_flg ='ACOV' THEN (select ao.city from cisadm.CI_PER_ADDR_OVRD ao where ao.acct_id = ap.acct_id and ao.per_id = ap.per_id)
    ELSE ' ' 
    END as city,
    CASE
    WHEN ap.bill_addr_srce_flg ='PER ' THEN (select ao.postal from cisadm.CI_PER ao where ao.per_id = ap.per_id)
    WHEN ap.bill_addr_srce_flg ='PREM' THEN (SELECT pr.postal from cisadm.ci_prem pr where pr.prem_id = (select a.mailing_prem_id from cisadm.ci_acct a where a.acct_id = ap.acct_id))
    WHEN ap.bill_addr_srce_flg ='ACOV' THEN (select ao.postal from cisadm.CI_PER_ADDR_OVRD ao where ao.acct_id = ap.acct_id and ao.per_id = ap.per_id)
    ELSE ' ' 
    END as postal,
    CASE
    WHEN ap.bill_addr_srce_flg ='PER ' THEN (select ao.state from cisadm.CI_PER ao where ao.per_id = ap.per_id)
    WHEN ap.bill_addr_srce_flg ='PREM' THEN (SELECT pr.state from cisadm.ci_prem pr where pr.prem_id = (select a.mailing_prem_id from cisadm.ci_acct a where a.acct_id = ap.acct_id))
    WHEN ap.bill_addr_srce_flg ='ACOV' THEN (select ao.state from cisadm.CI_PER_ADDR_OVRD ao where ao.acct_id = ap.acct_id and ao.per_id = ap.per_id)
    ELSE ' ' 
    END as state,
    CASE
    WHEN ap.bill_addr_srce_flg ='PER ' THEN (select ao.country from cisadm.CI_PER ao where ao.per_id = ap.per_id)
    WHEN ap.bill_addr_srce_flg ='PREM' THEN (SELECT pr.country from cisadm.ci_prem pr where pr.prem_id = (select a.mailing_prem_id from cisadm.ci_acct a where a.acct_id = ap.acct_id))
    WHEN ap.bill_addr_srce_flg ='ACOV' THEN (select ao.country from cisadm.CI_PER_ADDR_OVRD ao where ao.acct_id = ap.acct_id and ao.per_id = ap.per_id)
    ELSE ' ' 
    END as country    
from cisadm.ci_acct_per ap where ap.main_cust_sw = 'Y'</query>
    </jdbcQuery>
