      <joinInfo alias="C1_BI_SA_SNAPSHOT_MAX" referenceId="C1_BI_SA_SNAPSHOT_MAX"></joinInfo>
      <joinList>
        <join expr="C1_BI_SA_SNAPSHOT_MAX.ACCT_ID == CI_ACCT.ACCT_ID" left="C1_BI_SA_SNAPSHOT_MAX" right="CI_ACCT" type="leftOuter" weight="1"></join>
        <join expr="C1_BI_SA_SNAPSHOT_MAX.SA_ID == CI_SA.SA_ID" left="C1_BI_SA_SNAPSHOT_MAX" right="CI_SA" type="leftOuter" weight="1"></join>
        <join expr="C1_BI_SA_SNAPSHOT_MAX.PER_ID == CM_PER_CONTACTS.PER_ID" left="C1_BI_SA_SNAPSHOT_MAX" right="CM_PER_CONTACTS" type="leftOuter" weight="1"></join>
        <join expr="C1_BI_SA_SNAPSHOT_MAX.ACCT_ID == MAILING_PREM.ACCT_ID" left="C1_BI_SA_SNAPSHOT_MAX" right="MAILING_PREM" type="leftOuter" weight="1"></join>
        <join expr="C1_BI_SA_SNAPSHOT_MAX.PER_ID == CM_PER_CHAR_LOW_INCOME.PER_ID" left="C1_BI_SA_SNAPSHOT_MAX" right="CM_PER_CHAR_LOW_INCOME" type="inner" weight="1"></join>
        <join expr="CI_SA.CHAR_PREM_ID == CI_PREM.PREM_ID" left="CI_SA" right="CI_PREM" type="leftOuter" weight="1"></join>
      </joinList>
      <joinOptions suppressCircularJoins="true"></joinOptions>
      <query>Select SP.*
from CISADM.C1_BI_SA_SNAPSHOT sp where sp.c1_snapshot_dt = (select max(sp2.c1_snapshot_dt) from cisadm.C1_BI_SA_SNAPSHOT sp2 where sp.acct_id = sp2.acct_id and sp.per_id = sp2.per_id)</query>
