						<paragraph lineSpacing="1_1_2"/>
					</textElement>
					<textFieldExpression><![CDATA["According to our records, the attached invoice(s), #"+($F{billId}==null?"":$F{billId})+", dated "+($F{billDate}==null?"":(new SimpleDateFormat("MM/dd/yyyy").format($F{billDate})))+" has not been paid. <br /><br />"+

