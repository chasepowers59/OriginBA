					<property name="com.jaspersoft.studio.unit.y" value="px"/>
				</reportElement>
				<box topPadding="7" leftPadding="10" bottomPadding="10" rightPadding="10">
					<pen lineWidth="1.0" lineStyle="Dotted"/>
					<topPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<leftPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<bottomPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<rightPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
				</box>
				<textElement textAlignment="Justified" verticalAlignment="Top" markup="html">
					<font fontName="SansSerif" size="10"/>
					<paragraph lineSpacing="1_1_2"/>
				</textElement>
				<textFieldExpression><![CDATA["We accept payment by cash, check and electronic payments by card and check (fees associated with electronic payments). For phone payments, please call us at (509) 962-7201 or toll free (855) 529-2439 or you can pay online at <u>www.ellensburgwa.gov</u> and select the Pay Utility Bill option. If you have any questions or would like to make payment arrangements,please call us at (509) 962-7201. Thank you for your immediate attention to this matter.<br />"+

"RIGHT OF APPEAL: If you dispute your utility bill, you have the right to present your objections by requesting an informal appeal hearing with the clerk prior to the service disconnection date set forth on this notice. You may contact the clerk at (509) 962-7201. This informal hearing may be conducted by telephone or at City Hall, 501 N Anderson St., Ellensburg WA. The clerk will endeavor to issues a decision immediately following the hearing. Your service will not be disconnected while your informal appeal is pending."]]></textFieldExpression>
