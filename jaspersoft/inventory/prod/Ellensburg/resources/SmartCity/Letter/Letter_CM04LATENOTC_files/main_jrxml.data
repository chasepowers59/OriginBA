				<reportElement x="0" y="-12" width="572" height="60" uuid="74b851a6-3e32-4786-90d4-2334cdaa2287"/>
				<textField textAdjust="StretchHeight">
					<reportElement x="0" y="-12" width="572" height="60" uuid="95d0e317-8ea0-48bb-ba9e-992431a4ad6e">
						<property name="com.jaspersoft.studio.unit.height" value="px"/>
						<property name="com.jaspersoft.studio.unit.y" value="px"/>
					</reportElement>
					<box topPadding="2" leftPadding="10" bottomPadding="2" rightPadding="10">
						<pen lineWidth="1.0" lineStyle="Dotted"/>
						<topPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
						<leftPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
						<bottomPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
						<rightPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					</box>
					<textElement textAlignment="Justified" verticalAlignment="Top" markup="html">
						<font fontName="SansSerif" size="10"/>
						<paragraph lineSpacing="1_1_2"/>
					</textElement>
					<textFieldExpression><![CDATA["This is a reminder that the total amount due is now overdue for utility services at the above address. A $10 late fee has been charged to this account and will show in the Account Activity on your next bill. Payment must be made in full at our office by the due date to prevent interruption of service. If payment has been made, thank you for your payment and please disregard this notice. <br />"+
"If a payment plan has already been set up with our customer service staff, a $10 late fee will not be charged. If you need to set a fixed due date to avoid late payments, please contact our customer staff at (509) 962-7201 during normal business hours.<br />"+
"If you dispute the amount owing, or are unable to pay the full amount, contact our office at (509) 962-7201. You have the right of appeal if you dispute your utility bill. See RIGHT OF APPEAL process below: "]]></textFieldExpression>
				</textField>
			</frame>
		</band>
