				</textElement>
				<textFieldExpression><![CDATA["<b>Si disputa el monto adeudado, tiene derecho a consultar con un representante de la Ciudad.</b><br /><br />"+
"Paga directamente en:<br /><br />"+
"Departamento de Finanzas, Ayuntamiento<br />"+
"501 N. Calle Anderson<br />"+ 
