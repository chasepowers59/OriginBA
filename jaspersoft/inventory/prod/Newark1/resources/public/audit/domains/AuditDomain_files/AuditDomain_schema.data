  <resources>
    <null id="constant_fields_level" datasourceId="AuditVirtualDataSource">
      <fieldList>
        <field id="orgpath" dataSetExpression="groovy('(tenant.getTenantFolderUri() == &quot;/&quot;) ? &quot;/&quot; : tenant.getTenantFolderUri() + &quot;/&quot;')" type="java.lang.String" />
        <field id="tenantUri" dataSetExpression="groovy('tenant.getTenantUri()')" type="java.lang.String" />
      </fieldList>
    </null>
    <jdbcTable id="jirole" datasourceId="AuditVirtualDataSource" datasourceTableName="JIROLE" schemaAlias="JasperserverDataSource_JASPERSERVER">
      <fieldList>
