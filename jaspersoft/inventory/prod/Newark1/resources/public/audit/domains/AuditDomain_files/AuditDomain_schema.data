        <field id="EXTERNALLYDEFINED" type="java.math.BigDecimal" />
        <field id="ENABLED" type="java.math.BigDecimal" />
        <field id="PREVIOUSPASSWORDCHANGETIME" type="java.sql.Timestamp" />
      </fieldList>
    </jdbcTable>
    <jdbcTable id="jiuser2" datasourceId="AuditVirtualDataSource" datasourceTableName="JIUSER" schemaAlias="JasperserverDataSource_JASPERSERVER">
      <fieldList>
        <field id="ID" type="java.math.BigDecimal" />
        <field id="USERNAME" type="java.lang.String" />
        <field id="TENANTID" type="java.math.BigDecimal" />
        <field id="FULLNAME" type="java.lang.String" />
        <field id="EMAILADDRESS" type="java.lang.String" />
        <field id="PASSWORD" type="java.lang.String" />
        <field id="EXTERNALLYDEFINED" type="java.math.BigDecimal" />
        <field id="ENABLED" type="java.math.BigDecimal" />
        <field id="PREVIOUSPASSWORDCHANGETIME" type="java.sql.Timestamp" />
      </fieldList>
    </jdbcTable>
    <jdbcTable id="jiuserrole" datasourceId="AuditVirtualDataSource" datasourceTableName="JIUSERROLE" schemaAlias="JasperserverDataSource_JASPERSERVER">
      <fieldList>
        <field id="ROLEID" type="java.math.BigDecimal" />
        <field id="USERID" type="java.math.BigDecimal" />
      </fieldList>
    </jdbcTable>
    <jdbcTable id="jiauditevent" datasourceId="AuditVirtualDataSource" datasourceTableName="JIAUDITEVENT" schemaAlias="AuditDataSource_JASPERSERVER">
      <fieldList>
        <field id="ID" type="java.math.BigDecimal" />
        <field id="USERNAME" type="java.lang.String" />
        <field id="TENANT_ID" type="java.lang.String" />
        <field id="EVENT_DATE" type="java.sql.Timestamp" />
        <field id="RESOURCE_URI" type="java.lang.String" />
        <field id="RESOURCE_TYPE" type="java.lang.String" />
        <field id="EVENT_TYPE" type="java.lang.String" />
        <field id="REQUEST_TYPE" type="java.lang.String" />
        <field id="au_date" dataSetExpression="PARSEDATE(SUBSTRING(EVENT_DATE, 1, 10), 'yyyy''-''MM''-''dd')" type="java.util.Date" />
        <field id="au_time" dataSetExpression="parseTime(SUBSTRING(EVENT_DATE, 12), 'HH:mm:ss')" type="java.sql.Timestamp" />
        <field id="orguri1" dataSetExpression="if(isNull(RESOURCE_URI), NULL, concat('/', substr(RESOURCE_URI, length(constant_fields_level.orgpath) + 1)))" type="java.lang.String" />
        <field id="orguri" dataSetExpression="if(startsWith(RESOURCE_URI, '/public/'), RESOURCE_URI, orguri1)" type="java.lang.String" />
        <field id="filter1" dataSetExpression="(isNull(RESOURCE_URI) or contains(RESOURCE_URI, constant_fields_level.orgpath) or startsWith(RESOURCE_URI, '/public/'))" type="java.lang.Boolean" />
        <field id="filter3" dataSetExpression="(isNull(RESOURCE_URI) or not (startsWith(orguri1, '/temp/')))" type="java.lang.Boolean" />
      </fieldList>
      <filterString>filter1 == true and filter3 == true</filterString>
    </jdbcTable>
    <jdbcTable id="jiauditevent2" datasourceId="AuditVirtualDataSource" datasourceTableName="JIAUDITEVENT" schemaAlias="AuditDataSource_JASPERSERVER">
      <fieldList>
        <field id="ID" type="java.math.BigDecimal" />
        <field id="USERNAME" type="java.lang.String" />
        <field id="TENANT_ID" type="java.lang.String" />
        <field id="EVENT_DATE" type="java.sql.Timestamp" />
        <field id="RESOURCE_URI" type="java.lang.String" />
        <field id="RESOURCE_TYPE" type="java.lang.String" />
        <field id="EVENT_TYPE" type="java.lang.String" />
        <field id="REQUEST_TYPE" type="java.lang.String" />
        <field id="au_date" dataSetExpression="PARSEDATE(SUBSTRING(EVENT_DATE, 1, 10), 'yyyy''-''MM''-''dd')" type="java.util.Date" />
        <field id="au_time" dataSetExpression="parseTime(SUBSTRING(EVENT_DATE, 12), 'HH:mm:ss')" type="java.sql.Timestamp" />
        <field id="orguri1" dataSetExpression="if(isNull(RESOURCE_URI), NULL, concat('/', substr(RESOURCE_URI, length(constant_fields_level.orgpath) + 1)))" type="java.lang.String" />
        <field id="orguri" dataSetExpression="if(startsWith(RESOURCE_URI, '/public/'), RESOURCE_URI, orguri1)" type="java.lang.String" />
        <field id="filter21" dataSetExpression="(isNull(RESOURCE_URI) or startsWith(RESOURCE_URI, '/public/') or contains(RESOURCE_URI, constant_fields_level.orgpath))" type="java.lang.Boolean" />
        <field id="filter23" dataSetExpression="(isNull(RESOURCE_URI) or not (startsWith(orguri1, '/temp/')))" type="java.lang.Boolean" />
        <field id="crosstabGroupField" dataSetExpression="'Average Values'" type="java.lang.String" />
      </fieldList>
      <filterString>filter21 == true and filter23 == true and EVENT_TYPE == 'runReport'</filterString>
    </jdbcTable>
    <jdbcTable id="jiauditeventproperty" datasourceId="AuditVirtualDataSource" datasourceTableName="JIAUDITEVENTPROPERTY" schemaAlias="AuditDataSource_JASPERSERVER">
      <fieldList>
        <field id="ID" type="java.math.BigDecimal" />
        <field id="PROPERTY_TYPE" type="java.lang.String" />
        <field id="VALUE" type="java.lang.String" />
        <field id="CLOB_VALUE" type="java.lang.String" />
        <field id="AUDIT_EVENT_ID" type="java.math.BigDecimal" />
      </fieldList>
    </jdbcTable>
    <jdbcTable id="dataSourceURI" datasourceId="AuditVirtualDataSource" datasourceTableName="JIAUDITEVENTPROPERTY" schemaAlias="AuditDataSource_JASPERSERVER">
      <fieldList>
        <field id="ID" type="java.math.BigDecimal" />
        <field id="PROPERTY_TYPE" type="java.lang.String" />
        <field id="VALUE" type="java.lang.String" />
        <field id="CLOB_VALUE" type="java.lang.String" />
        <field id="AUDIT_EVENT_ID" type="java.math.BigDecimal" />
      </fieldList>
      <filterString>PROPERTY_TYPE == 'dataSource' and PROPERTY_TYPE == 'dataSource'</filterString>
    </jdbcTable>
    <jdbcTable id="query" datasourceId="AuditVirtualDataSource" datasourceTableName="JIAUDITEVENTPROPERTY" schemaAlias="AuditDataSource_JASPERSERVER">
      <fieldList>
        <field id="ID" type="java.math.BigDecimal" />
        <field id="PROPERTY_TYPE" type="java.lang.String" />
        <field id="VALUE" type="java.lang.String" />
        <field id="CLOB_VALUE" type="java.lang.String" />
        <field id="AUDIT_EVENT_ID" type="java.math.BigDecimal" />
        <field id="queryTypeFilter" dataSetExpression="(PROPERTY_TYPE == 'sqlQuery' or PROPERTY_TYPE == 'domainQuery')" type="java.lang.Boolean" />
      </fieldList>
      <filterString>queryTypeFilter == true</filterString>
    </jdbcTable>
    <jdbcTable id="queryExecutionTime" datasourceId="AuditVirtualDataSource" datasourceTableName="JIAUDITEVENTPROPERTY" schemaAlias="AuditDataSource_JASPERSERVER">
      <fieldList>
        <field id="ID" type="java.math.BigDecimal" />
        <field id="PROPERTY_TYPE" type="java.lang.String" />
        <field id="VALUE" type="java.lang.String" />
        <field id="CLOB_VALUE" type="java.lang.String" />
        <field id="AUDIT_EVENT_ID" type="java.math.BigDecimal" />
        <field id="queryExecutionTimeMS" dataSetExpression="parseInteger(VALUE, '######')" type="java.lang.Integer" />
      </fieldList>
      <filterString>PROPERTY_TYPE == 'queryExecutionTime'</filterString>
    </jdbcTable>
    <jdbcTable id="reportExecutionTime" datasourceId="AuditVirtualDataSource" datasourceTableName="JIAUDITEVENTPROPERTY" schemaAlias="AuditDataSource_JASPERSERVER">
      <fieldList>
        <field id="ID" type="java.math.BigDecimal" />
        <field id="PROPERTY_TYPE" type="java.lang.String" />
        <field id="VALUE" type="java.lang.String" />
        <field id="CLOB_VALUE" type="java.lang.String" />
        <field id="AUDIT_EVENT_ID" type="java.math.BigDecimal" />
        <field id="reportExecutionTimeMS" dataSetExpression="parseInteger(VALUE, '######')" type="java.lang.Integer" />
      </fieldList>
      <filterString>PROPERTY_TYPE == 'reportExecutionTime'</filterString>
    </jdbcTable>
    <jdbcTable id="reportRenderingTime" datasourceId="AuditVirtualDataSource" datasourceTableName="JIAUDITEVENTPROPERTY" schemaAlias="AuditDataSource_JASPERSERVER">
      <fieldList>
        <field id="ID" type="java.math.BigDecimal" />
        <field id="PROPERTY_TYPE" type="java.lang.String" />
        <field id="VALUE" type="java.lang.String" />
        <field id="CLOB_VALUE" type="java.lang.String" />
        <field id="AUDIT_EVENT_ID" type="java.math.BigDecimal" />
        <field id="reportRenderingTimeMS" dataSetExpression="parseInteger(VALUE, '######')" type="java.lang.Integer" />
      </fieldList>
      <filterString>PROPERTY_TYPE == 'reportRenderingTime'</filterString>
    </jdbcTable>
    <jdbcTable id="JoinTree_1" datasourceId="AuditVirtualDataSource" datasourceTableName="JIAUDITEVENT" schemaAlias="AuditDataSource_JASPERSERVER">
      <fieldList>
        <field id="jiuserrole.ROLEID" type="java.math.BigDecimal" />
        <field id="jiuserrole.USERID" type="java.math.BigDecimal" />
        <field id="jiauditevent.ID" type="java.math.BigDecimal" />
        <field id="jiauditevent.USERNAME" type="java.lang.String" />
        <field id="jiauditevent.TENANT_ID" type="java.lang.String" />
        <field id="jiauditevent.EVENT_DATE" type="java.sql.Timestamp" />
        <field id="jiauditevent.RESOURCE_URI" type="java.lang.String" />
        <field id="jiauditevent.RESOURCE_TYPE" type="java.lang.String" />
        <field id="jiauditevent.EVENT_TYPE" type="java.lang.String" />
        <field id="jiauditevent.REQUEST_TYPE" type="java.lang.String" />
        <field id="jiauditevent.au_date" dataSetExpression="PARSEDATE(SUBSTRING(jiauditevent.EVENT_DATE, 1, 10), 'yyyy''-''MM''-''dd')" type="java.util.Date" />
        <field id="jiauditevent.au_time" dataSetExpression="parseTime(SUBSTRING(jiauditevent.EVENT_DATE, 12), 'HH:mm:ss')" type="java.sql.Timestamp" />
        <field id="jiauditevent.orguri1" dataSetExpression="if(isNull(jiauditevent.RESOURCE_URI), null, concat('/', substr(jiauditevent.RESOURCE_URI, length(constant_fields_level.orgpath) + 1)))" type="java.lang.String" />
