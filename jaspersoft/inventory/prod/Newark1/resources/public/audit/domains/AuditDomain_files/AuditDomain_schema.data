    <jdbcTable id="jiuser" datasourceId="AuditVirtualDataSource" datasourceTableName="JIUSER" schemaAlias="JasperserverDataSource_JASPERSERVER">
      <fieldList>
        <field id="ID" type="java.math.BigDecimal" />
        <field id="USERNAME" type="java.lang.String" />
        <field id="TENANTID" type="java.math.BigDecimal" />
        <field id="FULLNAME" type="java.lang.String" />
