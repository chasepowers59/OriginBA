						<font fontName="Arial"/>
					</textElement>
					<textFieldExpression><![CDATA["Dear " + $F{entityName1} + ":"]]></textFieldExpression>
				</textField>
				<textField>
					<reportElement x="0" y="29" width="470" height="265" uuid="c71099fa-15a9-4829-bd49-2edcc4fd6c17">
						<property name="com.jaspersoft.studio.unit.height" value="px"/>
					</reportElement>
					<textElement verticalAlignment="Top" markup="html">
						<font fontName="Arial"/>
					</textElement>
					<textFieldExpression><![CDATA["After reviewing our records, it appears that a payment has not been received for the account referenced above. The account currently shows an overdue balance of $" + $F{amountStillOwed} + ". If you have already made a payment, no further action is required. <br/><br/>We will maintain water service to the above address and allow you time to make a payment on this overdue account. Please make sure the outstanding balance is paid within 30 days of the date of this letter to avoid an interruption in service. If service is disconnected, a reconnection fee of $25.00 will be added to your next bill.<br/><br/>Please note that a late fee of 1.5% of the total due balance will be applied to the next bill.<br/><br/>For assistance, please call our customer service unit Monday to Friday, from 9:00am to 4:00pm: (973)733-6370 EXT 0.<br/><br/>In addition, you can request for a payment arrangement and/or make a payment via our self-service portal: <u><font color='blue'><a href='https://mywateraccount.newarknj.gov/user/login' target='_blank'>https://mywateraccount.newarknj.gov/user/login</a></font></u> you have two choices: enroll for full access to manage your account or use the Quick Pay option to pay your bill. <br/><br/><br/>Sincerely,<br/><br/>City of Newark<br/>Department of Water and Sewer Utilities"]]></textFieldExpression>
				</textField>
			</frame>
