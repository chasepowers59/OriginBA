		<field name="PAY_DT" class="java.sql.Timestamp">
			<property name="com.jaspersoft.studio.field.name" value="PAY_DT"/>
			<property name="com.jaspersoft.studio.field.label" value="PAY_DT"/>
		</field>
		<field name="TOTAL_TENDER_AMT" class="java.math.BigDecimal">
			<property name="com.jaspersoft.studio.field.name" value="TOTAL_TENDER_AMT"/>
			<property name="com.jaspersoft.studio.field.label" value="TOTAL_TENDER_AMT"/>
		</field>
		<field name="TOTAL_NUMBER_OF_TENDERS" class="java.math.BigDecimal">
			<property name="com.jaspersoft.studio.field.name" value="TOTAL_NUMBER_OF_TENDERS"/>
			<property name="com.jaspersoft.studio.field.label" value="TOTAL_NUMBER_OF_TENDERS"/>
		</field>
	</subDataset>
	<parameter name="Report_From_Date" class="java.sql.Date"/>
