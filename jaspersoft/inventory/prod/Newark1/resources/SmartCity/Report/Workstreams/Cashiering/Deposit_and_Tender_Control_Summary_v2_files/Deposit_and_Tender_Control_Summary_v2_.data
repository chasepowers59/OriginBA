My0wNmNmLTQ1NzMtYjlmOC0zODIwNjFkNzNkNjI7Q0lTQURNLkNJX1BBWV9FVkVOVCAsMTUsMTUs
OTAxYWQ1YmItNjM0NC00Mzc3LWJlMWUtZTZiZjEyNmY0MGU1Ow==]]>
		</property>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="Newark1"/>
		<parameter name="Report_From_Date" class="java.sql.Date"/>
		<parameter name="Report_To_Date" class="java.sql.Date"/>
		<queryString language="SQL">
			<![CDATA[SELECT DC.DEP_CTL_ID, 
       TC.CRE_DTTM, 
       TC.TNDR_CTL_ID, 
       TSL.DESCR TENDER_SOURCE, 
       MAX(TRUNC(PE.PAY_DT)) PAY_DT,
       SUM(PT.TENDER_AMT) TOTAL_TENDER_AMT, 
       COUNT(PT.PAY_TENDER_ID) TOTAL_NUMBER_OF_TENDERS
FROM CISADM.CI_DEP_CTL DC
INNER JOIN CISADM.CI_TNDR_CTL TC ON TC.DEP_CTL_ID = DC.DEP_CTL_ID
INNER JOIN CISADM.CI_TNDR_SRCE_L TSL ON TSL.TNDR_SOURCE_CD = TC.TNDR_SOURCE_CD
    AND TSL.LANGUAGE_CD = 'ENG'
INNER JOIN CISADM.CI_PAY_TNDR PT ON PT.TNDR_CTL_ID = TC.TNDR_CTL_ID
    AND PT.TNDR_STATUS_FLG in ('25','60') AND PT.IN_TNDR_CTL_BAL_SW = 'Y'
INNER JOIN CISADM.CI_PAY_EVENT PE ON PE.PAY_EVENT_ID = PT.PAY_EVENT_ID
WHERE 1=1
AND TC.CRE_DTTM >= TRUNC($P{Report_From_Date} - 1) + 21/24
AND TC.CRE_DTTM <= TRUNC($P{Report_To_Date}) + 21/24
GROUP BY DC.DEP_CTL_ID, TC.CRE_DTTM, TC.TNDR_CTL_ID, TSL.DESCR
ORDER BY TC.CRE_DTTM, TSL.DESCR, PAY_DT]]>
		</queryString>
		<field name="DEP_CTL_ID" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="DEP_CTL_ID"/>
			<property name="com.jaspersoft.studio.field.label" value="DEP_CTL_ID"/>
		</field>
		<field name="CRE_DTTM" class="java.sql.Timestamp">
			<property name="com.jaspersoft.studio.field.name" value="CRE_DTTM"/>
			<property name="com.jaspersoft.studio.field.label" value="CRE_DTTM"/>
		</field>
		<field name="TNDR_CTL_ID" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="TNDR_CTL_ID"/>
			<property name="com.jaspersoft.studio.field.label" value="TNDR_CTL_ID"/>
		</field>
		<field name="TENDER_SOURCE" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="TENDER_SOURCE"/>
			<property name="com.jaspersoft.studio.field.label" value="TENDER_SOURCE"/>
