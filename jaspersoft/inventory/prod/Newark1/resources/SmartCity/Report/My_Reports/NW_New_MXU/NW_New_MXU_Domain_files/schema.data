<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.jaspersoft.com/2007/SL/XMLSchema" version="1.3">
  <dataIslands>
    <itemGroup id="New_MXU" label="New_MXU" resourceId="New_MXU"></itemGroup>
  </dataIslands>
  <items>
    <item id="D1_ACTIVITY_ID" label="D1_ACTIVITY_ID" resourceId="New_MXU.D1_ACTIVITY_ID"></item>
    <item id="D1_DEVICE_ID" label="D1_DEVICE_ID" resourceId="New_MXU.D1_DEVICE_ID"></item>
    <item id="DEVICE_LOCATION" label="DEVICE_LOCATION" resourceId="New_MXU.DEVICE_LOCATION"></item>
    <item id="DEVICE_LOCATION_DETAILS" label="DEVICE_LOCATION_DETAILS" resourceId="New_MXU.DEVICE_LOCATION_DETAILS"></item>
    <item id="GIS_LATITUDE" label="GIS_LATITUDE" resourceId="New_MXU.GIS_LATITUDE"></item>
    <item id="GIS_LONGITUDE" label="GIS_LONGITUDE" resourceId="New_MXU.GIS_LONGITUDE"></item>
    <item id="HIGH_LIMIT" label="HIGH_LIMIT" resourceId="New_MXU.HIGH_LIMIT"></item>
    <item id="LOW_LIMIT" label="LOW_LIMIT" resourceId="New_MXU.LOW_LIMIT"></item>
    <item id="METER_ID" label="METER_ID" resourceId="New_MXU.METER_ID"></item>
    <item id="METER_TYPE" label="METER_TYPE" resourceId="New_MXU.METER_TYPE"></item>
    <item id="MXU_ID" label="MXU_ID" resourceId="New_MXU.MXU_ID"></item>
    <item id="MXU_TYPE" label="MXU_TYPE" resourceId="New_MXU.MXU_TYPE"></item>
    <item id="SCHEDULED_DATE" label="SCHEDULED_DATE" resourceId="New_MXU.SCHEDULED_DATE"></item>
    <item id="SERVICE_ADDRESS" label="SERVICE_ADDRESS" resourceId="New_MXU.SERVICE_ADDRESS"></item>
    <item id="SP_ID" label="SP_ID" resourceId="New_MXU.SP_ID"></item>
    <item id="SP_INSTRUCTION" label="SP_INSTRUCTION" resourceId="New_MXU.SP_INSTRUCTION"></item>
    <item id="SP_WARNING" label="SP_WARNING" resourceId="New_MXU.SP_WARNING"></item>
  </items>
  <resources>
    <jdbcQuery id="New_MXU" datasourceId="Newark1_DS">
      <fieldList>
        <field id="D1_ACTIVITY_ID" type="java.lang.String"></field>
        <field id="D1_DEVICE_ID" type="java.lang.String"></field>
        <field id="SCHEDULED_DATE" type="java.sql.Timestamp"></field>
        <field id="SP_ID" type="java.lang.String"></field>
        <field id="SERVICE_ADDRESS" type="java.lang.String"></field>
        <field id="METER_ID" type="java.lang.String"></field>
        <field id="LOW_LIMIT" type="java.lang.String"></field>
        <field id="HIGH_LIMIT" type="java.lang.String"></field>
        <field id="DEVICE_LOCATION" type="java.lang.String"></field>
        <field id="DEVICE_LOCATION_DETAILS" type="java.lang.String"></field>
        <field id="SP_WARNING" type="java.lang.String"></field>
        <field id="SP_INSTRUCTION" type="java.lang.String"></field>
        <field id="METER_TYPE" type="java.lang.String"></field>
        <field id="MXU_ID" type="java.lang.String"></field>
        <field id="MXU_TYPE" type="java.lang.String"></field>
        <field id="GIS_LATITUDE" type="java.math.BigDecimal"></field>
        <field id="GIS_LONGITUDE" type="java.math.BigDecimal"></field>
      </fieldList>
      <query>SELECT ACT.D1_ACTIVITY_ID, 
       DV.D1_DEVICE_ID,
       TO_DATE(EXTRACTVALUE(XMLTYPE(CONCAT(CONCAT('&lt;root&gt;', ACT.BO_DATA_AREA), '&lt;/root&gt;')), 'root/scheduledSelectionDate'),'YYYY-MM-DD') "SCHEDULED_DATE", 
       OBSP.PK_VALUE1 "SP_ID", 
       SP.ADDRESS1 "SERVICE_ADDRESS", 
       DVID.ID_VALUE "METER_ID", 
       EXTRACTVALUE(XMLTYPE(CONCAT(CONCAT('&lt;root&gt;', ACT.BO_DATA_AREA), '&lt;/root&gt;')), 'root/mcs/mcList[1]/lowBoundaryReading') "LOW_LIMIT", 
       EXTRACTVALUE(XMLTYPE(CONCAT(CONCAT('&lt;root&gt;', ACT.BO_DATA_AREA), '&lt;/root&gt;')), 'root/mcs/mcList[1]/highBoundaryReading') "HIGH_LIMIT", 
       EXTRACTVALUE(XMLTYPE(CONCAT(CONCAT('&lt;root&gt;', SP.BO_DATA_AREA), '&lt;/root&gt;')), 'root/deviceLocation') "DEVICE_LOCATION", 
       EXTRACTVALUE(XMLTYPE(CONCAT(CONCAT('&lt;root&gt;', SP.BO_DATA_AREA), '&lt;/root&gt;')), 'root/deviceLocationDetails') "DEVICE_LOCATION_DETAILS", 
       (SELECT DESCR FROM CISADM.F1_EXT_LOOKUP_VAL_L 
       WHERE BUS_OBJ_CD = 'D1-SPWarningLookup' 
       AND F1_EXT_LOOKUP_VALUE = EXTRACTVALUE(XMLTYPE(CONCAT(CONCAT('&lt;root&gt;', SP.BO_DATA_AREA), '&lt;/root&gt;')), 'root/spWarning') 
       AND LANGUAGE_CD = 'ENG') "SP_WARNING", 
       (SELECT DESCR FROM CISADM.F1_EXT_LOOKUP_VAL_L 
       WHERE BUS_OBJ_CD = 'D1-SPInstructionLookup' 
       AND F1_EXT_LOOKUP_VALUE = EXTRACTVALUE(XMLTYPE(CONCAT(CONCAT('&lt;root&gt;', SP.BO_DATA_AREA), '&lt;/root&gt;')), 'root/spInstruction') 
       AND LANGUAGE_CD = 'ENG') "SP_INSTRUCTION", 
       (SELECT DESCR FROM CISADM.F1_EXT_LOOKUP_VAL_L 
       WHERE BUS_OBJ_CD = 'CMC-ManufacturerMeterTypLookup' 
       AND F1_EXT_LOOKUP_VALUE = DV.MANUFACTURER_CD 
       AND LANGUAGE_CD = 'ENG') "METER_TYPE", 
       MXUID.ID_VALUE "MXU_ID", 
       MXUCH.SRCH_CHAR_VAL "MXU_TYPE", 
       SP.D1_GEO_LAT "GIS_LATITUDE", 
       SP.D1_GEO_LONG "GIS_LONGITUDE"
FROM CISADM.F1_GEN_PROC GP
INNER JOIN CISADM.D1_ACTIVITY ACT ON ACT.D1_ACTIVITY_ID = GP.PK_VALUE1
INNER JOIN CISADM.D1_ACTIVITY_REL_OBJ OBSP ON OBSP.D1_ACTIVITY_ID = ACT.D1_ACTIVITY_ID
    AND OBSP.MAINT_OBJ_CD = 'D1-SP'
    AND OBSP.ACTIVITY_REL_OBJ_TYPE_FLG = 'D1RO'
INNER JOIN CISADM.D1_ACTIVITY_REL_OBJ OBDV ON OBDV.D1_ACTIVITY_ID = ACT.D1_ACTIVITY_ID
    AND OBDV.MAINT_OBJ_CD = 'D1-DEVICE'
    AND OBDV.ACTIVITY_REL_OBJ_TYPE_FLG = 'D1RO'
INNER JOIN CISADM.D1_DVC_IDENTIFIER DVID ON DVID.D1_DEVICE_ID = OBDV.PK_VALUE1
    AND DVID.DVC_ID_TYPE_FLG = 'D1SN'
INNER JOIN CISADM.D1_DVC DV ON DV.D1_DEVICE_ID = DVID.D1_DEVICE_ID
INNER JOIN CISADM.D1_SP SP ON SP.D1_SP_ID = OBSP.PK_VALUE1
INNER JOIN CISADM.D1_SP_EQPMNT SPEQ ON SPEQ.D1_SP_ID = SP.D1_SP_ID
    AND SPEQ.D1_INSTALL_DTTM = (SELECT MAX(SPEQ1.D1_INSTALL_DTTM) FROM CISADM.D1_SP_EQPMNT SPEQ1 
                                WHERE SPEQ1.D1_SP_ID = SP.D1_SP_ID
                                AND TRUNC(SPEQ1.D1_INSTALL_DTTM) &lt;= TO_DATE(EXTRACTVALUE(XMLTYPE(CONCAT(CONCAT('&lt;root&gt;', ACT.BO_DATA_AREA), '&lt;/root&gt;')), 'root/scheduledSelectionDate'), 'YYYY-MM-DD')
                                )
INNER JOIN CISADM.D1_DVC_IDENTIFIER MXUID ON MXUID.D1_DEVICE_ID = SPEQ.D1_DEVICE_ID
    AND MXUID.DVC_ID_TYPE_FLG = 'D1BN'
LEFT JOIN CISADM.D1_DVC_CHAR MXUCH ON MXUCH.D1_DEVICE_ID = MXUID.D1_DEVICE_ID
    AND MXUCH.CHAR_TYPE_CD = 'CMCMXUTY'
WHERE GP.BATCH_CD = 'CMS-MRDL'
AND GP.MAINT_OBJ_CD = 'D1-ACTIVITY'</query>
    </jdbcQuery>
  </resources>
</schema>
