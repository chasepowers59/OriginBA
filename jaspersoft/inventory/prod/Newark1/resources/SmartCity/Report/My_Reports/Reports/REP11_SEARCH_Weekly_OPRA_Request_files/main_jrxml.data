	<subDataset name="OpraRequest" uuid="b4458104-8916-42f7-9fbc-46714fdfd099">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="Newark - JRS TST DB"/>
		<parameter name="Report_Date" class="java.sql.Date"/>
		<queryString language="SQL">
			<![CDATA[SELECT
    SA.OLD_ACCT_ID          AS400_ACCT_ID,
    SA.ACCT_ID              C2M_ACCT_ID,
    PCH1.SRCH_CHAR_VAL      BLOCK_LOT,
    PCH2.SRCH_CHAR_VAL      QUALIFIER,
    PREM.ADDRESS1           SERVICE_ADDRESS,
    PNAME.ENTITY_NAME_UPR   BILL_NAME,
    NVL(CB.BALANCE, 0)      CURRENT_ENDING_BALANCE,
    UPPER(PCH3L.DESCR)      CUSTOMER_STATUS,
    NVL(LAST_BILL.LAST_BILLED_AMT, 0) LAST_BILLED_AMT,
    TO_CHAR(LAST_BILL.LAST_BILLED_DATE,'YYYYMMDD') AS BILL_DATE
FROM 
    CISADM.CI_PREM PREM
INNER JOIN (
        SELECT * FROM (
                SELECT TSA.ACCT_ID, 
                   TSA.OLD_ACCT_ID,
                   TSA.CHAR_PREM_ID,
                   ROW_NUMBER() OVER (PARTITION BY TSA.CHAR_PREM_ID ORDER BY TSA.START_DT DESC) RANK
            FROM CISADM.CI_SA TSA
            WHERE TSA.CHAR_PREM_ID != ' '
            AND TSA.SA_STATUS_FLG NOT IN ('70')
            ORDER BY TSA.START_DT DESC)
        WHERE RANK = 1) 
SA ON SA.CHAR_PREM_ID = PREM.PREM_ID
INNER JOIN CISADM.CI_ACCT_PER AP
ON         AP.ACCT_ID = SA.ACCT_ID
AND        AP.MAIN_CUST_SW = 'Y'
INNER JOIN CISADM.CI_PER_NAME PNAME
ON         PNAME.PER_ID = AP.PER_ID
AND        PNAME.PRIM_NAME_SW = 'Y'
LEFT JOIN  CISADM.CI_PREM_CHAR PCH1
ON         PCH1.PREM_ID = PREM.PREM_ID
AND        PCH1.CHAR_TYPE_CD = 'BLCK/LOT'
LEFT JOIN  CISADM.CI_PREM_CHAR PCH2
ON         PCH2.PREM_ID = PREM.PREM_ID
AND        PCH2.CHAR_TYPE_CD = 'CMC-QLFR'
LEFT JOIN  CISADM.CI_PREM_CHAR PCH3
ON         PCH3.PREM_ID = PREM.PREM_ID
AND        PCH3.CHAR_TYPE_CD = 'CUST STA'
LEFT JOIN  CISADM.CI_CHAR_VAL_L PCH3L
ON         PCH3L.CHAR_TYPE_CD = PCH3.CHAR_TYPE_CD
AND        PCH3L.CHAR_VAL = PCH3.CHAR_VAL
AND        PCH3L.LANGUAGE_CD = 'ENG'
LEFT JOIN
           (
                    SELECT   /*+ FULL(FT) */ 
                             SUM(FT.CUR_AMT) BALANCE,
                             ACT.ACCT_ID
                    FROM     CISADM.CI_SA SA,
                             CISADM.CI_ACCT ACT,
                             CISADM.CI_FT FT
                    WHERE    FT.SA_ID = SA.SA_ID
                    AND $X{LESS], FT.FREEZE_DTTM, Report_Date}
                    AND      FT.FREEZE_SW = 'Y'
                    AND      SA.ACCT_ID = ACT.ACCT_ID
                    GROUP BY ACT.ACCT_ID) CB
ON         CB.ACCT_ID = SA.ACCT_ID
LEFT JOIN
           (
                      SELECT     SUM(BSA.CUR_AMT) AS LAST_BILLED_AMT,
                                 BILL.BILL_DT     AS LAST_BILLED_DATE,
                                 BILL.ACCT_ID
                      FROM       CISADM.CI_BILL_SA BSA
                      INNER JOIN CISADM.CI_BILL BILL
                      ON         BILL.BILL_ID = BSA.BILL_ID
                      WHERE      1=1
                      AND        BILL.BILL_DT =
                                 (
                                        SELECT MAX(B.BILL_DT)
                                        FROM   CISADM.CI_BILL B
                                        WHERE  B.ACCT_ID = BILL.ACCT_ID
                                        AND    B.BILL_STAT_FLG = 'C'
                                        AND $X{LESS], B.BILL_DT, Report_Date})
                      GROUP BY   BILL.BILL_DT,
                                 BILL.ACCT_ID) LAST_BILL
ON         LAST_BILL.ACCT_ID = SA.ACCT_ID]]>
		</queryString>
