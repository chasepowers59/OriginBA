      </fieldList>
      <filterString>CI_FT.NOT_IN_ARS_SW == 'N' and CI_FT.FT_TYPE_FLG in ('PS') and CI_FT.FREEZE_SW == 'Y'</filterString>
      <joinInfo alias="CI_SA" referenceId="CI_SA"></joinInfo>
      <joinList>
        <join expr="CI_SA.SA_ID == CI_FT.SA_ID" left="CI_SA" right="CI_FT" type="inner" weight="1"></join>
        <join expr="SC_CUS_DET.ACCT_ID == CI_SA.ACCT_ID" left="SC_CUS_DET" right="CI_SA" type="leftOuter" weight="1"></join>
      </joinList>
      <joinOptions></joinOptions>
      <tableRefList>
        <tableRef alwaysIncludeTable="false" tableAlias="CI_SA" tableId="CI_SA"></tableRef>
        <tableRef alwaysIncludeTable="false" tableAlias="CI_FT" tableId="CI_FT"></tableRef>
        <tableRef alwaysIncludeTable="false" tableAlias="SC_CUS_DET" tableId="SC_CUS_DET"></tableRef>
      </tableRefList>
    </jdbcTable>
