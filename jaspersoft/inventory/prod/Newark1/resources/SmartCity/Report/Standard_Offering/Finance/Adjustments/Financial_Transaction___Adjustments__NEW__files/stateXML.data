  <subFilterList>
    <subFilter id="filter_1" letter="A" sourceString="DYNAMIC">
      <expressionString>betweenDates(FT_CORE.ACCOUNTING_DT, ts'2026-08-01', ts'2026-08-31')</expressionString>
      <parameterizedExpressionString>betweenDates(FT_CORE.ACCOUNTING_DT, ACCOUNTING_DT_1, ACCOUNTING_DT_2)</parameterizedExpressionString>
    </subFilter>
    <subFilter id="filter_2" letter="B" sourceString="DYNAMIC">
      <expressionString>FT_ADJ.ADJ_TYPE_DESC in ('Additional charge', 'Adjust general ledger accounts', 'Adjustment Credit', 'Amnesty Credit', 'Application Fee', 'Bid Fee Deposits', 'Change payment arrangement current balance', 'City Owned Property Sale Adjustment', 'Connection Fee', 'Contract Bidding', 'Converted Adjustments', 'Customer relationship expense', 'DO NOT USE - Overpayment (remove credit)', 'Demolished Property Adjustment', 'Deposit interest', 'Final Fee', 'Flow Test', 'Hydrant Meter Rental - Deposit, daily rate, key', 'Inspection Fee', 'Installation charge', 'Late Fee Adjustment', 'Late payment charge', 'Map Copy', 'New Meter', 'Non-sufficient funds', 'Pay arrangement broken / canceled', 'Reconnect Fee', 'Refund credit balance via A/P', 'Refund credit balance via A/P (1099)', 'Sanitary Connection Fee', 'Service Kill/Cap', 'Synch cur bal w/ payoff bal', 'Tap Inspection', 'Tap Installation', 'Transfer to Tax', 'Water Main Extension Permit', 'Write down/up small debit/cred', 'Xfer balance - printed', 'Xfer balance -to Taxes as Water Lien')</expressionString>
      <parameterizedExpressionString>FT_ADJ.ADJ_TYPE_DESC in ADJ_TYPE_DESC_1</parameterizedExpressionString>
    </subFilter>
    <subFilter id="filter_3" letter="C" sourceString="DYNAMIC">
      <expressionString>FT_ADJ.ADJ_AMT &gt; 0</expressionString>
      <parameterizedExpressionString>FT_ADJ.ADJ_AMT &gt; ADJ_AMT_1</parameterizedExpressionString>
    </subFilter>
    <subFilter id="filter_4" letter="D" sourceString="DYNAMIC">
      <expressionString>isAnyValue(FT_SA_ACCT.SA_TYPE_DESC)</expressionString>
      <parameterizedExpressionString>FT_SA_ACCT.SA_TYPE_DESC in SA_TYPE_DESC_1</parameterizedExpressionString>
    </subFilter>
    <subFilter id="filter_5" letter="E" sourceString="DYNAMIC">
      <expressionString>isAnyValue(FT_CORE.FREEZE_USER_NAME)</expressionString>
      <parameterizedExpressionString>FT_CORE.FREEZE_USER_NAME in FREEZE_USER_NAME_1</parameterizedExpressionString>
    </subFilter>
  </subFilterList>
