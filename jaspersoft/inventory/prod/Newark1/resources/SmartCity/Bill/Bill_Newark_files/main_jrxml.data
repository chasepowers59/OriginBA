						</textElement>
						<text><![CDATA[e-billing]]></text>
					</staticText>
					<staticText>
						<reportElement x="148" y="61" width="120" height="19" forecolor="#1E51A4" uuid="10246676-e76f-46ec-bd3a-ddaa074ae3f0"/>
						<box>
							<rightPen lineWidth="0.0" lineColor="#C6C6C6"/>
						</box>
						<textElement textAlignment="Center" verticalAlignment="Middle">
							<font fontName="Arial Black" size="8" isBold="true"/>
						</textElement>
						<text><![CDATA[Pay by Phone]]></text>
					</staticText>
					<staticText>
						<reportElement x="268" y="61" width="121" height="19" forecolor="#1E51A4" uuid="666072a5-09bb-4b54-a006-249d6da47812"/>
						<box>
							<rightPen lineWidth="0.0" lineColor="#C6C6C6"/>
						</box>
						<textElement textAlignment="Center" verticalAlignment="Middle">
							<font fontName="Arial Black" size="8" isBold="true"/>
						</textElement>
						<text><![CDATA[In Person]]></text>
					</staticText>
					<staticText>
						<reportElement x="389" y="61" width="120" height="19" forecolor="#1E51A4" uuid="9a8949ab-cf0c-44e0-b605-9918540d84f0"/>
						<box>
							<rightPen lineWidth="0.0"/>
						</box>
						<textElement textAlignment="Center" verticalAlignment="Middle">
							<font fontName="Arial Black" size="8" isBold="true"/>
						</textElement>
						<text><![CDATA[By Mail]]></text>
					</staticText>
					<staticText>
						<reportElement x="17" y="76" width="121" height="94" uuid="1ca65030-06bf-453a-8f25-61fbbba86e66">
							<property name="com.jaspersoft.studio.unit.width" value="px"/>
							<property name="com.jaspersoft.studio.unit.height" value="px"/>
						</reportElement>
						<box topPadding="0" leftPadding="2" bottomPadding="0" rightPadding="2">
							<rightPen lineWidth="0.25" lineStyle="Solid" lineColor="#C6C6C6"/>
						</box>
						<textElement textAlignment="Center">
							<font fontName="Arial" size="6.5"/>
						</textElement>
						<text><![CDATA[Try our new online Water and Sewer Utility Payment System. Through our secure site, you can pay all or part of your bill with an e-check, credit or debit card for a small convenience fee. Simply click on the link below and follow the instructions.

https://mywateraccount.newarknj.gov/]]></text>
					</staticText>
					<staticText>
						<reportElement x="148" y="76" width="120" height="82" uuid="f672cefb-b7d5-481b-a7c9-31a46407ca6c">
							<property name="com.jaspersoft.studio.unit.width" value="px"/>
							<property name="com.jaspersoft.studio.unit.height" value="px"/>
						</reportElement>
						<box padding="3">
							<rightPen lineWidth="0.25" lineStyle="Solid" lineColor="#C6C6C6"/>
						</box>
						<textElement textAlignment="Center" verticalAlignment="Top">
							<font fontName="Arial" size="6.5"/>
						</textElement>
						<text><![CDATA[Call 1(888)-877-0450 to pay by phone with credit card. You can pay 24 hours a day. Your payment will post immediately.]]></text>
					</staticText>
					<staticText>
						<reportElement x="268" y="76" width="121" height="82" uuid="6cd9464f-ae5e-41d5-886a-4f1fb61f8a33">
							<property name="com.jaspersoft.studio.unit.width" value="px"/>
							<property name="com.jaspersoft.studio.unit.height" value="px"/>
						</reportElement>
						<box padding="3">
							<rightPen lineWidth="0.25" lineStyle="Solid" lineColor="#C6C6C6"/>
						</box>
						<textElement textAlignment="Center">
							<font fontName="Arial" size="6.5"/>
						</textElement>
						<text><![CDATA[Residents can pay in person by cash, check, money order or credit card at the Water Department office in City Hall:

920 Mayor Kenneth A Gibson Blvd
Room 117
Newark, New Jersey 07102
Checks and money orders are payable to: City of Newark Water Department]]></text>
					</staticText>
					<staticText>
						<reportElement x="389" y="76" width="120" height="82" uuid="e5de1f13-bfd2-47a0-8904-272da831aa5c">
							<property name="com.jaspersoft.studio.unit.width" value="px"/>
							<property name="com.jaspersoft.studio.unit.height" value="px"/>
						</reportElement>
						<box padding="3">
							<rightPen lineWidth="0.0"/>
						</box>
						<textElement textAlignment="Center">
							<font fontName="Arial" size="6.5"/>
						</textElement>
						<text><![CDATA[Customers can mail their payments to the Department. Make checks payable to City of Newark Water Department and Send to:

City of Newark Water Department
920 Mayor Kenneth A Gibson Blvd
Room 117
Newark, New Jersey 07102]]></text>
					</staticText>
					<image>
						<reportElement x="60" y="27" width="54" height="37" printWhenGroupChanges="BillAccountIDSubGroup" uuid="098d1115-e092-42d5-96e2-327fc90894d3"/>
						<imageExpression><![CDATA["repo:e_billing.png"]]></imageExpression>
					</image>
					<image>
						<reportElement x="184" y="27" width="45" height="37" printWhenGroupChanges="BillAccountIDSubGroup" uuid="279c3efb-2d08-44bd-bf6d-7c18a192463f"/>
						<imageExpression><![CDATA["repo:PaybyPhone.png"]]></imageExpression>
					</image>
					<image>
						<reportElement x="302" y="27" width="49" height="37" printWhenGroupChanges="BillAccountIDSubGroup" uuid="c4889a23-f99f-4dbd-9090-d3f891d2dd7f"/>
						<imageExpression><![CDATA["repo:InPerson.png"]]></imageExpression>
					</image>
