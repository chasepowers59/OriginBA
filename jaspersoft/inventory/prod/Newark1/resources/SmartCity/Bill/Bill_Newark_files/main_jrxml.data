						<font fontName="Arial" size="6"/>
					</textElement>
					<textFieldExpression><![CDATA["Due by " + DATEFORMAT(DATE(Integer.valueOf($F{dueDate}.substring(0,4)),Integer.valueOf($F{dueDate}.substring(5,7)),Integer.valueOf($F{dueDate}.substring(8,10))), "MM/dd/yy")]]></textFieldExpression>
