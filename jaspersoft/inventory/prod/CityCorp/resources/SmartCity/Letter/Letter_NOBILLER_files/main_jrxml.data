						<paragraph lineSpacing="1_1_2"/>
					</textElement>
					<textFieldExpression><![CDATA["CURRENT RESIDENT"+"<br />"+
($F{address1}==null?"":$F{address1})+
($F{address2}==null?"":", "+$F{address2})+
($F{address3}==null?"":", "+$F{address3})+
($F{address4}==null?"":", "+$F{address4})+"<br />"+
($F{city}==null?"":$F{city})+
($F{state}==null?"":", "+$F{state})+ 
