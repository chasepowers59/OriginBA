						<paragraph lineSpacing="1_1_2"/>
					</textElement>
					<textFieldExpression><![CDATA["RE: ACCOUNT: "+($F{accountId}==null?"":$F{accountId})+"<br />"+
"LOCATION: "+($F{address1}==null?"":$F{address1})+"<br /><br />"+

"Dear Customer:<br /><br />"+

"It has come to our attention that you are currently connected to a temporary service location.<br /><br />"+

"If you have completed construction or are currently residing at this location, please contact our office as soon as possible. If you are still under construction you also need to contact our office and apply for an extension.<br /><br />"+

"You must contact us by "+new SimpleDateFormat("MM/dd/yyyy").format($F{DEADLINE})+". If you fail to do so your permit authorization may be revoked. This will in turn bill you for a deposit and sewer fees if appropriate.<br/><br />"+

"If you have any questions, please contact customer service at 479/968-2105.<br/><br/><br/>"+

"Sincerely,"]]></textFieldExpression>
				</textField>
			</frame>
