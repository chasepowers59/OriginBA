      </fieldList>
      <query>SELECT
            ft1.sa_id, sum(ft1.cur_amt),sum(ft1.tot_amt)
        FROM
            cisadm.ci_ft ft1
        WHERE
                ft1.freeze_sw = 'Y'
            AND ( ft1.ars_dt BETWEEN ( TO_DATE('2025-05-31','RRRR-MM-DD') - 60 ) AND TO_DATE('2025-05-31','RRRR-MM-DD') - 31 )
group by ft1.sa_id</query>
    </jdbcQuery>
    <jdbcQuery id="AGED_6190" datasourceId="CityCorp_DS">
