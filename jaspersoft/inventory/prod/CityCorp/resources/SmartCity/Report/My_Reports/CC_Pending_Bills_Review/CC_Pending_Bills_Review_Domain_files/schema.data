<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.jaspersoft.com/2007/SL/XMLSchema" version="1.3">
  <dataIslands>
    <itemGroup id="SC_PENDING_BILL_RVW" label="SC_PENDING_BILL_RVW" resourceId="SC_PENDING_BILL_RVW"></itemGroup>
  </dataIslands>
  <items>
    <item id="ACCT_ID" label="Account ID" resourceId="SC_PENDING_BILL_RVW.ACCT_ID"></item>
    <item id="BILL_CYC_CD" label="Bill Cycle" resourceId="SC_PENDING_BILL_RVW.BILL_CYC_CD"></item>
    <item id="BILL_DT" label="Bill Date" resourceId="SC_PENDING_BILL_RVW.BILL_DT"></item>
    <item id="BILL_ID" label="Bill ID" resourceId="SC_PENDING_BILL_RVW.BILL_ID"></item>
    <item id="BILL_STAT_FLG" label="Bill Status" resourceId="SC_PENDING_BILL_RVW.BILL_STAT_FLG"></item>
    <item id="CUST_CL_CD" label="Customer Class" resourceId="SC_PENDING_BILL_RVW.CUST_CL_CD"></item>
    <item id="SUM_FT_CUR_AMT_" label="Current Amount" resourceId="SC_PENDING_BILL_RVW.SUM_FT_CUR_AMT_"></item>
    <item id="SUM_FT_TOT_AMT_" label="Payoff Amount" resourceId="SC_PENDING_BILL_RVW.SUM_FT_TOT_AMT_"></item>
    <item id="TRUNC_BILL_COMPLETE_DTTM_" label="Complete Date/Time" resourceId="SC_PENDING_BILL_RVW.TRUNC_BILL_COMPLETE_DTTM_"></item>
    <item id="TRUNC_BILL_CRE_DTTM_" label="Create Date/Time" resourceId="SC_PENDING_BILL_RVW.TRUNC_BILL_CRE_DTTM_"></item>
    <item id="WIN_START_DT" label="Window Start Date" resourceId="SC_PENDING_BILL_RVW.WIN_START_DT"></item>
  </items>
  <resources>
    <jdbcQuery id="SC_PENDING_BILL_RVW" datasourceId="CollegeStation_DS">
      <fieldList>
        <field id="ACCT_ID" type="java.lang.String"></field>
        <field id="BILL_ID" type="java.lang.String"></field>
        <field id="TRUNC_BILL_CRE_DTTM_" fieldDBName="TRUNC(BILL.CRE_DTTM)" type="java.sql.Timestamp"></field>
        <field id="WIN_START_DT" type="java.sql.Timestamp"></field>
        <field id="BILL_STAT_FLG" type="java.lang.String"></field>
        <field id="CUST_CL_CD" type="java.lang.String"></field>
        <field id="BILL_CYC_CD" type="java.lang.String"></field>
        <field id="TRUNC_BILL_COMPLETE_DTTM_" fieldDBName="TRUNC(BILL.COMPLETE_DTTM)" type="java.sql.Timestamp"></field>
        <field id="BILL_DT" type="java.sql.Timestamp"></field>
        <field id="SUM_FT_CUR_AMT_" fieldDBName="SUM(FT.CUR_AMT)" type="java.math.BigDecimal"></field>
        <field id="SUM_FT_TOT_AMT_" fieldDBName="SUM(FT.TOT_AMT)" type="java.math.BigDecimal"></field>
      </fieldList>
      <query>select bill.acct_id, bill.bill_id, trunc(bill.cre_dttm), bill.win_start_dt, bill.bill_stat_flg, acct.cust_cl_cd, bill.bill_cyc_cd, trunc(bill.complete_dttm), bill.bill_dt, sum(ft.cur_amt), sum(ft.tot_amt)
from CISADM.ci_bill bill
inner join CISADM.ci_bseg bseg on bseg.bill_id = bill.bill_id
--inner join ci_bill_routing br on br.bill_id = bill.bill_id
inner join CISADM.ci_acct acct on acct.acct_id = bill.acct_id
inner join CISADM.ci_ft ft on ft.sa_id = bseg.sa_id and ft.sibling_id = bseg.bseg_id and ft.parent_id = bill.bill_id
where 1=1

and bill.bill_stat_flg = 'P'
group by bill.acct_id, bill.bill_id, trunc(bill.cre_dttm), bill.win_start_dt, bill.bill_stat_flg, acct.cust_cl_cd, bill.bill_cyc_cd, trunc(bill.complete_dttm), bill.bill_dt</query>
    </jdbcQuery>
  </resources>
</schema>
