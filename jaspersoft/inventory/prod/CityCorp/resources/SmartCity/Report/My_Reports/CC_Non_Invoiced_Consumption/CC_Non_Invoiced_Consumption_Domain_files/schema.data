  <resources>
    <jdbcQuery id="BILL_DATA" datasourceId="CityCorp_DS">
      <fieldList>
        <field id="ACCT_ID" type="java.lang.String"></field>
        <field id="PER_ID" type="java.lang.String"></field>
        <field id="OLD_ACCT_ID" type="java.lang.String"></field>
        <field id="ADDRESS1" type="java.lang.String"></field>
        <field id="ENTITY_NAME" type="java.lang.String"></field>
        <field id="SA_TYPE_CD" type="java.lang.String"></field>
        <field id="PREM_ID" type="java.lang.String"></field>
        <field id="SA_STATUS_FLG" type="java.lang.String"></field>
      </fieldList>
      <query>SELECT DISTINCT AP.ACCT_ID, AP.PER_ID, SA.OLD_ACCT_ID, PREM.PREM_ID, PREM.ADDRESS1, PN.ENTITY_NAME, SA.SA_TYPE_CD, SA.SA_STATUS_FLG
FROM 
CISADM.CI_ACCT ACCT
INNER JOIN CISADM.CI_SA SA ON SA.ACCT_ID = ACCT.ACCT_ID 
INNER JOIN CISADM.CI_ACCT_PER AP ON AP.ACCT_ID = SA.ACCT_ID AND AP.MAIN_CUST_SW = 'Y'
INNER JOIN CISADM.CI_PER_NAME PN ON PN.PER_ID = AP.PER_ID AND PN.PRIM_NAME_SW = 'Y'
INNER JOIN CISADM.CI_PREM PREM ON PREM.PREM_ID = SA.CHAR_PREM_ID
AND NOT EXISTS (SELECT 1 FROM CISADM.CI_BILL B WHERE B.ACCT_ID = ACCT.ACCT_ID AND B.BILL_STAT_FLG = 'C' AND B.BILL_DT BETWEEN SYSDATE-30 AND SYSDATE)</query>
    </jdbcQuery>
    <jdbcQuery id="MSRMT_DATA" datasourceId="CityCorp_DS">
      <fieldList>
        <field id="D1_SP_ID" type="java.lang.String"></field>
        <field id="SP_ID_TYPE_FLG" type="java.lang.String"></field>
        <field id="ID_VALUE" type="java.lang.String"></field>
        <field id="INSTALL_EVT_ID" type="java.lang.String"></field>
        <field id="D1_INSTALL_DTTM" type="java.sql.Timestamp"></field>
        <field id="D1_REMOVAL_DTTM" type="java.sql.Timestamp"></field>
        <field id="INSTALLATION_CONST" type="java.math.BigDecimal"></field>
        <field id="IE_BUS_OBJ_CD" type="java.lang.String"></field>
        <field id="IE_BO_STATUS_CD" type="java.lang.String"></field>
        <field id="IE_BO_STATUS_REASON_CD" type="java.lang.String"></field>
        <field id="IE_STATUS_UPD_DTTM" type="java.sql.Timestamp"></field>
        <field id="IE_CRE_DTTM" type="java.sql.Timestamp"></field>
        <field id="ARM_STAT_FLG" type="java.lang.String"></field>
        <field id="IE_BO_DATA_AREA" type="java.lang.String"></field>
        <field id="DEVICE_CONFIG_ID" type="java.lang.String"></field>
        <field id="DEVICE_CONFIG_TYPE_CD" type="java.lang.String"></field>
        <field id="DC_BUS_OBJ_CD" type="java.lang.String"></field>
        <field id="D1_DEVICE_ID" type="java.lang.String"></field>
        <field id="EFF_DTTM" type="java.sql.Timestamp"></field>
        <field id="TIME_ZONE_CD" type="java.lang.String"></field>
        <field id="DC_BO_STATUS_CD" type="java.lang.String"></field>
        <field id="DC_STATUS_UPD_DTTM" type="java.sql.Timestamp"></field>
        <field id="DC_BO_STATUS_REASON_CD" type="java.lang.String"></field>
        <field id="DC_CRE_DTTM" type="java.sql.Timestamp"></field>
        <field id="DC_BO_DATA_AREA" type="java.lang.String"></field>
        <field id="MEASR_COMP_ID" type="java.lang.String"></field>
        <field id="MSRMT_DTTM" type="java.sql.Timestamp"></field>
        <field id="M_BO_STATUS_CD" type="java.lang.String"></field>
        <field id="MSRMT_COND_FLG" type="java.lang.String"></field>
        <field id="MSRMT_USE_FLG" type="java.lang.String"></field>
        <field id="MSRMT_LOCAL_DTTM" type="java.sql.Timestamp"></field>
        <field id="MSRMT_VAL" type="java.math.BigDecimal"></field>
        <field id="ORIG_INIT_MSRMT_ID" type="java.lang.String"></field>
        <field id="PREV_MSRMT_DTTM" type="java.sql.Timestamp"></field>
        <field id="MSRMT_VAL1" type="java.math.BigDecimal"></field>
        <field id="MSRMT_VAL2" type="java.math.BigDecimal"></field>
        <field id="MSRMT_VAL3" type="java.math.BigDecimal"></field>
        <field id="MSRMT_VAL4" type="java.math.BigDecimal"></field>
        <field id="MSRMT_VAL5" type="java.math.BigDecimal"></field>
        <field id="M_BUS_OBJ_CD" type="java.lang.String"></field>
        <field id="M_CRE_DTTM" type="java.sql.Timestamp"></field>
        <field id="READING_VAL" type="java.math.BigDecimal"></field>
        <field id="COMBINED_MULTIPLIER" type="java.math.BigDecimal"></field>
        <field id="READING_COND_FLG" type="java.lang.String"></field>
        <field id="RANK" type="java.math.BigDecimal"></field>
        <field id="PREM_ID" type="java.lang.String"></field>
      </fieldList>
      <query>SELECT * FROM (
SELECT
PREM.PREM_ID,
SPID.D1_SP_ID, 
SPID.SP_ID_TYPE_FLG, 
SPID.ID_VALUE, 
IE.INSTALL_EVT_ID, 
IE.D1_INSTALL_DTTM, 
IE.D1_REMOVAL_DTTM, 
IE.INSTALLATION_CONST, 
IE.BUS_OBJ_CD IE_BUS_OBJ_CD, 
IE.BO_STATUS_CD IE_BO_STATUS_CD, 
IE.BO_STATUS_REASON_CD IE_BO_STATUS_REASON_CD, 
IE.STATUS_UPD_DTTM IE_STATUS_UPD_DTTM, 
IE.CRE_DTTM IE_CRE_DTTM, 
IE.ARM_STAT_FLG, 
IE.BO_DATA_AREA IE_BO_DATA_AREA, 
DC.DEVICE_CONFIG_ID,
DC.DEVICE_CONFIG_TYPE_CD,
DC.BUS_OBJ_CD DC_BUS_OBJ_CD,
DC.D1_DEVICE_ID,
DC.EFF_DTTM,
DC.TIME_ZONE_CD,
DC.BO_STATUS_CD DC_BO_STATUS_CD,
DC.STATUS_UPD_DTTM DC_STATUS_UPD_DTTM,
DC.BO_STATUS_REASON_CD DC_BO_STATUS_REASON_CD,
DC.CRE_DTTM DC_CRE_DTTM,
DC.BO_DATA_AREA DC_BO_DATA_AREA,
M.MEASR_COMP_ID,
M.MSRMT_DTTM,
M.BO_STATUS_CD M_BO_STATUS_CD,
M.MSRMT_COND_FLG,
M.MSRMT_USE_FLG,
M.MSRMT_LOCAL_DTTM,
M.MSRMT_VAL,
M.ORIG_INIT_MSRMT_ID,
M.PREV_MSRMT_DTTM,
M.MSRMT_VAL1,
M.MSRMT_VAL2,
M.MSRMT_VAL3,
M.MSRMT_VAL4,
M.MSRMT_VAL5,
M.BUS_OBJ_CD M_BUS_OBJ_CD,
M.CRE_DTTM M_CRE_DTTM,
M.READING_VAL, 
M.COMBINED_MULTIPLIER,
M.READING_COND_FLG,
ROW_NUMBER() OVER (PARTITION BY SPID.D1_SP_ID ORDER BY PREM.PREM_ID, M.MSRMT_LOCAL_DTTM DESC) RANK
FROM CISADM.CI_PREM PREM 
INNER JOIN CISADM.D1_SP_IDENTIFIER SPID ON SPID.SP_ID_TYPE_FLG = 'D1EP' AND SPID.ID_VALUE = PREM.PREM_ID
INNER JOIN CISADM.D1_INSTALL_EVT IE ON IE.D1_SP_ID = SPID.D1_SP_ID AND (IE.D1_REMOVAL_DTTM IS NULL OR IE.D1_REMOVAL_DTTM &gt; SYSDATE - 30)
INNER JOIN CISADM.D1_DVC_CFG DC ON DC.DEVICE_CONFIG_ID = IE.DEVICE_CONFIG_ID
INNER JOIN CISADM.D1_MEASR_COMP MC ON MC.DEVICE_CONFIG_ID = DC.DEVICE_CONFIG_ID
INNER JOIN CISADM.D1_MSRMT M ON M.MEASR_COMP_ID = MC.MEASR_COMP_ID AND M.MSRMT_USE_FLG != 'D101' AND M.MSRMT_LOCAL_DTTM BETWEEN SYSDATE-30 AND SYSDATE
) WHERE RANK = 1</query>
    </jdbcQuery>
    <jdbcQuery id="JoinTree_3" datasourceId="CityCorp_DS">
      <fieldList>
