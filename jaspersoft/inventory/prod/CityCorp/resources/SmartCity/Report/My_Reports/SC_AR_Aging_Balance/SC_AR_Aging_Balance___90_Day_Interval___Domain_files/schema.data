    <itemGroup id="FDL_AGED_CURRENT" label="All Days" resourceId="JoinTree_1">
      <items>
        <item id="SUM_FT1_TOT_AMT_" label="Payoff" resourceId="JoinTree_1.AGED_CURRENT.SUM_FT1_TOT_AMT_"></item>
        <item id="SUM_FT1_CUR_AMT_" label="Current" resourceId="JoinTree_1.AGED_CURRENT.SUM_FT1_CUR_AMT_"></item>
