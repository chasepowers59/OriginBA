<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.jaspersoft.com/2007/SL/XMLSchema" version="1.3">
  <dataIslands>
    <itemGroup id="JoinTree_1" label="JoinTree_1" resourceId="JoinTree_1"></itemGroup>
  </dataIslands>
  <itemGroups>
    <itemGroup id="FDL_AGED_OLD" label="271 Days and Older" resourceId="JoinTree_1">
      <items>
        <item id="SUM_FT1_TOT_AMT__4" label="271 Days and Older (Payoff)" resourceId="JoinTree_1.AGED_OLD.SUM_FT1_TOT_AMT__4"></item>
        <item id="SUM_FT1_CUR_AMT__4" label="271 Days and Older (Current)" resourceId="JoinTree_1.AGED_OLD.SUM_FT1_CUR_AMT__4"></item>
      </items>
    </itemGroup>
    <itemGroup id="FDL_AGED_270" label="181 to 270 Days" resourceId="JoinTree_1">
      <items>
        <item id="SUM_FT1_CUR_AMT__2" label="181 to 270 Days (Current)" resourceId="JoinTree_1.AGED_270.SUM_FT1_CUR_AMT__2"></item>
        <item id="SUM_FT1_TOT_AMT__2" label="181 to 270 Days (Payoff)" resourceId="JoinTree_1.AGED_270.SUM_FT1_TOT_AMT__2"></item>
      </items>
    </itemGroup>
    <itemGroup id="FDL_AGED_180" label="91 to 180 Days" resourceId="JoinTree_1">
      <items>
        <item id="SUM_FT1_TOT_AMT__3" label="91 to 180 Days (Payoff)" resourceId="JoinTree_1.AGED_180.SUM_FT1_TOT_AMT__3"></item>
        <item id="SUM_FT1_CUR_AMT__3" label="91 to 180 Days (Current)" resourceId="JoinTree_1.AGED_180.SUM_FT1_CUR_AMT__3"></item>
      </items>
    </itemGroup>
    <itemGroup id="FDL_AGED_90" label="0 to 90 Days" resourceId="JoinTree_1">
      <items>
        <item id="SUM_FT1_TOT_AMT__1" label="0 to 90 Days (Payoff)" resourceId="JoinTree_1.AGED_90.SUM_FT1_TOT_AMT__1"></item>
        <item id="SUM_FT1_CUR_AMT__1" label="0 to 90 Days (Current)" resourceId="JoinTree_1.AGED_90.SUM_FT1_CUR_AMT__1"></item>
