    <itemGroup id="FDL_AGED_DETAILS_1" label="Account Details" resourceId="JoinTree_1">
      <items>
        <item id="ACCT_ID_1" label="Account ID" resourceId="JoinTree_1.AGED_DETAILS.ACCT_ID"></item>
        <item id="ADDRESS1_1" label="Address" resourceId="JoinTree_1.AGED_DETAILS.ADDRESS1"></item>
        <item id="BILL_CYC_CD_1" label="Bill Cycle" resourceId="JoinTree_1.AGED_DETAILS.BILL_CYC_CD"></item>
        <item id="DST_ID" label="Distribution Code" resourceId="JoinTree_1.AGED_DETAILS.DST_ID"></item>
        <item id="ENTITY_NAME_1" label="Entity Name" resourceId="JoinTree_1.AGED_DETAILS.ENTITY_NAME"></item>
        <item id="SA_ID" label="Service Agreement" resourceId="JoinTree_1.AGED_DETAILS.SA_ID"></item>
        <item id="SA_TYPE_CD_1" label="SA Type" resourceId="JoinTree_1.AGED_DETAILS.SA_TYPE_CD"></item>
      </items>
    </itemGroup>
  </itemGroups>
  <resources>
    <jdbcQuery id="AGED_DETAILS" datasourceId="CityCorp_DS">
      <fieldList>
        <field id="BILL_CYC_CD" type="java.lang.String"></field>
        <field id="SA_TYPE_CD" type="java.lang.String"></field>
        <field id="ADDRESS1" type="java.lang.String"></field>
        <field id="ACCT_ID" type="java.lang.String"></field>
        <field id="SA_ID" type="java.lang.String"></field>
        <field id="ENTITY_NAME" type="java.lang.String"></field>
        <field id="DST_ID" type="java.lang.String"></field>
      </fieldList>
      <query>SELECT
    a.bill_cyc_cd,
    sa.sa_type_cd,
    p.address1 as ADDRESS1,
    a.acct_id,
    sa.sa_id,
    sat.dst_id,
    pn.entity_name

FROM
         cisadm.ci_acct a
    JOIN cisadm.ci_acct_per      ap ON a.acct_id = ap.acct_id
                                  AND main_cust_sw = 'Y'
    JOIN cisadm.ci_per_name      pn ON ap.per_id = pn.per_id
                                  AND pn.prim_name_sw = 'Y'
    JOIN cisadm.ci_sa            sa ON a.acct_id = sa.acct_id
                            AND sa.sa_type_cd IN (
        SELECT
            sa_type_cd
        FROM
            cisadm.ci_sa_type
        WHERE
                allow_billing_sw = 'Y'
                and prem_req_sw = 'Y'
    )
    join cisadm.ci_sa_type  sat on sa.sa_type_cd = sat.sa_type_cd
    JOIN cisadm.ci_prem          p ON sa.char_prem_id = p.prem_id
Union
SELECT
    a.bill_cyc_cd,
    sa.sa_type_cd,
    ' ' as ADDRESS1,
    a.acct_id,
    sa.sa_id,
    sat.dst_id,
    pn.entity_name

FROM
         cisadm.ci_acct a
    JOIN cisadm.ci_acct_per      ap ON a.acct_id = ap.acct_id
                                  AND main_cust_sw = 'Y'
    JOIN cisadm.ci_per_name      pn ON ap.per_id = pn.per_id
                                  AND pn.prim_name_sw = 'Y'
    JOIN cisadm.ci_sa            sa ON a.acct_id = sa.acct_id
                            AND sa.sa_type_cd IN (
        SELECT
            sa_type_cd
        FROM
            cisadm.ci_sa_type
        WHERE
                allow_billing_sw = 'Y'
                and prem_req_sw = 'N'
    )
    join cisadm.ci_sa_type  sat on sa.sa_type_cd = sat.sa_type_cd</query>
    </jdbcQuery>
    <jdbcQuery id="AGED_90" datasourceId="CityCorp_DS">
      <fieldList>
        <field id="SA_ID" type="java.lang.String"></field>
        <field id="SUM_FT1_CUR_AMT__1" fieldDBName="SUM(FT1.CUR_AMT)" type="java.math.BigDecimal"></field>
        <field id="SUM_FT1_TOT_AMT__1" fieldDBName="SUM(FT1.TOT_AMT)" type="java.math.BigDecimal"></field>
      </fieldList>
      <query>SELECT
            ft1.sa_id, sum(ft1.cur_amt),sum(ft1.tot_amt)
            
        FROM
            cisadm.ci_ft ft1
        WHERE
                ft1.freeze_sw = 'Y'
            AND ( ft1.ars_dt BETWEEN ( trunc(sysdate) - 90 ) AND trunc(sysdate) )
group by ft1.sa_id</query>
    </jdbcQuery>
    <jdbcQuery id="AGED_180" datasourceId="CityCorp_DS">
      <fieldList>
        <field id="SA_ID" type="java.lang.String"></field>
        <field id="SUM_FT1_CUR_AMT__3" fieldDBName="SUM(FT1.CUR_AMT)" type="java.math.BigDecimal"></field>
        <field id="SUM_FT1_TOT_AMT__3" fieldDBName="SUM(FT1.TOT_AMT)" type="java.math.BigDecimal"></field>
      </fieldList>
      <query>SELECT
            ft1.sa_id, sum(ft1.cur_amt),sum(ft1.tot_amt)
        FROM
            cisadm.ci_ft ft1
        WHERE
                ft1.freeze_sw = 'Y'
            AND ( ft1.ars_dt BETWEEN ( trunc(sysdate) - 180 ) AND trunc(sysdate) - 91 )
group by ft1.sa_id</query>
    </jdbcQuery>
    <jdbcQuery id="AGED_270" datasourceId="CityCorp_DS">
      <fieldList>
        <field id="SA_ID" type="java.lang.String"></field>
        <field id="SUM_FT1_CUR_AMT__2" fieldDBName="SUM(FT1.CUR_AMT)" type="java.math.BigDecimal"></field>
        <field id="SUM_FT1_TOT_AMT__2" fieldDBName="SUM(FT1.TOT_AMT)" type="java.math.BigDecimal"></field>
      </fieldList>
      <query>SELECT
            ft1.sa_id, sum(ft1.cur_amt),sum(ft1.tot_amt)
        FROM
            cisadm.ci_ft ft1
        WHERE
                ft1.freeze_sw = 'Y'
            AND ( ft1.ars_dt BETWEEN ( trunc(sysdate) - 270 ) AND trunc(sysdate) - 181 )
group by ft1.sa_id</query>
    </jdbcQuery>
    <jdbcQuery id="AGED_CURRENT" datasourceId="CityCorp_DS">
      <fieldList>
        <field id="SA_ID" type="java.lang.String"></field>
        <field id="SUM_FT1_CUR_AMT_" fieldDBName="SUM(FT1.CUR_AMT)" type="java.math.BigDecimal"></field>
        <field id="SUM_FT1_TOT_AMT_" fieldDBName="SUM(FT1.TOT_AMT)" type="java.math.BigDecimal"></field>
      </fieldList>
      <query>SELECT
            ft1.sa_id,
            sum(ft1.cur_amt),sum(ft1.tot_amt)
            
        FROM
            cisadm.ci_ft ft1
        WHERE
                ft1.freeze_sw = 'Y'
            AND ( ft1.ars_dt &lt;= trunc(sysdate) )
group by ft1.sa_id</query>
    </jdbcQuery>
    <jdbcQuery id="AGED_OLD" datasourceId="CityCorp_DS">
      <fieldList>
        <field id="SA_ID" type="java.lang.String"></field>
        <field id="SUM_FT1_CUR_AMT__4" fieldDBName="SUM(FT1.CUR_AMT)" type="java.math.BigDecimal"></field>
        <field id="SUM_FT1_TOT_AMT__4" fieldDBName="SUM(FT1.TOT_AMT)" type="java.math.BigDecimal"></field>
      </fieldList>
      <query>SELECT
            ft1.sa_id, sum(ft1.cur_amt),sum(ft1.tot_amt)
            
        FROM
            cisadm.ci_ft ft1
        WHERE
                ft1.freeze_sw = 'Y'
            AND ( ft1.ars_dt &lt;= trunc(sysdate) - 271)  
group by ft1.sa_id</query>
    </jdbcQuery>
    <jdbcQuery id="JoinTree_1" datasourceId="CityCorp_DS">
      <fieldList>
        <field id="AGED_CURRENT.SA_ID" type="java.lang.String"></field>
        <field id="AGED_CURRENT.SUM_FT1_CUR_AMT_" fieldDBName="SUM(FT1.CUR_AMT)" type="java.math.BigDecimal"></field>
        <field id="AGED_CURRENT.SUM_FT1_TOT_AMT_" fieldDBName="SUM(FT1.TOT_AMT)" type="java.math.BigDecimal"></field>
        <field id="AGED_90.SA_ID" type="java.lang.String"></field>
        <field id="AGED_90.SUM_FT1_CUR_AMT__1" fieldDBName="SUM(FT1.CUR_AMT)" type="java.math.BigDecimal"></field>
        <field id="AGED_90.SUM_FT1_TOT_AMT__1" fieldDBName="SUM(FT1.TOT_AMT)" type="java.math.BigDecimal"></field>
        <field id="AGED_180.SA_ID" type="java.lang.String"></field>
        <field id="AGED_180.SUM_FT1_CUR_AMT__3" fieldDBName="SUM(FT1.CUR_AMT)" type="java.math.BigDecimal"></field>
        <field id="AGED_180.SUM_FT1_TOT_AMT__3" fieldDBName="SUM(FT1.TOT_AMT)" type="java.math.BigDecimal"></field>
        <field id="AGED_270.SA_ID" type="java.lang.String"></field>
        <field id="AGED_270.SUM_FT1_CUR_AMT__2" fieldDBName="SUM(FT1.CUR_AMT)" type="java.math.BigDecimal"></field>
        <field id="AGED_270.SUM_FT1_TOT_AMT__2" fieldDBName="SUM(FT1.TOT_AMT)" type="java.math.BigDecimal"></field>
        <field id="AGED_DETAILS.BILL_CYC_CD" type="java.lang.String"></field>
        <field id="AGED_DETAILS.SA_TYPE_CD" type="java.lang.String"></field>
        <field id="AGED_DETAILS.ADDRESS1" type="java.lang.String"></field>
        <field id="AGED_DETAILS.ACCT_ID" type="java.lang.String"></field>
        <field id="AGED_DETAILS.SA_ID" type="java.lang.String"></field>
        <field id="AGED_DETAILS.ENTITY_NAME" type="java.lang.String"></field>
        <field id="AGED_DETAILS.DST_ID" type="java.lang.String"></field>
        <field id="AGED_OLD.SA_ID" type="java.lang.String"></field>
        <field id="AGED_OLD.SUM_FT1_CUR_AMT__4" fieldDBName="SUM(FT1.CUR_AMT)" type="java.math.BigDecimal"></field>
        <field id="AGED_OLD.SUM_FT1_TOT_AMT__4" fieldDBName="SUM(FT1.TOT_AMT)" type="java.math.BigDecimal"></field>
      </fieldList>
      <joinInfo alias="AGED_DETAILS" referenceId="AGED_DETAILS"></joinInfo>
      <joinList>
        <join expr="AGED_DETAILS.SA_ID == AGED_90.SA_ID" left="AGED_DETAILS" right="AGED_90" type="leftOuter" weight="1"></join>
        <join expr="AGED_DETAILS.SA_ID == AGED_180.SA_ID" left="AGED_DETAILS" right="AGED_180" type="leftOuter" weight="1"></join>
        <join expr="AGED_DETAILS.SA_ID == AGED_270.SA_ID" left="AGED_DETAILS" right="AGED_270" type="leftOuter" weight="1"></join>
        <join expr="AGED_DETAILS.SA_ID == AGED_CURRENT.SA_ID" left="AGED_DETAILS" right="AGED_CURRENT" type="leftOuter" weight="1"></join>
        <join expr="AGED_DETAILS.SA_ID == AGED_OLD.SA_ID" left="AGED_DETAILS" right="AGED_OLD" type="leftOuter" weight="1"></join>
      </joinList>
      <joinOptions></joinOptions>
      <query>SELECT
    a.bill_cyc_cd,
    sa.sa_type_cd,
    p.address1 as ADDRESS1,
    a.acct_id,
    sa.sa_id,
    sat.dst_id,
    pn.entity_name

FROM
         cisadm.ci_acct a
    JOIN cisadm.ci_acct_per      ap ON a.acct_id = ap.acct_id
                                  AND main_cust_sw = 'Y'
    JOIN cisadm.ci_per_name      pn ON ap.per_id = pn.per_id
                                  AND pn.prim_name_sw = 'Y'
    JOIN cisadm.ci_sa            sa ON a.acct_id = sa.acct_id
                            AND sa.sa_type_cd IN (
        SELECT
            sa_type_cd
        FROM
            cisadm.ci_sa_type
        WHERE
                allow_billing_sw = 'Y'
                and prem_req_sw = 'Y'
    )
    join cisadm.ci_sa_type  sat on sa.sa_type_cd = sat.sa_type_cd
    JOIN cisadm.ci_prem          p ON sa.char_prem_id = p.prem_id
Union
SELECT
    a.bill_cyc_cd,
    sa.sa_type_cd,
    ' ' as ADDRESS1,
    a.acct_id,
    sa.sa_id,
    sat.dst_id,
    pn.entity_name

FROM
         cisadm.ci_acct a
    JOIN cisadm.ci_acct_per      ap ON a.acct_id = ap.acct_id
                                  AND main_cust_sw = 'Y'
    JOIN cisadm.ci_per_name      pn ON ap.per_id = pn.per_id
                                  AND pn.prim_name_sw = 'Y'
    JOIN cisadm.ci_sa            sa ON a.acct_id = sa.acct_id
                            AND sa.sa_type_cd IN (
        SELECT
            sa_type_cd
        FROM
            cisadm.ci_sa_type
        WHERE
                allow_billing_sw = 'Y'
                and prem_req_sw = 'N'
    )
    join cisadm.ci_sa_type  sat on sa.sa_type_cd = sat.sa_type_cd</query>
      <tableRefList>
        <tableRef alwaysIncludeTable="false" tableAlias="AGED_180" tableId="AGED_180"></tableRef>
