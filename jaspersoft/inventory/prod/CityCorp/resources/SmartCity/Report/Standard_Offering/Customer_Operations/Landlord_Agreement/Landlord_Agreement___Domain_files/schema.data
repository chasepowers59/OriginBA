    <jdbcQuery id="CMS_LL_COVERAGE" datasourceId="CityCorp_DS">
      <fieldList>
        <field id="LL_ID" type="java.lang.String"></field>
        <field id="IS_WATER_COVERED" type="java.lang.String"></field>
        <field id="IS_SEWER_COVERED" type="java.lang.String"></field>
        <field id="IS_ELECTRIC_COVERED" type="java.lang.String"></field>
        <field id="IS_GAS_COVERED" type="java.lang.String"></field>
      </fieldList>
      <query>SELECT 
  LL.LL_ID,
  MAX(CASE WHEN LLD.SVC_TYPE_CD = 'W'  THEN 'Y' ELSE 'N' END) AS IS_WATER_COVERED,
  MAX(CASE WHEN LLD.SVC_TYPE_CD = 'WW' THEN 'Y' ELSE 'N' END) AS IS_SEWER_COVERED,
  MAX(CASE WHEN LLD.SVC_TYPE_CD = 'E'  THEN 'Y' ELSE 'N' END) AS IS_ELECTRIC_COVERED,
  MAX(CASE WHEN LLD.SVC_TYPE_CD = 'G'  THEN 'Y' ELSE 'N' END) AS IS_GAS_COVERED
FROM
  CISADM.CI_LANDLORD LL,
  CISADM.CI_LL_DETAIL LLD 
WHERE
  LL.LL_ID = LLD.LL_ID (+)
GROUP BY 
  LL.LL_ID</query>
    </jdbcQuery>
