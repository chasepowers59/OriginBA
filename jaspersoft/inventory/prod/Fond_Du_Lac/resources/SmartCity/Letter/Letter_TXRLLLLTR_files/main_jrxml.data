		<band height="404" splitType="Stretch">
			<property name="com.jaspersoft.studio.unit.height" value="px"/>
			<textField textAdjust="StretchHeight">
				<reportElement x="0" y="0" width="572" height="404" isPrintWhenDetailOverflows="true" uuid="95d0e317-8ea0-48bb-ba9e-992431a4ad6e">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<box topPadding="5" leftPadding="50" bottomPadding="2" rightPadding="50"/>
				<textElement verticalAlignment="Top" markup="none">
					<font fontName="Calibri" size="11"/>
					<paragraph lineSpacing="1_1_2"/>
				</textElement>
				<textFieldExpression><![CDATA["Re: Delinquent Final Bill Payment Notice of Water Bill\n\n"+
"At the time this letter was prepared and according to the City Assessor’s records, you are listed as the owner of the property located at "+$V{ADDR001}+", Fond du Lac, Wisconsin.\n\n"+

"There is an unpaid or delinquent water/sewer bill for this property by "+$V{RENT001}+". The unpaid amount is "+$V{AMT001}+". Please bring this letter with you when making payments on this outstanding balance.\n\n"+

"If the amount outstanding is not received on or before "+$V{DUEDT001}+", a one-time 10% penalty will be added to the delinquent amount. If the outstanding amount plus penalty is not paid by "+$V{DUEDT002}+", the same will be levied as a tax to the lot of parcel of real estate to which the water was furnished, as provided for in Sections 66.0809 of the Wisconsin Statutes.\n\n"+

"If you have any questions in regard to this letter or are not the owner of this property, please contact the City of Fond du Lac Water Utility Business Office at 920-322-3680.\n\n"+

"Sincerely,\n\n\n"+
"City of Fond du Lac Water Utility"]]></textFieldExpression>
			</textField>
		</band>
