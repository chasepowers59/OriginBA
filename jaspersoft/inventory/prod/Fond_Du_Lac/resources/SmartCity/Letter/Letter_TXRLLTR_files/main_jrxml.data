						<font fontName="Calibri" size="11" isBold="true" isUnderline="true"/>
					</textElement>
					<textFieldExpression><![CDATA["NOTICE OF PAST DUE AMOUNT AND INTENT TO TRANSFER TO THE TAX ROLL"]]></textFieldExpression>
				</textField>
				<textField textAdjust="StretchHeight" isBlankWhenNull="true">
					<reportElement x="0" y="60" width="572" height="20" uuid="73ddb104-31a2-4362-91ee-98de765c8d41">
						<property name="com.jaspersoft.studio.unit.height" value="px"/>
					</reportElement>
					<box leftPadding="5"/>
					<textElement textAlignment="Left" verticalAlignment="Middle">
						<font fontName="Calibri" size="11" isBold="false" isUnderline="false"/>
					</textElement>
					<textFieldExpression><![CDATA["This is to notify you that payment for utility service provided to the address listed above is past due. "]]></textFieldExpression>
				</textField>
				<textField textAdjust="StretchHeight" isBlankWhenNull="true">
					<reportElement x="50" y="80" width="522" height="40" uuid="a26c5024-0a3b-4d06-b84d-6a1886daaed5">
						<property name="com.jaspersoft.studio.unit.x" value="px"/>
						<property name="com.jaspersoft.studio.unit.y" value="px"/>
						<property name="com.jaspersoft.studio.unit.height" value="px"/>
						<property name="com.jaspersoft.studio.unit.width" value="px"/>
					</reportElement>
					<box topPadding="3" leftPadding="5"/>
					<textElement textAlignment="Justified" verticalAlignment="Top" markup="html">
						<font fontName="Calibri" size="11" isBold="false" isUnderline="false"/>
						<paragraph lineSpacing="1_1_2" lineSpacingSize="1.5"/>
					</textElement>
					<textFieldExpression><![CDATA["If payment for the above amount is not received by the Utility <span style='font-weight: bold;'>by November 1, an additional penalty of 10% of the past due amount will be added</span> to the amount owed."]]></textFieldExpression>
				</textField>
				<ellipse>
					<reportElement x="40" y="89" width="3" height="3" backcolor="#000000" uuid="48089227-d5f0-42af-ba2a-d6e6ab5be0a1">
						<property name="com.jaspersoft.studio.unit.x" value="px"/>
						<property name="com.jaspersoft.studio.unit.width" value="px"/>
						<property name="com.jaspersoft.studio.unit.height" value="px"/>
						<property name="com.jaspersoft.studio.unit.y" value="px"/>
					</reportElement>
				</ellipse>
				<ellipse>
					<reportElement x="40" y="129" width="3" height="3" backcolor="#000000" uuid="85d2b2e3-1545-4a25-9fff-8b0ab7d5cbd2">
						<property name="com.jaspersoft.studio.unit.x" value="px"/>
						<property name="com.jaspersoft.studio.unit.width" value="px"/>
						<property name="com.jaspersoft.studio.unit.height" value="px"/>
						<property name="com.jaspersoft.studio.unit.y" value="px"/>
					</reportElement>
				</ellipse>
				<textField textAdjust="StretchHeight" isBlankWhenNull="true">
					<reportElement x="50" y="120" width="521" height="100" uuid="c646e2a5-2647-424c-a826-b841fb732f04">
						<property name="com.jaspersoft.studio.unit.x" value="px"/>
						<property name="com.jaspersoft.studio.unit.y" value="px"/>
						<property name="com.jaspersoft.studio.unit.height" value="px"/>
						<property name="com.jaspersoft.studio.unit.width" value="px"/>
					</reportElement>
					<box topPadding="3" leftPadding="5"/>
					<textElement textAlignment="Justified" verticalAlignment="Top" markup="html">
						<font fontName="Calibri" size="11" isBold="false" isUnderline="false"/>
						<paragraph lineSpacing="1_1_2" lineSpacingSize="1.5"/>
					</textElement>
					<textFieldExpression><![CDATA["If full payment is not received<span style='font-weight: bold;'> by November 15, the past due amounts plus penalties will be levied as a special charge, as defined under Wis. Stat.</span> § 74.01 (4), against the lot or parcel of real estate to which utility service was furnished and for which payment is delinquent. This action will be taken in accordance with Wis. Stat. § 66.0809(3). There is no exception  for rental property although additional provisions may apply to certain rental properties as described below."]]></textFieldExpression>
				</textField>
			</frame>
		</band>
		<band height="95">
			<frame>
				<reportElement x="0" y="0" width="572" height="95" uuid="656405e9-b8ff-429d-a0cc-a7ed36dc8e2f"/>
				<box topPadding="0" leftPadding="0" bottomPadding="0" rightPadding="0">
					<topPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<leftPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<bottomPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<rightPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
				</box>
				<textField textAdjust="StretchHeight" isBlankWhenNull="true">
					<reportElement x="0" y="5" width="572" height="20" uuid="2ce51381-175a-4096-91cd-6a6a96ac411f">
						<property name="com.jaspersoft.studio.unit.height" value="px"/>
						<property name="com.jaspersoft.studio.unit.y" value="px"/>
					</reportElement>
					<box leftPadding="5"/>
					<textElement textAlignment="Left" verticalAlignment="Middle" markup="none">
						<font size="11" isBold="true" isItalic="true"/>
					</textElement>
					<textFieldExpression><![CDATA["To Residential Tenant Responsible for Utility Bill "]]></textFieldExpression>
				</textField>
				<textField textAdjust="StretchHeight" isBlankWhenNull="true">
					<reportElement x="0" y="45" width="572" height="50" uuid="6de2b45b-29de-464a-a473-2115277486ec">
						<property name="com.jaspersoft.studio.unit.height" value="px"/>
						<property name="com.jaspersoft.studio.unit.y" value="px"/>
					</reportElement>
					<box leftPadding="20"/>
					<textElement textAlignment="Left" verticalAlignment="Top" markup="styled">
						<font fontName="Calibri" size="11" isBold="false"/>
						<paragraph lineSpacing="1_1_2" lineSpacingSize="1.5"/>
					</textElement>
					<textFieldExpression><![CDATA["If the property provided with utility service is a residential rental property, and the Utility has been properly notified in writing that a tenant is responsible for the payment of utility charges at the rental dwelling unit, and utility bills for service have been sent to the tenant in the tenant’s own name, Wisconsin law grants the Utility a lien upon the responsible tenant’s personal assets in the amount of the past due amount plus penalties. The lien is effective as of the date of this notice. "+

"If you, as the tenant responsible for the past due utility charges, pay the full amount plus penalties owed to the Utility by November 15, this lien is automatically extinguished. If you fail to pay the full amount owed to the Utility by November 15, the Utility may file notice of the lien with the Fond du Lac County Clerk of Courts. Filing a notice of lien would result in the lien appearing under your name in the Wisconsin Consolidated Court Automation Program (CCAP). The Utility may thereafter take action to enforce the lien against your personal assets.\n"+

"If the property owner pays the past due utility charges, Wisconsin law requires the Utility to transfer its lien on your personal assets to the property owner. The property owner may then file notice of the lien with the Fond du Lac County Clerk of Courts, and notice of the lien would appear under your name in the Wisconsin Consolidated Court Automation Program (CCAP). The property owner may thereafter take action to enforce the lien against your personal assets. "+

"The lien granted and this notice is provided in accordance with Wis. Stat. § 66.0809(3m)(a) and (b)."]]></textFieldExpression>
				</textField>
				<textField textAdjust="StretchHeight" isBlankWhenNull="true">
					<reportElement x="0" y="25" width="572" height="20" uuid="0c3eedee-c192-45a4-8c49-8fd089ce5b06">
						<property name="com.jaspersoft.studio.unit.height" value="px"/>
						<property name="com.jaspersoft.studio.unit.y" value="px"/>
					</reportElement>
					<box leftPadding="0"/>
					<textElement textAlignment="Center" verticalAlignment="Middle">
						<font fontName="Calibri" size="11" isBold="true" isUnderline="true"/>
					</textElement>
					<textFieldExpression><![CDATA["NOTICE OF LIEN ON TENANT’S PERSONAL ASSETS"]]></textFieldExpression>
				</textField>
			</frame>
		</band>
