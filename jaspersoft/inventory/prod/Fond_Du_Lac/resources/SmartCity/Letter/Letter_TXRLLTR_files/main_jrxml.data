				<reportElement x="0" y="30" width="572" height="204" uuid="7e9086fa-4ea3-467d-8db5-adc29d9cc98f"/>
				<textField textAdjust="StretchHeight" isBlankWhenNull="true">
					<reportElement x="0" y="0" width="572" height="20" uuid="7bf960ad-b953-4604-83d9-2dd98cd76e0e">
						<property name="com.jaspersoft.studio.unit.height" value="px"/>
						<property name="com.jaspersoft.studio.unit.y" value="px"/>
					</reportElement>
					<box leftPadding="5"/>
					<textElement textAlignment="Left" verticalAlignment="Middle" markup="none">
						<font fontName="Arial" size="9" isBold="true" isItalic="false"/>
					</textElement>
					<textFieldExpression><![CDATA["Please call this telephone number, (920) 322-3680 immediately if:"]]></textFieldExpression>
				</textField>
				<textField textAdjust="StretchHeight" isBlankWhenNull="true">
					<reportElement x="0" y="20" width="572" height="40" uuid="943f5f51-645c-4425-a04c-32ded14e3939">
						<property name="com.jaspersoft.studio.unit.height" value="px"/>
						<property name="com.jaspersoft.studio.unit.y" value="px"/>
					</reportElement>
					<box leftPadding="20"/>
					<textElement textAlignment="Left" verticalAlignment="Middle" markup="styled">
						<font fontName="Arial" size="9" isBold="false"/>
						<paragraph lineSpacing="1_1_2" lineSpacingSize="1.5"/>
					</textElement>
					<textFieldExpression><![CDATA["1.	You dispute the notice of delinquent account.\n"+
"2.	You have a question about your utility service arrears."]]></textFieldExpression>
				</textField>
				<textField textAdjust="StretchHeight" isBlankWhenNull="true">
					<reportElement x="0" y="60" width="572" height="24" uuid="ba97492f-fc9b-4337-9d68-e460ce701a15">
						<property name="com.jaspersoft.studio.unit.height" value="px"/>
						<property name="com.jaspersoft.studio.unit.y" value="px"/>
					</reportElement>
					<box leftPadding="5"/>
					<textElement textAlignment="Left" verticalAlignment="Middle" markup="none">
						<font fontName="Arial" size="10" isBold="true" isItalic="false"/>
					</textElement>
					<textFieldExpression><![CDATA["PAYMENTS MAY BE MADE USING ONE OF THE FOLLOWING METHODS:"]]></textFieldExpression>
				</textField>
				<textField textAdjust="StretchHeight" isBlankWhenNull="true">
					<reportElement x="0" y="86" width="572" height="72" uuid="ada7f33e-6c94-4193-852c-81cd0f2afef3">
						<property name="com.jaspersoft.studio.unit.height" value="px"/>
						<property name="com.jaspersoft.studio.unit.y" value="px"/>
					</reportElement>
					<box leftPadding="20"/>
					<textElement textAlignment="Left" verticalAlignment="Middle" markup="styled">
						<font fontName="Arial" size="10" isBold="false"/>
						<paragraph lineSpacing="1_1_2" lineSpacingSize="1.5"/>
					</textElement>
					<textFieldExpression><![CDATA["1.	In person at the City Payments counter located in the City/County Government Center, 160 S. Macy Street\n"+
"2.	By mail payable to the City of Fond du Lac to PO Box 830, Fond du Lac, WI  54936-0830\n"+
"3.	Payment drop boxes located in the City/County Government Center lobby, Lot 19, or Lot 22 off of Macy Street\n"+
"4.	Online at the City website www.fdl.wi.gov via e-check or credit card\n"]]></textFieldExpression>
				</textField>
				<textField textAdjust="StretchHeight" isBlankWhenNull="true">
					<reportElement x="0" y="181" width="572" height="38" uuid="5c8543f2-8ee5-4a61-95be-f997b5a690f9">
						<property name="com.jaspersoft.studio.unit.height" value="px"/>
						<property name="com.jaspersoft.studio.unit.y" value="px"/>
					</reportElement>
					<box leftPadding="5"/>
					<textElement textAlignment="Left" verticalAlignment="Middle" markup="none">
						<font fontName="Arial" size="10" isBold="true" isItalic="true"/>
						<paragraph lineSpacing="1_1_2" lineSpacingSize="1.5"/>
					</textElement>
					<textFieldExpression><![CDATA["Mastercard, VISA, and Discover Cards are accepted when making payments at the counter or online.  There is no additional charge for credit card payments."]]></textFieldExpression>
				</textField>
			</frame>
		</band>
	</detail>
