	<detail>
		<band height="480" splitType="Stretch">
			<property name="com.jaspersoft.studio.unit.height" value="px"/>
			<frame>
				<reportElement x="0" y="0" width="572" height="480" uuid="74b851a6-3e32-4786-90d4-2334cdaa2287"/>
				<textField textAdjust="StretchHeight" isBlankWhenNull="true">
					<reportElement stretchType="RelativeToBandHeight" x="0" y="40" width="572" height="110" isPrintWhenDetailOverflows="true" uuid="2fbb36c0-3b53-4ad8-98a6-298046086371">
						<property name="com.jaspersoft.studio.unit.x" value="px"/>
						<property name="com.jaspersoft.studio.unit.height" value="px"/>
						<property name="com.jaspersoft.studio.unit.y" value="px"/>
					</reportElement>
					<box topPadding="5" leftPadding="10" rightPadding="10"/>
					<textElement textAlignment="Left" verticalAlignment="Top" markup="styled">
						<font fontName="SansSerif" size="10" isBold="false"/>
						<paragraph lineSpacing="1_1_2"/>
					</textElement>
					<textFieldExpression><![CDATA[($F{entityName1}==null?"":$F{entityName1})+"\n"+($F{mailingAddress1}==null?"":$F{mailingAddress1})+"\n"+($F{mailingCity}==null?"":$F{mailingCity})+", "+
($F{mailingState}==null?"":$F{mailingState})+" " + ($F{mailingPostal}==null?"":$F{mailingPostal})+"\n\n"+"Reference: "+($F{mailingAddress1}==null?"":$F{mailingAddress1})+"\n"]]></textFieldExpression>
				</textField>
				<textField textAdjust="StretchHeight">
					<reportElement x="0" y="150" width="572" height="250" uuid="95d0e317-8ea0-48bb-ba9e-992431a4ad6e">
						<property name="com.jaspersoft.studio.unit.height" value="px"/>
					</reportElement>
					<box topPadding="2" leftPadding="10" bottomPadding="2" rightPadding="10"/>
					<textElement textAlignment="Justified" verticalAlignment="Top" markup="html">
						<font fontName="SansSerif" size="10"/>
						<paragraph lineSpacing="1_1_2"/>
					</textElement>
					<textFieldExpression><![CDATA["The site referenced above, is documented to have a shallow water service or previously had a water service freeze during the winter months. Notification was mailed by the utility earlier this year, requesting the occupant of this property to run water with the intention of preventing a freeze occurrence.<br /><br />"+

"This letter serves as notice, effective immediately the utility is requesting water customers on the winter run list to <span style='text-decoration: underline;'>STOP</span> running water.<br /><br />"+

"Water volume utilized to prevent a freeze event will be calculated based off the accounts average quarterly usage and credits to water accounts will be applied accordingly within the next few months.<br /><br />"+

"Please contact a utility representative at (920) 322-3680 or <span style='color: #0077C8;text-decoration: underline;'>fdlwater@fdl.wi.gov</span> with any questions regarding this letter."]]></textFieldExpression>
				</textField>
				<textField textAdjust="StretchHeight" isBlankWhenNull="true">
					<reportElement stretchType="RelativeToBandHeight" x="0" y="400" width="572" height="80" isPrintWhenDetailOverflows="true" uuid="36e54847-59a6-4edd-ace2-24ca6e2029eb">
						<property name="com.jaspersoft.studio.unit.x" value="px"/>
						<property name="com.jaspersoft.studio.unit.y" value="px"/>
					</reportElement>
					<box topPadding="10" leftPadding="10" rightPadding="10"/>
					<textElement textAlignment="Left" verticalAlignment="Top" markup="styled">
						<font fontName="SansSerif" size="10" isBold="false"/>
						<paragraph lineSpacing="1_1_2"/>
					</textElement>
					<textFieldExpression><![CDATA["Sincerely,\n\n"+"Travis Kloetzke\n"+"Utility General Manager\n"+"Fond du Lac Water Utility\n"+"109 N Macy St"]]></textFieldExpression>
				</textField>
				<textField textAdjust="StretchHeight" pattern="MMMM dd, yyyy" isBlankWhenNull="true">
					<reportElement stretchType="RelativeToBandHeight" x="0" y="0" width="572" height="25" isPrintWhenDetailOverflows="true" uuid="d7579dbe-11a6-40d0-bda2-9699ba8e4977">
						<property name="com.jaspersoft.studio.unit.x" value="px"/>
						<property name="com.jaspersoft.studio.unit.y" value="px"/>
						<property name="com.jaspersoft.studio.unit.height" value="px"/>
					</reportElement>
					<box topPadding="0" leftPadding="10" rightPadding="10"/>
