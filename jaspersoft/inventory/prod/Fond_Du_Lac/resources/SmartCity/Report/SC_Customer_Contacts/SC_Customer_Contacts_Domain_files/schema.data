        <field id="CI_CC.ILM_DT" type="java.sql.Timestamp"></field>
        <field id="CI_CC.ILM_ARCH_SW" type="java.lang.String"></field>
      </fieldList>
      <filterString>CI_CC_TYPE_L.LANGUAGE_CD == 'ENG' and CI_CC_CL_L.LANGUAGE_CD == 'ENG'</filterString>
      <joinInfo alias="CI_CC_CL_L" referenceId="CI_CC_CL_L"></joinInfo>
      <joinList>
        <join expr="CI_CC_CL_L.CC_CL_CD == CI_CC.CC_CL_CD" left="CI_CC_CL_L" right="CI_CC" type="inner" weight="1"></join>
        <join expr="CI_CC.CC_CL_CD == CI_CC_TYPE_L.CC_CL_CD and CI_CC.CC_TYPE_CD == CI_CC_TYPE_L.CC_TYPE_CD" left="CI_CC" right="CI_CC_TYPE_L" type="inner" weight="1"></join>
      </joinList>
      <joinOptions includeAllDataIslandJoins="true"></joinOptions>
      <tableRefList>
        <tableRef alwaysIncludeTable="false" tableAlias="CI_CC_CL_L" tableId="CI_CC_CL_L"></tableRef>
        <tableRef alwaysIncludeTable="false" tableAlias="CI_CC" tableId="CI_CC"></tableRef>
        <tableRef alwaysIncludeTable="false" tableAlias="CI_CC_TYPE_L" tableId="CI_CC_TYPE_L"></tableRef>
