  <resources>
    <jdbcTable id="CI_CC" datasourceId="FondDuLac_DS" datasourceTableName="CI_CC" schemaAlias="CISADM">
      <fieldList>
        <field id="CC_ID" type="java.lang.String"></field>
        <field id="USER_ID" type="java.lang.String"></field>
        <field id="PER_ID" type="java.lang.String"></field>
