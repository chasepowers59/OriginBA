        <field id="VERSION" type="java.math.BigDecimal"></field>
        <field id="CC_SHORT_NOTE" type="java.lang.String"></field>
      </fieldList>
      <filterString>LANGUAGE_CD == 'ENG'</filterString>
    </jdbcTable>
    <jdbcTable id="JoinTree_2" datasourceId="FondDuLac_DS" datasourceTableName="CI_CC_CL_L" schemaAlias="CISADM">
      <fieldList>
        <field id="CI_CC_CL_L.CC_CL_CD" type="java.lang.String"></field>
        <field id="CI_CC_CL_L.LANGUAGE_CD" type="java.lang.String"></field>
