        <field id="ILM_ARCH_SW" type="java.lang.String"></field>
      </fieldList>
    </jdbcTable>
    <jdbcTable id="CI_CC_CL_L" datasourceId="FondDuLac_DS" datasourceTableName="CI_CC_CL_L" schemaAlias="CISADM">
      <fieldList>
        <field id="CC_CL_CD" type="java.lang.String"></field>
        <field id="LANGUAGE_CD" type="java.lang.String"></field>
        <field id="VERSION" type="java.math.BigDecimal"></field>
        <field id="DESCR" type="java.lang.String"></field>
      </fieldList>
      <filterString>LANGUAGE_CD == 'ENG'</filterString>
    </jdbcTable>
    <jdbcTable id="CI_CC_TYPE_L" datasourceId="FondDuLac_DS" datasourceTableName="CI_CC_TYPE_L" schemaAlias="CISADM">
      <fieldList>
        <field id="CC_CL_CD" type="java.lang.String"></field>
        <field id="CC_TYPE_CD" type="java.lang.String"></field>
