      <joinList>
        <join expr="CI_ADJ.ADJ_TYPE_CD == CI_ADJ_TYPE.ADJ_TYPE_CD" left="CI_ADJ" right="CI_ADJ_TYPE" type="inner" weight="1"></join>
        <join expr="CI_ADJ_TYPE.ADJ_TYPE_CD == CI_ADJ_TYPE_L.ADJ_TYPE_CD" left="CI_ADJ_TYPE" right="CI_ADJ_TYPE_L" type="inner" weight="1"></join>
        <join expr="CI_ADJ.ADJ_TYPE_CD == CI_ADJ_TYPE_L.ADJ_TYPE_CD and CI_ADJ_TYPE_L.LANGUAGE_CD == 'ENG'" left="CI_ADJ" right="CI_ADJ_TYPE_L" type="inner" weight="1"></join>
        <join expr="CI_ADJ.CAN_RSN_CD == CI_ADJ_CAN_RSN_L.CAN_RSN_CD and CI_ADJ_CAN_RSN_L.LANGUAGE_CD == 'ENG'" left="CI_ADJ" right="CI_ADJ_CAN_RSN_L" type="leftOuter" weight="1"></join>
        <join expr="CI_ADJ.ADJ_ID == CI_ADJ_APREQ.ADJ_ID" left="CI_ADJ" right="CI_ADJ_APREQ" type="leftOuter" weight="1"></join>
        <join expr="CI_ADJ.SA_ID == CI_SA.SA_ID" left="CI_ADJ" right="CI_SA" type="inner" weight="1"></join>
        <join expr="CI_SA.ACCT_ID == CI_ACCT.ACCT_ID" left="CI_SA" right="CI_ACCT" type="inner" weight="1"></join>
      </joinList>
