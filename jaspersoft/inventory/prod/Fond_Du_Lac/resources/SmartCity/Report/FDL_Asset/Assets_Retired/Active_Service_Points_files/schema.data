<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.jaspersoft.com/2007/SL/XMLSchema" version="1.3">
  <dataIslands>
    <itemGroup id="ActiveServicePointsComprehensive" label="Active Service Points Comprehensive" resourceId="ActiveServicePointsComprehensive"></itemGroup>
  </dataIslands>
  <dataSources>
    <jdbcDataSource id="FondDuLac_DS">
      <schemaMap>
        <entry key="defaultSchema">
          <string></string>
        </entry>
        <entry key="CISADM">
          <string>CISADM</string>
        </entry>
      </schemaMap>
    </jdbcDataSource>
  </dataSources>
  <itemGroups>
    <itemGroup id="SERVICE_POINT" label="Service Point" resourceId="ActiveServicePointsComprehensive">
      <items>
        <item id="SP_ID" label="Service Point ID" resourceId="ActiveServicePointsComprehensive.SP_ID"></item>
        <item id="SP_TYPE_CD" label="Service Point Type" resourceId="ActiveServicePointsComprehensive.SP_TYPE_CD"></item>
        <item id="SP_STATUS_CD" label="Service Point Status" resourceId="ActiveServicePointsComprehensive.SP_STATUS_CD"></item>
        <item id="SP_STATUS_UPD_DTTM" label="Service Point Status Date/Time" resourceId="ActiveServicePointsComprehensive.SP_STATUS_UPD_DTTM"></item>
        <item id="ADDRESS1" label="Address" resourceId="ActiveServicePointsComprehensive.ADDRESS1"></item>
        <item id="CITY" label="City" resourceId="ActiveServicePointsComprehensive.CITY"></item>
        <item id="STATE" label="State" resourceId="ActiveServicePointsComprehensive.STATE"></item>
        <item id="POSTAL" label="Postal" resourceId="ActiveServicePointsComprehensive.POSTAL"></item>
        <item id="MSRMT_CYC_CD" label="Measurement Cycle" resourceId="ActiveServicePointsComprehensive.MSRMT_CYC_CD"></item>
        <item id="MSRMT_CYC_RTE_CD" label="Measurement Route" resourceId="ActiveServicePointsComprehensive.MSRMT_CYC_RTE_CD"></item>
        <item id="NO_METER_SW" label="No Meter Flag" resourceId="ActiveServicePointsComprehensive.NO_METER_SW"></item>
        <item id="LEGACY_METER_SITE_ID" label="Legacy Meter Site ID" resourceId="ActiveServicePointsComprehensive.LEGACY_METER_SITE_ID"></item>
      </items>
    </itemGroup>
    <itemGroup id="SP_EQUIPMENT" label="Service Point Equipment" resourceId="ActiveServicePointsComprehensive">
      <items>
        <item id="EQ_SP_ID" label="Service Point ID" resourceId="ActiveServicePointsComprehensive.EQ_SP_ID"></item>
        <item id="EQ_DEVICE_ID" label="Device ID" resourceId="ActiveServicePointsComprehensive.EQ_DEVICE_ID"></item>
        <item id="EQ_INSTALL_DTTM" label="Equipment Installation Date/Time" resourceId="ActiveServicePointsComprehensive.EQ_INSTALL_DTTM"></item>
        <item id="EQ_REMOVAL_DTTM" label="Equipment Removal Date/Time" resourceId="ActiveServicePointsComprehensive.EQ_REMOVAL_DTTM"></item>
        <item id="EQPMNT_CNT" label="Equipment Count" resourceId="ActiveServicePointsComprehensive.EQPMNT_CNT"></item>
        <item id="EQ_COMMENTS" label="Equipment Comments" resourceId="ActiveServicePointsComprehensive.EQ_COMMENTS"></item>
      </items>
    </itemGroup>
    <itemGroup id="DEVICE" label="Device" resourceId="ActiveServicePointsComprehensive">
      <items>
        <item id="DEVICE_ID" label="Device ID" resourceId="ActiveServicePointsComprehensive.DEVICE_ID"></item>
        <item id="DEVICE_TYPE_CD" label="Device Type" resourceId="ActiveServicePointsComprehensive.DEVICE_TYPE_CD"></item>
        <item id="DEVICE_BUS_OBJ_CD" label="Device Business Object" resourceId="ActiveServicePointsComprehensive.DEVICE_BUS_OBJ_CD"></item>
        <item id="MANUFACTURER_CD" label="Manufacturer" resourceId="ActiveServicePointsComprehensive.MANUFACTURER_CD"></item>
        <item id="D1_MODEL_CD" label="Model" resourceId="ActiveServicePointsComprehensive.D1_MODEL_CD"></item>
        <item id="D1_SPR_CD" label="Service Provider" resourceId="ActiveServicePointsComprehensive.D1_SPR_CD"></item>
        <item id="DEVICE_STATUS_CD" label="Device Status" resourceId="ActiveServicePointsComprehensive.DEVICE_STATUS_CD"></item>
        <item id="DEVICE_STATUS_REASON_CD" label="Device Status Reason" resourceId="ActiveServicePointsComprehensive.DEVICE_STATUS_REASON_CD"></item>
        <item id="DEVICE_STATUS_UPD_DTTM" label="Device Status Date/Time" resourceId="ActiveServicePointsComprehensive.DEVICE_STATUS_UPD_DTTM"></item>
        <item id="DEVICE_CRE_DTTM" label="Device Create Date/Time" resourceId="ActiveServicePointsComprehensive.DEVICE_CRE_DTTM"></item>
      </items>
    </itemGroup>
    <itemGroup id="DEVICE_CONFIGURATION" label="Device Configuration" resourceId="ActiveServicePointsComprehensive">
      <items>
        <item id="DEVICE_CONFIG_ID" label="Device Configuration ID" resourceId="ActiveServicePointsComprehensive.DEVICE_CONFIG_ID"></item>
        <item id="CFG_DEVICE_ID" label="Device ID" resourceId="ActiveServicePointsComprehensive.CFG_DEVICE_ID"></item>
        <item id="DEVICE_CONFIG_TYPE_CD" label="Device Configuration Type" resourceId="ActiveServicePointsComprehensive.DEVICE_CONFIG_TYPE_CD"></item>
        <item id="CFG_EFF_DTTM" label="Configuration Effective Date/Time" resourceId="ActiveServicePointsComprehensive.CFG_EFF_DTTM"></item>
        <item id="CFG_STATUS_CD" label="Configuration Status" resourceId="ActiveServicePointsComprehensive.CFG_STATUS_CD"></item>
        <item id="CFG_STATUS_UPD_DTTM" label="Configuration Status Date/Time" resourceId="ActiveServicePointsComprehensive.CFG_STATUS_UPD_DTTM"></item>
      </items>
    </itemGroup>
    <itemGroup id="INSTALL_REMOVAL" label="Install and Removal" resourceId="ActiveServicePointsComprehensive">
      <items>
        <item id="INSTALL_EVT_ID" label="Install Event ID" resourceId="ActiveServicePointsComprehensive.INSTALL_EVT_ID"></item>
        <item id="INSTALL_SP_ID" label="Service Point ID" resourceId="ActiveServicePointsComprehensive.INSTALL_SP_ID"></item>
        <item id="INSTALL_DEVICE_CONFIG_ID" label="Device Configuration ID" resourceId="ActiveServicePointsComprehensive.INSTALL_DEVICE_CONFIG_ID"></item>
        <item id="INSTALL_DTTM" label="Installation Date/Time" resourceId="ActiveServicePointsComprehensive.INSTALL_DTTM"></item>
        <item id="REMOVAL_DTTM" label="Removal Date/Time" resourceId="ActiveServicePointsComprehensive.REMOVAL_DTTM"></item>
        <item id="INSTALL_STATUS_CD" label="Install Event Status" resourceId="ActiveServicePointsComprehensive.INSTALL_STATUS_CD"></item>
        <item id="INSTALL_STATUS_UPD_DTTM" label="Install Event Status Date/Time" resourceId="ActiveServicePointsComprehensive.INSTALL_STATUS_UPD_DTTM"></item>
      </items>
    </itemGroup>
  </itemGroups>
  <resources>
    <jdbcQuery id="ActiveServicePointsComprehensive" datasourceId="FondDuLac_DS">
      <fieldList>
        <field id="SP_ID" type="java.lang.String"></field>
        <field id="SP_TYPE_CD" type="java.lang.String"></field>
        <field id="SP_STATUS_CD" type="java.lang.String"></field>
        <field id="SP_STATUS_UPD_DTTM" type="java.sql.Timestamp"></field>
        <field id="ADDRESS1" type="java.lang.String"></field>
        <field id="CITY" type="java.lang.String"></field>
        <field id="STATE" type="java.lang.String"></field>
        <field id="POSTAL" type="java.lang.String"></field>
        <field id="MSRMT_CYC_CD" type="java.lang.String"></field>
        <field id="MSRMT_CYC_RTE_CD" type="java.lang.String"></field>
        <field id="NO_METER_SW" type="java.lang.String"></field>
        <field id="LEGACY_METER_SITE_ID" type="java.lang.String"></field>
        <field id="EQ_SP_ID" type="java.lang.String"></field>
        <field id="EQ_DEVICE_ID" type="java.lang.String"></field>
        <field id="EQ_INSTALL_DTTM" type="java.sql.Timestamp"></field>
        <field id="EQ_REMOVAL_DTTM" type="java.sql.Timestamp"></field>
        <field id="EQPMNT_CNT" type="java.math.BigDecimal"></field>
        <field id="EQ_COMMENTS" type="java.lang.String"></field>
        <field id="DEVICE_ID" type="java.lang.String"></field>
        <field id="DEVICE_TYPE_CD" type="java.lang.String"></field>
        <field id="DEVICE_BUS_OBJ_CD" type="java.lang.String"></field>
        <field id="MANUFACTURER_CD" type="java.lang.String"></field>
        <field id="D1_MODEL_CD" type="java.lang.String"></field>
        <field id="D1_SPR_CD" type="java.lang.String"></field>
        <field id="DEVICE_STATUS_CD" type="java.lang.String"></field>
        <field id="DEVICE_STATUS_REASON_CD" type="java.lang.String"></field>
        <field id="DEVICE_STATUS_UPD_DTTM" type="java.sql.Timestamp"></field>
        <field id="DEVICE_CRE_DTTM" type="java.sql.Timestamp"></field>
        <field id="DEVICE_CONFIG_ID" type="java.lang.String"></field>
        <field id="CFG_DEVICE_ID" type="java.lang.String"></field>
        <field id="DEVICE_CONFIG_TYPE_CD" type="java.lang.String"></field>
        <field id="CFG_EFF_DTTM" type="java.sql.Timestamp"></field>
        <field id="CFG_STATUS_CD" type="java.lang.String"></field>
        <field id="CFG_STATUS_UPD_DTTM" type="java.sql.Timestamp"></field>
        <field id="INSTALL_EVT_ID" type="java.lang.String"></field>
        <field id="INSTALL_SP_ID" type="java.lang.String"></field>
        <field id="INSTALL_DEVICE_CONFIG_ID" type="java.lang.String"></field>
        <field id="INSTALL_DTTM" type="java.sql.Timestamp"></field>
        <field id="REMOVAL_DTTM" type="java.sql.Timestamp"></field>
        <field id="INSTALL_STATUS_CD" type="java.lang.String"></field>
        <field id="INSTALL_STATUS_UPD_DTTM" type="java.sql.Timestamp"></field>
      </fieldList>
      <query>SELECT
    sp.d1_sp_id AS sp_id,
    sp.d1_sp_type_cd AS sp_type_cd,
    sp.bo_status_cd AS sp_status_cd,
    sp.status_upd_dttm AS sp_status_upd_dttm,
    sp.address1,
    sp.city,
    sp.state,
    sp.postal,
    sp.msrmt_cyc_cd,
    sp.msrmt_cyc_rte_cd,
    CASE
        WHEN spe.d1_sp_id IS NULL THEN 'Y'
        ELSE 'N'
    END AS no_meter_sw,
    mtr.adhoc_char_val AS legacy_meter_site_id,
    spe.d1_sp_id AS eq_sp_id,
    spe.d1_device_id AS eq_device_id,
    spe.d1_install_dttm AS eq_install_dttm,
    spe.d1_removal_dttm AS eq_removal_dttm,
    spe.eqpmnt_cnt,
    spe.comments AS eq_comments,
    dvc.d1_device_id AS device_id,
    dvc.device_type_cd,
    dvc.bus_obj_cd AS device_bus_obj_cd,
    dvc.manufacturer_cd,
    dvc.d1_model_cd,
    dvc.d1_spr_cd,
    dvc.bo_status_cd AS device_status_cd,
    dvc.bo_status_reason_cd AS device_status_reason_cd,
    dvc.status_upd_dttm AS device_status_upd_dttm,
    dvc.cre_dttm AS device_cre_dttm,
    cfg.device_config_id,
    cfg.d1_device_id AS cfg_device_id,
    cfg.device_config_type_cd,
    cfg.eff_dttm AS cfg_eff_dttm,
    cfg.bo_status_cd AS cfg_status_cd,
    cfg.status_upd_dttm AS cfg_status_upd_dttm,
    ie.install_evt_id,
    ie.d1_sp_id AS install_sp_id,
    ie.device_config_id AS install_device_config_id,
    ie.d1_install_dttm AS install_dttm,
    ie.d1_removal_dttm AS removal_dttm,
    ie.bo_status_cd AS install_status_cd,
    ie.status_upd_dttm AS install_status_upd_dttm
FROM cisadm.d1_sp sp
LEFT JOIN (
    SELECT
        d1_sp_id,
        MAX(adhoc_char_val) AS adhoc_char_val
    FROM cisadm.d1_sp_char
    WHERE char_type_cd = 'C2M-MLID'
    GROUP BY d1_sp_id
) mtr
    ON mtr.d1_sp_id = sp.d1_sp_id
LEFT JOIN cisadm.d1_sp_eqpmnt spe
    ON spe.d1_sp_id = sp.d1_sp_id
LEFT JOIN cisadm.d1_dvc dvc
    ON dvc.d1_device_id = spe.d1_device_id
LEFT JOIN cisadm.d1_dvc_cfg cfg
    ON cfg.d1_device_id = spe.d1_device_id
LEFT JOIN cisadm.d1_install_evt ie
    ON ie.device_config_id = cfg.device_config_id
   AND ie.d1_sp_id = sp.d1_sp_id</query>
    </jdbcQuery>
  </resources>
</schema>
