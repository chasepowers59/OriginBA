        <field id="FINAL_DTTM" type="java.sql.Timestamp"></field>
        <field id="IN_SERVICE_DT" type="java.sql.Timestamp"></field>
        <field id="PREDCTD_WEAR_OUT_DT" type="java.sql.Timestamp"></field>
        <field id="D1_DEVICE_ID_FROM_ASSET" type="java.lang.String"></field>
        <field id="BO_DATA_AREA" type="java.lang.String"></field>
      </fieldList>
      <query>SELECT
    a.asset_id,
    a.asset_type_cd,
    a.bus_obj_cd,
    a.bo_status_cd,
    a.status_upd_dttm,
    a.bo_status_reason_cd,
    a.cre_dttm,
    a.final_dttm,
    a.in_service_dt,
    a.predctd_wear_out_dt,
    EXTRACTVALUE(XMLTYPE(CONCAT(CONCAT('&lt;root&gt;', a.bo_data_area), '&lt;/root&gt;')), 'root/c2mDeviceId') AS d1_device_id_from_asset,
    DBMS_LOB.SUBSTR(a.bo_data_area, 4000, 1) AS bo_data_area
FROM cisadm.w1_asset a</query>
    </jdbcQuery>
    <jdbcQuery id="ASSET_DEVICE_IDENTIFIER_LINK" datasourceId="FondDuLac_DS">
      <fieldList>
        <field id="ASSET_ID" type="java.lang.String"></field>
        <field id="D1_DEVICE_ID" type="java.lang.String"></field>
        <field id="MATCHED_IDENTIFIER_VALUE" type="java.lang.String"></field>
        <field id="MATCHED_ASSET_IDENTIFIER_TYPE" type="java.lang.String"></field>
        <field id="MATCHED_DEVICE_IDENTIFIER_TYPE" type="java.lang.String"></field>
      </fieldList>
      <query>SELECT
    AI.ASSET_ID,
    MIN(DI.D1_DEVICE_ID) AS D1_DEVICE_ID,
    MIN(AI.W1_ID_VALUE) AS MATCHED_IDENTIFIER_VALUE,
    MIN(AI.ASSET_ID_TYPE_FLG) AS MATCHED_ASSET_IDENTIFIER_TYPE,
    MIN(DI.DVC_ID_TYPE_FLG) AS MATCHED_DEVICE_IDENTIFIER_TYPE
FROM CISADM.W1_ASSET_IDENTIFIER AI
JOIN CISADM.D1_DVC_IDENTIFIER DI
    ON DI.ID_VALUE = AI.W1_ID_VALUE
   AND (
        (AI.ASSET_ID_TYPE_FLG = 'W1BN' AND DI.DVC_ID_TYPE_FLG = 'D1BN')
     OR (AI.ASSET_ID_TYPE_FLG = 'W1SN' AND DI.DVC_ID_TYPE_FLG = 'D1SN')
     OR (AI.ASSET_ID_TYPE_FLG = 'W1EI' AND DI.DVC_ID_TYPE_FLG = 'D1AS')
   )
GROUP BY AI.ASSET_ID</query>
    </jdbcQuery>
    <jdbcQuery id="ASSET_SP_EQUIPMENT_LINK" datasourceId="FondDuLac_DS">
      <fieldList>
        <field id="ID_VALUE" type="java.lang.String"></field>
        <field id="SP_ID_TYPE_FLG" type="java.lang.String"></field>
        <field id="D1_SP_ID" type="java.lang.String"></field>
        <field id="D1_DEVICE_ID" type="java.lang.String"></field>
        <field id="D1_INSTALL_DTTM" type="java.sql.Timestamp"></field>
        <field id="D1_REMOVAL_DTTM" type="java.sql.Timestamp"></field>
        <field id="EQPMNT_CNT" type="java.math.BigDecimal"></field>
        <field id="COMMENTS" type="java.lang.String"></field>
        <field id="VERSION" type="java.math.BigDecimal"></field>
      </fieldList>
      <query>SELECT
    SPID.ID_VALUE,
    SPID.SP_ID_TYPE_FLG,
    SPE.D1_SP_ID,
    SPE.D1_DEVICE_ID,
    SPE.D1_INSTALL_DTTM,
    SPE.D1_REMOVAL_DTTM,
    SPE.EQPMNT_CNT,
    SPE.COMMENTS,
    SPE.VERSION
FROM CISADM.D1_SP_IDENTIFIER SPID
JOIN CISADM.D1_SP_EQPMNT SPE
    ON SPE.D1_SP_ID = SPID.D1_SP_ID
WHERE SPID.SP_ID_TYPE_FLG = 'D1OI'</query>
    </jdbcQuery>
    <jdbcQuery id="D1_DVC" datasourceId="FondDuLac_DS">
      <fieldList>
        <field id="D1_DEVICE_ID" type="java.lang.String"></field>
        <field id="DEVICE_TYPE_CD" type="java.lang.String"></field>
        <field id="BUS_OBJ_CD" type="java.lang.String"></field>
        <field id="MANUFACTURER_CD" type="java.lang.String"></field>
        <field id="D1_MODEL_CD" type="java.lang.String"></field>
        <field id="D1_SPR_CD" type="java.lang.String"></field>
        <field id="BO_STATUS_CD" type="java.lang.String"></field>
        <field id="BO_STATUS_REASON_CD" type="java.lang.String"></field>
        <field id="STATUS_UPD_DTTM" type="java.sql.Timestamp"></field>
        <field id="CRE_DTTM" type="java.sql.Timestamp"></field>
        <field id="RETIREMENT_DTTM" type="java.sql.Timestamp"></field>
        <field id="RETIREMENT_DTTM_RAW" type="java.lang.String"></field>
        <field id="BO_DATA_AREA" type="java.lang.String"></field>
      </fieldList>
      <query>SELECT
    d.d1_device_id,
    d.device_type_cd,
    d.bus_obj_cd,
    d.manufacturer_cd,
    d.d1_model_cd,
    d.d1_spr_cd,
    d.bo_status_cd,
    d.bo_status_reason_cd,
    d.status_upd_dttm,
    d.cre_dttm,
    CASE
        WHEN DBMS_LOB.INSTR(d.bo_data_area, '&lt;retirementDateTime&gt;') &gt; 0
        THEN TO_TIMESTAMP(
            REGEXP_SUBSTR(
                DBMS_LOB.SUBSTR(d.bo_data_area, 500, DBMS_LOB.INSTR(d.bo_data_area, '&lt;retirementDateTime&gt;')),
                '&lt;retirementDateTime&gt;([^&lt;]+)&lt;/retirementDateTime&gt;',
                1,
                1,
                NULL,
                1
            ),
            'YYYY-MM-DD-HH24.MI.SS'
        )
    END AS retirement_dttm,
    CASE
        WHEN DBMS_LOB.INSTR(d.bo_data_area, '&lt;retirementDateTime&gt;') &gt; 0
        THEN REGEXP_SUBSTR(
            DBMS_LOB.SUBSTR(d.bo_data_area, 500, DBMS_LOB.INSTR(d.bo_data_area, '&lt;retirementDateTime&gt;')),
            '&lt;retirementDateTime&gt;([^&lt;]+)&lt;/retirementDateTime&gt;',
            1,
            1,
            NULL,
            1
        )
    END AS retirement_dttm_raw,
    DBMS_LOB.SUBSTR(d.bo_data_area, 4000, 1) AS bo_data_area
FROM cisadm.d1_dvc d</query>
    </jdbcQuery>
    <jdbcQuery id="D1_DVC_BODA" datasourceId="FondDuLac_DS">
      <fieldList>
        <field id="D1_DEVICE_ID" type="java.lang.String"></field>
        <field id="BUS_OBJ_CD" type="java.lang.String"></field>
        <field id="STATUS" type="java.lang.String"></field>
        <field id="RETIREMENT_DTTM" type="java.sql.Timestamp"></field>
        <field id="RETIREMENT_DTTM_RAW" type="java.lang.String"></field>
      </fieldList>
      <query>SELECT
    DVC.D1_DEVICE_ID,
    MIN(DVC.BUS_OBJ_CD) AS BUS_OBJ_CD,
    CAST(MIN(EXTRACTVALUE(XMLTYPE(CONCAT(CONCAT('&lt;root&gt;', DVC.BO_DATA_AREA), '&lt;/root&gt;')), 'root/latestBoStatus')) AS CHAR(12)) AS STATUS,
    MIN(TO_DATE(EXTRACTVALUE(XMLTYPE(CONCAT(CONCAT('&lt;root&gt;', DVC.BO_DATA_AREA), '&lt;/root&gt;')), 'root/retirementDateTime'), 'YYYY-MM-DD-HH24.MI.SS')) AS RETIREMENT_DTTM,
    MIN(EXTRACTVALUE(XMLTYPE(CONCAT(CONCAT('&lt;root&gt;', DVC.BO_DATA_AREA), '&lt;/root&gt;')), 'root/retirementDateTime')) AS RETIREMENT_DTTM_RAW
FROM CISADM.D1_DVC DVC
WHERE DVC.BO_DATA_AREA IS NOT NULL
GROUP BY DVC.D1_DEVICE_ID</query>
    </jdbcQuery>
    <jdbcQuery id="ACCOUNT_ADDRESS_SOURCE" datasourceId="FondDuLac_DS">
      <fieldList>
        <field id="D1_DEVICE_ID" type="java.lang.String"></field>
        <field id="D1_SP_ID" type="java.lang.String"></field>
        <field id="INSTALL_EVT_ID" type="java.lang.String"></field>
        <field id="D1_INSTALL_DTTM" type="java.sql.Timestamp"></field>
        <field id="D1_REMOVAL_DTTM" type="java.sql.Timestamp"></field>
        <field id="PREM_ID" type="java.lang.String"></field>
        <field id="SA_ID" type="java.lang.String"></field>
        <field id="SA_STATUS_FLG" type="java.lang.String"></field>
        <field id="ACCT_ID" type="java.lang.String"></field>
        <field id="PER_ID" type="java.lang.String"></field>
        <field id="MAIN_CUST_SW" type="java.lang.String"></field>
        <field id="FIN_RESP_SW" type="java.lang.String"></field>
        <field id="BILL_ADDR_SRCE_FLG" type="java.lang.String"></field>
        <field id="BILL_RTE_TYPE_CD" type="java.lang.String"></field>
        <field id="BILL_FORMAT_FLG" type="java.lang.String"></field>
        <field id="ACCOUNT_ACCT_ID" type="java.lang.String"></field>
        <field id="ACCOUNT_BILL_CYC_CD" type="java.lang.String"></field>
        <field id="ACCOUNT_SETUP_DT" type="java.sql.Timestamp"></field>
        <field id="ACCOUNT_CURRENCY_CD" type="java.lang.String"></field>
        <field id="ACCOUNT_ACCT_MGMT_GRP_CD" type="java.lang.String"></field>
        <field id="ACCOUNT_ALERT_INFO" type="java.lang.String"></field>
        <field id="ACCOUNT_BILL_AFTER_DT" type="java.sql.Timestamp"></field>
        <field id="ACCOUNT_PROTECT_CYC_SW" type="java.lang.String"></field>
        <field id="ACCOUNT_CIS_DIVISION" type="java.lang.String"></field>
        <field id="ACCOUNT_MAILING_PREM_ID" type="java.lang.String"></field>
        <field id="ACCOUNT_PROTECT_PREM_SW" type="java.lang.String"></field>
        <field id="ACCOUNT_COLL_CL_CD" type="java.lang.String"></field>
        <field id="ACCOUNT_CR_REVIEW_DT" type="java.sql.Timestamp"></field>
        <field id="ACCOUNT_POSTPONE_CR_RVW_DT" type="java.sql.Timestamp"></field>
        <field id="ACCOUNT_INT_CR_REVIEW_SW" type="java.lang.String"></field>
        <field id="ACCOUNT_CUST_CL_CD" type="java.lang.String"></field>
        <field id="ACCOUNT_BILL_PRT_INTERCEPT" type="java.lang.String"></field>
        <field id="ACCOUNT_NO_DEP_RVW_SW" type="java.lang.String"></field>
        <field id="ACCOUNT_BUD_PLAN_CD" type="java.lang.String"></field>
        <field id="ACCOUNT_VERSION" type="java.math.BigDecimal"></field>
        <field id="ACCOUNT_PROTECT_DIV_SW" type="java.lang.String"></field>
        <field id="ACCOUNT_ACCESS_GRP_CD" type="java.lang.String"></field>
        <field id="ACCOUNT_ACCT_DATA_AREA" type="java.lang.String"></field>
      </fieldList>
      <query>SELECT
    DSP.D1_DEVICE_ID,
    DSP.D1_SP_ID,
    DSP.INSTALL_EVT_ID,
    DSP.D1_INSTALL_DTTM,
    DSP.D1_REMOVAL_DTTM,
    SP.PREM_ID,
    PA.SA_ID,
    PA.SA_STATUS_FLG,
    PA.ACCT_ID,
    AP.PER_ID,
    AP.MAIN_CUST_SW,
    AP.FIN_RESP_SW,
    AP.BILL_ADDR_SRCE_FLG,
    AP.BILL_RTE_TYPE_CD,
    AP.BILL_FORMAT_FLG,
    AC.ACCT_ID AS ACCOUNT_ACCT_ID,
    AC.BILL_CYC_CD AS ACCOUNT_BILL_CYC_CD,
    AC.SETUP_DT AS ACCOUNT_SETUP_DT,
    AC.CURRENCY_CD AS ACCOUNT_CURRENCY_CD,
    AC.ACCT_MGMT_GRP_CD AS ACCOUNT_ACCT_MGMT_GRP_CD,
    AC.ALERT_INFO AS ACCOUNT_ALERT_INFO,
    AC.BILL_AFTER_DT AS ACCOUNT_BILL_AFTER_DT,
    AC.PROTECT_CYC_SW AS ACCOUNT_PROTECT_CYC_SW,
    AC.CIS_DIVISION AS ACCOUNT_CIS_DIVISION,
    AC.MAILING_PREM_ID AS ACCOUNT_MAILING_PREM_ID,
    AC.PROTECT_PREM_SW AS ACCOUNT_PROTECT_PREM_SW,
    AC.COLL_CL_CD AS ACCOUNT_COLL_CL_CD,
    AC.CR_REVIEW_DT AS ACCOUNT_CR_REVIEW_DT,
    AC.POSTPONE_CR_RVW_DT AS ACCOUNT_POSTPONE_CR_RVW_DT,
    AC.INT_CR_REVIEW_SW AS ACCOUNT_INT_CR_REVIEW_SW,
    AC.CUST_CL_CD AS ACCOUNT_CUST_CL_CD,
    AC.BILL_PRT_INTERCEPT AS ACCOUNT_BILL_PRT_INTERCEPT,
    AC.NO_DEP_RVW_SW AS ACCOUNT_NO_DEP_RVW_SW,
    AC.BUD_PLAN_CD AS ACCOUNT_BUD_PLAN_CD,
    AC.VERSION AS ACCOUNT_VERSION,
    AC.PROTECT_DIV_SW AS ACCOUNT_PROTECT_DIV_SW,
    AC.ACCESS_GRP_CD AS ACCOUNT_ACCESS_GRP_CD,
    DBMS_LOB.SUBSTR(AC.ACCT_DATA_AREA, 4000, 1) AS ACCOUNT_ACCT_DATA_AREA
FROM (
    SELECT *
    FROM (
        SELECT
            SPE.D1_DEVICE_ID,
            SPE.D1_SP_ID,
            IE.INSTALL_EVT_ID,
            SPE.D1_INSTALL_DTTM,
            SPE.D1_REMOVAL_DTTM,
            ROW_NUMBER() OVER (
                PARTITION BY SPE.D1_DEVICE_ID, SPE.D1_SP_ID
                ORDER BY
                    CASE WHEN SPE.D1_REMOVAL_DTTM IS NULL THEN 1 ELSE 2 END,
                    SPE.D1_INSTALL_DTTM DESC,
                    IE.INSTALL_EVT_ID
            ) AS INSTALL_RANK
        FROM CISADM.D1_SP_EQPMNT SPE
        LEFT JOIN CISADM.D1_DVC_CFG DC
            ON DC.D1_DEVICE_ID = SPE.D1_DEVICE_ID
        LEFT JOIN CISADM.D1_INSTALL_EVT IE
            ON IE.DEVICE_CONFIG_ID = DC.DEVICE_CONFIG_ID
           AND IE.D1_SP_ID = SPE.D1_SP_ID
    )
    WHERE INSTALL_RANK = 1
) DSP
LEFT JOIN (
    SELECT
        SPID.D1_SP_ID,
        SPID.ID_VALUE AS PREM_ID
    FROM CISADM.D1_SP_IDENTIFIER SPID
    WHERE SPID.SP_ID_TYPE_FLG = 'D1EP'
) SP
    ON SP.D1_SP_ID = DSP.D1_SP_ID
LEFT JOIN (
    SELECT *
    FROM (
        SELECT
            SA.CHAR_PREM_ID AS PREM_ID,
            SA.ACCT_ID,
            SA.SA_ID,
            SA.SA_STATUS_FLG,
            ROW_NUMBER() OVER (
                PARTITION BY SA.CHAR_PREM_ID
                ORDER BY
                    CASE WHEN SA.SA_STATUS_FLG IN ('20', '30') THEN 1 ELSE 2 END,
                    SA.START_DT DESC,
                    SA.SA_ID
            ) AS SA_RANK
        FROM CISADM.CI_SA SA
        WHERE SA.CHAR_PREM_ID IS NOT NULL
    )
    WHERE SA_RANK = 1
) PA
    ON PA.PREM_ID = SP.PREM_ID
LEFT JOIN CISADM.CI_ACCT AC
    ON AC.ACCT_ID = PA.ACCT_ID
LEFT JOIN (
    SELECT *
    FROM (
        SELECT
            AP.ACCT_ID,
            AP.PER_ID,
            AP.MAIN_CUST_SW,
            AP.FIN_RESP_SW,
            AP.BILL_ADDR_SRCE_FLG,
            AP.BILL_RTE_TYPE_CD,
            AP.BILL_FORMAT_FLG,
            ROW_NUMBER() OVER (
                PARTITION BY AP.ACCT_ID
                ORDER BY
                    CASE WHEN AP.MAIN_CUST_SW = 'Y' THEN 1 ELSE 2 END,
                    CASE WHEN AP.FIN_RESP_SW = 'Y' THEN 1 ELSE 2 END,
                    AP.PER_ID
            ) AS ACCT_PER_RANK
        FROM CISADM.CI_ACCT_PER AP
    )
    WHERE ACCT_PER_RANK = 1
) AP
    ON AP.ACCT_ID = PA.ACCT_ID</query>
    </jdbcQuery>
    <jdbcQuery id="SC_SP_MTR_LOC" datasourceId="FondDuLac_DS">
      <fieldList>
        <field id="D1_SP_ID" type="java.lang.String"></field>
        <field id="ADHOC_CHAR_VAL" type="java.lang.String"></field>
