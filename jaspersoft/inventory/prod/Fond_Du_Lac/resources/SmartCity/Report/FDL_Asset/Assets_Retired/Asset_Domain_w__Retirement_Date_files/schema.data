        <field id="ACCOUNT_ADDRESS_SOURCE.ACCOUNT_MAILING_PREM_ID" type="java.lang.String"></field>
        <field id="ACCOUNT_ADDRESS_SOURCE.ACCOUNT_PROTECT_PREM_SW" type="java.lang.String"></field>
        <field id="ACCOUNT_ADDRESS_SOURCE.ACCOUNT_COLL_CL_CD" type="java.lang.String"></field>
        <field id="ACCOUNT_ADDRESS_SOURCE.ACCOUNT_CR_REVIEW_DT" type="java.sql.Timestamp"></field>
        <field id="ACCOUNT_ADDRESS_SOURCE.ACCOUNT_POSTPONE_CR_RVW_DT" type="java.sql.Timestamp"></field>
        <field id="ACCOUNT_ADDRESS_SOURCE.ACCOUNT_INT_CR_REVIEW_SW" type="java.lang.String"></field>
        <field id="ACCOUNT_ADDRESS_SOURCE.ACCOUNT_CUST_CL_CD" type="java.lang.String"></field>
        <field id="ACCOUNT_ADDRESS_SOURCE.ACCOUNT_BILL_PRT_INTERCEPT" type="java.lang.String"></field>
        <field id="ACCOUNT_ADDRESS_SOURCE.ACCOUNT_NO_DEP_RVW_SW" type="java.lang.String"></field>
        <field id="ACCOUNT_ADDRESS_SOURCE.ACCOUNT_BUD_PLAN_CD" type="java.lang.String"></field>
        <field id="ACCOUNT_ADDRESS_SOURCE.ACCOUNT_VERSION" type="java.math.BigDecimal"></field>
        <field id="ACCOUNT_ADDRESS_SOURCE.ACCOUNT_PROTECT_DIV_SW" type="java.lang.String"></field>
