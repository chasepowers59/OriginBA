        <field id="ACCOUNT_ADDRESS_SOURCE.ACCOUNT_ACCT_ID" type="java.lang.String"></field>
        <field id="ACCOUNT_ADDRESS_SOURCE.ACCOUNT_BILL_CYC_CD" type="java.lang.String"></field>
        <field id="ACCOUNT_ADDRESS_SOURCE.ACCOUNT_SETUP_DT" type="java.sql.Timestamp"></field>
        <field id="ACCOUNT_ADDRESS_SOURCE.ACCOUNT_CURRENCY_CD" type="java.lang.String"></field>
        <field id="ACCOUNT_ADDRESS_SOURCE.ACCOUNT_ACCT_MGMT_GRP_CD" type="java.lang.String"></field>
        <field id="ACCOUNT_ADDRESS_SOURCE.ACCOUNT_ALERT_INFO" type="java.lang.String"></field>
        <field id="ACCOUNT_ADDRESS_SOURCE.ACCOUNT_BILL_AFTER_DT" type="java.sql.Timestamp"></field>
