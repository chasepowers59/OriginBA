        <field id="ACCOUNT_ADDRESS_SOURCE.ACCOUNT_ACCT_DATA_AREA" type="java.lang.String"></field>
        <field id="D1_SP_EQPMNT.D1_SP_ID" type="java.lang.String"></field>
        <field id="D1_SP_EQPMNT.D1_DEVICE_ID" type="java.lang.String"></field>
        <field id="D1_SP_EQPMNT.D1_INSTALL_DTTM" type="java.sql.Timestamp"></field>
        <field id="D1_SP_EQPMNT.D1_REMOVAL_DTTM" type="java.sql.Timestamp"></field>
        <field id="D1_SP_EQPMNT.EQPMNT_CNT" type="java.math.BigDecimal"></field>
        <field id="D1_SP_EQPMNT.COMMENTS" type="java.lang.String"></field>
        <field id="ASSET_DEVICE_IDENTIFIER_LINK.ASSET_ID" type="java.lang.String"></field>
        <field id="ASSET_DEVICE_IDENTIFIER_LINK.D1_DEVICE_ID" type="java.lang.String"></field>
        <field id="ASSET_DEVICE_IDENTIFIER_LINK.MATCHED_IDENTIFIER_VALUE" type="java.lang.String"></field>
        <field id="ASSET_DEVICE_IDENTIFIER_LINK.MATCHED_ASSET_IDENTIFIER_TYPE" type="java.lang.String"></field>
        <field id="ASSET_DEVICE_IDENTIFIER_LINK.MATCHED_DEVICE_IDENTIFIER_TYPE" type="java.lang.String"></field>
        <field id="W1_ASSET_IDENTIFIER.ASSET_ID" type="java.lang.String"></field>
        <field id="W1_ASSET_IDENTIFIER.ASSET_ID_TYPE_FLG" type="java.lang.String"></field>
        <field id="W1_ASSET_IDENTIFIER.W1_ID_VALUE" type="java.lang.String"></field>
      </fieldList>
      <joinInfo alias="W1_ASSET" referenceId="W1_ASSET"></joinInfo>
      <joinList>
        <join expr="W1_ASSET.ASSET_ID == W1_ASSET_IDENTIFIER.ASSET_ID" left="W1_ASSET" right="W1_ASSET_IDENTIFIER" type="leftOuter" weight="1"></join>
        <join expr="W1_ASSET.ASSET_ID == W1_ASSET_NODE.ASSET_ID" left="W1_ASSET" right="W1_ASSET_NODE" type="leftOuter" weight="1"></join>
        <join expr="W1_ASSET.ASSET_ID == ASSET_DEVICE_IDENTIFIER_LINK.ASSET_ID" left="W1_ASSET" right="ASSET_DEVICE_IDENTIFIER_LINK" type="leftOuter" weight="1"></join>
        <join expr="W1_ASSET_NODE.NODE_ID == ASSET_SP_EQUIPMENT_LINK.ID_VALUE" left="W1_ASSET_NODE" right="ASSET_SP_EQUIPMENT_LINK" type="leftOuter" weight="1"></join>
        <join expr="ASSET_DEVICE_IDENTIFIER_LINK.D1_DEVICE_ID == D1_DVC.D1_DEVICE_ID" left="ASSET_DEVICE_IDENTIFIER_LINK" right="D1_DVC" type="leftOuter" weight="1"></join>
        <join expr="ASSET_DEVICE_IDENTIFIER_LINK.D1_DEVICE_ID == D1_DVC_BODA.D1_DEVICE_ID" left="ASSET_DEVICE_IDENTIFIER_LINK" right="D1_DVC_BODA" type="leftOuter" weight="1"></join>
        <join expr="D1_DVC.D1_DEVICE_ID == D1_DVC_IDENTIFIER.D1_DEVICE_ID" left="D1_DVC" right="D1_DVC_IDENTIFIER" type="leftOuter" weight="1"></join>
        <join expr="D1_DVC.D1_DEVICE_ID == D1_DVC_CFG.D1_DEVICE_ID" left="D1_DVC" right="D1_DVC_CFG" type="leftOuter" weight="1"></join>
        <join expr="D1_DVC_CFG.DEVICE_CONFIG_ID == D1_INSTALL_EVT.DEVICE_CONFIG_ID" left="D1_DVC_CFG" right="D1_INSTALL_EVT" type="leftOuter" weight="1"></join>
        <join expr="D1_DVC.D1_DEVICE_ID == D1_SP_EQPMNT.D1_DEVICE_ID" left="D1_DVC" right="D1_SP_EQPMNT" type="leftOuter" weight="1"></join>
        <join expr="D1_SP_EQPMNT.D1_SP_ID == D1_SP.D1_SP_ID" left="D1_SP_EQPMNT" right="D1_SP" type="leftOuter" weight="1"></join>
        <join expr="D1_SP_EQPMNT.D1_DEVICE_ID == ACCOUNT_ADDRESS_SOURCE.D1_DEVICE_ID and D1_SP_EQPMNT.D1_SP_ID == ACCOUNT_ADDRESS_SOURCE.D1_SP_ID" left="D1_SP_EQPMNT" right="ACCOUNT_ADDRESS_SOURCE" type="leftOuter" weight="1"></join>
        <join expr="D1_SP_EQPMNT.D1_SP_ID == SC_SP_MTR_LOC.D1_SP_ID" left="D1_SP_EQPMNT" right="SC_SP_MTR_LOC" type="leftOuter" weight="1"></join>
      </joinList>
      <joinOptions></joinOptions>
      <query>SELECT
    a.asset_id,
    a.asset_type_cd,
    a.bus_obj_cd,
    a.bo_status_cd,
    a.status_upd_dttm,
    a.bo_status_reason_cd,
    a.cre_dttm,
    a.final_dttm,
    a.in_service_dt,
    a.predctd_wear_out_dt,
    EXTRACTVALUE(XMLTYPE(CONCAT(CONCAT('&lt;root&gt;', a.bo_data_area), '&lt;/root&gt;')), 'root/c2mDeviceId') AS d1_device_id_from_asset,
    DBMS_LOB.SUBSTR(a.bo_data_area, 4000, 1) AS bo_data_area
FROM cisadm.w1_asset a</query>
      <tableRefList>
        <tableRef alwaysIncludeTable="false" tableAlias="W1_ASSET_IDENTIFIER" tableId="W1_ASSET_IDENTIFIER"></tableRef>
        <tableRef alwaysIncludeTable="false" tableAlias="D1_DVC_BODA" tableId="D1_DVC_BODA"></tableRef>
        <tableRef alwaysIncludeTable="false" tableAlias="W1_ASSET" tableId="W1_ASSET"></tableRef>
        <tableRef alwaysIncludeTable="false" tableAlias="D1_DVC_CFG" tableId="D1_DVC_CFG"></tableRef>
        <tableRef alwaysIncludeTable="false" tableAlias="ASSET_DEVICE_IDENTIFIER_LINK" tableId="ASSET_DEVICE_IDENTIFIER_LINK"></tableRef>
        <tableRef alwaysIncludeTable="false" tableAlias="ASSET_SP_EQUIPMENT_LINK" tableId="ASSET_SP_EQUIPMENT_LINK"></tableRef>
        <tableRef alwaysIncludeTable="false" tableAlias="D1_SP_EQPMNT" tableId="D1_SP_EQPMNT"></tableRef>
        <tableRef alwaysIncludeTable="false" tableAlias="W1_ASSET_NODE" tableId="W1_ASSET_NODE"></tableRef>
        <tableRef alwaysIncludeTable="false" tableAlias="D1_DVC" tableId="D1_DVC"></tableRef>
        <tableRef alwaysIncludeTable="false" tableAlias="SC_SP_MTR_LOC" tableId="SC_SP_MTR_LOC"></tableRef>
        <tableRef alwaysIncludeTable="false" tableAlias="D1_INSTALL_EVT" tableId="D1_INSTALL_EVT"></tableRef>
        <tableRef alwaysIncludeTable="false" tableAlias="D1_DVC_IDENTIFIER" tableId="D1_DVC_IDENTIFIER"></tableRef>
        <tableRef alwaysIncludeTable="false" tableAlias="D1_SP" tableId="D1_SP"></tableRef>
        <tableRef alwaysIncludeTable="false" tableAlias="ACCOUNT_ADDRESS_SOURCE" tableId="ACCOUNT_ADDRESS_SOURCE"></tableRef>
      </tableRefList>
    </jdbcQuery>
  </resources>
</schema>
