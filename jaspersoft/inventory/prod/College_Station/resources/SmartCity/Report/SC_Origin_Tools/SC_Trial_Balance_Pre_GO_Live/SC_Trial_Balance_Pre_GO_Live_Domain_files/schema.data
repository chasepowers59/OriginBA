  <resources>
    <jdbcQuery id="SC_TRIAL_BAL_TOTAL" datasourceId="CollegeStation_DS_1">
      <fieldList>
        <field id="DST_ID" type="java.lang.String"></field>
        <field id="DESCR" type="java.lang.String"></field>
        <field id="SUM_FT_CUR_AMT_" fieldDBName="SUM(FT.CUR_AMT)" type="java.math.BigDecimal"></field>
        <field id="SUM_FT_TOT_AMT_" fieldDBName="SUM(FT.TOT_AMT)" type="java.math.BigDecimal"></field>
      </fieldList>
      <query>select DCL.DST_ID, DCL.DESCR,
    SUM(FT.CUR_AMT), SUM(FT.TOT_AMT) from cisadm.ci_ft FT, cisadm.CI_SA sa, cisadm.ci_sa_type SAT, cisadm.CI_DST_CODE_L DCL
    where FT.SA_ID = SA.SA_ID
          and SA.SA_TYPE_CD = SAT.SA_TYPE_CD
          and SAT.DST_ID = DCL.DST_ID
    group by DCL.DST_ID, DCL.DESCR</query>
    </jdbcQuery>
    <jdbcQuery id="SC_TRIAL_BALANCE_0_15" datasourceId="CollegeStation_DS_1">
      <fieldList>
        <field id="DST_ID" type="java.lang.String"></field>
        <field id="DESCR" type="java.lang.String"></field>
        <field id="SUM_FT_CUR_AMT__1" fieldDBName="SUM(FT.CUR_AMT)" type="java.math.BigDecimal"></field>
        <field id="SUM_FT_TOT_AMT__2" fieldDBName="SUM(FT.TOT_AMT)" type="java.math.BigDecimal"></field>
      </fieldList>
      <query>select DCL.DST_ID, DCL.DESCR,
    SUM(FT.CUR_AMT), SUM(FT.TOT_AMT) from cisadm.ci_ft FT, cisadm.CI_SA sa, cisadm.ci_sa_type SAT, cisadm.CI_DST_CODE_L DCL
    where FT.SA_ID = SA.SA_ID
          and FT.ars_dt between trunc(sysdate) -15 and trunc(sysdate)
          and SA.SA_TYPE_CD = SAT.SA_TYPE_CD
          and SAT.DST_ID = DCL.DST_ID
    group by DCL.DST_ID, DCL.DESCR</query>
    </jdbcQuery>
    <jdbcQuery id="SC_TRIAL_BALANCE_15_45" datasourceId="CollegeStation_DS_1">
      <fieldList>
        <field id="DST_ID" type="java.lang.String"></field>
