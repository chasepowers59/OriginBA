      <joinInfo alias="SC_TRIAL_BAL_TOTAL" referenceId="SC_TRIAL_BAL_TOTAL"></joinInfo>
      <joinList>
        <join expr="SC_TRIAL_BAL_TOTAL.DST_ID == SC_TRIAL_BALANCE_0_15.DST_ID" left="SC_TRIAL_BAL_TOTAL" right="SC_TRIAL_BALANCE_0_15" type="inner" weight="1"></join>
        <join expr="SC_TRIAL_BAL_TOTAL.DST_ID == SC_TRIAL_BALANCE_15_45.DST_ID" left="SC_TRIAL_BAL_TOTAL" right="SC_TRIAL_BALANCE_15_45" type="inner" weight="1"></join>
