<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.jaspersoft.com/2007/SL/XMLSchema" version="1.3">
  <dataIslands>
    <itemGroup id="CS_KW_USAGE" label="CS_KW_USAGE" resourceId="CS_KW_USAGE"></itemGroup>
  </dataIslands>
  <items>
    <item id="ACCT_ID" label="Account ID" resourceId="CS_KW_USAGE.ACCT_ID"></item>
    <item id="PREM_ID" label="Premise ID" resourceId="CS_KW_USAGE.PREM_ID"></item>
    <item id="ADDRESS1_UPR" label="Address 1" resourceId="CS_KW_USAGE.ADDRESS1_UPR"></item>
    <item id="BILL_CYC_CD" label="Bill Cycle" resourceId="CS_KW_USAGE.BILL_CYC_CD"></item>
    <item id="RS_CD" label="Rate Code" resourceId="CS_KW_USAGE.RS_CD"></item>
    <item id="D1_SP_ID" label="MDM Service Point ID" resourceId="CS_KW_USAGE.D1_SP_ID"></item>
    <item id="MSRMT_VAL" label="Measurement Value" resourceId="CS_KW_USAGE.MSRMT_VAL"></item>
    <item id="PREV_MSRMT_DTTM" label="Previous Measurement Date / Time" resourceId="CS_KW_USAGE.PREV_MSRMT_DTTM"></item>
    <item id="MSRMT_DTTM" label="Measurement Date / Time" resourceId="CS_KW_USAGE.MSRMT_DTTM"></item>
    <item id="READING_VAL" label="Reading Value" resourceId="CS_KW_USAGE.READING_VAL"></item>
    <item id="ID_VALUE" label="Badge Number" resourceId="CS_KW_USAGE.ID_VALUE"></item>
  </items>
  <resources>
    <jdbcQuery id="CS_KW_USAGE" datasourceId="CollegeStation_DS">
      <fieldList>
        <field id="ACCT_ID" type="java.lang.String"></field>
        <field id="ADDRESS1_UPR" type="java.lang.String"></field>
        <field id="BILL_CYC_CD" type="java.lang.String"></field>
        <field id="PREM_ID" type="java.lang.String"></field>
        <field id="SP_ID" type="java.lang.String"></field>
        <field id="D1_SP_ID" type="java.lang.String"></field>
        <field id="DEVICE_CONFIG_ID" type="java.lang.String"></field>
        <field id="MEASR_COMP_ID" type="java.lang.String"></field>
        <field id="MEASR_COMP_TYPE_CD" type="java.lang.String"></field>
        <field id="PREV_MSRMT_DTTM" type="java.sql.Timestamp"></field>
        <field id="MSRMT_DTTM" type="java.sql.Timestamp"></field>
        <field id="MSRMT_VAL" type="java.math.BigDecimal"></field>
        <field id="READING_VAL" type="java.math.BigDecimal"></field>
        <field id="RS_CD" type="java.lang.String"></field>
        <field id="ID_VALUE" type="java.lang.String"></field>
      </fieldList>
      <query>select sa.acct_id, ac.BILL_CYC_CD, p.address1_upr, p.prem_id, rs.rs_cd, sp.sp_id, spi.d1_sp_id, i.device_config_id, di.id_value, mc.measr_comp_id, mc.measr_comp_type_cd, 
    msr.prev_msrmt_dttm, msr.msrmt_dttm, msr.msrmt_val, msr.reading_val
    from CISADM.CI_ACCT ac, CISADM.CI_SA SA, cisadm.CI_SA_RS_HIST rs, cisadm.ci_prem p,CISADM.ci_sa_sp sasp, cisadm.ci_sp sp, cisadm.ci_sp_type spt, cisadm.d1_sp_identifier spi , 
         cisadm.d1_sp dsp, cisadm.d1_install_evt i, cisadm.d1_measr_comp mc, cisadm.d1_msrmt msr,
         cisadm.d1_dvc_cfg cfg, cisadm.d1_dvc_identifier di
    where SA.ACCT_ID = ac.acct_id and SA.SA_STATUS_FLG in ('20','30') and SA.CHAR_PREM_ID = P.PREM_ID and 
        sa.sa_id = rs.sa_id and rs.effdt = (select max(rs2.effdt) from cisadm.CI_SA_RS_HIST rs2 where rs2.sa_id = rs.sa_id)
        and sp.sp_type_cd = spt.sp_type_cd
        and spt.svc_type_cd = 'E'
        --and sp.prem_id = p.prem_id 
        and sa.sa_id = sasp.sa_id
        and sasp.sp_id = sp.sp_id
        and spi.id_value = sp.sp_id
        and spi.d1_sp_id = dsp.d1_sp_id
        and dsp.d1_sp_id = i.d1_sp_id
        and (i.d1_removal_DTTM is null or i.d1_removal_dttm &gt;= sysdate)
        and i.d1_install_dttm &lt;= sysdate
        and i.device_config_id = mc.device_config_id
        and mc.measr_comp_type_cd like '%KW-%'
        and mc.measr_comp_id = msr.measr_comp_id

        and i.device_config_id = cfg.device_config_id
        and cfg.d1_device_id = di.d1_device_id
        and di.dvc_id_type_flg = 'D1BN'</query>
    </jdbcQuery>
  </resources>
</schema>
