        <field id="SUM_TOT_AMT_" fieldDBName="SUM(TOT_AMT)" type="java.math.BigDecimal"></field>
      </fieldList>
      <query>select SA_ID, sum(cur_amt),sum(tot_amt) from cisadm.ci_ft where ars_dt between sysdate-20 and sysdate and new_debit_sw = 'Y' and freeze_sw = 'Y'group by sa_ID</query>
    </jdbcQuery>
