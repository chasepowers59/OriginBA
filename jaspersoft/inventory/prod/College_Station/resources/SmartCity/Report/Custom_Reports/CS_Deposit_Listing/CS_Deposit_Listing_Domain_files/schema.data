<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.jaspersoft.com/2007/SL/XMLSchema" version="1.3">
  <dataIslands>
    <itemGroup id="CS_DEPOSIT" label="CS_DEPOSIT" resourceId="CS_DEPOSIT"></itemGroup>
  </dataIslands>
  <dataSources>
    <jdbcDataSource id="CollegeStation_DS">
      <schemaMap>
        <entry key="defaultSchema">
          <string></string>
        </entry>
        <entry key="CISADM">
          <string>CISADM</string>
        </entry>
      </schemaMap>
    </jdbcDataSource>
  </dataSources>
  <items>
    <item id="CIS_DIVISION" label="CIS Division" resourceId="CS_DEPOSIT.CIS_DIVISION"></item>
    <item id="SA_TYPE" label="SA Type" resourceId="CS_DEPOSIT.SA_TYPE"></item>
    <item id="SA_TYPE_DESC" label="SA Type Description" resourceId="CS_DEPOSIT.SA_TYPE_DESC"></item>
    <item id="ARS_DT" label="Date" resourceId="CS_DEPOSIT.ARS_DT"></item>
    <item id="TOT_DEPOSIT_AMT" label="Total Deposit Amount" resourceId="CS_DEPOSIT.TOT_DEPOSIT_AMT"></item>
    <item id="TOT_NUM_DEPOSIT" label="Total Number of Deposits" resourceId="CS_DEPOSIT.TOT_NUM_DEPOSIT"></item>
    <item id="TOT_NUM_REFUND" label="Total Number of Refunds" resourceId="CS_DEPOSIT.TOT_NUM_REFUND"></item>
    <item id="TOT_REFUND_AMT" label="Total Refund Amount" resourceId="CS_DEPOSIT.TOT_REFUND_AMT"></item>
    <item id="UNPAID_DEPOSIT" label="Deposits Unpaid" resourceId="CS_DEPOSIT.UNPAID_DEPOSIT"></item>
  </items>
  <resources>
    <jdbcQuery id="CS_DEPOSIT" datasourceId="CollegeStation_DS">
      <fieldList>
        <field id="ARS_DT" type="java.sql.Timestamp"></field>
        <field id="TOT_NUM_DEPOSIT" type="java.math.BigDecimal"></field>
        <field id="TOT_DEPOSIT_AMT" type="java.math.BigDecimal"></field>
        <field id="TOT_NUM_REFUND" type="java.math.BigDecimal"></field>
        <field id="TOT_REFUND_AMT" type="java.math.BigDecimal"></field>
        <field id="UNPAID_DEPOSIT" type="java.math.BigDecimal"></field>
        <field id="SA_TYPE_DESC" type="java.lang.String"></field>
        <field id="CIS_DIVISION" type="java.lang.String"></field>
        <field id="SA_TYPE" type="java.lang.String"></field>
      </fieldList>
      <query>SELECT SUM(DEPOSIT_COUNT) AS TOT_NUM_DEPOSIT, SUM(DEPOSIT_AMT) AS TOT_DEPOSIT_AMT, SUM(REFUND_COUNT) AS TOT_NUM_REFUND, SUM(REFUND_AMT) AS TOT_REFUND_AMT, SUM(DEPOSIT_AMT)-SUM(REFUND_AMT) AS UNPAID_DEPOSIT, SA_TYPE_DESC, CIS_DIVISION, SA_TYPE, ARS_DT
FROM (
SELECT ABS(SUM(FTD.CUR_AMT)) AS DEPOSIT_AMT, 0 AS REFUND_AMT, SATL.DESCR AS SA_TYPE_DESC, SATL.CIS_DIVISION AS CIS_DIVISION, SATL.SA_TYPE_CD AS SA_TYPE, COUNT(FTD.FT_ID) AS DEPOSIT_COUNT, 0 AS REFUND_COUNT, FTD.ARS_DT AS ARS_DT
FROM CISADM.CI_FT FTD, CISADM.CI_SA SA, CISADM.CI_SA_TYPE_L SATL
WHERE SA.SA_TYPE_CD = SATL.SA_TYPE_CD
AND SA.CIS_DIVISION = SATL.CIS_DIVISION
AND FTD.SA_ID = SA.SA_ID
AND FTD.FT_TYPE_FLG = 'BS'
AND FTD.FREEZE_SW = 'Y'
AND SATL.LANGUAGE_CD = 'ENG'
AND SA.SA_TYPE_CD IN ('E-DEP','GARB-DEP','IRR-DEP','SL-DEP','SW-DEP','W-DEP')
GROUP BY SATL.DESCR, SATL.CIS_DIVISION, SATL.SA_TYPE_CD, FTD.ARS_DT
union
SELECT 0 AS DEPOSIT_AMT, ABS(SUM(FTD.CUR_AMT)) AS REFUND_AMT, SATL.DESCR AS SA_TYPE_DESC, SATL.CIS_DIVISION AS CIS_DIVISION, SATL.SA_TYPE_CD AS SA_TYPE, 0 AS DEPOSIT_COUNT, COUNT(FTD.FT_ID) AS REFUND_COUNT, FTD.ARS_DT
FROM CISADM.CI_FT FTD, CISADM.CI_SVC_TYPE_L STL, CISADM.CI_SA SA, CISADM.CI_SA_TYPE_L SATL, CISADM.CI_ADJ ADJ
WHERE SA.SA_TYPE_CD = SATL.SA_TYPE_CD
AND SA.CIS_DIVISION = SATL.CIS_DIVISION
AND FTD.SA_ID = SA.SA_ID
AND FTD.SIBLING_ID = ADJ.ADJ_ID
AND ADJ.SA_ID = SA.SA_ID
AND ADJ.ADJ_TYPE_CD IN ('CONVADJ', 'DEPOSREF','REFUNDAP')
AND FTD.FT_TYPE_FLG = 'AD'
AND ADJ.ADJ_STATUS_FLG = '50'
AND SATL.LANGUAGE_CD = 'ENG'
AND SA.SA_TYPE_CD IN ('E-DEP','GARB-DEP','IRR-DEP','SL-DEP','SW-DEP','W-DEP')
GROUP BY SATL.DESCR, SATL.CIS_DIVISION, SATL.SA_TYPE_CD, FTD.ARS_DT
) GROUP BY CIS_DIVISION, SA_TYPE_DESC, SA_TYPE, ARS_DT</query>
    </jdbcQuery>
  </resources>
</schema>
