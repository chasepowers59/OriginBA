<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.jaspersoft.com/2007/SL/XMLSchema" version="1.3">
  <dataIslands>
    <itemGroup id="JoinTree_1" label="JoinTree_1" resourceId="JoinTree_1"></itemGroup>
  </dataIslands>
  <dataSources>
    <jdbcDataSource id="CollegeStation_DS">
      <schemaMap>
        <entry key="defaultSchema">
          <string></string>
        </entry>
        <entry key="CISADM">
          <string>CISADM</string>
        </entry>
      </schemaMap>
    </jdbcDataSource>
  </dataSources>
  <itemGroups>
    <itemGroup id="CS_TRIAL_BALANCE" label="CS_TRIAL_BALANCE" resourceId="JoinTree_1">
      <items>
        <item id="A0" label="Current Total" resourceId="JoinTree_1.CS_TRIAL_BALANCE.A0"></item>
        <item id="A15" label="Current" resourceId="JoinTree_1.CS_TRIAL_BALANCE.A15"></item>
        <item id="A45" label="Current 15 - 45 Days " resourceId="JoinTree_1.CS_TRIAL_BALANCE.A45"></item>
        <item id="A90" label="Current 45 - 90 Days" resourceId="JoinTree_1.CS_TRIAL_BALANCE.A90"></item>
        <item id="AOLD" label="Current 90 + Days" resourceId="JoinTree_1.CS_TRIAL_BALANCE.AOLD"></item>
        <item id="ATOT15" label="Payoff 15 - 45 Days" resourceId="JoinTree_1.CS_TRIAL_BALANCE.ATOT15"></item>
        <item id="ATOT45" label="Payoff 45 - 90 Days" resourceId="JoinTree_1.CS_TRIAL_BALANCE.ATOT45"></item>
        <item id="ATOT90" label="Payoff 90+ Days" resourceId="JoinTree_1.CS_TRIAL_BALANCE.ATOT90"></item>
        <item id="ATOTO" label="Payoff Total" resourceId="JoinTree_1.CS_TRIAL_BALANCE.ATOTO"></item>
        <item id="ATOTOLD" label="ATOTOLD" resourceId="JoinTree_1.CS_TRIAL_BALANCE.ATOTOLD"></item>
        <item id="DESCR" label="Description" resourceId="JoinTree_1.CS_TRIAL_BALANCE.DESCR"></item>
        <item id="GL_ACCT_1" label="GL Account" resourceId="JoinTree_1.CI_DST_CODE_EFF.GL_ACCT"></item>
        <item id="DST_ID" label="Distribution Code" resourceId="JoinTree_1.CS_TRIAL_BALANCE.DST_ID"></item>
      </items>
    </itemGroup>
  </itemGroups>
  <resources>
    <jdbcTable id="CI_DST_CODE_EFF" datasourceId="CollegeStation_DS" datasourceTableName="CI_DST_CODE_EFF" schemaAlias="CISADM">
      <fieldList>
        <field id="DST_ID" type="java.lang.String"></field>
        <field id="EFFDT" type="java.sql.Timestamp"></field>
        <field id="EFF_STATUS" type="java.lang.String"></field>
        <field id="GL_ACCT" type="java.lang.String"></field>
        <field id="VERSION" type="java.math.BigDecimal"></field>
        <field id="STATISTICS_CD" type="java.lang.String"></field>
        <field id="FUND_CD" type="java.lang.String"></field>
      </fieldList>
    </jdbcTable>
    <jdbcQuery id="CS_TRIAL_BALANCE" datasourceId="CollegeStation_DS">
      <fieldList>
        <field id="DESCR" type="java.lang.String"></field>
        <field id="A0" type="java.math.BigDecimal"></field>
        <field id="A45" type="java.math.BigDecimal"></field>
        <field id="A90" type="java.math.BigDecimal"></field>
        <field id="AOLD" type="java.math.BigDecimal"></field>
        <field id="A15" type="java.math.BigDecimal"></field>
        <field id="ATOTO" type="java.math.BigDecimal"></field>
        <field id="ATOT15" type="java.math.BigDecimal"></field>
        <field id="ATOT45" type="java.math.BigDecimal"></field>
        <field id="ATOT90" type="java.math.BigDecimal"></field>
        <field id="ATOTOLD" type="java.math.BigDecimal"></field>
        <field id="DST_ID" type="java.lang.String"></field>
      </fieldList>
      <query>select DCL.DST_ID, DCL.DESCR, FTGL0.a0, FTGL15.a15, FTGL45.a45, FTGL90.a90, FTGLOLD.aold , FTGL0.aTOTo, FTGL15.aTOT15, FTGL45.aTOT45, FTGL90.aTOT90, FTGLOLD.aTOTold from CISADM.CI_DST_CODE_L DCL 
LEFT JOIN (select SAT.DST_ID, SUM(FT.CUR_AMT) as aold , SUM(FT.TOT_AMT) as aTOTold from cisadm.ci_ft FT, cisadm.CI_SA sa, cisadm.ci_sa_type SAT where FT.SA_ID = SA.SA_ID and FT.ars_dt &lt;=trunc(sysdate)-91 and SA.SA_TYPE_CD = SAT.SA_TYPE_CD group by SAT.DST_ID) FTGLOLD on FTGLOLD.DST_ID = DCL.DST_ID
LEFT JOIN (select SAT.DST_ID, SUM(FT.CUR_AMT) as a90, SUM(FT.TOT_AMT) as aTOT90 from cisadm.ci_ft FT, cisadm.CI_SA sa, cisadm.ci_sa_type SAT where FT.SA_ID = SA.SA_ID and FT.ars_dt between trunc(sysdate) -90 and trunc(sysdate)-61 and SA.SA_TYPE_CD = SAT.SA_TYPE_CD group by SAT.DST_ID) FTGL90 on FTGL90.DST_ID = DCL.DST_ID
LEFT JOIN (select SAT.DST_ID, SUM(FT.CUR_AMT) as a45, SUM(FT.TOT_AMT) as aTOT45 from cisadm.ci_ft FT, cisadm.CI_SA sa, cisadm.ci_sa_type SAT where FT.SA_ID = SA.SA_ID and FT.ars_dt between trunc(sysdate) -60 and trunc(sysdate)-31 and SA.SA_TYPE_CD = SAT.SA_TYPE_CD group by SAT.DST_ID) FTGL45 on FTGL45.DST_ID = DCL.DST_ID  
LEFT JOIN (SELECT SAT.DST_ID ,SUM(FT.CUR_AMT) as a15, SUM(FT.TOT_AMT) as aTOT15 from cisadm.ci_ft FT, cisadm.CI_SA sa, cisadm.ci_sa_type SAT where FT.SA_ID = SA.SA_ID and FT.ars_dt between trunc(sysdate) -30 and trunc(sysdate) and SA.SA_TYPE_CD = SAT.SA_TYPE_CD group by SAT.DST_ID) FTGL15 on FTGL15.DST_ID = DCL.DST_ID
LEFT JOIN (select SAT.DST_ID, SUM(FT.CUR_AMT) as a0, SUM(FT.TOT_AMT) as aTOTo from cisadm.ci_ft FT, cisadm.CI_SA sa, cisadm.ci_sa_type SAT where FT.SA_ID = SA.SA_ID and FT.ars_dt &lt;= (sysdate) and SA.SA_TYPE_CD = SAT.SA_TYPE_CD group by SAT.DST_ID) FTGL0 on FTGL0.DST_ID = DCL.DST_ID</query>
    </jdbcQuery>
    <jdbcQuery id="JoinTree_1" datasourceId="CollegeStation_DS">
      <fieldList>
        <field id="CS_TRIAL_BALANCE.DESCR" type="java.lang.String"></field>
        <field id="CS_TRIAL_BALANCE.A0" type="java.math.BigDecimal"></field>
        <field id="CS_TRIAL_BALANCE.A45" type="java.math.BigDecimal"></field>
        <field id="CS_TRIAL_BALANCE.A90" type="java.math.BigDecimal"></field>
        <field id="CS_TRIAL_BALANCE.AOLD" type="java.math.BigDecimal"></field>
        <field id="CS_TRIAL_BALANCE.A15" type="java.math.BigDecimal"></field>
        <field id="CS_TRIAL_BALANCE.ATOTO" type="java.math.BigDecimal"></field>
        <field id="CS_TRIAL_BALANCE.ATOT15" type="java.math.BigDecimal"></field>
        <field id="CS_TRIAL_BALANCE.ATOT45" type="java.math.BigDecimal"></field>
        <field id="CS_TRIAL_BALANCE.ATOT90" type="java.math.BigDecimal"></field>
        <field id="CS_TRIAL_BALANCE.ATOTOLD" type="java.math.BigDecimal"></field>
        <field id="CS_TRIAL_BALANCE.DST_ID" type="java.lang.String"></field>
        <field id="CI_DST_CODE_EFF.DST_ID" type="java.lang.String"></field>
        <field id="CI_DST_CODE_EFF.EFFDT" type="java.sql.Timestamp"></field>
        <field id="CI_DST_CODE_EFF.EFF_STATUS" type="java.lang.String"></field>
        <field id="CI_DST_CODE_EFF.GL_ACCT" type="java.lang.String"></field>
        <field id="CI_DST_CODE_EFF.VERSION" type="java.math.BigDecimal"></field>
        <field id="CI_DST_CODE_EFF.STATISTICS_CD" type="java.lang.String"></field>
        <field id="CI_DST_CODE_EFF.FUND_CD" type="java.lang.String"></field>
      </fieldList>
      <joinInfo alias="CS_TRIAL_BALANCE" referenceId="CS_TRIAL_BALANCE"></joinInfo>
      <joinList>
        <join expr="CS_TRIAL_BALANCE.DST_ID == CI_DST_CODE_EFF.DST_ID" left="CS_TRIAL_BALANCE" right="CI_DST_CODE_EFF" type="leftOuter" weight="1"></join>
      </joinList>
      <joinOptions></joinOptions>
      <query>select DCL.DST_ID, DCL.DESCR, FTGL0.a0, FTGL15.a15, FTGL45.a45, FTGL90.a90, FTGLOLD.aold , FTGL0.aTOTo, FTGL15.aTOT15, FTGL45.aTOT45, FTGL90.aTOT90, FTGLOLD.aTOTold from CISADM.CI_DST_CODE_L DCL 
LEFT JOIN (select SAT.DST_ID, SUM(FT.CUR_AMT) as aold , SUM(FT.TOT_AMT) as aTOTold from cisadm.ci_ft FT, cisadm.CI_SA sa, cisadm.ci_sa_type SAT where FT.SA_ID = SA.SA_ID and FT.ars_dt &lt;=trunc(sysdate)-91 and SA.SA_TYPE_CD = SAT.SA_TYPE_CD group by SAT.DST_ID) FTGLOLD on FTGLOLD.DST_ID = DCL.DST_ID
LEFT JOIN (select SAT.DST_ID, SUM(FT.CUR_AMT) as a90, SUM(FT.TOT_AMT) as aTOT90 from cisadm.ci_ft FT, cisadm.CI_SA sa, cisadm.ci_sa_type SAT where FT.SA_ID = SA.SA_ID and FT.ars_dt between trunc(sysdate) -90 and trunc(sysdate)-61 and SA.SA_TYPE_CD = SAT.SA_TYPE_CD group by SAT.DST_ID) FTGL90 on FTGL90.DST_ID = DCL.DST_ID
LEFT JOIN (select SAT.DST_ID, SUM(FT.CUR_AMT) as a45, SUM(FT.TOT_AMT) as aTOT45 from cisadm.ci_ft FT, cisadm.CI_SA sa, cisadm.ci_sa_type SAT where FT.SA_ID = SA.SA_ID and FT.ars_dt between trunc(sysdate) -60 and trunc(sysdate)-31 and SA.SA_TYPE_CD = SAT.SA_TYPE_CD group by SAT.DST_ID) FTGL45 on FTGL45.DST_ID = DCL.DST_ID  
LEFT JOIN (SELECT SAT.DST_ID ,SUM(FT.CUR_AMT) as a15, SUM(FT.TOT_AMT) as aTOT15 from cisadm.ci_ft FT, cisadm.CI_SA sa, cisadm.ci_sa_type SAT where FT.SA_ID = SA.SA_ID and FT.ars_dt between trunc(sysdate) -30 and trunc(sysdate) and SA.SA_TYPE_CD = SAT.SA_TYPE_CD group by SAT.DST_ID) FTGL15 on FTGL15.DST_ID = DCL.DST_ID
LEFT JOIN (select SAT.DST_ID, SUM(FT.CUR_AMT) as a0, SUM(FT.TOT_AMT) as aTOTo from cisadm.ci_ft FT, cisadm.CI_SA sa, cisadm.ci_sa_type SAT where FT.SA_ID = SA.SA_ID and FT.ars_dt &lt;= (sysdate) and SA.SA_TYPE_CD = SAT.SA_TYPE_CD group by SAT.DST_ID) FTGL0 on FTGL0.DST_ID = DCL.DST_ID</query>
      <tableRefList>
        <tableRef alwaysIncludeTable="false" tableAlias="CS_TRIAL_BALANCE" tableId="CS_TRIAL_BALANCE"></tableRef>
        <tableRef alwaysIncludeTable="false" tableAlias="CI_DST_CODE_EFF" tableId="CI_DST_CODE_EFF"></tableRef>
      </tableRefList>
    </jdbcQuery>
  </resources>
</schema>
