        <join expr="CI_SEV_PROC.SA_ID == CI_SA.SA_ID" left="CI_SEV_PROC" right="CI_SA" type="inner" weight="1"></join>
        <join expr="CI_SEV_PROC.SEV_PROC_TMPL_CD == CI_SEV_PROC_TMP.SEV_PROC_TMPL_CD" left="CI_SEV_PROC" right="CI_SEV_PROC_TMP" type="inner" weight="1"></join>
        <join expr="CI_SEV_PROC.SEV_PROC_TMPL_CD == CI_SEV_PROC_TMP_L.SEV_PROC_TMPL_CD" left="CI_SEV_PROC" right="CI_SEV_PROC_TMP_L" type="inner" weight="1"></join>
        <join expr="CI_SEV_PROC_TMP.SEV_PROC_TMPL_CD == CI_SEV_PROC_TMP_L.SEV_PROC_TMPL_CD and CI_SEV_PROC_TMP_L.LANGUAGE_CD == 'ENG'" left="CI_SEV_PROC_TMP" right="CI_SEV_PROC_TMP_L" type="inner" weight="1"></join>
        <join expr="CI_SEV_PROC.SEV_PROC_ID == CI_SEV_EVT_FA.SEV_PROC_ID" left="CI_SEV_PROC" right="CI_SEV_EVT_FA" type="leftOuter" weight="1"></join>
        <join expr="CI_SEV_PROC.SEV_PROC_ID == CI_SEV_EVT.SEV_PROC_ID" left="CI_SEV_PROC" right="CI_SEV_EVT" type="leftOuter" weight="1"></join>
        <join expr="CI_SEV_EVT_FA.SEV_PROC_ID == CI_SEV_EVT.SEV_PROC_ID and CI_SEV_EVT_FA.EVT_SEQ == CI_SEV_EVT.EVT_SEQ" left="CI_SEV_EVT_FA" right="CI_SEV_EVT" type="leftOuter" weight="1"></join>
        <join expr="CI_SEV_EVT.SEV_EVT_TYPE_CD == CI_SEV_EVT_TYPE_L.SEV_EVT_TYPE_CD and CI_SEV_EVT_TYPE_L.LANGUAGE_CD == 'ENG'" left="CI_SEV_EVT" right="CI_SEV_EVT_TYPE_L" type="leftOuter" weight="1"></join>
        <join expr="CI_SA.CHAR_PREM_ID == CI_PREM.PREM_ID" left="CI_SA" right="CI_PREM" type="leftOuter" weight="1"></join>
        <join expr="CI_SA.ACCT_ID == CM_ACCT_PER.ACCT_ID" left="CI_SA" right="CM_ACCT_PER" type="leftOuter" weight="1"></join>
