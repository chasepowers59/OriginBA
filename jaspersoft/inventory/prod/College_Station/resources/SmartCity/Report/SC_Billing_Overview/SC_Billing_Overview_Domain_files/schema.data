        <join expr="CI_BILL.ACCT_ID == CI_ACCT_PER.ACCT_ID" left="CI_BILL" right="CI_ACCT_PER" type="inner" weight="1"></join>
        <join expr="CI_ACCT.ACCT_ID == CI_ACCT_PER.ACCT_ID" left="CI_ACCT" right="CI_ACCT_PER" type="inner" weight="1"></join>
        <join expr="CI_BILL.BILL_CYC_CD == CI_BILL_CYC_L.BILL_CYC_CD" left="CI_BILL" right="CI_BILL_CYC_L" type="leftOuter" weight="1"></join>
        <join expr="CI_BILL.BILL_CYC_CD == CI_BILL_CYC_SCH.BILL_CYC_CD and CI_BILL.WIN_START_DT &gt;= CI_BILL_CYC_SCH.WIN_START_DT and CI_BILL.WIN_START_DT &lt;= CI_BILL_CYC_SCH.WIN_END_DT" left="CI_BILL" right="CI_BILL_CYC_SCH" type="leftOuter" weight="1"></join>
        <join expr="CI_BILL.BILL_ID == CI_BILL_ROUTING.BILL_ID" left="CI_BILL" right="CI_BILL_ROUTING" type="leftOuter" weight="1"></join>
        <join expr="CI_ACCT_PER.PER_ID == CI_BILL_ROUTING.PER_ID" left="CI_ACCT_PER" right="CI_BILL_ROUTING" type="leftOuter" weight="1"></join>
        <join expr="CI_BILL_ROUTING.BILL_RTE_TYPE_CD == CI_BILL_RT_TYPE_L.BILL_RTE_TYPE_CD" left="CI_BILL_ROUTING" right="CI_BILL_RT_TYPE_L" type="leftOuter" weight="1"></join>
        <join expr="CI_BILL.BILL_ID == CI_BILL_SA.BILL_ID" left="CI_BILL" right="CI_BILL_SA" type="leftOuter" weight="1"></join>
        <join expr="CI_BILL.BILL_ID == CI_BILL_EXCP.BILL_ID" left="CI_BILL" right="CI_BILL_EXCP" type="leftOuter" weight="1"></join>
      </joinList>
      <joinOptions includeAllDataIslandJoins="true"></joinOptions>
      <tableRefList>
        <tableRef alwaysIncludeTable="false" tableAlias="CI_ACCT" tableId="CI_ACCT"></tableRef>
        <tableRef alwaysIncludeTable="false" tableAlias="CI_ACCT_PER" tableId="CI_ACCT_PER"></tableRef>
        <tableRef alwaysIncludeTable="false" tableAlias="CI_BILL_SA" tableId="CI_BILL_SA"></tableRef>
