        <tableRef alwaysIncludeTable="false" tableAlias="CI_BILL_EXCP" tableId="CI_BILL_EXCP"></tableRef>
        <tableRef alwaysIncludeTable="false" tableAlias="CI_BILL" tableId="CI_BILL"></tableRef>
        <tableRef alwaysIncludeTable="false" tableAlias="CI_BILL_RT_TYPE_L" tableId="CI_BILL_RT_TYPE_L"></tableRef>
        <tableRef alwaysIncludeTable="false" tableAlias="CI_BILL_CYC_SCH" tableId="CI_BILL_CYC_SCH"></tableRef>
      </tableRefList>
    </jdbcTable>
