				<reportElement x="0" y="60" width="572" height="420" uuid="74b851a6-3e32-4786-90d4-2334cdaa2287"/>
				<textField textAdjust="StretchHeight" isBlankWhenNull="true">
					<reportElement stretchType="RelativeToBandHeight" x="0" y="-35" width="572" height="59" isPrintWhenDetailOverflows="true" uuid="2fbb36c0-3b53-4ad8-98a6-298046086371">
