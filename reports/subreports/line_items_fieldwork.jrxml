<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
    name="line_items_fieldwork"
    pageWidth="364"
    pageHeight="470"
    columnWidth="364"
    leftMargin="0"
    rightMargin="0"
    topMargin="0"
    bottomMargin="0"
    uuid="4dce7f58-9354-4d95-857b-a7636b2304a8">

    <parameter name="CLIENT_ID" class="java.lang.String"/>
    <parameter name="START_TS" class="java.sql.Timestamp"/>
    <parameter name="END_TS" class="java.sql.Timestamp"/>
    <parameter name="REGION" class="java.lang.String"/>

    <queryString language="SQL"><![CDATA[
SELECT
    FW.WORK_ID,
    FW.METER_ID,
    FW.WORK_STATUS,
    FW.ASSIGNED_DATE,
    FW.TECHNICIAN_ID,
    FW.WORK_REGION
FROM CISADM.FIELD_WORK_LOG FW
WHERE FW.CLIENT_ID = $P{CLIENT_ID}
  AND FW.WORK_STATUS IN ('Assigned', 'In Progress')
  AND FW.ASSIGNED_DATE >= $P{START_TS}
  AND FW.ASSIGNED_DATE <  $P{END_TS}
  AND ($P{REGION} IS NULL OR FW.WORK_REGION = $P{REGION})
ORDER BY FW.ASSIGNED_DATE DESC
    ]]></queryString>

    <field name="WORK_ID" class="java.math.BigDecimal"/>
    <field name="METER_ID" class="java.math.BigDecimal"/>
    <field name="WORK_STATUS" class="java.lang.String"/>
    <field name="ASSIGNED_DATE" class="java.sql.Timestamp"/>
    <field name="TECHNICIAN_ID" class="java.lang.String"/>
    <field name="WORK_REGION" class="java.lang.String"/>

