    <style name="SubText" style="Base" fontSize="8" forecolor="#000000"/>
    <style name="TotalText" style="Base" fontSize="9" isBold="true" forecolor="#000000" backcolor="#F5F0EB" mode="Opaque"/>
    <style name="FooterConfidential" style="Base" fontSize="7" forecolor="#000000"/>
    <parameter name="FROM_DT" class="java.sql.Date">
        <defaultValueExpression><![CDATA[java.sql.Date.valueOf(java.time.LocalDate.now().withDayOfMonth(1).minusMonths(1).toString())]]></defaultValueExpression>
    </parameter>
    <parameter name="TO_DT" class="java.sql.Date">
        <defaultValueExpression><![CDATA[java.sql.Date.valueOf(java.time.LocalDate.now().withDayOfMonth(1).minusDays(1).toString())]]></defaultValueExpression>
    </parameter>
    <parameter name="CLIENT_NAME" isForPrompting="false" class="java.lang.String">
        <defaultValueExpression><![CDATA["SmartCity Client"]]></defaultValueExpression>
    </parameter>
    <parameter name="ADJ_TYPE_CD" class="java.lang.String">
        <defaultValueExpression><![CDATA[""]]></defaultValueExpression>
    </parameter>
    <parameter name="TOP_N" class="java.lang.Integer">
        <defaultValueExpression><![CDATA[10]]></defaultValueExpression>
    </parameter>
    <queryString language="SQL"><![CDATA[
SELECT ADJ_ID, CRE_DT, SA_ID, ACCT_ID, CUSTOMER_NAME, ADJ_AMT FROM (
  SELECT TRIM(a.adj_id) AS ADJ_ID, a.cre_dt AS CRE_DT, TRIM(a.sa_id) AS SA_ID, TRIM(sa.acct_id) AS ACCT_ID,
         pn.entity_name AS CUSTOMER_NAME, a.adj_amt AS ADJ_AMT
  FROM CISADM.CI_ADJ a
  JOIN CISADM.CI_SA sa ON sa.sa_id = a.sa_id
  LEFT JOIN CISADM.CI_ACCT_PER ap ON ap.acct_id = sa.acct_id AND TRIM(ap.main_cust_sw) = 'Y'
  LEFT JOIN CISADM.CI_PER_NAME pn ON pn.per_id = ap.per_id AND TRIM(pn.name_type_flg) = 'PRIM'
  WHERE TRIM(a.adj_status_flg) = '50' AND a.cre_dt >= $P{FROM_DT} AND a.cre_dt < $P{TO_DT} + INTERVAL '1' DAY
    AND TRIM(a.adj_type_cd) = TRIM($P{ADJ_TYPE_CD})
  ORDER BY ABS(a.adj_amt) DESC, a.adj_id
) x
FETCH FIRST $P{TOP_N} ROWS ONLY
]]></queryString>
    <field name="ADJ_ID" class="java.lang.String"/>
    <field name="CRE_DT" class="java.sql.Timestamp"/>
    <field name="SA_ID" class="java.lang.String"/>
    <field name="ACCT_ID" class="java.lang.String"/>
    <field name="CUSTOMER_NAME" class="java.lang.String"/>
    <field name="ADJ_AMT" class="java.math.BigDecimal"/>
    <variable name="SUM_ADJ_AMT" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{ADJ_AMT}]]></variableExpression>
    </variable>
