<?xml version="1.0" encoding="UTF-8"?>
<jasperReport name="adjustments_by_type_top" pageWidth="778" pageHeight="595" orientation="Landscape"
    columnWidth="778" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0"
    whenNoDataType="AllSectionsNoDetail">
    <property name="net.sf.jasperreports.query.timeout" value="600"/>
    <property name="net.sf.jasperreports.export.xls.remove.empty.space.between.rows" value="true"/>
    <style name="Base" default="true" fontName="Aptos" fontSize="9"/>
    <style name="TitleSapphire" style="Base" fontSize="18" bold="true" forecolor="#006FAC"/>
    <style name="H3" style="Base" fontSize="10" forecolor="#0F4761"/>
    <style name="HeaderSapphire" style="Base" fontSize="9" bold="true" forecolor="#FFFFFF" backcolor="#006FAC" mode="Opaque"/>
    <style name="DetailText" style="Base" fontSize="9" forecolor="#000000" backcolor="#F5F0EB" mode="Opaque"/>
    <style name="SubHeader" style="Base" fontSize="8" bold="true" forecolor="#1348AB"/>
    <style name="SubText" style="Base" fontSize="8" forecolor="#000000"/>
    <style name="TotalText" style="Base" fontSize="9" bold="true" forecolor="#000000" backcolor="#F5F0EB" mode="Opaque"/>
    <style name="FooterConfidential" style="Base" fontSize="7" forecolor="#000000"/>
    <query language="SQL"><![CDATA[
SELECT ADJ_ID, CRE_DT, SA_ID, ACCT_ID, CUSTOMER_NAME, ADJ_AMT FROM (
  SELECT TRIM(a.adj_id) AS ADJ_ID, a.cre_dt AS CRE_DT, TRIM(a.sa_id) AS SA_ID, TRIM(sa.acct_id) AS ACCT_ID,
         pn.entity_name AS CUSTOMER_NAME, a.adj_amt AS ADJ_AMT
  FROM CISADM.CI_ADJ a
  JOIN CISADM.CI_SA sa ON sa.sa_id = a.sa_id
  LEFT JOIN CISADM.CI_ACCT_PER ap ON ap.acct_id = sa.acct_id AND TRIM(ap.main_cust_sw) = 'Y'
  LEFT JOIN CISADM.CI_PER_NAME pn ON pn.per_id = ap.per_id AND TRIM(pn.name_type_flg) = 'PRIM'
  WHERE TRIM(a.adj_status_flg) = '50' AND a.cre_dt >= $P{FROM_DT} AND a.cre_dt < $P{TO_DT} + INTERVAL '1' DAY
    AND TRIM(a.adj_type_cd) = TRIM($P{ADJ_TYPE_CD})
      AND ($P{ADJ_TYPE_CD_F} IS NULL OR TRIM(a.adj_type_cd) = TRIM($P{ADJ_TYPE_CD_F}))
  AND ($P{ACCT_ID_F} IS NULL OR TRIM(sa.acct_id) = TRIM($P{ACCT_ID_F}))
  AND ($P{SA_ID_F} IS NULL OR TRIM(a.sa_id) = TRIM($P{SA_ID_F}))
  AND ($P{MIN_ABS_AMT_F} IS NULL OR ABS(a.adj_amt) >= $P{MIN_ABS_AMT_F})
  ORDER BY ABS(a.adj_amt) DESC, a.adj_id
) x
FETCH FIRST $P{TOP_N} ROWS ONLY
]]></query>
    <parameter name="FROM_DT" class="java.sql.Date">
        <defaultValueExpression><![CDATA[java.sql.Date.valueOf(java.time.LocalDate.now().withDayOfMonth(1).minusMonths(1).toString())]]></defaultValueExpression>
    </parameter>
    <parameter name="TO_DT" class="java.sql.Date">
        <defaultValueExpression><![CDATA[java.sql.Date.valueOf(java.time.LocalDate.now().withDayOfMonth(1).minusDays(1).toString())]]></defaultValueExpression>
    </parameter>
    <parameter name="ADJ_TYPE_CD" class="java.lang.String">
        <defaultValueExpression><![CDATA[""]]></defaultValueExpression>
    </parameter>
    <parameter name="TOP_N" class="java.lang.Integer">
        <defaultValueExpression><![CDATA[10]]></defaultValueExpression>
    </parameter>
    <parameter name="ADJ_TYPE_CD_F" class="java.lang.String">
        <defaultValueExpression><![CDATA[null]]></defaultValueExpression>
    </parameter>
    <parameter name="ACCT_ID_F" class="java.lang.String">
        <defaultValueExpression><![CDATA[null]]></defaultValueExpression>
    </parameter>
    <parameter name="SA_ID_F" class="java.lang.String">
        <defaultValueExpression><![CDATA[null]]></defaultValueExpression>
    </parameter>
    <parameter name="MIN_ABS_AMT_F" class="java.math.BigDecimal">
        <defaultValueExpression><![CDATA[null]]></defaultValueExpression>
    </parameter>
    <field name="ADJ_ID" class="java.lang.String"/>
    <field name="CRE_DT" class="java.sql.Timestamp"/>
    <field name="SA_ID" class="java.lang.String"/>
    <field name="ACCT_ID" class="java.lang.String"/>
    <field name="CUSTOMER_NAME" class="java.lang.String"/>
    <field name="ADJ_AMT" class="java.math.BigDecimal"/>
    <variable name="SUM_ADJ_AMT" class="java.math.BigDecimal" calculation="Sum">
        <expression><![CDATA[$F{ADJ_AMT}]]></expression>
    </variable>
    <title height="14">
            <element kind="textField" x="0" y="0" width="778" height="14" style="SubHeader" hTextAlign="Left" vTextAlign="Middle" blankWhenNull="true" textAdjust="StretchHeight"><expression><![CDATA["Largest adjustments of type " + $P{ADJ_TYPE_CD}]]></expression></element>
    </title>
    <columnHeader height="14">
            <element kind="staticText" x="0" y="0" width="90" height="14" style="SubHeader" hTextAlign="Left" vTextAlign="Middle"><text><![CDATA[Adjustment]]></text></element>
            <element kind="staticText" x="90" y="0" width="80" height="14" style="SubHeader" hTextAlign="Left" vTextAlign="Middle"><text><![CDATA[Created]]></text></element>
            <element kind="staticText" x="170" y="0" width="90" height="14" style="SubHeader" hTextAlign="Left" vTextAlign="Middle"><text><![CDATA[SA]]></text></element>
            <element kind="staticText" x="260" y="0" width="90" height="14" style="SubHeader" hTextAlign="Left" vTextAlign="Middle"><text><![CDATA[Account]]></text></element>
            <element kind="staticText" x="350" y="0" width="308" height="14" style="SubHeader" hTextAlign="Left" vTextAlign="Middle"><text><![CDATA[Main Customer]]></text></element>
            <element kind="staticText" x="658" y="0" width="120" height="14" style="SubHeader" hTextAlign="Right" vTextAlign="Middle"><text><![CDATA[Amount]]></text></element>
    </columnHeader>
    <detail>
        <band height="13">
            <element kind="textField" x="0" y="0" width="90" height="13" style="SubText" hTextAlign="Left" vTextAlign="Middle" blankWhenNull="true" textAdjust="StretchHeight"><expression><![CDATA[$F{ADJ_ID}]]></expression></element>
            <element kind="textField" x="90" y="0" width="80" height="13" style="SubText" hTextAlign="Left" vTextAlign="Middle" blankWhenNull="true" textAdjust="StretchHeight" pattern="yyyy-MM-dd"><expression><![CDATA[$F{CRE_DT}]]></expression></element>
            <element kind="textField" x="170" y="0" width="90" height="13" style="SubText" hTextAlign="Left" vTextAlign="Middle" blankWhenNull="true" textAdjust="StretchHeight"><expression><![CDATA[$F{SA_ID}]]></expression></element>
            <element kind="textField" x="260" y="0" width="90" height="13" style="SubText" hTextAlign="Left" vTextAlign="Middle" blankWhenNull="true" textAdjust="StretchHeight"><expression><![CDATA[$F{ACCT_ID}]]></expression></element>
            <element kind="textField" x="350" y="0" width="308" height="13" style="SubText" hTextAlign="Left" vTextAlign="Middle" blankWhenNull="true" textAdjust="StretchHeight"><expression><![CDATA[$F{CUSTOMER_NAME}]]></expression></element>
            <element kind="textField" x="658" y="0" width="120" height="13" style="SubText" hTextAlign="Right" vTextAlign="Middle" blankWhenNull="true" textAdjust="StretchHeight" pattern="#,##0.00;(#,##0.00)"><expression><![CDATA[$F{ADJ_AMT}]]></expression></element>
        </band>
    </detail>
    <summary height="16">
            <element kind="staticText" x="0" y="0" width="90" height="13" style="SubHeader" hTextAlign="Left" vTextAlign="Middle"><text><![CDATA[Subtotal]]></text></element>
            <element kind="staticText" x="90" y="0" width="80" height="13" style="SubHeader" hTextAlign="Left" vTextAlign="Middle"><text><![CDATA[]]></text></element>
            <element kind="staticText" x="170" y="0" width="90" height="13" style="SubHeader" hTextAlign="Left" vTextAlign="Middle"><text><![CDATA[]]></text></element>
            <element kind="staticText" x="260" y="0" width="90" height="13" style="SubHeader" hTextAlign="Left" vTextAlign="Middle"><text><![CDATA[]]></text></element>
            <element kind="staticText" x="350" y="0" width="308" height="13" style="SubHeader" hTextAlign="Left" vTextAlign="Middle"><text><![CDATA[]]></text></element>
            <element kind="textField" x="658" y="0" width="120" height="13" style="SubHeader" hTextAlign="Right" vTextAlign="Middle" blankWhenNull="true" textAdjust="StretchHeight" pattern="#,##0.00;(#,##0.00)"><expression><![CDATA[$V{SUM_ADJ_AMT}]]></expression></element>
    </summary>
</jasperReport>
