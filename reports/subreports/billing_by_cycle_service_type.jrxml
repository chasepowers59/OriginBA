<?xml version="1.0" encoding="UTF-8"?>
<jasperReport name="billing_by_cycle_service_type" pageWidth="778" pageHeight="595" orientation="Landscape"
    columnWidth="778" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0"
    whenNoDataType="AllSectionsNoDetail">
    <property name="net.sf.jasperreports.query.timeout" value="600"/>
    <property name="net.sf.jasperreports.export.xls.remove.empty.space.between.rows" value="true"/>
    <style name="Base" default="true" fontName="Aptos" fontSize="9"/>
    <style name="TitleSapphire" style="Base" fontSize="18" bold="true" forecolor="#006FAC"/>
    <style name="H3" style="Base" fontSize="10" forecolor="#0F4761"/>
    <style name="HeaderSapphire" style="Base" fontSize="9" bold="true" forecolor="#FFFFFF" backcolor="#006FAC" mode="Opaque"/>
    <style name="DetailText" style="Base" fontSize="9" forecolor="#000000" backcolor="#F5F0EB" mode="Opaque"/>
    <style name="SubHeader" style="Base" fontSize="8" bold="true" forecolor="#1348AB"/>
    <style name="SubText" style="Base" fontSize="8" forecolor="#000000"/>
    <style name="TotalText" style="Base" fontSize="9" bold="true" forecolor="#000000" backcolor="#F5F0EB" mode="Opaque"/>
    <style name="FooterConfidential" style="Base" fontSize="7" forecolor="#000000"/>
    <query language="SQL"><![CDATA[
SELECT TRIM(t.svc_type_cd) AS SVC_TYPE_CD, COALESCE(sl.descr, TRIM(t.svc_type_cd)) AS SVC_TYPE_DESCR,
       COUNT(DISTINCT s.sa_id) AS SERVICE_AGREEMENTS,
       COUNT(DISTINCT s.bseg_id) AS SEGMENTS,
       COUNT(DISTINCT CASE WHEN TRIM(s.est_sw) = 'Y' THEN s.bseg_id END) AS ESTIMATED_SEGMENTS,
       COALESCE(SUM(h.calc_amt), 0) AS BILLED_AMT
FROM CISADM.CI_BILL b
JOIN CISADM.CI_BSEG s ON s.bill_id = b.bill_id AND TRIM(s.bseg_stat_flg) = '50'
JOIN CISADM.CI_SA sa ON sa.sa_id = s.sa_id
JOIN CISADM.CI_SA_TYPE t ON t.sa_type_cd = sa.sa_type_cd AND t.cis_division = sa.cis_division
LEFT JOIN CISADM.CI_SVC_TYPE_L sl ON sl.svc_type_cd = t.svc_type_cd AND sl.language_cd = 'ENG'
LEFT JOIN CISADM.CI_BSEG_CALC h ON h.bseg_id = s.bseg_id
WHERE TRIM(b.bill_stat_flg) = 'C' AND b.bill_dt >= $P{FROM_DT} AND b.bill_dt < $P{TO_DT} + INTERVAL '1' DAY
  AND COALESCE(NULLIF(TRIM(b.bill_cyc_cd), ''), '(none)') = $P{BILL_CYC_CD}
  AND ($P{BILL_CYC_CD_F} IS NULL OR TRIM(b.bill_cyc_cd) = TRIM($P{BILL_CYC_CD_F}))
  AND ($P{SVC_TYPE_CD_F} IS NULL OR TRIM(t.svc_type_cd) = TRIM($P{SVC_TYPE_CD_F}))
  AND ($P{CIS_DIVISION_F} IS NULL OR TRIM(sa.cis_division) = TRIM($P{CIS_DIVISION_F}))
  AND ($P{ACCT_ID_F} IS NULL OR TRIM(b.acct_id) = TRIM($P{ACCT_ID_F}))
GROUP BY TRIM(t.svc_type_cd), COALESCE(sl.descr, TRIM(t.svc_type_cd))
ORDER BY BILLED_AMT DESC
]]></query>
    <parameter name="FROM_DT" class="java.sql.Date">
        <defaultValueExpression><![CDATA[java.sql.Date.valueOf(java.time.LocalDate.now().withDayOfMonth(1).minusMonths(1).toString())]]></defaultValueExpression>
    </parameter>
    <parameter name="TO_DT" class="java.sql.Date">
        <defaultValueExpression><![CDATA[java.sql.Date.valueOf(java.time.LocalDate.now().withDayOfMonth(1).minusDays(1).toString())]]></defaultValueExpression>
    </parameter>
    <parameter name="BILL_CYC_CD" class="java.lang.String">
        <defaultValueExpression><![CDATA[""]]></defaultValueExpression>
    </parameter>
    <parameter name="BILL_CYC_CD_F" class="java.lang.String">
        <defaultValueExpression><![CDATA[null]]></defaultValueExpression>
    </parameter>
    <parameter name="SVC_TYPE_CD_F" class="java.lang.String">
        <defaultValueExpression><![CDATA[null]]></defaultValueExpression>
    </parameter>
    <parameter name="CIS_DIVISION_F" class="java.lang.String">
        <defaultValueExpression><![CDATA[null]]></defaultValueExpression>
    </parameter>
    <parameter name="ACCT_ID_F" class="java.lang.String">
        <defaultValueExpression><![CDATA[null]]></defaultValueExpression>
    </parameter>
    <field name="SVC_TYPE_CD" class="java.lang.String"/>
    <field name="SVC_TYPE_DESCR" class="java.lang.String"/>
    <field name="SERVICE_AGREEMENTS" class="java.lang.Long"/>
    <field name="SEGMENTS" class="java.lang.Long"/>
    <field name="ESTIMATED_SEGMENTS" class="java.lang.Long"/>
    <field name="BILLED_AMT" class="java.math.BigDecimal"/>
    <variable name="SUM_SERVICE_AGREEMENTS" class="java.lang.Long" calculation="Sum">
        <expression><![CDATA[$F{SERVICE_AGREEMENTS}]]></expression>
    </variable>
    <variable name="SUM_SEGMENTS" class="java.lang.Long" calculation="Sum">
        <expression><![CDATA[$F{SEGMENTS}]]></expression>
    </variable>
    <variable name="SUM_ESTIMATED_SEGMENTS" class="java.lang.Long" calculation="Sum">
        <expression><![CDATA[$F{ESTIMATED_SEGMENTS}]]></expression>
    </variable>
    <variable name="SUM_BILLED_AMT" class="java.math.BigDecimal" calculation="Sum">
        <expression><![CDATA[$F{BILLED_AMT}]]></expression>
    </variable>
    <title height="14">
            <element kind="textField" x="0" y="0" width="778" height="14" style="SubHeader" hTextAlign="Left" vTextAlign="Middle" blankWhenNull="true" textAdjust="StretchHeight"><expression><![CDATA["By service type in cycle " + $P{BILL_CYC_CD}]]></expression></element>
    </title>
    <columnHeader height="14">
            <element kind="staticText" x="0" y="0" width="60" height="14" style="SubHeader" hTextAlign="Left" vTextAlign="Middle"><text><![CDATA[Type]]></text></element>
            <element kind="staticText" x="60" y="0" width="328" height="14" style="SubHeader" hTextAlign="Left" vTextAlign="Middle"><text><![CDATA[Service Type]]></text></element>
            <element kind="staticText" x="388" y="0" width="90" height="14" style="SubHeader" hTextAlign="Right" vTextAlign="Middle"><text><![CDATA[SAs]]></text></element>
            <element kind="staticText" x="478" y="0" width="90" height="14" style="SubHeader" hTextAlign="Right" vTextAlign="Middle"><text><![CDATA[Segments]]></text></element>
            <element kind="staticText" x="568" y="0" width="90" height="14" style="SubHeader" hTextAlign="Right" vTextAlign="Middle"><text><![CDATA[Estimated]]></text></element>
            <element kind="staticText" x="658" y="0" width="120" height="14" style="SubHeader" hTextAlign="Right" vTextAlign="Middle"><text><![CDATA[Billed Amount]]></text></element>
    </columnHeader>
    <detail>
        <band height="13">
            <element kind="textField" x="0" y="0" width="60" height="13" style="SubText" hTextAlign="Left" vTextAlign="Middle" blankWhenNull="true" textAdjust="StretchHeight"><expression><![CDATA[$F{SVC_TYPE_CD}]]></expression></element>
            <element kind="textField" x="60" y="0" width="328" height="13" style="SubText" hTextAlign="Left" vTextAlign="Middle" blankWhenNull="true" textAdjust="StretchHeight"><expression><![CDATA[$F{SVC_TYPE_DESCR}]]></expression></element>
            <element kind="textField" x="388" y="0" width="90" height="13" style="SubText" hTextAlign="Right" vTextAlign="Middle" blankWhenNull="true" textAdjust="StretchHeight" pattern="#,##0"><expression><![CDATA[$F{SERVICE_AGREEMENTS}]]></expression></element>
            <element kind="textField" x="478" y="0" width="90" height="13" style="SubText" hTextAlign="Right" vTextAlign="Middle" blankWhenNull="true" textAdjust="StretchHeight" pattern="#,##0"><expression><![CDATA[$F{SEGMENTS}]]></expression></element>
            <element kind="textField" x="568" y="0" width="90" height="13" style="SubText" hTextAlign="Right" vTextAlign="Middle" blankWhenNull="true" textAdjust="StretchHeight" pattern="#,##0"><expression><![CDATA[$F{ESTIMATED_SEGMENTS}]]></expression></element>
            <element kind="textField" x="658" y="0" width="120" height="13" style="SubText" hTextAlign="Right" vTextAlign="Middle" blankWhenNull="true" textAdjust="StretchHeight" pattern="#,##0.00;(#,##0.00)"><expression><![CDATA[$F{BILLED_AMT}]]></expression></element>
        </band>
    </detail>
    <summary height="16">
            <element kind="staticText" x="0" y="0" width="60" height="13" style="SubHeader" hTextAlign="Left" vTextAlign="Middle"><text><![CDATA[Subtotal]]></text></element>
            <element kind="staticText" x="60" y="0" width="328" height="13" style="SubHeader" hTextAlign="Left" vTextAlign="Middle"><text><![CDATA[]]></text></element>
            <element kind="textField" x="388" y="0" width="90" height="13" style="SubHeader" hTextAlign="Right" vTextAlign="Middle" blankWhenNull="true" textAdjust="StretchHeight" pattern="#,##0"><expression><![CDATA[$V{SUM_SERVICE_AGREEMENTS}]]></expression></element>
            <element kind="textField" x="478" y="0" width="90" height="13" style="SubHeader" hTextAlign="Right" vTextAlign="Middle" blankWhenNull="true" textAdjust="StretchHeight" pattern="#,##0"><expression><![CDATA[$V{SUM_SEGMENTS}]]></expression></element>
            <element kind="textField" x="568" y="0" width="90" height="13" style="SubHeader" hTextAlign="Right" vTextAlign="Middle" blankWhenNull="true" textAdjust="StretchHeight" pattern="#,##0"><expression><![CDATA[$V{SUM_ESTIMATED_SEGMENTS}]]></expression></element>
            <element kind="textField" x="658" y="0" width="120" height="13" style="SubHeader" hTextAlign="Right" vTextAlign="Middle" blankWhenNull="true" textAdjust="StretchHeight" pattern="#,##0.00;(#,##0.00)"><expression><![CDATA[$V{SUM_BILLED_AMT}]]></expression></element>
    </summary>
</jasperReport>
