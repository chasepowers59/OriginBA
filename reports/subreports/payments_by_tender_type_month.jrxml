    xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
    name="payments_by_tender_type_month" pageWidth="778" pageHeight="595" orientation="Landscape"
    columnWidth="778" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0"
    whenNoDataType="AllSectionsNoDetail" uuid="9aac602e-86c1-5b7d-a4da-49e01e8ad4ae">
    <property name="net.sf.jasperreports.query.timeout" value="600"/>
    <property name="net.sf.jasperreports.export.xls.remove.empty.space.between.rows" value="true"/>
    <style name="Base" isDefault="true" fontName="Aptos" fontSize="9"/>
    <style name="TitleSapphire" style="Base" fontSize="18" isBold="true" forecolor="#006FAC"/>
    <style name="H3" style="Base" fontSize="10" forecolor="#0F4761"/>
    <style name="HeaderSapphire" style="Base" fontSize="9" isBold="true" forecolor="#FFFFFF" backcolor="#006FAC" mode="Opaque"/>
    <style name="DetailText" style="Base" fontSize="9" forecolor="#000000" backcolor="#F5F0EB" mode="Opaque"/>
    <style name="SubHeader" style="Base" fontSize="8" isBold="true" forecolor="#1348AB"/>
    <style name="SubText" style="Base" fontSize="8" forecolor="#000000"/>
    <style name="TotalText" style="Base" fontSize="9" isBold="true" forecolor="#000000" backcolor="#F5F0EB" mode="Opaque"/>
    <style name="FooterConfidential" style="Base" fontSize="7" forecolor="#000000"/>
    <parameter name="FROM_DT" class="java.sql.Date">
        <defaultValueExpression><![CDATA[java.sql.Date.valueOf(java.time.LocalDate.now().withDayOfMonth(1).minusMonths(1).toString())]]></defaultValueExpression>
    </parameter>
    <parameter name="TO_DT" class="java.sql.Date">
        <defaultValueExpression><![CDATA[java.sql.Date.valueOf(java.time.LocalDate.now().withDayOfMonth(1).minusDays(1).toString())]]></defaultValueExpression>
    </parameter>
    <parameter name="CLIENT_NAME" isForPrompting="false" class="java.lang.String">
        <defaultValueExpression><![CDATA["SmartCity Client"]]></defaultValueExpression>
    </parameter>
    <parameter name="TENDER_TYPE_CD" class="java.lang.String">
        <defaultValueExpression><![CDATA[""]]></defaultValueExpression>
    </parameter>
    <queryString language="SQL"><![CDATA[
SELECT TO_CHAR(e.pay_dt, 'YYYY-MM') AS PAY_MONTH,
       COUNT(CASE WHEN NULLIF(TRIM(t.can_rsn_cd), '') IS NULL THEN 1 END) AS TENDERS,
       COALESCE(SUM(CASE WHEN NULLIF(TRIM(t.can_rsn_cd), '') IS NULL THEN t.tender_amt ELSE 0 END), 0) AS TENDER_AMT,
       COUNT(CASE WHEN NULLIF(TRIM(t.can_rsn_cd), '') IS NOT NULL THEN 1 END) AS CANCELLED,
       COUNT(DISTINCT t.payor_acct_id) AS PAYOR_ACCOUNTS
FROM CISADM.CI_PAY_TNDR t
JOIN CISADM.CI_PAY_EVENT e ON e.pay_event_id = t.pay_event_id
WHERE e.pay_dt >= $P{FROM_DT} AND e.pay_dt < $P{TO_DT} + INTERVAL '1' DAY AND TRIM(t.tender_type_cd) = TRIM($P{TENDER_TYPE_CD})
GROUP BY TO_CHAR(e.pay_dt, 'YYYY-MM')
ORDER BY PAY_MONTH
]]></queryString>
    <field name="PAY_MONTH" class="java.lang.String"/>
    <field name="TENDERS" class="java.lang.Long"/>
    <field name="TENDER_AMT" class="java.math.BigDecimal"/>
    <field name="CANCELLED" class="java.lang.Long"/>
    <field name="PAYOR_ACCOUNTS" class="java.lang.Long"/>
    <variable name="SUM_TENDERS" class="java.lang.Long" calculation="Sum">
        <variableExpression><![CDATA[$F{TENDERS}]]></variableExpression>
    </variable>
    <variable name="SUM_TENDER_AMT" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{TENDER_AMT}]]></variableExpression>
    </variable>
    <variable name="SUM_CANCELLED" class="java.lang.Long" calculation="Sum">
        <variableExpression><![CDATA[$F{CANCELLED}]]></variableExpression>
    </variable>
    <variable name="SUM_PAYOR_ACCOUNTS" class="java.lang.Long" calculation="Sum">
        <variableExpression><![CDATA[$F{PAYOR_ACCOUNTS}]]></variableExpression>
    </variable>
