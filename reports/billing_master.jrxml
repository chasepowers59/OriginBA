            <textField><reportElement x="170" y="0" width="180" height="18" uuid="83d6f286-e4ef-40d0-9f10-d0fff79dd0c7"/><textFieldExpression><![CDATA[$F{CUSTOMER_NAME}]]></textFieldExpression></textField>
            <textField pattern="yyyy-MM-dd"><reportElement x="355" y="0" width="90" height="18" uuid="98328f1d-98b4-4e5c-a77d-7f480d2f7b3e"/><textFieldExpression><![CDATA[$F{BILL_DATE}]]></textFieldExpression></textField>
            <textField pattern="#,##0.00"><reportElement x="450" y="0" width="105" height="18" uuid="7527e993-e188-4a2b-8abf-61762f0d318f"/><textElement textAlignment="Right"/><textFieldExpression><![CDATA[$F{BILL_TOTAL}]]></textFieldExpression></textField>

