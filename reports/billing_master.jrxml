<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
    name="billing_master"
    pageWidth="595"
    pageHeight="842"
    orientation="Portrait"
    columnWidth="555"
    leftMargin="20"
    rightMargin="20"
    topMargin="20"
    bottomMargin="20"
    uuid="f4ab5d9a-87d2-4423-8619-4f0050a6528f">

    <property name="com.jaspersoft.studio.data.defaultdataadapter" value="ORIGIN_DEV_DS"/>

    <parameter name="CLIENT_ID" class="java.lang.String"/>
    <parameter name="START_TS" class="java.sql.Timestamp"/>
    <parameter name="END_TS" class="java.sql.Timestamp"/>
    <parameter name="CLIENT_LOGO_URL" class="java.lang.String" isForPrompting="false"/>
    <parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
        <defaultValueExpression><![CDATA["reports/subreports/"]]></defaultValueExpression>
    </parameter>

    <queryString language="SQL">
        <![CDATA[
SELECT
    B.BILL_ID,
    B.ACCT_ID AS CUSTOMER_ID,
    NVL(PN.ENTITY_NAME, 'N/A') AS CUSTOMER_NAME,
    B.BILL_STAT_FLG AS BILL_STATUS_CD,
    NULLIF(TRIM(BILL_STAT_LU.VALUE_NAME), '') AS BILL_STATUS_DESCR,
    B.BILL_DT AS BILL_DATE,
    B.DUE_DT AS DUE_DATE,
    NVL(SUM(FT.CUR_AMT), 0) AS BILL_TOTAL
FROM CISADM.CI_BILL B
LEFT JOIN CISADM.CI_ACCT_PER AP
  ON AP.ACCT_ID = B.ACCT_ID
 AND AP.MAIN_CUST_SW = 'Y'
LEFT JOIN CISADM.CI_PER_NAME PN
  ON PN.PER_ID = AP.PER_ID
 AND PN.PRIM_NAME_SW = 'Y'
LEFT JOIN CISADM.CI_LOOKUP_VAL BILL_STAT_LU
  ON TRIM(BILL_STAT_LU.FIELD_NAME) = 'BILL_STAT_FLG'
 AND TRIM(BILL_STAT_LU.FIELD_VALUE) = TRIM(B.BILL_STAT_FLG)
LEFT JOIN CISADM.CI_FT FT
  ON FT.BILL_ID = B.BILL_ID
 AND FT.FREEZE_SW = 'Y'
 AND FT.FT_TYPE_FLG NOT IN ('PS', 'PX')
WHERE NULLIF(TRIM(B.BILL_CYC_CD), '') = NULLIF(TRIM($P{CLIENT_ID}), '')
  AND B.BILL_DT >= $P{START_TS}
  AND B.BILL_DT <  $P{END_TS}
GROUP BY
    B.BILL_ID,
    B.ACCT_ID,
    PN.ENTITY_NAME,
    B.BILL_STAT_FLG,
    BILL_STAT_LU.VALUE_NAME,
    B.BILL_DT,
    B.DUE_DT
ORDER BY B.BILL_ID
        ]]>
    </queryString>

    <field name="BILL_ID" class="java.lang.String"/>
    <field name="CUSTOMER_ID" class="java.lang.String"/>
    <field name="CUSTOMER_NAME" class="java.lang.String"/>
    <field name="BILL_STATUS_CD" class="java.lang.String"/>
    <field name="BILL_STATUS_DESCR" class="java.lang.String"/>
    <field name="BILL_DATE" class="java.sql.Timestamp"/>
    <field name="DUE_DATE" class="java.sql.Timestamp"/>
    <field name="BILL_TOTAL" class="java.math.BigDecimal"/>

