                    <font size="16" isBold="true"/>
                </textElement>
                <text><![CDATA[Customer Contact Letter Printability Check]]></text>
            </staticText>
        </band>
    </title>

    <columnHeader>
        <band height="24">
            <staticText><reportElement x="0" y="0" width="80" height="24" uuid="bb90ef3a-70cf-4eb3-8be1-4f07cdb4f4b5"/><text><![CDATA[CC_ID]]></text></staticText>
            <staticText><reportElement x="80" y="0" width="80" height="24" uuid="fdbf2f81-3753-41ea-b2d3-70061a4fc280"/><text><![CDATA[ACCT_ID]]></text></staticText>
            <staticText><reportElement x="160" y="0" width="125" height="24" uuid="65d92d9a-311d-4b45-b26b-6ca22f31d648"/><text><![CDATA[CC_DTTM]]></text></staticText>
            <staticText><reportElement x="285" y="0" width="105" height="24" uuid="d6f8b1ad-0cad-4bcb-b9f6-bc50e9d5bef8"/><text><![CDATA[STATUS]]></text></staticText>
            <staticText><reportElement x="390" y="0" width="220" height="24" uuid="c5f3cc63-6be0-46b8-ab8d-f02e2898d3d7"/><text><![CDATA[REASON]]></text></staticText>
            <staticText><reportElement x="610" y="0" width="192" height="24" uuid="11f5bccf-8491-4f91-96e5-2f87dbf398f4"/><text><![CDATA[RECIPIENT / ADDRESS]]></text></staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="32">
            <textField><reportElement x="0" y="0" width="80" height="16" uuid="91c894b7-47dc-4739-b3f8-5260139f9aa2"/><textFieldExpression><![CDATA[$F{CC_ID}]]></textFieldExpression></textField>
            <textField><reportElement x="80" y="0" width="80" height="16" uuid="3a816972-ef3d-43f7-8228-8f45bc9946aa"/><textFieldExpression><![CDATA[$F{ACCT_ID}]]></textFieldExpression></textField>
            <textField pattern="yyyy-MM-dd HH:mm"><reportElement x="160" y="0" width="125" height="16" uuid="f7069397-7aef-4676-b9d6-c85bf6f5fe25"/><textFieldExpression><![CDATA[$F{CC_DTTM}]]></textFieldExpression></textField>
            <textField><reportElement x="285" y="0" width="105" height="16" uuid="b5138f57-8b45-4379-bf00-7c8e0fd53f3d"/><textFieldExpression><![CDATA[$F{PRINT_STATUS}]]></textFieldExpression></textField>
            <textField isStretchWithOverflow="true"><reportElement x="390" y="0" width="220" height="16" uuid="836909da-2eb6-4af9-b09e-494eb2f37ea7"/><textFieldExpression><![CDATA[$F{BLOCK_REASON}]]></textFieldExpression></textField>
            <textField isStretchWithOverflow="true"><reportElement x="610" y="0" width="192" height="30" uuid="581d53c5-8d75-4f27-b507-5cc5f2f4fa7d"/><textFieldExpression><![CDATA[($F{RECIPIENT_NAME} == null ? "-" : $F{RECIPIENT_NAME}) + " | " + ($F{ADDRESS1} == null ? "-" : $F{ADDRESS1}) + ", " + ($F{CITY} == null ? "-" : $F{CITY}) + ", " + ($F{STATE} == null ? "-" : $F{STATE}) + " " + ($F{POSTAL} == null ? "-" : $F{POSTAL})]]></textFieldExpression></textField>
        </band>
    </detail>
</jasperReport>
