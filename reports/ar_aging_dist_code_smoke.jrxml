            </staticText>
            <staticText>
                <reportElement x="80" y="0" width="120" height="18" uuid="e5f6a7b8-c9d0-4123-e456-789012abcde0"/>
                <text><![CDATA[DB User]]></text>
            </staticText>
            <staticText>
                <reportElement x="200" y="0" width="150" height="18" uuid="e5f6a7b8-c9d0-4123-e456-789012abcde1"/>
                <text><![CDATA[DB Name]]></text>
            </staticText>
            <staticText>
                <reportElement x="350" y="0" width="100" height="18" uuid="e5f6a7b8-c9d0-4123-e456-789012abcde2"/>
                <text><![CDATA[As-Of]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="18">
            <textField>
                <reportElement x="0" y="0" width="80" height="18" uuid="f6a7b8c9-d0e1-4234-f567-890123abcdef"/>
                <textFieldExpression><![CDATA[$F{STATUS}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="80" y="0" width="120" height="18" uuid="f6a7b8c9-d0e1-4234-f567-890123abcde0"/>
                <textFieldExpression><![CDATA[$F{DB_USER}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="200" y="0" width="150" height="18" uuid="f6a7b8c9-d0e1-4234-f567-890123abcde1"/>
                <textFieldExpression><![CDATA[$F{DB_NAME}]]></textFieldExpression>
            </textField>
            <textField pattern="yyyy-MM-dd">
                <reportElement x="350" y="0" width="100" height="18" uuid="f6a7b8c9-d0e1-4234-f567-890123abcde2"/>
                <textFieldExpression><![CDATA[$F{AS_OF_USED}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <pageFooter>
        <band height="16">
            <textField>
                <reportElement x="0" y="0" width="555" height="14" uuid="a7b8c9d0-e1f2-4345-a678-901234abcdef"/>
