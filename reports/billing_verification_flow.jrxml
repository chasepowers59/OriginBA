        <groupFooter>
            <band height="24">
                <frame>
                    <reportElement style="CycleFooterCell" x="0" y="2" width="1150" height="20" uuid="cc6fce94-c6e4-46ba-aea9-bee955abf98f"/>
                    <box><pen lineWidth="0.5" lineColor="#BFDBFE"/></box>
                    <textField>
                        <reportElement x="10" y="2" width="1130" height="16" uuid="46a53f85-d769-4585-a888-ac9f991e968f"/>
                        <textFieldExpression><![CDATA[
"Cycle result: "
+ (((($F{MISSING_ACTIVE_ACCOUNT_COUNT} != null && $F{MISSING_ACTIVE_ACCOUNT_COUNT}.doubleValue() > 0d)
  || ($F{MISSING_ACTIVE_SA_COUNT} != null && $F{MISSING_ACTIVE_SA_COUNT}.doubleValue() > 0d)
  || ($V{ERROR_ROWS_IN_CYCLE} != null && $V{ERROR_ROWS_IN_CYCLE}.intValue() > 0))) ? "ATTENTION REQUIRED" : "ON TRACK")
+ " | Error rows shown: " + ($V{ERROR_ROWS_IN_CYCLE} == null ? "0" : $V{ERROR_ROWS_IN_CYCLE}.toString())
+ (((($F{MISSING_ACTIVE_ACCOUNT_COUNT} != null && $F{MISSING_ACTIVE_ACCOUNT_COUNT}.doubleValue() > 0d)
   || ($F{MISSING_ACTIVE_SA_COUNT} != null && $F{MISSING_ACTIVE_SA_COUNT}.doubleValue() > 0d))
   && ($V{ERROR_ROWS_IN_CYCLE} == null || $V{ERROR_ROWS_IN_CYCLE}.intValue() == 0)) ? " | No bill/segment status errors were returned for this cycle. Review upstream billing completeness." : "")
                        ]]></textFieldExpression>
                    </textField>
                </frame>
            </band>
        </groupFooter>
    </group>

    <title>
        <band height="138">
            <frame>
                <reportElement x="0" y="0" width="1150" height="64" uuid="01076dba-8d4d-488e-9b7d-23c801e68b0a" mode="Opaque" backcolor="#1348AB"/>
            </frame>
            <staticText>
                <reportElement style="TitleBlue" x="18" y="12" width="900" height="24" uuid="66c47662-63d8-41f4-9a24-4d5299bac0c1"/>
                <text><![CDATA[Billing Verification Flow]]></text>
            </staticText>
            <textField>
                <reportElement style="MetaBlue" x="18" y="40" width="1110" height="18" uuid="23476211-7111-42de-aa53-e697042efdb8"/>
                <textFieldExpression><![CDATA[
"BILL_CYCLE=" + (($P{BILL_CYCLE_CODE} == null || $P{BILL_CYCLE_CODE}.trim().length() == 0) ? "ALL" : $P{BILL_CYCLE_CODE}.trim())
+ " | MOST_RECENT_ONLY=" + (($P{MOST_RECENT_ONLY} == null || !$P{MOST_RECENT_ONLY}.booleanValue()) ? "NO" : "YES")
                ]]></textFieldExpression>
            </textField>

            <frame>
                <reportElement style="SummaryBlue" x="0" y="74" width="1150" height="56" uuid="a4bc8ff2-0312-49b6-a06a-f2a0b38f67f6"/>
                <box><pen lineWidth="0.5"/></box>
                <textField evaluationTime="Report"><reportElement x="10" y="10" width="1125" height="16" uuid="ad48f397-c705-4ac4-92cb-48c54e312ca1"/><textFieldExpression><![CDATA[
"Cycles in scope: " + $V{CYCLE_COUNT}
+ " | Cycles with gaps: " + $V{CYCLES_WITH_GAPS}
+ " | Cycles with caught status errors: " + $V{CYCLES_WITH_ERRORS}
+ " | Error rows shown: " + $V{ERROR_ROWS_IN_REPORT}
                ]]></textFieldExpression></textField>
                <staticText>
                    <reportElement x="10" y="30" width="1125" height="18" uuid="08fd2f0c-33d8-435c-8efb-7bc7e2aa7eb1"/>
                    <text><![CDATA[Read each cycle left to right: expected active population, actual billed population, bills created, bill segments created, then the remaining gap. Exception rows below show caught bill or segment status issues for the same cycle.]]></text>
                </staticText>
            </frame>
        </band>
    </title>

    <columnHeader>
        <band height="24">
            <staticText><reportElement style="HeaderBlue" x="0" y="0" width="110" height="24" uuid="7851f936-c4ad-4827-b0f4-0edc28be48d8"/><text><![CDATA[Account]]></text></staticText>
            <staticText><reportElement style="HeaderBlue" x="110" y="0" width="110" height="24" uuid="e6cd77a1-74c4-44c1-bcb4-676762338cf3"/><text><![CDATA[Service Agmt]]></text></staticText>
            <staticText><reportElement style="HeaderBlue" x="220" y="0" width="80" height="24" uuid="c2709dc5-2857-4942-812a-7184b5a25039"/><text><![CDATA[Premise]]></text></staticText>
            <staticText><reportElement style="HeaderBlue" x="300" y="0" width="90" height="24" uuid="6ef95fc7-f981-4427-a71d-dd2a7aa8cbf8"/><text><![CDATA[Bill ID]]></text></staticText>
            <staticText><reportElement style="HeaderBlue" x="390" y="0" width="110" height="24" uuid="11ebf2e9-4f24-4f45-843d-4a18f3420d8d"/><text><![CDATA[Segment ID]]></text></staticText>
            <staticText><reportElement style="HeaderBlue" x="500" y="0" width="140" height="24" uuid="3d0f14f9-a4d5-4c1c-b9b9-dceb70556a94"/><text><![CDATA[Bill Status]]></text></staticText>
