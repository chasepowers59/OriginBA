    <queryField id="MISSING_ACTIVE_SA_COUNT"/>
    <queryField id="RECON_CYCLE_LAST_EVENT_DATE"/>
    <queryField id="MOST_RECENT_BILL_CYCLE_SW_RECON"/>
    <queryField id="ACCOUNT_ID"/>
    <queryField id="SERVICE_AGREEMENT_ID"/>
    <queryField id="PREMISE_ID"/>
    <queryField id="BILL_ID_DETAIL"/>
    <queryField id="BILL_SEGMENT_ID_DETAIL"/>
    <queryField id="BILL_DATE"/>
    <queryField id="BILL_CREATE_DATE"/>
    <queryField id="BSEG_CREATE_DATE"/>
    <queryField id="BILL_STATUS_DESCRIPTION"/>
    <queryField id="BSEG_STATUS_DESCRIPTION"/>
    <queryField id="IS_ERROR_SW"/>
    <queryField id="ERROR_REASON"/>
  </queryFields>
</query>
    ]]></queryString>

