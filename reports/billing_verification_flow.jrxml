                        <reportElement x="10" y="5" width="660" height="16" uuid="d168dc57-6c4a-438f-b646-f1f4910c2081"/>
                        <textElement><font isBold="true"/></textElement>
                        <textFieldExpression><![CDATA[
"Bill Cycle " + ($F{BILL_CYCLE_CODE} == null ? "UNASSIGNED" : $F{BILL_CYCLE_CODE})
+ " | " + ($F{BILL_CYCLE_DESCRIPTION} == null ? "No description" : $F{BILL_CYCLE_DESCRIPTION})
                        ]]></textFieldExpression>
                    </textField>
                    <textField pattern="yyyy-MM-dd">
                        <reportElement x="760" y="5" width="380" height="16" uuid="27f7c3f8-432a-4cfa-9ff0-c8ca13cdf66d"/>
                        <textElement textAlignment="Right"/>
                        <textFieldExpression><![CDATA[
"Latest Event Date: " + ($F{RECON_CYCLE_LAST_EVENT_DATE} == null ? "N/A" : new java.text.SimpleDateFormat("yyyy-MM-dd").format($F{RECON_CYCLE_LAST_EVENT_DATE}))
                        ]]></textFieldExpression>
                    </textField>
                </frame>

                <frame>
                    <reportElement style="FlowExpected" x="0" y="34" width="223" height="62" uuid="cd0558e0-4cd1-49ec-bc17-b20fbe1db4e2"/>
