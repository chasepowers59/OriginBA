    <field name="ERROR_REASON" class="java.lang.String"><property name="net.sf.jasperreports.query.field.id" value="ERROR_REASON"/></field>

    <sortField name="BILL_CYCLE_CODE" order="Ascending"/>
    <sortField name="ACCOUNT_ID" order="Ascending"/>

    <variable name="CYCLE_COUNT" class="java.lang.Long" calculation="DistinctCount">
        <variableExpression><![CDATA[$F{BILL_CYCLE_CODE}]]></variableExpression>
        <initialValueExpression><![CDATA[0L]]></initialValueExpression>
    </variable>
    <variable name="CYCLES_WITH_GAPS" class="java.lang.Long" calculation="DistinctCount">
        <variableExpression><![CDATA[
(($F{MISSING_ACTIVE_ACCOUNT_COUNT} != null && $F{MISSING_ACTIVE_ACCOUNT_COUNT}.doubleValue() > 0d)
|| ($F{MISSING_ACTIVE_SA_COUNT} != null && $F{MISSING_ACTIVE_SA_COUNT}.doubleValue() > 0d)) ? $F{BILL_CYCLE_CODE} : null
        ]]></variableExpression>
        <initialValueExpression><![CDATA[0L]]></initialValueExpression>
    </variable>
    <variable name="CYCLES_WITH_ERRORS" class="java.lang.Long" calculation="DistinctCount">
        <variableExpression><![CDATA["Y".equalsIgnoreCase($F{IS_ERROR_SW}) ? $F{BILL_CYCLE_CODE} : null]]></variableExpression>
        <initialValueExpression><![CDATA[0L]]></initialValueExpression>
    </variable>
    <variable name="ERROR_ROWS_IN_REPORT" class="java.lang.Integer" calculation="Sum">
        <variableExpression><![CDATA["Y".equalsIgnoreCase($F{IS_ERROR_SW}) ? 1 : 0]]></variableExpression>
        <initialValueExpression><![CDATA[0]]></initialValueExpression>
    </variable>
    <variable name="ERROR_ROWS_IN_CYCLE" class="java.lang.Integer" calculation="Sum" resetType="Group" resetGroup="BILL_CYCLE_GROUP">
        <variableExpression><![CDATA["Y".equalsIgnoreCase($F{IS_ERROR_SW}) ? 1 : 0]]></variableExpression>
        <initialValueExpression><![CDATA[0]]></initialValueExpression>
    </variable>

    <filterExpression><![CDATA[
($F{BILL_CYCLE_CODE} != null)
&& ($P{BILL_CYCLE_CODE} == null || $P{BILL_CYCLE_CODE}.trim().length() == 0 || $F{BILL_CYCLE_CODE}.equalsIgnoreCase($P{BILL_CYCLE_CODE}.trim()))
&& ($P{MOST_RECENT_ONLY} == null || !$P{MOST_RECENT_ONLY}.booleanValue() || "Y".equalsIgnoreCase($F{MOST_RECENT_BILL_CYCLE_SW_RECON}))
    ]]></filterExpression>

    <group name="BILL_CYCLE_GROUP">
        <groupExpression><![CDATA[$F{BILL_CYCLE_CODE}]]></groupExpression>
        <groupHeader>
