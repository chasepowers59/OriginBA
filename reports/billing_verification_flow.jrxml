                        <textFieldExpression><![CDATA[
"Bills: " + ($F{ACTUAL_BILL_COUNT} == null ? "0" : new java.text.DecimalFormat("#,##0").format($F{ACTUAL_BILL_COUNT}))
                        ]]></textFieldExpression>
                    </textField>
                </frame>

