    <field name="BILL_ID_DETAIL" class="java.lang.String"><property name="net.sf.jasperreports.query.field.id" value="BILL_ID_DETAIL"/></field>
    <field name="BILL_SEGMENT_ID_DETAIL" class="java.lang.String"><property name="net.sf.jasperreports.query.field.id" value="BILL_SEGMENT_ID_DETAIL"/></field>
