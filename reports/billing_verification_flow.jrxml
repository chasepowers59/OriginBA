                        <textFieldExpression><![CDATA[
"Missing Accounts: " + ($F{MISSING_ACTIVE_ACCOUNT_COUNT} == null ? "0" : new java.text.DecimalFormat("#,##0").format($F{MISSING_ACTIVE_ACCOUNT_COUNT}))
                        ]]></textFieldExpression>
                    </textField>
                    <textField>
                        <reportElement x="8" y="38" width="120" height="16" uuid="e001e84f-df8a-4e20-b0bb-79333dfb6140"/>
                        <textFieldExpression><![CDATA[
"Missing SAs: " + ($F{MISSING_ACTIVE_SA_COUNT} == null ? "0" : new java.text.DecimalFormat("#,##0").format($F{MISSING_ACTIVE_SA_COUNT}))
                        ]]></textFieldExpression>
                    </textField>
                    <textField>
                        <reportElement style="GapStatusCell" x="132" y="36" width="86" height="18" uuid="9c8ae44f-1b6f-4188-bcb9-9f3302d63372"/>
                        <textElement textAlignment="Center"/>
                        <textFieldExpression><![CDATA[
(($F{MISSING_ACTIVE_ACCOUNT_COUNT} != null && $F{MISSING_ACTIVE_ACCOUNT_COUNT}.doubleValue() > 0d)
|| ($F{MISSING_ACTIVE_SA_COUNT} != null && $F{MISSING_ACTIVE_SA_COUNT}.doubleValue() > 0d)) ? "ATTN" : "OK"
                        ]]></textFieldExpression>
                    </textField>
                </frame>
