                        <textFieldExpression><![CDATA[
"Accounts: " + ($F{EXPECTED_ACTIVE_ACCOUNT_COUNT} == null ? "0" : new java.text.DecimalFormat("#,##0").format($F{EXPECTED_ACTIVE_ACCOUNT_COUNT}))
+ " | SAs: " + ($F{EXPECTED_ACTIVE_SA_COUNT} == null ? "0" : new java.text.DecimalFormat("#,##0").format($F{EXPECTED_ACTIVE_SA_COUNT}))
                        ]]></textFieldExpression>
                    </textField>
                </frame>

