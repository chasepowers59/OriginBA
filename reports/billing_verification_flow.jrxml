+ " | SAs: " + ($F{ACTUAL_BILLED_SA_COUNT} == null ? "0" : new java.text.DecimalFormat("#,##0").format($F{ACTUAL_BILLED_SA_COUNT}))
                        ]]></textFieldExpression>
                    </textField>
