<?xml version="1.0" encoding="UTF-8"?>
<!--
  Fast AR Aging by Dist Code (as-of) — summary by GL Control Section + Dist detail.
  Pattern: one SQL query, JRXML groups/summary bands (not a second query).
  SA-level drill = separate report unit + hyperlink (do not put SA grain here).
-->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
    name="ar_aging_by_dist_code_asof_fast"
    pageWidth="842"
    pageHeight="595"
    orientation="Landscape"
    columnWidth="802"
    leftMargin="20"
    rightMargin="20"
    topMargin="20"
    bottomMargin="20"
    uuid="d4e5f6a7-b8c9-4012-d345-6789abcdef01">

    <property name="com.jaspersoft.studio.data.defaultdataadapter" value="ORIGIN_DEV_DS"/>
    <property name="net.sf.jasperreports.query.timeout" value="600"/>

    <style name="Base" fontName="SansSerif" fontSize="9"/>
    <style name="TitleBlue" style="Base" fontSize="16" isBold="true" forecolor="#0A4A8A"/>
    <style name="MetaBlue" style="Base" fontSize="10" forecolor="#0A4A8A"/>
    <style name="HeaderBlue" style="Base" fontSize="9" isBold="true" forecolor="#FFFFFF" backcolor="#0A4A8A"/>
    <style name="SectionHeader" style="Base" fontSize="10" isBold="true" forecolor="#FFFFFF" backcolor="#0A4A8A"/>
    <style name="DetailText" style="Base" fontSize="9"/>
    <style name="SectionTotal" style="Base" fontSize="9" isBold="true" backcolor="#D6E8F7"/>
    <style name="SummaryBlue" style="Base" fontSize="9" isBold="true" backcolor="#EAF3FF"/>

    <parameter name="AS_OF_DT" class="java.sql.Timestamp">
        <defaultValueExpression><![CDATA[new java.sql.Timestamp(java.sql.Date.valueOf("2026-06-30").getTime())]]></defaultValueExpression>
    </parameter>
    <parameter name="CLIENT_NAME" class="java.lang.String">
        <defaultValueExpression><![CDATA["Origin DEV"]]></defaultValueExpression>
    </parameter>
    <parameter name="SHOW_DIST_DETAIL" class="java.lang.String">
        <parameterDescription><![CDATA[Y = show Dist Code rows under each GL section; N = section totals only]]></parameterDescription>
        <defaultValueExpression><![CDATA["Y"]]></defaultValueExpression>
    </parameter>
    <parameter name="DISTRIBUTION_CODE" class="java.lang.String">
        <parameterDescription><![CDATA[Optional Dist Code filter (exact match). Leave blank for all.]]></parameterDescription>
        <defaultValueExpression><![CDATA[""]]></defaultValueExpression>
    </parameter>

    <queryString language="SQL"><![CDATA[
SELECT
    TRIM(st.dst_id) AS DISTRIBUTION_CODE,
    CASE
        WHEN TRIM(st.dst_id) IN ('A/R-WATER', 'A/R-SEWER', 'A/R-PA', 'A/P-OVPY')
            THEN '142000 Customer AR'
        WHEN TRIM(st.dst_id) = 'A/R-SOLWST'
            THEN '142050 Solid Waste AR'
        WHEN TRIM(st.dst_id) = 'A/R-CARDS'
            THEN '142060 Cards AR'
        WHEN TRIM(st.dst_id) = 'A/P-DEPOS'
            THEN '235000 Customer Deposits'
        WHEN TRIM(st.dst_id) LIKE 'E-WO%'
            THEN 'Write-Off DST (not AR control)'
        ELSE 'Other'
    END AS GL_CONTROL_SECTION,
    COUNT(DISTINCT ft.sa_id) AS SA_COUNT,
    ROUND(SUM(ft.cur_amt), 2) AS CURRENT_BAL,
    ROUND(SUM(CASE
        WHEN TRUNC($P{AS_OF_DT}) - TRUNC(ft.ars_dt) BETWEEN 0 AND 30 THEN ft.cur_amt
        ELSE 0 END), 2) AS AMT_0_30,
    ROUND(SUM(CASE
        WHEN TRUNC($P{AS_OF_DT}) - TRUNC(ft.ars_dt) BETWEEN 31 AND 60 THEN ft.cur_amt
        ELSE 0 END), 2) AS AMT_31_60,
    ROUND(SUM(CASE
        WHEN TRUNC($P{AS_OF_DT}) - TRUNC(ft.ars_dt) BETWEEN 61 AND 90 THEN ft.cur_amt
        ELSE 0 END), 2) AS AMT_61_90,
    ROUND(SUM(CASE
        WHEN TRUNC($P{AS_OF_DT}) - TRUNC(ft.ars_dt) BETWEEN 91 AND 120 THEN ft.cur_amt
        ELSE 0 END), 2) AS AMT_91_120,
    ROUND(SUM(CASE
        WHEN TRUNC($P{AS_OF_DT}) - TRUNC(ft.ars_dt) > 120 THEN ft.cur_amt
        ELSE 0 END), 2) AS AMT_121_PLUS
FROM cisadm.ci_ft ft
JOIN cisadm.ci_sa sa
  ON sa.sa_id = ft.sa_id
JOIN cisadm.ci_sa_type st
  ON st.sa_type_cd = sa.sa_type_cd
 AND st.cis_division = sa.cis_division
WHERE ft.freeze_sw = 'Y'
  AND ft.not_in_ars_sw = 'N'
  AND ft.ars_dt IS NOT NULL
  AND TRUNC(ft.ars_dt) <= TRUNC($P{AS_OF_DT})
  AND (
        $P{DISTRIBUTION_CODE} IS NULL
        OR TRIM($P{DISTRIBUTION_CODE}) IS NULL
        OR LENGTH(TRIM($P{DISTRIBUTION_CODE})) = 0
        OR TRIM(st.dst_id) = TRIM($P{DISTRIBUTION_CODE})
      )
GROUP BY
    TRIM(st.dst_id),
    CASE
        WHEN TRIM(st.dst_id) IN ('A/R-WATER', 'A/R-SEWER', 'A/R-PA', 'A/P-OVPY')
            THEN '142000 Customer AR'
        WHEN TRIM(st.dst_id) = 'A/R-SOLWST'
            THEN '142050 Solid Waste AR'
        WHEN TRIM(st.dst_id) = 'A/R-CARDS'
            THEN '142060 Cards AR'
        WHEN TRIM(st.dst_id) = 'A/P-DEPOS'
            THEN '235000 Customer Deposits'
        WHEN TRIM(st.dst_id) LIKE 'E-WO%'
            THEN 'Write-Off DST (not AR control)'
        ELSE 'Other'
    END
ORDER BY GL_CONTROL_SECTION, DISTRIBUTION_CODE
    ]]></queryString>

