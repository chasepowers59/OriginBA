                <textFieldExpression><![CDATA[
(($F{DAYS_OLD} != null && $F{DAYS_OLD}.intValue() >= $P{STALE_DAYS}.intValue()) || ($F{CANCEL_REASON} != null && $F{CANCEL_REASON}.trim().length() > 0)) ? "HIGH"
 : ((("Y".equalsIgnoreCase($F{APPOINTMENT_FLG}) || "YES".equalsIgnoreCase($F{APPOINTMENT_FLG}) || "1".equalsIgnoreCase($F{APPOINTMENT_FLG})) && ($F{STATUS_UPD_DTTM} == null)) ? "MED" : "NORMAL")
                ]]></textFieldExpression>
            </textField>
