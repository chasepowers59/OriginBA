    <sortField name="DAYS_OLD" order="Descending"/>

    <variable name="TOTAL_ACTIVITIES" class="java.lang.Integer" calculation="Count">
        <variableExpression><![CDATA[$F{D1_ACTIVITY_ID}]]></variableExpression>
        <initialValueExpression><![CDATA[0]]></initialValueExpression>
    </variable>
    <variable name="STALE_CNT" class="java.lang.Integer" calculation="Sum">
        <variableExpression><![CDATA[
((($F{STATUS_DESCR} != null && $F{STATUS_DESCR}.toUpperCase().contains("COMPLETE"))
 || ($F{BO_STATUS_CD} != null && $F{BO_STATUS_CD}.toUpperCase().contains("COMPLETE"))) ? 0 :
 (($F{DAYS_OLD} != null && $F{DAYS_OLD}.intValue() >= $P{STALE_DAYS}.intValue()) ? 1 : 0))
        ]]></variableExpression>
        <initialValueExpression><![CDATA[0]]></initialValueExpression>
    </variable>
    <variable name="CANCELLED_CNT" class="java.lang.Integer" calculation="Sum">
        <variableExpression><![CDATA[
(($F{CANCEL_REASON} != null && $F{CANCEL_REASON}.trim().length() > 0)
 || ($F{STATUS_DESCR} != null && $F{STATUS_DESCR}.toUpperCase().contains("CANCEL"))
 || ($F{BO_STATUS_CD} != null && $F{BO_STATUS_CD}.toUpperCase().contains("CANCEL"))) ? 1 : 0
        ]]></variableExpression>
        <initialValueExpression><![CDATA[0]]></initialValueExpression>
    </variable>
    <variable name="APPT_REQUIRED_CNT" class="java.lang.Integer" calculation="Sum">
        <variableExpression><![CDATA[
("Y".equalsIgnoreCase($F{APPOINTMENT_FLG}) || "YES".equalsIgnoreCase($F{APPOINTMENT_FLG}) || "1".equalsIgnoreCase($F{APPOINTMENT_FLG})) ? 1 : 0
        ]]></variableExpression>
        <initialValueExpression><![CDATA[0]]></initialValueExpression>
    </variable>
    <variable name="APPT_AT_RISK_CNT" class="java.lang.Integer" calculation="Sum">
        <variableExpression><![CDATA[
(("Y".equalsIgnoreCase($F{APPOINTMENT_FLG}) || "YES".equalsIgnoreCase($F{APPOINTMENT_FLG}) || "1".equalsIgnoreCase($F{APPOINTMENT_FLG}))
&& !($F{STATUS_DESCR} != null && $F{STATUS_DESCR}.toUpperCase().contains("COMPLETE"))
&& !($F{BO_STATUS_CD} != null && $F{BO_STATUS_CD}.toUpperCase().contains("COMPLETE"))
&& ($F{STATUS_UPD_DTTM} == null || ($F{DAYS_OLD} != null && $F{DAYS_OLD}.intValue() >= 1))) ? 1 : 0
        ]]></variableExpression>
        <initialValueExpression><![CDATA[0]]></initialValueExpression>
    </variable>
    <variable name="AVG_DAYS_COMPLETE" class="java.lang.Double" calculation="Average">
        <variableExpression><![CDATA[$F{DAYS_COMPLETED} == null ? null : Double.valueOf($F{DAYS_COMPLETED}.doubleValue())]]></variableExpression>
    </variable>

    <filterExpression><![CDATA[
($F{D1_ACTIVITY_ID} != null)
&& ($P{REGION} == null || $P{REGION}.trim().length() == 0
    || ($F{CITY} != null && $F{CITY}.toUpperCase().contains($P{REGION}.trim().toUpperCase()))
)
&& ($P{DIVISION_CD} == null || $P{DIVISION_CD}.trim().length() == 0
    || ($F{DIVISION_CD} != null && $F{DIVISION_CD}.equalsIgnoreCase($P{DIVISION_CD}.trim()))
)
&& ($P{STATUS_TEXT} == null || $P{STATUS_TEXT}.trim().length() == 0
    || (($F{STATUS_DESCR} != null && $F{STATUS_DESCR}.toUpperCase().contains($P{STATUS_TEXT}.trim().toUpperCase()))
        || ($F{BO_STATUS_CD} != null && $F{BO_STATUS_CD}.toUpperCase().contains($P{STATUS_TEXT}.trim().toUpperCase())))
)
&& ($P{ACTIVITY_TYPE_TEXT} == null || $P{ACTIVITY_TYPE_TEXT}.trim().length() == 0
    || ($F{ACTIVITY_TYPE_DESCR} != null && $F{ACTIVITY_TYPE_DESCR}.toUpperCase().contains($P{ACTIVITY_TYPE_TEXT}.trim().toUpperCase()))
)
&& ($P{ONLY_OPEN} == null || !$P{ONLY_OPEN}.booleanValue()
    || (!($F{STATUS_DESCR} != null && $F{STATUS_DESCR}.toUpperCase().contains("COMPLETE"))
        && !($F{BO_STATUS_CD} != null && $F{BO_STATUS_CD}.toUpperCase().contains("COMPLETE")))
)
&& ($P{ONLY_EXCEPTIONS} == null || !$P{ONLY_EXCEPTIONS}.booleanValue()
    || (($F{DAYS_OLD} != null && $F{DAYS_OLD}.intValue() >= $P{STALE_DAYS}.intValue())
        || ($F{CANCEL_REASON} != null && $F{CANCEL_REASON}.trim().length() > 0)
        || (("Y".equalsIgnoreCase($F{APPOINTMENT_FLG}) || "YES".equalsIgnoreCase($F{APPOINTMENT_FLG}) || "1".equalsIgnoreCase($F{APPOINTMENT_FLG})) && ($F{STATUS_UPD_DTTM} == null)))
)
    ]]></filterExpression>

