            <textField><reportElement style="DetailText" x="650" y="2" width="120" height="16" uuid="04a4c0a5-95cb-4073-b204-53be24beddd8"/><textFieldExpression><![CDATA[$F{CANCEL_REASON_DESCR} == null ? ($F{CANCEL_REASON} == null ? "" : $F{CANCEL_REASON}) : $F{CANCEL_REASON_DESCR}]]></textFieldExpression></textField>
