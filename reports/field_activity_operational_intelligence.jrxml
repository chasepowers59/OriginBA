            <textField>
                <reportElement style="DetailText" x="930" y="2" width="220" height="16" uuid="651e6050-751e-4ad2-a696-f6587a99243b"/>
                <textFieldExpression><![CDATA[
($F{CANCEL_REASON} != null && $F{CANCEL_REASON}.trim().length() > 0) ? "Analyze cancel root cause + customer comms"
 : (($F{DAYS_OLD} != null && $F{DAYS_OLD}.intValue() >= $P{STALE_DAYS}.intValue()) ? "Dispatch escalation; clear stale queue"
 : ((("Y".equalsIgnoreCase($F{APPOINTMENT_FLG}) || "YES".equalsIgnoreCase($F{APPOINTMENT_FLG}) || "1".equalsIgnoreCase($F{APPOINTMENT_FLG})) && ($F{STATUS_UPD_DTTM} == null)) ? "Confirm appointment adherence" : "Monitor"))
                ]]></textFieldExpression>
            </textField>
        </band>
    </detail>

