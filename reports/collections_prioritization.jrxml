<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
    name="collections_prioritization"
    pageWidth="842"
    pageHeight="595"
    orientation="Landscape"
    columnWidth="802"
    leftMargin="20"
    rightMargin="20"
    topMargin="20"
    bottomMargin="20"
    uuid="8dbf7f75-0709-4f26-ab8f-a45da269d0f4">

    <parameter name="CLIENT_ID" class="java.lang.String"/>
    <parameter name="START_TS" class="java.sql.Timestamp"/>
    <parameter name="END_TS" class="java.sql.Timestamp"/>
    <parameter name="MIN_DEBT_OVER_60" class="java.math.BigDecimal">
        <defaultValueExpression><![CDATA[new java.math.BigDecimal("0")]]></defaultValueExpression>
    </parameter>

    <queryString language="SQL">
        <![CDATA[
SELECT
    A.ACCT_ID,
    NULLIF(TRIM(A.COLL_CL_CD), '') AS COLL_CL_CD,
    SUM(CASE WHEN (TRUNC($P{END_TS}) - FT.ARS_DT) <= 30 THEN FT.CUR_AMT ELSE 0 END) AS DEBT_30_DAYS,
    SUM(CASE WHEN (TRUNC($P{END_TS}) - FT.ARS_DT) BETWEEN 31 AND 60 THEN FT.CUR_AMT ELSE 0 END) AS DEBT_60_DAYS,
    SUM(CASE WHEN (TRUNC($P{END_TS}) - FT.ARS_DT) > 60 THEN FT.CUR_AMT ELSE 0 END) AS DEBT_OVER_60,
    SUM(FT.CUR_AMT) AS TOTAL_DEBT,
    COUNT(DISTINCT CASE WHEN AL.ALERT_TYPE_CD IS NOT NULL THEN AL.ALERT_TYPE_CD END) AS ACTIVE_ALERT_COUNT,
    MAX(B.BILL_DT) AS LAST_BILL_DT,
    (
      SUM(CASE WHEN (TRUNC($P{END_TS}) - FT.ARS_DT) > 60 THEN FT.CUR_AMT ELSE 0 END)
      + (COUNT(DISTINCT CASE WHEN AL.ALERT_TYPE_CD IS NOT NULL THEN AL.ALERT_TYPE_CD END) * 100)
    ) AS PRIORITY_SCORE
FROM CISADM.CI_ACCT A
JOIN CISADM.CI_SA SA
  ON SA.ACCT_ID = A.ACCT_ID
 AND NULLIF(TRIM(SA.SA_STATUS_FLG), '') = '20'
JOIN CISADM.CI_FT FT
  ON FT.SA_ID = SA.SA_ID
 AND FT.FREEZE_SW = 'Y'
 AND FT.NOT_IN_ARS_SW = 'N'
 AND FT.FT_TYPE_FLG NOT IN ('PS', 'PX')
 AND FT.ARS_DT IS NOT NULL
LEFT JOIN CISADM.CI_ACCT_ALERT AL
  ON AL.ACCT_ID = A.ACCT_ID
 AND $P{END_TS} BETWEEN AL.START_DT AND NVL(AL.END_DT, $P{END_TS})
LEFT JOIN CISADM.CI_BILL B
  ON B.ACCT_ID = A.ACCT_ID
 AND B.BILL_DT >= $P{START_TS}
 AND B.BILL_DT <  $P{END_TS}
WHERE ($P{CLIENT_ID} IS NULL OR A.CIS_DIVISION = $P{CLIENT_ID})
GROUP BY A.ACCT_ID, A.COLL_CL_CD
HAVING SUM(CASE WHEN (TRUNC($P{END_TS}) - FT.ARS_DT) > 60 THEN FT.CUR_AMT ELSE 0 END) >= NVL($P{MIN_DEBT_OVER_60}, 0)
ORDER BY PRIORITY_SCORE DESC, DEBT_OVER_60 DESC
        ]]>
    </queryString>

    <field name="ACCT_ID" class="java.lang.String"/>
    <field name="COLL_CL_CD" class="java.lang.String"/>
    <field name="DEBT_30_DAYS" class="java.math.BigDecimal"/>
    <field name="DEBT_60_DAYS" class="java.math.BigDecimal"/>
    <field name="DEBT_OVER_60" class="java.math.BigDecimal"/>
    <field name="TOTAL_DEBT" class="java.math.BigDecimal"/>
    <field name="ACTIVE_ALERT_COUNT" class="java.math.BigDecimal"/>
    <field name="LAST_BILL_DT" class="java.sql.Timestamp"/>
    <field name="PRIORITY_SCORE" class="java.math.BigDecimal"/>

    <title>
