            <textField pattern="#,##0.00"><reportElement x="175" y="0" width="90" height="18" uuid="63252ab5-c051-4efc-8236-f7d1a4cd0d5f"/><textElement textAlignment="Right"/><textFieldExpression><![CDATA[$F{DEBT_30_DAYS}]]></textFieldExpression></textField>
            <textField pattern="#,##0.00"><reportElement x="270" y="0" width="90" height="18" uuid="ed15f50b-9989-4aa0-a186-4292d5c63206"/><textElement textAlignment="Right"/><textFieldExpression><![CDATA[$F{DEBT_60_DAYS}]]></textFieldExpression></textField>
