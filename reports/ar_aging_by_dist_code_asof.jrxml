                <reportElement style="MetaBlue" x="0" y="28" width="802" height="14" uuid="11111111-1111-4111-a111-111111111102"/>
                <textFieldExpression><![CDATA[$P{CLIENT_NAME} + "  |  As-of (ARS_DT cutoff): " + $P{AS_OF_DT} + "  |  FIFO aging; payments/credits included; future ARS excluded"]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement style="MetaBlue" x="0" y="42" width="802" height="12" uuid="11111111-1111-4111-a111-111111111103"/>
                <textFieldExpression><![CDATA["Current = SA CUR_BAL as of cutoff. Buckets ARS_AMT1-5 sum to Current. Use GL Control Section when comparing to BC TB 142000/050/060."]]></textFieldExpression>
            </textField>
        </band>
    </title>

