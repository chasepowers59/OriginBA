<?xml version="1.0" encoding="UTF-8"?>
<!--
  CityCorp Ad Hoc AR Aging parity — same calendar-bucket SQL pattern as CC export,
  with trunc(sysdate) replaced by TRUNC($P{AS_OF_DT}).
  AS_OF_DT is java.sql.Date (calendar day only) so DB/JRS timezone does not shift the cutoff.
  Not FIFO. Not FT_GL / TB bridge. Population = CC SA-type unions (billing/prem flags).
-->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
    name="ar_aging_by_dist_code_asof_adhoc"
    pageWidth="842"
    pageHeight="595"
    orientation="Landscape"
    columnWidth="802"
    leftMargin="20"
    rightMargin="20"
    topMargin="20"
    bottomMargin="20"
    uuid="c3d4e5f6-a7b8-4901-c234-56789abcdef0">

    <property name="com.jaspersoft.studio.data.defaultdataadapter" value="ORIGIN_DEV_DS"/>
    <property name="net.sf.jasperreports.query.timeout" value="900"/>

    <style name="Base" fontName="SansSerif" fontSize="9"/>
    <style name="TitleBlue" style="Base" fontSize="16" isBold="true" forecolor="#0A4A8A"/>
    <style name="MetaBlue" style="Base" fontSize="10" forecolor="#0A4A8A"/>
    <style name="HeaderBlue" style="Base" fontSize="9" isBold="true" forecolor="#FFFFFF" backcolor="#0A4A8A"/>
    <style name="SectionHeader" style="Base" fontSize="10" isBold="true" forecolor="#FFFFFF" backcolor="#0A4A8A"/>
    <style name="DetailText" style="Base" fontSize="9"/>
    <style name="SectionTotal" style="Base" fontSize="9" isBold="true" backcolor="#D6E8F7"/>
    <style name="SummaryBlue" style="Base" fontSize="9" isBold="true" backcolor="#EAF3FF"/>

    <parameter name="AS_OF_DT" class="java.sql.Date">
        <parameterDescription><![CDATA[As-of calendar day (ARS_DT). Default 2026-06-30 for Jeremy EOY.]]></parameterDescription>
        <defaultValueExpression><![CDATA[java.sql.Date.valueOf("2026-06-30")]]></defaultValueExpression>
    </parameter>
    <parameter name="CLIENT_NAME" class="java.lang.String">
        <defaultValueExpression><![CDATA["CityCorp"]]></defaultValueExpression>
    </parameter>

    <queryString language="SQL"><![CDATA[
SELECT
    TRIM(aged.dst_id) AS DISTRIBUTION_CODE,
    CASE
        WHEN TRIM(aged.dst_id) IN ('A/R-WATER', 'A/R-SEWER', 'A/R-PA', 'A/P-OVPY')
            THEN '142000 Customer AR'
        WHEN TRIM(aged.dst_id) = 'A/R-SOLWST'
            THEN '142050 Solid Waste AR'
        WHEN TRIM(aged.dst_id) = 'A/R-CARDS'
            THEN '142060 Cards AR'
        WHEN TRIM(aged.dst_id) = 'A/P-DEPOS'
            THEN '235000 Customer Deposits'
        WHEN TRIM(aged.dst_id) LIKE 'E-WO%'
            THEN 'Write-Off DST (not AR control)'
        ELSE 'Other'
    END AS GL_CONTROL_SECTION,
    COUNT(DISTINCT aged.sa_id) AS SA_COUNT,
    ROUND(SUM(NVL(aged_current.sum_cur, 0)), 2) AS CURRENT_BAL,
    ROUND(SUM(NVL(aged_30.sum_cur, 0)), 2) AS AMT_0_30,
    ROUND(SUM(NVL(aged_3160.sum_cur, 0)), 2) AS AMT_31_60,
    ROUND(SUM(NVL(aged_6190.sum_cur, 0)), 2) AS AMT_61_90,
    ROUND(SUM(NVL(aged_91120.sum_cur, 0)), 2) AS AMT_91_120,
    ROUND(SUM(NVL(aged_old.sum_cur, 0)), 2) AS AMT_121_PLUS
FROM (
    SELECT
        a.bill_cyc_cd,
        sa.sa_type_cd,
        p.address1 AS address1,
        a.acct_id,
        sa.sa_id,
        sat.dst_id,
        pn.entity_name
    FROM cisadm.ci_acct a
    JOIN cisadm.ci_acct_per ap
      ON a.acct_id = ap.acct_id
     AND ap.main_cust_sw = 'Y'
    JOIN cisadm.ci_per_name pn
      ON ap.per_id = pn.per_id
     AND pn.prim_name_sw = 'Y'
    JOIN cisadm.ci_sa sa
      ON a.acct_id = sa.acct_id
     AND sa.sa_type_cd IN (
            SELECT sa_type_cd
            FROM cisadm.ci_sa_type
            WHERE allow_billing_sw = 'Y'
              AND prem_req_sw = 'Y'
         )
    JOIN cisadm.ci_sa_type sat
      ON sa.sa_type_cd = sat.sa_type_cd
    JOIN cisadm.ci_prem p
      ON sa.char_prem_id = p.prem_id
    UNION
    SELECT
        a.bill_cyc_cd,
        sa.sa_type_cd,
        ' ' AS address1,
        a.acct_id,
        sa.sa_id,
        sat.dst_id,
        pn.entity_name
    FROM cisadm.ci_acct a
    JOIN cisadm.ci_acct_per ap
      ON a.acct_id = ap.acct_id
     AND ap.main_cust_sw = 'Y'
    JOIN cisadm.ci_per_name pn
      ON ap.per_id = pn.per_id
     AND pn.prim_name_sw = 'Y'
    JOIN cisadm.ci_sa sa
      ON a.acct_id = sa.acct_id
     AND sa.sa_type_cd IN (
            SELECT sa_type_cd
            FROM cisadm.ci_sa_type
            WHERE allow_billing_sw = 'Y'
              AND prem_req_sw = 'N'
         )
    JOIN cisadm.ci_sa_type sat
      ON sa.sa_type_cd = sat.sa_type_cd
    UNION
    SELECT
        a.bill_cyc_cd,
        sa.sa_type_cd,
        ' ' AS address1,
        a.acct_id,
        sa.sa_id,
        sat.dst_id,
        pn.entity_name
    FROM cisadm.ci_acct a
    JOIN cisadm.ci_acct_per ap
      ON a.acct_id = ap.acct_id
     AND ap.main_cust_sw = 'Y'
    JOIN cisadm.ci_per_name pn
      ON ap.per_id = pn.per_id
     AND pn.prim_name_sw = 'Y'
    JOIN cisadm.ci_sa sa
      ON a.acct_id = sa.acct_id
     AND sa.sa_type_cd IN (
            SELECT sa_type_cd
            FROM cisadm.ci_sa_type
            WHERE allow_billing_sw = 'N'
              AND prem_req_sw = 'N'
         )
    JOIN cisadm.ci_sa_type sat
      ON sa.sa_type_cd = sat.sa_type_cd
) aged
LEFT JOIN (
    SELECT ft1.sa_id, SUM(ft1.cur_amt) AS sum_cur
    FROM cisadm.ci_ft ft1
    WHERE ft1.freeze_sw = 'Y'
      AND ft1.ars_dt BETWEEN (TRUNC($P{AS_OF_DT}) - 30) AND TRUNC($P{AS_OF_DT})
    GROUP BY ft1.sa_id
) aged_30
  ON aged.sa_id = aged_30.sa_id
LEFT JOIN (
    SELECT ft1.sa_id, SUM(ft1.cur_amt) AS sum_cur
    FROM cisadm.ci_ft ft1
    WHERE ft1.freeze_sw = 'Y'
      AND ft1.ars_dt BETWEEN (TRUNC($P{AS_OF_DT}) - 60) AND (TRUNC($P{AS_OF_DT}) - 31)
    GROUP BY ft1.sa_id
) aged_3160
  ON aged.sa_id = aged_3160.sa_id
LEFT JOIN (
    SELECT ft1.sa_id, SUM(ft1.cur_amt) AS sum_cur
    FROM cisadm.ci_ft ft1
    WHERE ft1.freeze_sw = 'Y'
      AND ft1.ars_dt BETWEEN (TRUNC($P{AS_OF_DT}) - 90) AND (TRUNC($P{AS_OF_DT}) - 61)
    GROUP BY ft1.sa_id
) aged_6190
  ON aged.sa_id = aged_6190.sa_id
LEFT JOIN (
    SELECT ft1.sa_id, SUM(ft1.cur_amt) AS sum_cur
    FROM cisadm.ci_ft ft1
    WHERE ft1.freeze_sw = 'Y'
      AND ft1.ars_dt BETWEEN (TRUNC($P{AS_OF_DT}) - 120) AND (TRUNC($P{AS_OF_DT}) - 91)
    GROUP BY ft1.sa_id
) aged_91120
  ON aged.sa_id = aged_91120.sa_id
LEFT JOIN (
    SELECT ft1.sa_id, SUM(ft1.cur_amt) AS sum_cur
    FROM cisadm.ci_ft ft1
    WHERE ft1.freeze_sw = 'Y'
      AND ft1.ars_dt <= (TRUNC($P{AS_OF_DT}) - 121)
    GROUP BY ft1.sa_id
) aged_old
  ON aged.sa_id = aged_old.sa_id
LEFT JOIN (
    SELECT ft1.sa_id, SUM(ft1.cur_amt) AS sum_cur
    FROM cisadm.ci_ft ft1
    WHERE ft1.freeze_sw = 'Y'
      AND ft1.ars_dt <= TRUNC($P{AS_OF_DT})
    GROUP BY ft1.sa_id
) aged_current
  ON aged.sa_id = aged_current.sa_id
GROUP BY
    TRIM(aged.dst_id),
    CASE
        WHEN TRIM(aged.dst_id) IN ('A/R-WATER', 'A/R-SEWER', 'A/R-PA', 'A/P-OVPY')
            THEN '142000 Customer AR'
        WHEN TRIM(aged.dst_id) = 'A/R-SOLWST'
            THEN '142050 Solid Waste AR'
        WHEN TRIM(aged.dst_id) = 'A/R-CARDS'
            THEN '142060 Cards AR'
        WHEN TRIM(aged.dst_id) = 'A/P-DEPOS'
            THEN '235000 Customer Deposits'
        WHEN TRIM(aged.dst_id) LIKE 'E-WO%'
            THEN 'Write-Off DST (not AR control)'
        ELSE 'Other'
    END
ORDER BY GL_CONTROL_SECTION, DISTRIBUTION_CODE
    ]]></queryString>

    <field name="DISTRIBUTION_CODE" class="java.lang.String"/>
    <field name="GL_CONTROL_SECTION" class="java.lang.String"/>
    <field name="SA_COUNT" class="java.lang.Long"/>
