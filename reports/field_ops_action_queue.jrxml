        <conditionalStyle>
            <conditionExpression><![CDATA[
($F{DAYS_OLD} != null && $F{DAYS_OLD}.intValue() >= $P{CRITICAL_DAYS}.intValue())
            ]]></conditionExpression>
            <style backcolor="#B91C1C" forecolor="#FFFFFF"/>
        </conditionalStyle>
        <conditionalStyle>
            <conditionExpression><![CDATA[
($F{D1_GEO_LAT} == null || $F{D1_GEO_LONG} == null) && !($F{DAYS_OLD} != null && $F{DAYS_OLD}.intValue() >= $P{CRITICAL_DAYS}.intValue())
            ]]></conditionExpression>
            <style backcolor="#C2410C" forecolor="#FFFFFF"/>
        </conditionalStyle>
        <conditionalStyle>
            <conditionExpression><![CDATA[
($F{DAYS_OLD} != null && $F{DAYS_OLD}.intValue() >= $P{HIGH_DAYS}.intValue()) && !($F{DAYS_OLD} != null && $F{DAYS_OLD}.intValue() >= $P{CRITICAL_DAYS}.intValue()) && !($F{D1_GEO_LAT} == null || $F{D1_GEO_LONG} == null)
            ]]></conditionExpression>
            <style backcolor="#D97706" forecolor="#FFFFFF"/>
        </conditionalStyle>
        <conditionalStyle>
            <conditionExpression><![CDATA[
!($F{DAYS_OLD} != null && $F{DAYS_OLD}.intValue() >= $P{HIGH_DAYS}.intValue()) && !($F{D1_GEO_LAT} == null || $F{D1_GEO_LONG} == null)
            ]]></conditionExpression>
            <style backcolor="#047857" forecolor="#FFFFFF"/>
        </conditionalStyle>
    </style>
