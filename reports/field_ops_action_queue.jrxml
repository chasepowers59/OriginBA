    <variable name="TOTAL_ROWS" class="java.lang.Integer" calculation="Count">
        <variableExpression><![CDATA[$F{D1_SP_ID}]]></variableExpression>
        <initialValueExpression><![CDATA[0]]></initialValueExpression>
    </variable>
    <variable name="CRITICAL_CNT" class="java.lang.Integer" calculation="Sum">
        <variableExpression><![CDATA[
($F{DAYS_OLD} != null && $F{DAYS_OLD}.intValue() >= $P{CRITICAL_DAYS}.intValue()) ? 1 : 0
        ]]></variableExpression>
        <initialValueExpression><![CDATA[0]]></initialValueExpression>
    </variable>
    <variable name="GEO_MISSING_CNT" class="java.lang.Integer" calculation="Sum">
        <variableExpression><![CDATA[
($F{D1_GEO_LAT} == null || $F{D1_GEO_LONG} == null) ? 1 : 0
        ]]></variableExpression>
        <initialValueExpression><![CDATA[0]]></initialValueExpression>
    </variable>
    <variable name="HIGH_GEO_CNT" class="java.lang.Integer" calculation="Sum">
        <variableExpression><![CDATA[
($F{D1_GEO_LAT} == null || $F{D1_GEO_LONG} == null) && !($F{DAYS_OLD} != null && $F{DAYS_OLD}.intValue() >= $P{CRITICAL_DAYS}.intValue()) ? 1 : 0
        ]]></variableExpression>
        <initialValueExpression><![CDATA[0]]></initialValueExpression>
    </variable>
    <variable name="HIGH_CNT" class="java.lang.Integer" calculation="Sum">
        <variableExpression><![CDATA[
($F{DAYS_OLD} != null && $F{DAYS_OLD}.intValue() >= $P{HIGH_DAYS}.intValue() && $F{DAYS_OLD}.intValue() < $P{CRITICAL_DAYS}.intValue() && !($F{D1_GEO_LAT} == null || $F{D1_GEO_LONG} == null)) ? 1 : 0
        ]]></variableExpression>
        <initialValueExpression><![CDATA[0]]></initialValueExpression>
    </variable>
    <variable name="NORMAL_CNT" class="java.lang.Integer" calculation="Sum">
        <variableExpression><![CDATA[
(!($F{DAYS_OLD} != null && $F{DAYS_OLD}.intValue() >= $P{HIGH_DAYS}.intValue()) && !($F{D1_GEO_LAT} == null || $F{D1_GEO_LONG} == null)) ? 1 : 0
        ]]></variableExpression>
        <initialValueExpression><![CDATA[0]]></initialValueExpression>
    </variable>
    <variable name="AVG_DAYS_OLD" class="java.lang.Double" calculation="Average">
        <variableExpression><![CDATA[$F{DAYS_OLD} == null ? null : Double.valueOf($F{DAYS_OLD}.doubleValue())]]></variableExpression>
    </variable>

    <filterExpression><![CDATA[
($F{D1_SP_ID} != null)
&& ($P{REGION} == null || $P{REGION}.trim().length() == 0
    || ("UNKNOWN".equalsIgnoreCase($P{REGION}.trim()) && (($F{CITY} == null || $F{CITY}.trim().length() == 0) && ($F{DIVISION_CD} == null || $F{DIVISION_CD}.trim().length() == 0)))
    || ($F{CITY} != null && $F{CITY}.toUpperCase().contains($P{REGION}.trim().toUpperCase()))
    || ($F{DIVISION_CD} != null && $F{DIVISION_CD}.toUpperCase().contains($P{REGION}.trim().toUpperCase())))
&& ($P{DIVISION_CD} == null || $P{DIVISION_CD}.trim().length() == 0 || ($F{DIVISION_CD} != null && $F{DIVISION_CD}.equalsIgnoreCase($P{DIVISION_CD})))
&& ($P{STATUS_TEXT} == null || $P{STATUS_TEXT}.trim().length() == 0 || (($F{STATUS_DESCR} != null && $F{STATUS_DESCR}.toUpperCase().contains($P{STATUS_TEXT}.trim().toUpperCase())) || ($F{BO_STATUS_CD} != null && $F{BO_STATUS_CD}.toUpperCase().contains($P{STATUS_TEXT}.trim().toUpperCase()))))
&& ($P{STATUS_EXACT} == null || $P{STATUS_EXACT}.trim().length() == 0 || (($F{STATUS_DESCR} != null && $F{STATUS_DESCR}.equalsIgnoreCase($P{STATUS_EXACT}.trim())) || ($F{BO_STATUS_CD} != null && $F{BO_STATUS_CD}.equalsIgnoreCase($P{STATUS_EXACT}.trim()))))
&& ($P{ACTIVITY_TYPE_TEXT} == null || $P{ACTIVITY_TYPE_TEXT}.trim().length() == 0 || ($F{ACTIVITY_TYPE_DESCR} != null && $F{ACTIVITY_TYPE_DESCR}.toUpperCase().contains($P{ACTIVITY_TYPE_TEXT}.trim().toUpperCase())))
&& ($P{MIN_DAYS_OLD} == null || $F{DAYS_OLD} == null || $F{DAYS_OLD}.intValue() >= $P{MIN_DAYS_OLD}.intValue())
&& ($P{MAX_DAYS_OLD} == null || $F{DAYS_OLD} == null || $F{DAYS_OLD}.intValue() <= $P{MAX_DAYS_OLD}.intValue())
&& ($P{GEO_STATUS} == null || $P{GEO_STATUS}.trim().length() == 0 || ("MISSING".equalsIgnoreCase($P{GEO_STATUS}.trim()) ? ($F{D1_GEO_LAT} == null || $F{D1_GEO_LONG} == null) : ("PRESENT".equalsIgnoreCase($P{GEO_STATUS}.trim()) ? ($F{D1_GEO_LAT} != null && $F{D1_GEO_LONG} != null) : true)))
&& ($P{PAIN_FLAG_FILTER} == null || $P{PAIN_FLAG_FILTER}.trim().length() == 0 || (
((($F{DAYS_OLD} != null && $F{DAYS_OLD}.intValue() >= $P{CRITICAL_DAYS}.intValue()) ? "CRITICAL" : (($F{D1_GEO_LAT} == null || $F{D1_GEO_LONG} == null) ? "HIGH_GEO" : (($F{DAYS_OLD} != null && $F{DAYS_OLD}.intValue() >= $P{HIGH_DAYS}.intValue()) ? "HIGH" : "NORMAL")))).equalsIgnoreCase($P{PAIN_FLAG_FILTER}.trim())
))
&& ($P{PRIORITY_ONLY} == null || !$P{PRIORITY_ONLY}.booleanValue() || (($F{DAYS_OLD} != null && $F{DAYS_OLD}.intValue() >= $P{HIGH_DAYS}.intValue()) || ($F{D1_GEO_LAT} == null || $F{D1_GEO_LONG} == null))
)
&& ($P{ONLY_GEO_MISSING} == null || !$P{ONLY_GEO_MISSING}.booleanValue() || ($F{D1_GEO_LAT} == null || $F{D1_GEO_LONG} == null))
    ]]></filterExpression>

