    <variable name="TOTAL_ROWS" class="java.lang.Integer" calculation="Count">
        <variableExpression><![CDATA[$F{FT_ID}]]></variableExpression>
        <initialValueExpression><![CDATA[0]]></initialValueExpression>
    </variable>
    <variable name="BAD_ROWS" class="java.lang.Integer" calculation="Sum">
        <variableExpression><![CDATA[
(
($F{GL_ACCT} == null || $F{GL_ACCT}.trim().length() == 0)
|| ($F{AMOUNT} == null || $F{AMOUNT}.compareTo(java.math.BigDecimal.ZERO) == 0)
|| ($F{GL_DISTRIB_STATUS_DESC} == null
    || !($F{GL_DISTRIB_STATUS_DESC}.toUpperCase().contains("DISTRIBUT")
         || $F{GL_DISTRIB_STATUS_DESC}.toUpperCase().contains("COMPLETE")
         || $F{GL_DISTRIB_STATUS_DESC}.toUpperCase().contains("POST")))
) ? 1 : 0
        ]]></variableExpression>
        <initialValueExpression><![CDATA[0]]></initialValueExpression>
    </variable>
    <variable name="MISSING_GL_ACCT_CNT" class="java.lang.Integer" calculation="Sum">
        <variableExpression><![CDATA[($F{GL_ACCT} == null || $F{GL_ACCT}.trim().length() == 0) ? 1 : 0]]></variableExpression>
        <initialValueExpression><![CDATA[0]]></initialValueExpression>
    </variable>
    <variable name="ZERO_AMT_CNT" class="java.lang.Integer" calculation="Sum">
        <variableExpression><![CDATA[($F{AMOUNT} == null || $F{AMOUNT}.compareTo(java.math.BigDecimal.ZERO) == 0) ? 1 : 0]]></variableExpression>
        <initialValueExpression><![CDATA[0]]></initialValueExpression>
    </variable>
    <variable name="STATUS_ISSUE_CNT" class="java.lang.Integer" calculation="Sum">
        <variableExpression><![CDATA[
($F{GL_DISTRIB_STATUS_DESC} == null
    || !($F{GL_DISTRIB_STATUS_DESC}.toUpperCase().contains("DISTRIBUT")
         || $F{GL_DISTRIB_STATUS_DESC}.toUpperCase().contains("COMPLETE")
         || $F{GL_DISTRIB_STATUS_DESC}.toUpperCase().contains("POST"))) ? 1 : 0
        ]]></variableExpression>
        <initialValueExpression><![CDATA[0]]></initialValueExpression>
    </variable>

    <filterExpression><![CDATA[
($F{FT_ID} != null)
&& ($P{ONLY_LATEST_BATCH} == null || !$P{ONLY_LATEST_BATCH}.booleanValue()
    || ("Y".equalsIgnoreCase($F{IS_LATEST_BATCH_NBR})
        || "YES".equalsIgnoreCase($F{IS_LATEST_BATCH_NBR})
        || "TRUE".equalsIgnoreCase($F{IS_LATEST_BATCH_NBR})
        || "1".equalsIgnoreCase($F{IS_LATEST_BATCH_NBR}))
)
&& ($P{BATCH_NBR_FILTER} == null || $P{BATCH_NBR_FILTER}.trim().length() == 0
    || ($F{BATCH_NBR} != null && $F{BATCH_NBR}.toPlainString().equals($P{BATCH_NBR_FILTER}.trim()))
)
&& ($P{GL_STATUS_FILTER} == null || $P{GL_STATUS_FILTER}.trim().length() == 0
    || ($F{GL_DISTRIB_STATUS_DESC} != null && $F{GL_DISTRIB_STATUS_DESC}.toUpperCase().contains($P{GL_STATUS_FILTER}.trim().toUpperCase()))
)
&& ($P{MIN_ABS_AMOUNT} == null || $F{AMOUNT} == null || $F{AMOUNT}.abs().compareTo($P{MIN_ABS_AMOUNT}) >= 0)
&& ($P{ONLY_BAD_VALUES} == null || !$P{ONLY_BAD_VALUES}.booleanValue()
    || (
        ($F{GL_ACCT} == null || $F{GL_ACCT}.trim().length() == 0)
        || ($F{AMOUNT} == null || $F{AMOUNT}.compareTo(java.math.BigDecimal.ZERO) == 0)
        || ($F{GL_DISTRIB_STATUS_DESC} == null
            || !($F{GL_DISTRIB_STATUS_DESC}.toUpperCase().contains("DISTRIBUT")
                 || $F{GL_DISTRIB_STATUS_DESC}.toUpperCase().contains("COMPLETE")
                 || $F{GL_DISTRIB_STATUS_DESC}.toUpperCase().contains("POST")))
    )
)
    ]]></filterExpression>

