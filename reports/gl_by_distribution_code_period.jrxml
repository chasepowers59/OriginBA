<?xml version="1.0" encoding="UTF-8"?>
<jasperReport name="gl_by_distribution_code_period" pageWidth="842" pageHeight="595" orientation="Landscape"
    columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20"
    whenNoDataType="AllSectionsNoDetail">
    <property name="net.sf.jasperreports.query.timeout" value="600"/>
    <property name="net.sf.jasperreports.export.xls.remove.empty.space.between.rows" value="true"/>
    <style name="Base" default="true" fontName="Aptos" fontSize="9"/>
    <style name="TitleSapphire" style="Base" fontSize="18" bold="true" forecolor="#006FAC"/>
    <style name="H3" style="Base" fontSize="10" forecolor="#0F4761"/>
    <style name="HeaderSapphire" style="Base" fontSize="9" bold="true" forecolor="#FFFFFF" backcolor="#006FAC" mode="Opaque"/>
    <style name="DetailText" style="Base" fontSize="9" forecolor="#000000" backcolor="#F5F0EB" mode="Opaque"/>
    <style name="SubHeader" style="Base" fontSize="8" bold="true" forecolor="#1348AB"/>
    <style name="SubText" style="Base" fontSize="8" forecolor="#000000"/>
    <style name="TotalText" style="Base" fontSize="9" bold="true" forecolor="#000000" backcolor="#F5F0EB" mode="Opaque"/>
    <style name="FooterConfidential" style="Base" fontSize="7" forecolor="#000000"/>
    <query language="SQL"><![CDATA[
SELECT TRIM(g.dst_id) AS DST_ID, COALESCE(TRIM(g.gl_acct), '(no GL account)') AS GL_ACCT,
       COUNT(*) AS GL_LINES, COUNT(DISTINCT f.ft_id) AS TRANSACTIONS,
       COALESCE(SUM(CASE WHEN g.amount > 0 THEN g.amount ELSE 0 END), 0) AS DEBIT_AMT,
       COALESCE(SUM(CASE WHEN g.amount < 0 THEN -g.amount ELSE 0 END), 0) AS CREDIT_AMT,
       COALESCE(SUM(g.amount), 0) AS NET_AMT
FROM CISADM.CI_FT_GL g
JOIN CISADM.CI_FT f ON f.ft_id = g.ft_id
WHERE TRIM(f.freeze_sw) = 'Y' AND f.accounting_dt >= $P{FROM_DT} AND f.accounting_dt < $P{TO_DT} + INTERVAL '1' DAY
  AND ($P{DST_ID_F} IS NULL OR TRIM(g.dst_id) = TRIM($P{DST_ID_F}))
  AND ($P{GL_ACCT_F} IS NULL OR TRIM(g.gl_acct) = TRIM($P{GL_ACCT_F}))
  AND ($P{GL_DIVISION_F} IS NULL OR TRIM(f.gl_division) = TRIM($P{GL_DIVISION_F}))
  AND ($P{CIS_DIVISION_F} IS NULL OR TRIM(f.cis_division) = TRIM($P{CIS_DIVISION_F}))
  AND ($P{FT_TYPE_FLG_F} IS NULL OR TRIM(f.ft_type_flg) = TRIM($P{FT_TYPE_FLG_F}))
GROUP BY TRIM(g.dst_id), COALESCE(TRIM(g.gl_acct), '(no GL account)')
ORDER BY ABS(COALESCE(SUM(g.amount), 0)) DESC
]]></query>
    <parameter name="FROM_DT" class="java.sql.Date">
        <defaultValueExpression><![CDATA[java.sql.Date.valueOf(java.time.LocalDate.now().withDayOfMonth(1).minusMonths(1).toString())]]></defaultValueExpression>
    </parameter>
    <parameter name="TO_DT" class="java.sql.Date">
        <defaultValueExpression><![CDATA[java.sql.Date.valueOf(java.time.LocalDate.now().withDayOfMonth(1).minusDays(1).toString())]]></defaultValueExpression>
    </parameter>
    <parameter name="CLIENT_NAME" class="java.lang.String">
        <defaultValueExpression><![CDATA["SmartCity Client"]]></defaultValueExpression>
    </parameter>
    <parameter name="DST_ID_F" class="java.lang.String">
        <defaultValueExpression><![CDATA[null]]></defaultValueExpression>
    </parameter>
    <parameter name="GL_ACCT_F" class="java.lang.String">
        <defaultValueExpression><![CDATA[null]]></defaultValueExpression>
    </parameter>
    <parameter name="GL_DIVISION_F" class="java.lang.String">
        <defaultValueExpression><![CDATA[null]]></defaultValueExpression>
    </parameter>
    <parameter name="CIS_DIVISION_F" class="java.lang.String">
        <defaultValueExpression><![CDATA[null]]></defaultValueExpression>
    </parameter>
    <parameter name="FT_TYPE_FLG_F" class="java.lang.String">
        <defaultValueExpression><![CDATA[null]]></defaultValueExpression>
    </parameter>
    <field name="DST_ID" class="java.lang.String"/>
    <field name="GL_ACCT" class="java.lang.String"/>
    <field name="GL_LINES" class="java.lang.Long"/>
    <field name="TRANSACTIONS" class="java.lang.Long"/>
    <field name="DEBIT_AMT" class="java.math.BigDecimal"/>
    <field name="CREDIT_AMT" class="java.math.BigDecimal"/>
    <field name="NET_AMT" class="java.math.BigDecimal"/>
    <variable name="SUM_GL_LINES" class="java.lang.Long" calculation="Sum">
        <expression><![CDATA[$F{GL_LINES}]]></expression>
    </variable>
    <variable name="SUM_TRANSACTIONS" class="java.lang.Long" calculation="Sum">
        <expression><![CDATA[$F{TRANSACTIONS}]]></expression>
    </variable>
    <variable name="SUM_DEBIT_AMT" class="java.math.BigDecimal" calculation="Sum">
        <expression><![CDATA[$F{DEBIT_AMT}]]></expression>
    </variable>
    <variable name="SUM_CREDIT_AMT" class="java.math.BigDecimal" calculation="Sum">
        <expression><![CDATA[$F{CREDIT_AMT}]]></expression>
    </variable>
    <variable name="SUM_NET_AMT" class="java.math.BigDecimal" calculation="Sum">
        <expression><![CDATA[$F{NET_AMT}]]></expression>
    </variable>
    <title height="52">
            <element kind="textField" x="0" y="0" width="802" height="26" style="TitleSapphire" hTextAlign="Left" vTextAlign="Middle" blankWhenNull="true" textAdjust="StretchHeight"><expression><![CDATA["GL Activity by Distribution Code"]]></expression></element>
            <element kind="textField" x="0" y="28" width="802" height="16" style="H3" hTextAlign="Left" vTextAlign="Middle" blankWhenNull="true" textAdjust="StretchHeight"><expression><![CDATA[$P{CLIENT_NAME} + "  |  " + new java.text.SimpleDateFormat("yyyy-MM-dd").format($P{FROM_DT}) + " to " + new java.text.SimpleDateFormat("yyyy-MM-dd").format($P{TO_DT}) + "  |  frozen FTs by accounting date; net = sum of GL amounts" + ($P{DST_ID_F} == null ? "" : "  |  Distribution code: " + $P{DST_ID_F}) + ($P{GL_ACCT_F} == null ? "" : "  |  GL account (exact): " + $P{GL_ACCT_F}) + ($P{GL_DIVISION_F} == null ? "" : "  |  GL division: " + $P{GL_DIVISION_F}) + ($P{CIS_DIVISION_F} == null ? "" : "  |  CIS division: " + $P{CIS_DIVISION_F}) + ($P{FT_TYPE_FLG_F} == null ? "" : "  |  FT type (BS, BX, AD, AX, PS, PX): " + $P{FT_TYPE_FLG_F})]]></expression></element>
    </title>
    <columnHeader height="18">
            <element kind="staticText" x="0" y="0" width="120" height="18" style="HeaderSapphire" hTextAlign="Center" vTextAlign="Middle"><text><![CDATA[Distribution Code]]></text></element>
            <element kind="staticText" x="120" y="0" width="232" height="18" style="HeaderSapphire" hTextAlign="Center" vTextAlign="Middle"><text><![CDATA[GL Account]]></text></element>
            <element kind="staticText" x="352" y="0" width="70" height="18" style="HeaderSapphire" hTextAlign="Center" vTextAlign="Middle"><text><![CDATA[Lines]]></text></element>
            <element kind="staticText" x="422" y="0" width="70" height="18" style="HeaderSapphire" hTextAlign="Center" vTextAlign="Middle"><text><![CDATA[FTs]]></text></element>
            <element kind="staticText" x="492" y="0" width="100" height="18" style="HeaderSapphire" hTextAlign="Center" vTextAlign="Middle"><text><![CDATA[Debits]]></text></element>
            <element kind="staticText" x="592" y="0" width="100" height="18" style="HeaderSapphire" hTextAlign="Center" vTextAlign="Middle"><text><![CDATA[Credits]]></text></element>
            <element kind="staticText" x="692" y="0" width="110" height="18" style="HeaderSapphire" hTextAlign="Center" vTextAlign="Middle"><text><![CDATA[Net]]></text></element>
    </columnHeader>
    <detail>
        <band height="20" splitType="Prevent">
            <element kind="textField" x="0" y="0" width="120" height="16" style="DetailText" hTextAlign="Left" vTextAlign="Middle" blankWhenNull="true" textAdjust="StretchHeight"><expression><![CDATA[$F{DST_ID}]]></expression></element>
            <element kind="textField" x="120" y="0" width="232" height="16" style="DetailText" hTextAlign="Left" vTextAlign="Middle" blankWhenNull="true" textAdjust="StretchHeight"><expression><![CDATA[$F{GL_ACCT}]]></expression></element>
            <element kind="textField" x="352" y="0" width="70" height="16" style="DetailText" hTextAlign="Right" vTextAlign="Middle" blankWhenNull="true" textAdjust="StretchHeight" pattern="#,##0"><expression><![CDATA[$F{GL_LINES}]]></expression></element>
            <element kind="textField" x="422" y="0" width="70" height="16" style="DetailText" hTextAlign="Right" vTextAlign="Middle" blankWhenNull="true" textAdjust="StretchHeight" pattern="#,##0"><expression><![CDATA[$F{TRANSACTIONS}]]></expression></element>
            <element kind="textField" x="492" y="0" width="100" height="16" style="DetailText" hTextAlign="Right" vTextAlign="Middle" blankWhenNull="true" textAdjust="StretchHeight" pattern="#,##0.00;(#,##0.00)"><expression><![CDATA[$F{DEBIT_AMT}]]></expression></element>
            <element kind="textField" x="592" y="0" width="100" height="16" style="DetailText" hTextAlign="Right" vTextAlign="Middle" blankWhenNull="true" textAdjust="StretchHeight" pattern="#,##0.00;(#,##0.00)"><expression><![CDATA[$F{CREDIT_AMT}]]></expression></element>
            <element kind="textField" x="692" y="0" width="110" height="16" style="DetailText" hTextAlign="Right" vTextAlign="Middle" blankWhenNull="true" textAdjust="StretchHeight" pattern="#,##0.00;(#,##0.00)"><expression><![CDATA[$F{NET_AMT}]]></expression></element>
        </band>
        <band height="20" splitType="Stretch">
            <element kind="subreport" x="24" y="0" width="778" height="20" positionType="Float" removeLineWhenBlank="true" usingCache="false">
                <parameter name="FROM_DT"><expression><![CDATA[$P{FROM_DT}]]></expression></parameter>
                <parameter name="TO_DT"><expression><![CDATA[$P{TO_DT}]]></expression></parameter>
                <parameter name="DST_ID_F"><expression><![CDATA[$P{DST_ID_F}]]></expression></parameter>
                <parameter name="GL_ACCT_F"><expression><![CDATA[$P{GL_ACCT_F}]]></expression></parameter>
                <parameter name="GL_DIVISION_F"><expression><![CDATA[$P{GL_DIVISION_F}]]></expression></parameter>
                <parameter name="CIS_DIVISION_F"><expression><![CDATA[$P{CIS_DIVISION_F}]]></expression></parameter>
                <parameter name="FT_TYPE_FLG_F"><expression><![CDATA[$P{FT_TYPE_FLG_F}]]></expression></parameter>
                <parameter name="DST_ID"><expression><![CDATA[$F{DST_ID}]]></expression></parameter>
                <parameter name="GL_ACCT"><expression><![CDATA[$F{GL_ACCT}]]></expression></parameter>
                <connectionExpression><![CDATA[$P{REPORT_CONNECTION}]]></connectionExpression>
                <expression><![CDATA["repo:gl_by_distribution_code_month"]]></expression>
            </element>
        </band>
    </detail>
    <pageFooter height="14">
            <element kind="textField" x="0" y="0" width="600" height="14" style="FooterConfidential" hTextAlign="Left" vTextAlign="Middle" blankWhenNull="true" textAdjust="StretchHeight"><expression><![CDATA["@2026, Origin Utility, Inc / Proprietary & Confidential / Expressly for " + $P{CLIENT_NAME}]]></expression></element>
            <element kind="textField" x="600" y="0" width="150" height="14" style="FooterConfidential" hTextAlign="Right" vTextAlign="Middle" blankWhenNull="true" textAdjust="StretchHeight"><expression><![CDATA["Page " + $V{PAGE_NUMBER} + " of"]]></expression></element>
            <element kind="textField" x="750" y="0" width="52" height="14" style="FooterConfidential" hTextAlign="Left" vTextAlign="Middle" blankWhenNull="true" textAdjust="StretchHeight" evaluationTime="Report"><expression><![CDATA[" " + $V{PAGE_NUMBER}]]></expression></element>
    </pageFooter>
    <summary height="22">
            <element kind="staticText" x="0" y="0" width="120" height="16" style="TotalText" hTextAlign="Left" vTextAlign="Middle"><text><![CDATA[Total]]></text></element>
            <element kind="staticText" x="120" y="0" width="232" height="16" style="TotalText" hTextAlign="Left" vTextAlign="Middle"><text><![CDATA[]]></text></element>
            <element kind="textField" x="352" y="0" width="70" height="16" style="TotalText" hTextAlign="Right" vTextAlign="Middle" blankWhenNull="true" textAdjust="StretchHeight" pattern="#,##0"><expression><![CDATA[$V{SUM_GL_LINES}]]></expression></element>
            <element kind="textField" x="422" y="0" width="70" height="16" style="TotalText" hTextAlign="Right" vTextAlign="Middle" blankWhenNull="true" textAdjust="StretchHeight" pattern="#,##0"><expression><![CDATA[$V{SUM_TRANSACTIONS}]]></expression></element>
