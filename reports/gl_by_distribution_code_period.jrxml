                <textFieldExpression><![CDATA[$P{CLIENT_NAME} + "  |  " + new java.text.SimpleDateFormat("yyyy-MM-dd").format($P{FROM_DT}) + " to " + new java.text.SimpleDateFormat("yyyy-MM-dd").format($P{TO_DT}) + "  |  frozen FTs by accounting date; net = sum of GL amounts" + ($P{DST_ID_F} == null ? "" : "  |  Distribution code: " + $P{DST_ID_F}) + ($P{GL_ACCT_F} == null ? "" : "  |  GL account (exact): " + $P{GL_ACCT_F}) + ($P{GL_DIVISION_F} == null ? "" : "  |  GL division: " + $P{GL_DIVISION_F}) + ($P{CIS_DIVISION_F} == null ? "" : "  |  CIS division: " + $P{CIS_DIVISION_F}) + ($P{FT_TYPE_FLG_F} == null ? "" : "  |  FT type (BS, BX, AD, AX, PS, PX): " + $P{FT_TYPE_FLG_F})]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true" textAdjust="StretchHeight">
                <reportElement style="Base" x="0" y="44" width="802" height="8" uuid="04b3a93d-da45-577b-89f7-b5bb604e7044"/>
