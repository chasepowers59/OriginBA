)
&& ($P{BATCH_NBR_FILTER} == null || $P{BATCH_NBR_FILTER}.trim().length() == 0
    || ($F{BATCH_NBR} != null && $F{BATCH_NBR}.toPlainString().equals($P{BATCH_NBR_FILTER}.trim()))
