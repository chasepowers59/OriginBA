            <staticText>
                <reportElement x="0" y="0" width="280" height="20" uuid="f8c2d0f2-f2dd-4cb8-89ab-4ce58b4d1532"/>
                <textElement><font isBold="true"/></textElement>
                <text><![CDATA[Metric]]></text>
