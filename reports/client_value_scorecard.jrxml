    <detail>
        <band height="18">
            <textField>
                <reportElement x="0" y="0" width="280" height="18" uuid="7405d412-f45e-4c6d-8253-fe95e2952be2"/>
                <textFieldExpression><![CDATA[$F{METRIC_NAME}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00">
                <reportElement x="300" y="0" width="255" height="18" uuid="47f3ebb7-c265-4c07-a2ca-578fe2cc0504"/>
