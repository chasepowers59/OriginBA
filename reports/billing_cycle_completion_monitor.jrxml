                <textFieldExpression><![CDATA[
"BILL_CYCLE=" + (($P{BILL_CYCLE_CODE} == null || $P{BILL_CYCLE_CODE}.trim().length()==0) ? "ALL" : $P{BILL_CYCLE_CODE}.trim())
+ " | BILL_DATE_RANGE=" + ($P{START_DATE} == null ? "MIN" : $P{START_DATE}) + " to " + ($P{END_DATE} == null ? "MAX" : $P{END_DATE})
                ]]></textFieldExpression>
            </textField>
            <frame>
                <reportElement style="SummaryBlue" x="0" y="72" width="1150" height="40" uuid="be8b2c82-e824-4a5a-a95f-35df34c6e6f4"/>
