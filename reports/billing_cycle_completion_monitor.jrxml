                <textField evaluationTime="Report"><reportElement x="360" y="12" width="370" height="16" uuid="d1686e95-f154-4ec4-92e3-fe0731f2a2ad"/><textFieldExpression><![CDATA["Generated Bill Segments: " + $V{TOTAL_GENERATED_SEGMENTS}]]></textFieldExpression></textField>
