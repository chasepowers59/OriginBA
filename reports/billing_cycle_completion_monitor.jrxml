    <style name="CompletionCell" style="Base" mode="Opaque" backcolor="#E5E7EB" forecolor="#0F172A" isBold="true">
        <conditionalStyle>
            <conditionExpression><![CDATA[$F{BILL_SEGMENT_COMPLETION_PCT} != null && $F{BILL_SEGMENT_COMPLETION_PCT}.doubleValue() < 95.0]]></conditionExpression>
            <style backcolor="#FEE2E2" forecolor="#7F1D1D"/>
        </conditionalStyle>
        <conditionalStyle>
            <conditionExpression><![CDATA[$F{BILL_SEGMENT_COMPLETION_PCT} != null && $F{BILL_SEGMENT_COMPLETION_PCT}.doubleValue() >= 95.0]]></conditionExpression>
            <style backcolor="#DCFCE7" forecolor="#14532D"/>
        </conditionalStyle>
    </style>

    <parameter name="LoggedInUser" class="com.jaspersoft.jasperserver.api.metadata.user.domain.User" isForPrompting="false"/>
    <parameter name="LoggedInUsername" class="java.lang.String" isForPrompting="false"/>
    <parameter name="BILL_CYCLE_CODE" class="java.lang.String"/>
    <parameter name="START_DATE" class="java.sql.Date"/>
    <parameter name="END_DATE" class="java.sql.Date"/>
    <parameter name="MIN_COMPLETION_PCT" class="java.lang.Double">
        <defaultValueExpression><![CDATA[Double.valueOf(0)]]></defaultValueExpression>
    </parameter>
    <parameter name="CLIENT_NAME" class="java.lang.String">
        <defaultValueExpression><![CDATA["INTERNAL USE ONLY"]]></defaultValueExpression>
    </parameter>

    <queryString language="domain"><![CDATA[
<query>
  <queryFields>
    <queryField id="BILL_CYCLE_CODE"/>
    <queryField id="BILL_CYCLE_DESCRIPTION"/>
    <queryField id="BILL_DATE"/>
    <queryField id="BILL_CREATE_DATE"/>
    <queryField id="GENERATED_BILL_COUNT"/>
    <queryField id="GENERATED_BILL_SEGMENT_COUNT"/>
    <queryField id="EXPECTED_BILL_SEGMENT_COUNT"/>
    <queryField id="MISSING_BILL_SEGMENT_COUNT"/>
    <queryField id="BILL_SEGMENT_COMPLETION_PCT"/>
  </queryFields>
</query>
    ]]></queryString>

    <field name="BILL_CYCLE_CODE" class="java.lang.String"><property name="net.sf.jasperreports.query.field.id" value="BILL_CYCLE_CODE"/></field>
    <field name="BILL_CYCLE_DESCRIPTION" class="java.lang.String"><property name="net.sf.jasperreports.query.field.id" value="BILL_CYCLE_DESCRIPTION"/></field>
    <field name="BILL_DATE" class="java.sql.Timestamp"><property name="net.sf.jasperreports.query.field.id" value="BILL_DATE"/></field>
    <field name="BILL_CREATE_DATE" class="java.sql.Timestamp"><property name="net.sf.jasperreports.query.field.id" value="BILL_CREATE_DATE"/></field>
    <field name="GENERATED_BILL_COUNT" class="java.lang.Long"><property name="net.sf.jasperreports.query.field.id" value="GENERATED_BILL_COUNT"/></field>
    <field name="GENERATED_BILL_SEGMENT_COUNT" class="java.lang.Long"><property name="net.sf.jasperreports.query.field.id" value="GENERATED_BILL_SEGMENT_COUNT"/></field>
    <field name="EXPECTED_BILL_SEGMENT_COUNT" class="java.lang.Long"><property name="net.sf.jasperreports.query.field.id" value="EXPECTED_BILL_SEGMENT_COUNT"/></field>
    <field name="MISSING_BILL_SEGMENT_COUNT" class="java.lang.Long"><property name="net.sf.jasperreports.query.field.id" value="MISSING_BILL_SEGMENT_COUNT"/></field>
    <field name="BILL_SEGMENT_COMPLETION_PCT" class="java.math.BigDecimal"><property name="net.sf.jasperreports.query.field.id" value="BILL_SEGMENT_COMPLETION_PCT"/></field>

    <sortField name="BILL_DATE" order="Descending"/>
    <sortField name="BILL_CYCLE_CODE" order="Ascending"/>

    <variable name="TOTAL_CYCLES" class="java.lang.Integer" calculation="Count">
        <variableExpression><![CDATA[$F{BILL_CYCLE_CODE}]]></variableExpression>
        <initialValueExpression><![CDATA[0]]></initialValueExpression>
    </variable>
    <variable name="TOTAL_GENERATED_SEGMENTS" class="java.lang.Long" calculation="Sum">
        <variableExpression><![CDATA[$F{GENERATED_BILL_SEGMENT_COUNT} == null ? 0L : $F{GENERATED_BILL_SEGMENT_COUNT}.longValue()]]></variableExpression>
        <initialValueExpression><![CDATA[0L]]></initialValueExpression>
    </variable>
    <variable name="TOTAL_MISSING_SEGMENTS" class="java.lang.Long" calculation="Sum">
        <variableExpression><![CDATA[$F{MISSING_BILL_SEGMENT_COUNT} == null ? 0L : $F{MISSING_BILL_SEGMENT_COUNT}.longValue()]]></variableExpression>
        <initialValueExpression><![CDATA[0L]]></initialValueExpression>
    </variable>

    <filterExpression><![CDATA[
($F{BILL_CYCLE_CODE} != null)
&& ($P{BILL_CYCLE_CODE} == null || $P{BILL_CYCLE_CODE}.trim().length() == 0 || $F{BILL_CYCLE_CODE}.equalsIgnoreCase($P{BILL_CYCLE_CODE}.trim()))
&& ($P{START_DATE} == null || ($F{BILL_DATE} != null && !$F{BILL_DATE}.before($P{START_DATE})))
&& ($P{END_DATE} == null || ($F{BILL_DATE} != null && $F{BILL_DATE}.before(new java.sql.Timestamp($P{END_DATE}.getTime() + 86400000L))))
&& ($P{MIN_COMPLETION_PCT} == null || $F{BILL_SEGMENT_COMPLETION_PCT} == null || $F{BILL_SEGMENT_COMPLETION_PCT}.doubleValue() >= $P{MIN_COMPLETION_PCT}.doubleValue())
    ]]></filterExpression>

    <title>
        <band height="112">
            <frame>
