    <variable name="FIRST_BATCH_CD" class="java.lang.String" calculation="First"><variableExpression><![CDATA[$F{SNAPSHOT_AUDIT.BATCH_CD}]]></variableExpression></variable>
    <variable name="MAX_FREEZE_DTTM" class="java.sql.Timestamp" calculation="Highest"><variableExpression><![CDATA[$F{SNAPSHOT_AUDIT.FREEZE_DTTM}]]></variableExpression></variable>
    <variable name="FIRST_FREEZE_USER" class="java.lang.String" calculation="First"><variableExpression><![CDATA[$F{SNAPSHOT_AUDIT.FREEZE_USER_NAME}]]></variableExpression></variable>
    <variable name="MAX_LOAD_DTTM" class="java.sql.Timestamp" calculation="Highest"><variableExpression><![CDATA[$F{SNAPSHOT_AUDIT.LOAD_DTTM}]]></variableExpression></variable>
    <variable name="ROW_SEVERITY" class="java.lang.String" calculation="Nothing"><variableExpression><![CDATA[
($F{GL_LINE.GL_ACCT} == null || $F{GL_LINE.GL_ACCT}.trim().length() == 0 || $F{GL_LINE.GL_AMOUNT} == null || $F{GL_LINE.GL_AMOUNT}.compareTo(java.math.BigDecimal.ZERO) == 0) ? "ERROR"
: (($F{FT_CORE.GL_DISTRIB_STATUS_DESC} == null || !($F{FT_CORE.GL_DISTRIB_STATUS_DESC}.toUpperCase().contains("DISTRIBUT") || $F{FT_CORE.GL_DISTRIB_STATUS_DESC}.toUpperCase().contains("COMPLETE") || $F{FT_CORE.GL_DISTRIB_STATUS_DESC}.toUpperCase().contains("POST"))) ? "WARN" : "OK")
    ]]></variableExpression></variable>
    <variable name="TOTAL_GL_LINES" class="java.lang.Integer" calculation="Count"><variableExpression><![CDATA[$F{GL_LINE.FT_ID}]]></variableExpression><initialValueExpression><![CDATA[0]]></initialValueExpression></variable>
    <variable name="DISTINCT_FTS" class="java.lang.Long" calculation="DistinctCount"><variableExpression><![CDATA[$F{GL_LINE.FT_ID}]]></variableExpression><initialValueExpression><![CDATA[0L]]></initialValueExpression></variable>
    <variable name="DISTINCT_GL_ACCTS" class="java.lang.Long" calculation="DistinctCount"><variableExpression><![CDATA[$F{GL_LINE.GL_ACCT}]]></variableExpression><initialValueExpression><![CDATA[0L]]></initialValueExpression></variable>
    <variable name="DISTINCT_CUSTOMERS" class="java.lang.Long" calculation="DistinctCount"><variableExpression><![CDATA[$F{ACCT_SERVICE.CUSTOMER_NAME_UPR}]]></variableExpression><initialValueExpression><![CDATA[0L]]></initialValueExpression></variable>
    <variable name="TOTAL_GL_AMOUNT" class="java.math.BigDecimal" calculation="Sum"><variableExpression><![CDATA[$F{GL_LINE.GL_AMOUNT}]]></variableExpression><initialValueExpression><![CDATA[java.math.BigDecimal.ZERO]]></initialValueExpression></variable>
    <variable name="TOTAL_STAT_AMOUNT" class="java.math.BigDecimal" calculation="Sum"><variableExpression><![CDATA[$F{GL_LINE.STATISTIC_AMOUNT}]]></variableExpression><initialValueExpression><![CDATA[java.math.BigDecimal.ZERO]]></initialValueExpression></variable>
    <variable name="TOTAL_DEBIT_AMOUNT" class="java.math.BigDecimal" calculation="Sum"><variableExpression><![CDATA[($F{GL_LINE.GL_AMOUNT} != null && $F{GL_LINE.GL_AMOUNT}.compareTo(java.math.BigDecimal.ZERO) > 0) ? $F{GL_LINE.GL_AMOUNT} : java.math.BigDecimal.ZERO]]></variableExpression><initialValueExpression><![CDATA[java.math.BigDecimal.ZERO]]></initialValueExpression></variable>
    <variable name="TOTAL_CREDIT_AMOUNT" class="java.math.BigDecimal" calculation="Sum"><variableExpression><![CDATA[($F{GL_LINE.GL_AMOUNT} != null && $F{GL_LINE.GL_AMOUNT}.compareTo(java.math.BigDecimal.ZERO) < 0) ? $F{GL_LINE.GL_AMOUNT}.abs() : java.math.BigDecimal.ZERO]]></variableExpression><initialValueExpression><![CDATA[java.math.BigDecimal.ZERO]]></initialValueExpression></variable>
    <variable name="OK_ROWS" class="java.lang.Integer" calculation="Sum"><variableExpression><![CDATA["OK".equals($V{ROW_SEVERITY}) ? 1 : 0]]></variableExpression><initialValueExpression><![CDATA[0]]></initialValueExpression></variable>
    <variable name="WARN_ROWS" class="java.lang.Integer" calculation="Sum"><variableExpression><![CDATA["WARN".equals($V{ROW_SEVERITY}) ? 1 : 0]]></variableExpression><initialValueExpression><![CDATA[0]]></initialValueExpression></variable>
    <variable name="ERROR_ROWS" class="java.lang.Integer" calculation="Sum"><variableExpression><![CDATA["ERROR".equals($V{ROW_SEVERITY}) ? 1 : 0]]></variableExpression><initialValueExpression><![CDATA[0]]></initialValueExpression></variable>
    <variable name="FT_TYPE_LINE_COUNT" class="java.lang.Integer" resetType="Group" resetGroup="FT_TYPE_GROUP" calculation="Count"><variableExpression><![CDATA[$F{GL_LINE.FT_ID}]]></variableExpression><initialValueExpression><![CDATA[0]]></initialValueExpression></variable>
    <variable name="FT_TYPE_NET_AMOUNT" class="java.math.BigDecimal" resetType="Group" resetGroup="FT_TYPE_GROUP" calculation="Sum"><variableExpression><![CDATA[$F{GL_LINE.GL_AMOUNT}]]></variableExpression><initialValueExpression><![CDATA[java.math.BigDecimal.ZERO]]></initialValueExpression></variable>
    <variable name="GL_ACCT_LINE_COUNT" class="java.lang.Integer" resetType="Group" resetGroup="GL_ACCT_GROUP" calculation="Count"><variableExpression><![CDATA[$F{GL_LINE.FT_ID}]]></variableExpression><initialValueExpression><![CDATA[0]]></initialValueExpression></variable>
    <variable name="GL_ACCT_NET_AMOUNT" class="java.math.BigDecimal" resetType="Group" resetGroup="GL_ACCT_GROUP" calculation="Sum"><variableExpression><![CDATA[$F{GL_LINE.GL_AMOUNT}]]></variableExpression><initialValueExpression><![CDATA[java.math.BigDecimal.ZERO]]></initialValueExpression></variable>

    <filterExpression><![CDATA[
($P{BATCH_NBR_FILTER} != null)
&& ($F{GL_LINE.FT_ID} != null)
&& ($P{BATCH_CD_FILTER} == null || $P{BATCH_CD_FILTER}.trim().length() == 0 || ($F{SNAPSHOT_AUDIT.BATCH_CD} != null && $F{SNAPSHOT_AUDIT.BATCH_CD}.equalsIgnoreCase($P{BATCH_CD_FILTER}.trim())))
&& ($P{GL_STATUS_FILTER} == null || $P{GL_STATUS_FILTER}.trim().length() == 0 || ($F{FT_CORE.GL_DISTRIB_STATUS_DESC} != null && $F{FT_CORE.GL_DISTRIB_STATUS_DESC}.toUpperCase().contains($P{GL_STATUS_FILTER}.trim().toUpperCase())))
&& ($P{GL_ACCT_FILTER} == null || $P{GL_ACCT_FILTER}.trim().length() == 0 || ($F{GL_LINE.GL_ACCT} != null && $F{GL_LINE.GL_ACCT}.toUpperCase().contains($P{GL_ACCT_FILTER}.trim().toUpperCase())))
&& ($P{MIN_ABS_GROUP_AMOUNT} == null || $F{GL_LINE.GL_AMOUNT} == null || $F{GL_LINE.GL_AMOUNT}.abs().compareTo($P{MIN_ABS_GROUP_AMOUNT}) >= 0)
&& (($P{ONLY_EXCEPTION_GROUPS} == null || !$P{ONLY_EXCEPTION_GROUPS}.booleanValue()) || !"OK".equals($V{ROW_SEVERITY}))
    ]]></filterExpression>

    <group name="FT_TYPE_GROUP">
        <groupExpression><![CDATA[$F{FT_CORE.FT_TYPE_FLG_DESC} == null ? "Unknown FT Type" : $F{FT_CORE.FT_TYPE_FLG_DESC}]]></groupExpression>
        <groupHeader><band height="22"><textField><reportElement style="GroupBlue" x="0" y="0" width="1150" height="22" uuid="33f428dd-a406-4751-b0d7-f6ccb67c66dc"/><textFieldExpression><![CDATA["Financial Transaction Type: " + ($F{FT_CORE.FT_TYPE_FLG_DESC} == null ? "Unknown FT Type" : $F{FT_CORE.FT_TYPE_FLG_DESC})]]></textFieldExpression></textField></band></groupHeader>
        <groupFooter><band height="18"><textField><reportElement style="GroupBlue" x="0" y="0" width="1150" height="18" uuid="0ff8e1ec-b9dd-4c4b-bd90-037e13bb33a4"/><textFieldExpression><![CDATA["FT Type Subtotal | Lines: " + $V{FT_TYPE_LINE_COUNT} + " | Net Amount: " + new java.text.DecimalFormat("#,##0.00;(#,##0.00)").format($V{FT_TYPE_NET_AMOUNT})]]></textFieldExpression></textField></band></groupFooter>
