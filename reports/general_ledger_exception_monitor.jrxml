            <textField><reportElement style="MetaBlue" x="730" y="40" width="403" height="14" uuid="7bcbfa8f-b534-4dc0-bdc7-355371405667"/><textElement textAlignment="Right"/><textFieldExpression><![CDATA["BATCH_NBR=" + ($P{BATCH_NBR_FILTER} == null ? "REQUIRED" : $P{BATCH_NBR_FILTER}.toPlainString()) + " | BATCH_CD=" + (($P{BATCH_CD_FILTER} == null || $P{BATCH_CD_FILTER}.trim().length() == 0) ? "ALL" : $P{BATCH_CD_FILTER}.trim()) + " | STATUS=" + (($P{GL_STATUS_FILTER} == null || $P{GL_STATUS_FILTER}.trim().length() == 0) ? "ALL" : $P{GL_STATUS_FILTER}.trim()) + " | GL_ACCOUNT=" + (($P{GL_ACCT_FILTER} == null || $P{GL_ACCT_FILTER}.trim().length() == 0) ? "ALL" : $P{GL_ACCT_FILTER}.trim()) + " | EXCEPTIONS_ONLY=" + (($P{ONLY_EXCEPTION_GROUPS} != null && $P{ONLY_EXCEPTION_GROUPS}.booleanValue()) ? "Y" : "N")]]></textFieldExpression></textField>
