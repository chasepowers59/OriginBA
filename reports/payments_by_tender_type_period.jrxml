                <textFieldExpression><![CDATA[$P{CLIENT_NAME} + "  |  " + new java.text.SimpleDateFormat("yyyy-MM-dd").format($P{FROM_DT}) + " to " + new java.text.SimpleDateFormat("yyyy-MM-dd").format($P{TO_DT}) + "  |  cancelled = tender carries a cancel reason" + ($P{TENDER_TYPE_CD_F} == null ? "" : "  |  Tender type: " + $P{TENDER_TYPE_CD_F}) + ($P{PAYOR_ACCT_ID_F} == null ? "" : "  |  Payor account ID: " + $P{PAYOR_ACCT_ID_F}) + ($P{TNDR_CTL_ID_F} == null ? "" : "  |  Tender control ID: " + $P{TNDR_CTL_ID_F}) + ($P{MIN_AMT_F} == null ? "" : "  |  Minimum tender amount: " + $P{MIN_AMT_F})]]></textFieldExpression>
            </textField>
