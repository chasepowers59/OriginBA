    <variable name="TOTAL_USAGE_QTY" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{USAGE_QTY}]]></variableExpression>
        <initialValueExpression><![CDATA[new java.math.BigDecimal(0)]]></initialValueExpression>
    </variable>
    <variable name="AVG_USAGE_QTY_PER_DAY" class="java.lang.Double" calculation="Average">
        <variableExpression><![CDATA[$F{USAGE_QTY_PER_DAY} == null ? null : Double.valueOf($F{USAGE_QTY_PER_DAY}.doubleValue())]]></variableExpression>
    </variable>
    <variable name="HIGH_USAGE_ROWS" class="java.lang.Integer" calculation="Sum">
        <variableExpression><![CDATA[
($F{USAGE_QTY_PER_DAY} != null && $F{USAGE_QTY_PER_DAY}.doubleValue() >= ($P{HIGH_USAGE_PER_DAY} == null ? 0d : $P{HIGH_USAGE_PER_DAY}.doubleValue())) ? 1 : 0
        ]]></variableExpression>
        <initialValueExpression><![CDATA[0]]></initialValueExpression>
    </variable>
    <variable name="MISSING_ACCOUNT_ROWS" class="java.lang.Integer" calculation="Sum">
        <variableExpression><![CDATA[$F{ACCT_ID} == null ? 1 : 0]]></variableExpression>
        <initialValueExpression><![CDATA[0]]></initialValueExpression>
    </variable>
    <variable name="DISTINCT_OUTLIER_DEVICES" class="java.lang.Long" calculation="DistinctCount">
        <variableExpression><![CDATA[
($F{USAGE_QTY_PER_DAY} != null && $F{USAGE_QTY_PER_DAY}.doubleValue() >= ($P{HIGH_USAGE_PER_DAY} == null ? 0d : $P{HIGH_USAGE_PER_DAY}.doubleValue())) ? $F{D1_DEVICE_ID} : null
        ]]></variableExpression>
        <initialValueExpression><![CDATA[0L]]></initialValueExpression>
    </variable>
    <variable name="DISTINCT_OUTLIER_ACCOUNTS" class="java.lang.Long" calculation="DistinctCount">
