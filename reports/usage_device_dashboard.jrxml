($F{USAGE_QTY_PER_DAY} != null && $F{USAGE_QTY_PER_DAY}.doubleValue() >= ($P{HIGH_USAGE_PER_DAY} == null ? 0d : $P{HIGH_USAGE_PER_DAY}.doubleValue())) ? $F{ACCT_ID} : null
        ]]></variableExpression>
        <initialValueExpression><![CDATA[0L]]></initialValueExpression>
    </variable>

    <filterExpression><![CDATA[
($F{D1_USAGE_ID} != null)
&& ($P{DEVICE_TYPE_TEXT} == null || $P{DEVICE_TYPE_TEXT}.trim().length() == 0 || ($F{DEVICE_TYPE_DESCR} != null && $F{DEVICE_TYPE_DESCR}.toUpperCase().contains($P{DEVICE_TYPE_TEXT}.trim().toUpperCase())))
&& ($P{ACCOUNT_ID_TEXT} == null || $P{ACCOUNT_ID_TEXT}.trim().length() == 0 || ($F{ACCT_ID} != null && $F{ACCT_ID}.toUpperCase().contains($P{ACCOUNT_ID_TEXT}.trim().toUpperCase())))
&& ($P{CUSTOMER_NAME_TEXT} == null || $P{CUSTOMER_NAME_TEXT}.trim().length() == 0 || ($F{CUSTOMER_NAME} != null && $F{CUSTOMER_NAME}.toUpperCase().contains($P{CUSTOMER_NAME_TEXT}.trim().toUpperCase())))
&& ($P{START_TS} == null || ($F{USAGE_START_DTTM} != null && !$F{USAGE_START_DTTM}.before($P{START_TS})))
&& ($P{END_TS} == null || ($F{USAGE_START_DTTM} != null && $F{USAGE_START_DTTM}.before($P{END_TS})))
&& ($P{ONLY_HIGH_USAGE} == null || !$P{ONLY_HIGH_USAGE}.booleanValue() || ($F{USAGE_QTY_PER_DAY} != null && $F{USAGE_QTY_PER_DAY}.doubleValue() >= ($P{HIGH_USAGE_PER_DAY} == null ? 0d : $P{HIGH_USAGE_PER_DAY}.doubleValue())))
&& ($P{ONLY_MISSING_ACCOUNT} == null || !$P{ONLY_MISSING_ACCOUNT}.booleanValue() || $F{ACCT_ID} == null)
    ]]></filterExpression>

