<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
    name="lookup_description_completeness_audit"
    pageWidth="842"
    pageHeight="595"
    orientation="Landscape"
    columnWidth="802"
    leftMargin="20"
    rightMargin="20"
    topMargin="20"
    bottomMargin="20"
    uuid="b2ca94ef-0f89-4a84-a110-05a7f265f703">

    <parameter name="CLIENT_ID" class="java.lang.String"/>
    <parameter name="START_TS" class="java.sql.Timestamp"/>
    <parameter name="END_TS" class="java.sql.Timestamp"/>

    <queryString language="SQL">
        <![CDATA[
WITH
coll_codes AS (
    SELECT DISTINCT TRIM(A.COLL_CL_CD) AS CODE
    FROM CISADM.CI_ACCT A
    WHERE NULLIF(TRIM(A.COLL_CL_CD), '') IS NOT NULL
      AND ($P{CLIENT_ID} IS NULL OR A.CIS_DIVISION = $P{CLIENT_ID})
),
coll_desc AS (
    SELECT C.CODE, NULLIF(TRIM(L.DESCR), '') AS DESCR
    FROM coll_codes C
    LEFT JOIN CISADM.CI_COLL_CL_L L
      ON L.COLL_CL_CD = C.CODE
     AND L.LANGUAGE_CD = 'EN'
),
cc_cl_codes AS (
    SELECT DISTINCT TRIM(CC.CC_CL_CD) AS CODE
    FROM CISADM.CI_CC CC
    JOIN CISADM.CI_ACCT A ON A.ACCT_ID = CC.ACCT_ID
    WHERE NULLIF(TRIM(CC.CC_CL_CD), '') IS NOT NULL
      AND CC.CC_DTTM >= $P{START_TS}
      AND CC.CC_DTTM <  $P{END_TS}
      AND ($P{CLIENT_ID} IS NULL OR A.CIS_DIVISION = $P{CLIENT_ID})
),
cc_cl_desc AS (
    SELECT C.CODE, NULLIF(TRIM(L.DESCR), '') AS DESCR
    FROM cc_cl_codes C
    LEFT JOIN CISADM.CI_CC_CL_L L
      ON L.CC_CL_CD = C.CODE
     AND L.LANGUAGE_CD = 'EN'
)
SELECT DOMAIN_FIELD,
       TOTAL_DISTINCT_VALUES,
       MISSING_DESCRIPTIONS,
       COVERAGE_PCT,
       MISSING_SAMPLES
FROM (
    SELECT
        'COLL_CL_CD' AS DOMAIN_FIELD,
        COUNT(*) AS TOTAL_DISTINCT_VALUES,
        SUM(CASE WHEN DESCR IS NULL THEN 1 ELSE 0 END) AS MISSING_DESCRIPTIONS,
        ROUND(100 * (COUNT(*) - SUM(CASE WHEN DESCR IS NULL THEN 1 ELSE 0 END)) / NULLIF(COUNT(*), 0), 2) AS COVERAGE_PCT,
        LISTAGG(CASE WHEN DESCR IS NULL THEN CODE END, ', ') WITHIN GROUP (ORDER BY CODE) AS MISSING_SAMPLES
    FROM coll_desc

    UNION ALL
    SELECT
        'CC_CL_CD',
        COUNT(*),
        SUM(CASE WHEN DESCR IS NULL THEN 1 ELSE 0 END),
        ROUND(100 * (COUNT(*) - SUM(CASE WHEN DESCR IS NULL THEN 1 ELSE 0 END)) / NULLIF(COUNT(*), 0), 2),
        LISTAGG(CASE WHEN DESCR IS NULL THEN CODE END, ', ') WITHIN GROUP (ORDER BY CODE)
    FROM cc_cl_desc
)
ORDER BY DOMAIN_FIELD
        ]]>
    </queryString>

    <field name="DOMAIN_FIELD" class="java.lang.String"/>
    <field name="TOTAL_DISTINCT_VALUES" class="java.math.BigDecimal"/>
    <field name="MISSING_DESCRIPTIONS" class="java.math.BigDecimal"/>
    <field name="COVERAGE_PCT" class="java.math.BigDecimal"/>
    <field name="MISSING_SAMPLES" class="java.lang.String"/>

    <title>
