            <textField><reportElement x="175" y="0" width="130" height="18" uuid="9d9ad447-335f-4248-a1eb-f9a6b63cfeb5"/><textElement textAlignment="Right"/><textFieldExpression><![CDATA[$F{TOTAL_DISTINCT_VALUES}]]></textFieldExpression></textField>
            <textField><reportElement x="310" y="0" width="150" height="18" uuid="f45f3f5d-46b1-49bb-abca-f0c6f3e9a930"/><textElement textAlignment="Right"/><textFieldExpression><![CDATA[$F{MISSING_DESCRIPTIONS}]]></textFieldExpression></textField>
