<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
    name="line_items"
    pageWidth="540"
    pageHeight="100"
    columnWidth="540"
    leftMargin="0"
    rightMargin="0"
    topMargin="0"
    bottomMargin="0"
    uuid="9d3f5ff9-2d4f-47fc-b8a4-63d85bf75441">

    <parameter name="CLIENT_ID" class="java.lang.String"/>
    <parameter name="BILL_ID" class="java.lang.String"/>

    <queryString language="SQL">
        <![CDATA[
SELECT
    S.BSEG_ID AS LINE_ID,
    S.SA_ID AS ITEM_CODE,
    COALESCE(
      NULLIF(TRIM(BSEG_STAT_LU.VALUE_NAME), ''),
      'BSEG_STATUS_' || S.BSEG_STAT_FLG
    ) AS ITEM_DESCRIPTION,
    1 AS QUANTITY,
    0 AS UNIT_PRICE,
    0 AS LINE_AMOUNT
FROM CISADM.CI_BSEG S
LEFT JOIN CISADM.CI_LOOKUP_VAL BSEG_STAT_LU
  ON TRIM(BSEG_STAT_LU.FIELD_NAME) = 'BSEG_STAT_FLG'
 AND TRIM(BSEG_STAT_LU.FIELD_VALUE) = TRIM(S.BSEG_STAT_FLG)
WHERE S.BILL_ID = $P{BILL_ID}
ORDER BY S.BSEG_ID
        ]]>
    </queryString>

    <field name="LINE_ID" class="java.lang.String"/>
    <field name="ITEM_CODE" class="java.lang.String"/>
    <field name="ITEM_DESCRIPTION" class="java.lang.String"/>
    <field name="QUANTITY" class="java.math.BigDecimal"/>
    <field name="UNIT_PRICE" class="java.math.BigDecimal"/>
    <field name="LINE_AMOUNT" class="java.math.BigDecimal"/>

