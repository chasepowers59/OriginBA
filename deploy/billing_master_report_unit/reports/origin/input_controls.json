{
  "reportUnitUri": "/reports/origin/billing_master",
  "dataSources": {
    "DEV": "C2M_DEV_DS",
    "QA": "C2M_QA_DS",
    "PROD": "C2M_PROD_DS"
  },
  "inputControls": [
    {
      "id": "CLIENT_ID",
      "label": "Bill Cycle",
      "type": "singleSelectQuery",
      "mandatory": true,
      "visible": true,
      "valueColumn": "CLIENT_ID",
      "visibleColumn": "CLIENT_LABEL",
      "query": "SELECT DISTINCT TRIM(BILL_CYC_CD) AS CLIENT_ID, TRIM(BILL_CYC_CD) AS CLIENT_LABEL FROM CISADM.CI_BILL WHERE NULLIF(TRIM(BILL_CYC_CD), '') IS NOT NULL ORDER BY TRIM(BILL_CYC_CD)"
    },
    {
      "id": "START_TS",
      "label": "Start Timestamp",
      "type": "dateTime",
      "mandatory": true,
      "visible": true
    },
    {
      "id": "END_TS",
      "label": "End Timestamp",
      "type": "dateTime",
      "mandatory": true,
      "visible": true
    },
    {
      "id": "CLIENT_LOGO_URL",
      "label": "Client Logo URL",
      "type": "singleValueText",
      "mandatory": false,
      "visible": false
    }
  ],
  "multiSelectPattern": {
    "oracleSqlExample": "AND ITEM_CODE IN (SELECT COLUMN_VALUE FROM TABLE(:ITEM_CODE_LIST))",
    "parameterTypeHint": "Collection"
  }
}
