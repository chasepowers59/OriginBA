            <textField><reportElement x="175" y="0" width="260" height="18" uuid="20fe37cd-f27f-4fcd-8697-8cf2c7784500"/><textFieldExpression><![CDATA[$F{KPI_NAME}]]></textFieldExpression></textField>
            <textField pattern="#,##0.00"><reportElement x="440" y="0" width="115" height="18" uuid="85c89f3b-1565-48ca-a6f0-574ff47ca395"/><textElement textAlignment="Right"/><textFieldExpression><![CDATA[$F{KPI_VALUE}]]></textFieldExpression></textField>
        </band>
