    <jdbcQuery id="CMS_PERSON_NAME" datasourceId="Origin_DEV_DS">
      <fieldList>
        <field id="D1_SP_ID" type="java.lang.String"></field>
        <field id="NAME_VALUE_UPPER" type="java.lang.String"></field>
      </fieldList>
      <query>select
  sp.d1_sp_id, 
  cn.name_value_upper
 from
  cisadm.d1_sp sp
  ,cisadm.d1_sp_contact spc
  ,cisadm.d1_contact_name cn
where
  sp.d1_sp_id = spc.d1_sp_id
  and spc.contact_id = cn.contact_id
  and spc.sp_cntct_rel_flg = 'D1MC'</query>
    </jdbcQuery>
    <jdbcQuery id="CMS_LATEST_MSRMT_CYC_RTE_SCHED" datasourceId="Origin_DEV_DS">
      <fieldList>
        <field id="MSRMT_CYC_CD" type="java.lang.String"></field>
        <field id="MSRMT_CYC_RTE_CD" type="java.lang.String"></field>
        <field id="SCHED_SELECTION_DT" type="java.sql.Timestamp"></field>
      </fieldList>
      <query>select 
  mcsr.msrmt_cyc_cd,
  mcsr.msrmt_cyc_rte_cd,
  max(sched_selection_dt) as sched_selection_dt
from 
  cisadm.d1_msrmt_cyc_sched_rte mcsr
where
  mcsr.sched_selection_dt &lt;= trunc(sysdate)
group by
  mcsr.msrmt_cyc_cd,
  mcsr.msrmt_cyc_rte_cd</query>
    </jdbcQuery>
