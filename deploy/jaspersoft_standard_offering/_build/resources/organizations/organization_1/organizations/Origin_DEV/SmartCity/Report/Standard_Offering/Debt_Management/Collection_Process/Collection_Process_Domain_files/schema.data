    <jdbcQuery id="CMS_IS_NEXT_COLL_EVT" datasourceId="Origin_DEV_DS">
      <fieldList>
        <field id="COLL_PROC_ID" type="java.lang.String"></field>
        <field id="EVT_SEQ" type="java.math.BigDecimal"></field>
        <field id="IS_NEXT" type="java.lang.String"></field>
      </fieldList>
      <query>select 
  ce.coll_proc_id
  ,min(ce.evt_seq) as EVT_SEQ
  ,'Y' as IS_NEXT
from
  cisadm.ci_coll_evt ce
where
  ce.completion_dt is null
group by
