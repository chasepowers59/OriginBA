        <field id="CI_ACCT_PER.RECV_QTE_SW" type="java.lang.String"></field>
        <field id="CI_ACCT_PER.WEB_ACCESS_FLG" type="java.lang.String"></field>
        <field id="CI_ACCT_PER.ALW_PREF_FLG" type="java.lang.String"></field>
        <field id="CI_ACCT_PER.CSS_ACCESS_ROLE_FLG" type="java.lang.String"></field>
        <field id="CI_LOOKUP_VAL_L.FIELD_NAME" type="java.lang.String"></field>
        <field id="CI_LOOKUP_VAL_L.FIELD_VALUE" type="java.lang.String"></field>
        <field id="CI_LOOKUP_VAL_L.LANGUAGE_CD" type="java.lang.String"></field>
        <field id="CI_LOOKUP_VAL_L.VERSION" type="java.math.BigDecimal"></field>
        <field id="CI_LOOKUP_VAL_L.DESCR" type="java.lang.String"></field>
        <field id="CI_LOOKUP_VAL_L.OWNER_FLG" type="java.lang.String"></field>
        <field id="CI_LOOKUP_VAL_L.DESCR_OVRD" type="java.lang.String"></field>
        <field id="CI_LOOKUP_VAL_L.DESCRLONG" type="java.lang.String"></field>
        <field id="CI_MATCH_TYPE_L.MATCH_TYPE_CD" type="java.lang.String"></field>
        <field id="CI_MATCH_TYPE_L.LANGUAGE_CD" type="java.lang.String"></field>
        <field id="CI_MATCH_TYPE_L.DESCR" type="java.lang.String"></field>
        <field id="CI_MATCH_TYPE_L.VERSION" type="java.math.BigDecimal"></field>
        <field id="PAY_EVENT_ID_DISTINCT" dataSetExpression="CountDistinct(CI_PAY_EVENT.PAY_EVENT_ID, 'Current')" type="java.lang.Long"></field>
        <field id="PAY_ID_DISTINCT" dataSetExpression="CountDistinct(CI_PAY.PAY_ID, 'Current')" type="java.lang.Long"></field>
        <field id="DAYS_OLD" dataSetExpression="ElapsedDays(Today(0), CI_PAY_EVENT.CRE_DTTM)" type="java.math.BigDecimal"></field>
        <field id="ACCT_ID_DISTINCT" dataSetExpression="CountDistinct(CI_PAY.ACCT_ID, 'Current')" type="java.lang.Long"></field>
      </fieldList>
      <filterString>CI_ACCT_PER.MAIN_CUST_SW == 'Y' and CI_LOOKUP_VAL_L.FIELD_NAME == 'PAY_STATUS_FLG                ' and CI_LOOKUP_VAL_L.LANGUAGE_CD == 'ENG' and CI_PER_NAME.NAME_TYPE_FLG == 'PRIM'</filterString>
      <joinInfo alias="CI_PAY" referenceId="CI_PAY"></joinInfo>
      <joinList>
        <join expr="CI_PAY.PAY_EVENT_ID == CI_PAY_EVENT.PAY_EVENT_ID" left="CI_PAY" right="CI_PAY_EVENT" type="inner" weight="1"></join>
        <join expr="CI_PAY.CAN_RSN_CD == CI_PAY_CAN_RSN_L.CAN_RSN_CD and CI_PAY_CAN_RSN_L.LANGUAGE_CD == 'ENG'" left="CI_PAY" right="CI_PAY_CAN_RSN_L" type="leftOuter" weight="1"></join>
        <join expr="CI_PAY.MATCH_TYPE_CD == CI_MATCH_TYPE_L.MATCH_TYPE_CD and CI_MATCH_TYPE_L.LANGUAGE_CD == 'ENG'" left="CI_PAY" right="CI_MATCH_TYPE_L" type="leftOuter" weight="1"></join>
        <join expr="CI_PAY.PAY_STATUS_FLG == CI_LOOKUP_VAL_L.FIELD_VALUE and CI_LOOKUP_VAL_L.FIELD_NAME == 'PAY_STATUS_FLG' and CI_LOOKUP_VAL_L.LANGUAGE_CD == 'ENG'" left="CI_PAY" right="CI_LOOKUP_VAL_L" type="inner" weight="1"></join>
        <join expr="CI_PAY.ACCT_ID == CI_ACCT_PER.ACCT_ID and CI_ACCT_PER.MAIN_CUST_SW == 'Y'" left="CI_PAY" right="CI_ACCT_PER" type="inner" weight="1"></join>
        <join expr="CI_ACCT_PER.PER_ID == CI_PER_NAME.PER_ID and CI_PER_NAME.NAME_TYPE_FLG == 'PRIM' and CI_ACCT_PER.MAIN_CUST_SW == 'Y'" left="CI_ACCT_PER" right="CI_PER_NAME" type="inner" weight="1"></join>
      </joinList>
      <joinOptions></joinOptions>
      <tableRefList>
        <tableRef alwaysIncludeTable="false" tableAlias="CI_PAY_CAN_RSN_L" tableId="CI_PAY_CAN_RSN_L"></tableRef>
        <tableRef alwaysIncludeTable="false" tableAlias="CI_ACCT_PER" tableId="CI_ACCT_PER"></tableRef>
        <tableRef alwaysIncludeTable="false" tableAlias="CI_PAY" tableId="CI_PAY"></tableRef>
        <tableRef alwaysIncludeTable="false" tableAlias="CI_PAY_EVENT" tableId="CI_PAY_EVENT"></tableRef>
        <tableRef alwaysIncludeTable="false" tableAlias="CI_LOOKUP_VAL_L" tableId="CI_LOOKUP_VAL_L"></tableRef>
        <tableRef alwaysIncludeTable="false" tableAlias="CI_MATCH_TYPE_L" tableId="CI_MATCH_TYPE_L"></tableRef>
        <tableRef alwaysIncludeTable="false" tableAlias="CI_PER_NAME" tableId="CI_PER_NAME"></tableRef>
      </tableRefList>
    </jdbcTable>
  </resources>
</schema>
