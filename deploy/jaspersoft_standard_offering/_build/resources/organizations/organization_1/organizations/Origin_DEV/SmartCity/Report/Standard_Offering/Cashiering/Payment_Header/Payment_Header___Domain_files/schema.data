        <field id="CI_PAY_CAN_RSN_L.LANGUAGE_CD" type="java.lang.String"></field>
        <field id="CI_PAY_CAN_RSN_L.VERSION" type="java.math.BigDecimal"></field>
        <field id="CI_PAY_CAN_RSN_L.DESCR" type="java.lang.String"></field>
