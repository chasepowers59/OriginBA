        <field id="CSS_ACCESS_ROLE_FLG" type="java.lang.String"></field>
      </fieldList>
      <filterString>MAIN_CUST_SW == 'Y'</filterString>
    </jdbcTable>
    <jdbcTable id="CI_MATCH_TYPE_L" datasourceId="Origin_DEV_DS" datasourceTableName="CI_MATCH_TYPE_L" schemaAlias="CISADM">
      <fieldList>
        <field id="MATCH_TYPE_CD" type="java.lang.String"></field>
