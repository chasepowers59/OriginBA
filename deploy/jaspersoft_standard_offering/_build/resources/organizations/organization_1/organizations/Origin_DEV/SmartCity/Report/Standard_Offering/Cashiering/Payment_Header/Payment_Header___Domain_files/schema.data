        <field id="CI_ACCT_PER.RECEIVE_COPY_SW" type="java.lang.String"></field>
        <field id="CI_ACCT_PER.BILL_RTE_TYPE_CD" type="java.lang.String"></field>
        <field id="CI_ACCT_PER.BILL_FORMAT_FLG" type="java.lang.String"></field>
        <field id="CI_ACCT_PER.NBR_BILL_COPIES" type="java.math.BigDecimal"></field>
        <field id="CI_ACCT_PER.VERSION" type="java.math.BigDecimal"></field>
