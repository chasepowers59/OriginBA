        <field id="CI_PAY.MATCH_VAL" type="java.lang.String"></field>
        <field id="CI_PAY.ILM_DT" type="java.sql.Timestamp"></field>
        <field id="CI_PAY.ILM_ARCH_SW" type="java.lang.String"></field>
        <field id="CI_PAY_EVENT.PAY_EVENT_ID" type="java.lang.String"></field>
        <field id="CI_PAY_EVENT.PAY_DT" type="java.sql.Timestamp"></field>
        <field id="CI_PAY_EVENT.VERSION" type="java.math.BigDecimal"></field>
        <field id="CI_PAY_EVENT.CRE_DTTM" type="java.sql.Timestamp"></field>
        <field id="CI_PAY_EVENT.DOC_ID" type="java.lang.String"></field>
        <field id="CI_PAY_EVENT.ILM_DT" type="java.sql.Timestamp"></field>
        <field id="CI_PAY_EVENT.ILM_ARCH_SW" type="java.lang.String"></field>
