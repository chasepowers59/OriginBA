        <field id="FT_ID_DISTINCT" dataSetExpression="CountDistinct(CI_FT.FT_ID, 'Current')" type="java.lang.Long"></field>
        <field id="BSEG_ID_DISTINCT" dataSetExpression="CountDistinct(CI_BSEG.BSEG_ID, 'Current')" type="java.lang.Long"></field>
        <field id="PAY_SEG_ID_DISTINCT" dataSetExpression="CountDistinct(CI_PAY_SEG.PAY_SEG_ID, 'Current')" type="java.lang.Long"></field>
        <field id="ADJ_ID_DISTINCT" dataSetExpression="CountDistinct(CI_ADJ.ADJ_ID, 'Current')" type="java.lang.Long"></field>
        <field id="USER_ID_NAME" dataSetExpression="Concatenate(SC_USER.FIRST_NAME, ' ', SC_USER.LAST_NAME)" type="java.lang.String"></field>
        <field id="GL_DISTRIB_STATUS_DESC" dataSetExpression="Case(CI_FT.GL_DISTRIB_STATUS, 'D', 'Distributed', 'G', 'Generated', 'M', 'Modified', 'N', 'Pending')" type="java.lang.String"></field>
        <field id="FT_TYPE_FLG_DESC" dataSetExpression="Case(CI_FT.FT_TYPE_FLG, 'AD', 'Adjustment', 'AX', 'Adjustment Cancellation', 'BS', 'Bill Segment', 'BX', 'Bill Segment Cancellation', 'PS', 'Pay Segment', 'PX', 'Pay Segment Cancellation')" type="java.lang.String"></field>
      </fieldList>
      <filterString>CI_FT.REDUNDANT_SW == 'N'</filterString>
      <joinInfo alias="CI_FT" referenceId="CI_FT"></joinInfo>
      <joinList>
        <join expr="CI_FT.SIBLING_ID == CI_BSEG.BSEG_ID and CI_FT.BILL_ID == CI_BSEG.BILL_ID and CI_FT.REDUNDANT_SW == 'N' and CI_FT.FT_TYPE_FLG in ('BS', 'BX')" left="CI_FT" right="CI_BSEG" type="inner" weight="1"></join>
        <join expr="CI_FT.SIBLING_ID == CI_PAY_SEG.PAY_SEG_ID and CI_FT.PARENT_ID == CI_PAY_SEG.PAY_ID and CI_FT.REDUNDANT_SW == 'N' and CI_FT.FT_TYPE_FLG in ('PS', 'PX')" left="CI_FT" right="CI_PAY_SEG" type="inner" weight="1"></join>
        <join expr="CI_FT.SIBLING_ID == CI_ADJ.ADJ_ID and CI_FT.PARENT_ID == CI_ADJ.ADJ_TYPE_CD and CI_FT.REDUNDANT_SW == 'N' and CI_FT.FT_TYPE_FLG in ('AD', 'AX')" left="CI_FT" right="CI_ADJ" type="inner" weight="1"></join>
        <join expr="CI_FT.SA_ID == CI_SA.SA_ID and CI_FT.REDUNDANT_SW == 'N'" left="CI_FT" right="CI_SA" type="inner" weight="1"></join>
        <join expr="CI_SA.ACCT_ID == CI_ACCT.ACCT_ID" left="CI_SA" right="CI_ACCT" type="inner" weight="1"></join>
        <join expr="CI_ACCT.ACCT_ID == CI_ACCT_PER.ACCT_ID and CI_ACCT_PER.MAIN_CUST_SW == 'Y'" left="CI_ACCT" right="CI_ACCT_PER" type="inner" weight="1"></join>
        <join expr="CI_ACCT_PER.PER_ID == CI_PER_NAME.PER_ID and CI_PER_NAME.NAME_TYPE_FLG == 'PRIM'" left="CI_ACCT_PER" right="CI_PER_NAME" type="inner" weight="1"></join>
        <join expr="CI_SA.CIS_DIVISION == CI_SA_TYPE_L.CIS_DIVISION and CI_SA.SA_TYPE_CD == CI_SA_TYPE_L.SA_TYPE_CD and CI_SA_TYPE_L.LANGUAGE_CD == 'ENG'" left="CI_SA" right="CI_SA_TYPE_L" type="inner" weight="1"></join>
        <join expr="CI_SA.CHAR_PREM_ID == CI_PREM.PREM_ID" left="CI_SA" right="CI_PREM" type="leftOuter" weight="1"></join>
        <join expr="CI_FT.GL_DIVISION == CI_GL_DIVISION_L.GL_DIVISION and CI_FT.REDUNDANT_SW == 'N' and CI_GL_DIVISION_L.LANGUAGE_CD == 'ENG'" left="CI_FT" right="CI_GL_DIVISION_L" type="inner" weight="1"></join>
        <join expr="CI_FT.FREEZE_USER_ID == SC_USER.USER_ID and CI_FT.REDUNDANT_SW == 'N'" left="CI_FT" right="SC_USER" type="leftOuter" weight="1"></join>
        <join expr="CI_SA.SA_STATUS_FLG == CI_LOOKUP_VAL_L_2.FIELD_VALUE and CI_LOOKUP_VAL_L_2.FIELD_NAME == 'SA_STATUS_FLG' and CI_LOOKUP_VAL_L_2.LANGUAGE_CD == 'ENG'" left="CI_SA" right="CI_LOOKUP_VAL_L_2" type="inner" weight="1"></join>
        <join expr="CI_PREM.PREM_TYPE_CD == CI_PREM_TYPE_L.PREM_TYPE_CD and CI_PREM_TYPE_L.LANGUAGE_CD == 'ENG'" left="CI_PREM" right="CI_PREM_TYPE_L" type="inner" weight="1"></join>
        <join expr="CI_PREM.MR_INSTR_CD == CI_MR_INSTR_L.MR_INSTR_CD and CI_MR_INSTR_L.LANGUAGE_CD == 'ENG'" left="CI_PREM" right="CI_MR_INSTR_L" type="leftOuter" weight="1"></join>
        <join expr="CI_PREM.MR_WARN_CD == CI_MR_WARN_L.MR_WARN_CD and CI_MR_WARN_L.LANGUAGE_CD == 'ENG'" left="CI_PREM" right="CI_MR_WARN_L" type="leftOuter" weight="1"></join>
        <join expr="CI_PREM.TREND_AREA_CD == CI_TREND_AREA_L.DESCR and CI_TREND_AREA_L.LANGUAGE_CD == 'ENG'" left="CI_PREM" right="CI_TREND_AREA_L" type="leftOuter" weight="1"></join>
        <join expr="CI_PREM.COUNTRY == CI_STATE_L.COUNTRY and CI_PREM.STATE == CI_STATE_L.STATE and CI_STATE_L.LANGUAGE_CD == 'ENG'" left="CI_PREM" right="CI_STATE_L" type="leftOuter" weight="1"></join>
