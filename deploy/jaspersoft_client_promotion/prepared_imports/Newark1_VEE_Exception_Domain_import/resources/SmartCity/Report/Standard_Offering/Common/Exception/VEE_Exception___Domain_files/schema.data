    <jdbcQuery id="CMS_PER_NAME" datasourceId="Newark1_DS">
      <fieldList>
        <field id="ENTITY_NAME_UPR" type="java.lang.String"></field>
        <field id="INIT_MSRMT_DATA_ID" type="java.lang.String"></field>
      </fieldList>
      <query>SELECT
    DISTINCT IMDC.INIT_MSRMT_DATA_ID ,  PN.ENTITY_NAME_UPR
FROM
    CISADM.D1_INIT_MSRMT_DATA IMDC ,
    CISADM.D1_MEASR_COMP MC ,         
    CISADM.D1_DVC_CFG DC ,            
    CISADM.D1_INSTALL_EVT IE ,        
    CISADM.D1_SP SP ,                 
    CISADM.D1_US_SP USSP ,
    CISADM.D1_US US,
    CISADM.D1_US_CONTACT USC ,        
    CISADM.D1_CONTACT_IDENTIFIER DCI ,
    CISADM.CI_PER_NAME PN           
WHERE
    DCI.CONTACT_ID_TYPE_FLG = 'D1EI'
    AND PN.NAME_TYPE_FLG = 'PRIM'
    AND IMDC.MEASR_COMP_ID = MC.MEASR_COMP_ID
    AND MC.DEVICE_CONFIG_ID = DC.DEVICE_CONFIG_ID
    AND DC.DEVICE_CONFIG_ID = IE.DEVICE_CONFIG_ID
    AND IE.D1_SP_ID = SP.D1_SP_ID
    AND SP.D1_SP_ID = USSP.D1_SP_ID
    AND USSP.US_ID = US.US_ID
    AND US.BO_STATUS_CD = 'ACTIVE'
    AND US.US_ID = USC.US_ID    
    AND USC.CONTACT_ID = DCI.CONTACT_ID
    AND DCI.ID_VALUE = PN.PER_ID</query>
    </jdbcQuery>
