# API container environment (see DEPLOYMENT.md). Never commit real values.

# WHICH ENVIRONMENT THIS IS. Set it: three fences read it, and each defaults to the
# SAFE answer when it is missing, which is not the convenient one.
#   production | prod                     -> the safe default; set this on real deployments
#   development | dev | local | test      -> unlocks open access and the verbose /health
# Leaving it unset is treated as production, deliberately: is_production() returns False
# for an unrecognised environment, and the API runs on Render, which sets none of the
# platform markers -- so "not production" proves nothing there (audit M3, M7).
#   * /health returns only {"status":"ok"} unless development is declared, because the
#     verbose branch names every tenant and the route takes no auth.
#   * PORTAL_AUTH_DISABLED is IGNORED unless development is declared.
ENVIRONMENT=production

# Shared control-plane DB (Supabase). Backs logins (auth tables auto-create) AND
# the user-state stores (saved views, dashboards) via portal_state.records.
# Use the Supabase POOLED connection string (port 6543) for an app.
PORTAL_AUTH_DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-us-east-2.pooler.supabase.com:6543/postgres?sslmode=require
# Optional: point user-state at a different DB than auth. Defaults to the auth URL.
# PORTAL_STATE_DATABASE_URL=

PORTAL_AUTH_SECRET=<32+ char random secret>
# Open access, for local work ONLY. Requires ENVIRONMENT=development|dev|local|test;
# it is ignored anywhere else, because it yields a full admin on a literal dev secret.
# PORTAL_AUTH_DISABLED=true
PORTAL_BOOTSTRAP_ADMIN_EMAIL=admin@origin.local
PORTAL_BOOTSTRAP_ADMIN_PASSWORD=<strong password>

# Extra browser origins allowed to call the API, comma separated. Must be
# scheme://host[:port]; anything else is ignored, and "*" is DROPPED rather than
# honoured -- the middleware runs with credentials, and Starlette answers a wildcard by
# echoing the caller's origin, which would let any site call the API with a logged-in
# user's cookies (audit M9).
# PORTAL_CORS_ORIGINS=https://portal.yourutility.gov

# Restrict where scheduled reports and KPI alerts may be emailed, comma separated.
# Unset means no restriction, and a saved view on a cadence can mail its CSV anywhere
# (audit M6). Matched on the EXACT domain, so origin.local admits a@origin.local but
# not a@origin.local.attacker.example.
# PORTAL_ALLOWED_RECIPIENT_DOMAINS=yourutility.gov

# Reporting warehouses (Postgres). Per-client override wins over the shared default.
WAREHOUSE_DATABASE_URL=postgresql://...
# WAREHOUSE_DATABASE_URL_<ORG>=postgresql://...

# Oracle-backed orgs only (needs an Instant Client image + oracledb installed):
# <ORG>_DB_USER / _DB_PASSWORD / _ORACLE_DSN, DB_THICK_MODE=1, ORACLE_CLIENT_LIB_DIR=...

# --- OIDC single sign-on (Azure AD / Entra), optional. All four required to enable. ---
# OIDC_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
# OIDC_CLIENT_ID=<app registration client id>
# OIDC_CLIENT_SECRET=<client secret>
# OIDC_REDIRECT_URI=https://<api-host>/auth/oidc/callback   # registered at the IdP
# OIDC_DEFAULT_ORGANIZATION=dev          # org for just-in-time provisioned users (role: user)
# OIDC_POST_LOGIN_URL=https://<portal-host>/login   # receives #sso_token=<jwt>

# --- Scheduled report delivery (optional). Cron runs: python -m api.report_schedule_runner ---
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_USERNAME=reports@yourutility.gov
# SMTP_PASSWORD=<app password>
# SMTP_FROM=reports@yourutility.gov
# SMTP_STARTTLS=true
