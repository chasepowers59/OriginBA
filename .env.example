# Narrative generation: use OpenAI or Gemini (set one)
# -----------------------------------------------------------------------------
# OpenAI (recommended)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# Gemini (alternative)
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# Optional: Path to usage CSV exported from C2M (default: data/usage.csv)
# USAGE_CSV_PATH=data/usage.csv

# Analytics portal POC (demo database only — see docs/analytics_portal_poc.md)
# DEMO_DB_USER=
# DEMO_DB_PASSWORD=
# DEMO_ORACLE_DSN=smartcity-db-demo.originsmartops.com:1521/<service_name>

# Internal SmartCity DBs (same credentials as DEMO; client keys int_train / int_dev)
# INT_TRAIN_ORACLE_DSN=smartcity-db-demo.originsmartops.com:1521/ptrndb_demo.demoprivatesn2.origindemovcn.oraclevcn.com
# INT_DEV_ORACLE_DSN=10.16.0.89:1521/pdevdb_demo.devprivatesn.devvcn.oraclevcn.com

# Per-client Oracle DSNs for the analytics portal (shared DEMO_DB_USER / DEMO_DB_PASSWORD unless overridden)
# Ellensburg TEST 25.4
# ELLENSBURG_ORACLE_DSN=smartcity-db-test-v1-2.originsmartops.com:1521/PTESTDB_ELLENSBURG.testprivatesn.testvcn.oraclevcn.com
# ELLENSBURG_DB_USER=CPOWERS
# ELLENSBURG_DB_PASSWORD=
# CityCorp TEST 25.4
# CITYCORP_ORACLE_DSN=10.13.4.91:1521/ptestdb_citycorp.testprivatesn.testvcn.oraclevcn.com
# CITYCORP_DB_USER=
# CITYCORP_DB_PASSWORD=
# Odessa Test
# ODESSA_ORACLE_DSN=smartcity-db-test2.originsmartops.com:1521/ptestdb_odessa.testprivatesn.testvcn.oraclevcn.com
# ODESSA_DB_USER=
# ODESSA_DB_PASSWORD=
# Odessa Dev
# ODESSA_DEV_ORACLE_DSN=10.16.0.225:1521/pdevdb_odessa.devprivatesn.devvcn.oraclevcn.com
# ODESSA_DEV_DB_USER=
# ODESSA_DEV_DB_PASSWORD=
# Newark / College Station / Fond du Lac TEST 25.4 (shared non-prod creds)
# NEWARK_ORACLE_DSN=smartcity-db-test-v1-2.originsmartops.com:1521/PTESTDB_NEWARK.testprivatesn.testvcn.oraclevcn.com
# NEWARK_DB_USER=CPOWERS
# NEWARK_DB_PASSWORD=
# COLLEGESTATION_ORACLE_DSN=smartcity-db-test-v1-2.originsmartops.com:1521/PTESTDB_COLLEGESTATION.testprivatesn.testvcn.oraclevcn.com
# COLLEGESTATION_DB_USER=CPOWERS
# COLLEGESTATION_DB_PASSWORD=
# FONDDULAC_ORACLE_DSN=smartcity-db-test-v1-2.originsmartops.com:1521/PTESTDB_FONDDULAC.testprivatesn.testvcn.oraclevcn.com
# FONDDULAC_DB_USER=CPOWERS
# FONDDULAC_DB_PASSWORD=

# SmartCity PROD (see docs/smartcity_prod_db_connections.md)
# SMARTCITY_PROD_DB_USER=CPOWERS
# SMARTCITY_PROD_DB_PASSWORD=
# CityCorp 25.4 PROD
# CITYCORP_PROD_ORACLE_DSN=smartcity-db-prod-v1-2.originsmartops.com:1521/PPRODDB_CITYCORP.prodprivatesn.prodvcn.oraclevcn.com
# CITYCORP_PROD_DB_USER=CPOWERS
# CITYCORP_PROD_DB_PASSWORD=
# NEWARK_PROD_ORACLE_DSN=smartcity-db-prod.originsmartops.com:1521/pproddb_newark.prodprivatesn.originprodvcn.oraclevcn.com
# FONDDULAC_PROD_ORACLE_DSN=smartcity-db-prod.originsmartops.com:1521/pproddb_fonddulac.prodprivatesn.originprodvcn.oraclevcn.com
# COLLEGESTATION_PROD_ORACLE_DSN=smartcity-db-prod.originsmartops.com:1521/pproddb_collegestation.prodprivatesn.originprodvcn.oraclevcn.com
# ELLENSBURG_PROD_ORACLE_DSN=smartcity-db-prod.originsmartops.com:1521/pproddb_ellensburg.prodprivatesn.originprodvcn.oraclevcn.com
# PORTAL_DEV_ORGANIZATION=ellensburg   # When PORTAL_AUTH_DISABLED=true, which client DB to query

# PORTAL_SETTINGS_TOKEN=          # Optional: require token for /settings save & test
# PORTAL_DB_ENCRYPTION_KEY=       # Optional Fernet key for encrypted portal vault

# Portal identity (separate DB from Oracle — see docs/analytics_portal_auth.md)
# PORTAL_AUTH_DISABLED=true       # Dev: skip login (open admin context)
# PORTAL_AUTH_SECRET=             # Required when auth enabled (32+ chars)
# PORTAL_AUTH_DATABASE_URL=       # postgresql+psycopg2://... or sqlite default
# PORTAL_BOOTSTRAP_ADMIN_EMAIL=admin@origin.local
# PORTAL_BOOTSTRAP_ADMIN_PASSWORD=   # REQUIRED to create the first admin (min 12).
#   There is deliberately no default: the previous one was a literal in this file and
#   in api/auth/config.py, so any deployment that skipped it shipped an admin login
#   anyone with the repo could read. Bootstrap now refuses to run without it, the same
#   way PORTAL_AUTH_SECRET does.

# Optional: Output path for narrative JSON (default: output/narrative.json)
# NARRATIVE_JSON_PATH=output/narrative.json

# -----------------------------------------------------------------------------
# Oracle C2M (optional – for pipeline to fetch usage from DB instead of CSV)
# Use the same dev username/password you use in SQL Developer.
# -----------------------------------------------------------------------------
# ORACLE_USER=your_dev_username
# ORACLE_PASSWORD=your_dev_password
# DSN format: host:port/service_name  (e.g. myhost.example.com:1521/C2MDEV)
# ORACLE_DSN=host:1521/service_name

# -----------------------------------------------------------------------------
# SmartCity client / demo DB aliases (for scripts/local/run_client_oracle_sql.py)
# Example demo (Int Demo 2.9) — store real values only in .env (gitignored)
# DEMO_DB_USER=
# DEMO_DB_PASSWORD=
# DEMO_ORACLE_DSN=smartcity-db-demo.originsmartops.com:1521/<service_name>

# If the server requires Native Network Encryption, use thick mode: install Oracle Instant Client
# and set this to its directory (e.g. C:\oracle\instantclient_19_21 or /opt/oracle/instantclient_19_21).
# ORACLE_CLIENT_LIB_DIR=

# -----------------------------------------------------------------------------
# Risk Data / Audit Mode (optional – when ORACLE_* are set)
# -----------------------------------------------------------------------------
# Set to 1 or true to run Revenue Leakage, Liquidity Risk, and Stale Pending SA queries.
# Narrative and Business Snapshot will include Unresolved Debt on Canceled Service, Suspense Account Alert, Service delay (F1_TSK).
# RISK_DATA_ENABLED=

# -----------------------------------------------------------------------------
# NLQ API (optional – only when deploying api/nlq_server.py)
# -----------------------------------------------------------------------------
# If set, POST/GET /nlq require header: X-API-Key: <this value>. Keep .env in .gitignore.
# NLQ_API_KEY=
